@{
    var saveUrl = Url.Action("SaveAdminLayoutTheme", "Home", new { area = "ADMIN" });
    var embedded = ViewData["ThemeSwitcherEmbedded"] as bool? ?? false;
}

@if (!embedded)
{
    <div id="vm-admin-theme-overlay" class="vm-admin-theme-overlay" aria-hidden="true"></div>

    <button type="button" id="vm-admin-theme-fab" class="vm-admin-theme-fab" title="Layout Theme" aria-label="Open layout theme panel" aria-expanded="false" aria-controls="vm-admin-theme-panel">
        <svg class="vm-admin-theme-fab-icon" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="3"></circle>
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
        </svg>
    </button>
}

<div id="vm-admin-theme-panel" class="vm-admin-theme-panel@(embedded ? " vm-admin-theme-panel--embedded vm-open" : "")" role="@(embedded ? "region" : "dialog")" @(embedded ? "" : "aria-modal=\"true\"") aria-label="Layout theme picker" aria-hidden="@(embedded ? "false" : "true")">
    @if (!embedded)
    {
        <div class="vm-admin-theme-head">
            <div class="vm-admin-theme-head-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 3c-4.5 1.5-7.5 5-7.5 9a7.5 7.5 0 0 0 15 0c0-4-3-7.5-7.5-9z"></path>
                    <circle cx="12" cy="12" r="2.5"></circle>
                </svg>
            </div>
            <div class="vm-admin-theme-head-text">
                <h4>Theme Color</h4>
                <p>Top bar &amp; sidebar colors — solid or gradient</p>
            </div>
            <button type="button" id="vm-admin-theme-close" class="vm-admin-theme-close" aria-label="Close theme panel">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <path d="M6 6l12 12M18 6L6 18"></path>
                </svg>
            </button>
        </div>
    }

    <div class="vm-admin-theme-live-preview" aria-hidden="true">
        <div class="vm-preview-top" id="vm-preview-top"></div>
        <div class="vm-preview-body">
            <div class="vm-preview-side" id="vm-preview-side"></div>
            <div class="vm-preview-content">
                <span></span><span></span><span></span>
            </div>
        </div>
    </div>

    <div class="vm-admin-theme-section">
        <div class="vm-admin-theme-section-label">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
            Preset Themes
        </div>
        <div data-vm-theme-grid class="vm-admin-theme-grid"></div>
    </div>

    <div class="vm-admin-theme-custom">
        <div class="vm-admin-theme-section-label">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 20h4l10-10-4-4L4 16v4z"/><path d="M13 7l4 4"/></svg>
            Custom Colors
        </div>

        <div class="vm-admin-theme-block">
            <div class="vm-admin-theme-block-head">
                <span class="vm-admin-theme-block-title">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 10h18"/></svg>
                    Top Navigation Bar
                </span>
                <label class="vm-admin-theme-switch">
                    <input type="checkbox" id="vm-theme-top-gradient" />
                    <span class="vm-admin-theme-switch-ui"></span>
                    <span class="vm-admin-theme-switch-label">Gradient</span>
                </label>
            </div>
            <div class="vm-admin-theme-row">
                <div class="vm-admin-theme-color-field">
                    <label for="vm-theme-top-c1">Color 1</label>
                    <div class="vm-admin-theme-color-wrap">
                        <input type="color" id="vm-theme-top-c1" value="#ffffff" />
                        <span class="vm-admin-theme-hex" data-for="vm-theme-top-c1">#ffffff</span>
                    </div>
                </div>
                <div class="vm-admin-theme-color-field">
                    <label for="vm-theme-top-c2">Color 2</label>
                    <div class="vm-admin-theme-color-wrap">
                        <input type="color" id="vm-theme-top-c2" value="#2563eb" />
                        <span class="vm-admin-theme-hex" data-for="vm-theme-top-c2">#2563eb</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="vm-admin-theme-block">
            <div class="vm-admin-theme-block-head">
                <span class="vm-admin-theme-block-title">
                    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="7" height="16" rx="1.5"/><rect x="12" y="4" width="9" height="16" rx="1.5"/></svg>
                    Left Sidebar
                </span>
                <label class="vm-admin-theme-switch">
                    <input type="checkbox" id="vm-theme-side-gradient" />
                    <span class="vm-admin-theme-switch-ui"></span>
                    <span class="vm-admin-theme-switch-label">Gradient</span>
                </label>
            </div>
            <div class="vm-admin-theme-row">
                <div class="vm-admin-theme-color-field">
                    <label for="vm-theme-side-c1">Color 1</label>
                    <div class="vm-admin-theme-color-wrap">
                        <input type="color" id="vm-theme-side-c1" value="#0b1220" />
                        <span class="vm-admin-theme-hex" data-for="vm-theme-side-c1">#0b1220</span>
                    </div>
                </div>
                <div class="vm-admin-theme-color-field">
                    <label for="vm-theme-side-c2">Color 2</label>
                    <div class="vm-admin-theme-color-wrap">
                        <input type="color" id="vm-theme-side-c2" value="#111827" />
                        <span class="vm-admin-theme-hex" data-for="vm-theme-side-c2">#111827</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="vm-admin-theme-actions">
            <button type="button" id="vm-admin-theme-reset" class="vm-admin-theme-reset">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/></svg>
                Reset
            </button>
            <button type="button" id="vm-admin-theme-apply-custom" class="vm-admin-theme-apply">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 13l4 4L19 7"/></svg>
                Apply Custom
            </button>
        </div>
    </div>
</div>

<script>
    window.vmAdminThemeSaveUrl = '@saveUrl';
    window.vmAdminThemeEmbedded = @(embedded ? "true" : "false");
</script>
