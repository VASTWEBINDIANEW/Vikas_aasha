@model Vastwebmulti.Areas.ADMIN.Models.CashDepositeAndBank_Info_VM
@using (Ajax.BeginForm("_EditPurchageOrder", "Home", new AjaxOptions { HttpMethod = "POST", OnSuccess = "success", OnFailure = "failed", UpdateTargetId = "farziidhye" }))
{
    <div class="cdc-deposit-save-bar">
        <button id="btnsubmit" type="submit" class="ne-btn-submit cdc-btn-save"><i class="fas fa-save" aria-hidden="true"></i><span>Save Now</span></button>
    </div>
    <div id="tblmaster" class="cdc-deposit-table-host">
        <table class="table table-bordered cdc-deposit-table example-second">
            <thead>
                <tr>
                    <th>User ID</th>
                    <th>Payment&nbsp;Type</th>
                    <th>Charge&nbsp;(%)</th>
                </tr>
            </thead>
            @if (Model.creditchargemaster != null)
            {
                <tbody id="tbodyshow" class="cdc-deposit-view">
                    @foreach (var item in Model.creditchargemaster)
                    {
                        <tr>
                            <td>@item.userid</td>
                            <td>@item.ctype</td>
                            <td class="cdc-deposit-charge-val">@item.Charge</td>
                        </tr>
                    }
                </tbody>
                <tbody id="tbodyedit" class="cdc-deposit-edit" style="display:none;">
                    @for (int i = 0; i < Model.creditchargemaster.Count; i++)
                    {
                        <tr>
                            @Html.HiddenFor(a => a.creditchargemaster[i].userinfo)
                            <td>@Html.DisplayFor(a => a.creditchargemaster[i].userid)</td>
                            <td>
                                @Html.HiddenFor(a => a.creditchargemaster[i].ctype)
                                @Html.DisplayFor(a => a.creditchargemaster[i].ctype)
                            </td>
                            <td>
                                @Html.EditorFor(a => a.creditchargemaster[i].Charge, new { htmlAttributes = new { @class = "form-control cdc-cell-input" } })
                                @Html.ValidationMessageFor(a => a.creditchargemaster[i].Charge)
                            </td>
                        </tr>
                    }
                </tbody>
            }
        </table>
    </div>
}
