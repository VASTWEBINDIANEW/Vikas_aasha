<script>
    function vmRlUploadTablePhoto(input, retailerId) {
        if (!input || !input.files || !input.files[0] || !retailerId) return;

        var fd = new FormData();
        fd.append('FileUpload', input.files[0]);
        fd.append('retailerId', retailerId);

        var $wrap = $(input).closest('.vm-rl-avatar-upload');
        $wrap.addClass('vm-rl-avatar-upload--loading');

        $.ajax({
            url: '@Url.Action("UploadRetailerTablePhoto", "Home")',
            type: 'POST',
            data: fd,
            processData: false,
            contentType: false,
            success: function (res) {
                $wrap.removeClass('vm-rl-avatar-upload--loading');
                if (res && res.success && res.imageUrl) {
                    var bustUrl = res.imageUrl + (res.imageUrl.indexOf('?') >= 0 ? '&' : '?') + 't=' + Date.now();
                    var $img = $wrap.find('.vm-rl-avatar-img');
                    if ($img.length) {
                        $img.attr('src', bustUrl);
                    } else {
                        $wrap.find('.vm-rl-avatar-placeholder').replaceWith('<img src="' + bustUrl + '" class="vm-rl-avatar-img" alt="Retailer photo" onclick="viewImage(this)" />');
                    }
                } else {
                    alert((res && res.message) ? res.message : 'Photo upload failed.');
                }
                input.value = '';
            },
            error: function () {
                $wrap.removeClass('vm-rl-avatar-upload--loading');
                alert('Photo upload failed.');
                input.value = '';
            }
        });
    }
</script>
