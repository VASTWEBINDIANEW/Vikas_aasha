<script>
    var pageindex = 2;
    var NoMoredata = false;
    var inProgress = false;

    function vmRlLoadMore() {
        var dealer_selected = $('#RetailerFilterDealerID').val();
        if (!NoMoredata && !inProgress && !dealer_selected) {
            inProgress = true;
            $("#loadingdiv").show();
            $.post("@Url.Action("InfiniteScroll_retailer", "Home")",
                { "pageindex": pageindex },
                function (data) {
                    pageindex = pageindex + 1;
                    NoMoredata = data.NoMoredata;
                    $("#body").append(data.HTMLString);
                    $("#loadingdiv").hide();
                    inProgress = false;
                });
        }
    }

    function vmRlBindTableScroll() {
        // Container scroll (desktop — when #vmRlTableScroll has fixed height)
        $('#vmRlTableScroll').off('scroll.vmRlInfinite').on('scroll.vmRlInfinite', function () {
            var el = this;
            if (el.scrollTop + el.clientHeight >= el.scrollHeight - 100) {
                vmRlLoadMore();
            }
        });

        // Window scroll (mobile — when table stretches full page)
        $(window).off('scroll.vmRlInfinite').on('scroll.vmRlInfinite', function () {
            var $tableHost = $('#vmRlTableScroll');
            if (!$tableHost.length) return;
            var tableBottom = $tableHost.offset().top + $tableHost.outerHeight();
            var windowBottom = $(window).scrollTop() + $(window).height();
            if (windowBottom >= tableBottom - 150) {
                vmRlLoadMore();
            }
        });
    }

    function vmRlSyncTabPanelHeight() {
        var $wrap = $('#vmRlTabPanels');
        var $tab9 = $('#tab-9');
        var $tab10 = $('#tab-10');
        if (!$wrap.length || !$tab9.length) return;

        var h = 0;
        if ($tab9.hasClass('current')) {
            h = Math.ceil($tab9.outerHeight());
        } else {
            $tab9.addClass('vm-rl-tab-measure');
            h = Math.ceil($tab9.outerHeight());
            $tab9.removeClass('vm-rl-tab-measure');
        }

        if (h > 0) {
            $wrap.css('min-height', h + 'px');
            $tab9.css('min-height', h + 'px');
            $tab10.css('min-height', h + 'px');
        }
    }

    function vmRlSyncPanelHeight() {
        vmRlSyncTabPanelHeight();
        // Form card is now inside the side drawer — clear any fixed heights so the
        // full-width history panel stretches naturally with its content.
        var $panel     = $('#vmRlHistoryPanel');
        var $scroll    = $('#vmRlTableScroll');
        var $tableHost = $('#Retailertablelist');
        $panel.css({ height: '', maxHeight: '' });
        $scroll.css({ height: '', maxHeight: '' });
        $tableHost.css({ height: '', maxHeight: '' });
    }

    function vmRlInitHeightSync() {
        vmRlSyncPanelHeight();
        $(window).off('load.vmRlSync resize.vmRlSync').on('load.vmRlSync resize.vmRlSync', function () {
            vmRlSyncPanelHeight();
        });
    }

    $(document).ready(function () {
        vmRlBindTableScroll();
        vmRlInitHeightSync();
    });
</script>

<script>
    /* ===== Create Retailer Side Drawer ===== */
    (function () {
        var modal   = document.getElementById('vmRlCreateModal');
        var panel   = document.getElementById('vmRlCreatePanel');
        var backdrop = document.getElementById('vmRlCreateBdrop');
        var closeBtn = document.getElementById('vmRlCreateClose');
        var openBtn  = document.getElementById('btnOpenCreateRetailer');
        var formCard = document.getElementById('vmRlFormCard');

        // Move the form card into the drawer panel (DOM move - preserves all bindings)
        if (formCard && panel) {
            panel.appendChild(formCard);
        }

        function openDrawer() {
            modal.classList.add('is-open');
            modal.setAttribute('aria-hidden', 'false');
            document.body.classList.add('vm-rl-modal-open');
            // Scroll drawer to top on open
            if (panel) panel.scrollTop = 0;
        }

        function closeDrawer() {
            modal.classList.remove('is-open');
            modal.setAttribute('aria-hidden', 'true');
            document.body.classList.remove('vm-rl-modal-open');
        }

        if (openBtn)   openBtn.addEventListener('click', openDrawer);
        if (closeBtn)  closeBtn.addEventListener('click', closeDrawer);
        if (backdrop)  backdrop.addEventListener('click', closeDrawer);

        // Close on Escape key
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && modal.classList.contains('is-open')) {
                closeDrawer();
            }
        });
    })();
</script>


