        <script>
            function whtssupdate() {
                var url = '@Url.Action("Whatsaapupdate","Home")'
                $.ajax({
                    url: url,
                    cache: false,
                    type: "POST",
                    success: function (data) {
                        var upt = document.getElementById('whtup');
                        var badge = upt ? upt.querySelector('.vm-rl-action-item__badge') : null;
                        if (data == true) {
                            upt.classList.remove('vm-rl-action-item--off');
                            upt.classList.add('vm-rl-action-item--on');
                            if (badge) badge.textContent = 'ON';
                        } else {
                            upt.classList.remove('vm-rl-action-item--on');
                            upt.classList.add('vm-rl-action-item--off');
                            if (badge) badge.textContent = 'OFF';
                        }
                    }
                });
            }
        </script>

