                <a href="@Url.Action("userwisewhatsappstatus", "Home")" class="vm-rl-action-item vm-rl-action-item--whatsapp" title="Whatsapp Status">
                    <span class="vm-rl-action-item__icon" aria-hidden="true"><i class="fab fa-whatsapp"></i></span>
                    <span class="vm-rl-action-item__label">Whatsapp Status</span>
                </a>
                @{
                    var chjk = db.Email_show_passcode.SingleOrDefault().whatsappapists;
                    if (chjk == true)
                    {
                        <button type="button" id="whtup" onclick="whtssupdate()" class="vm-rl-action-item vm-rl-action-item--btn vm-rl-action-item--whatsapp vm-rl-action-item--on" title="Whatsapp Sms">
                            <span class="vm-rl-action-item__icon" aria-hidden="true"><i class="fas fa-comment-dots"></i></span>
                            <span class="vm-rl-action-item__label">Whatsapp Sms</span>
                            <span class="vm-rl-action-item__badge">ON</span>
                        </button>
                    }
                    else
                    {
                        <button type="button" id="whtup" onclick="whtssupdate()" class="vm-rl-action-item vm-rl-action-item--btn vm-rl-action-item--whatsapp vm-rl-action-item--off" title="Whatsapp Sms">
                            <span class="vm-rl-action-item__icon" aria-hidden="true"><i class="fas fa-comment-dots"></i></span>
                            <span class="vm-rl-action-item__label">Whatsapp Sms</span>
                            <span class="vm-rl-action-item__badge">OFF</span>
                        </button>
                    }
                }
