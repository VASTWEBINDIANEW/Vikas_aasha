@Html.Partial("_RetailerlistModals")

<script>
    var vmRlSkipModalRefresh = false;

    function vmRlAfterTableUpdate() {
        if (typeof vmRlBindTableScroll === 'function') vmRlBindTableScroll();
        if (typeof vmRlInitHeightSync === 'function') vmRlInitHeightSync();
    }

    function vmRlMoveModalsToBody() {
        $('#defaultModal222,#panviewdoc,#aadharviewdoc,#ShopwithSalfieviewdoc,#VideoKYCdocshowviewdoc,#gstviewdoc,#frmagrviewdoc,#otpmodal,#otpmodaldocument').each(function () {
            var $m = $(this);
            if ($m.length && !$m.parent().is('body')) {
                $m.appendTo('body');
            }
        });
    }

    function vmRlResetDetailModal() {
        var $m = $('#defaultModal222');
        $m.find('.first-form').show();
        $m.find('.second-form').hide();
        $m.find('.modal-footer button.one, .first-form button.one').show();
        $m.find('.modal-footer button.One2, .second-form button.One2').hide();
        $('#error').text('');
        $('#loadredmodel').hide();
        $('#userinfodiv').css({ visibility: 'visible', opacity: 1 }).show();
    }

    function vmRlCloseDetailModal() {
        $('#defaultModal222').modal('hide');
    }

    function vmRlInitModals() {
        vmRlMoveModalsToBody();
        $(document).off('click.vmRl', '#defaultModal222 button.btn[value="Edit"]')
            .on('click.vmRl', '#defaultModal222 button.btn[value="Edit"]', function () {
                var $m = $('#defaultModal222');
                $m.find('.first-form').hide();
                $m.find('.second-form').show();
                $m.find('.modal-footer button.one, .first-form button.one').hide();
                $m.find('.modal-footer button.One2, .second-form button.One2').show();
            });
        $('#defaultModal222').off('hidden.bs.modal.vmRl').on('hidden.bs.modal.vmRl', function () {
            vmRlResetDetailModal();
            $('body').removeClass('modal-open');
            $('.modal-backdrop').remove();
            if (vmRlSkipModalRefresh) {
                vmRlSkipModalRefresh = false;
                vmRlAfterTableUpdate();
                return;
            }
            $.ajax({
                url: '@Url.Action("RetailerlistPart", "Home")',
                type: 'POST',
                cache: false,
                success: function (response) {
                    $('#Retailertablelist').html(response);
                    vmRlAfterTableUpdate();
                }
            });
        });
    }

    $(document).ready(function () {
        vmRlInitModals();
    });
</script>

