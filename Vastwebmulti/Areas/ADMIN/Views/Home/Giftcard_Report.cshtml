<script>
    function hideGiftcardReportTotals() {
        var $panel = $('#giftcardReportTotalsPanel');
        var $btn = $('.vm-gift-totals-btn');
        $panel.hide().attr('aria-hidden', 'true');
        $btn.attr('aria-expanded', 'false');
    }

    function findtotalA() {
        var $panel = $('#giftcardReportTotalsPanel');
        var $btn = $('.vm-gift-totals-btn');
        if ($panel.is(':visible')) {
            hideGiftcardReportTotals();
            return;
        }
        $panel.show().attr('aria-hidden', 'false');
        $btn.attr('aria-expanded', 'true');
    }

    function buildGiftcardExportUrl(isPdf) {
        var base = isPdf
            ? '@Url.Action("pdfGiftcard_Report", "Home")'
            : '@Url.Action("ExcelGiftCardReport", "Home")';
        return base
            + '?txt_frm_date=' + encodeURIComponent($('#txt_frm_date').val())
            + '&txt_to_date=' + encodeURIComponent($('#txt_to_date').val())
            + '&ddlusers=' + encodeURIComponent($('#ddlusers').val())
            + '&ddl_status=' + encodeURIComponent($('#ddl_status').val() || '')
            + '&alldealer=' + encodeURIComponent($('#alldealer').val() || '')
            + '&allretailer=' + encodeURIComponent($('#allretailer').val() || '')
            + '&Whitelabel=' + encodeURIComponent($('#Whitelabel').val() || '')
            + '&Operator=' + encodeURIComponent($('#Operator').val() || '')
            + '&allmaster1=' + encodeURIComponent($('#allmaster1').val() || '');
    }

    function refundshow(orderid, status) {
        $('#txtorderid').val(orderid);
        $('#status').val(status);
    }

    function Failed() {
        var answer = confirm('Are you sure ?');
        if (!answer) {
            $('#defaultModal1').modal('hide');
            return false;
        }

        var orderid = $('#txtorderid').val();
        var status = $('#status').val();
        var ddlval = $('#ddl_refund').val();

        $.ajax({
            url: '@Url.Action("GiftcardFailed", "Home")',
            type: 'POST',
            dataType: 'html',
            data: { orderid: orderid, status: status, ddl_refund: ddlval },
            success: function (data) {
                var response = JSON.parse(data);
                if (response.Status) {
                    swal('Good Job!', response.Message, 'success');
                    window.location.reload();
                } else {
                    swal('Oops...', response.Message, 'error');
                }
            }
        }).done(function () {
            $('#defaultModal1').modal('hide');
        });
        return true;
    }

    function success(orderid, status) {
        var answer = confirm('Are you sure ?');
        if (!answer) {
            return false;
        }

        $.ajax({
            url: '@Url.Action("GiftcardSuccess", "Home")',
            type: 'POST',
            dataType: 'html',
            data: { orderid: orderid, status: status },
            success: function (data) {
                var response = JSON.parse(data);
                if (response.Status) {
                    swal('Good Job!', response.Message, 'success');
                    window.location.reload();
                } else {
                    swal('Oops...', response.Message, 'error');
                }
            }
        });
        return true;
    }

    function destroyGiftSelect2($el) {
        if ($el && $el.length && $el.data('select2')) {
            $el.select2('destroy');
        }
    }

    function applyGiftSelect2($el) {
        if (!$el || !$el.length || !$.fn.select2) {
            return;
        }
        destroyGiftSelect2($el);
        $el.select2({
            width: '100%',
            minimumResultsForSearch: 6
        });
    }

    function hideGiftFilter($id) {
        var $wrap = $('#' + $id);
        $wrap.removeClass('is-visible').attr('hidden', 'hidden');
        var $select = $wrap.find('select');
        destroyGiftSelect2($select);
        if ($select.length) {
            $select[0].selectedIndex = 0;
        }
    }

    function showGiftFilter($id) {
        var $wrap = $('#' + $id);
        $wrap.addClass('is-visible').removeAttr('hidden');
        applyGiftSelect2($wrap.find('select'));
    }

    function hideAllGiftExtraFilters() {
        hideGiftFilter('allmaster');
        hideGiftFilter('dlm');
        hideGiftFilter('rem');
        hideGiftFilter('whitelabelid');
    }

    function answers() {
        var answer = $('#ddlusers').val();
        hideAllGiftExtraFilters();

        if (answer === 'Dealer') {
            showGiftFilter('dlm');
        } else if (answer === 'Master') {
            showGiftFilter('allmaster');
        } else if (answer === 'Retailer') {
            showGiftFilter('rem');
        } else if (answer === 'WAdmin') {
            showGiftFilter('whitelabelid');
        }
    }

    function initGiftcardReportSelect2() {
        applyGiftSelect2($('#ddlusers'));
        applyGiftSelect2($('#ddl_status'));
        applyGiftSelect2($('#Operator'));
        $('#ddlusers').off('change.giftcardReport').on('change.giftcardReport', answers);
    }

    function initGiftcardReportDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initGiftcardReportDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm('#giftcardReportForm');
        }
    }

    $(document).ready(function () {
        initGiftcardReportSelect2();
        answers();
        initGiftcardReportDatepickers();
        $('#giftcardReportForm .select2-container').css('width', '100%');

        $(document).on('click', '.vm-gift-detail-btn', function () {
            var $btn = $(this);
            $('#gift-dealer-pre').val($btn.data('dealer-pre') || '');
            $('#gift-dealer-post').val($btn.data('dealer-post') || '');
            $('#gift-master-pre').val($btn.data('master-pre') || '');
            $('#gift-master-post').val($btn.data('master-post') || '');
            $('#gift-whitelable-pre').val($btn.data('whitelabel-pre') || '');
            $('#gift-whitelable-post').val($btn.data('whitelabel-post') || '');
            $('#giftcard-massage').val($btn.data('gift-message') || '');
            $('#gift-api-request').val($btn.data('api-request') || '');
            $('#gift-api-response').val($btn.data('api-response') || '');
        });

        $('#btnExportA').on('click', function () {
            location.href = buildGiftcardExportUrl(false);
        });

        $('#btnPDFA').on('click', function () {
            window.open(buildGiftcardExportUrl(true), '_blank');
        });
    });
</script>
