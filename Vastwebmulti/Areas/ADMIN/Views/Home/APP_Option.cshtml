    function ChangeColorIcon(type) {
        var isFill = type === 'fill' || (typeof type === 'number' && type <= 12);
        var fillBtn = document.getElementById('fill');
        var lineBtn = document.getElementById('line');
        var fillPanel = document.getElementById('iconfillshow');
        var linePanel = document.getElementById('iconlineshow');
        var desc = document.getElementById('textforicon');
        if (isFill) {
            if (linePanel) { linePanel.style.display = 'none'; }
            if (fillPanel) { fillPanel.style.display = 'block'; }
            if (desc) { desc.textContent = '12 fill-style icon groups — tap a group to apply and preview.'; }
            if (fillBtn) { fillBtn.classList.add('vm-ao-segment__btn--active', 'filllinecolor'); }
            if (lineBtn) { lineBtn.classList.remove('vm-ao-segment__btn--active', 'filllinecolor'); }
        } else {
            if (linePanel) { linePanel.style.display = 'block'; }
            if (fillPanel) { fillPanel.style.display = 'none'; }
            if (desc) { desc.textContent = '12 outline-style icon groups — tap a group to apply and preview.'; }
            if (lineBtn) { lineBtn.classList.add('vm-ao-segment__btn--active', 'filllinecolor'); }
            if (fillBtn) { fillBtn.classList.remove('vm-ao-segment__btn--active', 'filllinecolor'); }
        }
