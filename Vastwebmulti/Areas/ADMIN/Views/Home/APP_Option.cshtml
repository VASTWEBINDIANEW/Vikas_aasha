        }
    })();

    function handleSubmit(event) {
        event.preventDefault();
        var text = (document.getElementById('vmMsgText') || {}).value || '';
        if (!text.trim()) {
            vmLoadAppMessages(false);
            return;
        }
        $.ajax({
            url: '@Url.Action("InsertAppMessage", "Home", new { area = "ADMIN" })',
            type: 'POST',
            dataType: 'json',
            data: { Message: text },
            success: function (response) {
                vmRenderAppMessages(vmGetJsonList(response));
                if (response.status) {
                    document.getElementById('vmMsgText').value = '';
                    updateCharCount();
                    toastr.success(response.message);
                } else if (response.message) {
                    toastr.error(response.message);
                }
            },
            error: function () {
                if (typeof vmAppOptionNotify === 'function') {
                    vmAppOptionNotify('Error', 'Could not save notification.', 'error');
                } else if (typeof toastr !== 'undefined') {
                    toastr.error('Could not save notification.');
                }
            }
        });
    }

