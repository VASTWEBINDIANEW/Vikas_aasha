    function addContent(groupId) {
        var group = document.getElementById(groupId);
        if (!group) { return; }
        var button = group.querySelector('button');
        if (button) {
            button.classList.add('ClassBtnActive');
        }
        var i, id, otherGroup, otherButton;
        for (i = 1; i <= 24; i++) {
            id = 'group' + i;
            if (groupId !== id) {
                otherGroup = document.getElementById(id);
                if (otherGroup) {
                    otherButton = otherGroup.querySelector('button');
                    if (otherButton) {
                        otherButton.classList.remove('ClassBtnActive');
                    }
                }
            } else {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("ChangeIconTheam", "Home", new { area = "ADMIN" })',
                    data: { theam: i },
                    success: function (result) {
                        if (result.status) {
                            inserthtml(result.theam);
