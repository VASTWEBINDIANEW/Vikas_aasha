    //  App Icon Theme
    function vmSyncIconThemeSwitch(showDashboard) {
        var dashPanel = document.getElementById('iconsettingshow');
        var frontPanel = document.getElementById('iconsettinghide');
        var titleEl = document.getElementById('vmIconThemePanelTitle');
        var dashBtns = dashPanel ? dashPanel.querySelectorAll('#dback, #fback') : [];
        var frontBtns = frontPanel ? frontPanel.querySelectorAll('#dback, #fback') : [];
        var i;
        if (showDashboard) {
            if (dashPanel) { dashPanel.style.display = 'block'; }
            if (frontPanel) { frontPanel.style.display = 'none'; }
            if (titleEl) { titleEl.textContent = 'Dashboard icon design'; }
            for (i = 0; i < dashBtns.length; i++) {
                dashBtns[i].classList.toggle('vm-ao-segment__btn--active', dashBtns[i].id === 'dback');
            }
            for (i = 0; i < frontBtns.length; i++) {
                frontBtns[i].classList.toggle('vm-ao-segment__btn--active', false);
            }
        } else {
            if (dashPanel) { dashPanel.style.display = 'none'; }
            if (frontPanel) { frontPanel.style.display = 'block'; }
            for (i = 0; i < dashBtns.length; i++) {
                dashBtns[i].classList.toggle('vm-ao-segment__btn--active', false);
            }
            for (i = 0; i < frontBtns.length; i++) {
                frontBtns[i].classList.toggle('vm-ao-segment__btn--active', frontBtns[i].id === 'fback');
            }
        }
    }
