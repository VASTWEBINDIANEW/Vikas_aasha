    const maxLength = 500;
    function updateCharCount() {
        const textArea = document.getElementById("vmMsgText");
        const charCountDiv = document.getElementById("vmMsgCharCount");
        const currentLength = textArea.value.length;

        if (currentLength > maxLength) {
            textArea.value = textArea.value.substring(0, maxLength);
        }

        charCountDiv.textContent = `Characters Remaining: ${maxLength - currentLength}`;
    }

    function clearText(event) {
        event.preventDefault();
        const textArea = document.getElementById("vmMsgText");
        textArea.value = "";
        updateCharCount();
    }

    function vmGetJsonList(response) {
        if (!response) { return []; }
        var list = response.data || response.Data;
        return Array.isArray(list) ? list : [];
    }

    function vmEscapeMsgHtml(text) {
        if (!text) { return ''; }
        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function vmRenderAppMessages(list) {
        var host = document.getElementById('vmNotifyList');
        if (!host) { return; }
        if (!list || !list.length) {
            host.innerHTML = '<div class="vm-app-msg-empty"><i class="fas fa-bell-slash"></i><p>No notifications yet. Add one using the form on the left.</p></div>';
            return;
        }
        var html = '';
        var count = 1;
        list.forEach(function (item) {
            var msg = item.App_Message || item.app_Message || '';
            var id = item.id || item.Id;
            html += '<div class="vm-app-msg-item" data-vm-msg-id="' + id + '">' +
                '<span class="vm-app-msg-num">' + count + '</span>' +
                '<div class="vm-app-msg-body">' +
                '<p class="vm-app-msg-text">' + vmEscapeMsgHtml(msg) + '</p>' +
                '<button type="button" class="vm-app-msg-delete" onclick="DeleteAppNotification(' + id + ')">Delete</button>' +
                '</div></div>';
            count++;
        });
        host.innerHTML = html;
    }

    function vmLoadAppMessages(showErrorOnFail) {
        var host = document.getElementById('vmNotifyList');
        var notifyOnFail = showErrorOnFail !== false;
        $.ajax({
            url: '@Url.Action("InsertAppMessage", "Home", new { area = "ADMIN" })',
            type: 'POST',
            data: { Message: '' },
            dataType: 'json',
            cache: false,
            success: function (response) {
                if (typeof response === 'string') {
                    try { response = JSON.parse(response); } catch (e) { response = null; }
                }
                vmRenderAppMessages(vmGetJsonList(response));
            },
            error: function (xhr) {
                if (host && host.querySelector('.vm-app-msg-item')) {
                    return;
                }
                vmRenderAppMessages([]);
                if (!notifyOnFail) {
                    return;
                }
                var errText = 'Could not load notifications.';
                if (xhr && xhr.status === 404) {
                    errText = 'Notifications service not found. Rebuild and refresh the page.';
                } else if (xhr && xhr.responseText && xhr.responseText.indexOf('PassCode') >= 0) {
                    errText = 'Session expired. Please refresh the page and login again.';
                }
                if (typeof vmAppOptionNotify === 'function') {
                    vmAppOptionNotify('Error', errText, 'error');
                } else if (typeof toastr !== 'undefined') {
                    toastr.error(errText);
                }
            }
        });
    }

    function DeleteAppNotification(id) {
        $.ajax({
            url: '@Url.Action("DeleteAppMessage", "Home", new { area = "ADMIN" })',
            type: "POST",
            dataType: 'json',
            data: { id: id },
            success: function (response) {
                vmRenderAppMessages(vmGetJsonList(response));
                if (response.status) {
                    toastr.success(response.message);
                } else {
                    toastr.error(response.message);
                }
            },
            error: function () {
                if (typeof vmAppOptionNotify === 'function') {
                    vmAppOptionNotify('Error', 'Could not delete notification.', 'error');
                } else if (typeof toastr !== 'undefined') {
                    toastr.error('Could not delete notification.');
                }
            }
        });
    }

    (function vmInitNotifyList() {
        var host = document.getElementById('vmNotifyList');
        if (!host) { return; }
        if (!host.querySelector('.vm-app-msg-item')) {
