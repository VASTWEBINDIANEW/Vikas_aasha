@model IEnumerable<Vastwebmulti.Models.CreditCardBillPaymentChargReport_Result>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Credit Card Bill Payment Slab";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var rows = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.CreditCardBillPaymentChargReport_Result>();
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-settings-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css?v=12" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-payment-gateway-slab-modern.css?v=10" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-prepaid-slab-modern.css?v=16" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-prepaid-slab-mobile.css?v=16" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-prepaid-slab-modals.css?v=5" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />

<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

<style>
    #div_Loader {
        background: rgba(0, 0, 0, 0.6) none repeat scroll 0 0;
        height: 100%;
        position: fixed;
        left: 0;
        top: 0;
        width: 100%;
        z-index: 999999;
    }

    .ldio-gs56nt525f > div {
        transform-origin: 100px 100px;
        animation: ldio-gs56nt525f 0.2s infinite linear;
    }

        .ldio-gs56nt525f > div div {
            position: absolute;
            width: 22px;
            height: 152px;
            background: var(--main-bg-lcolor);
            left: 100px;
            top: 100px;
            transform: translate(-50%,-50%);
        }

            .ldio-gs56nt525f > div div:nth-child(1) {
                width: 120px;
                height: 120px;
                border-radius: 50%;
            }

            .ldio-gs56nt525f > div div:nth-child(6) {
                width: 80px;
                height: 80px;
                background: #fff;
                border-radius: 50%;
            }

            .ldio-gs56nt525f > div div:nth-child(3) {
                transform: translate(-50%,-50%) rotate(45deg)
            }

            .ldio-gs56nt525f > div div:nth-child(4) {
                transform: translate(-50%,-50%) rotate(90deg)
            }

            .ldio-gs56nt525f > div div:nth-child(5) {
                transform: translate(-50%,-50%) rotate(135deg)
            }

    .loadingio-spinner-gear-94vo528ab8 {
        width: 200px;
        height: 200px;
        display: inline-block;
        overflow: hidden;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%,-50%);
    }

    .ldio-gs56nt525f {
        width: 100%;
        height: 100%;
        position: relative;
        transform: translateZ(0) scale(1);
        backface-visibility: hidden;
        transform-origin: 0 0;
    }

        .ldio-gs56nt525f div {
            box-sizing: content-box;
        }

    @@keyframes ldio-gs56nt525f {
        0% { transform: rotate(0deg) }
        50% { transform: rotate(22.5deg) }
        100% { transform: rotate(45deg) }
    }
</style>

<section class="content saas-admin-account-page saas-admin-settings-page saas-pg-slab-page saas-prepaid-slab-page saas-cms-slab-page saas-retailer-charge-slab-page saas-cc-billpayment-slab-page" id="retailerChargePage">
    <div class="container-fluid">

        <div class="saas-acc-toolbar">
            <ol class="saas-acc-breadcrumb">
                <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                <li><a href="javascript:void(0);">Basic Setting</a></li>
                <li>Credit Card Bill Payment Slab</li>
            </ol>
        </div>

        <div class="vm-prepaid-slab-shell">
            @Html.Partial("_Slab_Menu")

            <div class="vm-prepaid-slab-main">
                <div class="vm-pg-slab-card">
                    <div class="vm-pg-slab-card__head vm-retailer-charge-card__head">
                        <h3 class="vm-pg-slab-card__title">
                            <i class="fas fa-file-invoice-dollar" aria-hidden="true"></i>
                            Credit Card Bill Payment Slab
                        </h3>
                    </div>

                    <div class="vm-pg-slab-body">
                        <div class="vm-retailer-charge-toolbar">
                            @using (Html.BeginForm("CreditCard_BillPayment_Slab", "Home", FormMethod.Post, new { @class = "vm-retailer-charge-filter vm-prepaid-user-filter vm-prepaid-user-filter--inline slab-master-block" }))
                            {
                                <div class="vm-prepaid-user-filter__row vm-cc-filter-row">
                                    <div class="vm-prepaid-user-filter__item vm-prepaid-user-filter__item--select">
                                        <div class="vm-pg-slab-field">
                                            <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-store"></i></span>
                                            @Html.DropDownList("DealerId", ViewBag.DealerId as SelectList, "Select Distributor", new { @class = "form-control for-select2", onchange = "SelectDealer(this)" })
                                        </div>
                                    </div>
                                    <div class="vm-prepaid-user-filter__item vm-prepaid-user-filter__item--select">
                                        <div class="vm-pg-slab-field">
                                            <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-user-tag"></i></span>
                                            @Html.DropDownList("RetailerId", Enumerable.Empty<SelectListItem>(), "Select Retailer", new { @class = "form-control for-select2" })
                                        </div>
                                    </div>
                                    <div class="vm-prepaid-user-filter__item vm-cc-filter-search">
                                        <button type="submit" class="vm-retailer-charge-search-btn">
                                            <i class="fas fa-search" aria-hidden="true"></i>
                                            <span>Search</span>
                                        </button>
                                    </div>
                                </div>
                            }

                            <div class="vm-retailer-charge-actions">
                                <div class="vm-prepaid-slab-actions vm-cc-charge-actions">
                                    <button type="button" id="btnBulkEdit" class="vm-prepaid-slab-action-btn" data-toggle="modal" data-target="#billBulkModal">
                                        <i class="fas fa-users-cog" aria-hidden="true"></i>
                                        Edit All Users
                                    </button>
                                    <button type="button" id="btnEdit" class="vm-pg-slab-btn-edit" onclick="showRetailerChargeEditMode()">
                                        <img src="~/AdminDesign/images/edit.svg" alt="" />
                                        <span>Edit Slab</span>
                                    </button>
                                    <button type="button" id="btnSave" class="vm-pg-slab-save-btn" onclick="saveRetailerCharges()" style="display:none;">
                                        <span>Save</span>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div id="divEditFormComm" class="vm-pg-slab-edit-table">
                            @using (Ajax.BeginForm("UpdateCreditBillPaymentCartCharges", "Home", new AjaxOptions { HttpMethod = "POST" }, new { id = "chargesForm" }))
                            {
                                <div class="vm-pg-slab-table-scroll saas-acc-table-wrap vm-prepaid-slab-table-wrap vm-retailer-charge-table-wrap">
                                    <table class="table table-bordered vm-pg-slab-table slab-table third-design-table" id="creditBillPaymentTable">
                                        <thead>
                                            <tr>
                                                <th>Retailer Name</th>
                                                <th>Charge</th>
                                            </tr>
                                        </thead>
                                        <tbody id="tbodyshow" class="vm-pg-slab-tbody--view">
                                            @if (rows.Count > 0)
                                            {
                                                foreach (var item in rows)
                                                {
                                                    <tr>
                                                        <td class="vm-retailer-charge-name">@item.Frm_Name</td>
                                                        <td>
                                                            <span class="vm-charge-view">@item.Charge</span>
                                                            <div class="vm-charge-edit">
                                                                <input type="hidden" name="RetailerId" value="@item.RetailerId" />
                                                                <input step="any" type="number" name="Charges" value="@item.Charge" class="form-control vm-pg-slab-cell-input charge-input" readonly="readonly" />
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="2" class="vm-retailer-charge-empty">No data found</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div id="billBulkModal" class="modal fade saas-admin-modal vm-prepaid-modal vm-prepaid-modal--md vm-retailer-charge-bulk-modal vm-cc-billpayment-bulk-modal" tabindex="-1" role="dialog" aria-labelledby="billBulkModalLabel" aria-hidden="true">
    <div class="modal-dialog saas-admin-modal-dialog vm-retailer-bulk-modal-dialog" role="document">
        <div class="modal-content vm-retailer-bulk-modal-content">
            @using (Html.BeginForm("UpdateCreditCardBillpaymentAllUser", "Home", FormMethod.Post, new { id = "billBulkForm", @class = "vm-cc-bulk-modal-form" }))
            {
                <div class="modal-header saas-admin-modal-header accent-sky vm-retailer-bulk-modal-header">
                    <div class="saas-admin-modal-head-main">
                        <div class="saas-admin-modal-icon"><i class="fas fa-file-invoice-dollar" aria-hidden="true"></i></div>
                        <div class="saas-admin-modal-title-wrap">
                            <h4 class="modal-title saas-admin-modal-title" id="billBulkModalLabel">Update All Users</h4>
                            <p class="saas-admin-modal-subtitle">Apply same bill payment charge for all retailers</p>
                        </div>
                    </div>
                    <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
                </div>
                <div class="modal-body saas-admin-modal-body saas-admin-modal-scroll vm-retailer-bulk-modal-body">
                    <p class="vm-prepaid-modal-note vm-retailer-charge-modal-note">
                        This charge will be applied to all retailers in the system. Use individual edit for specific retailer changes only.
                    </p>
                    <div class="vm-retailer-charge-modal-field vm-cc-billpayment-charge-field">
                        <label for="AllCharge">
                            <i class="fas fa-percentage" aria-hidden="true"></i>
                            Bill Payment Charge
                        </label>
                        <input id="AllCharge" class="vm-prepaid-modal-input" type="number" step="any" name="AllCharge" value="0.00" placeholder="Enter charge amount" />
                        <small>Service charge applied per credit card bill payment transaction</small>
                    </div>
                </div>
                <div class="modal-footer saas-admin-modal-footer vm-retailer-bulk-modal-footer">
                    <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="saas-admin-modal-btn saas-admin-modal-btn--success">
                        <i class="fas fa-save" aria-hidden="true"></i>
                        Save Changes
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<script>
    function initRetailerChargeUi() {
        if ($.fn.select2) {
            $('.saas-retailer-charge-slab-page .for-select2').each(function () {
                var $el = $(this);
                try {
                    if ($el.hasClass('select2-hidden-accessible')) {
                        $el.select2('destroy');
                    }
                } catch (e) { }
                $el.select2({
                    width: '100%',
                    dropdownParent: $(document.body)
                });
            });
        }
    }

    function resetRetailerChargeViewMode() {
        $('#retailerChargePage').removeClass('is-edit-mode');
        $('.charge-input').attr('readonly', 'readonly');
        $('#btnEdit').show().removeClass('is-hidden');
        $('#btnSave').hide().removeClass('is-visible');
        $('#btnBulkEdit').show().removeClass('is-hidden');
    }

    function showRetailerChargeEditMode() {
        $('#retailerChargePage').addClass('is-edit-mode');
        $('.charge-input').removeAttr('readonly');
        $('#btnEdit').hide().addClass('is-hidden');
        $('#btnBulkEdit').hide().addClass('is-hidden');
        $('#btnSave').show().addClass('is-visible');
    }

    function saveRetailerCharges() {
        $('#chargesForm').submit();
    }

    function SelectDealer(dealer) {
        var selectedValue = dealer.value;
        $.ajax({
            type: 'GET',
            url: '@Url.Action("GetRetailer", "Home")',
            data: { dealerId: selectedValue },
            success: function (data) {
                var selectElement = $('#RetailerId');
                selectElement.empty();
                selectElement.append('<option value="">Select Retailer</option>');
                for (var i = 0; i < data.retailer.length; i++) {
                    var retailer = data.retailer[i];
                    selectElement.append('<option value="' + retailer.Value + '">' + retailer.Text + '</option>');
                }
                initRetailerChargeUi();
            },
            error: function (error) {
                console.log('Error:', error);
            }
        });
    }

    $(document).ready(function () {
        initRetailerChargeUi();
        resetRetailerChargeViewMode();

        $('#billBulkModal').on('shown.bs.modal', function () {
            $(this).find('.vm-retailer-bulk-modal-body').scrollTop(0);
        });
    });
</script>
