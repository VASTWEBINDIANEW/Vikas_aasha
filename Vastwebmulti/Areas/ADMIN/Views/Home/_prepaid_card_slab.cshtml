@model Vastwebmulti.Areas.ADMIN.Models.prepaid_card1
@using (Ajax.BeginForm("_prepaid_card_slab", "Home", new AjaxOptions { HttpMethod = "POST", OnSuccess = "OnSuccess1", OnFailure = "onfailed", UpdateTargetId = "divEditFormComm", LoadingElementId = "div_Loader", InsertionMode = InsertionMode.Replace }))
{
    <input id="btnsubmitusercommon" type="button" onclick="otpsend1()" name="Button" value="Save Data" class="btn waves-effect vm-pg-slab-save-btn" style="display:none;" />

    <input type="hidden" value="@Model.role" id="role" />
    <div class="row clearfix" style="margin-right:0px;">
        <div class="col-md-12">
            <div class="slab-master-block vm-prepaid-user-filter vm-prepaid-user-filter--inline">
                <div id="slab-master-detail" class="slab-master-detail slab-master-detail-hide vm-prepaid-user-filter__row" style="display: block;">
                    <div class="vm-prepaid-user-filter__item vm-prepaid-user-filter__item--select">
                        <div class="vm-pg-slab-field">
                            <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-users"></i></span>
                            @Html.DropDownList("ddlUserId", Model.UserId, "All Users", new { @class = "form-control for-select2", @onchange = "ddlUserIdChange()" })
                        </div>
                    </div>
                    @if (Model.role == "Retailer")
                    {
                        <div class="vm-prepaid-user-filter__item">
                            <div class="vm-pg-slab-field">
                                <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-store"></i></span>
                                @Html.DropDownList("ddlUserIdrem", Model.RetailerId, "All Retailer", new { @class = "form-control for-select2", @onchange = "ddlUserIdChangerem()" })
                            </div>
                        </div>
                    }
                    <div class="vm-prepaid-user-filter__item">
                        <div class="vm-pg-slab-field">
                            <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-user"></i></span>
                            <input class="form-control" type="text" placeholder="User Name" value="@Model.Name" readonly="readonly" />
                        </div>
                    </div>
                    <div class="vm-prepaid-user-filter__item">
                        <div class="vm-pg-slab-field">
                            <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-phone-alt"></i></span>
                            <input class="form-control" type="text" placeholder="User Registered Number" value="@Model.Phone" readonly="readonly" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="vm-pg-slab-table-scroll saas-acc-table-wrap vm-prepaid-slab-table-wrap">
        <table id="prepaidCardUserSlabTable" class="table table-bordered vm-pg-slab-table third-design-table slab-table example-second">
            <thead>
                <tr>
                    <th>User</th>
                    <th>Comm&nbsp;%</th>
                </tr>
            </thead>
            <tbody id="tbodyshow" class="vm-pg-slab-tbody--view">
                @foreach (var item in Model.usersd)
                {
                    <tr>
                        <td class="text-center">@item.Email</td>
                        <td class="text-center" id="text12">@item.Comm</td>
                    </tr>
                }
            </tbody>
            <tbody id="tbodyedit" class="vm-pg-slab-tbody--hidden">
                @for (int i = 0; i < Model.updateset.Count; i++)
                {
                    <tr>
                        @Html.HiddenFor(a => a.updateset[i].idno, new { id = "idnoset" })
                        <td>
                            @Html.TextBoxFor(a => a.updateset[i].Email, new { @readonly = "readonly", id = "EMailSet" })
                        </td>
                        @Html.HiddenFor(a => a.updateset[i].Role, new { id = "RoleSet" })
                        <td class="vm-pg-slab-edit-cell">
                            @Html.TextBoxFor(a => a.updateset[i].Comm, new { id = "Commset", @class = "vm-pg-slab-cell-input" })
                            @Html.ValidationMessageFor(a => a.updateset[i].Comm)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<script>
    function otpsend1() {
        var id = $('#idnoset').val();
        var com = $('#Commset').val();
        var role = $('#RoleSet').val();
        var email = $('#EMailSet').val();

        $.ajax({
            url: '@Url.Action("updatesetpccomm", "Home")',
            type: 'POST',
            data: { id: id, comm: com, roles: role, Emails: email },
            dataType: "JSON"
        });

        if (typeof resetSlabViewMode === 'function') {
            resetSlabViewMode();
        } else {
            $('#btnsubmitusercommon').hide().removeClass('is-visible');
            $('#btnEdit').show().removeClass('is-hidden');
            $('#tbodyshow').removeClass('vm-pg-slab-tbody--hidden').addClass('vm-pg-slab-tbody--view');
            $('#tbodyedit').addClass('vm-pg-slab-tbody--hidden');
        }

        if (document.getElementById('text12')) {
            document.getElementById('text12').innerHTML = com;
        }
    }

    function OnSuccess1(data) {
        if (typeof resetSlabViewMode === 'function') {
            resetSlabViewMode();
        }
    }

    function onfailed(error) {
        alert(error.responseText);
    }
</script>
