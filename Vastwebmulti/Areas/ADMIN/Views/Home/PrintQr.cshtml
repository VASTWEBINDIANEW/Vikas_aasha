@using System
@using Vastwebmulti.Models
@using System.Linq
@model Vastwebmulti.Areas.ADMIN.Models.QRCODE_Details
@{
    ViewBag.Title = "Print QR Code";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var qrDetails = Model?.QRDetails ?? Enumerable.Empty<Vastwebmulti.Areas.ADMIN.Models.details>();
    var qrCount = qrDetails.Count();

    VastwebmultiEntities db = new VastwebmultiEntities();
    var acticeapi = db.UPI_API.SingleOrDefault();
    var showDelete = acticeapi != null && acticeapi.APIID == "PAYU";

    Func<string, string> resolveImagePath = path =>
    {
        if (string.IsNullOrWhiteSpace(path))
        {
            return "";
        }
        path = path.Trim();
        if (path.StartsWith("data:", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("//", StringComparison.Ordinal))
        {
            return path;
        }
        return Url.Content("~" + path.TrimStart('~', '/'));
    };

    var logoPath = Model != null && !string.IsNullOrWhiteSpace(Model.logoimage)
        ? resolveImagePath(Model.logoimage)
        : "";
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=53" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=29" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-prepaid-card-report-page saas-print-qr-page">

    <div class="container-fluid vm-opr-page-shell">

        @using (Html.BeginForm("PrintQr", "Home", FormMethod.Post, new { id = "printQrForm", @class = "vm-rpt-filters-panel__form" }))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-print-qr-toolbar-head vm-print-qr-toolbar-head--one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb vm-print-qr-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Report's</li>
                        <li>Print QR Code</li>
                    </ol>

                    <div class="vm-print-qr-role-tabs" role="tablist" aria-label="User type">
                        <button type="button" class="vm-print-qr-role-tab is-active" aria-selected="true">Retailer</button>
                        <button type="button" class="vm-print-qr-role-tab">Master Distributor</button>
                        <button type="button" class="vm-print-qr-role-tab">Distributor</button>
                        <button type="button" class="vm-print-qr-role-tab">Api User</button>
                        <button type="button" class="vm-print-qr-role-tab">White Label</button>
                    </div>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-print-qr-filter-row vm-print-qr-filter-row--inline">
                        <div class="vm-opr-field vm-dmt-field vm-print-qr-field--retailer">
                            @Html.DropDownList("RetailerList", (IEnumerable<SelectListItem>)ViewBag.allretailer, "Select Retailer", new { id = "RetailerDDL", @class = "vm-opr-select vm-dmt-select form-control for-select2", data_live_search = "true" })
                        </div>
                        <div class="vm-dmt-filter-search-group">
                            <button type="submit" id="btnsubmit" name="btnsubmit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>
                    </div>

                </div>

            </div>
        }

        <div class="vm-opr-main-card vm-security-report-main-card vm-gift-report-main-card vm-prepaid-report-main-card vm-print-qr-main-card">
            <div class="vm-opr-table-panel vm-security-report-table-panel vm-gift-report-table-panel vm-prepaid-report-table-panel vm-print-qr-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head vm-security-report-table-head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-qrcode" aria-hidden="true"></i>
                        <span>Print QR Code</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total QR cards">
                            Records: <strong id="printQrRecordCount">@qrCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total vm-print-qr-selected-badge" title="Selected QR cards">
                            Selected: <strong id="printQrSelectedCount">0</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" id="btnSelectAllQr" class="saas-acc-btn saas-acc-btn--outline vm-print-qr-action-btn" title="Select all QR cards">
                                <i class="fas fa-check-square" aria-hidden="true"></i> Select All
                            </button>
                            @if (showDelete)
                            {
                                <button type="button" id="btnDeleteQr" class="saas-acc-btn saas-acc-btn--pdf vm-print-qr-action-btn vm-print-qr-action-btn--delete" title="Delete selected QR">
                                    <i class="fas fa-trash-alt" aria-hidden="true"></i> Delete
                                </button>
                            }
                            <button type="button" id="btnPrintQr" class="saas-acc-btn saas-acc-btn--excel vm-print-qr-action-btn vm-print-qr-action-btn--print" title="Print selected QR">
                                <i class="fas fa-print" aria-hidden="true"></i> Print
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-print-qr-grid-wrap">
                    @if (qrDetails.Any())
                    {
                        <div class="vm-print-qr-grid" id="printQrGrid">
                            @foreach (var item in qrDetails)
                            {
                                var checkId = "qr_" + item.userid;
                                <article class="vm-print-qr-card" data-user-id="@item.userid">
                                    <div class="vm-print-qr-card__check">
                                        <input type="checkbox" id="@checkId" name="sport" value="@item.userid" class="vm-print-qr-card__checkbox" />
                                        <label for="@checkId" class="vm-print-qr-card__check-label" aria-label="Select @item.firmname"></label>
                                    </div>
                                    <div class="vm-print-qr-card__body">
                                        <div class="vm-print-qr-card__brands">
                                            <div class="vm-print-qr-card__brand vm-print-qr-card__brand--upi">
                                                <img src="~/AdminDesign/images/bhim-upi.png" alt="BHIM UPI" />
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(logoPath))
                                            {
                                                <div class="vm-print-qr-card__brand vm-print-qr-card__brand--logo">
                                                    <img src="@logoPath" alt="Logo" />
                                                </div>
                                            }
                                        </div>
                                        <div class="vm-print-qr-card__meta vm-print-qr-card__meta--line">
                                            <span class="vm-print-qr-card__meta-item" title="@item.firmname">
                                                <img src="@Url.Content("~/AdminDesign/images/retail.svg")" alt="" />
                                                <span>@item.firmname</span>
                                            </span>
                                            <span class="vm-print-qr-card__meta-item" title="@item.MerchantVPA">
                                                <img src="@Url.Content("~/AdminDesign/images/qr-codes.svg")" alt="" />
                                                <span>@item.MerchantVPA</span>
                                            </span>
                                            <span class="vm-print-qr-card__meta-item" title="@item.Mobile">
                                                <img src="@Url.Content("~/AdminDesign/images/call.svg")" alt="" />
                                                <span>@item.Mobile</span>
                                            </span>
                                        </div>
                                        <div class="vm-print-qr-card__qr">
                                            <p class="vm-print-qr-card__qr-title">Accepted Here All UPI Payments</p>
                                            <div class="vm-print-qr-card__qr-image">
                                                <img src="@resolveImagePath(item.QRCODE)" alt="QR code for @item.firmname" />
                                            </div>
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="vm-print-qr-empty">
                            <i class="fas fa-qrcode" aria-hidden="true"></i>
                            <span>No QR code found for the selected retailer.</span>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</section>

<script>
    function getSelectedQrIds() {
        var ids = [];
        $('input[name="sport"]:checked').each(function () {
            ids.push($(this).val());
        });
        return ids;
    }

    function refreshPrintQrSummary() {
        var total = $('input[name="sport"]').length;
        var selected = $('input[name="sport"]:checked').length;
        $('#printQrRecordCount').text(total);
        $('#printQrSelectedCount').text(selected);
    }

    function printQrSelected() {
        var favorite = getSelectedQrIds();
        if (!favorite.length) {
            alert('Please select at least one QR code to print.');
            return;
        }
        var url = '@Url.Action("Print_QR", "Home", new { useriddata = "__param__" })';
        url = url.replace('__param__', favorite.join(','));
        window.open(url, '_blank');
    }

    function deleteQrSelected() {
        var favorite = getSelectedQrIds();
        if (!favorite.length) {
            alert('Please select at least one QR code to delete.');
            return;
        }
        if (!confirm('Delete selected QR code(s)?')) {
            return;
        }
        var url = '@Url.Action("Delete_QR", "Home", new { useriddata = "__param__" })';
        url = url.replace('__param__', favorite.join(','));
        window.open(url, '_blank');
    }

    function toggleSelectAllQr() {
        var $checks = $('input[name="sport"]');
        if (!$checks.length) {
            return;
        }
        var allChecked = $checks.filter(':checked').length === $checks.length;
        $checks.prop('checked', !allChecked);
        refreshPrintQrSummary();
    }

    function initPrintQrSelect2() {
        var $el = $('#RetailerDDL');
        if (!$el.length || !$.fn.select2) {
            return;
        }
        if ($el.data('select2')) {
            $el.select2('destroy');
        }
        $el.select2({
            width: '100%',
            minimumResultsForSearch: 0,
            allowClear: true,
            placeholder: 'Select Retailer'
        });
    }

    $(document).ready(function () {
        initPrintQrSelect2();
        refreshPrintQrSummary();

        $('#btnPrintQr').on('click', printQrSelected);
        $('#btnDeleteQr').on('click', deleteQrSelected);
        $('#btnSelectAllQr').on('click', toggleSelectAllQr);

        $(document).on('change', 'input[name="sport"]', refreshPrintQrSummary);

        $('.vm-print-qr-role-tab').on('click', function () {
            $('.vm-print-qr-role-tab').removeClass('is-active').attr('aria-selected', 'false');
            $(this).addClass('is-active').attr('aria-selected', 'true');
        });
    });
</script>
