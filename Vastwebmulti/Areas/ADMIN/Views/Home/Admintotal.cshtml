@using Vastwebmulti.Models
@{
    ViewBag.Title = "Admintotal";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var db = new VastwebmultiEntities();
    var adminBal = db.Remain_Admin_balance.FirstOrDefault();
    var totals = db.Total_account().FirstOrDefault();

    decimal virtualAmt = adminBal?.VirtualAmount ?? 0m;
    decimal adminRemain = adminBal?.RemainAmount ?? 0m;
    decimal adminTotal = totals?.totaladmin ?? 0m;
    decimal networkTotal = totals?.total ?? 0m;

    decimal adminOpening = 0m;
    decimal transaction = 0m;
    decimal fundTransfer = 0m;
    decimal sharing = 0m;
    decimal oldRefund = 0m;
    decimal oldSuccess = 0m;
    decimal adminClosing = adminRemain;
    decimal lossDiff = networkTotal - virtualAmt;

    Func<decimal, string> fmt = v => v.ToString("N2");
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />

<section class="content fourdesign-section-admin saas-admin-account-page">
    <div class="container-fluid">

        

        <div class="saas-acc-toolbar">
            <ol class="saas-acc-breadcrumb">
                <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                <li>Admin Business</li>
            </ol>
            <div class="saas-acc-toolbar-right">
                <div class="saas-acc-search">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    <input class="form-control" id="myInput" type="text" placeholder="Filter table values..." autocomplete="off" />
                </div>
                <div class="saas-acc-export-group">
                    <button type="button" class="saas-acc-btn saas-acc-btn--excel" id="btnExport" onclick="exportAdminTotalExcel()">
                        <i class="fas fa-file-excel" aria-hidden="true"></i> Export
                    </button>
                    <button type="button" class="saas-acc-btn saas-acc-btn--pdf" id="btnPDF" onclick="exportAdminTotalPdf()">
                        <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                    </button>
                </div>
            </div>
        </div>

        
        <div class="saas-acc-table-card">
            <div class="saas-acc-table-card-head">
                <h3>Ledger breakdown</h3>
                <span>All amounts in ₹ (INR)</span>
            </div>
            <div class="saas-acc-table-wrap table-responsive">
                <table id="adminTotalTable" class="table saas-acc-table example-second third-design-table">
                    <thead>
                        <tr>
                            <th>Total Virtual</th>
                            <th>Admin Opening</th>
                            <th>Transaction</th>
                            <th>Fund Transfer</th>
                            <th>Sharing</th>
                            <th>Old Refund</th>
                            <th>Old Success</th>
                            <th>Admin Closing</th>
                            <th>Loss (Diff.)</th>
                        </tr>
                    </thead>
                    <tbody id="adminTotalBody">
                        <tr>
                            <td class="col-virtual" data-label="Total Virtual">@fmt(virtualAmt)</td>
                            <td data-label="Admin Opening">@fmt(adminOpening)</td>
                            <td data-label="Transaction">@fmt(transaction)</td>
                            <td data-label="Fund Transfer">@fmt(fundTransfer)</td>
                            <td data-label="Sharing">@fmt(sharing)</td>
                            <td data-label="Old Refund">@fmt(oldRefund)</td>
                            <td data-label="Old Success">@fmt(oldSuccess)</td>
                            <td data-label="Admin Closing">@fmt(adminClosing)</td>
                            <td class="col-loss @(lossDiff == 0 ? "is-zero" : "")" data-label="Loss">@fmt(lossDiff)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</section>

<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.22/pdfmake.min.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.4.1/html2canvas.min.js"></script>
<script>
    $(document).ready(function () {
        if ($.fn.DataTable && $('#adminTotalTable').length) {
            $('#adminTotalTable').DataTable({
                bSort: false,
                paging: false,
                searching: false,
                info: false
            });
        }

        $("#myInput").on("keyup", function () {
            var value = $(this).val().toLowerCase();
            var match = false;
            $("#adminTotalBody tr").each(function () {
                var rowText = $(this).text().toLowerCase();
                var show = rowText.indexOf(value) > -1;
                $(this).toggle(show);
                if (show) match = true;
            });
            $(".saas-acc-metric").each(function () {
                var text = $(this).text().toLowerCase();
                $(this).toggle(text.indexOf(value) > -1);
            });
        });
    });

    function exportAdminTotalExcel() {
        var table = document.getElementById('adminTotalTable');
        if (!table) return;
        var csv = [];
        table.querySelectorAll('tr').forEach(function (row) {
            var cols = [];
            row.querySelectorAll('th, td').forEach(function (cell) {
                cols.push('"' + (cell.innerText || '').replace(/"/g, '""') + '"');
            });
            csv.push(cols.join(','));
        });
        var blob = new Blob([csv.join('\n')], { type: 'text/csv;charset=utf-8;' });
        var link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = 'Admin_Account_Detail.csv';
        link.click();
    }

    function exportAdminTotalPdf() {
        var el = document.querySelector('.saas-acc-table-card');
        if (!el || typeof html2canvas === 'undefined') return;
        html2canvas(el, {
            onrendered: function (canvas) {
                var data = canvas.toDataURL();
                var docDefinition = {
                    content: [{ image: data, width: 500 }]
                };
                pdfMake.createPdf(docDefinition).download('Admin_Account_Detail.pdf');
            }
        });
    }
</script>
