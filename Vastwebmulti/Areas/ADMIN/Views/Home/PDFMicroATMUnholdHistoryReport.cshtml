@model IEnumerable<Vastwebmulti.Models.Show_MicroAtM_UnholdHistory_Result>
@using System.Linq
@{
    Layout = null;
    var rows = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.Show_MicroAtM_UnholdHistory_Result>();
    var totalAmount = rows.Sum(r => r.amount ?? 0);
    var frmDate = ViewBag.frmDate as string ?? "";
    var toDate = ViewBag.toDate as string ?? "";
    var generatedOn = DateTime.Now.ToString("dd MMM yyyy, hh:mm tt");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Micro ATM Unhold History</title>
    <style type="text/css">
        @@page { size: A4 landscape; margin: 12mm 8mm 14mm 8mm; }
        * { box-sizing: border-box; }
        body { margin:0; padding:0; font-family:Arial,Helvetica,sans-serif; font-size:9px; color:#1e293b; background:#fff; -webkit-print-color-adjust:exact; print-color-adjust:exact; }
        table { page-break-inside:auto; border-collapse:collapse; }
        tr { page-break-inside:avoid; page-break-after:auto; }
        thead { display:table-header-group; }
        .vm-ml-pdf { width:100%; }
        .vm-ml-pdf__header { width:100%; margin-bottom:14px; border:1px solid #dbe2ea; border-radius:10px; overflow:hidden; }
        .vm-ml-pdf__hero { padding:12px 20px; background:#2563eb; background:-webkit-linear-gradient(135deg,#2563eb,#4f46e5); background:linear-gradient(135deg,#2563eb 0%,#4f46e5 100%); color:#fff; -webkit-print-color-adjust:exact; print-color-adjust:exact; }
        .vm-ml-pdf__title { margin:0; font-size:16px; font-weight:700; }
        .vm-ml-pdf__subtitle { margin:3px 0 0; font-size:10px; opacity:.9; }
        .vm-ml-pdf__meta { width:100%; border-top:1px solid #e2e8f0; background:#f8fafc; }
        .vm-ml-pdf__meta td { padding:7px 10px; border-right:1px solid #e2e8f0; vertical-align:middle; }
        .vm-ml-pdf__meta td:last-child { border-right:none; }
        .vm-ml-pdf__meta-label { display:block; font-size:8px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:#64748b; margin-bottom:2px; }
        .vm-ml-pdf__meta-value { font-size:10px; font-weight:700; color:#0f172a; }
        .vm-ml-pdf__table-wrap { width:100%; border:1px solid #dbe2ea; border-radius:10px; overflow:hidden; }
        .vm-ml-pdf__table { width:100%; border:none; }
        .vm-ml-pdf__table thead th { padding:7px 5px; text-align:left; font-size:7.5px; font-weight:700; text-transform:uppercase; letter-spacing:.04em; color:#fff; background:#334155; -webkit-print-color-adjust:exact; print-color-adjust:exact; border-bottom:2px solid #1e293b; white-space:nowrap; }
        .vm-ml-pdf__table tbody td { padding:6px 5px; border-bottom:1px solid #e2e8f0; vertical-align:middle; font-size:8.5px; color:#334155; }
        .vm-ml-pdf__table tbody tr:nth-child(even) td { background:#f8fafc; }
        .vm-ml-pdf__table tfoot td { padding:6px 5px; font-weight:700; background:#f1f5f9; border-top:2px solid #334155; font-size:8.5px; }
        .vm-ml-pdf__sr { width:28px; text-align:center; font-weight:700; color:#64748b; }
        .vm-ml-pdf__firm { font-weight:700; color:#0f172a; }
        .vm-ml-pdf__mono { font-family:"Courier New",monospace; font-size:8px; }
        .vm-ml-pdf__amt  { font-weight:700; color:#2563eb; white-space:nowrap; text-align:right; }
        .vm-ml-pdf__empty { padding:24px 16px; text-align:center; color:#64748b; font-size:11px; font-weight:600; }
        .vm-ml-pdf__footer { margin-top:10px; padding-top:7px; border-top:1px dashed #dbe2ea; font-size:8.5px; color:#94a3b8; text-align:center; }
    </style>
</head>
<body>
<div class="vm-ml-pdf">
    <div class="vm-ml-pdf__header">
        <div class="vm-ml-pdf__hero">
            <h1 class="vm-ml-pdf__title">Micro ATM Unhold History</h1>
            <p class="vm-ml-pdf__subtitle">Period: @frmDate to @toDate &mdash; Admin Panel</p>
        </div>
        <table class="vm-ml-pdf__meta" cellpadding="0" cellspacing="0">
            <tr>
                <td style="width:25%;"><span class="vm-ml-pdf__meta-label">Generated On</span><span class="vm-ml-pdf__meta-value">@generatedOn</span></td>
                <td style="width:25%;"><span class="vm-ml-pdf__meta-label">Total Records</span><span class="vm-ml-pdf__meta-value">@rows.Count</span></td>
                <td style="width:25%;"><span class="vm-ml-pdf__meta-label">Total Amount</span><span class="vm-ml-pdf__meta-value">@totalAmount.ToString("N2")</span></td>
                <td style="width:25%;"><span class="vm-ml-pdf__meta-label">Report Type</span><span class="vm-ml-pdf__meta-value">Micro ATM Unhold History</span></td>
            </tr>
        </table>
    </div>
    <div class="vm-ml-pdf__table-wrap">
        @if (rows.Any())
        {
            <table class="vm-ml-pdf__table" cellpadding="0" cellspacing="0">
                <thead>
                    <tr>
                        <th class="vm-ml-pdf__sr">#</th>
                        <th>Firm</th>
                        <th>Unhold By</th>
                        <th>RRN</th>
                        <th>Txn Type</th>
                        <th>Payment</th>
                        <th>Amount</th>
                        <th>Card Pay</th>
                        <th>PAN</th>
                        <th>Ret. Pre</th>
                        <th>Ret. Post</th>
                        <th>Network</th>
                        <th>Usage</th>
                        <th>Unhold Time</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var sr = 0; }
                    @foreach (var item in rows)
                    {
                        sr++;
                        <tr>
                            <td class="vm-ml-pdf__sr">@sr</td>
                            <td class="vm-ml-pdf__firm">@item.frmname</td>
                            <td>@item.Person_name</td>
                            <td class="vm-ml-pdf__mono">@item.rrn</td>
                            <td>@item.transaction_type</td>
                            <td>@item.payment_method</td>
                            <td class="vm-ml-pdf__amt">@(item.amount.HasValue ? item.amount.Value.ToString("N2") : "0.00")</td>
                            <td>@item.card_payment_type</td>
                            <td class="vm-ml-pdf__mono">@item.masked_pan</td>
                            <td>@item.retailer_remain_pre</td>
                            <td>@item.retailer_remain_post</td>
                            <td>@item.network</td>
                            <td>@item.card_usage_type</td>
                            <td>@item.unhold_transection_time</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="6">Total</td>
                        <td class="vm-ml-pdf__amt">@totalAmount.ToString("N2")</td>
                        <td colspan="7"></td>
                    </tr>
                </tfoot>
            </table>
        }
        else { <div class="vm-ml-pdf__empty">No records found.</div> }
    </div>
    <div class="vm-ml-pdf__footer">Micro ATM Unhold History &mdash; @generatedOn</div>
</div>
</body>
</html>
