@model IEnumerable<Vastwebmulti.Models.total_bussiness_dashboard_Result>
@using System.Linq

@{
    var totalSuccess = Model.Where(aa => aa.Rstaus.ToUpper() == "SUCCESS").Sum(aa => aa.total);
    var totalPending = Model.Where(aa => aa.Rstaus.ToUpper() == "PENDING").Sum(aa => aa.total);
    var totalFailed = Model.Where(aa => aa.Rstaus.ToUpper() == "FAILED").Sum(aa => aa.total);
}

<div class="vm-bbo-ajax-content">

<div class="vm-bbo-summary-bar">
    <div class="vm-bbo-summary-grid">
        <div class="vm-bbo-summary-tile vm-bbo-summary-tile--total">
            <button type="button" class="vm-bbo-summary-tile__btn first-success btnssl2233 special-iii" title="Total business overview">
                <i class="fas fa-chart-line" aria-hidden="true"></i>
                <span class="vm-bbo-summary-tile__label">Total Business</span>
            </button>
        </div>
        <div class="vm-bbo-summary-tile vm-bbo-summary-tile--success">
            <span class="vm-bbo-summary-tile__label">Success</span>
            <strong class="vm-bbo-summary-tile__value">@totalSuccess</strong>
        </div>
        <div class="vm-bbo-summary-tile vm-bbo-summary-tile--pending">
            <span class="vm-bbo-summary-tile__label">Pending</span>
            <strong class="vm-bbo-summary-tile__value">@totalPending</strong>
        </div>
        <div class="vm-bbo-summary-tile vm-bbo-summary-tile--failed">
            <span class="vm-bbo-summary-tile__label">Failed</span>
            <strong class="vm-bbo-summary-tile__value">@totalFailed</strong>
        </div>
    </div>
</div>

