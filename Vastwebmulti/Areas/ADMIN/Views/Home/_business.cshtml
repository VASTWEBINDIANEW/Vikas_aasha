<script>
    function show(data) {
        if (typeof bboShowLoader === 'function') {
            bboShowLoader(true);
        }

        var date = $('#txt_frm_date').val();
        var url = '@Url.Action("_business_Operator", "Home")';

        $.post(url, { data: data, frmdate: date }, function (response) {
            if (typeof bboShowLoader === 'function') {
                bboShowLoader(false);
            }

            $('.gross-business-first').hide();
            $('.gross-business-second').show();
            $('#business_s').html(response);

            if (typeof bindBboTotalsToggle === 'function') {
                bindBboTotalsToggle();
            }
        }).fail(function () {
            if (typeof bboShowLoader === 'function') {
                bboShowLoader(false);
            }
        });
    }
</script>
