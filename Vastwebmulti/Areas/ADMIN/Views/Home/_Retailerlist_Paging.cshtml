@model Vastwebmulti.Areas.ADMIN.Models.RetailerDetalsModel


@if (Model.select_retailer_details_paging != null)
{
    int i = 0;
    int id = 51;
    foreach (var item in Model.select_retailer_details_paging)
    {
        var idno = "subTbl";
        idno = idno + i;

        var idshow = "subTblshow";
        idshow = idshow + i;

        var idhide = "subTblhide";
        idhide = idhide + i;


        var colorchange = "";
        var borderleft = "";
        var imggg = "";
        if (item.aadharcardPath != null && item.BackSideAadharcardphoto != null && item.pancardPath != null)
        {
            if (item.PSAStatus == "N" && item.AadhaarStatus == "N")
            {
                colorchange = "#dbdb70";

                borderleft = "7px solid var(--main-bg-lcolor)";
                imggg = "☻";

            }

        }


        <tr class="tr vm-ml-parent-row @(!string.IsNullOrEmpty(colorchange) ? "vm-rl-row--pending" : "")" style="@(string.IsNullOrEmpty(colorchange) ? null : "background-color:" + colorchange)">
            <td class="vm-rl-sr">@id</td>
            <td class="vm-rl-user-cell">
                @Html.Partial("_RetailerlistUserCell", item)
            </td>
            <td class="vm-rl-mobile-cell">
                <div class="vm-rl-mobile-cell__inner">
                    <div class="vm-rl-mobile-status">
                        @if (item.PhoneNumberConfirmed == true)
                        {
                            <span class="securtyoff-show vm-rl-status-dot vm-rl-status-dot--on"></span>
                        }
                        else
                        {
                            <span class="securtyoff-show vm-rl-status-dot vm-rl-status-dot--off"></span>
                        }
                    </div>
                    <div class="vm-rl-mobile-num">@item.Mobile</div>
                </div>
                @if (item.Demouser == true)
                {
                    <div class="demouser22"><span class="vm-rl-demo-badge">DEMO USER</span></div>
                }
            </td>
            <td class="vm-rl-distributor-cell@(string.IsNullOrEmpty(borderleft) ? "" : " vm-rl-cell--flag")" style="@(string.IsNullOrEmpty(borderleft) ? null : "border-left:" + borderleft)">@item.DealerFarmName</td>
            <td class="vm-rl-verify-cell">
                <div class="vm-rl-verify-cell__inner">
                @if (item.aadhar_verification == true)
                {
                    <span class="vm-ml-status-badge vm-ml-status-badge--done" title="Aadhar">Verified</span>
                }
                else
                {
                    <span class="vm-ml-status-badge vm-ml-status-badge--due" title="Aadhar">Unverify</span>
                }
                @if (item.pan_verification == true)
                {
                    <span class="vm-ml-status-badge vm-ml-status-badge--done" title="PAN">Verified</span>
                }
                else
                {
                    <span class="vm-ml-status-badge vm-ml-status-badge--due" title="PAN">Unverify</span>
                }
                @if (item.EmailConfirmed == true)
                {
                    <span class="vm-ml-status-badge vm-ml-status-badge--done" title="Email">Verified</span>
                }
                else
                {
                    <span class="vm-ml-status-badge vm-ml-status-badge--due" title="Email">Unverify</span>
                }
                </div>
            </td>
            <td class="vm-rl-wallet-cell">
                <div class="vm-rl-wallet-amt">@item.Remainamount</div>
                @if (item.caption > 0)
                {
                    <span class="vm-rl-cap-badge">Cap: @item.caption</span>
                }
            </td>
            <td class="vm-rl-permission-cell">
                <div class="vm-rl-permission-cell__inner">
                    @foreach (var itempermission in Model.Service_BlockUserwiseclslist)
                    {
                        if (item.RetailerId == itempermission.remid)
                        {
                            var isOn = itempermission.idno == itempermission.serviceidno && itempermission.servicestatus == true;
                            <button type="button" data-idno="@itempermission.basedupdate_id" class="vm-ml-toggle-btn vm-rl-perm-btn @(isOn ? "vm-rl-perm-btn--on costom-on" : "vm-rl-perm-btn--off custom-off") clscall" onclick="callstats(this)">
                                <i class="fas fa-coins" aria-hidden="true"></i><span>@(isOn ? "ON" : "OFF")</span>
                            </button>
                        }
                    }
                </div>
            </td>
            <td class="kyc-button vm-rl-kyc-cell vm-ml-ev-cell" onclick="mdActionBtn('@item.RetailerId'); return false;">
                <div class="vm-rl-kyc-cell__inner vm-ml-ev-cell__inner">
                @if (item.PSAStatus == "Y" && item.AadhaarStatus == "Y" && item.ShopwithSalfieStatus == "Y")
                {
                    <span class="vm-ml-status-badge vm-ml-status-badge--done">Done</span>
                }
                else
                {
                    <span class="vm-ml-status-badge vm-ml-status-badge--due">Due</span>
                }
                <i class="fas fa-chevron-right vm-ml-ev-arrow" aria-hidden="true"></i>
                </div>
            </td>
            <td class="vm-rl-video-kyc-cell">
                @if (item.videokycstatus == "Y")
                {
                    <span class="vm-ml-status-badge vm-ml-status-badge--done">Done</span>
                }
                else
                {
                    <span class="vm-ml-status-badge vm-ml-status-badge--due">Due</span>
                }
            </td>
        </tr>


        i++;
        id++;
    }

}