@model IEnumerable<Vastwebmulti.Models.Recharge_API_URLS>
@using System.Linq
@{
    ViewBag.Title = "Api_Name";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var apiRows = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.Recharge_API_URLS>();
    var selectedApinm = (Request["apinm"] ?? "").Trim();
    var apiFilterNames = apiRows
        .Select(a => a.API_Name)
        .Where(n => !string.IsNullOrWhiteSpace(n))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(n => n)
        .ToList();
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=28" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-api-operator-modern.css?v=20" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-api-operator-page saas-api-name-page">
    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
            <div class="saas-acc-toolbar-top vm-api-operator-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-api-operator-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li><a href="@Url.Action("Dashboard", "Home")#setting">Basic Setting</a></li>
                    <li>Set {Post} API</li>
                </ol>
                <div class="vm-dmt-fin-nav-row vm-api-operator-nav-wrap">
                    @Html.Partial("_menuapinm")
                </div>
            </div>

            <div class="vm-rpt-filters-panel vm-api-operator-filter-panel">
                <div class="saas-acc-filter-bar vm-opr-filter-row vm-api-operator-filter-row vm-rpt-filters-panel__bar">
                    <div class="vm-api-operator-filter-group vm-api-name-filter-group">
                        <div class="vm-opr-field vm-api-operator-field vm-api-name-field--api">
                            <select id="filterApinm" name="apinm" title="Api Name" class="form-control vm-opr-select vm-dmt-select vm-api-operator-select">
                                <option value="">Api Name</option>
                                @foreach (var name in apiFilterNames)
                                {
                                    if (string.Equals(name, selectedApinm, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <option value="@name" selected="selected">@name</option>
                                    }
                                    else
                                    {
                                        <option value="@name">@name</option>
                                    }
                                }
                            </select>
                        </div>
                        <button type="button" id="apiNameFilterBtn" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-api-operator-search-btn" title="Search">
                            <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                        </button>
                        <button type="button" class="saas-acc-btn saas-acc-btn--search vm-api-nm-add-btn" data-toggle="modal" data-target="#apiNameAddModal" title="Add New API">
                            <i class="fas fa-plus" aria-hidden="true"></i><span>Add New</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-upload" aria-hidden="true"></i>
                        <span>POST API configuration</span>
                    </div>
                    <label class="vm-api-operator-table-search" for="apiNameSearch">
                        <i class="fas fa-search" aria-hidden="true"></i>
                        <input type="text" id="apiNameSearch" placeholder="Search records..." autocomplete="off" />
                    </label>
                </div>
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="apiNameTable" class="table vm-opr-data-table vm-api-name-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>API Name</th>
                                    <th>API ID</th>
                                    <th>API Token1</th>
                                    <th>API Token2</th>
                                    <th>API Token3</th>
                                    <th>Token Priority</th>
                                    <th>API Url</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in apiRows)
                                {
                                    var copyInputId = "apiNameUrlCopy" + item.Idno;
                                    <tr data-api-name="@(item.API_Name ?? "")">
                                        <td class="vm-api-name-cell">@item.API_Name</td>
                                        <td class="vm-api-name-cell--mono">@item.API_ID</td>
                                        <td class="vm-api-name-cell--mono vm-api-name-cell--ellipsis" title="@(item.Token ?? "")">@item.Token</td>
                                        <td class="vm-api-name-cell--mono vm-api-name-cell--ellipsis" title="@(item.token1 ?? "")">@item.token1</td>
                                        <td class="vm-api-name-cell--mono vm-api-name-cell--ellipsis" title="@(item.token2 ?? "")">@item.token2</td>
                                        <td class="vm-api-name-cell--priority">@item.prioritytoken</td>
                                        <td class="vm-api-nm-url-cell">
                                            <div class="vm-api-nm-url-wrap">
                                                <span class="vm-api-nm-url-text" title="@(item.url ?? "")">@(item.url ?? "")</span>
                                                <input type="hidden" id="@copyInputId" value="@(item.url ?? "")" />
                                                <button type="button"
                                                        class="vm-api-nm-copy-btn"
                                                        data-copy-target="@copyInputId"
                                                        data-copy-text="@Html.AttributeEncode(item.url ?? "")"
                                                        title="Copy URL">
                                                    <i class="fas fa-copy" aria-hidden="true"></i>
                                                    <span>Copy</span>
                                                </button>
                                            </div>
                                        </td>
                                        <td class="vm-api-nm-action-cell">
                                            <div class="vm-api-nm-action-group">
                                                <button type="button"
                                                        class="vm-api-operator-edit-btn vm-api-name-edit-btn"
                                                        data-id="@item.Idno"
                                                        data-apiname="@(item.API_Name ?? "")"
                                                        data-apiid="@(item.API_ID ?? "")"
                                                        data-apipwd="@Html.AttributeEncode(item.Api_pwd ?? "")"
                                                        data-token1="@Html.AttributeEncode(item.Token ?? "")"
                                                        data-token2="@Html.AttributeEncode(item.token1 ?? "")"
                                                        data-token3="@Html.AttributeEncode(item.token2 ?? "")"
                                                        data-priority="@(item.prioritytoken ?? "")"
                                                        data-url="@Html.AttributeEncode(item.url ?? "")"
                                                        data-toggle="modal"
                                                        data-target="#apiNameEditModal">
                                                    <i class="fas fa-edit" aria-hidden="true"></i> Edit
                                                </button>
                                                <button type="button" class="vm-api-nm-delete-btn" data-id="@item.Idno" title="Delete API" aria-label="Delete API">
                                                    <i class="fas fa-trash-alt" aria-hidden="true"></i>
                                                </button>
                                                <button type="button" class="vm-api-nm-delete-confirm-btn" data-id="@item.Idno" title="Confirm delete" aria-label="Confirm delete" style="display:none;">
                                                    <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Add API Modal -->
<div class="modal fade saas-admin-modal vm-sm-modal vm-api-operator-modal vm-api-nm-modal vm-api-name-modal" id="apiNameAddModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered saas-admin-modal-dialog vm-sm-modal-dialog" role="document">
        <div class="modal-content">
            @using (Html.BeginForm("insert_Api_Name", "Home", FormMethod.Post, new { id = "apiNameAddForm" }))
            {
                <div class="modal-header saas-admin-modal-header accent-sky">
                    <div class="saas-admin-modal-head-main">
                        <div class="saas-admin-modal-icon"><i class="fas fa-plus" aria-hidden="true"></i></div>
                        <div class="saas-admin-modal-title-wrap">
                            <h4 class="modal-title saas-admin-modal-title">Add API Url</h4>
                            <p class="saas-admin-modal-subtitle">Configure POST API credentials and endpoints</p>
                        </div>
                    </div>
                    <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
                </div>

                <div class="modal-body saas-admin-modal-body saas-admin-modal-scroll vm-sm-modal-body">
                    <div class="vm-sm-modal-panel vm-api-operator-form-grid">
                        <div class="vm-sm-modal-field vm-sm-modal-field--full">
                            <label for="txtapiname">API Name</label>
                            <input type="text" id="txtapiname" name="txtapiname" placeholder="Enter API Name" class="form-control" maxlength="8" required="" />
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="txtapiId">API ID</label>
                            @Html.TextBox("txtapiId", "", new { id = "txtapiId", @class = "form-control", @required = "", @placeholder = "Enter API ID" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="txtApi_pwd">Password</label>
                            @Html.TextBox("txtApi_pwd", "", new { id = "txtApi_pwd", @class = "form-control", @placeholder = "Enter Password", @required = "" })
                        </div>
                        <div class="vm-sm-modal-field vm-sm-modal-field--full">
                            <label for="txtApiToken">API Token1</label>
                            @Html.TextBox("txtApiToken", "", new { id = "txtApiToken", @class = "form-control", @placeholder = "Enter API Token1", @required = "" })
                        </div>
                        <div class="vm-sm-modal-field vm-sm-modal-field--full">
                            <label for="txtApiToken1">API Token2</label>
                            @Html.TextBox("txtApiToken1", "", new { id = "txtApiToken1", @class = "form-control", @placeholder = "Enter API Token2", @required = "" })
                        </div>
                        <div class="vm-sm-modal-field vm-sm-modal-field--full">
                            <label for="txtApiToken2">API Token3</label>
                            @Html.TextBox("txtApiToken2", "", new { id = "txtApiToken2", @class = "form-control", @placeholder = "Enter API Token3", @required = "" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="tokenpriority">Token Priority</label>
                            @Html.DropDownList("tokenpriority", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "token1", Value = "token1" },
                                new SelectListItem { Text = "token2", Value = "token2" },
                                new SelectListItem { Text = "token3", Value = "token3" }
                            }, new { id = "tokenpriority", @class = "form-control" })
                        </div>
                        <div class="vm-sm-modal-field vm-sm-modal-field--full">
                            <label for="txtApiUrl">API Url</label>
                            @Html.TextBox("txtApiUrl", "", new { id = "txtApiUrl", @class = "form-control", @placeholder = "Enter API Url", @required = "" })
                        </div>
                    </div>
                </div>

                <div class="modal-footer saas-admin-modal-footer vm-sm-modal-footer">
                    <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal">
                        <i class="fas fa-times" aria-hidden="true"></i> Cancel
                    </button>
                    <button type="submit" class="saas-admin-modal-btn saas-admin-modal-btn--success">
                        <i class="fas fa-save" aria-hidden="true"></i> Save Changes
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Edit API Modal -->
<div class="modal fade saas-admin-modal vm-sm-modal vm-api-operator-modal vm-api-nm-modal vm-api-name-modal" id="apiNameEditModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered saas-admin-modal-dialog vm-sm-modal-dialog" role="document">
        <div class="modal-content">
            @using (Html.BeginForm("Edit_Api_Nam", "Home", FormMethod.Post, new { id = "apiNameEditForm" }))
            {
                <div class="modal-header saas-admin-modal-header accent-emerald">
                    <div class="saas-admin-modal-head-main">
                        <div class="saas-admin-modal-icon"><i class="fas fa-edit" aria-hidden="true"></i></div>
                        <div class="saas-admin-modal-title-wrap">
                            <h4 class="modal-title saas-admin-modal-title">Edit API Details</h4>
                            <p class="saas-admin-modal-subtitle">Update POST API credentials and endpoints</p>
                        </div>
                    </div>
                    <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
                </div>

                <div class="modal-body saas-admin-modal-body saas-admin-modal-scroll vm-sm-modal-body">
                    @Html.Hidden("Editid", "", new { id = "Editid" })
                    <div class="vm-sm-modal-panel vm-api-operator-form-grid">
                        <div class="vm-sm-modal-field vm-sm-modal-field--full">
                            <label for="Editapiname">API Name</label>
                            @Html.TextBox("Editapiname", "", new { id = "Editapiname", @class = "form-control", @readonly = "readonly" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="EditapiId">API ID</label>
                            @Html.TextBox("EditapiId", "", new { id = "EditapiId", @class = "form-control" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="EditApi_pwd">Password</label>
                            @Html.TextBox("EditApi_pwd", "", new { id = "EditApi_pwd", @class = "form-control" })
                        </div>
                        <div class="vm-sm-modal-field vm-sm-modal-field--full">
                            <label for="EditApiToken">Token1</label>
                            @Html.TextBox("EditApiToken", "", new { id = "EditApiToken", @class = "form-control" })
                        </div>
                        <div class="vm-sm-modal-field vm-sm-modal-field--full">
                            <label for="EditApiToken1">Token2</label>
                            @Html.TextBox("EditApiToken1", "", new { id = "EditApiToken1", @class = "form-control" })
                        </div>
                        <div class="vm-sm-modal-field vm-sm-modal-field--full">
                            <label for="EditApiToken2">Token3</label>
                            @Html.TextBox("EditApiToken2", "", new { id = "EditApiToken2", @class = "form-control" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="edittokenpriority">Token Priority</label>
                            @Html.DropDownList("edittokenpriority", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "token1", Value = "token1" },
                                new SelectListItem { Text = "token2", Value = "token2" },
                                new SelectListItem { Text = "token3", Value = "token3" }
                            }, new { id = "edittokenpriority", @class = "form-control" })
                        </div>
                        <div class="vm-sm-modal-field vm-sm-modal-field--full">
                            <label for="EditApiUrl">API Url</label>
                            @Html.TextBox("EditApiUrl", "", new { id = "EditApiUrl", @class = "form-control" })
                        </div>
                    </div>
                </div>

                <div class="modal-footer saas-admin-modal-footer vm-sm-modal-footer">
                    <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal">
                        <i class="fas fa-times" aria-hidden="true"></i> Cancel
                    </button>
                    <button type="submit" class="saas-admin-modal-btn saas-admin-modal-btn--success">
                        <i class="fas fa-save" aria-hidden="true"></i> Save Changes
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<script src="~/AdminDesign/plugins/jquery/jquery.min.js"></script>
<script src="~/AdminDesign/js/pages/forms/basic-form-elements.js"></script>
<script src="~/AdminDesign/plugins/bootstrap-select/js/bootstrap-select.js"></script>
<script src="~/AdminDesign/js/demo.js"></script>
<script src="~/AdminDesign/plugins/jquery-slimscroll/jquery.slimscroll.js"></script>
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script src="~/select2/dist/js/select2.min.js"></script>

<script>
    function initApiNameFilter() {
        var $api = $('#filterApinm');
        if ($api.hasClass('select2-hidden-accessible')) {
            $api.select2('destroy');
        }
        $api.select2({
            width: '100%',
            placeholder: 'Api Name',
            allowClear: true,
            dropdownParent: $(document.body)
        });
    }

    function applyApiNameFilters() {
        var apiVal = ($('#filterApinm').val() || '').trim().toLowerCase();
        var q = ($('#apiNameSearch').val() || '').trim().toLowerCase();

        $('#apiNameTable tbody tr').each(function () {
            var $row = $(this);
            var apiName = ($row.attr('data-api-name') || '').toLowerCase();
            var text = $row.text().toLowerCase();
            var matchApi = !apiVal || apiName === apiVal;
            var matchSearch = !q || text.indexOf(q) > -1;
            $row.toggle(matchApi && matchSearch);
        });
    }

    $(document).ready(function () {
        initApiNameFilter();

        var successMsg = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Convert.ToString(ViewData["success"])))';
        var errorMsg = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Convert.ToString(ViewData["errormsg"])))';
        var tempMsg = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Convert.ToString(TempData["msg"])))';

        if (successMsg) {
            swal('Good job!', successMsg, 'success');
        } else if (tempMsg) {
            swal('Good job!', tempMsg, 'success');
        }
        if (errorMsg) {
            swal('Oops..!', errorMsg, 'error');
        }

        if (@(!string.IsNullOrEmpty(selectedApinm) ? "true" : "false")) {
            applyApiNameFilters();
        }

        $('#apiNameFilterBtn').on('click', applyApiNameFilters);
        $('#filterApinm').on('change select2:select select2:clear', applyApiNameFilters);
        $('#apiNameSearch').on('keyup', applyApiNameFilters);
    });

    function openApiNameEdit($btn) {
        $('#Editid').val($btn.attr('data-id') || '');
        $('#Editapiname').val($btn.attr('data-apiname') || '');
        $('#EditapiId').val($btn.attr('data-apiid') || '');
        $('#EditApi_pwd').val($btn.attr('data-apipwd') || '');
        $('#EditApiToken').val($btn.attr('data-token1') || '');
        $('#EditApiToken1').val($btn.attr('data-token2') || '');
        $('#EditApiToken2').val($btn.attr('data-token3') || '');
        $('#edittokenpriority').val($btn.attr('data-priority') || '');
        $('#EditApiUrl').val($btn.attr('data-url') || '');
    }

    $(document).on('click', '.vm-api-name-edit-btn', function () {
        openApiNameEdit($(this));
    });

    $(document).on('click', '.vm-api-nm-copy-btn', function () {
        var text = $(this).attr('data-copy-text') || '';
        if (!text) {
            var targetId = $(this).data('copy-target');
            text = $('#' + targetId).val() || '';
        }
        if (!text) {
            return;
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(function () {
                swal('Copied!', 'API URL copied to clipboard.', 'success');
            }).catch(function () {
                copyTextFallback(text);
            });
        } else {
            copyTextFallback(text);
        }
    });

    function copyTextFallback(text) {
        var $temp = $('<textarea readonly></textarea>').val(text).css({ position: 'fixed', left: '-9999px', top: '0' }).appendTo('body');
        $temp[0].select();
        try {
            document.execCommand('copy');
            swal('Copied!', 'API URL copied to clipboard.', 'success');
        } catch (e) {
            swal('Error', 'Unable to copy URL.', 'error');
        }
        $temp.remove();
    }

    $(document).on('click', '.saas-api-name-page .vm-api-nm-delete-btn', function () {
        $('.saas-api-name-page .vm-api-nm-action-group').each(function () {
            $(this).find('.vm-api-nm-delete-btn').show();
            $(this).find('.vm-api-nm-delete-confirm-btn').hide().prop('disabled', false);
        });
        var $group = $(this).closest('.vm-api-nm-action-group');
        $group.find('.vm-api-nm-delete-btn').hide();
        $group.find('.vm-api-nm-delete-confirm-btn').show();
    });

    $(document).on('click', '.saas-api-name-page .vm-api-nm-delete-confirm-btn', function () {
        var id = $(this).data('id');
        var $btn = $(this);
        $btn.prop('disabled', true);

        $.ajax({
            type: 'POST',
            url: '@Url.Action("Delete_Api_Name_Details", "Home")',
            data: { Idno: id },
            cache: false,
            success: function () {
                window.location.reload();
            },
            error: function () {
                $btn.prop('disabled', false);
                swal('Error', 'Unable to delete API. Please try again.', 'error');
            }
        });
    });
</script>
