@model Vastwebmulti.Areas.ADMIN.Models.LoanModelSlab
@{ ViewBag.Title = "Loan_model_Slab_setting";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml"; }

<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<style>
    .table.dataTable thead th, table.dataTable thead td {
        padding: 8px 4px 6px 4px;
    }

    .table.dataTable tbody th, table.dataTable tbody td {
        padding: 8px 4px 6px 4px;
    }

    .dropdown-menu {
        margin-top: 81px !important;
    }

    .dataTables_wrapper .dt-buttons a.dt-button {
        padding: 7px 10px 8px 8px;
    }

    .bootstrap-select.btn-group:not(.input-group-btn), .bootstrap-select.btn-group[class*="col-"] {
        height: 20px;
    }

    #div_Loader {
        background: rgba(0, 0, 0, 0.6) none repeat scroll 0 0;
        height: 100%;
        position: absolute;
        top: 0;
        width: 100%;
        z-index: 999999;
    }


    .ldio-gs56nt525f > div {
        transform-origin: 100px 100px;
        animation: ldio-gs56nt525f 0.2s infinite linear;
    }

        .ldio-gs56nt525f > div div {
            position: absolute;
            width: 22px;
            height: 152px;
            background: var(--main-bg-lcolor);
            left: 100px;
            top: 100px;
            transform: translate(-50%,-50%);
        }

            .ldio-gs56nt525f > div div:nth-child(1) {
                width: 120px;
                height: 120px;
                border-radius: 50%;
            }

            .ldio-gs56nt525f > div div:nth-child(6) {
                width: 80px;
                height: 80px;
                background: #fff;
                border-radius: 50%;
            }

            .ldio-gs56nt525f > div div:nth-child(3) {
                transform: translate(-50%,-50%) rotate(45deg)
            }

            .ldio-gs56nt525f > div div:nth-child(4) {
                transform: translate(-50%,-50%) rotate(90deg)
            }

            .ldio-gs56nt525f > div div:nth-child(5) {
                transform: translate(-50%,-50%) rotate(135deg)
            }

    .loadingio-spinner-gear-94vo528ab8 {
        width: 200px;
        height: 200px;
        display: inline-block;
        overflow: hidden;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%,-50%);
    }

    .ldio-gs56nt525f {
        width: 100%;
        height: 100%;
        position: relative;
        transform: translateZ(0) scale(1);
        backface-visibility: hidden;
        transform-origin: 0 0; /* see note above */
    }

        .ldio-gs56nt525f div {
            box-sizing: content-box;
        }

    .select2-container--default .select2-selection--single {
        border: 1px solid #bbb !important;
        border-radius: 0px !important;
        height: 38px !important;
        background-color: #f5f5f5 !important;
    }

        .select2-container--default .select2-selection--single .select2-selection__rendered {
            line-height: 36px !important;
        }

        .select2-container--default .select2-selection--single .select2-selection__arrow {
            height: 36px !important;
        }

    @@keyframes ldio-gs56nt525f {
        0% {
            transform: rotate(0deg)
        }

        50% {
            transform: rotate(22.5deg)
        }

        100% {
            transform: rotate(45deg)
        }
    }

    @@media only screen and (max-width:1169px) {

        .ls-closed section.content {
            margin-left: 0px;
        }
    }

    @@media only screen and (max-width:1080px) {

        .slab-first-tab h2 {
            font-size: 18px;
        }

        .nav > li > a {
            padding: 10px 5px;
        }

        div#custnav ul li a {
            font-size: 12px;
        }

        .slab-first-tab .nav-tabs li a::before {
            width: 8px !important;
            height: 8px !important;
            right: 9px !important;
        }

        .slab-first-tab ul li {
            margin-top: 11px;
        }

        #Comm, #Rembtn, #Mdbtn, #Dlmbtn, #Whitebtn {
            font-size: 10px !important;
        }
    }

    @@media only screen and (max-width:1024px) {
        #sidebar-open {
            top: 29px;
            left: -146px;
        }
    }


    @@media only screen and (max-width:992px) {
        .p_range {
            margin-top: 9px;
        }
    }

    @@media only screen and (max-width:991px) {

        .slab-first-tab {
            float: left;
        }

        .slab-first-tab {
            width: 15% !important;
        }

        .col-md-10.slab-first-tab-content {
            width: 84% !important;
        }
    }


    @@media only screen and (max-width:767px) {

        #sidebar-open {
            top: 0px;
            left: -3px;
        }

        .all-slab-header button#btnEdit {
            margin-top: 1px;
        }
    }

    @@media only screen and (max-width:600px) {
        .slab-first-tab {
            width: 25% !important;
        }

        .col-md-10.slab-first-tab-content {
            width: 73% !important;
        }

        #Comm, #Rembtn, #Mdbtn, #Dlmbtn, #Whitebtn {
            margin-bottom: 7px;
        }
    }


    @@media only screen and (max-width:425px) {
        .slab-first-tab {
            width: 100% !important;
        }

            .slab-first-tab .nav-tabs li a::before {
                top: 3px;
            }

        .col-md-10.slab-first-tab-content {
            width: 100% !important;
        }
    }
</style>

<section class="content">
    <div class="container-fluid">

        <!--Four-Design-Admin-page-Header-Section-Start-->
        <div class="page-title-box-fourde-admin">
            <h3>Loan Commission Slab Setting</h3>
            <ul>
                <li><a href="@Url.Action("Dashboard","Home")" style="color:var(--fullbodybg-four);">Home&nbsp;&nbsp;<i class="fa fa-angle-right"></i></a></li>
                <li><a href="javascript:void(0);">Basic Setting&nbsp;&nbsp;<i class="fa fa-angle-right"></i></a></li>
                <li><a href="javascript:void(0);">Loan Slab Setting</a></li>
            </ul>
        </div>
        <!--Four-Design-Admin-page-Header-Section-End-->

        <div class="row clearfix">
            <div class="col-md-12">
                @Html.Partial("_Slab_Menu")
                <div class="col-md-10 slab-first-tab-content">
                    <div class="row clearfix">
                        <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">
                            <div class="card">
                                <div class="header " style="padding:0px;border-bottom:0px;">
                                    <div class="row">
                                        <div class="col-md-12 all-slab-header all-slab-header-second slab-btn-second">
                                            <div class="page-header-third" style="float:left; width:auto;">
                                                <a href="@Url.Action("Loan_model_Slab_setting","Home")" id="Comm" class="btn bg-blue-grey waves-effect fullbodydycolorbg">Common Slab<p>For New Users</p></a>
                                               <button type="button"id ="Rembtn" class="btn bg-blue-grey waves-effect" onclick="editUserWise('Retailer', 'EditFormComm')">Retailer Slab<p>Existing Users</p></button>
                                            </div>
                                            <div class="page-header-third" style="float:right; width:auto;">
                                                <button id="btnEdit" type="button" class="btn  waves-effect btn-first" style="padding: 7px 15px !important; float: right !important; width: auto;" onclick="funcEdit(this, 'EditFormComm')"> <img src="~/AdminDesign/images/edit.svg" style="width:13px;" />&nbsp;<span style="color:#3c3c3c;">Edit Slab</span></button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="table-responsive tablefourdesign-admin page-header-third">
                                        <div id="divEditFormComm" class="slab-edit-table table-responsive " style="position:inherit;">
                                            @Html.Partial("_Loan_comm", Model)
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        </div>
</section>
<div id="div_Loader" style="display:none;">
    <div class="loadingio-spinner-gear-94vo528ab8">
        <div class="ldio-gs56nt525f">
            <div><div></div><div></div><div></div><div></div><div></div><div></div></div>
        </div>
    </div>
</div>
<script>
    function editUserWise(userRole, frmId) {

    // Loan commission is only for retailers
    if (userRole !== "Retailer") {
        alert("Loan commission slab is available for Retailers only.");
        return;
    }

    FormId = frmId || "EditFormComm";

    setActive("#Rembtn");

    $('#div_Loader').show();

    $.ajax({
        url: '@Url.Action("_UserModelLoanSlab", "Home")',
        type: 'POST',
        data: {
            ddlUserId: ''
        },
        success: function (data) {
            $('#divEditFormComm').html(data);
            $('#btnEdit').show();
        },
        error: function (xhr) {
            alert("Could not load retailer loan commission.");
            console.log(xhr.responseText);
        },
        complete: function () {
            $('#div_Loader').hide();
        }
    });
}
</script>


<script>
    var FormId = "EditFormComm";

    // Set active menu
    function setActive(sel) {
        $("#Comm, #Mdbtn, #Dlmbtn, #Rembtn, #Whitebtn")
            .removeClass("bg-grey fullbodydycolorbg")
            .addClass("bg-blue-grey");

        if (sel) {
            $(sel)
                .removeClass("bg-blue-grey")
                .addClass("bg-grey fullbodydycolorbg");
        }
    }


var FormId = "EditFormComm";

function funcEdit() {

    $('#btnEdit').hide();
    $('#tbodyshow').hide();

    // COMMON SLAB
    if ($('#EditFormComm').length) {

        $('#tbodyedit').show();
        $('#btnSaveCommon').show();
        $('#btnCancelCommon').show();

        return;
    }

    // RETAILER SLAB
    if ($('#EditFormUserWise').length) {

        var selectedUserId = $('#ddlUserId').val();

        if (selectedUserId == null || selectedUserId == '') {

            // All Retailers
            $('#tbodyeditAll').show();
            $('#tbodyedit').hide();

            $('#btnSaveExisting').show();
            $('#btnSaveExistingNew').show();

        } else {

            // Selected Retailer
            $('#tbodyedit').show();
            $('#tbodyeditAll').hide();

            $('#btnSaveRetailer').show();
        }

        $('#btnCancelRetailer').show();
    }
}


function funcSave(buttonValue) {

    var $form;

    if ($('#EditFormUserWise').length) {
        $form = $('#EditFormUserWise');
    }
    else if ($('#EditFormComm').length) {
        $form = $('#EditFormComm');
    }
    else {
        alert('Form not found.');
        return;
    }

    var formData = $form.serialize();

    // Send Button only for retailer slab.
    if ($form.attr('id') === 'EditFormUserWise') {
        if (!buttonValue) {
            buttonValue = 'Update For Existing Users';
        }

        formData += '&Button=' + encodeURIComponent(buttonValue);
    }

    $('#div_Loader').show();

    $.ajax({
        url: $form.attr('action'),
        type: 'POST',
        data: formData,

        success: function (response) {
            $('#divEditFormComm').html(response);
            $('#btnEdit').show();
        },

        error: function (xhr) {
            console.log(xhr.responseText);
            alert('Could not save the loan commission.');
        },

        complete: function () {
            $('#div_Loader').hide();
        }
    });
}


function funcCancel() {

    // Retailer screen: reload current selected retailer
    if ($('#EditFormUserWise').length) {
        ddlUserIdChange();
        return;
    }

    // Common screen: reload original values
    location.reload();
}


function ddlUserIdChange() {

    var selectedUserId = $('#ddlUserId').val();

    $('#div_Loader').show();

    $.ajax({
        url: '@Url.Action("_UserModelLoanSlab", "Home")',
        type: 'POST',
        data: {
            ddlUserId: selectedUserId
        },

        success: function (response) {
            $('#divEditFormComm').html(response);
            $('#btnEdit').show();
        },

        error: function (xhr) {
            console.log(xhr.responseText);
            alert('Could not load retailer loan commission.');
        },

        complete: function () {
            $('#div_Loader').hide();
        }
    });
}


function editUserWise(userRole, frmId) {

    if (userRole !== "Retailer") {
        alert("Loan commission slab is available for Retailers only.");
        return;
    }

    FormId = frmId || "EditFormUserWise";

    setActive("#Rembtn");

    $('#div_Loader').show();

    $.ajax({
        url: '@Url.Action("_UserModelLoanSlab", "Home")',
        type: 'POST',
        data: {
            ddlUserId: ''
        },

        success: function (response) {
            $('#divEditFormComm').html(response);
            $('#btnEdit').show();
        },

        error: function (xhr) {
            console.log(xhr.responseText);
            alert('Could not load retailer loan commission.');
        },

        complete: function () {
            $('#div_Loader').hide();
        }
    });
}


    $(document).ready(function () {
        setActive("#Comm");
    });
</script>

