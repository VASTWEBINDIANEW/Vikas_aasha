@model Vastwebmulti.Areas.ADMIN.Models.SecuritySlab
@using (Ajax.BeginForm("_Security_comm", "Home", new AjaxOptions { HttpMethod = "POST", OnSuccess = "OnSuccess", UpdateTargetId = "divEditFormComm", LoadingElementId = "div_Loader", InsertionMode = InsertionMode.Replace }))
{
    <input id="btnsubmit" type="submit" value="Save Now" class="btn waves-effect vm-pg-slab-save-btn" style="display:none;" />

    <div class="vm-pg-slab-table-scroll saas-acc-table-wrap vm-prepaid-slab-table-wrap">
        <table id="securitySlabTable" class="table table-bordered vm-pg-slab-table third-design-table slab-table example-second">
            <thead>
                <tr>
                    <th>Operator&nbsp;Name</th>
                    <th>Master&nbsp;(M/D)&nbsp;%</th>
                    <th>Distributor&nbsp;%</th>
                    <th>Retailer&nbsp;%</th>
                    <th>White Label&nbsp;%</th>
                    <th>Purchase&nbsp;%</th>
                </tr>
            </thead>
            <tbody id="tbodyshow" class="vm-pg-slab-tbody--view">
                @foreach (var item in Model.common)
                {
                    <tr>
                        <td>@item.OperatorName</td>
                        <td>@item.mastercomm</td>
                        <td>@item.dlmcomm</td>
                        <td>@item.dlm_rem_comm</td>
                        <td>@item.whitelabelcomm</td>
                        <td>@item.purchase</td>
                    </tr>
                }
            </tbody>
            <tbody id="tbodyedit" class="vm-pg-slab-tbody--hidden">
                @for (int i = 0; i < Model.common.Count; i++)
                {
                <tr>
                    @Html.HiddenFor(a => a.common[i].idno)
                    <td>@Html.DisplayFor(a => a.common[i].OperatorName)</td>
                    <td class="vm-pg-slab-edit-cell">
                        @Html.EditorFor(a => a.common[i].mastercomm, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input" } })
                        @Html.ValidationMessageFor(a => a.common[i].mastercomm)
                    </td>
                    <td class="vm-pg-slab-edit-cell">
                        @Html.EditorFor(a => a.common[i].dlmcomm, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input" } })
                        @Html.ValidationMessageFor(a => a.common[i].dlmcomm)
                    </td>
                    <td class="vm-pg-slab-edit-cell">
                        @Html.EditorFor(a => a.common[i].dlm_rem_comm, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input" } })
                        @Html.ValidationMessageFor(a => a.common[i].dlm_rem_comm)
                    </td>
                    <td class="vm-pg-slab-edit-cell">
                        @Html.EditorFor(a => a.common[i].whitelabelcomm, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input" } })
                        @Html.ValidationMessageFor(a => a.common[i].whitelabelcomm)
                    </td>
                    <td class="vm-pg-slab-edit-cell">
                        @Html.EditorFor(a => a.common[i].purchase, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input" } })
                        @Html.ValidationMessageFor(a => a.common[i].purchase)
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
}

<script>
    function OnSuccess() {
        $('#btnsubmit').hide().removeClass('is-visible');
        $('#btnEdit').show().removeClass('is-hidden');
        if (typeof resetSlabViewMode === 'function') {
            resetSlabViewMode();
        }
    }
</script>
