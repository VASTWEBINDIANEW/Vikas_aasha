@model Vastwebmulti.Areas.ADMIN.Models.DayBookreport
@using System.Linq
@{
    ViewBag.Title = "White Label Day Book";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var hasCurrent = Model.daybook_whitelabel != null;
    var rowCount = hasCurrent ? Model.daybook_whitelabel.Count() : (Model.daybook_whitelabel_old != null ? Model.daybook_whitelabel_old.Count() : 0);

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";

    decimal totalDiff = 0m;
    if (hasCurrent)
    {
        totalDiff = Model.daybook_whitelabel.Sum(x => x.DIFF ?? 0m);
    }
    else if (Model.daybook_whitelabel_old != null)
    {
        totalDiff = Model.daybook_whitelabel_old.Sum(x => x.DIFF ?? 0m);
    }

    ViewBag.DayBookFormAction = "DayBookWhitelabel";
    ViewBag.DayBookFormId = "dayBookWhitelabelForm";
    ViewBag.DayBookFrmDate = frmDate;
    ViewBag.DayBookDateMode = dateMode;
    ViewBag.DayBookTotalsPanelId = "dayBookWhitelabelTotalsPanel";
    ViewBag.DayBookTotalOpening = "0.00";
    ViewBag.DayBookTotalClosing = "0.00";
    ViewBag.DayBookTotalDiff = totalDiff.ToString("N2");
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=46" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=35" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-actual-daybook-modern.css?v=10" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-actual-daybook-page">
    <div class="container-fluid vm-opr-page-shell">
        @Html.Partial("~/Areas/ADMIN/Views/Home/_DayBookModernToolbar.cshtml")

        <div class="vm-opr-main-card vm-prepaid-report-main-card" id="tblpdf">
            <div class="vm-opr-table-panel vm-prepaid-report-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head vm-adb-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-tag" aria-hidden="true"></i>
                        <span>White label day book</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge">Records: <strong id="adbRecordCount">@rowCount</strong></span>
                        <span class="vm-radiant-inline-total">Diff: <strong id="adbInlineDiff">@totalDiff.ToString("N2")</strong></span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-adb-totals-btn" onclick="toggleDayBookTotals('dayBookWhitelabelTotalsPanel')" title="Show totals" aria-expanded="false" aria-controls="dayBookWhitelabelTotalsPanel"><i class="fas fa-chart-pie" aria-hidden="true"></i></button>
                            <button type="button" id="btnExportA" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel"><i class="fas fa-file-excel" aria-hidden="true"></i> Excel</button>
                            <button type="button" id="btnPDFA" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF"><i class="fas fa-file-pdf" aria-hidden="true"></i> PDF</button>
                        </div>
                    </div>
                </div>
                <div class="vm-opr-table-wrap vm-prepaid-table-wrap vm-adb-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="dayBookWhitelabelTable" class="table vm-opr-data-table vm-adb-daybook-table vm-adb-daybook-table--whitelabel" cellspacing="0">
                            <colgroup>
                                <col class="vm-adb-col-firm" />
                                <col class="vm-adb-col-num" span="22" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th rowspan="2">White Label&nbsp;Firm</th>
                                    <th rowspan="2">Opening&nbsp;&#8377;</th>
                                    <th colspan="2">Purchase</th>
                                    <th rowspan="2">Prepaid&nbsp;&&nbsp;Utility</th>
                                    <th rowspan="2">Account Transfer</th>
                                    <th rowspan="2">AEPS</th>
                                    <th rowspan="2">mPos</th>
                                    <th rowspan="2">Pan</th>
                                    <th rowspan="2">Flight</th>
                                    <th rowspan="2">Bus</th>
                                    <th rowspan="2">Hotel</th>
                                    <th rowspan="2">Gift</th>
                                    <th rowspan="2">Security</th>
                                    <th rowspan="2">eComm</th>
                                    <th colspan="2">Success&nbsp;To&nbsp;Fail</th>
                                    <th colspan="2">Failed&nbsp;To&nbsp;Success</th>
                                    <th rowspan="2">GST&nbsp;&#8377;</th>
                                    <th rowspan="2">TDS&nbsp;&#8377;</th>
                                    <th rowspan="2">Closing&nbsp;&#8377;</th>
                                    <th rowspan="2">Diff</th>
                                </tr>
                                <tr>
                                    <th><span>Net&nbsp;&#8377;</span></th>
                                    <th><span>Charge&nbsp;&#8377;</span></th>
                                    <th><span>To&nbsp;Fail</span></th>
                                    <th><span>Refund&nbsp;&#8377;</span></th>
                                    <th><span>To&nbsp;Success</span></th>
                                    <th><span>Debit&nbsp;&#8377;</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (rowCount == 0)
                                {
                                    <tr class="vm-opr-table-empty-row"><td colspan="23" class="vm-opr-table-empty vm-dmt-table-empty"><i class="fas fa-inbox" aria-hidden="true"></i><span>No data found.</span></td></tr>
                                }
                                else
                                {
                                    <tr class="vm-adb-row-total">
                                        <td class="vm-adb-text"><strong>Total</strong></td>
                                        <td>0</td><td>0</td><td>0</td><td>0</td><td>0</td><td>0</td><td>0</td><td>0</td>
                                        <td>0</td><td>0</td><td>0</td><td>0</td><td>0</td><td>0</td>
                                        <td>0</td><td>0</td><td>0</td><td>0</td><td>0</td><td>0</td><td>0</td>
                                        <td>@totalDiff.ToString("N2")</td>
                                    </tr>
                                    if (hasCurrent)
                                    {
                                        foreach (var item in Model.daybook_whitelabel)
                                        {
                                            <tr>
                                                <td class="vm-adb-text">@(item.frmname ?? item.name)</td>
                                                <td>@item.rch</td>
                                                <td>@item.imps</td>
                                                <td>@item.aeps</td>
                                                <td>0.00</td>
                                                <td>@item.pan</td>
                                                <td>0.00</td>
                                                <td>@item.purchase</td>
                                                <td>@item.pre</td>
                                                <td>@item.post</td>
                                                <td>0</td><td>0</td><td>0</td><td>0</td><td>0</td>
                                                <td>@item.olddayfailed</td>
                                                <td>@item.olddayrefund</td>
                                                <td>0</td><td>0</td><td>0</td><td>0</td><td>0</td>
                                                <td>@item.DIFF</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        foreach (var item in Model.daybook_whitelabel_old)
                                        {
                                            <tr>
                                                <td class="vm-adb-text">@(item.frmname ?? item.name)</td>
                                                <td>@item.rch</td>
                                                <td>@item.imps</td>
                                                <td>@item.aeps</td>
                                                <td>0.00</td>
                                                <td>@item.pan</td>
                                                <td>0.00</td>
                                                <td>@item.purchase</td>
                                                <td>@item.pre</td>
                                                <td>@item.post</td>
                                                <td>0</td><td>0</td><td>0</td><td>0</td><td>0</td>
                                                <td>@item.olddayfailed</td>
                                                <td>@item.olddayrefund</td>
                                                <td>0</td><td>0</td><td>0</td><td>0</td><td>0</td>
                                                <td>@item.DIFF</td>
                                            </tr>
                                        }
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@Html.Partial("~/Areas/ADMIN/Views/Home/_DayBookModernScripts.cshtml")
<script>
    bindDayBookPage({
        formId: 'dayBookWhitelabelForm',
        tableId: 'dayBookWhitelabelTable',
        recordCountId: 'adbRecordCount',
        title: 'White Label Day Book',
        subtitle: 'White label day book report',
        filePrefix: 'DayBook_WhiteLabel',
        sheetName: 'White Label Day Book'
    });
</script>
