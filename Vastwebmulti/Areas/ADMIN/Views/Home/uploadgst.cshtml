@model IEnumerable<Vastwebmulti.Areas.ADMIN.Models.remuploadgst>
@using System.Linq
@{
    ViewBag.Title = "uploadgst";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    ViewBag.InvoiceGstNavActive = "retailer";
    ViewBag.InvoiceRetailerNavActive = "upload";
    var rows = Model != null ? Model.ToList() : new List<Vastwebmulti.Areas.ADMIN.Models.remuploadgst>();
    var rowCount = rows.Count;
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=32" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-invoice-gst-table.css?v=2" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<script src="~/MainFrontDesign/js/admin-financial-report.js?v=6"></script>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-auto-fund-status-page saas-invoice-gst-page">

    <div class="container-fluid vm-opr-page-shell">

        @using (Html.BeginForm("uploadgst", "Home", FormMethod.Post, new { id = "uploadGstForm", @class = "vm-rpt-filters-panel__form" }))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Retailer GST Invoice</li>
                        <li>Retailer Upload GST</li>
                    </ol>
                    <div class="vm-dmt-fin-nav-row vm-invoice-nav-row">
                        @Html.Partial("_InvoiceGstNav")
                    </div>
                    <div class="vm-dmt-fin-nav-row vm-invoice-nav-row vm-invoice-nav-row--sub">
                        @Html.Partial("_InvoiceRetailerNav")
                    </div>
                </div>
            </div>

            <div class="vm-opr-main-card vm-auto-fund-main-card">
                <div class="vm-opr-table-panel vm-auto-fund-table-panel">
                    <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                        <div class="vm-opr-table-panel__title">
                            <i class="fas fa-cloud-upload-alt" aria-hidden="true"></i>
                            <span>Retailer upload GST invoices</span>
                        </div>
                        <div class="vm-dmt-table-panel__right vm-invoice-table-toolbar">
                            <span class="vm-radiant-record-badge" title="Total records">
                                Records: <strong id="invoiceRecordCount">@rowCount</strong>
                            </span>
                            <div class="vm-invoice-head-filters">
                                <div class="vm-opr-field vm-dmt-field vm-invoice-head-field">
                                    @Html.DropDownList("remid", ViewBag.apiid as SelectList, "Select Retailer", new { @class = "vm-opr-select vm-dmt-select form-control", @title = "Retailer" })
                                </div>
                                <div class="vm-opr-field vm-dmt-field vm-invoice-head-field vm-invoice-head-field--month">
                                    @Html.DropDownList("Month", ViewBag.month as SelectList, new { @class = "vm-opr-select vm-dmt-select form-control", @title = "Month" })
                                </div>
                                <div class="vm-opr-field vm-dmt-field vm-invoice-head-field vm-invoice-head-field--year">
                                    @Html.DropDownList("Year", ViewBag.year as SelectList, new { @class = "vm-opr-select vm-dmt-select form-control", @title = "Year" })
                                </div>
                                <button type="submit" id="RetailerSearch" class="saas-acc-btn saas-acc-btn--search vm-dmt-search-btn vm-invoice-head-search" title="Search">
                                    <i class="fas fa-search" aria-hidden="true"></i> Search
                                </button>
                            </div>
                            <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                                <button type="button" id="btnExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel" onclick="excel()">
                                    <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                                </button>
                                <button type="button" id="btnPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF" onclick="PDF()">
                                    <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="vm-opr-table-wrap vm-auto-fund-table-wrap">
                        <div class="table-responsive vm-opr-table-scroll vm-invoice-gst-scroll" id="uploadGstExportWrap">
                            <table id="uploadGstTable" class="table vm-opr-data-table vm-invoice-gst-table vm-invoice-gst-table--8col" cellspacing="0">
                                <thead>
                                    <tr>
                                        <th>Email&nbsp;Id</th>
                                        <th>Firm&nbsp;Name</th>
                                        <th>Month</th>
                                        <th>Year</th>
                                        <th>Status</th>
                                        <th>Reason</th>
                                        <th>View</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody id="body">
                                    @if (rowCount == 0)
                                    {
                                        <tr class="vm-opr-table-empty-row">
                                            <td colspan="8">No retailer upload GST records found.</td>
                                        </tr>
                                    }
                                    else
                                    {
                                        foreach (var item in rows)
                                        {
                                            var statusClass = "vm-invoice-status";
                                            if (item.status == "Pending") { statusClass += " vm-invoice-status--pending"; }
                                            else if (item.status == "Approved") { statusClass += " vm-invoice-status--approved"; }
                                            else if (item.status == "Rejected") { statusClass += " vm-invoice-status--rejected"; }

                                            <tr class="tr vm-auto-fund-row">
                                                <td>@item.email</td>
                                                <td>
                                                    <div class="vm-auto-fund-firm">
                                                        <strong>@item.firmname</strong>
                                                    </div>
                                                </td>
                                                <td>@item.monthchk</td>
                                                <td>@item.yearchk</td>
                                                <td><span class="@statusClass">@item.status</span></td>
                                                <td class="vm-invoice-reason-cell">@(string.IsNullOrWhiteSpace(item.reason) ? "—" : item.reason)</td>
                                                <td class="vm-invoice-pdf-cell">
                                                    <button type="button" onclick="show('@item.uploadfile')" class="vm-invoice-pdf-btn" title="View uploaded file">
                                                        <i class="fas fa-file-pdf" aria-hidden="true"></i>
                                                        <span>View</span>
                                                    </button>
                                                </td>
                                                <td class="vm-invoice-action-cell">
                                                    @if (item.status == "Pending")
                                                    {
                                                        <button type="button" class="vm-invoice-action-btn vm-invoice-action-btn--approve" onclick="approved('@item.idno', '@item.firmname', '@item.monthchk', '@item.yearchk')" title="Approve">
                                                            <i class="fas fa-check" aria-hidden="true"></i>
                                                        </button>
                                                        <button type="button" class="vm-invoice-action-btn vm-invoice-action-btn--reject" onclick="Rejected('@item.idno', '@item.firmname', '@item.monthchk', '@item.yearchk')" title="Reject">
                                                            <i class="fas fa-ban" aria-hidden="true"></i>
                                                        </button>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }

    </div>
</section>

<div class="modal fade vm-invoice-upload-modal" id="m-d-fund-transfer12" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg vm-invoice-upload-modal__dialog" role="document">
        <div class="modal-content">
            <div class="modal-header vm-invoice-upload-modal__head">
                <h5 class="modal-title">Retailer Upload GST</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body vm-invoice-upload-modal__body">
                <iframe id="ifrmgst" src="#" title="Uploaded GST file"></iframe>
            </div>
        </div>
    </div>
</div>

<div class="modal fade vm-invoice-upload-modal" id="m-d-fund-transfer121" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog vm-invoice-upload-modal__dialog vm-invoice-upload-modal__dialog--sm" role="document">
        <div class="modal-content">
            <div class="modal-header vm-invoice-upload-modal__head">
                <h5 class="modal-title">Approved Upload GST</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body vm-invoice-upload-modal__body">
                @using (Html.BeginForm("ApprovedDoneRetailer", "Home", FormMethod.Post))
                {
                    @Html.Hidden("idnochk")
                    <div class="vm-invoice-upload-detail">
                        <div class="vm-invoice-upload-detail__row">
                            <span>Firm Name</span>
                            <strong id="aprfrmname"></strong>
                        </div>
                        <div class="vm-invoice-upload-detail__row">
                            <span>Month</span>
                            <strong id="aprmonth"></strong>
                        </div>
                        <div class="vm-invoice-upload-detail__row">
                            <span>Year</span>
                            <strong id="apryear"></strong>
                        </div>
                    </div>
                    <button type="submit" class="saas-acc-btn saas-acc-btn--search vm-invoice-upload-submit">
                        <i class="fas fa-check" aria-hidden="true"></i> Approved
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade vm-invoice-upload-modal" id="m-d-fund-transfer1211" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog vm-invoice-upload-modal__dialog vm-invoice-upload-modal__dialog--sm" role="document">
        <div class="modal-content">
            <div class="modal-header vm-invoice-upload-modal__head">
                <h5 class="modal-title">Rejected Upload GST</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body vm-invoice-upload-modal__body">
                @using (Html.BeginForm("RejectedDoneRetailer", "Home", FormMethod.Post))
                {
                    @Html.Hidden("idnochk1")
                    <div class="vm-invoice-upload-detail">
                        <div class="vm-invoice-upload-detail__row">
                            <span>Firm Name</span>
                            <strong id="aprfrmname1"></strong>
                        </div>
                        <div class="vm-invoice-upload-detail__row">
                            <span>Month</span>
                            <strong id="aprmonth1"></strong>
                        </div>
                        <div class="vm-invoice-upload-detail__row">
                            <span>Year</span>
                            <strong id="apryear1"></strong>
                        </div>
                        <div class="vm-invoice-upload-detail__row vm-invoice-upload-detail__row--field">
                            <label for="txtreason">Reason</label>
                            @Html.TextBox("txtreason", "", new { @class = "form-control vm-invoice-upload-reason", @required = "required", @id = "txtreason" })
                        </div>
                    </div>
                    <button type="submit" class="saas-acc-btn saas-acc-btn--pdf vm-invoice-upload-submit">
                        <i class="fas fa-ban" aria-hidden="true"></i> Rejected
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.22/pdfmake.min.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.4.1/html2canvas.min.js"></script>
<script src="~/MainFrontDesign/select2/dist/js/select2.full.min.js"></script>

<script>
    function excel() {
        var table = document.getElementById('uploadGstTable');
        if (!table) {
            return;
        }
        var html = '<html><head><meta charset="utf-8" /></head><body>' + table.outerHTML + '</body></html>';
        var blob = new Blob(['\ufeff', html], { type: 'application/vnd.ms-excel;charset=utf-8;' });
        var link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = 'Retailer_Upload_GST.xls';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    function PDF() {
        var el = document.getElementById('uploadGstExportWrap');
        if (!el || typeof html2canvas === 'undefined' || typeof pdfMake === 'undefined') {
            return;
        }
        html2canvas(el, {
            onrendered: function (canvas) {
                var data = canvas.toDataURL();
                pdfMake.createPdf({
                    content: [{ image: data, width: 500 }]
                }).download('Retailer_Upload_GST.pdf');
            }
        });
    }

    function show(str) {
        $('#m-d-fund-transfer12').modal('toggle');
        $('#ifrmgst').attr('src', '../../' + str);
    }

    function approved(idno, firmname, month, year) {
        $('#idnochk').val(idno);
        $('#aprfrmname').text(firmname);
        $('#aprmonth').text(month);
        $('#apryear').text(year);
        $('#m-d-fund-transfer121').modal('toggle');
    }

    function Rejected(idno, firmname, month, year) {
        $('#idnochk1').val(idno);
        $('#aprfrmname1').text(firmname);
        $('#aprmonth1').text(month);
        $('#apryear1').text(year);
        $('#m-d-fund-transfer1211').modal('toggle');
    }

    $(document).ready(function () {
        if ($.fn.select2) {
            $('#remid').select2({ width: 'resolve', minimumResultsForSearch: 8 });
            $('#Month, #Year').select2({ width: 'resolve', minimumResultsForSearch: -1 });
        }

        var month = '@ViewBag.chkmonth';
        var val = '@ViewBag.chk';
        if (val != "post") {
            $('#Month').val(month);
            if ($.fn.select2) {
                $('#Month').trigger('change');
            }
        }
    });
</script>
