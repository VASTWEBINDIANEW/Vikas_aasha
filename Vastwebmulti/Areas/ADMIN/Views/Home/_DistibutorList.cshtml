<script>
    function mdActionBtn(SSId, values) {
        vmDlResetDetailModalForms();
        $('#error').text('');
        vmDlEnsureDetailModal().modal({ backdrop: true, keyboard: true, show: true });
        $('#loadredmodel').show();
        $('#userinfodiv').css('visibility', 'hidden');
        $('#alinks').html('');
        $.ajax({
            url: '@Url.Action("DealerByIdSearch","Home")',
            type: "POST",
            data: { ssid: SSId },
            cache: false,
            success: function (data2) {

                      $('#error').text("");
                var date = new Date(parseInt((data2.list[0].JoinDate).match(/\d+/)[0]))

                var createddate = converttoDate(date);

                var datess = data2.list[0].DOF;
                var dateTimesss = moment(datess).format("YYYY-MM-DD");

                var CCNValue = data2.list[0].adharcard;
                CCNValue = CCNValue.substring(0, 8).replace(/\d/g, "X") + CCNValue.substring(8);

              
                $("#DealerId").val(data2.list[0].DealerId);
                $("#DealerIddelete").val(data2.list[0].DealerId);
                $("#DealerIdshow").val(data2.list[0].DealerId);
                $("#Names").text(data2.list[0].DealerName);
                $("#NameEdit").val(data2.list[0].DealerName);
                $("#FirmName").text(data2.list[0].FarmName);
                $("#FirmEdit").val(data2.list[0].FarmName);
                $("#DOBEdit").val(dateTimesss);
                $("#RegisteredDate").text(createddate);
                $("#Email11").val(data2.list[0].Email);
                $("#Pancard11").val(data2.list[0].pancard);
                $("#pancardEdit").val(data2.list[0].pancard);
                $("#Aadhar11").val(CCNValue);
                $("#AadhaarEdit").val(data2.list[0].adharcard);
                $("#GSTRegistrationNo11").val(data2.list[0].gst);
                $("#gstEdit").val(data2.list[0].gst);
                  $('#Edittxtlrole').hide();
                ravi("#DivEditddlrole").show();
               ravi("#Editddlrole").val(data2.list[0].FinincialRolesType).trigger('change');
                $("#pincode11").val(data2.list[0].Pincode);
                $("#PinEdit").val(data2.list[0].Pincode);

                $("#Capping").text(data2.list[0].caption);
                $("#CappingEdit").val(data2.list[0].caption);
                //$("#masterremain").html(data2[0].superremain);
                $("#offmargine").html(data2.list[0].dlmcomminper);
                $("#offmargineEdit").val(data2.list[0].dlmcomminper);
                $("#Distributorbalance").val(data2.list[0].remaindlm);
                $("#Retailerbalance").val(data2.list[0].remainrem);
                $("#State11").val(data2.list[0].State_name);
                $("#District11").val(data2.list[0].Dist_Desc);
                $("#address11").val(data2.list[0].Address);
                $("#AddressEdit").val(data2.list[0].Address);
                $("#StateEdit").val(data2.list[0].State);
                var dealerId = data2.list[0].DealerId;
                var buttonHTML = "";

                console.log(data2.list[0].selregSTATUS);
                console.log(data2.list[0].sellstatus);
                if (data2.list[0].selregSTATUS == null && data2.list[0].sellstatus == null) {
                    buttonHTML = '<button type="button" class="vm-ml-sell-chip vm-ml-sell-chip--danger" onclick="disrecharsellupdate(\'' + dealerId + '\', \'SELL STATUS\')" title="Sell Status">SELL</button>';
                    document.getElementById('sellbutton').innerHTML = buttonHTML;
                }
                else if (data2.list[0].selregSTATUS == false && data2.list[0].sellstatus == false) {
                    buttonHTML = '<button type="button" class="vm-ml-sell-chip vm-ml-sell-chip--warn" onclick="disrecharsellupdate(\'' + dealerId + '\', \'Registration\')" title="Registration">REG</button>';
                    document.getElementById('sellbutton').innerHTML = buttonHTML;
                }
                else if (data2.list[0].selregSTATUS == true && data2.list[0].sellstatus == false) {
                    buttonHTML = '<button type="button" class="vm-ml-sell-chip vm-ml-sell-chip--danger" onclick="disrecharsellupdate(\'' + dealerId + '\', \'Sell RECHARGE OFF\')" title="Sell Recharge Off">OFF</button>';
                    document.getElementById('sellbutton').innerHTML = buttonHTML;
                }
                else if (data2.list[0].selregSTATUS == true && data2.list[0].sellstatus == true) {
                    buttonHTML = '<button type="button" class="vm-ml-sell-chip vm-ml-sell-chip--success" onclick="disrecharsellupdate(\'' + dealerId + '\', \'Sell RECHARGE ON\')" title="Sell Recharge On">ON</button>';
                    document.getElementById('sellbutton').innerHTML = buttonHTML;
                }
                document.getElementById('Messages12').innerHTML ='';
                var chargeback_otpsts = data2.list[0].chargeback_otpsts;
               

                if (chargeback_otpsts == true) {
                    $('#chargeback_otpsts').addClass('costom-on')
                    $('#chargeback_otpsts').removeClass('custom-off')
                }
                else {
                    $('#chargeback_otpsts').addClass('custom-off')
                    $('#chargeback_otpsts').removeClass('costom-on')
                }

                var self_upi = data2.list[0].DealerSelf_sts;
                

                if (self_upi == true)
                {
                    $('#self_upi').addClass('costom-on')
                    $('#self_upi').removeClass('custom-off')
                }
                else
