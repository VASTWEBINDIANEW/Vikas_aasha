<div class="table-responsive vm-ml-table-scroll saas-acc-table-wrap">
    <table class="table table-bordered saas-acc-table vm-ml-data-table third-design-table" id="mdList">
        <thead>
            <tr>
                <th>Sr</th>
                <th>Master&nbsp;Distributor&nbsp;Firm</th>
                <th>Distributor&nbsp;Firm</th>
                <th>Distributor&nbsp;Name</th>
                <th>Mobile&nbsp;No</th>
                <th>Balance</th>
                <th>KYC</th>
                <th style="width:90px;">Email&nbsp;V/F</th>
            </tr>
        </thead>
        <tbody id="body">
            @if (Model.Select_dealer_list != null)
            {
                int i = 0;
                var id = 1;
                foreach (var item in Model.Select_dealer_list)
                {
                    var idno = "subTbl";
                    idno = idno + i;

                    var idshow = "subTblshow";
                    idshow = idshow + i;

                    var idhide = "subTblhide";
                    idhide = idhide + i;

                    var colorchange = "";
                    var borderleft = "";
                    var imggg = "";

                    if (item.aadharcardPath != null && item.BackSideAadharcardphoto != null && item.pancardPath != null)
                    {
                        if (item.PSAStatus == "N" && item.AadhaarStatus == "N")
                        {
                            colorchange = "#fef9c3";
                            borderleft = "4px solid #2563eb";
                            imggg = "?";
                        }
                    }
                    <tr class="tr vm-ml-parent-row" style="background-color:@colorchange">
                        <td>@id</td>
                        <td class="vm-ml-md-firm">@item.MasterEmail</td>
                        <td style="border-left:@borderleft">
                            <span id="@idshow" class="vm-ml-expand-toggle" onclick="md_dlm_List('@item.DealerId', '@i')">
                                <i class="fa fa-caret-down vm-ml-expand-icon" aria-hidden="true"></i>
                                <span class="vm-ml-firm-name">@item.FarmName</span>
                            </span>
                            <span id="@idhide" class="vm-ml-expand-toggle vm-ml-expand-toggle--open" style="display:none;" onclick="md_dlm_Listhide('@i')">
                                <i class="fa fa-caret-up vm-ml-expand-icon" aria-hidden="true"></i>
                                <span class="vm-ml-firm-name">@item.FarmName</span>
                            </span>
                        </td>
                        <td><span class="vm-ml-pending-mark">@imggg</span>@item.DealerName</td>
                        <td>@item.Mobile</td>
                        <td class="vm-ml-balance-cell">@item.remaindlm</td>
                        <td class="kyc-button">
                            @if (item.PSAStatus == "Y" && item.AadhaarStatus == "Y" && item.pancardsts == "Y")
                            {
                                <span class="vm-ml-status-badge vm-ml-status-badge--done">Done</span>
                            }
                            else
                            {
                                <span class="vm-ml-status-badge vm-ml-status-badge--due">Due</span>
                            }
                        </td>
                        <td class="vm-ml-ev-cell" onclick="mdActionBtn('@item.DealerId', this); return false;">
                            <div class="vm-ml-ev-cell__inner">
                                @if (item.Emailconfirmed == true)
                                {
                                    <span class="vm-ml-status-badge vm-ml-status-badge--done">Done</span>
                                }
                                else
                                {
                                    <span class="vm-ml-status-badge vm-ml-status-badge--due">Due</span>
                                }
                                <i class="fas fa-chevron-right vm-ml-ev-arrow" aria-hidden="true"></i>
                            </div>
                        </td>
                    </tr>

                    <tr id="@i" class="vm-ml-sub-row" style="display:none;">
                        <td colspan="8" class="vm-ml-sub-row-cell">
                            <div id="@idno"></div>
                        </td>
                    </tr>

                    i++;
                    id++;
                }
            }
        </tbody>
    </table>
</div>


<script>

    function vmDlEnsureDetailModal() {
        var $modal = $('#defaultModal222');
        if ($modal.length && !$modal.parent().is('body')) {
            $modal.appendTo('body');
        }
        return $modal;
    }

    function vmDlResetDetailModalForms() {
        $('#defaultModal222 .first-form').show();
        $('#defaultModal222 .second-form').hide();
        $('#defaultModal222 .first-form .vm-ml-modal-actions__grid button[value="Edit"]').show();
        $('#loadredmodel').hide();
        $('#userinfodiv').css('visibility', 'visible');
    }

    function vmDlShowEditForm() {
        $('#defaultModal222 .first-form').hide();
        $('#defaultModal222 .second-form').show();
        vmDlInitEditSelects();
    }

    function vmDlBackToViewForm() {
        vmDlResetDetailModalForms();
    }

    function vmDlCloseDetailModal() {
        var $modal = $('#defaultModal222');
        if ($modal.length) {
            $modal.modal('hide');
        }
    }

    function vmDlGetEditModalParent() {
        return ravi('#defaultModal222');
    }

    function vmDlInitEditSelects() {
        var $parent = vmDlGetEditModalParent();
        $parent.find('.vm-ml-edit-select').each(function () {
            if (ravi(this).data('select2')) {
                ravi(this).select2('destroy');
            }
            ravi(this).select2({ dropdownParent: $parent });
        });
    }

    $(document).off('click.vmDlEdit', '#defaultModal222 .first-form button.btn[value="Edit"]');
    $(document).on('click.vmDlEdit', '#defaultModal222 .first-form button.btn[value="Edit"]', function () {
        vmDlShowEditForm();
    });

    function OnSuccessdistributor(data) {
        $('#distributorlist').html(data);
        vmDlCloseDetailModal();
        $('#otpmodal').modal('hide');
        $('body').removeClass('modal-open');
        $('.modal-backdrop').remove();
        ToastrMessage();
        toastr.success("Account Deleted Successfully");
    }

    function OnFailureotperror(data) {
        $('#otpmodal').modal('show');
        $('#otpwrong').text("OTP Mismatch , Please enter Correct OTP");
    }

</script>
<script>
    function OnFailure() {
        $('#otpwrong').text("Otp MissMatch");
    }
</script>
<script>
    function chkvalidation() {
        $("#PinEdit").parent().next(".alert.alert-success").remove(); // remove it
        var name = $('#NameEdit').val();
        var FarmName = $('#FirmEdit').val();
        var Email = $('#Email').val();
        var Mb = $('#Mb').val();
        var State = $('#StateEdit').val();
        var District = $('#DistrictEdit').val();
        var Address = $('#AddressEdit').val();
        var Editddlrole = $('#Editddlrole').val();
        var Pincode = $('#PinEdit').val();
        var adharcard = $('#AadhaarEdit').val();
        var gst = $('#gstEdit').val();
        var pancard = $('#pancardEdit').val();
        if (name == null || name == '') {
            $('#error').text('Master Distributor Name Required')
            $("#PinEdit").parent().after("<div class='alert alert-success' style='color:red;margin-bottom: 20px;'><strong>Error!</strong> Please Enter Name</div>");
            RegisterSuccess.stopImmediatePropagation();
            return false;

        }
        if (FarmName == null || FarmName == '') {
            $("#PinEdit").parent().after("<div class='alert alert-success' style='color:red;margin-bottom: 20px;'><strong>Error!</strong> Firm Name Required</div>");
            RegisterSuccess.stopImmediatePropagation();
            return false;
        }


        if (pancard.length != 0) {
            var regex = /([A-Z]){5}([0-9]){4}([A-Z]){1}$/;
            if (!regex.test(pancard.toUpperCase())) {
                // $('#error').text('Invalid Pan No')
                // return false;
                $("#PinEdit").parent().after("<div class='alert alert-success' style='color:red;margin-bottom: 20px;'><strong>Error!</strong>'Invalid Pan No'</div>");
                RegisterSuccess.stopImmediatePropagation();

                return false;
            }


        }
        if (Editddlrole == null || Editddlrole == '') {
            $("#PinEdit").parent().after("<div class='alert alert-success' style='color:red;margin-bottom: 20px;'><strong>Error!</strong>'Finincial Required'</div>");
            RegisterSuccess.stopImmediatePropagation();
        }
        if (State == null || State == '') {
            //   $('#error').text(' State Required')
            //  return false;
            $("#PinEdit").parent().after("<div class='alert alert-success' style='color:red;margin-bottom: 20px;'><strong>Error!</strong>'State Required'</div>");
            RegisterSuccess.stopImmediatePropagation();

            return false;
        }
        if (District == null || District == '') {
            //  $('#error').text(' District Required')
            //  return false;
            $("#PinEdit").parent().after("<div class='alert alert-success' style='color:red;margin-bottom: 20px;'><strong>Error!</strong>' District Required'</div>");
            RegisterSuccess.stopImmediatePropagation();

            return false;
        }
        if (Address == null || Address == '') {
            // $('#error').text(' Address Required')
            //  return false;
            $("#PinEdit").parent().after("<div class='alert alert-success' style='color:red;margin-bottom: 20px;'><strong>Error!</strong>' Address Required'</div>");
            RegisterSuccess.stopImmediatePropagation();
            return false;
        }

        if (adharcard.length != 0) {


            if (validatesss(adharcard) == false) {
                //  $('#error').text('Invalid Adhar No')
                //    return false;
                $("#PinEdit").parent().after("<div class='alert alert-success' style='color:red;margin-bottom: 20px;'><strong>Error!</strong>'Invalid Adhar No'</div>");
                RegisterSuccess.stopImmediatePropagation();
                return false;
            }


        }
        if (gst.length != 0) {
            var gstinformat = new RegExp('^([0][1-9]|[1-2][0-9]|[3][0-5])([a-zA-Z]{5}[0-9]{4}[a-zA-Z]{1}[1-9a-zA-Z]{1}[zZ]{1}[0-9a-zA-Z]{1})+$$');
            if (!gstinformat.test(gst)) {
                //  $('#error').text('Invalid GST No')
                //  return false;
                $("#PinEdit").parent().after("<div class='alert alert-success' style='color:red;margin-bottom: 20px;'><strong>Error!</strong>'Invalid GST No')'</div>");
                RegisterSuccess.stopImmediatePropagation();
                return false;
            }


        }
        if (Pincode == null || Pincode == '') {
            //  $('#error').text(' Pincode Required')
            //  return false;
            $("#PinEdit").parent().after("<div class='alert alert-success' style='color:red;margin-bottom: 20px;'><strong>Error!</strong>' Pincode Required')'</div>");
            RegisterSuccess.stopImmediatePropagation();
            return false;
        }


    }

</script>
