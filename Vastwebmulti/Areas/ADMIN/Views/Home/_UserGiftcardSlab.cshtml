
@model Vastwebmulti.Areas.ADMIN.Models.GiftcardSlab

@using (Ajax.BeginForm("_UserGiftcardSlab", "Home", new AjaxOptions { HttpMethod = "POST", OnSuccess = "OnSuccess1", OnFailure = "onfailed", UpdateTargetId = "divEditFormComm", LoadingElementId = "div_Loader", InsertionMode = InsertionMode.Replace }))
{
    <input id="btnsubmituser" type="submit" value="Update For Existing Users" class="btn waves-effect vm-pg-slab-save-btn" style="display:none;" />
    <input id="btnsubmitusercommon" type="submit" name="Button" value="Update Existing & New Users" class="btn waves-effect vm-pg-slab-save-btn" style="display:none;" />

    @Html.HiddenFor(m => m.role, new { id = "role" })
    <div class="row clearfix" style="margin-right:0px;">
        <div class="col-md-12">
            <div class="slab-master-block vm-prepaid-user-filter vm-prepaid-user-filter--inline">
                <div id="slab-master-message" class="slab-master-message slab-master-message-show" style="display: none;">
                    <p>If you edit the slabs of all the master distributors, you are given a data view of the common slabs.</p>
                </div>
                <div id="slab-master-detail" class="slab-master-detail slab-master-detail-hide vm-prepaid-user-filter__row" style="display: block;">
                    <div class="vm-prepaid-user-filter__item vm-prepaid-user-filter__item--select">
                        <div class="vm-pg-slab-field">
                            <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-users"></i></span>
                            @Html.DropDownList("ddlUserId", Model.UserId, "All Users", new { @class = "for-select2 form-control", @onchange = "ddlUserIdChange()" })
                        </div>
                    </div>
                    <div class="vm-prepaid-user-filter__item">
                        <div class="vm-pg-slab-field">
                            <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-user"></i></span>
                            <input class="form-control" type="text" placeholder="User Name" value="@Model.Name" readonly="readonly" />
                        </div>
                    </div>
                    <div class="vm-prepaid-user-filter__item">
                        <div class="vm-pg-slab-field">
                            <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-phone-alt"></i></span>
                            <input class="form-control" type="text" placeholder="User Registered Number" value="@Model.Phone" readonly="readonly" />
                        </div>
                    </div>
                    <div class="vm-prepaid-user-filter__item">
                        <div class="vm-pg-slab-field">
                            <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-envelope"></i></span>
                            <input class="form-control" type="text" placeholder="User Registered Mail" value="@Model.Email" readonly="readonly" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="vm-pg-slab-table-scroll saas-acc-table-wrap vm-prepaid-slab-table-wrap">
    <table id="giftcardUserSlabTable" class="table table-bordered vm-pg-slab-table third-design-table slab-table">
        <thead>
            <tr>
                <th>User&nbsp;ID</th>
                <th>Operator&nbsp;Name</th>
                <th>Commission&nbsp;(%)</th>
                @*<th>Status</th>*@

            </tr>
        </thead>
        <tbody id="tbodyshow" class="vm-pg-slab-tbody--view">
            <!--Master User-->
            @if (Model.Materuser != null)
            {
                for (int i = 0; i < Model.Materuser.Count; i++)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(a => a.Materuser[i].Email)
                        </td>
                        <td>
                            @Html.DisplayFor(a => a.Materuser[i].OperatorName)

                        </td>
                        <td>
                            @Html.DisplayFor(a => a.Materuser[i].comm)

                        </td>

                    </tr>

                }
            }
            <!--End Master-->
            <!--Dealer User-->
            @if (Model.Dealeruser != null)
            {
                for (int i = 0; i < Model.Dealeruser.Count; i++)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(a => a.Dealeruser[i].Email)
                        </td>
                        <td>
                            @Html.DisplayFor(a => a.Dealeruser[i].OperatorName)

                        </td>
                        <td>
                            @Html.DisplayFor(a => a.Dealeruser[i].comm)

                        </td>

                    </tr>

                }
            }
            <!--End Dealer-->
            <!--Retailer User-->
            @if (Model.Retaileruser != null)
            {
                for (int i = 0; i < Model.Retaileruser.Count; i++)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(a => a.Retaileruser[i].Email)
                        </td>
                        <td>
                            @Html.DisplayFor(a => a.Retaileruser[i].OperatorName)

                        </td>
                        <td>
                            @Html.DisplayFor(a => a.Retaileruser[i].comm)

                        </td>

                    </tr>

                }
            }
            <!--End Retailer-->
            <!--Whitelabel User-->
            @if (Model.Whitelabeluser != null)
            {
                for (int i = 0; i < Model.Whitelabeluser.Count; i++)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(a => a.Whitelabeluser[i].Email)
                        </td>
                        <td>
                            @Html.DisplayFor(a => a.Whitelabeluser[i].OperatorName)

                        </td>
                        <td>
                            @Html.DisplayFor(a => a.Whitelabeluser[i].comm)

                        </td>

                    </tr>

                }
            }
            <!--End Whitelabel-->

        </tbody>
        <tbody id="tbodyedit" class="vm-pg-slab-tbody--hidden">
            <!--Master User-->
            @if (Model.Materuser != null)
            {
                for (int i = 0; i < Model.Materuser.Count; i++)
                {
                    <tr>
                        @Html.HiddenFor(a => a.Materuser[i].RolesName)
                        @Html.HiddenFor(a => a.Materuser[i].idno)
                        @Html.HiddenFor(a => a.Materuser[i].optcode)
                        <td>
                            @Html.DisplayFor(a => a.Materuser[i].Email)
                        </td>
                        <td>
                            @Html.DisplayFor(a => a.Materuser[i].OperatorName)
                        </td>
                        <td>
                            @Html.EditorFor(a => a.Materuser[i].comm, new { htmlAttributes = new { @style = "width:100%" } })
                            @Html.ValidationMessageFor(a => a.Materuser[i].comm)
                        </td>


                    </tr>
                }
            }
            <!--End Master-->
            <!--Dealer User-->
            @if (Model.Dealeruser != null)
            {
                for (int i = 0; i < Model.Dealeruser.Count; i++)
                {
                    <tr>
                        @Html.HiddenFor(a => a.Dealeruser[i].RolesName)
                        @Html.HiddenFor(a => a.Dealeruser[i].idno)
                        @Html.HiddenFor(a => a.Dealeruser[i].optcode)
                        <td>
                            @Html.DisplayFor(a => a.Dealeruser[i].Email)
                        </td>
                        <td>
                            @Html.DisplayFor(a => a.Dealeruser[i].OperatorName)
                        </td>
                        <td>
                            @Html.EditorFor(a => a.Dealeruser[i].comm, new { htmlAttributes = new { @style = "width:100%" } })
                            @Html.ValidationMessageFor(a => a.Dealeruser[i].comm)
                        </td>


                    </tr>
                }
            }
            <!--End Dealer-->
            <!--Retailer User-->
            @if (Model.Retaileruser != null)
            {
                for (int i = 0; i < Model.Retaileruser.Count; i++)
                {
                    <tr>
                        @Html.HiddenFor(a => a.Retaileruser[i].RolesName)
                        @Html.HiddenFor(a => a.Retaileruser[i].idno)
                        @Html.HiddenFor(a => a.Retaileruser[i].optcode)
                        <td>
                            @Html.DisplayFor(a => a.Retaileruser[i].Email)
                        </td>
                        <td>
                            @Html.DisplayFor(a => a.Retaileruser[i].OperatorName)
                        </td>
                        <td>
                            @Html.EditorFor(a => a.Retaileruser[i].comm, new { htmlAttributes = new { @style = "width:100%" } })
                            @Html.ValidationMessageFor(a => a.Retaileruser[i].comm)
                        </td>


                    </tr>
                }
            }
            <!--End Retailer-->
            <!--Whitelabel User-->
            @if (Model.Whitelabeluser != null)
            {
                for (int i = 0; i < Model.Whitelabeluser.Count; i++)
                {
                    <tr>
                        @Html.HiddenFor(a => a.Whitelabeluser[i].RolesName)
                        @Html.HiddenFor(a => a.Whitelabeluser[i].idno)
                        @Html.HiddenFor(a => a.Whitelabeluser[i].optcode)
                        <td>
                            @Html.DisplayFor(a => a.Whitelabeluser[i].Email)
                        </td>
                        <td>
                            @Html.DisplayFor(a => a.Whitelabeluser[i].OperatorName)
                        </td>
                        <td>
                            @Html.EditorFor(a => a.Whitelabeluser[i].comm, new { htmlAttributes = new { @style = "width:100%" } })
                            @Html.ValidationMessageFor(a => a.Whitelabeluser[i].comm)
                        </td>


                    </tr>
                }
            }
            <!--End Whitelabel-->

        </tbody>
        <tbody id="tbodyeditAll" class="vm-pg-slab-tbody--hidden">
            <!--Master User Update-->
            @if (Model.Materuser != null)
            {
                for (int i = 0; i < Model.UpdateMaster.Count; i++)
                {

                    <tr>
                        @Html.HiddenFor(a => a.UpdateMaster[i].idno)

                        <td>
                            <p>All</p>
                        </td>
                        <td style="display:none;">
                            @Html.HiddenFor(a => a.UpdateMaster[i].optcode)
                        </td>
                        <td>
                            @Html.DisplayFor(a => a.UpdateMaster[i].OperatorName)

                        </td>
                        <td>
                            @Html.TextBoxFor(a => a.UpdateMaster[i].comm, new { @style = "width:100%" })
                            @Html.ValidationMessageFor(a => a.UpdateMaster[i].comm)
                        </td>


                    </tr>
                }
            }
            <!--End Master User-->
            <!--Dealer User Update-->
            @if (Model.Dealeruser != null)
            {
                for (int i = 0; i < Model.UpdateDealer.Count; i++)
                {
                    var endID = Model.UpdateDealer[i].idno;
                    <tr>
                        @Html.HiddenFor(a => a.UpdateDealer[i].idno)

                        <td>
                            <p>All</p>
                        </td>
                        <td style="display:none;">
                            @Html.HiddenFor(a => a.UpdateDealer[i].optcode)
                        </td>
                        <td>
                            @Html.DisplayFor(a => a.UpdateDealer[i].OperatorName)

                        </td>
                        <td>
                            @Html.TextBoxFor(a => a.UpdateDealer[i].comm, new { @style = "width:100%" })
                            @Html.ValidationMessageFor(a => a.UpdateDealer[i].comm)
                        </td>
                    </tr>
                }
            }
            <!--End Dealer User-->
            <!--Retailer User Update-->
            @if (Model.UpdateRetailer != null)
            {
                for (int i = 0; i < Model.UpdateRetailer.Count; i++)
                {
                    var endID = Model.UpdateRetailer[i].idno;
                    <tr>
                        @Html.HiddenFor(a => a.UpdateRetailer[i].idno)

                        <td>
                            <p>All</p>
                        </td>
                        <td style="display:none;">
                            @Html.HiddenFor(a => a.UpdateRetailer[i].optcode)
                        </td>
                        <td>
                            @Html.DisplayFor(a => a.UpdateRetailer[i].OperatorName)

                        </td>
                        <td>
                            @Html.TextBoxFor(a => a.UpdateRetailer[i].comm, new { @style = "width:100%" })
                            @Html.ValidationMessageFor(a => a.UpdateRetailer[i].comm)
                        </td>
                    </tr>
                }
            }
            <!--End Retailer User-->
            <!--WHITELABEL User Update-->
            @if (Model.Whitelabeluser != null)
            {
                for (int i = 0; i < Model.UpdateWhitelabel.Count; i++)
                {
                    var endID = Model.UpdateWhitelabel[i].idno;
                    <tr>
                        @Html.HiddenFor(a => a.UpdateWhitelabel[i].idno)

                        <td>
                            <p>All</p>
                        </td>
                        <td style="display:none;">
                            @Html.HiddenFor(a => a.UpdateWhitelabel[i].optcode)
                        </td>
                        <td>
                            @Html.DisplayFor(a => a.UpdateWhitelabel[i].OperatorName)

                        </td>
                        <td>
                            @Html.TextBoxFor(a => a.UpdateWhitelabel[i].comm, new { @style = "width:100%" })
                            @Html.ValidationMessageFor(a => a.UpdateWhitelabel[i].comm)
                        </td>
                    </tr>
                }
            }
            <!--End api User-->

        </tbody>
    </table>
    </div>
}
<script>
    function OnSuccess1(data) {
        $('#btnsubmituser, #btnsubmitusercommon').hide().removeClass('is-visible');
        $('#btnEdit').show().removeClass('is-hidden');
        if (typeof resetSlabViewMode === 'function') {
            resetSlabViewMode();
        }
    }
    function onfailed(error) {
        alert(error.responseText);
    }
</script>