@model IEnumerable<Vastwebmulti.Models.daywisecomm>
@using System
@using System.Linq
@using System.Collections.Generic
@using Vastwebmulti.Models
@{
    ViewBag.Title = "Extra Commission History";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    VastwebmultiEntities db = new VastwebmultiEntities();

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var dateMode = Request.HttpMethod.Equals("POST", StringComparison.OrdinalIgnoreCase) || (ViewBag.chk as string) == "post" ? "post" : "get";
    var selectedRetailer = (Request["allretailer"] ?? "").Trim();
    var reports = Model ?? Enumerable.Empty<daywisecomm>();
    var rowCount = reports.Count();
    decimal totalComm = reports.Sum(i => i.comm ?? 0m);
    decimal totalDlmComm = reports.Sum(i => i.dlmcomm ?? 0m);
    decimal totalMdComm = reports.Sum(i => i.mdcomm ?? 0m);

    var retailerItems = (ViewBag.allretailer as SelectList)?.ToList() ?? new List<SelectListItem>();
    if (!string.IsNullOrEmpty(selectedRetailer))
    {
        foreach (var item in retailerItems)
        {
            item.Selected = string.Equals(item.Value, selectedRetailer, StringComparison.OrdinalIgnoreCase);
        }
    }
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=56" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=35" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-security-report-page saas-daywise-comm-history-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var historyFormAttrs = new Dictionary<string, object>
            {
                { "id", "daywiseCommHistoryForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("daywisecommhistory", "Home", FormMethod.Post, historyFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line vm-gift-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Report's</li>
                        <li>Extra Commission History</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters vm-ecomm-filter-row--one-line vm-gift-filter-row--one-line">

                        <div class="vm-opr-field vm-dmt-field vm-daywise-comm-history-field--retailer">
                            @Html.DropDownList("allretailer", retailerItems, "All Retailer", new { id = "allretailer", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar" aria-hidden="true"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar" aria-hidden="true"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" name="btntype" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

            </div>
        }

        <div class="vm-opr-main-card vm-security-report-main-card vm-gift-report-main-card vm-daywise-comm-history-main-card">
            <div class="vm-opr-table-panel vm-security-report-table-panel vm-gift-report-table-panel vm-daywise-comm-history-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head vm-security-report-table-head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-history" aria-hidden="true"></i>
                        <span>Extra commission history</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong id="daywiseCommHistoryRecordCount">@rowCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total vm-daywise-comm-history-total-badge" title="Total retailer commission">
                            Comm: <strong id="daywiseCommHistoryTotalComm">? @totalComm.ToString("N2")</strong>
                        </span>
                        <span class="vm-radiant-inline-total vm-daywise-comm-history-dlm-badge" title="Total distributor commission">
                            Dist: <strong id="daywiseCommHistoryTotalDlm">? @totalDlmComm.ToString("N2")</strong>
                        </span>
                        <span class="vm-radiant-inline-total vm-daywise-comm-history-md-badge" title="Total master commission">
                            MD: <strong id="daywiseCommHistoryTotalMd">? @totalMdComm.ToString("N2")</strong>
                        </span>
                    </div>
                </div>

                <div class="vm-opr-table-wrap vm-daywise-comm-history-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="daywiseCommHistoryTable" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Sr.</th>
                                    <th>User</th>
                                    <th>Commission</th>
                                    <th>Remain-Pre</th>
                                    <th>Remain-Post</th>
                                    <th>Dist.&nbsp;Comm</th>
                                    <th>Dist.&nbsp;Remain-Pre</th>
                                    <th>Dist.&nbsp;Remain-Post</th>
                                    <th>MD&nbsp;Comm</th>
                                    <th>MD&nbsp;Remain-Pre</th>
                                    <th>MD&nbsp;Remain-Post</th>
                                    <th>Date&nbsp;&amp;&nbsp;Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (rowCount == 0)
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="12">No records found for the selected filters.</td>
                                    </tr>
                                }
                                else
                                {
                                    var sr = 1;
                                    foreach (var item in reports)
                                    {
                                        var retailer = !string.IsNullOrWhiteSpace(item.userid)
                                            ? db.Retailer_Details.FirstOrDefault(s => s.RetailerId == item.userid)
                                            : null;
                                        var userFirm = retailer != null ? retailer.Frm_Name : "-";
                                        var userName = retailer != null ? retailer.RetailerName : "-";
                                        var comm = item.comm ?? 0m;
                                        var remainPre = item.remainpre ?? 0m;
                                        var remainPost = item.remainpost ?? 0m;
                                        var dlmComm = item.dlmcomm ?? 0m;
                                        var dlmPre = item.dlmpre ?? 0m;
                                        var dlmPost = item.dlmpost ?? 0m;
                                        var mdComm = item.mdcomm ?? 0m;
                                        var mdPre = item.mdpre ?? 0m;
                                        var mdPost = item.mdpost ?? 0m;
                                        var dateText = item.date.HasValue ? item.date.Value.ToString("dd-MM-yyyy HH:mm:ss") : "-";

                                        <tr class="vm-daywise-comm-history-row"
                                            data-comm="@comm.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-dlm-comm="@dlmComm.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-md-comm="@mdComm.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                            <td class="vm-daywise-comm-history-sr">@sr</td>
                                            <td>
                                                <div class="vm-daywise-comm-history-user">
                                                    <strong class="vm-daywise-comm-history-user__firm">@userFirm</strong>
                                                    @if (!string.IsNullOrWhiteSpace(userName) && userName != "-")
                                                    {
                                                        <span class="vm-daywise-comm-history-user__name">@userName</span>
                                                    }
                                                </div>
                                            </td>
                                            <td class="vm-daywise-comm-history-amount vm-daywise-comm-history-amount--comm">? @comm.ToString("N2")</td>
                                            <td class="vm-daywise-comm-history-amount">? @remainPre.ToString("N2")</td>
                                            <td class="vm-daywise-comm-history-amount">? @remainPost.ToString("N2")</td>
                                            <td class="vm-daywise-comm-history-amount vm-daywise-comm-history-amount--dlm">? @dlmComm.ToString("N2")</td>
                                            <td class="vm-daywise-comm-history-amount">? @dlmPre.ToString("N2")</td>
                                            <td class="vm-daywise-comm-history-amount">? @dlmPost.ToString("N2")</td>
                                            <td class="vm-daywise-comm-history-amount vm-daywise-comm-history-amount--md">? @mdComm.ToString("N2")</td>
                                            <td class="vm-daywise-comm-history-amount">? @mdPre.ToString("N2")</td>
                                            <td class="vm-daywise-comm-history-amount">? @mdPost.ToString("N2")</td>
                                            <td class="vm-daywise-comm-history-date">@dateText</td>
                                        </tr>
                                        sr++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>


<script>
    function formatDaywiseCommHistoryAmount(value) {
        var num = parseFloat(value);
        if (isNaN(num)) {
            return '0.00';
        }
        return num.toFixed(2);
    }

    function refreshDaywiseCommHistorySummary() {
        var rows = document.querySelectorAll('#daywiseCommHistoryTable tbody tr.vm-daywise-comm-history-row');
        var totalComm = 0;
        var totalDlm = 0;
        var totalMd = 0;

        for (var i = 0; i < rows.length; i++) {
            var comm = parseFloat(rows[i].getAttribute('data-comm') || '0');
            var dlm = parseFloat(rows[i].getAttribute('data-dlm-comm') || '0');
            var md = parseFloat(rows[i].getAttribute('data-md-comm') || '0');
            if (!isNaN(comm)) { totalComm += comm; }
            if (!isNaN(dlm)) { totalDlm += dlm; }
            if (!isNaN(md)) { totalMd += md; }
        }

        $('#daywiseCommHistoryRecordCount').text(rows.length);
        $('#daywiseCommHistoryTotalComm').text('? ' + formatDaywiseCommHistoryAmount(totalComm));
        $('#daywiseCommHistoryTotalDlm').text('? ' + formatDaywiseCommHistoryAmount(totalDlm));
        $('#daywiseCommHistoryTotalMd').text('? ' + formatDaywiseCommHistoryAmount(totalMd));
    }

    function destroyDaywiseCommHistorySelect2($el) {
        if ($el && $el.length && $el.data('select2')) {
            $el.select2('destroy');
        }
    }

    function applyDaywiseCommHistorySelect2($el) {
        if (!$el || !$el.length || !$.fn.select2) {
            return;
        }
        destroyDaywiseCommHistorySelect2($el);
        $el.select2({
            width: '100%',
            minimumResultsForSearch: 6,
            dropdownParent: $('#daywiseCommHistoryForm')
        });
    }

    function syncDaywiseCommHistorySelectWidth() {
        var $field = $('.vm-daywise-comm-history-field--retailer');
        $field.css({ width: '100%', maxWidth: '100%' });
        $('#allretailer').css({ width: '100%', maxWidth: '100%' });
        $('#daywiseCommHistoryForm .select2-container').css({ width: '100%', maxWidth: '100%' });
    }

    function initDaywiseCommHistorySelect2() {
        applyDaywiseCommHistorySelect2($('#allretailer'));
        window.setTimeout(syncDaywiseCommHistorySelectWidth, 0);
        window.setTimeout(syncDaywiseCommHistorySelectWidth, 120);
    }

    function initDaywiseCommHistoryDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initDaywiseCommHistoryDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm('#daywiseCommHistoryForm');
        }
    }

    $(document).ready(function () {
        initDaywiseCommHistorySelect2();
        initDaywiseCommHistoryDatepickers();
        refreshDaywiseCommHistorySummary();
        $(window).on('resize orientationchange', syncDaywiseCommHistorySelectWidth);
    });
</script>
