@model Vastwebmulti.Areas.ADMIN.Models.pancard_reports
@{
    ViewBag.Title = "TokenPurchaseReport";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
    ViewBag.PancardActiveTab = "old";
    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-pancard-report-modern.css?v=6" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.0.1/css/toastr.css" rel="stylesheet" />
<script src="~/MainFrontDesign/js/admin-financial-report.js?v=9"></script>
<script src="~/MainFrontDesign/js/admin-pancard-report.js?v=2"></script>
<script src="~/MainFrontDesign/js/admin-pancard-old-report.js?v=1"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.0.1/js/toastr.js"></script>

<div id="loaderpancard" class="vm-dmt-loader" style="display:none;"></div>
<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-pancard-report-page saas-pancard-new-page saas-pancard-old-page">
    <div class="container-fluid vm-opr-page-shell">

        @using (Html.BeginForm("TokenPurchaseReport", "Home", FormMethod.Post, new { id = "pancardOldForm", @class = "vm-rpt-filters-panel__form" }))
        {
            <input type="hidden" name="check" value="qq" />
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Financial Services</li>
                        <li>Pan Card Report</li>
                    </ol>
                    <div class="vm-dmt-fin-nav-row">
                        @Html.Partial("_finicalmenureport")
                    </div>
                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="pancardTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Transaction totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hidePancardTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Success</span>
                            <strong class="vm-opr-total-card__value" id="successtotal">&#8377;</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Failed</span>
                            <strong class="vm-opr-total-card__value" id="Failedtotal">&#8377;</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Pending</span>
                            <strong class="vm-opr-total-card__value" id="Pendingtotal">&#8377;</strong>
                        </div>
                    </div>
                </div>

                <div class="vm-rpt-filters-panel">
                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--pancard-old vm-rpt-filters-panel__bar">
                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("ddlusers", new List<SelectListItem>
                            {
                                new SelectListItem{ Text="All User", Value="Admin"},
                                new SelectListItem{ Text="Master D", Value="Master"},
                                new SelectListItem{ Text="Distributor", Value="Dealer"},
                                new SelectListItem{ Text="Retailer", Value="Retailer"},
                                new SelectListItem{ Text="Api User", Value="APIID"},
                                new SelectListItem{ Text="Whitelabel", Value="WAdmin"}
                            }, new { @class = "vm-opr-select vm-dmt-select form-control", @title = "User type", @onchange = "answers1()" })
                        </div>
                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="allmaster" style="display:none;">
                            @Html.DropDownList("allmaster1", ViewBag.allmaster as SelectList, "All Master", new { id = "allmaster1", @class = "vm-opr-select vm-dmt-select form-control", @title = "Master" })
                        </div>
                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="dlm" style="display:none;">
                            @Html.DropDownList("alldealer", ViewBag.alldealer as SelectList, "All Distributor", new { id = "alldealer", @class = "vm-opr-select vm-dmt-select form-control", @title = "Distributor" })
                        </div>
                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="rem" style="display:none;">
                            @Html.DropDownList("allretailer", ViewBag.allretailer as SelectList, "All Retailer", new { id = "allretailer", @class = "vm-opr-select vm-dmt-select form-control", @title = "Retailer" })
                        </div>
                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="apiid" style="display:none;">
                            @Html.DropDownList("allapiuser", ViewBag.apiid as SelectList, "All API", new { id = "allapiuser", @class = "vm-opr-select vm-dmt-select form-control", @title = "API user" })
                        </div>
                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="whitelabelid" style="display:none;">
                            @Html.DropDownList("Whitelabel", ViewBag.whitelabel as SelectList, "Select Whitelabel", new { id = "Whitelabel", @class = "vm-opr-select vm-dmt-select form-control", @title = "Whitelabel" })
                        </div>
                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("ddl_status", new List<SelectListItem>
                            {
                                new SelectListItem{ Text="All Status", Value="ALL"},
                                new SelectListItem{ Text="Success", Value="SUCCESS"},
                                new SelectListItem{ Text="Pending", Value="PENDING"},
                                new SelectListItem{ Text="Failed", Value="FAILED"}
                            }, new { @class = "vm-opr-select vm-dmt-select form-control", @title = "Status" })
                        </div>
                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-id-card" aria-hidden="true"></i>
                        <span>Pan card transactions</span>
                    </div>
                    <div class="vm-dmt-table-panel__right vm-pancard-table-head-right">
                        @Html.Partial("_PancardReportTabs")
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-pancard-totals-btn" onclick="findtotal()" title="Show totals" aria-expanded="false" aria-controls="pancardTotalsPanel"><i class="fas fa-chart-pie" aria-hidden="true"></i></button>
                            <button type="button" id="btnExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel"><i class="fas fa-file-excel" aria-hidden="true"></i> Excel</button>
                            <button type="button" id="btnPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF"><i class="fas fa-file-pdf" aria-hidden="true"></i> PDF</button>
                        </div>
                    </div>
                </div>
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="hhhh" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>S.R.</th>
                                    <th>#&nbsp;User's&nbsp;Information</th>
                                    <th>Merchant&nbsp;Id</th>
                                    <th>Physical</th>
                                    <th>Digital</th>
                                    <th>Processing&nbsp;Fees&nbsp;&#8377;</th>
                                    <th>UTI&nbsp;TXN&nbsp;ID</th>
                                    <th>User&nbsp;Income&nbsp;&#8377;</th>
                                    <th>User&nbsp;Post&nbsp;&#8377;</th>
                                    <th>User&nbsp;Pre&nbsp;&#8377;</th>
                                    <th>Date</th>
                                    <th>Total&nbsp;&#8377;</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody id="trow">
                                @Html.Partial("_TokenPurchaseReport", Model.p_Transations_report_olds11)
                            </tbody>
                        </table>
                        <div id="loadingdiv" class="vm-opr-table-loading" style="display:none;">
                            <img src="~/img/ajax-loader.gif" alt="Loading" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@Html.Partial("_PancardTokenDetailModal")

<script src="~/Swalalert/sweetalert-dev.js"></script>
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />

<script>
    window.pancardOldTotalsUrl = '@Url.Action("TokenPurchaseReport_Total", "Home")';

    var pageindex = 2;
    var NoMoredata = false;
    var inProgress = false;
    $(window).scroll(function () {
        if ($(window).scrollTop() > Number($("#hhhh").height()) / 4 && !NoMoredata && !inProgress) {
            inProgress = true;
            $("#loadingdiv").show();
            $.post("@Url.Action("InfiniteScroll3", "Home")",
                {
                    pageindex: pageindex,
                    ddlusers: $('#ddlusers').val(),
                    allmaster: $('#allmaster1').val(),
                    alldealer: $('#alldealer').val(),
                    allretailer11: $('#allretailer').val(),
                    allapiuser: $('#allapiuser').val(),
                    Whitelabel: $('#Whitelabel').val(),
                    ddl_status: $('#ddl_status').val(),
                    txt_frm_date: $('#txt_frm_date').val(),
                    txt_to_date: $('#txt_to_date').val()
                },
                function (data) {
                    pageindex += 1;
                    NoMoredata = data.NoMoredata;
                    $("#trow").append(data.HTMLString);
                    $("#loadingdiv").hide();
                    inProgress = false;
                    if (window.vmPancardRenumberSr) { window.vmPancardRenumberSr(); }
                });
        }
    });

    $("#btnExport").click(function () {
        var txt_frm_date = $('#txt_frm_date').val();
        var txt_to_date = $('#txt_to_date').val();
        var ddlusers = $('#ddlusers').val();
        var ddl_status = $('#ddl_status').val();
        var alldealer = $('#alldealer').val();
        var allretailer = $('#allretailer').val();
        var allmaster = $('#allmaster1').val();
        var allapiuser = $('#allapiuser').val();
        var Whitelabel = $('#Whitelabel').val();
        var ddl_Type = $('#ddl_Type').val() || '';
        var url = '@Url.Action("ExcelRechargereport1", "Home")?txt_frm_date=' + txt_frm_date + '&txt_to_date=' + txt_to_date + '&ddlusers=' + ddlusers + '&ddl_status=' + ddl_status + '&allmaster1=' + allmaster + '&alldealer=' + alldealer + '&allretailer=' + allretailer + '&allapiuser=' + allapiuser + '&Whitelabel=' + Whitelabel + '&ddl_Type=' + ddl_Type;
        location.href = url;
    });

    $("#btnPDF").click(function () {
        var txt_frm_date = $('#txt_frm_date').val();
        var txt_to_date = $('#txt_to_date').val();
        var ddlusers = $('#ddlusers').val();
        var ddl_status = $('#ddl_status').val();
        var alldealer = $('#alldealer').val();
        var allretailer = $('#allretailer').val();
        var allmaster = $('#allmaster1').val();
        var allapiuser = $('#allapiuser').val();
        var Whitelabel = $('#Whitelabel').val();
        var ddl_Type = $('#ddl_Type').val() || '';
        var url = '@Url.Action("PDFRechargereport_token", "Home")?txt_frm_date=' + txt_frm_date + '&txt_to_date=' + txt_to_date + '&ddlusers=' + ddlusers + '&ddl_status=' + ddl_status + '&allmaster1=' + allmaster + '&alldealer=' + alldealer + '&allretailer=' + allretailer + '&allapiuser=' + allapiuser + '&Whitelabel=' + Whitelabel + '&ddl_Type=' + ddl_Type;
        window.open(url, '_blank');
    });

    function mdActionBtn(Idno) {
        $('#loadredmodel').show();
        $.ajax({
            url: '@Url.Action("Token_report_View", "Home")',
            type: "POST",
            data: { Idno: Idno },
            cache: false,
            success: function (Response) {
                $("#retailer_dealer_pre").val(Response[0].retailer_dealer_pre);
                $("#DealerIncome").val(Response[0].DealerIncome);
                $("#retailer_dealer_post").val(Response[0].retailer_dealer_post);
                $("#retailer_master_pre").val(Response[0].retailer_master_pre);
                $("#MDIncome").val(Response[0].MDIncome);
                $("#retailer_master_post").val(Response[0].retailer_master_post);
                $("#whitelabel_remain_pre").val(Response[0].whitelabel_remain_pre);
                $("#whitelabelincome").val(Response[0].whitelabelincome);
                $("#whitelabel_remain_post").val(Response[0].whitelabel_remain_post);
                $("#CouponStatus").val(Response[0].CouponStatus);
                $("#Request").val(Response[0].Request);
                $("#Response").val(Response[0].response_output);
                $('#loadredmodel').hide();
            },
            error: function () { $('#loadredmodel').hide(); }
        });
    }

    function tokenStatus(id) {
        $.post('@Url.Action("GetTokenStatus", "Home")', { id: id }, function (data) {
            var response = JSON.parse(data);
            ToastrMessage();
            if (response.RESULT == "0") {
                toastr.success('Wow! ' + response.ADDINFO);
            } else {
                toastr.error('Oops!!! ' + response.ADDINFO);
            }
        }).fail(function (jqXHR) {
            ToastrMessage();
            toastr.error('Oops!!! ' + jqXHR.responseText);
        });
    }

    function manuallyfailed(id, msg) {
        $.post('@Url.Action("PanManualFailed", "Home")', { id: id, remark: msg }, function (data) {
            var response = JSON.parse(data);
            if (response.RESULT == "0") {
                swal("Wow!", response.ADDINFO, "success");
            } else {
                swal("Oops!!!", response.ADDINFO, "error");
            }
        }).fail(function (jqXHR) {
            ToastrMessage();
            toastr.error('Oops!!!' + jqXHR.responseText);
        });
    }

    function ToastrMessage() {
        toastr.options = {
            closeButton: false,
            positionClass: "toast-top-right1",
            progressBar: true,
            preventDuplicates: true,
            timeOut: "5000"
        };
    }

    $(document).ready(function () {
        var val = '@ViewBag.chk';
        if (val != "post") {
            $("#txt_frm_date").datepicker("setDate", new Date());
            $("#txt_to_date").datepicker("setDate", new Date());
        }
    });
</script>
