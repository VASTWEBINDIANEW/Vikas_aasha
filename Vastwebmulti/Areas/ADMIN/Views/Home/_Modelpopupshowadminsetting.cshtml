@model IEnumerable<Vastwebmulti.Models.Login_setting_email_phone>

<div class="wl-perm-drawer wl-drawer-visible">
    <div class="wl-perm-drawer__intro">
        <div class="wl-perm-drawer__intro-icon"><i class="fas fa-user-shield"></i></div>
        <div>
            <h3 class="wl-perm-drawer__title">Admin Login Permission</h3>
            <p class="wl-perm-drawer__sub">Toggle mobile and email login access for your admin account.</p>
        </div>
    </div>

    <div id="Statussetting" class="wl-perm-grid">
        @foreach (var item in Model)
        {
            <div class="wl-perm-card">
                <div class="wl-perm-card__top">
                    <div class="wl-perm-card__icon wl-perm-card__icon--mobile"><i class="fas fa-mobile-alt"></i></div>
                    <div class="wl-perm-card__info">
                        <h4>Mobile Login</h4>
                        <p>Login using registered mobile number</p>
                    </div>
                </div>
                @if (item.mobile == true)
                {
                    <button type="button" class="wl-perm-toggle wl-perm-toggle--on" onclick="updatedata('mobile')">
                        <i class="fas fa-check-circle"></i>
                        <span>Active</span>
                    </button>
                }
                else
                {
                    <button type="button" class="wl-perm-toggle wl-perm-toggle--off" onclick="updatedata('mobile')">
                        <i class="fas fa-times-circle"></i>
                        <span>Deactive</span>
                    </button>
                }
            </div>

            <div class="wl-perm-card">
                <div class="wl-perm-card__top">
                    <div class="wl-perm-card__icon wl-perm-card__icon--email"><i class="fas fa-envelope"></i></div>
                    <div class="wl-perm-card__info">
                        <h4>Email Login</h4>
                        <p>Login using registered email address</p>
                    </div>
                </div>
                @if (item.email == true)
                {
                    <button type="button" class="wl-perm-toggle wl-perm-toggle--on" onclick="updatedata('email')">
                        <i class="fas fa-check-circle"></i>
                        <span>Active</span>
                    </button>
                }
                else
                {
                    <button type="button" class="wl-perm-toggle wl-perm-toggle--off" onclick="updatedata('email')">
                        <i class="fas fa-times-circle"></i>
                        <span>Deactive</span>
                    </button>
                }
            </div>
        }
    </div>
</div>
