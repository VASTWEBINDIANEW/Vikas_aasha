<!--Edit Lapu Report-->
<script type="text/javascript">
    var val1 = "";
    function animation(port, simno, idno, Operator, Code, pinno, method, minbal, maxdaily, txtpurcharge,imeino) {
        $("#txtsimno").val(simno);
        $("#txtidno").val(idno);
        $("#txtOperator").val(Operator);
        $("#txtCode").val(Code);
        $("#txtpinno").val(pinno);
        $("#txtmethod").val(method);
        $("#txtminbal").val(minbal);
        $("#txtport").val(port);
        $("#txtport").val(port);
        $("#txtdailymax").val(maxdaily);
        $("#txtpurcharge").val(txtpurcharge);
        $("#txtimeino").val(imeino);
    }
    $(document).ready(function () {
        var hh = $("#lapuno11").val();
        if (hh != "" && hh != null) {
            $('#chkchk').show();
            $('#btnNewLapu').data('port', hh);
        }

        $('#lapuno11').on('change', function () {
            var port = $(this).val();
            if (port) {
                $('#chkchk').show();
                $('#btnNewLapu').data('port', port);
            } else {
                $('#chkchk').hide();
            }
        });

        $('#btnNewLapu').on('click', function () {
            animation1($(this).data('port') || $('#lapuno11').val(), $(this).data('sim') || '');
        });

        vmHardwareUpdateLapuTableInfo();
    });

    function vmHardwareUpdateLapuTableInfo() {
        var $rows = $('#hardwareLapuTable tbody tr:not(.vm-hardware-table-empty)');
        var $visible = $rows.filter(':visible');
        var total = $rows.length;
        var vis = $visible.length;
        var $info = $('#vmHardwareLapuTableInfo');

        if (total === 0) {
            $info.text('Showing 0 to 0 of 0 entries');
        } else if (vis === 0) {
            $info.text('Showing 0 to 0 of ' + total + ' entries');
        } else {
            $info.text('Showing 1 to ' + vis + ' of ' + total + ' entries');
        }
    }

    $(document).ready(function () {
        $('#vmHardwareLapuSearch').on('input', function () {
            var q = $.trim($(this).val()).toLowerCase();
            $('#hardwareLapuTable tbody tr:not(.vm-hardware-table-empty)').each(function () {
                var match = !q || $(this).text().toLowerCase().indexOf(q) !== -1;
                $(this).toggle(match);
            });
            vmHardwareUpdateLapuTableInfo();
        });
    });
    function animation1(port, simno) {
        $("#txtportnonew").val(port);
        $("#txtSimnonew").val(simno);
    }
    function del(id, portno) {

       
       
