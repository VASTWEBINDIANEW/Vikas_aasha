@model IEnumerable<Vastwebmulti.Models.srs_lapu_report_n_Result>
@{
    ViewBag.Title = "LapuReport";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var lapuRows = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.srs_lapu_report_n_Result>();
    var firstLapu = lapuRows.FirstOrDefault();
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-settings-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css?v=12" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-payment-gateway-slab-modern.css?v=10" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-prepaid-slab-modern.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-prepaid-slab-modals.css?v=2" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-prepaid-slab-mobile.css?v=6" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-hardware-modern.css?v=12" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-hardware-mobile.css?v=12" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-settings-page saas-pg-slab-page saas-prepaid-slab-page saas-hardware-page second-design">
    <div class="container-fluid">

        <div class="saas-acc-toolbar vm-hardware-toolbar-line vm-hardware-toolbar-line--lapu">
            <ol class="saas-acc-breadcrumb">
                <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                <li><a href="@Url.Action("Dashboard", "Home")#setting">Basic Setting</a></li>
                <li>Lapu Setting</li>
            </ol>
            <div class="vm-hardware-top-actions vm-hardware-top-actions--lapu">
                <div class="vm-hardware-lapu-filter">
                    @using (Html.BeginForm("LapuReport", "Home", FormMethod.Post, new { @class = "vm-hardware-lapu-filter-form" }))
                    {
                        <div class="vm-hardware-lapu-filter__group">
                            <label class="vm-hardware-lapu-filter__label" for="lapuno11">
                                <i class="fas fa-plug" aria-hidden="true"></i>
                                <span>Port</span>
                            </label>
                            @Html.DropDownList("lapuno11", ViewBag.Lapuno as SelectList, "Select Port", new { id = "lapuno11", @class = "vm-hardware-lapu-filter__select" })
                            <button type="submit" class="vm-hardware-lapu-filter__submit">
                                <i class="fas fa-search" aria-hidden="true"></i>
                                <span>Search</span>
                            </button>
                        </div>
                    }
                </div>
                <div id="chkchk" class="vm-hardware-lapu-toolbar-btn" style="@(firstLapu != null || !string.IsNullOrEmpty(Request["lapuno11"]) ? "" : "display:none;")">
                    <button type="button" id="btnNewLapu" class="vm-hardware-btn-new vm-hardware-btn-new--primary vm-hardware-lapu-add-toggle" data-toggle="modal" data-target="#defaultModal"
                            data-port="@(firstLapu != null ? firstLapu.PortNo : Request["lapuno11"])"
                            data-sim="@(firstLapu != null ? firstLapu.Simno : "")">
                        <span class="vm-hardware-btn-new__icon" aria-hidden="true"><i class="fas fa-plus"></i></span>
                        <span class="vm-hardware-btn-new__label">New Lapu</span>
                    </button>
                </div>
                <label class="saas-acc-search vm-hardware-port-search vm-hardware-lapu-table-search" for="vmHardwareLapuSearch">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    <input type="text" id="vmHardwareLapuSearch" placeholder="Search lapu..." autocomplete="off" />
                </label>
            </div>
        </div>

        <div class="vm-prepaid-slab-shell">
            @Html.Partial("_menuport")

            <div class="vm-prepaid-slab-main">
                <div class="vm-pg-slab-card">
                    <div class="vm-pg-slab-card__head">
                        <h3 class="vm-pg-slab-card__title"><i class="fas fa-sim-card" aria-hidden="true"></i> Lapu Setting</h3>
                    </div>
                    <div class="vm-pg-slab-body">
                        <div class="vm-hardware-table-shell">
                            <div class="vm-pg-slab-table-scroll vm-prepaid-slab-table-wrap vm-hardware-table-wrap">
                                <table id="hardwareLapuTable" class="table table-bordered table-striped table-hover vm-pg-slab-table vm-hardware-lapu-table">
                            <thead>
                                            <tr>
                                                <th>Port</th>
                                                @*<th style="padding-left:0px; text-align:center;">Sim No</th>*@
                                                <th>Operator</th>
                                                <th>Code</th>
                                                <th>PIN</th>
                                                <th>Method</th>
                                                <th>Lapu&nbsp;Bal</th>
                                                <th>Min&nbsp;Bal</th>
                                                <th>D-Max&nbsp;Rch</th>
                                                <th>purchase&nbsp;(%)</th>
                                                @*<th style="padding-left:0px; text-align:center;">ImeiNo</th>*@

                                                <th>Sts</th>
                                                <th>Edit</th>
                                                <th>DEL</th>

                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (lapuRows.Any())
                                            {
                                            foreach (var item in lapuRows)
                                            {
                                                <tr>
                                                    <td>@Html.DisplayFor(modelItem => item.PortNo)</td>
                                                    @*<td style="padding:3px;">@Html.DisplayFor(modelItem => item.Simno)</td>*@
                                                    <td>@Html.DisplayFor(modelItem => item.simName)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.Code)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.pin)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.method)</td>
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.SimBal)
                                                        <a href="@Url.Action("lapucheckbalance", new {port=item.PortNo,code = item.Code,pin = item.pin,pass=item.method })" class="vm-hardware-balance-refresh">
                                                            <img src="~/AdminDesign/images/refresh.svg" alt="Refresh balance" />
                                                        </a>
                                                    </td>
                                                    <td>@Html.DisplayFor(modelItem => item.minbal)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.maxrch)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.purchase)</td>
                                                    @*<td style="padding:3px;">@Html.DisplayFor(modelItem => item.imeino)</td>*@

                                                    <td>
                                                        <div class="onoffswitch">
                                                            @if (item.ActiveSts == "False")
                                                            {

                                                                <a href="@Url.Action("lapusts",new {id = item.idno, sts = item.ActiveSts, port = item.PortNo })" style="text-decoration:none;">
                                                                    <span class="custom-off">off</span>
                                                                </a>

                                                            }
                                                            else
                                                            {

                                                                <a href="@Url.Action("lapusts",new {id = item.idno, sts = item.ActiveSts, port = item.PortNo })" style="text-decoration:none;">
                                                                    <span class="costom-on">on</span>
                                                                </a>


                                                            }
                                                        </div>
                                                    </td>
                                                    <td>
                                                        <button type="button" class="vm-hardware-edit-btn" onclick="animation('@item.PortNo','@item.Simno','@item.idno','@item.simName','@item.Code','@item.pin','@item.method','@item.minbal','@item.maxrch','@item.purchase','@item.imeino')" data-toggle="modal" data-target="#defaultModal1">
                                                            Edit
                                                        </button>
                                                    </td>
                                                    <td>
                                                        <button type="button" class="vm-hardware-del-btn click-to-sure" aria-label="Delete">
                                                            <img src="~/MainFrontDesign/images/delete.svg" alt="" />
                                                        </button>
                                                        <button type="button" class="vm-hardware-sure-btn" onclick="del('@item.idno','@item.PortNo')">
                                                            Sure?
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                            }
                                            else
                                            {
                                                <tr class="vm-hardware-table-empty">
                                                    <td colspan="12">No data available in table</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                            </div>
                            <div id="vmHardwareLapuTableFooter" class="vm-hardware-table-footer">
                                <span id="vmHardwareLapuTableInfo">Showing 0 to 0 of 0 entries</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
