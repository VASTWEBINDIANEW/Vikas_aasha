@model IEnumerable<Vastwebmulti.Models.PAN_CARD_IPAY_Token_report_paging_Result>
@{
    Layout = null;
    var items = Model == null ? new List<Vastwebmulti.Models.PAN_CARD_IPAY_Token_report_paging_Result>() : Model.ToList();
}
@if (items.Count > 0)
{
    var srIndex = ViewBag.SrOffset != null ? Convert.ToInt32(ViewBag.SrOffset) : 0;
    foreach (var item in items)
    {
        srIndex++;
        var particulars = item.Particulars ?? "";
        var statusTone = "pending";
        var statusFa = "fa-clock-o";
        var statusLabel = "Pending";
        if (particulars.IndexOf("Refund", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "refund";
            statusFa = "fa-undo";
            statusLabel = "Refund";
        }
        else if (particulars.IndexOf("Success", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "success";
            statusFa = "fa-check";
            statusLabel = "Success";
        }
        else if (particulars.IndexOf("Failed", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "failed";
            statusFa = "fa-times";
            statusLabel = particulars;
        }
        else if (particulars.IndexOf("Pending", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "pending";
            statusFa = "fa-clock-o";
            statusLabel = "Pending";
        }
        var userType = !string.IsNullOrWhiteSpace(item.UserType) ? item.UserType : "User";
        var userName = !string.IsNullOrWhiteSpace(item.Frm_Name) ? item.Frm_Name : "�";
        var sd = item.ProcessingFees - item.RetailerIncome;
        <tr class="vm-dmt-row vm-dmt-row--@statusTone">
            <td class="vm-dmt-sr-cell">
                <span class="vm-dmt-sr-num">@srIndex</span>
                <span class="vm-dmt-status vm-dmt-status--@statusTone" title="@statusLabel">
                    <i class="fa @statusFa" aria-hidden="true"></i>
                </span>
            </td>
            <td class="vm-dmt-user-cell">
                <div class="vm-dmt-user-stack">
                    <div class="vm-dmt-user-line">
                        <span class="vm-dmt-user-role">@userType</span>
                        <span class="vm-dmt-user-sep">&rsaquo;</span>
                        <span class="vm-dmt-user-name">@userName</span>
                    </div>
                </div>
            </td>
            <td>@item.MerchantTxnId</td>
            <td>@item.PhysicalCount</td>
            <td>@item.DigitalCount</td>
            <td class="vm-dmt-amt-cell">@item.ProcessingFees</td>
            <td>@item.UTI_TXN_ID</td>
            <td class="vm-dmt-amt-cell">@item.RetailerIncome</td>
            <td>@item.retailer_remain_post</td>
            <td>@item.retailer_remain_pre</td>
            <td class="vm-dmt-time-cell">@item.Date</td>
            <td class="vm-dmt-amt-cell">@sd</td>
            <td class="vm-dmt-action-cell">
                <div class="nrch vm-dmt-action-bar">
                    @if (item.Particulars == "Pending")
                    {
                        <button type="button" class="fftt vm-dmt-act-btn vm-dmt-act-btn--danger" title="Manually failed" onclick="manuallyfailed('@item.idno','Manually Failed')">
                            <i class="fa fa-reply" aria-hidden="true"></i>
                        </button>
                    }
                    <button type="button" class="fftt vm-dmt-act-btn vm-dmt-act-btn--view" title="Check token status" onclick="tokenStatus('@item.idno')">
                        <i class="fa fa-eye" aria-hidden="true"></i>
                    </button>
                    <button type="button" class="fftt vm-dmt-act-btn vm-dmt-act-btn--detail" title="View details" data-toggle="modal" data-target="#defaultModal222" onclick="mdActionBtn('@item.idno')">
                        <i class="fa fa-angle-double-right" aria-hidden="true"></i>
                    </button>
                </div>
            </td>
        </tr>
    }
}
else
{
    <tr class="vm-opr-table-empty-row">
        @if (ViewBag.checkdata != null)
        {
            <td colspan="13" class="vm-opr-table-empty vm-dmt-table-empty">
                <i class="fas fa-search" aria-hidden="true"></i>
                <span>No transactions found for current search.</span>
            </td>
        }
        else
        {
            <td colspan="13" class="vm-opr-table-empty vm-dmt-table-empty">
                <i class="fas fa-id-card" aria-hidden="true"></i>
                <span>Pan card transaction not found.</span>
            </td>
        }
    </tr>
}
