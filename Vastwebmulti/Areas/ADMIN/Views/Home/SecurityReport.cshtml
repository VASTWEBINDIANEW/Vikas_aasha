<script src="~/MainFrontDesign/select2/dist/js/select2.full.min.js"></script>
<script src="~/Swalalert/sweetalert-dev.js"></script>

<script>
    function ActionBtn(resptime, dlmpre, dlmincome, dlmpost, mdpre, mdincome, mdpost, adminincome, apireq, apiresp) {
        $('#resptm').text(resptime);
        $('#distpre').val(dlmpre);
        $('#distincome').val(dlmincome);
        $('#distpost').val(dlmpost);
        $('#mdpre').val(mdpre);
        $('#mdincome').val(mdincome);
        $('#mdpost').val(mdpost);
        $('#adminincome').val(adminincome);
        $('#APIRequest').val(apireq);
        $('#APIResponse').val(apiresp);
    }

    function Successchk(idno) {
        var idnn = idno + 'divchk';
        var rchsuc = idno + 'nrchsuccess';
        var rchfailed = idno + 'nrchfailed';
        $('#' + idnn).hide();
        $('#' + rchsuc).show();
        $('#' + rchfailed).hide();
    }

    function Failedchk(idno) {
        var idnn = idno + 'divchk';
        var rchsuc = idno + 'nrchsuccess';
        var rchfailed = idno + 'nrchfailed';
        $('#' + idnn).hide();
        $('#' + rchsuc).hide();
        $('#' + rchfailed).show();
    }

    function Response(reqid, sts) {
        $.ajax({
            url: '@Url.Action("SecurityManually", "Home")',
            type: 'POST',
            data: { orderid: reqid, status: sts },
            success: function () {
                window.location.reload();
            }
        });
        return true;
    }

    function success(orderid, status) {
        var answer = confirm('Are you sure ?');
        if (!answer) {
            return false;
        }
        $.ajax({
            url: '@Url.Action("GiftcardSuccess", "Home")',
            type: 'POST',
            dataType: 'html',
            data: { orderid: orderid, status: status },
            success: function (data) {
                var response = JSON.parse(data);
                if (response.Status) {
                    swal('Good Job!', response.Message, 'success');
                    window.location.reload();
                } else {
                    swal('Oops...', response.Message, 'error');
                }
            }
        });
        return true;
    }

    function hideSecurityReportTotals() {
        var $panel = $('#securityReportTotalsPanel');
        var $btn = $('.vm-security-totals-btn');
        $panel.hide().attr('aria-hidden', 'true');
        $btn.attr('aria-expanded', 'false');
    }

    function findtotal() {
        var $panel = $('#securityReportTotalsPanel');
        var $btn = $('.vm-security-totals-btn');
        if ($panel.is(':visible')) {
            hideSecurityReportTotals();
            return;
        }
        $panel.show().attr('aria-hidden', 'false');
        $btn.attr('aria-expanded', 'true');
    }

    function destroySecuritySelect2($el) {
        if ($el && $el.length && $el.data('select2')) {
            $el.select2('destroy');
        }
    }

    function applySecuritySelect2($el) {
        if (!$el || !$el.length || !$.fn.select2) {
            return;
        }
        destroySecuritySelect2($el);
        $el.select2({
            width: '100%',
            minimumResultsForSearch: 6
        });
    }

    function hideSecurityRetailerFilter() {
        $('#rem').removeClass('is-visible').attr('hidden', 'hidden');
        destroySecuritySelect2($('#allretailer'));
        var retailerEl = document.getElementById('allretailer');
        if (retailerEl) {
            retailerEl.selectedIndex = 0;
        }
    }

    function showSecurityRetailerFilter() {
        $('#rem').addClass('is-visible').removeAttr('hidden');
        applySecuritySelect2($('#allretailer'));
    }

    function answers() {
        var answer = $('#ddlusers').val();
        hideSecurityRetailerFilter();
        if (answer === 'Retailer') {
            showSecurityRetailerFilter();
        }
    }

    function initSecurityReportSelect2() {
        applySecuritySelect2($('#ddlusers'));
        applySecuritySelect2($('#ddl_status'));
        $('#ddlusers').off('change.securityReport').on('change.securityReport', answers);
    }

    function initSecurityReportDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initSecurityReportDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm('#securityReportForm');
        }
    }

    $(document).ready(function () {
        initSecurityReportSelect2();
        answers();
        initSecurityReportDatepickers();
        $('#securityReportForm .select2-container').css('width', '100%');

        $('#btnExport').on('click', function () {
            var url = '@Url.Action("ExcelSecurityReport", "Home")'
                + '?txt_frm_date=' + encodeURIComponent($('#txt_frm_date').val())
                + '&txt_to_date=' + encodeURIComponent($('#txt_to_date').val())
                + '&ddlusers=' + encodeURIComponent($('#ddlusers').val())
                + '&allretailer=' + encodeURIComponent($('#allretailer').val() || '')
                + '&ddl_status=' + encodeURIComponent($('#ddl_status').val() || '');
            location.href = url;
        });

        $('#btnPDF').on('click', function () {
            var url = '@Url.Action("PDFSecurityReport", "Home")'
                + '?txt_frm_date=' + encodeURIComponent($('#txt_frm_date').val())
                + '&txt_to_date=' + encodeURIComponent($('#txt_to_date').val())
                + '&ddlusers=' + encodeURIComponent($('#ddlusers').val())
                + '&ddl_status=' + encodeURIComponent($('#ddl_status').val() || '')
                + '&alldealer=' + encodeURIComponent($('#alldealer').val() || '')
                + '&allretailer=' + encodeURIComponent($('#allretailer').val() || '')
                + '&allmaster=' + encodeURIComponent($('#allmaster').val() || '')
                + '&ddl_status_ticket=' + encodeURIComponent($('#ddl_status_ticket').val() || '');
            window.open(url, '_blank');
        });
    });
</script>
