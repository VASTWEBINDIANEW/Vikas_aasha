@model IEnumerable<Vastwebmulti.Models.history_norton_Result>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Security Report";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
    var reports = Model ?? Enumerable.Empty<Vastwebmulti.Models.history_norton_Result>();
    var rowCount = reports.Count();

    decimal totalAmount = reports.Sum(i => i.amount ?? 0m);
    decimal totalSuccess = reports.Where(i => string.Equals(i.Status, "SUCCESS", StringComparison.OrdinalIgnoreCase)).Sum(i => i.amount ?? 0m);
    decimal totalPending = reports.Where(i => string.Equals(i.Status, "PENDING", StringComparison.OrdinalIgnoreCase)).Sum(i => i.amount ?? 0m);
    decimal totalFailed = reports.Where(i => string.Equals(i.Status, "FAILED", StringComparison.OrdinalIgnoreCase)).Sum(i => i.amount ?? 0m);
}

