<div class="modal fade mastetr222Modal saas-admin-modal vm-dmt-modal vm-dmt-detail-modal vm-pancard-detail-modal" id="defaultModal222" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div id="loadredmodel" class="vm-dmt-modal-loader loadingio-spinner-ripple-92ar2pfqk5j" style="display:none;">
            <div class="ldio-zdyd6mf6t5"><div></div><div></div></div>
        </div>
        <div id="userinfodiv" class="modal-content">
            <div class="modal-header saas-admin-modal-header accent-sky">
                <div class="saas-admin-modal-head-main">
                    <div class="saas-admin-modal-icon"><i class="fas fa-id-card" aria-hidden="true"></i></div>
                    <div>
                        <h4 class="modal-title saas-admin-modal-title">Pan card token details</h4>
                        <p class="saas-admin-modal-sub">Commission and hierarchy breakdown</p>
                    </div>
                </div>
                @Html.Hidden("Idno")
                <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
            </div>
            <div class="modal-body vm-dmt-modal-body vm-dmt-detail-body">
                <form class="first-form vm-dmt-detail-form">
                    <div class="vm-dmt-detail-grid vm-dmt-detail-grid--2">
                        <div class="vm-dmt-modal-field">
                            <label for="DealerIncome">Distributor income</label>
                            @Html.TextBox("DealerIncome", "", new { @class = "form-control vm-dmt-modal-input", maxlength = 10, @readonly = "readonly" })
                        </div>
                        <div class="vm-dmt-modal-field">
                            <label for="retailer_dealer_pre">Distributor remain pre</label>
                            @Html.TextBox("retailer_dealer_pre", "", new { @class = "form-control vm-dmt-modal-input", maxlength = 10, @readonly = "readonly" })
                        </div>
                        <div class="vm-dmt-modal-field">
                            <label for="retailer_dealer_post">Distributor remain post</label>
                            @Html.TextBox("retailer_dealer_post", "", new { @class = "form-control vm-dmt-modal-input", maxlength = 10, @readonly = "readonly" })
                        </div>
                        <div class="vm-dmt-modal-field">
                            <label for="MDIncome">MD income</label>
                            @Html.TextBox("MDIncome", "", new { @class = "form-control vm-dmt-modal-input", @readonly = "readonly" })
                        </div>
                        <div class="vm-dmt-modal-field">
                            <label for="retailer_master_pre">MD remain pre</label>
                            @Html.TextBox("retailer_master_pre", "", new { @class = "form-control vm-dmt-modal-input", maxlength = 10, @readonly = "readonly" })
                        </div>
                        <div class="vm-dmt-modal-field">
                            <label for="retailer_master_post">MD remain post</label>
                            @Html.TextBox("retailer_master_post", "", new { @class = "form-control vm-dmt-modal-input", @readonly = "readonly" })
                        </div>
                        <div class="vm-dmt-modal-field">
                            <label for="whitelabelincome">Whitelabel income</label>
                            @Html.TextBox("whitelabelincome", "", new { @class = "form-control vm-dmt-modal-input", maxlength = 10, @readonly = "readonly" })
                        </div>
                        <div class="vm-dmt-modal-field">
                            <label for="whitelabel_remain_pre">Whitelabel remain pre</label>
                            @Html.TextBox("whitelabel_remain_pre", "", new { @class = "form-control vm-dmt-modal-input", maxlength = 10, @readonly = "readonly" })
                        </div>
                        <div class="vm-dmt-modal-field">
                            <label for="whitelabel_remain_post">Whitelabel remain post</label>
                            @Html.TextBox("whitelabel_remain_post", "", new { @class = "form-control vm-dmt-modal-input", maxlength = 10, @readonly = "readonly" })
                        </div>
                        <div class="vm-dmt-modal-field">
                            <label for="CouponStatus">UTI status</label>
                            @Html.TextBox("CouponStatus", "", new { @class = "form-control vm-dmt-modal-input", maxlength = 10, @readonly = "readonly" })
                        </div>
                        <div class="vm-dmt-modal-field vm-dmt-modal-field--full">
                            <label for="Request">Request</label>
                            @Html.TextBox("Request", "", new { @class = "form-control vm-dmt-modal-input", @readonly = "readonly" })
                        </div>
                        <div class="vm-dmt-modal-field vm-dmt-modal-field--full">
                            <label for="Response">Response</label>
                            @Html.TextBox("Response", "", new { @class = "form-control vm-dmt-modal-input", @readonly = "readonly" })
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer saas-admin-modal-footer">
                <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal"><i class="fas fa-times" aria-hidden="true"></i> Close</button>
            </div>
        </div>
    </div>
</div>
