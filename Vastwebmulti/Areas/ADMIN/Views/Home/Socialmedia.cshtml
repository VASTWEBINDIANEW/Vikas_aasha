@{
    ViewBag.Title = "Socialmedia";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css?v=15" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-fund-transfer-modern.css?v=25" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-fund-transfer-mobile.css?v=29" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-fund-transfer-page saas-fund-transfer-premium saas-upload-apk-page saas-social-media-page">

    <div class="container-fluid vm-ft-page-shell">

        <div class="vm-ft-page-toolbar vm-ft-page-toolbar--premium vm-ft-apk-toolbar">
            <div class="vm-ft-page-hero">
                <div>
                    <ol class="vm-ft-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li><a href="@Url.Action("Dashboard", "Home")#setting">Basic Setting</a></li>
                        <li>Social Media</li>
                    </ol>
                </div>
            </div>
            <div class="vm-ft-apk-toolbar-actions">
                <button type="button" class="vm-ft-apk-toolbar-btn" data-toggle="modal" data-target="#defaultModal"><i class="fas fa-sitemap" aria-hidden="true"></i> Sitemap</button>
                <button type="button" class="vm-ft-apk-toolbar-btn" data-toggle="modal" data-target="#defaultModal1"><i class="fas fa-circle-question" aria-hidden="true"></i> Help</button>
                <button type="button" class="vm-ft-apk-toolbar-btn" data-toggle="modal" data-target="#defaultModal2"><i class="fas fa-file-contract" aria-hidden="true"></i> T&amp;C</button>
                <button type="button" class="vm-ft-apk-toolbar-btn" data-toggle="modal" data-target="#defaultModal3"><i class="fas fa-shield-halved" aria-hidden="true"></i> Privacy</button>
            </div>
            <div class="vm-ft-search-wrap vm-ft-apk-page-search">
                <input class="form-control" type="text" value="" id="txtSocialSearch" placeholder="Search..." autocomplete="off" />
            </div>
        </div>

        <div class="col-md-12 vm-ft-layout-wrap">
            <div class="row clearfix vm-ft-layout vm-ft-layout--full vm-ft-layout--split-equal">

                <div class="col-md-6 col-sm-12 vm-ft-apk-col">
                    <div class="fund-trasfer-left vm-ft-form-card">
                        <div class="vm-ft-form-card-header">
                            <div class="vm-ft-form-card-header__icon" aria-hidden="true">
                                <i class="fas fa-share-nodes"></i>
                            </div>
                            <div>
                                <span class="vm-ft-form-card-header__title">Followers Setting</span>
                                <span class="vm-ft-form-card-header__sub">Add and manage social media profile links</span>
                            </div>
                        </div>

                        <div class="width100 float-left tabcurrent-seconddesign input-border-third">
                            <div class="fund-transfer-form vm-ft-apk-form">
                                <div class="col-md-12 col-sm-12 col-xs-12 vm-ft-apk-section" data-apk-search="followers social media facebook instagram twitter">
                                    <span class="vm-ft-apk-section__title">Add Social Link</span>
                                    <label for="ddlSocial">Select Social Media</label>
                                    <div>
                                        @Html.DropDownList("ddlSocial", new List<SelectListItem>
                                        {
                                           new SelectListItem{ Text="Select Media", Value="" },
                                           new SelectListItem{ Text="Facebook", Value="Facebook" },
                                           new SelectListItem{ Text="Instagram", Value="Instagram" },
                                           new SelectListItem{ Text="Youtube", Value="Youtube" },
                                           new SelectListItem{ Text="Twitter", Value="Twitter" },
                                           new SelectListItem{ Text="Pinterest", Value="Pinterest" },
                                           new SelectListItem{ Text="LinkedIn", Value="LinkedIn" },
                                           new SelectListItem{ Text="Blogger", Value="Blogger" },
                                           new SelectListItem{ Text="Tumblr", Value="Tumblr" }
                                         }, new { @class = "form-control", required = "required" })
                                    </div>
                                    <label for="urlLink">Social Media Link</label>
                                    <div>
                                        <input type="url" id="urlLink" class="form-control" placeholder="Enter Social Media Link" autocomplete="off" />
                                    </div>
                                    <div class="col-md-12 col-sm-12 col-xs-12 button-seconddesign vm-ft-apk-actions">
                                        <div>
                                            <button type="button" class="fullbodydycolorbg btn-first" onclick="SaveSocialAc()">
                                                <span style="color:#fff;position:relative;"><i class="fas fa-save" aria-hidden="true"></i> Save Link</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="vm-ft-apk-status-panel" data-apk-search="social media list history">
                                <div class="vm-ft-apk-status-panel__head">
                                    <span class="vm-ft-apk-status-panel__title">Social Media Links</span>
                                </div>
                                <div class="vm-ft-table-wrap vm-ft-apk-table-wrap">
                                    <table id="social-list" class="table third-design-table vm-ft-apk-status-table">
                                        <thead>
                                            <tr>
                                                <th>Media Type</th>
                                                <th>Social Media Link</th>
                                                <th>Delete</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (ViewBag.linkcontact != null && ViewBag.linkcontact.Count > 0)
                                            {
                                                foreach (var item in ViewBag.linkcontact)
                                                {
                                                    <tr class="tr">
                                                        <td>@item.FooterType</td>
                                                        <td><span class="vm-ft-apk-value">@item.FooterLink</span></td>
                                                        <td>
                                                            <button type="button" class="button-third-design vm-ft-apk-action-btn vm-ft-apk-del-btn" onclick="delSocialAc('@item.Id')" title="Delete">
                                                                <i class="fas fa-trash-alt" aria-hidden="true"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-6 col-sm-12 vm-ft-apk-col">
                    <div class="fund-trasfer-left vm-ft-form-card">
                        <div class="vm-ft-form-card-header">
                            <div class="vm-ft-form-card-header__icon vm-ft-form-card-header__icon--wl" aria-hidden="true">
                                <i class="fas fa-award"></i>
                            </div>
                            <div>
                                <span class="vm-ft-form-card-header__title">Badges Setting</span>
                                <span class="vm-ft-form-card-header__sub">Add and manage review platform badge links</span>
                            </div>
                        </div>

                        <div class="width100 float-left tabcurrent-seconddesign input-border-third">
                            <div class="fund-transfer-form vm-ft-apk-form">
                                <div class="col-md-12 col-sm-12 col-xs-12 vm-ft-apk-section" data-apk-search="badges appfutura trustpilot freelancer">
                                    <span class="vm-ft-apk-section__title">Add Badge Link</span>
                                    <label for="ddlBadges">Select Badges</label>
                                    <div>
                                        @Html.DropDownList("ddlBadges", new List<SelectListItem>
                                        {
                                           new SelectListItem{ Text="Select Media", Value="" },
                                           new SelectListItem{ Text="Appfutura", Value="Appfutura" },
                                           new SelectListItem{ Text="Applancher", Value="Applancher" },
                                           new SelectListItem{ Text="Badush", Value="Badush" },
                                           new SelectListItem{ Text="Extract", Value="Extract" },
                                           new SelectListItem{ Text="Freelancer", Value="Freelancer" },
                                           new SelectListItem{ Text="Good-firms", Value="Good-firms" },
                                           new SelectListItem{ Text="Mobile-app", Value="Mobile-app" },
                                           new SelectListItem{ Text="Trustpilot", Value="Trustpilot" }
                                         }, new { @class = "form-control", required = "required" })
                                    </div>
                                    <label for="BadgeLink">Badges Link</label>
                                    <div>
                                        <input type="url" id="BadgeLink" class="form-control" placeholder="Enter Badges Link" autocomplete="off" />
                                    </div>
                                    <div class="col-md-12 col-sm-12 col-xs-12 button-seconddesign vm-ft-apk-actions">
                                        <div>
                                            <button type="button" class="fullbodydycolorbg btn-first" onclick="SaveBadge()">
                                                <span style="color:#fff;position:relative;"><i class="fas fa-save" aria-hidden="true"></i> Save Link</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="vm-ft-apk-status-panel" data-apk-search="badges list history">
                                <div class="vm-ft-apk-status-panel__head">
                                    <span class="vm-ft-apk-status-panel__title">Badge Links</span>
                                </div>
                                <div class="vm-ft-table-wrap vm-ft-apk-table-wrap">
                                    <table id="Badge-list" class="table third-design-table vm-ft-apk-status-table">
                                        <thead>
                                            <tr>
                                                <th>Badges Type</th>
                                                <th>Badges Link</th>
                                                <th>Delete</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (ViewBag.Badges != null && ViewBag.Badges.Count > 0)
                                            {
                                                foreach (var item in ViewBag.Badges)
                                                {
                                                    <tr class="tr">
                                                        <td>@item.BadgeType</td>
                                                        <td><span class="vm-ft-apk-value">@item.Url_Link</span></td>
                                                        <td>
                                                            <button type="button" class="button-third-design vm-ft-apk-action-btn vm-ft-apk-del-btn" onclick="delBadge('@item.Id')" title="Delete">
                                                                <i class="fas fa-trash-alt" aria-hidden="true"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

