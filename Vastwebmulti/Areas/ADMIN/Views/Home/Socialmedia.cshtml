<script src="~/AdminDesign/plugins/jquery/jquery.min.js"></script>
<script src="~/Ckeditor/ckeditor.js"></script>
<script src="~/Ckeditor/adapters/jquery.js"></script>

<script>
    function buildSocialRow(b) {
        return '<tr class="tr">' +
            '<td>' + b.FooterType + '</td>' +
            '<td><span class="vm-ft-apk-value">' + b.FooterLink + '</span></td>' +
            '<td><button type="button" class="button-third-design vm-ft-apk-action-btn vm-ft-apk-del-btn" onclick="delSocialAc(' + b.Id + ')" title="Delete"><i class="fas fa-trash-alt"></i></button></td>' +
            '</tr>';
    }

    function buildBadgeRow(b) {
        return '<tr class="tr">' +
            '<td>' + b.BadgeType + '</td>' +
            '<td><span class="vm-ft-apk-value">' + b.Url_Link + '</span></td>' +
            '<td><button type="button" class="button-third-design vm-ft-apk-action-btn vm-ft-apk-del-btn" onclick="delBadge(' + b.Id + ')" title="Delete"><i class="fas fa-trash-alt"></i></button></td>' +
            '</tr>';
    }

    function isValidUrl(txt) {
        var re = /(http(s)?:\\)?([\w-]+\.)+[\w-]+[.com|.in|.org]+(\[\?%&=]*)?/;
        return re.test(txt);
    }

    function SaveSocialAc() {
        var social = $('#ddlSocial').val();
        if (social === "") {
            alert('Select Social Account Type');
            return;
        }

        var txt = $('#urlLink').val();
        if (!isValidUrl(txt)) {
            alert('Not a Valid Url !');
            return;
        }

        $.ajax({
            type: "GET",
            url: '@Url.Action("Social_Media", "Home")',
            data: { socialType: social, link: txt },
            success: function (response) {
                var mdtblHtml = "";
                $.each(response, function (a, b) {
                    mdtblHtml += buildSocialRow(b);
                });
                $('#social-list > tbody').html(mdtblHtml);
                $('#urlLink').val('');
            }
        });
    }

    function delSocialAc(e) {
        if (e === "") {
            return;
        }

        $.ajax({
            type: "POST",
            url: '@Url.Action("delfooterlink", "Home")',
            data: { Id: e },
            dataType: 'json',
            cache: false,
            success: function (response) {
                var mdtblHtml = "";
                $.each(response, function (a, b) {
                    mdtblHtml += buildSocialRow(b);
                });
                $('#social-list > tbody').html(mdtblHtml);
            }
        });
    }

    function SaveBadge() {
        var badge = $('#ddlBadges').val();
        if (badge === "") {
            alert('Select Badge Type');
            return;
        }

        var txt = $('#BadgeLink').val();
        if (!isValidUrl(txt)) {
            alert('Not a Valid Url !');
            return;
        }

        $.ajax({
            type: "GET",
            url: '@Url.Action("BadgeMedia", "Home")',
            data: { BadgeType: badge, Badgelink: txt },
            success: function (response) {
                var badgeHtml = "";
                $.each(response, function (a, b) {
                    badgeHtml += buildBadgeRow(b);
                });
                $('#Badge-list > tbody').html(badgeHtml);
                $('#BadgeLink').val('');
            }
        });
    }

    function delBadge(e) {
        if (e === "") {
            return;
        }

        $.ajax({
            type: "POST",
            url: '@Url.Action("delBadgesMedia", "Home")',
            data: { Id: e },
            dataType: 'json',
            cache: false,
            success: function (response) {
                var badgeHtml = "";
                $.each(response, function (a, b) {
                    badgeHtml += buildBadgeRow(b);
                });
                $('#Badge-list > tbody').html(badgeHtml);
            }
        });
    }

    function getCkEditorHeight() {
        if (window.innerWidth <= 767) {
            return 160;
        }
        if (window.innerWidth <= 1199) {
            return 200;
        }
        return 320;
    }

    function initCkEditor(id) {
        if (typeof CKEDITOR === 'undefined' || CKEDITOR.instances[id]) {
            return;
        }
        CKEDITOR.replace(id, {
            height: getCkEditorHeight(),
            removePlugins: 'elementspath',
            resize_enabled: false
        });
    }

    function OnSuccess() {
        $('.vm-sm-modal--editor').modal('hide');
    }

    function OnFailure() {
        alert('Failed to save content. Please try again.');
    }

    $(document).ready(function () {
        $('#defaultModal1').on('shown.bs.modal', function () {
            initCkEditor('txteditHelp');
        });
        $('#defaultModal2').on('shown.bs.modal', function () {
            initCkEditor('txteditTC');
        });
        $('#defaultModal3').on('shown.bs.modal', function () {
            initCkEditor('txteditPrivacy');
        });

        $('#savePrivacy, #Help, #TC').on('click', function () {
            var editorId = this.id === 'Help' ? 'txteditHelp' : (this.id === 'TC' ? 'txteditTC' : 'txteditPrivacy');
            if (CKEDITOR.instances[editorId]) {
                CKEDITOR.instances[editorId].updateElement();
            }
        });

        $('#txtSocialSearch').on('input', function () {
            var q = $.trim($(this).val()).toLowerCase();
            var $blocks = $('.saas-upload-apk-page [data-apk-search]');

            if (!q) {
                $blocks.removeClass('vm-ft-apk-search-hidden');
                $('.vm-ft-apk-col').removeClass('vm-ft-apk-col--empty');
                $('#social-list tbody tr, #Badge-list tbody tr').show();
                return;
            }

            $blocks.each(function () {
                var text = (($(this).attr('data-apk-search') || '') + ' ' + $(this).text()).toLowerCase();
                $(this).toggleClass('vm-ft-apk-search-hidden', text.indexOf(q) === -1);
            });

            $('.vm-ft-apk-col').each(function () {
                var visible = $(this).find('[data-apk-search]').not('.vm-ft-apk-search-hidden').length > 0;
                $(this).toggleClass('vm-ft-apk-col--empty', !visible);
            });

            $('#social-list tbody tr, #Badge-list tbody tr').each(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(q) > -1);
            });
        });
    });
</script>
