<link href="~/MainFrontDesign/css/admin-fin-slab-nav-modern.css?v=2" rel="stylesheet" />
<nav class="vm-dmt2-fin-nav" id="vmTravelSlabNav" aria-label="Travel slab navigation">
    <div class="vm-dmt2-fin-nav__head">
        <span class="vm-dmt2-fin-nav__head-icon" aria-hidden="true"><i class="fas fa-plane"></i></span>
        <div class="vm-dmt2-fin-nav__head-copy">
            <strong>Travel Slab Menu</strong>
            <span>Flight, bus, hotel &amp; IRCTC commission settings</span>
        </div>
    </div>
    <ul class="vm-dmt2-fin-nav__list">
        <li>
            <a class="vm-dmt2-fin-nav__link" href="@Url.Action("Flight_Slab", "Home")">
                <i class="fas fa-plane" aria-hidden="true"></i>
                <span>Flight Slab</span>
            </a>
        </li>
        <li>
            <a class="vm-dmt2-fin-nav__link" href="@Url.Action("BUS_Slab", "Home")">
                <i class="fas fa-bus" aria-hidden="true"></i>
                <span>Bus Slab</span>
            </a>
        </li>
        <li>
            <a class="vm-dmt2-fin-nav__link" href="@Url.Action("Hotel_Slab", "Home")">
                <i class="fas fa-hotel" aria-hidden="true"></i>
                <span>Hotel Slab</span>
            </a>
        </li>
        <li>
            <a class="vm-dmt2-fin-nav__link" href="@Url.Action("IRCTC_Slab_setting", "Home")">
                <i class="fas fa-train" aria-hidden="true"></i>
                <span>IRCTC Slab</span>
            </a>
        </li>
    </ul>
</nav>
<script>
    $(document).ready(function () {
        var current = location.pathname.toLowerCase();
        $('#vmTravelSlabNav li a').each(function () {
            var $this = $(this);
            var href = ($this.attr('href') || '').toLowerCase();
            if (href && current.indexOf(href.split('?')[0]) !== -1) {
                $this.addClass('is-active activee');
            }
        });
    });
</script>
