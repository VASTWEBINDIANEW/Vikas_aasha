@using Microsoft.AspNet.Identity
@using Vastwebmulti.Models
@{
    VastwebmultiEntities DB1 = new VastwebmultiEntities();
    var userid = User.Identity.GetUserId();
    var masterpurchase = DB1.master_purchase.Count(x => x.frm == userid && x.sts == "Pending");
    var dealerpurchase = DB1.dlm_purchage.Count(x => x.frm == userid && x.sts == "Pending");
    var rempurchase = DB1.rem_purchage.Count(x => x.frm == userid && x.sts == "Pending");
    var apiuser = DB1.api_purchase.Count(m => m.frm == userid && m.sts == "Pending");
    var whitelabeluser = DB1.Whitelabel_master_purchase.Count(m => m.frm == userid && m.sts == "Pending");
}
<nav class="saas-pur-nav-card" aria-label="Purchase report type">
    <ul class="saas-pur-nav" id="saasPurNav">
        <li><a href="~/ADMIN/Home/ShowPurchase_master"><span class="saas-pur-nav-count">@masterpurchase</span> Master</a></li>
        <li><a href="~/ADMIN/Home/Dealer_showpurchase"><span class="saas-pur-nav-count">@dealerpurchase</span> Distributor</a></li>
        <li><a href="~/ADMIN/Home/Retailer_showpurchase"><span class="saas-pur-nav-count">@rempurchase</span> Retailer</a></li>
        <li><a href="~/ADMIN/Home/Api_showpurchase"><span class="saas-pur-nav-count">@apiuser</span> API User</a></li>
        <li><a href="~/ADMIN/Home/Show_Whitelabelpurchase"><span class="saas-pur-nav-count">@whitelabeluser</span> Whitelabel</a></li>
    </ul>
</nav>
<script>
    (function () {
        var path = (location.pathname || "").toLowerCase();
        document.querySelectorAll("#saasPurNav a").forEach(function (a) {
            var href = (a.getAttribute("href") || "").toLowerCase().replace(/^~\//, "/");
            if (href && (path.indexOf(href) !== -1 || path.endsWith(href.split("/").pop()))) {
                a.classList.add("is-active");
            }
        });
    })();
</script>
