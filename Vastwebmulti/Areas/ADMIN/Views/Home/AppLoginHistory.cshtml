@using System.Linq
@model IEnumerable<Vastwebmulti.Models.App_login_history_Result>
@{
    ViewBag.Title = "AppLoginHistory";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    var dateMode = (ViewBag.chk as string) == "post" ? "post" : "get";
    var rows = Model ?? Enumerable.Empty<Vastwebmulti.Models.App_login_history_Result>();
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-app-login-history-modern.css?v=4" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-app-login-history-mobile.css?v=4" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-app-login-report-page">
    <div class="container-fluid vm-opr-page-shell">

        @using (Html.BeginForm("AppLoginHistory", "Home", FormMethod.Post, new { id = "appLoginHistoryForm", data_date_mode = dateMode, data_frm_date = frmDate, data_to_date = toDate }))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Login Reports</li>
                        <li>Apps Success Login</li>
                    </ol>
                    <div class="vm-dmt-fin-nav-row vm-login-report-nav-row">
                        @Html.Partial("_loginReportNav")
                    </div>
                </div>

                <div class="vm-rpt-filters-panel">
                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-app-login-filter-row vm-rpt-filters-panel__bar">
                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-mobile-alt" aria-hidden="true"></i>
                        <span>All apps success login history</span>
                    </div>
                    <span class="vm-opr-table-panel__hint">Export via table toolbar · scroll on mobile</span>
                </div>
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="example" class="table table-bordered table-striped table-hover vm-opr-data-table vm-app-login-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Sr&nbsp;No.</th>
                                    <th>Registered&nbsp;User&nbsp;ID</th>
                                    <th>Imei&nbsp;No</th>
                                    <th>Lattitude</th>
                                    <th>Longitude</th>
                                    <th>Model&nbsp;No</th>
                                    <th>Last&nbsp;Login&nbsp;Details</th>
                                    <th>Current&nbsp;Login&nbsp;Details</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (rows.Any())
                                {
                                    var i = 1;
                                    foreach (var item in rows)
                                    {
                                        <tr>
                                            <td>@i</td>
                                            <td>@item.Userid</td>
                                            <td>@item.ImeiNo</td>
                                            <td>@item.Latitude</td>
                                            <td>@item.Logitude</td>
                                            <td>@item.ModelNo</td>
                                            <td>@item.LastLoginTime</td>
                                            <td>
                                                <button type="button" class="vm-app-login-loc-btn" data-lat="@item.Latitude" data-lng="@item.Logitude" title="View location">
                                                    <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                                                    <span>@item.CurrentLoginTime</span>
                                                </button>
                                            </td>
                                        </tr>
                                        i++;
                                    }
                                }
                                else
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="8" class="vm-opr-table-empty">
                                            <i class="fas fa-inbox" aria-hidden="true"></i>
                                            <span>No app login records for selected date range.</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade saas-admin-modal" id="appLoginLocationModal" tabindex="-1" role="dialog" aria-labelledby="appLoginLocationModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header saas-admin-modal-header accent-sky">
                <div class="saas-admin-modal-head-main">
                    <span class="saas-admin-modal-icon"><i class="fas fa-map-marker-alt" aria-hidden="true"></i></span>
                    <div class="saas-admin-modal-title-wrap">
                        <h4 class="modal-title saas-admin-modal-title" id="appLoginLocationModalTitle">Login Location</h4>
                        <span class="saas-admin-modal-subtitle">Resolved address from coordinates</span>
                    </div>
                </div>
                <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
            </div>
            <div class="modal-body saas-admin-modal-body">
                <div id="location" class="vm-app-login-location-body"></div>
            </div>
            <div class="modal-footer saas-admin-modal-footer">
                <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal"><i class="fas fa-times" aria-hidden="true"></i> Close</button>
            </div>
        </div>
    </div>
</div>

<script src="~/MainFrontDesign/js/admin-app-login-history.js?v=2"></script>
<script>
    function viewlocation(Latitude, Logitude) {
        $.ajax({
            url: '@Url.Action("GetLoctaion", "Home")',
            type: 'GET',
            dataType: 'html',
            data: { Latitude: Latitude, Logitude: Logitude },
            success: function (data) {
                $('#location').html(data);
                $('#appLoginLocationModal').modal('show');
            }
        });
        return false;
    }
</script>
