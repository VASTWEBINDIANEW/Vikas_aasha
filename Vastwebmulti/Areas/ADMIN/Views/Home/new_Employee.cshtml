@model Vastwebmulti.Areas.ADMIN.ViewModel.RegisternewEmployeeViewModel
@{
    ViewBag.Title = "new_Employee";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
}
<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.0.1/css/toastr.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.0.1/js/toastr.js"></script>

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-fund-transfer-modern.css?v=27" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-fund-transfer-mobile.css?v=23" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-master-list-modern.css?v=19" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-api-user-page.css?v=7" rel="stylesheet" />

<section class="content New_Employee_Page Masterlist-page saas-admin-account-page saas-admin-report-page saas-fund-transfer-page saas-fund-user-page saas-master-list-page saas-fund-transfer-premium">

    <div class="container-fluid vm-ft-page-shell">

        <!-- -- Toolbar: Breadcrumb + Actions -- -->
        <div class="vm-ft-page-toolbar vm-ft-page-toolbar--premium">
            <div class="vm-ft-page-hero">
                <ol class="vm-ft-breadcrumb">
                    <li><a href="@Url.Action("Dashboard","Home")"><i class="fas fa-home"></i> Dashboard</a></li>
                    <li>User's &amp; Account</li>
                    <li>Employee User</li>
                </ol>
            </div>
            <div class="vm-ft-search-wrap">
                <a href="@Url.Action("ShowEmployeeWithPermission","Home")" class="ne-emp-permission-btn">
                    <i class="fas fa-user-shield"></i> Employee Permission
                </a>
                <input class="form-control vm-ne-search" type="text" id="myInput"
                       placeholder="Search employee..." onkeyup="neSearchTable()" autocomplete="off" />
            </div>
        </div>

        <!-- -- Two-column layout -- -->
        <div class="col-md-12 vm-ft-layout-wrap">
            <div class="row clearfix vm-ft-layout vm-ft-layout--full">

                <!-- ====== LEFT: Create Employee Form ====== -->
                <div class="col-md-4 col-sm-12 vm-ft-form-col">
                    <div class="fund-trasfer-left fund-user-left vm-ft-form-card">

                        <!-- Card header -->
                        <div class="vm-ft-form-card-header">
                            <div class="vm-ft-form-card-header__icon"><i class="fas fa-user-tie"></i></div>
                            <div>
                                <span class="vm-ft-form-card-header__title">Employee</span>
                                <span class="vm-ft-form-card-header__sub">Create new employee login</span>
                            </div>
                        </div>

                        <!-- Tabs -->
                        <div class="au-tabs">
                            <button type="button" class="au-tab-btn active">
                                <i class="fas fa-user-plus"></i> Create Employee
                            </button>
                            <a href="@Url.Action("Rch_details","Home")" class="au-tab-btn" style="text-decoration:none;">
                                <i class="fas fa-retweet"></i> Create RCH User
                            </a>
                        </div>

                        <!-- Form -->
                        @using (Html.BeginForm("Register_new_Employee", "Home", FormMethod.Post))
                        {
                            <div class="au-tab-content active" style="padding:14px 16px;">

                                <div class="form-group">
                                    <label><i class="fas fa-id-card" style="color:#3b82f6;margin-right:4px;font-size:.68rem;"></i> Employee Name</label>
                                    @Html.EditorFor(model => model.Employee_name, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter employee name", required = "required" } })
                                </div>

                                <div class="form-group">
                                    <label><i class="fas fa-envelope" style="color:#3b82f6;margin-right:4px;font-size:.68rem;"></i> Email-ID</label>
                                    @Html.EditorFor(model => model.E_mail, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter email ID", required = "required" } })
                                </div>

                                <div class="row" style="margin:0 -5px;">
                                    <div class="col-md-6 col-xs-6" style="padding:0 5px;">
                                        <div class="form-group">
                                            <label><i class="fas fa-mobile-alt" style="color:#3b82f6;margin-right:4px;font-size:.68rem;"></i> (+91) Mobile</label>
                                            @Html.EditorFor(model => model.Mobile, new { htmlAttributes = new { @class = "form-control", placeholder = "Mobile number", required = "required", @onkeypress = "javascript:return isNumber(event)", minlength = 10, maxlength = 10 } })
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-xs-6" style="padding:0 5px;">
                                        <div class="form-group">
                                            <label><i class="fas fa-id-badge" style="color:#3b82f6;margin-right:4px;font-size:.68rem;"></i> PAN Card</label>
                                            @Html.EditorFor(model => model.PanCard, new { htmlAttributes = new { @class = "form-control upper-case", placeholder = "PAN no", maxlength = 10, minlength = 10 } })
                                        </div>
                                    </div>
                                </div>

                                <div class="row" style="margin:0 -5px;">
                                    <div class="col-md-6 col-xs-6" style="padding:0 5px;">
                                        <div class="form-group">
                                            <label><i class="fas fa-map" style="color:#3b82f6;margin-right:4px;font-size:.68rem;"></i> State</label>
                                            @Html.DropDownList("State1", (IEnumerable<SelectListItem>)ViewBag.state, "Select State", new { @class = "form-control", required = "required" })
                                        </div>
                                    </div>
                                    <div class="col-md-6 col-xs-6" style="padding:0 5px;">
                                        <div class="form-group">
                                            <label><i class="fas fa-map-marker-alt" style="color:#3b82f6;margin-right:4px;font-size:.68rem;"></i> District</label>
                                            <select id="District1" name="District1" class="form-control" required="required">
                                                <option>Select District</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label><i class="fas fa-home" style="color:#3b82f6;margin-right:4px;font-size:.68rem;"></i> Address</label>
                                    @Html.TextArea("Address", "", new { @class = "form-control", placeholder = "Enter full address", required = "required", minlength = "15", @onkeypress = "javascript:return AddValidation(event)" })
                                </div>

                                <div class="form-group">
                                    <label><i class="fas fa-map-pin" style="color:#3b82f6;margin-right:4px;font-size:.68rem;"></i> Area Pin Code</label>
                                    @Html.TextBox("Pincode", "", new { @class = "form-control", placeholder = "6-digit pin code", required = "required", onkeypress = "return isNumber(event)", maxlength = "6", minlength = "6" })
                                </div>

                                <div class="form-group">
                                    <label><i class="fas fa-fingerprint" style="color:#3b82f6;margin-right:4px;font-size:.68rem;"></i> Aadhaar Card</label>
                                    @Html.TextBox("AadharCard", "", new { @class = "form-control", placeholder = "12-digit Aadhaar no", onkeypress = "return isNumber(event)", maxlength = "12", minlength = 12 })
                                </div>

                                <!-- Messages -->
                                <div id="ne-msg-success" class="ne-msg-success"></div>
                                <div id="ne-msg-error"   class="ne-msg-error"></div>

                                <!-- Buttons -->
                                <div class="ne-form-footer">
                                    <button type="reset" class="ne-btn-reset">
                                        <i class="fas fa-undo"></i> Reset
                                    </button>
                                    <button type="submit" class="ne-btn-submit">
                                        <i class="fas fa-user-plus"></i> Create Employee
                                    </button>
                                </div>

                            </div>
                        }

                    </div>
                </div>
                <!-- ====== END LEFT ====== -->

                <!-- ====== RIGHT: Employee List ====== -->
                <div class="col-md-8 col-sm-12 fund-transfer-main-admin vm-ft-history-col" style="padding-left:0;">
                    <div class="fund-trasfer-right fund-user-right vm-ft-history-panel">
                        <div class="vm-ft-history-body">

                            <!-- Panel toolbar header -->
                            <div class="vm-ft-history-toolbar vm-ft-history-toolbar--premium vm-ml-list-toolbar">
                                <div class="vm-ml-list-toolbar__row">
                                    <div class="vm-ft-history-toolbar__head vm-ml-list-toolbar__head">
                                        <i class="fas fa-users" aria-hidden="true"></i>
                                        <div class="vm-ml-list-toolbar__text">
                                            <span class="vm-ft-history-toolbar__title">Employee List</span>
                                            <span class="vm-ft-history-toolbar__sub">View, search &amp; manage employee records</span>
                                        </div>
                                    </div>
                                    <div class="vm-ft-export-group vm-ml-list-toolbar__exports">
                                        <button type="button" id="btnExportA" class="vm-ft-export-btn vm-ft-export-btn--excel" title="Export Excel" onclick="neExcel()">
                                            <i class="fas fa-file-excel" aria-hidden="true"></i>
                                        </button>
                                        <button type="button" id="btnPDFA" class="vm-ft-export-btn vm-ft-export-btn--pdf" title="Export PDF" onclick="nePDF()">
                                            <i class="fas fa-file-pdf" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Employee table (AJAX target) -->
                            <div id="Employeelist_tbl" class="vm-ml-table-host" style="overflow-x:auto;overflow-y:auto;max-height:72vh;">
                                @Html.Action("Get_ALLEmployeelist")
                            </div>

                        </div>
                    </div>
                </div>
                <!-- ====== END RIGHT ====== -->

            </div>
        </div>

    </div>
</section>

<!-- Select2 -->
<link href="~/select2/dist/css/select2.css" rel="stylesheet" />
<script src="~/select2/dist/js/select2.min.js"></script>
<script src="~/AdminDesign/plugins/jquery-slimscroll/jquery.slimscroll.js"></script>

<script>
    /* -- Select2 -- */
    var ravi = $.noConflict();
    ravi(document).ready(function () { ravi("select").select2(); });
    $(document).ajaxComplete(function () { ravi("select").select2(); });

    /* -- Table search -- */
    function neSearchTable() {
        var value = $("#myInput").val().toLowerCase();
        $("#Employeelist_tbl tbody .tr").filter(function () {
            $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
        });
    }

    /* -- Exports -- */
    function neExcel() { location.href = '@Url.Action("Excel_new_Employee","Home")'; }
    function nePDF()   { window.open('@Url.Action("PDF_new_Employee","Home")', '_blank'); }

    /* -- PAN uppercase -- */
    $(document).on('keyup', '.upper-case', function () {
        $(this).val($(this).val().toUpperCase());
    });

    /* -- Number only -- */
    function isNumber(evt) {
        var k = (evt.which) ? evt.which : evt.keyCode;
        if (k != 46 && k > 31 && (k < 48 || k > 57)) return false;
        return true;
    }

    /* -- State ? District cascade -- */
    ravi(function () {
        ravi('#State1').change(function () {
            var stid = ravi('#State1').val();
            if (!stid) return;
            ravi("#District1").html("<option value='0'>Please wait…</option>").show();
            ravi.ajax({
                url: '@Url.Action("DistrictList","Home")',
                data: { Id: stid }, cache: false, type: "POST",
                success: function (data) {
                    var markup = "<option value='0'>Select District</option>";
                    for (var x = 0; x < data.length; x++) {
                        markup += "<option value='" + data[x].Value + "'>" + data[x].Text + "</option>";
                    }
                    ravi("#District1").html(markup).show();
                },
                error: function () { alert("Failed to load districts."); }
            });
        });
    });

    /* -- Status toggle (AJAX) -- */
    function statusIsActive(eid) {
        var btn = $('button.ne-sts-btn[onclick*="' + eid + '"]');
        btn.prop('disabled', true);
        $.ajax({
            url: '@Url.Action("ChangestatusforEmployee")',
            data: { Employeeid: eid }, type: "POST",
            success: function (data) { $('#Employeelist_tbl').html(data); },
            error:   function ()     { btn.prop('disabled', false); }
        });
    }

    /* -- Email verify (AJAX) -- */
    function clickVerifyEmail(eid) {
        $.ajax({
            url: '@Url.Action("emailverifyforEmployee")',
            data: { Employeeid: eid }, type: "POST",
            success: function (data) { $('#Employeelist_tbl').html(data); },
            error:   function (xhr)  { alert("Error: " + xhr.responseText); }
        });
    }

    /* -- TempData messages on load -- */
    $(document).ready(function () {
        @{
            var msgrem   = TempData["msgrem"]   as string ?? "";
            var mobileno = TempData["mobileno"] as string ?? "";
            var error1   = TempData["error"]    as string ?? "";
            var editdata = TempData["edit"]     as string ?? "";
            var wrong    = TempData["wrong"]    as string ?? "";
            var delmsg   = TempData["delete"]   as string ?? "";
        }
        @if (!string.IsNullOrEmpty(msgrem))   { <text>swal("Good job!", "@Html.Raw(msgrem)", "success");</text>   }
        @if (!string.IsNullOrEmpty(mobileno)) { <text>swal("Oops...", "@Html.Raw(mobileno)", "error");</text>     }
        @if (!string.IsNullOrEmpty(error1))   { <text>swal("Oops...", "@Html.Raw(error1)", "error");</text>       }
        @if (!string.IsNullOrEmpty(editdata)) { <text>swal("Good job!", "@Html.Raw(editdata)", "success");</text> }
        @if (!string.IsNullOrEmpty(wrong))    { <text>swal("Oops...", "@Html.Raw(wrong)", "error");</text>        }
        @if (!string.IsNullOrEmpty(delmsg))   { <text>swal("Good job!", "@Html.Raw(delmsg)", "success");</text>   }
    });
</script>
