@model IEnumerable<Vastwebmulti.Models.select_api_pur_order_Result>
@using System.Linq
@{
    ViewBag.Title = "Api Show Purchase";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var rows = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.select_api_pur_order_Result>();
    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    var dateMode = (ViewBag.chk as string) == "post" ? "set" : "get";
    ViewBag.PurchaseUpdateAction = "updatepurchage_Api";
    ViewBag.PurchaseModalAjax = false;
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-settings-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-purchase-report-modern.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-settings-page saas-admin-report-page saas-purchase-report-page">
    <div class="container-fluid">
        @Html.Partial("_menupurchase")

        @using (Html.BeginForm("Api_showpurchase", "Home", FormMethod.Post, new { id = "purchaseReportFormApi", data_date_mode = dateMode, data_frm_date = frmDate, data_to_date = toDate }))
        {
            <div class="saas-acc-toolbar saas-pan-toolbar-unified saas-purchase-toolbar-unified">
                <ol class="saas-acc-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li><a href="javascript:void(0);">Wallet-Q</a></li>
                    <li>API User Purchase</li>
                </ol>
                <div class="saas-acc-toolbar-right saas-pan-toolbar-dates">
                    <div class="saas-acc-report-date-controls saas-pan-date-controls">
                        <div class="saas-report-date-fields">
                            <div class="saas-acc-dp-field">
                                <label class="saas-acc-dp-label" for="txt_frm_date">From date</label>
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date" })
                            </div>
                            <div class="saas-acc-dp-field">
                                <label class="saas-acc-dp-label" for="txt_to_date">To date</label>
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date" })
                            </div>
                        </div>
                        <div class="saas-report-toolbar-actions">
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn"><i class="fas fa-search" aria-hidden="true"></i> Search</button>
                            <div class="saas-acc-export-group saas-pan-export-group">
                                <button type="button" class="saas-acc-btn saas-acc-btn--excel saas-pan-export-btn" id="btnExport"><i class="fas fa-file-excel" aria-hidden="true"></i> Excel</button>
                                <button type="button" class="saas-acc-btn saas-acc-btn--pdf saas-pan-export-btn" id="btnPDF"><i class="fas fa-file-pdf" aria-hidden="true"></i> PDF</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="saas-acc-table-card">
            <div class="saas-acc-table-card-head">
                <h3>API user purchase orders</h3>
                <span class="saas-acc-row-count"><i class="fas fa-list" aria-hidden="true"></i> @rows.Count entries · @frmDate to @toDate</span>
            </div>
            <div class="saas-acc-table-wrap table-responsive">
                <table class="table saas-acc-table saas-acc-table--purchase table-bordered">
                    <thead>
                        <tr>
                            <th>Status</th>
                            <th>Order No</th>
                            <th>API user</th>
                            <th>Request date</th>
                            <th>Payment mode</th>
                            <th class="text-right">Amount</th>
                            <th class="text-right">Charge</th>
                            <th>Action</th>
                            <th>From acc no</th>
                            <th>UTR / Slip</th>
                            <th>Comment</th>
                            <th>Resp. date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (rows.Count == 0)
                        {
                            <tr><td colspan="12" class="saas-pan-empty-cell">No purchase orders found.</td></tr>
                        }
                        else
                        {
                            foreach (var item in rows)
                            {
                                var sts = (item.sts ?? "").Trim();
                                var typeKey = (item.type_ ?? "").Trim().ToUpperInvariant();
                                var typeClass = typeKey == "CASH" ? "saas-pur-order-type--cash" : typeKey == "CREDIT" ? "saas-pur-order-type--credit" : "";
                                var badgeClass = sts.Equals("Pending", StringComparison.OrdinalIgnoreCase) ? "saas-pur-badge--pending" : sts.Equals("APPROVED", StringComparison.OrdinalIgnoreCase) ? "saas-pur-badge--approved" : sts.Equals("REJECTED", StringComparison.OrdinalIgnoreCase) ? "saas-pur-badge--rejected" : "saas-pur-badge--muted";
                                <tr>
                                    <td data-label="Status"><span class="saas-pur-badge @badgeClass">@sts.ToUpperInvariant()</span></td>
                                    <td data-label="Order No">@item.orderno @if (!string.IsNullOrEmpty(typeKey)) { <span class="saas-pur-order-type @typeClass">(@typeKey)</span> }</td>
                                    <td data-label="API user">@Html.DisplayFor(m => item.apiemail)</td>
                                    <td data-label="Request date">@string.Format("{0:dd-MM-yyyy} {0:t}", item.reqdate)</td>
                                    <td data-label="Payment mode">@Html.DisplayFor(m => item.paymode)</td>
                                    <td data-label="Amount" class="text-right">@Html.DisplayFor(m => item.amount)</td>
                                    <td data-label="Charge" class="text-right">@item.cashDepositCharge</td>
                                    <td data-label="Action">
                                        @if (sts.Equals("Pending", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <div class="saas-pur-actions">
                                                <button type="button" class="saas-pur-btn saas-pur-btn--approve" onclick="purchaseFunin('@item.idno','APP')"><i class="fa fa-check" aria-hidden="true"></i></button>
                                                <button type="button" class="saas-pur-btn saas-pur-btn--reject" onclick="purchaseFunin('@item.idno','REJ')"><i class="fa fa-times" aria-hidden="true"></i></button>
                                            </div>
                                        }
                                    </td>
                                    <td data-label="From acc">@Html.DisplayFor(m => item.Fromaccountno)</td>
                                    <td data-label="UTR">@Html.DisplayFor(m => item.utrno)</td>
                                    <td data-label="Comment" class="col-details">@item.details</td>
                                    <td data-label="Resp. date">@string.Format("{0:dd-MM-yyyy} {0:t}", item.responsedate)</td>
                                </tr>
                            }
                            <tr class="saas-pur-row-total">
                                <td><strong>Total</strong></td>
                                <td colspan="4"></td>
                                <td class="text-right"><strong>@rows.Sum(a => a.amount)</strong></td>
                                <td colspan="6"></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@Html.Partial("_PurchaseApproveModal")
<script src="~/MainFrontDesign/js/admin-report-datepicker.js"></script>
<script src="~/MainFrontDesign/js/admin-purchase-report.js"></script>
<script>
    $("#btnExport").on("click", function () {
        location.href = '@Url.Action("ExcelApiReport", "Home")?txt_frm_date=' + encodeURIComponent($("#txt_frm_date").val()) + '&txt_to_date=' + encodeURIComponent($("#txt_to_date").val());
    });
    $("#btnPDF").on("click", function () {
        window.open('@Url.Action("PDFApi_showpurchase", "Home")?txt_frm_date=' + encodeURIComponent($("#txt_frm_date").val()) + '&txt_to_date=' + encodeURIComponent($("#txt_to_date").val()), "_blank");
    });
    $(function () {
        if (window.initAdminReportDateForm) initAdminReportDateForm("#purchaseReportFormApi");
        var msg = '@ViewData["successorder"]'; if (msg) swal("Good job!", msg, "success");
        var err = '@ViewData["failedorder"]'; if (err) swal("Oops!", err, "error");
    });
</script>
