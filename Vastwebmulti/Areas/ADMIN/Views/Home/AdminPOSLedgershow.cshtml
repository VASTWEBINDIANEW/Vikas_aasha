@model IEnumerable<Vastwebmulti.Models.pos_ledger_report_Result>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "POS Ledger";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
    var selectedRetailer = Request["RetailerIdpos"] ?? "";
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=44" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=29" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ledger-modern.css?v=7" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-prepaid-card-report-page saas-admin-ledger-page saas-admin-pos-ledger-page">

    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

            <div id="posLedgerForm"
                 class="vm-rpt-filters-panel__form"
                 data-date-mode="@dateMode"
                 data-frm-date="@frmDate"
                 data-to-date="@toDate">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line vm-gift-toolbar-one-line vm-ledger-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Account</li>
                        <li>POS Ledger</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters vm-ecomm-filter-row--one-line vm-gift-filter-row--one-line vm-ledger-filter-row--one-line">

                        <div class="vm-ledger-quick-links">
                            <a href="@Url.Action("AdminLedger", "Home")" class="vm-ledger-quick-link">
                                <i class="fas fa-book" aria-hidden="true"></i> Main Ledger
                            </a>
                            <a href="@Url.Action("CMSLedger", "Home")" class="vm-ledger-quick-link">
                                <i class="fas fa-file-invoice" aria-hidden="true"></i> CMS Ledger
                            </a>
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-ledger-field--user vm-pos-field--retailer">
                            @Html.DropDownList("RetailerIdpos", new SelectList(ViewBag.RetailerId11 as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>(), "Value", "Text", selectedRetailer), "Select Retailer", new { @id = "RetailerIdpos", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="button" id="RetailerPOSMAINSearch" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

            </div>

            <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="posLedgerTotalsPanel" style="display:none;" aria-hidden="true">
                <div class="vm-dmt-totals-head">
                    <div class="vm-dmt-totals-head__title">
                        <i class="fas fa-chart-pie" aria-hidden="true"></i>
                        <span>POS ledger totals</span>
                    </div>
                    <button type="button" class="vm-dmt-totals-hide-btn" onclick="hidePosLedgerTotals()" title="Hide totals" aria-label="Hide totals">
                        <i class="fas fa-chevron-up" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                    <div class="vm-opr-total-card vm-opr-total-card--primary">
                        <span class="vm-opr-total-card__label">Total Credit</span>
                        <strong class="vm-opr-total-card__value" id="posTotalCredit">0.00</strong>
                    </div>
                    <div class="vm-opr-total-card vm-opr-total-card--failed">
                        <span class="vm-opr-total-card__label">Total Debit</span>
                        <strong class="vm-opr-total-card__value" id="posTotalDebit">0.00</strong>
                    </div>
                    <div class="vm-opr-total-card vm-opr-total-card--success">
                        <span class="vm-opr-total-card__label">Records</span>
                        <strong class="vm-opr-total-card__value" id="posTotalRecords">0</strong>
                    </div>
                </div>
            </div>

        </div>

        <div class="vm-opr-main-card vm-ledger-report-main-card vm-prepaid-report-main-card">
            <div class="vm-opr-table-panel vm-prepaid-report-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-cash-register" aria-hidden="true"></i>
                        <span>POS retailer ledger</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong id="posRecordCount">0</strong>
                        </span>
                        <span class="vm-radiant-inline-total" title="Total credit for current filter">
                            Credit: <strong id="posInlineCredit">0.00</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-pos-totals-btn" onclick="findPosLedgerTotals()" title="Show totals" aria-expanded="false" aria-controls="posLedgerTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap vm-ledger-table-wrap vm-prepaid-table-wrap">
                    <div id="RetailerPOSSearchList">
                        @Html.Action("POS_Retailer_MAINWallet", "Home")
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>


<script>
    (function ($) {

        function hidePosLedgerTotals() {
            $('#posLedgerTotalsPanel').hide().attr('aria-hidden', 'true');
            $('.vm-pos-totals-btn').attr('aria-expanded', 'false');
        }

        window.findPosLedgerTotals = function () {
            var $panel = $('#posLedgerTotalsPanel');
            if ($panel.is(':visible')) {
                hidePosLedgerTotals();
                return;
            }
            $panel.show().attr('aria-hidden', 'false');
            $('.vm-pos-totals-btn').attr('aria-expanded', 'true');
        };

        window.hidePosLedgerTotals = hidePosLedgerTotals;

        function formatPosAmount(value) {
            var num = parseFloat(value);
            if (isNaN(num)) {
                return '0.00';
            }
            return num.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function updatePosLedgerSummary() {
            var $root = $('#posLedgerPartialRoot');
            if (!$root.length) {
                return;
            }

            var records = parseInt($root.attr('data-record-count'), 10) || 0;
            var credit = $root.attr('data-total-credit') || '0';
            var debit = $root.attr('data-total-debit') || '0';

            $('#posRecordCount').text(records);
            $('#posTotalRecords').text(records);
            $('#posInlineCredit').text(formatPosAmount(credit));
            $('#posTotalCredit').text(formatPosAmount(credit));
            $('#posTotalDebit').text(formatPosAmount(debit));
        }

        function applyPosSelect2($el) {
            if (!$el || !$el.length || !$.fn.select2) {
                return;
            }
            if ($el.data('select2')) {
                $el.select2('destroy');
            }
            $el.select2({
                width: '100%',
                minimumResultsForSearch: 6
            });
        }

        function initPosLedgerDatepickers() {
            if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
                window.setTimeout(initPosLedgerDatepickers, 50);
                return;
            }
            if (typeof window.initAdminReportDateForm === 'function') {
                window.initAdminReportDateForm('#posLedgerForm');
            }
        }

        function buildPosExportUrl() {
            return '@Url.Action("ExcelAdminposreport", "Home")'
                + '?RetailerIdpos=' + encodeURIComponent($('#RetailerIdpos').val())
                + '&txt_frm_date=' + encodeURIComponent($('#txt_frm_date').val())
                + '&txt_to_date=' + encodeURIComponent($('#txt_to_date').val());
        }

        function searchPosLedger() {
            var $btn = $('#RetailerPOSMAINSearch');
            $btn.prop('disabled', true);

            $.ajax({
                url: '@Url.Action("POS_Retailer_MAINWallet", "Home")',
                type: 'POST',
                data: {
                    RetailerId: $('#RetailerIdpos').val(),
                    txt_frm_date: $('#txt_frm_date').val(),
                    txt_to_date: $('#txt_to_date').val()
                },
                success: function (response) {
                    $('#RetailerPOSSearchList').html(response);
                    updatePosLedgerSummary();
                },
                complete: function () {
                    $btn.prop('disabled', false);
                }
            });
        }

        $(document).ready(function () {
            applyPosSelect2($('#RetailerIdpos'));
            initPosLedgerDatepickers();
            $('#posLedgerForm .select2-container').css('width', '100%');

            updatePosLedgerSummary();

            $('#RetailerPOSMAINSearch').on('click', searchPosLedger);

            $('#btnExport').on('click', function () {
                window.location.href = buildPosExportUrl();
            });
        });
    })(jQuery);
</script>
