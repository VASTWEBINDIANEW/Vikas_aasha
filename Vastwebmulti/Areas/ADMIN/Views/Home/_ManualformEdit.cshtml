@model Vastwebmulti.Areas.ADMIN.Models.MasterDistributerModel

<div class="saas-mo-service-grid">
    @foreach (var item in Model.Formservice)
    {
        if (item.idno == Model.FormserviceByID.idno)
        {
            @Html.Hidden("idno", Model.FormserviceByID.idno)
            <article class="saas-mo-service-card saas-mo-service-card--editing">
                <div class="saas-mo-service-card-media">
                    <img src="data:image/png;base64,@item.images" alt="@item.servicename" />
                </div>
                @Html.TextBox("FormName1", Model.FormserviceByID.servicename, new { @class = "form-control saas-mo-input saas-mo-service-edit-input", placeholder = "Service name" })
                <button type="button" id="formbtnSave" onclick="formbtnSave(@item.idno)" class="btn saas-mo-btn-primary saas-mo-btn-block btnssl1" data-loading-text="<i class='fa fa-spinner fa-spin'></i> Saving">
                    <i class="fa fa-check" aria-hidden="true"></i> Save
                </button>
            </article>
        }
        else
        {
            <article class="saas-mo-service-card">
                <div class="saas-mo-service-card-media">
                    <img src="data:image/png;base64,@item.images" alt="@item.servicename" />
                </div>
                <p class="saas-mo-service-card-name">@item.servicename</p>
                <div class="saas-mo-service-card-actions">
                    <button type="button" onclick="formEditmode1('@item.idno')" class="btn saas-mo-service-btn saas-mo-service-btn-edit">
                        <i class="fa fa-pencil" aria-hidden="true"></i> Edit
                    </button>
                </div>
            </article>
        }
    }
</div>

<script>
    function formbtnSave(idno) {
        $.ajax({
            url: '@Url.Action("EditManual_FormName", "Home")',
            type: 'POST',
            data: { idno: idno, Name: $('#FormName1').val() },
            success: function () {
                if (typeof moSaveSuccess === 'function') {
                    moSaveSuccess('Manual form service saved successfully.');
                }
            },
            error: function () {
                if (typeof moSaveError === 'function') {
                    moSaveError('Could not save manual form service.');
                }
            }
        });
    }

    $('.btnssl1').on('click', function () {
        var $this = $(this);
        $this.button('loading');
        setTimeout(function () { $this.button('reset'); }, 500);
    });
</script>
