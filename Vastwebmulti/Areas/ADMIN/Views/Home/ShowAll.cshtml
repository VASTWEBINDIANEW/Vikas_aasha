@model IEnumerable<Vastwebmulti.Models.clear_dispute_list_Result>
@using System.Linq
@{
    ViewBag.Title = "Show All";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var rows = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.clear_dispute_list_Result>();
    var disputeReason = ViewBag.dis as string ?? "";
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-support-pages-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-showall-dispute.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-support-page saas-showall-page">
    <div class="container-fluid">
        <div class="saas-acc-toolbar saas-pan-toolbar-unified">
            <ol class="saas-acc-breadcrumb">
                <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                <li><a href="@Url.Action("Dispute_list", "Home")">Dispute's</a></li>
                <li>Show All</li>
            </ol>
            @if (!string.IsNullOrWhiteSpace(disputeReason))
            {
                <div class="saas-acc-toolbar-right">
                    <span class="saas-acc-row-count"><i class="fas fa-info-circle"></i> @disputeReason</span>
                </div>
            }
        </div>

        <div class="saas-acc-table-card">
            <div class="saas-acc-table-card-head">
                <h3>Dispute recharge details</h3>
                <span class="saas-acc-row-count"><i class="fas fa-list"></i> @rows.Count entries</span>
            </div>
            <div class="saas-acc-table-wrap table-responsive">
                <table class="table saas-acc-table saas-acc-table--showall table-bordered" id="showAllTable">
                    <thead>
                        <tr>
                            <th>User's Information</th>
                            <th>Port/API</th>
                            <th>Consumer No.</th>
                            <th>Provider</th>
                            <th>Req Date</th>
                            <th>Amount</th>
                            <th>Transition ID</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (rows.Count == 0)
                        {
                            <tr><td colspan="8" class="saas-pan-empty-cell">No records found for this dispute.</td></tr>
                        }
                        @foreach (var item in rows)
                        {
                            var sts = (item.Rstaus ?? "").Trim();
                            var rowClass = "saas-showall-row--default";
                            if (item.idno == item.newidd)
                            {
                                rowClass = "saas-showall-row--dispute";
                            }
                            else if (sts.Equals("RESEND", StringComparison.OrdinalIgnoreCase))
                            {
                                rowClass = "saas-showall-row--resend";
                            }
                            else if (sts.IndexOf("FAILED", StringComparison.OrdinalIgnoreCase) >= 0)
                            {
                                rowClass = "saas-showall-row--failed";
                            }
                            else if (sts.IndexOf("SUCCESS", StringComparison.OrdinalIgnoreCase) >= 0)
                            {
                                rowClass = "saas-showall-row--success";
                            }
                            else if (sts.Equals("Request Sent", StringComparison.OrdinalIgnoreCase) || sts.Equals("Request Send", StringComparison.OrdinalIgnoreCase))
                            {
                                rowClass = "saas-showall-row--sent";
                            }
                            var canAct = item.idno == item.newidd;
                            <tr class="@rowClass">
                                <td data-label="User">@item.Roles&nbsp;&rArr;&nbsp;@item.Frm_Name</td>
                                <td data-label="Port">@item.portno</td>
                                <td data-label="Consumer">@item.Mobile</td>
                                <td data-label="Provider">@item.operator_Name</td>
                                <td data-label="Req Date">@string.Format("{0:dd-MMM HH:mm:ss}", item.Rch_time)</td>
                                <td data-label="Amount">@item.amount</td>
                                <td data-label="Txn ID">@item.OPt_id</td>
                                <td data-label="Action">
                                    @if (canAct)
                                    {
                                        <div class="saas-showall-actions">
                                            <a href="javascript:void(0)" class="saas-showall-btn-refund" data-toggle="modal" data-target="#showAllRefundModal" onclick="showAllRefund('@item.idno')" title="Refund dispute">Refund</a>
                                            <a href="javascript:void(0)" class="saas-showall-btn-reject" data-toggle="modal" data-target="#showAllRejectModal" onclick="showAllReject('@item.idno')" title="Reject dispute">Reject</a>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<div class="modal fade saas-admin-modal" id="showAllRejectModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            @using (Html.BeginForm("diputerejected", "Home", FormMethod.Post))
            {
                <div class="modal-header saas-admin-modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title saas-admin-modal-title">Reject dispute</h4>
                </div>
                <div class="modal-body saas-admin-modal-body">
                    <input type="hidden" id="idno" name="idno" value="" />
                    <label class="saas-search-user-label">Reason</label>
                    <input type="text" id="disputereq" name="disputereq" class="form-control" value="@disputeReason" readonly="readonly" />
                    <label class="saas-search-user-label" style="margin-top:12px;">Enter response</label>
                    <textarea id="txtregion" name="txtregion" class="form-control" required="required" placeholder="Enter dispute reject comment" rows="3"></textarea>
                </div>
                <div class="saas-admin-modal-footer">
                    <button type="button" class="saas-admin-btn saas-admin-btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="saas-admin-btn saas-admin-btn-primary">Save change</button>
                </div>
            }
        </div>
    </div>
</div>

<div class="modal fade saas-admin-modal" id="showAllRefundModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            @using (Html.BeginForm("DisputeFailed", "Home", FormMethod.Post))
            {
                <div class="modal-header saas-admin-modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title saas-admin-modal-title">Refund dispute</h4>
                </div>
                <div class="modal-body saas-admin-modal-body">
                    <input type="hidden" id="txtrefidno" name="txtrefidno" value="" />
                    <label class="saas-search-user-label">Reject reason</label>
                    @Html.DropDownList("ddl_refund", new List<SelectListItem>
                    {
                        new SelectListItem { Text = "Manual Failed", Value = "Manual Failed" },
                        new SelectListItem { Text = "Failed Due To Invalid Choice", Value = "Failed Due To Invalid Choice" },
                        new SelectListItem { Text = "Network Down", Value = "Network Down" },
                        new SelectListItem { Text = "Unsupported Network", Value = "Unsupported Network" },
                        new SelectListItem { Text = "Network issue", Value = "Network issue" },
                        new SelectListItem { Text = "Insufficient Fund", Value = "Insufficient Fund" }
                    }, new { @class = "form-control" })
                </div>
                <div class="saas-admin-modal-footer">
                    <button type="button" class="saas-admin-btn saas-admin-btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="saas-admin-btn saas-admin-btn-primary">Submit</button>
                </div>
            }
        </div>
    </div>
</div>

<script>
    function showAllReject(idno) {
        document.getElementById("idno").value = idno;
    }
    function showAllRefund(idno) {
        document.getElementById("txtrefidno").value = idno;
    }
    $(function () {
        var succ = '@ViewData["success"]';
        var error = '@ViewData["error"]';
        if (succ && typeof swal === "function") { swal("Good job!", succ, "success"); }
        if (error && typeof swal === "function") { swal("Oops!", error, "error"); }
    });
</script>
