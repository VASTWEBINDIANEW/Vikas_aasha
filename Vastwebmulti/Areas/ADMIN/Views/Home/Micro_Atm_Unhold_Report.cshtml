@model IEnumerable<Vastwebmulti.Models.Show_MicroAtm_Unload_report_Result>
@using System.Linq
@{
    ViewBag.Title = "Micro ATM Unhold Report";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var rows = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.Show_MicroAtm_Unload_report_Result>();
    var outputresult = Convert.ToString(TempData["Resultdata"]);
    var totalAmount = rows.Sum(r => r.amount ?? 0);
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-settings-page-modern.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-settings-page saas-admin-report-page saas-micro-unhold-page">
    <div class="container-fluid">

        <div class="saas-acc-toolbar saas-pan-toolbar-unified" style="margin: 0 0 20px !important;">
            <ol class="saas-acc-breadcrumb">
                <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                <li><a href="@Url.Action("Micro_Atm_Unhold_Report", "Home")">Micro ATM Unhold</a></li>
                <li>Hold report</li>
            </ol>
            <div class="saas-acc-toolbar-right saas-pan-toolbar-dates">
                <div class="saas-acc-report-date-controls saas-pan-date-controls saas-micro-toolbar-actions" style="gap:8px;">
                    <a href="@Url.Action("MicroATM_Unhold_History", "Home")" class="saas-acc-btn saas-acc-btn--excel" style="text-decoration:none;">
                        <i class="fas fa-history" aria-hidden="true"></i> History
                    </a>
                    <a href="@Url.Action("MicroATM_Purchase_MaxLimit", "Home")" class="saas-acc-btn saas-acc-btn--pdf" style="text-decoration:none;">
                        <i class="fas fa-sliders-h" aria-hidden="true"></i> Max limit
                    </a>
                    <button type="button" class="saas-acc-btn saas-acc-btn--search" id="btnMicroUnholdTotal" title="Sum amounts">
                        <i class="fas fa-calculator" aria-hidden="true"></i> Total ₹@totalAmount.ToString("N2")
                    </button>
                    <div class="saas-acc-export-group saas-pan-export-group">
                        <button type="button" class="saas-acc-btn saas-acc-btn--excel saas-pan-export-btn" id="btnExport">
                            <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                        </button>
                        <button type="button" class="saas-acc-btn saas-acc-btn--pdf saas-pan-export-btn" id="btnPDF">
                            <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="saas-acc-table-card">
            <div class="saas-acc-table-card-head">
                <h3>Held transactions</h3>
                <span class="saas-acc-row-count"><i class="fas fa-list" aria-hidden="true"></i> @rows.Count records</span>
            </div>
            <div class="saas-acc-table-wrap table-responsive">
                <table class="table saas-acc-table table-bordered" id="microUnholdTable">
                    <thead>
                        <tr>
                            <th>Firm name</th>
                            <th>Bank RRN</th>
                            <th>Transaction type</th>
                            <th>Payment method</th>
                            <th class="text-right">Amount</th>
                            <th>Card payment</th>
                            <th>Trans time</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (rows.Count == 0)
                        {
                            <tr>
                                <td colspan="8" class="saas-pan-empty-cell">No held records found.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in rows)
                            {
                                <tr>
                                    <td data-label="Firm">@item.Frm_Name</td>
                                    <td data-label="RRN">@item.rrn</td>
                                    <td data-label="Type">@item.transaction_type</td>
                                    <td data-label="Payment">@item.payment_method</td>
                                    <td data-label="Amount" class="text-right saas-pan-amount micro-unhold-amt">@(item.amount.HasValue ? item.amount.Value.ToString("N2") : "0.00")</td>
                                    <td data-label="Card">@item.card_payment_type</td>
                                    <td data-label="Time">@item.transtime</td>
                                    <td data-label="Action">
                                        <button type="button" class="saas-set-btn-primary saas-micro-unhold-btn"
                                                data-toggle="modal" data-target="#microUnholdModal"
                                                data-idno="@item.idno"
                                                data-frm="@item.Frm_Name"
                                                data-rrn="@item.rrn"
                                                data-amount="@item.amount"
                                                data-card="@item.card_payment_type"
                                                data-tran="@item.transaction_type"
                                                data-pay="@item.payment_method"
                                                data-net="@item.network">
                                            Unhold
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<div class="modal fade saas-set-otp-modal saas-admin-modal saas-micro-unhold-modal" id="microUnholdModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm unhold</h5>
                <button type="button" class="close saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            @using (Html.BeginForm("MicroATM_Unhold_update", "Home", FormMethod.Post, new { id = "microUnholdForm" }))
            {
                <input type="hidden" id="hdid" name="hdid" value="0" />
                <div class="modal-body saas-micro-unhold-body">
                    <div class="saas-set-filter-bar" style="margin:0;box-shadow:none;border:none;padding:0;display:grid;gap:12px;">
                        <div><label class="saas-mo-label">Firm / mobile</label><input type="text" class="form-control" id="txtfrmname" readonly /></div>
                        <div><label class="saas-mo-label">Bank RRN</label><input type="text" class="form-control" id="txtbnkrrnno" readonly /></div>
                        <div><label class="saas-mo-label">Amount</label><input type="text" class="form-control" id="txtamountss" readonly /></div>
                        <div><label class="saas-mo-label">Card payment type</label><input type="text" class="form-control" id="txtcardPaymentType" readonly /></div>
                        <div><label class="saas-mo-label">Transaction type</label><input type="text" class="form-control" id="txttransectionType" readonly /></div>
                        <div><label class="saas-mo-label">Payment method</label><input type="text" class="form-control" id="txtPaymentMethode" readonly /></div>
                        <div><label class="saas-mo-label">Network</label><input type="text" class="form-control" id="txtnetwork" readonly /></div>
                        <div><label class="saas-mo-label">Person name <span style="color:#dc2626;">*</span></label><input type="text" class="form-control" id="txtpersonname" name="txtpersonname" required placeholder="Enter person name" /></div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="saas-set-btn-edit" data-dismiss="modal">Close</button>
                    <button type="submit" class="saas-set-btn-primary" id="btnupdate">Confirm unhold</button>
                </div>
            }
        </div>
    </div>
</div>

<script>
    (function () {
        var result = '@(outputresult ?? "")';
        if (result === 'Success' && typeof swal === 'function') {
            swal('Success', 'Unhold completed successfully.', 'success');
        } else if (result && result !== 'Success' && typeof swal === 'function') {
            swal('Error', result, 'error');
        }
    })();

    $(document).on('click', '.saas-micro-unhold-btn', function () {
        var $b = $(this);
        $('#txtfrmname').val($b.data('frm') || '');
        $('#txtbnkrrnno').val($b.data('rrn') || '');
        $('#txtamountss').val($b.data('amount') || '');
        $('#txtcardPaymentType').val($b.data('card') || '');
        $('#txttransectionType').val($b.data('tran') || '');
        $('#txtPaymentMethode').val($b.data('pay') || '');
        $('#txtnetwork').val($b.data('net') || '');
        $('#hdid').val($b.data('idno') || '0');
        $('#txtpersonname').val('');
    });

    $('#btnMicroUnholdTotal').on('click', function () {
        var total = 0;
        $('.micro-unhold-amt').each(function () {
            var v = parseFloat(String($(this).text()).replace(/,/g, '')) || 0;
            total += v;
        });
        if (typeof swal === 'function') {
            swal('Total amount', '₹ ' + total.toFixed(2), 'info');
        } else {
            alert('Total amount: ₹ ' + total.toFixed(2));
        }
    });

    $('#btnExport').on('click', function () {
        location.href = '@Url.Action("Excel_Micro_Atm_Unhold_Report", "Home")';
    });

    $('#btnPDF').on('click', function () {
        window.open('@Url.Action("PDFMicro_Atm_Unhold_Report", "Home")', '_blank');
    });
</script>
