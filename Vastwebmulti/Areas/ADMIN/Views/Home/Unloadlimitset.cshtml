@model IEnumerable<Vastwebmulti.Models.walletunloadlimit>
@using System
@using Vastwebmulti.Models
@{
    ViewBag.Title = "Wallet Unload Limit";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    VastwebmultiEntities db = new VastwebmultiEntities();
    var fg = 0;
    var rowCount = Model != null ? Model.Count() : 0;
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=62" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=40" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-security-report-page saas-unloadlimit-page">

    <div class="container-fluid vm-opr-page-shell">

        <!-- Top bar: breadcrumb + record count -->
        <div class="vm-ul-topbar">
            <ol class="vm-ul-breadcrumb">
                <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                <li>Settings</li>
                <li>Wallet Unload Limit</li>
            </ol>
            <span class="vm-ul-record-badge">
                Records: <strong id="ulRecordCount">@rowCount</strong>
            </span>
        </div>

        <!-- Main card -->
        <div class="vm-opr-main-card vm-security-report-main-card vm-gift-report-main-card vm-ul-main-card">
            <div class="vm-opr-table-panel vm-security-report-table-panel vm-gift-report-table-panel vm-ul-table-panel">

                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head vm-security-report-table-head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-wallet" aria-hidden="true"></i>
                        <span>Wallet Unload Limit</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-ul-info-badge">
                            <i class="fas fa-info-circle" aria-hidden="true"></i> Click <strong>Edit</strong> to update a retailer's limit
                        </span>
                    </div>
                </div>

                <div class="vm-opr-table-wrap vm-ul-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="ulTable" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>SR</th>
                                    <th>User (Firm &amp; Email)</th>
                                    <th>Limit</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody id="ulTbody">
                                @{int sr = 1;}
                                @foreach (var item in Model)
                                {
                                    var cj = db.Retailer_Details.Where(s => s.RetailerId == item.userid).SingleOrDefault();
                                    string limitVal = item.limit == null ? "0.00" : item.limit.ToString();
                                    <tr class="vm-ul-row" id="vm-ul-row-@fg">
                                        <td class="vm-ul-sr">@sr</td>
                                        <td class="vm-ul-user">
                                            @if (cj != null)
                                            {
                                                <div class="vm-ul-firm">@cj.Frm_Name</div>
                                                <div class="vm-ul-email">@cj.Email</div>
                                            }
                                        </td>
                                        <td class="vm-ul-limit-cell" id="vm-ul-display-@fg">
                                            <span class="vm-ul-limit-value" id="vm-ul-val-@fg">@limitVal</span>
                                        </td>
                                        <td class="vm-ul-action-cell">
                                            <!-- Display mode -->
                                            <div class="vm-ul-display-mode" id="vm-ul-dmode-@fg">
                                                <button type="button" class="vm-ul-btn vm-ul-btn--edit" onclick="ulEdit(@fg)">
                                                    <i class="fas fa-pencil-alt" aria-hidden="true"></i> Edit
                                                </button>
                                            </div>
                                            <!-- Edit mode -->
                                            <div class="vm-ul-edit-mode" id="vm-ul-emode-@fg" style="display:none;">
                                                <div class="vm-ul-edit-wrap">
                                                    <input type="number" step="0.01" class="vm-ul-input" id="vm-ul-inp-@fg" value="@limitVal" />
                                                    <button type="button" class="vm-ul-btn vm-ul-btn--save" onclick="ulSave(@fg, '@item.userid')">
                                                        <i class="fas fa-check" aria-hidden="true"></i> Save
                                                    </button>
                                                    <button type="button" class="vm-ul-btn vm-ul-btn--cancel" onclick="ulCancel(@fg)">
                                                        <i class="fas fa-times" aria-hidden="true"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                    fg++;
                                    sr++;
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>

    </div>
</section>

<script>
    /* ===== Edit toggle ===== */
    function ulEdit(idx) {
        document.getElementById('vm-ul-dmode-' + idx).style.display = 'none';
        document.getElementById('vm-ul-emode-' + idx).style.display = '';
        var inp = document.getElementById('vm-ul-inp-' + idx);
        if (inp) { inp.focus(); inp.select(); }
    }

    function ulCancel(idx) {
        document.getElementById('vm-ul-emode-' + idx).style.display = 'none';
        document.getElementById('vm-ul-dmode-' + idx).style.display = '';
    }

    /* ===== Save limit via AJAX ===== */
    function ulSave(idx, userId) {
        var inp = document.getElementById('vm-ul-inp-' + idx);
        var newVal = inp ? inp.value : '0.00';
        var $saveBtn = $('#vm-ul-emode-' + idx + ' .vm-ul-btn--save');
        $saveBtn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

        $.ajax({
            url: '@Url.Action("walletunloadlimitsave", "Home")',
            type: 'POST',
            data: { RetailerId: userId, limit: newVal },
            cache: false,
            success: function (response) {
                $saveBtn.prop('disabled', false).html('<i class="fas fa-check"></i> Save');
                if (response === 'Success') {
                    document.getElementById('vm-ul-val-' + idx).textContent = newVal;
                    ulCancel(idx);
                    showUlToast('Limit updated successfully.', 'success');
                } else {
                    ulCancel(idx);
                    showUlToast('Update failed: ' + response, 'error');
                }
            },
            error: function () {
                $saveBtn.prop('disabled', false).html('<i class="fas fa-check"></i> Save');
                ulCancel(idx);
                showUlToast('Network error. Please try again.', 'error');
            }
        });
    }

    /* ===== Toast notification ===== */
    function showUlToast(msg, type) {
        var existing = document.getElementById('vm-ul-toast');
        if (existing) existing.remove();
        var t = document.createElement('div');
        t.id = 'vm-ul-toast';
        t.className = 'vm-ul-toast vm-ul-toast--' + type;
        t.innerHTML = '<i class="fas ' + (type === 'success' ? 'fa-check-circle' : 'fa-exclamation-circle') + '"></i> ' + msg;
        document.body.appendChild(t);
        setTimeout(function () { t.classList.add('vm-ul-toast--show'); }, 10);
        setTimeout(function () { t.classList.remove('vm-ul-toast--show'); setTimeout(function () { t.remove(); }, 300); }, 3000);
    }

    /* ===== Live search ===== */
    $(document).ready(function () {
        $(document).on('keyup', '#ulSearchInput', function () {
            var val = this.value.toLowerCase();
            $('#ulTbody tr.vm-ul-row').each(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(val) > -1);
            });
        });
    });
</script>
