</div>

<script src="~/Swalalert/sweetalert-dev.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    var walletUnloadPendingAction = {
        reqId: '',
        action: ''
    };

    function formatWalletUnloadDisplayAmount(value) {
        var num = parseFloat(value);
        if (isNaN(num)) {
            return value || '�';
        }
        return '\u20B9 ' + num.toFixed(2);
    }

    function openWalletUnloadActionModal(btn) {
        var $btn = $(btn);
        var action = ($btn.data('action') || '').toString();
        var reqId = ($btn.data('request-id') || '').toString();
        var firm = ($btn.data('firm') || '�').toString();
        var bank = ($btn.data('bank') || '�').toString();
        var amount = $btn.data('amount');

        walletUnloadPendingAction.reqId = reqId;
        walletUnloadPendingAction.action = action;

        $('#walletUnloadActionFirm').text(firm);
        $('#walletUnloadActionBank').text(bank);
        $('#walletUnloadActionAmount').text(formatWalletUnloadDisplayAmount(amount));
        $('#walletUnloadActionRequestId').text(reqId || '�');

        var $header = $('#walletUnloadActionModalHeader');
        var $confirmBtn = $('#walletUnloadActionConfirmBtn');
        var $hero = $('#walletUnloadActionHero');
        var $heroBadge = $('#walletUnloadActionHeroBadge');
        var $note = $('#walletUnloadActionNote');

        $header.removeClass('accent-emerald accent-danger vm-wallet-unload-action-modal__header--reject');
        $hero.removeClass('vm-wallet-unload-confirm-hero--reject');
        $note.removeClass('vm-wallet-unload-confirm-note--reject');
        $confirmBtn.removeClass('saas-admin-modal-btn--success saas-admin-modal-btn--danger');

        if (action === 'Approved') {
            $header.addClass('accent-emerald');
            $('#walletUnloadActionModalIcon').html('<i class="fas fa-check" aria-hidden="true"></i>');
            $('#walletUnloadActionModalTitle').text('Approve wallet unload');
            $('#walletUnloadActionModalSubtitle').text('Confirm approval for this unload request');
            $('#walletUnloadActionHeroText').text('You are about to approve this wallet unload request.');
            $heroBadge.html('<i class="fas fa-check" aria-hidden="true"></i>');
            $('#walletUnloadActionNoteText').text('Approved requests will be marked as success immediately.');
            $confirmBtn.addClass('saas-admin-modal-btn--success').html('<i class="fas fa-check" aria-hidden="true"></i> Yes, Approve');
        } else {
            $header.addClass('accent-danger vm-wallet-unload-action-modal__header--reject');
            $hero.addClass('vm-wallet-unload-confirm-hero--reject');
            $note.addClass('vm-wallet-unload-confirm-note--reject');
            $('#walletUnloadActionModalIcon').html('<i class="fas fa-times" aria-hidden="true"></i>');
            $('#walletUnloadActionModalTitle').text('Reject wallet unload');
            $('#walletUnloadActionModalSubtitle').text('Confirm rejection and refund for this request');
            $('#walletUnloadActionHeroText').text('You are about to reject this wallet unload request.');
            $heroBadge.html('<i class="fas fa-times" aria-hidden="true"></i>');
            $('#walletUnloadActionNoteText').text('Rejected requests will be refunded to the retailer wallet.');
            $confirmBtn.addClass('saas-admin-modal-btn--danger').html('<i class="fas fa-times" aria-hidden="true"></i> Yes, Reject');
        }

        $('#walletUnloadActionModal').modal('show');
    }

    function showWalletUnloadSwal(type, title, message, reloadOnOk) {
        var icon = type;
        var confirmClass = 'vm-wallet-unload-swal__confirm';
        if (type === 'success') {
            confirmClass += ' vm-wallet-unload-swal__confirm--success';
        } else if (type === 'error') {
            confirmClass += ' vm-wallet-unload-swal__confirm--error';
        }

        Swal.fire({
            icon: icon,
            title: title,
            html: '<p class="vm-wallet-unload-swal__text">' + message + '</p>',
            confirmButtonText: 'OK',
            customClass: {
                popup: 'vm-wallet-unload-swal',
                title: 'vm-wallet-unload-swal__title',
                htmlContainer: 'vm-wallet-unload-swal__body',
                confirmButton: confirmClass
            },
            buttonsStyling: false
        }).then(function () {
            if (reloadOnOk) {
                location.reload();
            }
        });
    }

    function confirmWalletUnloadAction() {
        var reqId = walletUnloadPendingAction.reqId;
        var action = walletUnloadPendingAction.action;

        if (!reqId || !action) {
            return;
        }

        $('#walletUnloadActionModal').modal('hide');

        Swal.fire({
            title: 'Processing request',
            html: '<p class="vm-wallet-unload-swal__text">Please wait while we update this wallet unload request.</p>',
            allowOutsideClick: false,
            showConfirmButton: false,
            customClass: {
                popup: 'vm-wallet-unload-swal vm-wallet-unload-swal--loading',
                title: 'vm-wallet-unload-swal__title',
                htmlContainer: 'vm-wallet-unload-swal__body'
            },
            didOpen: function () {
                Swal.showLoading();
            }
        });

        $.ajax({
            url: '@Url.Action("WalletAction", "Home")',
            type: 'POST',
            data: {
                Reqid: reqId,
                Status: action
            },
            success: function (res) {
                Swal.close();
                if (res.status) {
                    showWalletUnloadSwal('success', 'Action completed', res.message, true);
                } else {
                    showWalletUnloadSwal('error', 'Action failed', res.message, false);
                }
            },
            error: function () {
                Swal.close();
                showWalletUnloadSwal('error', 'Server error', 'Unable to process this request right now. Please try again.', false);
            }
        });
    }
</script>

<script>
    function hideWalletUnloadTotals() {
        var $panel = $('#walletUnloadTotalsPanel');
        var $btn = $('.vm-wallet-unload-totals-btn');
        $panel.hide().attr('aria-hidden', 'true');
        $btn.attr('aria-expanded', 'false');
    }

    function findWalletUnloadTotals() {
        var $panel = $('#walletUnloadTotalsPanel');
        var $btn = $('.vm-wallet-unload-totals-btn');
        if ($panel.is(':visible')) {
            hideWalletUnloadTotals();
            return;
        }
        $panel.show().attr('aria-hidden', 'false');
        $btn.attr('aria-expanded', 'true');
    }

    function formatWalletUnloadAmount(value) {
        var num = parseFloat(value);
        if (isNaN(num)) {
            return '0.00';
        }
        return num.toFixed(2);
    }

    function refreshWalletUnloadSummary() {
        var rows = document.querySelectorAll('#walletUnloadReportTable tbody tr:not(.vm-opr-table-empty-row)');
        var count = rows.length;
        var total = 0;
        var success = 0;
        var rejected = 0;
        var pending = 0;

        for (var i = 0; i < rows.length; i++) {
            var row = rows[i];
            var amount = parseFloat(row.getAttribute('data-amount') || '0');
            var status = (row.getAttribute('data-status') || '').toUpperCase();
            if (isNaN(amount)) {
                amount = 0;
            }
            total += amount;
            if (status.indexOf('SUCCESS') >= 0) {
                success += amount;
            } else if (status === 'REJECTED') {
                rejected += amount;
            } else if (status === 'PENDING') {
                pending += amount;
            }
        }

        $('#walletUnloadRecordCount').text(count);
        $('#walletUnloadInlineTotal').text('\u20B9 ' + formatWalletUnloadAmount(total));
        $('#walletUnloadTotalSuccess').text(formatWalletUnloadAmount(success));
        $('#walletUnloadTotalRejected').text(formatWalletUnloadAmount(rejected));
        $('#walletUnloadTotalPending').text(formatWalletUnloadAmount(pending));
    }

    function destroyWalletUnloadSelect2($el) {
        if ($el && $el.length && $el.data('select2')) {
            $el.select2('destroy');
        }
    }

    function applyWalletUnloadSelect2($el) {
        if (!$el || !$el.length || !$.fn.select2) {
            return;
        }
        destroyWalletUnloadSelect2($el);
        $el.select2({
            width: '100%',
            minimumResultsForSearch: 6
        });
    }

    function hideWalletUnloadRetailerFilter() {
        var $wrap = $('#rem');
        $wrap.removeClass('is-visible').attr('hidden', 'hidden');
        var $select = $('#allretailer');
        destroyWalletUnloadSelect2($select);
        if ($select.length) {
            $select[0].selectedIndex = 0;
        }
    }

    function showWalletUnloadRetailerFilter() {
        var $wrap = $('#rem');
        $wrap.addClass('is-visible').removeAttr('hidden');
        applyWalletUnloadSelect2($('#allretailer'));
    }

    function answers() {
        var answer = $('#ddlusers').val();
        if (answer === 'ALL') {
            hideWalletUnloadRetailerFilter();
        } else if (answer === 'Retailer') {
            showWalletUnloadRetailerFilter();
        }
    }

    function initWalletUnloadSelect2() {
        applyWalletUnloadSelect2($('#ddlusers'));
        applyWalletUnloadSelect2($('#ddl_status'));
        $('#ddlusers').off('change.walletUnloadReport').on('change.walletUnloadReport', answers);
        if ($('#rem').hasClass('is-visible')) {
            applyWalletUnloadSelect2($('#allretailer'));
        }
    }

    function initWalletUnloadDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initWalletUnloadDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm('#walletUnloadReportForm');
        }
    }

    function buildWalletUnloadExportUrl(isPdf) {
        var base = isPdf
            ? '@Url.Action("pdfWalletUnloadReport", "Home")'
            : '@Url.Action("ExcelWalletUnloadReport", "Home")';
        return base
            + '?txt_frm_date=' + encodeURIComponent($('#txt_frm_date').val())
            + '&txt_to_date=' + encodeURIComponent($('#txt_to_date').val())
            + '&ddlusers=' + encodeURIComponent($('#ddlusers').val())
            + '&allretailer=' + encodeURIComponent($('#allretailer').val() || '')
            + '&ddl_status=' + encodeURIComponent($('#ddl_status').val() || '');
    }

    function refundshow(orderid, status) {
        $('#txtorderid').val(orderid);
        $('#status').val(status);
    }

    function Failed() {
        var answer = confirm('Are you sure ?');
        if (!answer) {
            $('#defaultModal1').modal('hide');
            return false;
        }

        var orderid = $('#txtorderid').val();
        var status = $('#status').val();
        var ddlval = $('#ddl_refund').val();

        $.ajax({
            url: '@Url.Action("GiftcardFailed", "Home")',
            type: 'POST',
            dataType: 'html',
            data: { orderid: orderid, status: status, ddl_refund: ddlval },
            success: function (data) {
                var response = JSON.parse(data);
                if (response.Status) {
                    swal('Good Job!', response.Message, 'success');
                    window.location.reload();
                } else {
                    swal('Oops...', response.Message, 'error');
                }
            }
        }).done(function () {
            $('#defaultModal1').modal('hide');
        });
        return true;
    }

    function success(orderid, status) {
        var answer = confirm('Are you sure ?');
        if (!answer) {
            return false;
        }

        $.ajax({
            url: '@Url.Action("GiftcardSuccess", "Home")',
            type: 'POST',
            dataType: 'html',
            data: { orderid: orderid, status: status },
            success: function (data) {
                var response = JSON.parse(data);
                if (response.Status) {
                    swal('Good Job!', response.Message, 'success');
                    window.location.reload();
                } else {
                    swal('Oops...', response.Message, 'error');
                }
            }
        });
        return true;
    }

    $(document).ready(function () {
        initWalletUnloadSelect2();
        answers();
        initWalletUnloadDatepickers();
        refreshWalletUnloadSummary();
        $('#walletUnloadReportForm .select2-container').css('width', '100%');

        $('#btnExport').on('click', function () {
            location.href = buildWalletUnloadExportUrl(false);
        });

        $('#btnPDF').on('click', function () {
            window.open(buildWalletUnloadExportUrl(true), '_blank');
        });
    });
</script>
