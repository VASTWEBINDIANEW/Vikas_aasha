                    <div class="vm-wallet-unload-confirm-field">
                        <span class="vm-wallet-unload-confirm-field__label">Amount</span>
                        <strong class="vm-wallet-unload-confirm-field__value vm-wallet-unload-confirm-field__value--money" id="walletUnloadActionAmount">�</strong>
