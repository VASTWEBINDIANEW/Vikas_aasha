@model IEnumerable<Vastwebmulti.Models.WalletUnloadReportAdmin_Result>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Wallet Unload Report";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var selectedUser = (Request["ddlusers"] ?? Request["type"] ?? "ALL").Trim();
    var selectedStatus = (Request["ddl_status"] ?? "ALL").Trim();
    var selectedRetailer = (Request["allretailer"] ?? "").Trim();

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
    var reports = Model ?? Enumerable.Empty<Vastwebmulti.Models.WalletUnloadReportAdmin_Result>();
    var rowCount = reports.Count();

    decimal totalAmount = reports.Sum(i => i.Amount ?? 0m);
    decimal totalSuccess = reports.Where(i => (i.Status ?? "").ToUpper().Contains("SUCCESS")).Sum(i => i.Amount ?? 0m);
    decimal totalPending = reports.Where(i => string.Equals(i.Status, "PENDING", StringComparison.OrdinalIgnoreCase)).Sum(i => i.Amount ?? 0m);
    decimal totalRejected = reports.Where(i => string.Equals(i.Status, "REJECTED", StringComparison.OrdinalIgnoreCase)).Sum(i => i.Amount ?? 0m);

    var ddlUsersItems = new List<SelectListItem>
    {
        new SelectListItem { Text = "ALL", Value = "ALL", Selected = selectedUser == "ALL" },
        new SelectListItem { Text = "Retailer", Value = "Retailer", Selected = selectedUser == "Retailer" }
    };

    var ddlStatusItems = new List<SelectListItem>
    {
        new SelectListItem { Text = "Status", Value = "ALL", Selected = selectedStatus == "ALL" },
        new SelectListItem { Text = "Pending", Value = "Pending", Selected = selectedStatus == "Pending" },
        new SelectListItem { Text = "Success", Value = "Success", Selected = selectedStatus == "Success" },
        new SelectListItem { Text = "Rejected", Value = "Rejected", Selected = selectedStatus == "Rejected" }
    };

    SelectList retailerDropdown = ViewBag.allretailer as SelectList;
    var retailerListItems = ViewBag.allretailer as IEnumerable<SelectListItem>;
    if (retailerDropdown == null && retailerListItems != null)
    {
        retailerDropdown = new SelectList(retailerListItems, "Value", "Text", selectedRetailer);
    }
    else if (retailerDropdown == null && ViewBag.allretailer != null)
    {
        var retailerSource = ViewBag.allretailer as System.Collections.IEnumerable;
        if (retailerSource != null)
        {
            retailerDropdown = new SelectList(retailerSource, "RetailerId", "Frm_Name", selectedRetailer);
        }
    }
    else if (retailerDropdown != null && !string.IsNullOrEmpty(selectedRetailer))
    {
        retailerDropdown = new SelectList(retailerDropdown.Items, "Value", "Text", selectedRetailer);
    }

    var showRetailerFilter = selectedUser == "Retailer";
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=47" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=31" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-security-report-page saas-giftcard-report-page saas-radiant-wallet-report-page saas-wallet-unload-report-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var walletUnloadFormAttrs = new Dictionary<string, object>
            {
                { "id", "walletUnloadReportForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("WalletUnloadReport", "Home", FormMethod.Post, walletUnloadFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line vm-gift-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Report's</li>
                        <li>Wallet Unload Report</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters vm-ecomm-filter-row--one-line vm-gift-filter-row--one-line">

                        <div class="vm-opr-field vm-dmt-field vm-wallet-unload-field--user">
                            @Html.DropDownList("ddlusers", ddlUsersItems, new { @id = "ddlusers", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        @if (showRetailerFilter)
                        {
                            <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra vm-wallet-unload-field--retailer is-visible" id="rem">
                                @Html.DropDownList("allretailer", retailerDropdown, "All Retailer", new { id = "allretailer", @class = "vm-opr-select vm-dmt-select form-control" })
                            </div>
                        }
                        else
                        {
                            <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra vm-wallet-unload-field--retailer" id="rem" hidden="hidden">
                                @Html.DropDownList("allretailer", retailerDropdown, "All Retailer", new { id = "allretailer", @class = "vm-opr-select vm-dmt-select form-control" })
                            </div>
                        }

                        <div class="vm-opr-field vm-dmt-field vm-wallet-unload-field--status">
                            @Html.DropDownList("ddl_status", ddlStatusItems, new { @id = "ddl_status", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar" aria-hidden="true"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar" aria-hidden="true"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" name="btntype" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="walletUnloadTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Wallet unload totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideWalletUnloadTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Success</span>
                            <strong class="vm-opr-total-card__value" id="walletUnloadTotalSuccess">@totalSuccess.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Rejected</span>
                            <strong class="vm-opr-total-card__value" id="walletUnloadTotalRejected">@totalRejected.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Pending</span>
                            <strong class="vm-opr-total-card__value" id="walletUnloadTotalPending">@totalPending.ToString("N2")</strong>
                        </div>
                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card vm-security-report-main-card vm-gift-report-main-card vm-wallet-unload-report-main-card">
            <div class="vm-opr-table-panel vm-security-report-table-panel vm-gift-report-table-panel vm-wallet-unload-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head vm-security-report-table-head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-university" aria-hidden="true"></i>
                        <span>Wallet unload report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong id="walletUnloadRecordCount">@rowCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total" title="Total amount for current filter">
                            Total: <strong id="walletUnloadInlineTotal">&#8377; @totalAmount.ToString("N2")</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-gift-totals-btn vm-wallet-unload-totals-btn" onclick="findWalletUnloadTotals()" title="Show totals" aria-expanded="false" aria-controls="walletUnloadTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap vm-wallet-unload-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="walletUnloadReportTable" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Status</th>
                                    <th>Role</th>
                                    <th>Firm&nbsp;Name</th>
                                    <th>Transfer&nbsp;Type</th>
                                    <th>Bank&nbsp;Name</th>
                                    <th>Remain&nbsp;Pre&nbsp;&#8377;</th>
                                    <th>Amount&nbsp;&#8377;</th>
                                    <th>Charge&nbsp;&#8377;</th>
                                    <th>Remain&nbsp;Post&nbsp;&#8377;</th>
                                    <th>Request&nbsp;Time</th>
                                    <th>Response&nbsp;Time</th>
                                    <th>Bank&nbsp;RRN</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (rowCount == 0)
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="13">No records found for the selected filters.</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var item in reports)
                                    {
                                        var statusKey = (item.Status ?? "").Trim();
                                        var statusUpper = statusKey.ToUpperInvariant();
                                        var rowClass = "vm-radiant-wallet-row";
                                        if (statusUpper.Contains("SUCCESS"))
                                        {
                                            rowClass += " vm-radiant-wallet-row--approved";
                                        }
                                        else if (statusUpper == "REJECTED")
                                        {
                                            rowClass += " vm-radiant-wallet-row--reject";
                                        }
                                        else if (statusUpper == "PENDING")
                                        {
                                            rowClass += " vm-radiant-wallet-row--pending";
                                        }
                                        else if (statusUpper.Contains("REFUND"))
                                        {
                                            rowClass += " vm-radiant-wallet-row--refund";
                                        }

                                        var amountVal = item.Amount ?? 0m;

                                        <tr class="@rowClass" data-status="@statusKey" data-amount="@amountVal">
                                            <td><span class="vm-radiant-wallet-status">@item.Status</span></td>
                                            <td>@item.RoleName</td>
                                            <td>@item.FirmName</td>
                                            <td>@item.TransferType</td>
                                            <td>@item.BankName</td>
                                            <td>@item.Rempre</td>
                                            <td>@item.Amount</td>
                                            <td>@item.ProcessingCharge</td>
                                            <td>@item.RemPost</td>
                                            <td>@item.RequestDate</td>
                                            <td>@item.ResponseDate</td>
                                            <td>@item.BankRRN</td>
                                            <td class="vm-wallet-unload-act-cell">
                                                <button type="button" class="vm-gift-act-btn vm-gift-act-btn--success" title="Approved"
                                                        data-request-id="@item.RequestId"
                                                        data-action="Approved"
                                                        data-firm="@item.FirmName"
                                                        data-amount="@item.Amount"
                                                        data-bank="@item.BankName"
                                                        onclick="openWalletUnloadActionModal(this)">
                                                    <i class="fa fa-check" aria-hidden="true"></i>
                                                </button>
                                                <button type="button" class="vm-gift-act-btn vm-gift-act-btn--failed" title="Reject"
                                                        data-request-id="@item.RequestId"
                                                        data-action="Reject"
                                                        data-firm="@item.FirmName"
                                                        data-amount="@item.Amount"
                                                        data-bank="@item.BankName"
                                                        onclick="openWalletUnloadActionModal(this)">
                                                    <i class="fa fa-times" aria-hidden="true"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<div class="modal fade saas-admin-modal" id="defaultModal1" tabindex="-1" role="dialog" aria-hidden="true" style="display:none;">
