@model Vastwebmulti.Areas.ADMIN.Models.whatsappslab
@using (Ajax.BeginForm("_whatsapp_comm", "Home", new AjaxOptions { HttpMethod = "POST", OnSuccess = "OnSuccess", UpdateTargetId = "divEditFormComm", LoadingElementId = "div_Loader", InsertionMode = InsertionMode.Replace }))
{
    <input id="btnsubmit" type="submit" value="Save Now" class="btn waves-effect vm-pg-slab-save-btn" style="display:none;" />

    <div class="vm-pg-slab-table-scroll saas-acc-table-wrap vm-prepaid-slab-table-wrap">
        <table id="whatsappSlabTable" class="table table-bordered vm-pg-slab-table third-design-table slab-table example-second">
            <thead>
                <tr>
                    <th>#</th>
                    <th>@Model.common[0].T1&nbsp;Months</th>
                    <th>@Model.common[0].T2&nbsp;Months</th>
                    <th>@Model.common[0].T3&nbsp;Months</th>
                </tr>
            </thead>
            <tbody id="tbodyshow" class="vm-pg-slab-tbody--view">
                <tr>
                    <td>All Api Users</td>
                    <td>@Model.common[0].P1</td>
                    <td>@Model.common[0].P2</td>
                    <td>@Model.common[0].P3</td>
                </tr>
                <tr>
                    <th>Purchase</th>
                    <td>@Model.common[0].PP1</td>
                    <td>@Model.common[0].PP2</td>
                    <td>@Model.common[0].PP3</td>
                </tr>
            </tbody>
            <tbody id="tbodyedit" class="vm-pg-slab-tbody--hidden">
                @for (int i = 0; i < Model.common.Count; i++)
                {
                    <tr>
                        @Html.HiddenFor(a => a.common[i].idno)
                        <td>All Api Users</td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.common[i].P1, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input" } })
                            @Html.ValidationMessageFor(a => a.common[i].P1)
                        </td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.common[i].P2, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input" } })
                            @Html.ValidationMessageFor(a => a.common[i].P2)
                        </td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.common[i].P3, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input" } })
                            @Html.ValidationMessageFor(a => a.common[i].P3)
                        </td>
                    </tr>
                }
                <tr>
                    <th>Purchase</th>
                    <td>@Model.common[0].PP1</td>
                    <td>@Model.common[0].PP2</td>
                    <td>@Model.common[0].PP3</td>
                </tr>
            </tbody>
        </table>
    </div>
}

<script>
    function OnSuccess() {
        $('#btnsubmit').hide().removeClass('is-visible');
        $('#btnEdit').show().removeClass('is-hidden');
        if (typeof resetSlabViewMode === 'function') {
            resetSlabViewMode();
        }
    }
</script>
