@{
    ViewBag.Title = "AEPS & Aadhaar Pay Slab";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-settings-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css?v=12" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-payment-gateway-slab-modern.css?v=10" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-prepaid-slab-modern.css?v=14" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-prepaid-slab-mobile.css?v=14" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-prepaid-slab-modals.css?v=4" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />

<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/MainFrontDesign/select2/dist/js/select2.full.min.js"></script>

<style>
    #div_Loader {
        background: rgba(0, 0, 0, 0.6) none repeat scroll 0 0;
        height: 100%;
        position: fixed;
        left: 0;
        top: 0;
        width: 100%;
        z-index: 999999;
    }

    .ldio-gs56nt525f > div {
        transform-origin: 100px 100px;
        animation: ldio-gs56nt525f 0.2s infinite linear;
    }

        .ldio-gs56nt525f > div div {
            position: absolute;
            width: 22px;
            height: 152px;
            background: var(--main-bg-lcolor);
            left: 100px;
            top: 100px;
            transform: translate(-50%,-50%);
        }

            .ldio-gs56nt525f > div div:nth-child(1) {
                width: 120px;
                height: 120px;
                border-radius: 50%;
            }

            .ldio-gs56nt525f > div div:nth-child(6) {
                width: 80px;
                height: 80px;
                background: #fff;
                border-radius: 50%;
            }

            .ldio-gs56nt525f > div div:nth-child(3) {
                transform: translate(-50%,-50%) rotate(45deg)
            }

            .ldio-gs56nt525f > div div:nth-child(4) {
                transform: translate(-50%,-50%) rotate(90deg)
            }

            .ldio-gs56nt525f > div div:nth-child(5) {
                transform: translate(-50%,-50%) rotate(135deg)
            }

    .loadingio-spinner-gear-94vo528ab8 {
        width: 200px;
        height: 200px;
        display: inline-block;
        overflow: hidden;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%,-50%);
    }

    .ldio-gs56nt525f {
        width: 100%;
        height: 100%;
        position: relative;
        transform: translateZ(0) scale(1);
        backface-visibility: hidden;
        transform-origin: 0 0;
    }

        .ldio-gs56nt525f div {
            box-sizing: content-box;
        }

    @@keyframes ldio-gs56nt525f {
        0% { transform: rotate(0deg) }
        50% { transform: rotate(22.5deg) }
        100% { transform: rotate(45deg) }
    }
</style>

<section class="content saas-admin-account-page saas-admin-settings-page saas-pg-slab-page saas-prepaid-slab-page saas-cms-slab-page saas-retailer-charge-slab-page saas-aeps-retailer-slab-page" id="retailerChargePage">
    <div id="loadermoney" class="loadermoney" style="display:none;"></div>
    <div class="container-fluid">

        <div class="saas-acc-toolbar">
            <ol class="saas-acc-breadcrumb">
                <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                <li><a href="javascript:void(0);">Basic Setting</a></li>
                <li>AEPS &amp; Aadhaar Pay Slab</li>
            </ol>
        </div>

        <div class="vm-prepaid-slab-shell">
            @Html.Partial("_Slab_Menu")

            <div class="vm-prepaid-slab-main">
                <div class="vm-pg-slab-card">
                    <div class="vm-pg-slab-card__head vm-retailer-charge-card__head">
                        <h3 class="vm-pg-slab-card__title">
                            <i class="fas fa-fingerprint" aria-hidden="true"></i>
                            AEPS &amp; Aadhaar Pay Retailer Slab
                        </h3>
                    </div>

                    <div class="vm-pg-slab-body">
                        <div class="vm-retailer-charge-toolbar">
                            @using (Html.BeginForm("Retailer_Aeps_Aadharpay_slab", "Home", FormMethod.Post, new { @class = "vm-retailer-charge-filter vm-prepaid-user-filter vm-prepaid-user-filter--inline slab-master-block" }))
                            {
                                <div class="vm-prepaid-user-filter__row vm-aeps-filter-row">
                                    <div class="vm-prepaid-user-filter__item vm-prepaid-user-filter__item--select">
                                        <div class="vm-pg-slab-field">
                                            <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-store"></i></span>
                                            @Html.DropDownList("DealerId", ViewBag.DealerId as SelectList, "Select Distributor", new { @class = "form-control for-select2", onchange = "SelectDealer(this)" })
                                        </div>
                                    </div>
                                    <div class="vm-prepaid-user-filter__item vm-prepaid-user-filter__item--select">
                                        <div class="vm-pg-slab-field">
                                            <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-user-tag"></i></span>
                                            @Html.DropDownList("RetailerId", Enumerable.Empty<SelectListItem>(), "Select Retailer", new { @class = "form-control for-select2" })
                                        </div>
                                    </div>
                                    <div class="vm-prepaid-user-filter__item vm-aeps-filter-search">
                                        <button type="submit" class="vm-retailer-charge-search-btn">
                                            <i class="fas fa-search" aria-hidden="true"></i>
                                            <span>Search</span>
                                        </button>
                                    </div>
                                </div>
                            }

                            <div class="vm-retailer-charge-actions">
                                <div class="vm-prepaid-slab-actions vm-aeps-charge-actions">
                                    <button type="button" id="btnBulkEdit" class="vm-prepaid-slab-action-btn" data-toggle="modal" data-target="#aepsBulkModal">
                                        <i class="fas fa-users-cog" aria-hidden="true"></i>
                                        Edit All Selected
                                    </button>
                                    <button type="button" id="btnEdit" class="vm-pg-slab-btn-edit" onclick="showRetailerChargeEditMode()">
                                        <img src="~/AdminDesign/images/edit.svg" alt="" />
                                        <span>Edit Slab</span>
                                    </button>
                                    <button type="button" id="btnSave" class="vm-pg-slab-save-btn" onclick="saveRetailerCharges()" style="display:none;">
                                        <span>Save</span>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div id="divEditFormComm" class="vm-pg-slab-edit-table">
                            @using (Ajax.BeginForm("UpdateCharges", "Home", new AjaxOptions { HttpMethod = "POST" }, new { id = "chargesForm" }))
                            {
                                <div class="vm-pg-slab-table-scroll saas-acc-table-wrap vm-prepaid-slab-table-wrap vm-retailer-charge-table-wrap">
                                    <table class="table table-bordered vm-pg-slab-table slab-table third-design-table" id="aepsChargeTable">
                                        <thead>
                                            <tr>
                                                <th>Retailer Name</th>
                                                <th>Mobile No</th>
                                                <th>AEPS Charge</th>
                                                <th>Aadhaar Pay Charge</th>
                                            </tr>
                                        </thead>
                                        <tbody id="tbodyshow" class="vm-pg-slab-tbody--view">
                                            @if (ViewBag.apescharges != null)
                                            {
                                                foreach (var item in ViewBag.apescharges)
                                                {
                                                    <tr>
                                                        <td class="vm-retailer-charge-name" data-label="Retailer Name">@item.Retailer_name</td>
                                                        <td data-label="Mobile No">@item.retailer_mobile</td>
                                                        <td data-label="AEPS Charge">
                                                            <span class="vm-charge-view">@item.AepsCharge</span>
                                                            <div class="vm-charge-edit">
                                                                <input type="hidden" name="DealerId" value="@item.DealerId" />
                                                                <input type="hidden" name="RetailerId" value="@item.RetailerId" />
                                                                <input step="any" type="number" name="AepsCharge" value="@item.AepsCharge" class="form-control vm-pg-slab-cell-input" />
                                                            </div>
                                                        </td>
                                                        <td data-label="Aadhaar Pay Charge">
                                                            <span class="vm-charge-view">@item.AadharpayCharge</span>
                                                            <div class="vm-charge-edit">
                                                                <input step="any" type="number" name="AadharpayCharge" value="@item.AadharpayCharge" class="form-control vm-pg-slab-cell-input" />
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="4" class="vm-retailer-charge-empty">No data found</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div id="div_Loader" style="display:none;">
    <div class="loadingio-spinner-gear-94vo528ab8">
        <div class="ldio-gs56nt525f">
            <div><div></div><div></div><div></div><div></div><div></div><div></div></div>
        </div>
    </div>
</div>

<div id="aepsBulkModal" class="modal fade saas-admin-modal vm-prepaid-modal vm-prepaid-modal--md vm-retailer-charge-bulk-modal" tabindex="-1" role="dialog" aria-labelledby="aepsBulkModalLabel" aria-hidden="true">
    <div class="modal-dialog saas-admin-modal-dialog vm-aeps-bulk-modal-dialog" role="document">
        <div class="modal-content vm-aeps-bulk-modal-content">
            <div class="modal-header saas-admin-modal-header accent-emerald vm-aeps-bulk-modal-header">
                <div class="saas-admin-modal-head-main">
                    <div class="saas-admin-modal-icon"><i class="fas fa-users-cog" aria-hidden="true"></i></div>
                    <div class="saas-admin-modal-title-wrap">
                        <h4 class="modal-title saas-admin-modal-title" id="aepsBulkModalLabel">Update All Selected Users</h4>
                        <p class="saas-admin-modal-subtitle">Apply same AEPS &amp; Aadhaar Pay charge</p>
                    </div>
                </div>
                <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
            </div>
            <div class="modal-body saas-admin-modal-body saas-admin-modal-scroll vm-aeps-bulk-modal-body">
                <p class="vm-prepaid-modal-note vm-retailer-charge-modal-note">
                    Charges will apply to users matching your current distributor / retailer filter. Leave retailer empty to update all retailers under the selected distributor.
                </p>
                <div class="vm-retailer-charge-modal-grid">
                    <div class="vm-retailer-charge-modal-field">
                        <label for="updateAeps">
                            <i class="fas fa-fingerprint" aria-hidden="true"></i>
                            AEPS Charge
                        </label>
                        <input id="updateAeps" type="number" step="any" name="aeps" value="0.80" class="vm-prepaid-modal-input" placeholder="Enter AEPS charge" />
                        <small>Per transaction AEPS service charge</small>
                    </div>
                    <div class="vm-retailer-charge-modal-field">
                        <label for="updateAadharpay">
                            <i class="fas fa-id-card" aria-hidden="true"></i>
                            Aadhaar Pay Charge
                        </label>
                        <input id="updateAadharpay" type="number" step="any" name="aadharpay" value="0.80" class="vm-prepaid-modal-input" placeholder="Enter Aadhaar Pay charge" />
                        <small>Per transaction Aadhaar Pay service charge</small>
                    </div>
                </div>
            </div>
            <div class="modal-footer saas-admin-modal-footer vm-aeps-bulk-modal-footer">
                <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal">Cancel</button>
                <button type="button" id="btnBulkSave" class="saas-admin-modal-btn saas-admin-modal-btn--success" onclick="UpdateAll()">
                    <i class="fas fa-save" aria-hidden="true"></i>
                    Save Changes
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function initRetailerChargeUi() {
        if ($.fn.select2) {
            $('.saas-retailer-charge-slab-page .for-select2').each(function () {
                var $el = $(this);
                try {
                    if ($el.hasClass('select2-hidden-accessible')) {
                        $el.select2('destroy');
                    }
                } catch (e) { }
                $el.select2({
                    width: '100%',
                    dropdownParent: $(document.body)
                });
            });
        }
    }

    function resetRetailerChargeViewMode() {
        $('#retailerChargePage').removeClass('is-edit-mode');
        $('#btnEdit').show().removeClass('is-hidden');
        $('#btnSave').hide().removeClass('is-visible');
        $('#btnBulkEdit').show().removeClass('is-hidden');
    }

    function showRetailerChargeEditMode() {
        $('#retailerChargePage').addClass('is-edit-mode');
        $('#btnEdit').hide().addClass('is-hidden');
        $('#btnBulkEdit').hide().addClass('is-hidden');
        $('#btnSave').show().addClass('is-visible');
    }

    function saveRetailerCharges() {
        $('#chargesForm').submit();
    }

    function SelectDealer(dealer) {
        var selectedValue = dealer.value;
        $.ajax({
            type: 'GET',
            url: '@Url.Action("GetRetailer", "Home")',
            data: { dealerId: selectedValue },
            success: function (data) {
                var selectElement = $('#RetailerId');
                selectElement.empty();
                selectElement.append('<option value="">Select Retailer</option>');
                for (var i = 0; i < data.retailer.length; i++) {
                    var retailer = data.retailer[i];
                    selectElement.append('<option value="' + retailer.Value + '">' + retailer.Text + '</option>');
                }
                initRetailerChargeUi();
            },
            error: function (error) {
                console.log('Error:', error);
            }
        });
    }

    function UpdateAll() {
        var dealer = document.getElementById('DealerId').value;
        var retailer = document.getElementById('RetailerId').value;
        if (retailer === '') {
            retailer = null;
        }
        var value = document.getElementById('updateAeps').value;
        var value1 = document.getElementById('updateAadharpay').value;

        $('#btnBulkSave').prop('disabled', true);
        $('#aepsBulkModal').modal('hide');
        $('#div_Loader').show();
        $.ajax({
            type: 'GET',
            url: '@Url.Action("UpdateAllEntery", "Home")',
            data: { dealer: dealer, retailer: retailer, aeps: value, aadhar: value1 },
            success: function (data) {
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("Retailer_Aeps_Aadharpay_slab", "Home")',
                    data: { DealerId: data.dealerid, RetailerId: null },
                    success: function () {
                        window.location.reload();
                    },
                    error: function () {
                        $('#div_Loader').hide();
                        $('#btnBulkSave').prop('disabled', false);
                        window.location.reload();
                    }
                });
            },
            error: function () {
                $('#div_Loader').hide();
                $('#btnBulkSave').prop('disabled', false);
            }
        });
    }

    $(document).ready(function () {
        initRetailerChargeUi();
        resetRetailerChargeViewMode();

        $('#aepsBulkModal').on('hidden.bs.modal', function () {
            $('#btnBulkSave').prop('disabled', false);
        });

        $('#aepsBulkModal').on('shown.bs.modal', function () {
            $(this).find('.vm-aeps-bulk-modal-body').scrollTop(0);
        });
    });
</script>
