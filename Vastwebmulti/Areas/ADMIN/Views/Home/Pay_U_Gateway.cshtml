<script src="~/MainFrontDesign/select2/dist/js/select2.full.min.js"></script>

<script>
    function hidePayUGatewayTotals() {
        var $panel = $('#payUGatewayTotalsPanel');
        var $btn = $('.vm-pg-totals-btn');
        $panel.hide().attr('aria-hidden', 'true');
        $btn.attr('aria-expanded', 'false');
    }

    function togglePayUGatewayTotals() {
        var $panel = $('#payUGatewayTotalsPanel');
        var $btn = $('.vm-pg-totals-btn');
        if ($panel.is(':visible')) {
            hidePayUGatewayTotals();
            return;
        }
        $panel.show().attr('aria-hidden', 'false');
        $btn.attr('aria-expanded', 'true');
    }

    var pgExtraWrapSelectors = ['#drpretailer1', '#drpdealer1', '#drpmaster1', '#drpapi1', '#drpwhite1'];
    var pgExtraSelectSelectors = ['#Retailerid1', '#Dealerid1', '#Masterid1', '#Apiid1', '#Whitelabelid1'];

    function destroyPgSelect2($el) {
        if ($el && $el.length && $el.data('select2')) {
            $el.select2('destroy');
        }
    }

    function applyPgSelect2($el) {
        if (!$el || !$el.length || !$.fn.select2) {
            return;
        }
        destroyPgSelect2($el);
        $el.select2({
            width: '100%',
            minimumResultsForSearch: 6
        });
    }

    function hidePgFilterExtras() {
        $(pgExtraWrapSelectors.join(', ')).each(function () {
            $(this).removeClass('is-visible').attr('hidden', 'hidden');
        });
        $(pgExtraSelectSelectors.join(', ')).each(function () {
            destroyPgSelect2($(this));
        });
    }

    function showPgFilterExtra(selector) {
        var $wrap = $(selector);
        $wrap.addClass('is-visible').removeAttr('hidden');
        var $select = $wrap.find('select');
        applyPgSelect2($select);
        if ($select.length && $select.data('select2')) {
            $select.next('.select2-container').css('width', '100%');
        }
    }

    function payUGatewayRoleFilter() {
        var answer = $('#ddlname1').val();
        hidePgFilterExtras();

        if (answer === 'Retailer') {
            showPgFilterExtra('#drpretailer1');
        } else if (answer === 'Dealer') {
            showPgFilterExtra('#drpdealer1');
        } else if (answer === 'Master') {
            showPgFilterExtra('#drpmaster1');
        } else if (answer === 'Api') {
            showPgFilterExtra('#drpapi1');
        } else if (answer === 'Whitelabel') {
            showPgFilterExtra('#drpwhite1');
        }
    }

    function ddlnamechange1() {
        payUGatewayRoleFilter();
    }

    function syncGatewayUserIdForSearch() {
        var role = $('#ddlname1').val();
        var id = '';
        if (role === 'Retailer') {
            id = $('#Retailerid1').val() || '';
        } else if (role === 'Dealer') {
            id = $('#Dealerid1').val() || '';
        } else if (role === 'Master') {
            id = $('#Masterid1').val() || '';
        } else if (role === 'Api') {
            id = $('#Apiid1').val() || '';
        } else if (role === 'Whitelabel') {
            id = $('#Whitelabelid1').val() || '';
        }
        $('#Retailerid1').val(id);
    }

    function initPayUGatewaySelect2() {
        applyPgSelect2($('#ddlname1'));
        applyPgSelect2($('#ddlstatus1'));
        applyPgSelect2($('#settlement'));
        $('#ddlname1').off('change.payUGateway').on('change.payUGateway', payUGatewayRoleFilter);
    }

    function initPayUGatewayDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initPayUGatewayDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm('#payUGatewayForm', '#txt_frm_date1', '#txt_to_date1', true);
        } else if (typeof window.bootPayUGatewayDates === 'function') {
            window.bootPayUGatewayDates(0);
        }
    }

    function exportPayUGatewayPdf() {
        syncGatewayUserIdForSearch();
        var $table = $('#payUGatewayTable');
        if (!$table.length) {
            return;
        }

        var frmDate = $('#txt_frm_date1').val() || '';
        var toDate = $('#txt_to_date1').val() || '';
        var title = 'Payment Gateway Report (' + frmDate + ' to ' + toDate + ')';
        var $clone = $table.clone();
        $clone.find('.vm-pg-status-check-btn').remove();
        $clone.find('tr.vm-opr-table-empty-row').remove();

        var printWindow = window.open('', '_blank');
        if (!printWindow) {
            alert('Please allow popups to export PDF.');
            return;
        }

        printWindow.document.write('<!DOCTYPE html><html><head><title>' + title + '</title>');
        printWindow.document.write('<style>');
        printWindow.document.write('body{font-family:Arial,sans-serif;margin:16px;color:#111;}');
        printWindow.document.write('h2{font-size:16px;margin:0 0 12px;}');
        printWindow.document.write('table{border-collapse:collapse;width:100%;font-size:10px;}');
        printWindow.document.write('th,td{border:1px solid #ccc;padding:5px 4px;text-align:center;vertical-align:middle;}');
        printWindow.document.write('th{background:#f3f4f6;font-weight:700;}');
        printWindow.document.write('@@media print{body{margin:0;} @@page{margin:10mm;}}');
        printWindow.document.write('</style></head><body>');
        printWindow.document.write('<h2>' + title + '</h2>');
        printWindow.document.write($clone.prop('outerHTML'));
        printWindow.document.write('</body></html>');
        printWindow.document.close();
        printWindow.focus();
        window.setTimeout(function () {
            printWindow.print();
            printWindow.close();
        }, 300);
    }

    function refreshPayUGatewaySummary() {
        var $rows = $('#payUGatewayTable tbody tr.vm-pay-gateway-report-row');
        var success = 0;
        var pending = 0;
        var failed = 0;

        $rows.each(function () {
            if ($(this).hasClass('vm-pay-gateway-report-row--success')) {
                success++;
            } else if ($(this).hasClass('vm-pay-gateway-report-row--pending')) {
                pending++;
            } else if ($(this).hasClass('vm-pay-gateway-report-row--failed')) {
                failed++;
            }
        });

        var count = $rows.length;
        $('#payUGatewayRecordCount').text(count);
        $('#payUGatewayTotalRecords').text(count);
        $('#payUGatewayTotalSuccess').text(success);
        $('#payUGatewayTotalPending').text(pending);
        $('#payUGatewayTotalFailed').text(failed);

        var $totalsRow = $('#payUGatewayTable tr.vm-pg-totals-row td');
        if ($totalsRow.length >= 4) {
            $('#payUGatewayTotalAmount').text($.trim($totalsRow.eq(1).text()));
            $('#payUGatewayTotalNet').text($.trim($totalsRow.eq(3).text()));
            $('#payUGatewayTotalReceived').text($.trim($totalsRow.eq(4).text()));
        }
    }

    function onPayUGatewaySearchSuccess() {
        refreshPayUGatewaySummary();
    }

    function onPayUGatewaySearchFailure(error) {
        if (error && error.responseText) {
            alert(error.responseText);
        }
    }

    function Statuschk(txnid) {
        syncGatewayUserIdForSearch();
        var ddlname1 = $('#ddlname1').val();
        var Retailerid = $('#Retailerid1').val();
        var ddlstatus = $('#ddlstatus1').val();
        var txt_frm_date = $('#txt_frm_date1').val();
        var txt_to_date = $('#txt_to_date1').val();
        var url = '@Url.Action("Gateway_Update_Status", "Home")';

        $.ajax({
            url: url,
            data: {
                txnid: txnid,
                ddlname1: ddlname1,
                Retailerid: Retailerid,
                ddlstatus: ddlstatus,
                txt_frm_date: txt_frm_date,
                txt_to_date: txt_to_date
            },
            success: function (data) {
                $('#WAdminSearchList').html(data);
                refreshPayUGatewaySummary();
            }
        });
    }

    function exportPayUGatewayReport() {
        syncGatewayUserIdForSearch();
        var txt_frm_date1 = $('#txt_frm_date1').val();
        var txt_to_date1 = $('#txt_to_date1').val();
        var ddlname1 = $('#ddlname1').val();
        var Retailerid1 = $('#Retailerid1').val() || '';
        var ddlstatus1 = $('#ddlstatus1').val();
        var url = '@Url.Action("Excel_Pay_U_Gateway", "Home")'
            + '?txt_frm_date1=' + encodeURIComponent(txt_frm_date1)
            + '&txt_to_date1=' + encodeURIComponent(txt_to_date1)
            + '&ddlname1=' + encodeURIComponent(ddlname1)
            + '&Retailerid1=' + encodeURIComponent(Retailerid1)
            + '&ddlstatus1=' + encodeURIComponent(ddlstatus1);
        location.href = url;
    }

    function KYCONOFF(usefor) {
        $.ajax({
            url: '@Url.Action("Payment_Gateway_KYC_ON_OFF", "Home")',
            type: 'GET',
            success: function (data) {
                if (data.status === 'Success') {
                    if (data.Message === true) {
                        $('.' + usefor + '.onoffswitch span').removeClass('custom-off').addClass('costom-on');
                    } else if (data.Message === false) {
                        $('.' + usefor + '.onoffswitch span').removeClass('costom-on').addClass('custom-off');
                    }
                } else if (typeof toastr !== 'undefined') {
                    toastr.error(data.Message);
                }
            }
        });
    }

    $(document).ready(function () {
        initPayUGatewaySelect2();
        payUGatewayRoleFilter();
        initPayUGatewayDatepickers();
        $('#payUGatewayForm .select2-container').css('width', '100%');
        $('#payUGatewayForm').on('submit', syncGatewayUserIdForSearch);
        refreshPayUGatewaySummary();

        $('#btnExport').on('click', function () {
            exportPayUGatewayReport();
        });

        $('#btnPDF').on('click', function () {
            exportPayUGatewayPdf();
        });

        $(window).on('load.payUGatewayDates', function () {
            if (typeof window.bootPayUGatewayDates === 'function') {
                window.bootPayUGatewayDates(0);
            } else {
                initPayUGatewayDatepickers();
            }
        });

        $('#SaveChargeGate').click(function () {
            var debitupto = $('#txtdebitupto').val();
            var debitabove = $('#txtdebitabove').val();
            var rupay = $('#txtrupay').val();
            var cc = $('#txtcrcard').val();
            var net = $('#txtnetbanking').val();
            var amex = $('#txtamex').val();
            var international = $('#txtinternational').val();
            var wallet = $('#txtwallet').val();
            var upi = $('#txtupi').val();
            $.ajax({
                url: '@Url.Action("AddGatewayCharge", "Home")',
                type: 'POST',
                data: {
                    txtdebitupto: debitupto,
                    txtdebitabove: debitabove,
                    txtrupay: rupay,
                    txtcrcard: cc,
                    txtnetbanking: net,
                    txtamex: amex,
                    txtinternational: international,
                    txtwallet: wallet,
                    txtupi: upi
                },
                success: function (response) {
                    $('#DLMTbl').html(response);
                    $('#txtdebitupto').val('');
                    $('#txtdebitabove').val('');
                    $('#txtrupay').val('');
                    $('#txtcrcard').val('');
                    $('#txtnetbanking').val('');
                    $('#txtamex').val('');
                    $('#txtinternational').val('');
                    $('#txtwallet').val('');
                    $('#txtupi').val('');
                },
                error: function (xhr, status, error) {
                    alert(error);
                }
            });
        });
    });
</script>
<script src="~/MainFrontDesign/js/admin-pay-u-gateway-dates.js?v=2"></script>
<script>
    (function retryPayUGatewayDates(attempt) {
        attempt = attempt || 0;
        if (typeof window.bootPayUGatewayDates === 'function') {
            window.bootPayUGatewayDates(0);
            return;
        }
        if (attempt < 200) {
            window.setTimeout(function () { retryPayUGatewayDates(attempt + 1); }, 50);
        }
    })();
</script>
