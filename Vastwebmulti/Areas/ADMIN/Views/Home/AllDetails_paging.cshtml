@model List<Vastwebmulti.Models.show_all_account_Result>
@{
    Layout = null;
}

@{
    var db = new Vastwebmulti.Models.VastwebmultiEntities();
    var virtualAmount = db.Remain_Admin_balance.FirstOrDefault()?.VirtualAmount;
}
@foreach (var item in Model)
{
    var isMismatch = item.total != virtualAmount;
    <tr class="@(isMismatch ? "saas-acc-row-mismatch" : "")">
        <td class="col-order">@item.id</td>
        <td class="col-details">@Html.DisplayFor(modelItem => item.details)</td>
        <td>@Html.DisplayFor(modelItem => item.totaladmin)</td>
        <td>@Html.DisplayFor(modelItem => item.totalsuper)</td>
        <td>@Html.DisplayFor(modelItem => item.totaldlm)</td>
        <td>@Html.DisplayFor(modelItem => item.totalrem)</td>
        <td>@item.posremain</td>
        <td>@Html.DisplayFor(modelItem => item.totalapi)</td>
        <td>@Html.DisplayFor(modelItem => item.totalwhitelabel)</td>
        <td class="col-total">@Html.DisplayFor(modelItem => item.total)</td>
        <td>@String.Format("{0:dd-MM-yyyy HH:mm}", item.tdate)</td>
    </tr>
}
