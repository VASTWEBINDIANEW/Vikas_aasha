<script>
    function openSuccessModal(trans_id, bank_trans_id, recivername, status) {

    $("#h_trans_id").val(trans_id);
    $("#h_bank_trans_id").val(bank_trans_id);
    $("#h_recivername").val(recivername);
    $("#h_status").val(status);

    $("#ddl_success_reason").val("");
    $("#success_securitypass").val("");

    $("#successModal").modal("show");
}

function confirmSuccess() {

    var ddl_refund = $("#ddl_success_reason").val();
    var securitypass = $("#success_securitypass").val();

    if (ddl_refund === "" || securitypass === "") {
        Swal.fire({
            icon: 'warning',
            title: 'Required',
            text: 'Please select success reason and enter security password'
        });
        return;
    }

    $.ajax({
        url: '@Url.Action("Moneysucess", "Home")',
        type: 'POST',
        dataType: 'json',
        beforeSend: function () {
            Swal.fire({
                title: "Processing...",
                allowOutsideClick: false,
                showConfirmButton: false,
                didOpen: () => Swal.showLoading()
            });
        },
        data: {
            trans_id: $("#h_trans_id").val(),
            bank_trans_id: $("#h_bank_trans_id").val(),
            recivername: $("#h_recivername").val(),
            currentstatus: $("#h_status").val(),
            ddl_refund: ddl_refund,
            securitypass: securitypass
        },
        success: function (response) {

            Swal.close(); // ✅ loader close here

            if (response.Status) {
                Swal.fire({
                    icon: 'success',
                    title: 'Success',
                    text: response.Message || 'Transaction marked as SUCCESS'
                }).then(() => {
                    $("#successModal").modal("hide");
                    location.reload();
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Failed',
                    text: response.Message || 'Something went wrong'
                }).then(() => {
                    $("#successModal").modal("hide");
                    location.reload();
                });
            }
        },
        error: function () {
            Swal.close();
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Server error occurred'
            });
        }
    });
}




</script>

