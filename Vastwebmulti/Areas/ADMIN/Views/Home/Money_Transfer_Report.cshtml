<script>
    var loading = false;
    function Dmt_status_check() {
        if (loading == true) return;

        $("#loadingdiv").show();
        loading = true;
        $.ajax({
            url: '@Url.Action("Dmt_status_check")',
            type: "GET",
            cache: false,
            success: function (data) {
                loading = false;
                fetchReport();
            }
        })
    }

    var inProgress = false;

    function fetchReport() {
        if (loading == true) return;

        inProgress = true;
        $("#loadingdiv").show();
        $.post("@Url.Action("InfiniteScroll1", "Home")",
            { "pageindex": 1, "txt_frm_date": $('#txt_frm_date').val(), "txt_to_date": $('#txt_to_date').val(), "ddlusers": ddlusers, "allmaster": allmaster, "alldealer": alldealer, "allretailer": allretailer, "Whitelabel": Whitelabel, "ddl_status": ddl_status, "allapiuser": allapiuser, "txtmob": txtmob, "ddl_Type": ddl_Type },
            function (data) {
                pageindex = 2;
                NoMoredata = data.NoMoredata;
                var html = data.HTMLString || '';
                if (html.indexOf('vm-opr-table-empty-row') !== -1) {
                    $("#trow").html(html);
                    NoMoredata = true;
                } else {
                    $("#trow").html(html);
                }
                if (window.vmDmtRenumberSr) { window.vmDmtRenumberSr(); }
                $("#loadingdiv").hide();
                inProgress = false;
            });
    }

</script>

<script type="text/javascript">
    function answers() {
        var e = document.getElementById("ddlusers");
        var answer = e.options[e.selectedIndex].value;
        var fields = ["allmaster", "dlm", "rem", "apiid", "whitelabelid"];
        fields.forEach(function (id) {
            document.getElementById(id).style.display = "none";
        });
        if (answer == "Dealer") {
            document.getElementById("dlm").style.display = "block";
        } else if (answer == "Master") {
            document.getElementById("allmaster").style.display = "block";
        } else if (answer == "Retailer") {
            document.getElementById("rem").style.display = "block";
        } else if (answer == "APIID") {
            document.getElementById("apiid").style.display = "block";
        } else if (answer == "WAdmin") {
            document.getElementById("whitelabelid").style.display = "block";
        }
    }
</script>

