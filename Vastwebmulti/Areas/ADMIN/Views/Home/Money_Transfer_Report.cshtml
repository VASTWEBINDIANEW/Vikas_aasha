<script>
function Failed() {
    var secuirtypass = $("#securitypass").val();
    var id = $("#txtrefidno").val();
    var bankid = $("#txtbankid").val();
    var recivername = $("#txtrecivername").val();
    var status = $("#txtstatus").val();
    var e = document.getElementById("ddl_refund");
    var ddlval = e.options[e.selectedIndex].value

    if (secuirtypass != "" && secuirtypass != null) {

        $.ajax({
            url: '@Url.Action("MoneyFailed", "Home")',
            type: 'POST',
            dataType: "html",
            beforeSend: function () {
                Swal.fire({
                    title: "Processing...",
                    html: "<b>Please wait</b><br>Your request is being processed",
                    allowOutsideClick: false,
                    background: "#ffffff",
                    color: "#333",
                    padding: "20px",
                    showConfirmButton: false,
                    customClass: {
                        popup: "swal-modern-box"
                    },
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });
            },
            data: {
                txtrefidno: id,
                bankid: bankid,
                recivername: recivername,
                ddl_refund: ddlval,
                secuirtypass: secuirtypass,
                currentstatus: status
            },
            success: function (data) {
                var response = JSON.parse(data);
                if (response.Status) {
                    window.location.reload();
                    reloadPageeee();
                }
                else {
                    alert(response.Message);
                }
            },
            complete: function () {
                Swal.close();
                $("#defaultModal1").modal('hide');
            }
        });
    }
}
</script>



