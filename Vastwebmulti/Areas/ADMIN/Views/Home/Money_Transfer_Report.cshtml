
@using Newtonsoft.Json;
@{
    ViewBag.Title = "Money_Transfer_Report";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<script src="~/MainFrontDesign/js/admin-financial-report.js?v=5"></script>
<script src="~/MainFrontDesign/js/admin-money-transfer-report.js?v=7"></script>

<div id="loadermoney" class="vm-dmt-loader" style="display:none;"></div>
<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page">
    <div class="container-fluid vm-opr-page-shell">

        @using (Html.BeginForm("Money_Transfer_Report", "Home", FormMethod.Post, new { id = "dmtReportForm", @class = "vm-rpt-filters-panel__form" }))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Financial Services</li>
                        <li>Money Transfer Report</li>
                    </ol>
                    <div class="vm-dmt-fin-nav-row">
                        @Html.Partial("_finicalmenureport")
                    </div>
                </div>
                

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="dmtTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Transaction totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideDmtTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Success</span>
                            <strong class="vm-opr-total-card__value" id="successtotal">—</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Failed</span>
                            <strong class="vm-opr-total-card__value" id="Failedtotal">—</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Pending</span>
                            <strong class="vm-opr-total-card__value" id="Pendingtotal">—</strong>
                        </div>
                    </div>
                </div>

                <div class="vm-rpt-filters-panel">
                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-rpt-filters-panel__bar">
                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("ddlusers", new List<SelectListItem>
                            {
                                new SelectListItem{ Text="All User",Value="Admin"},
                                new SelectListItem{Text="Master D",Value="Master"},
                                new SelectListItem{Text="Distributor",Value="Dealer"},
                                new SelectListItem{Text="Retailer",Value="Retailer"},
                                new SelectListItem{Text="Api User",Value="APIID"},
                                new SelectListItem{Text="Whitelabel",Value="WAdmin"}
                            }, new { @class = "vm-opr-select vm-dmt-select form-control", @title = "User type", @onchange = "answers()" })
                        </div>
                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("APINM", new List<SelectListItem>
                            {
                                new SelectListItem{ Text="All API",Value="ALL"},
                                new SelectListItem{Text="VASTWEB",Value="VASTWEB"},
                                new SelectListItem{Text="RADIANT",Value="RADIANT"},
                            }, new { @class = "vm-opr-select vm-dmt-select form-control", @title = "API" })
                        </div>
                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="allmaster" style="display:none;">
                            @Html.DropDownList("allmaster", ViewBag.allmaster as SelectList, "All Master", new { @class = "vm-opr-select vm-dmt-select form-control allmasters", @title = "Master" })
                        </div>
                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="dlm" style="display:none;">
                            @Html.DropDownList("alldealer", ViewBag.alldealer as SelectList, "All Distributor", new { id = "alldealer", @class = "vm-opr-select vm-dmt-select form-control", @title = "Distributor" })
                        </div>
                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="rem" style="display:none;">
                            @Html.DropDownList("allretailer", ViewBag.allretailer as SelectList, "All Retailer", new { id = "allretailer", @class = "vm-opr-select vm-dmt-select form-control", @title = "Retailer" })
                        </div>
                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="apiid" style="display:none;">
                            @Html.DropDownList("allapiuser", ViewBag.apiid as SelectList, "All API", new { id = "allapiuser", @class = "vm-opr-select vm-dmt-select form-control", @title = "API user" })
                        </div>
                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="whitelabelid" style="display:none;">
                            @Html.DropDownList("Whitelabel", ViewBag.whitelabel as SelectList, "Select Whitelabel", new { id = "Whitelabel", @class = "vm-opr-select vm-dmt-select form-control", @title = "Whitelabel" })
                        </div>
                        <div class="vm-opr-field vm-dmt-field" id="sts">
                            @Html.DropDownList("ddl_status", new List<SelectListItem>
                            {
                                new SelectListItem{ Text="All Status",Value="ALL"},
                                new SelectListItem{Text="Success",Value="SUCCESS"},
                                new SelectListItem{Text="Pending",Value="PENDING"},
                                new SelectListItem{Text="Failed",Value="FAILED"}
                            }, new { @class = "vm-opr-select vm-dmt-select form-control", @title = "Status" })
                        </div>
                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("ddl_Type", new List<SelectListItem>
                            {
                                new SelectListItem{ Text="Type",Value="ALL"},
                                new SelectListItem{Text="Account Transfer",Value="IMPS"},
                                new SelectListItem{Text="UPI Transfer",Value="UPI"},
                                new SelectListItem{Text="Paytm Wallet",Value="WALLET"},
                                new SelectListItem{Text="Verify",Value="IMPS_VERIFY"},
                                new SelectListItem{Text="Credit Card",Value="Credit Card"}
                            }, new { @class = "vm-opr-select vm-dmt-select form-control", @title = "Transfer type" })
                        </div>
                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("Category", new List<SelectListItem>
                            {
                                new SelectListItem{ Text="Category",Value="ALL"},
                                new SelectListItem{Text="PAYOUT E-KYC",Value="PAYOUT E-KYC"},
                                new SelectListItem{Text="DMT E-KYC",Value="DMT E-KYC"},
                                new SelectListItem{Text="PPI E-KYC",Value="PPI E-KYC"},
                                new SelectListItem{Text="DMT",Value="DMT"},
                                new SelectListItem{Text="PAYOUT",Value="PAYOUT"},
                                new SelectListItem{Text="PPI",Value="PPI"}
                            }, new { @class = "vm-opr-select vm-dmt-select form-control", @title = "Category" })
                        </div>
                        <div class="vm-dmt-filter-search-group">
                            <div class="vm-opr-field vm-dmt-field vm-dmt-field--search">
                                @Html.TextBox("txtmob", "", new { @class = "form-control vm-dmt-search-input", @placeholder = "Sender No. / Bank A/C", autocomplete = "off", @title = "Sender number or bank account" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" value="Old" name="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-exchange-alt" aria-hidden="true"></i>
                        <span>Money transfer transacti  ons</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn" title="Status Check" onclick="Dmt_status_check()"><i class="fas fa-sync-alt" aria-hidden="true"></i></button>
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn" onclick="findtotal()" title="Show totals" aria-expanded="false" aria-controls="dmtTotalsPanel"><i class="fas fa-chart-pie" aria-hidden="true"></i></button>
                            <button type="button" id="btnExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel"><i class="fas fa-file-excel" aria-hidden="true"></i> Excel</button>
                            <button type="button" id="btnPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF"><i class="fas fa-file-pdf" aria-hidden="true"></i> PDF</button>
                        </div>
                    </div>
                </div>
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="mmm" class="table vm-opr-data-table" cellspacing="0">
                    <thead>
                        <tr>
                            <th>S.R.</th>
                            <th>#&nbsp;User's&nbsp;Information</th>
                            <th>API Name</th>
                            <th>Mode/Req&nbsp;ID</th>
                            <th>Sender&nbsp;Number</th>
                            <th>Beneficiary&nbsp;A/C</th>
                            <th>Net&nbsp;T/F&nbsp;</th>
                            <th>User&nbsp;Pre&nbsp;₹&nbsp;</th>
                            <th>Debit&nbsp;₹&nbsp;</th>
                            <th>User&nbsp;Post&nbsp;₹</th>
                            <th>Api&nbsp;Bal</th>
                            <th>Request&nbsp;Time</th>
                            <th>Bank&nbsp;UTR</th>
                            <th><span data-toggle="tooltip" title="Success">Action</span></th>
                        </tr>
                    </thead>
                    <tbody id="trow">
                        @{
                            Html.RenderAction("_Money_TransferReport", "Home", new { Model = Model });
                        }
                    </tbody>
                </table>
                        <div id="loadingdiv" class="vm-opr-table-loading" style="display:none;">
                            <img src="~/img/ajax-loader.gif" alt="Loading" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

    <!--view modal popup-->
