<div class="modal-body saas-admin-modal-body">
    <input type="text" id="id" name="id" class="form-control" style="display:none;" />
    <input type="text" id="type" name="type" class="form-control" style="display:none;" />
    <input type="hidden" id="HD_frm_date" name="HD_frm_date" value="0" />
    <input type="hidden" id="HD_to_date" name="HD_to_date" value="0" />
    <label class="saas-search-user-label" for="txthighsec">Transaction password</label>
    <input type="password" autocomplete="new-password" id="txthighsec" name="txthighsec" class="form-control" required placeholder="Enter transaction password" />
    <label class="saas-search-user-label" for="txtcomment" style="margin-top:12px;">Comment</label>
    <textarea id="txtcomment" name="txtcomment" class="form-control" required placeholder="Enter comment"></textarea>
    <label id="errormsgshow" class="text-danger" style="margin-top:8px;"></label>
</div>
<div class="saas-admin-modal-footer">
    <button type="button" class="saas-admin-btn saas-admin-btn-secondary" data-dismiss="modal">Cancel</button>
    <button type="submit" class="saas-admin-btn saas-admin-btn-primary">Save Change</button>
</div>
