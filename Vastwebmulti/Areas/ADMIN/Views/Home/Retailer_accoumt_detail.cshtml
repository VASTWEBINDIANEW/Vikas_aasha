@model IEnumerable<Vastwebmulti.Models.retailer_Reamin_Cr_report_Result>
@using System.Linq
@{
    ViewBag.Title = "Retailer_accoumt_detail";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var rows = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.retailer_Reamin_Cr_report_Result>();
    var sumBalance = rows.Sum(aa => aa.remainbal ?? 0m);
    var sumPos = rows.Sum(aa => aa.posbalance ?? 0m);
    var sumAdminCredit = rows.Sum(aa => aa.cr);
    var sumDistCredit = rows.Sum(aa => aa.cr1);
    var combinedBalance = sumBalance + sumPos;
    var rowCount = rows.Count;
    Func<decimal, string> fmt = v => v.ToString("N2");
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />

<section class="content fourdesign-section-admin saas-admin-account-page">
    <div class="container-fluid">

        
        <div class="saas-acc-toolbar">
            <ol class="saas-acc-breadcrumb">
                <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                <li>Retailer Account's Balance</li>
            </ol>
            <div class="saas-acc-toolbar-right">
                <div class="saas-acc-search">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    <input class="form-control" id="myInput" type="text" placeholder="Search firm, retailer, mobile..." autocomplete="off" />
                </div>
                <div class="saas-acc-export-group">
                    <button type="button" class="saas-acc-btn saas-acc-btn--excel" id="btnExport" onclick="excel()">
                        <i class="fas fa-file-excel" aria-hidden="true"></i> Export
                    </button>
                    <button type="button" class="saas-acc-btn saas-acc-btn--pdf" id="btnPDF" onclick="PDF()">
                        <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                    </button>
                </div>
            </div>
        </div>

        
        <div class="saas-acc-table-card" id="retailerAccountExport">
            <div class="saas-acc-table-card-head">
                <h3>Retailer balance report</h3>
                <span class="saas-acc-row-count"><i class="fas fa-list" aria-hidden="true"></i> @rowCount records</span>
            </div>
            <div class="saas-acc-table-wrap table-responsive">
                <table id="dtBasicExample" class="table saas-acc-table example-second third-design-table">
                    <thead>
                        <tr>
                            <th class="col-sr">Sr</th>
                            <th class="col-text">Retailer Firm</th>
                            <th class="col-text">Dealer Firm</th>
                            <th class="col-text">Retailer Name</th>
                            <th>Registered No.</th>
                            <th>Account Balance</th>
                            <th>POS Balance</th>
                            <th>Admin Credit</th>
                            <th>Distributor Credit</th>
                        </tr>
                        <tr class="saas-acc-subtotal-row third-tr-color">
                            <th colspan="5" class="col-text">Sub Total</th>
                            <th class="col-balance">₹@fmt(sumBalance)</th>
                            <th class="col-pos">₹@fmt(sumPos)</th>
                            <th class="col-credit">₹@fmt(sumAdminCredit)</th>
                            <th class="col-mdcredit">₹@fmt(sumDistCredit)</th>
                        </tr>
                    </thead>
                    <tbody id="body">
                        @{ var sr = 1; }
                        @foreach (var item in rows)
                        {
                            <tr>
                                <td class="col-sr" data-label="Sr">@sr</td>
                                <td class="col-text" data-label="Retailer Firm">@item.Frm_Name</td>
                                <td class="col-text" data-label="Dealer Firm">@item.FarmName</td>
                                <td class="col-text" data-label="Retailer Name">@item.RetailerName</td>
                                <td data-label="Registered No.">@item.Mobile</td>
                                <td class="col-balance" data-label="Account Balance">@((item.remainbal ?? 0m).ToString("N2"))</td>
                                <td class="col-pos" data-label="POS Balance">@((item.posbalance ?? 0m).ToString("N2"))</td>
                                <td class="col-credit" data-label="Admin Credit">@item.cr.ToString("N2")</td>
                                <td class="col-mdcredit" data-label="Distributor Credit">@item.cr1.ToString("N2")</td>
                            </tr>
                            sr++;
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</section>

<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.22/pdfmake.min.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.4.1/html2canvas.min.js"></script>
<script>
    function excel() {
        location.href = '@Url.Action("ExportToExcel_to_Retailer", "Home")';
    }

    function PDF() {
        var el = document.getElementById('retailerAccountExport');
        if (!el || typeof html2canvas === 'undefined') return;
        html2canvas(el, {
            onrendered: function (canvas) {
                var data = canvas.toDataURL();
                pdfMake.createPdf({
                    content: [{ image: data, width: 500 }]
                }).download('Retailer_remain_balance.pdf');
            }
        });
    }

    $(document).ready(function () {
        if ($.fn.DataTable && $('#dtBasicExample').length) {
            $('#dtBasicExample').DataTable({
                orderCellsTop: true,
                paging: false,
                searching: false,
                info: false
            });
        }

        $('#myInput').on('keyup', function () {
            var value = $(this).val().toLowerCase();
            $('#body tr').filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
            });
        });
    });
</script>
