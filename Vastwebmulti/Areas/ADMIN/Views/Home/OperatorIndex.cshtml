<script>
    (function ($) {
        var $page = $('.OperatorIndex_Page');
        var historyPanels = '.for-Distributor, .for-Retailer, .for-White-Label, .for-Api-User';

        function oiGetVisiblePanel() {
            var $hist = $page.find('.oi-history-active').first();
            if ($hist.length) return $hist;
            var $tab = $page.find('.tab-content2.current2').first();
            if ($tab.length) return $tab;
            return $page.find('.tab-content2').first();
        }

        function oiFilterTables(term) {
            var q = (term || '').toLowerCase().trim();
            var $panel = oiGetVisiblePanel();
            $panel.find('table tbody tr').each(function () {
                var text = $(this).text().toLowerCase();
                $(this).toggle(q === '' || text.indexOf(q) > -1);
            });
        }

        function oiUpdateRightTitle() {
            var title = 'Operator Services';
            var $activeHist = $page.find('.oi-history-active').first();
            if ($activeHist.length) {
                if ($activeHist.hasClass('for-Retailer')) title = 'Retailer Blocked History';
                else if ($activeHist.hasClass('for-Distributor')) title = 'Distributor Blocked History';
                else if ($activeHist.hasClass('for-White-Label')) title = 'White Label Blocked History';
                else if ($activeHist.hasClass('for-Api-User')) title = 'API User Blocked History';
            } else {
                var $active = $('#oi-right-tabs li.current2').first();
                title = $active.data('title') || $.trim($active.text()) || title;
            }
            $('#oiRightPanelTitle').text(title);
        }

        function oiRefreshSearch() {
            oiUpdateRightTitle();
            oiFilterTables($('#txtsearch').val());
        }

        window.oiCloseHistory = function () {
            $page.removeClass('oi-history-open');
            $page.find(historyPanels).removeClass('oi-history-active').attr('style', 'display:none;');
            // Restore operator tabs/content in case any legacy code hid them inline
            $page.find('.oprindex-right #oi-right-tabs').removeAttr('style');
            $page.find('.oprindex-right .tab-content2').removeAttr('style');
            oiRefreshSearch();
        };

        window.oiOpenHistory = function (panelSelector) {
            $page.find(historyPanels).removeClass('oi-history-active').attr('style', 'display:none;');
            $page.addClass('oi-history-open');
            $page.find(panelSelector).addClass('oi-history-active').removeAttr('style');
            oiRefreshSearch();
            if (window.matchMedia('(max-width: 991px)').matches) {
                var $target = $page.find('.vm-ft-history-col');
                if ($target.length) {
                    $('html, body').animate({ scrollTop: $target.offset().top - 72 }, 280);
                }
            }
        };

        window.PrePaidTabeOpen = function () {
            oiCloseHistory();
        };

        window.UtilityTabeOpen = function () {
            oiCloseHistory();
        };

        window.oiRefreshSearch = oiRefreshSearch;

        function oiScheduleHistoryOpen(panelSelector) {
            setTimeout(function () {
                if (window.oiOpenHistory) window.oiOpenHistory(panelSelector);
            }, 0);
        }

        function oiSwitchLeftTab($li) {
            var tabId = $li.attr('data-tab');
            if (!tabId) return;
            oiCloseHistory();
            $('#oi-left-tabs li').removeClass('current');
            $page.find('.oprindex-left > .op-c > .tab-content').removeClass('current').removeAttr('style');
            $li.addClass('current');
            $page.find('.oprindex-left #' + tabId).addClass('current').removeAttr('style');
        }

        function oiSwitchRightTab($li) {
            var tabId = $li.attr('data-tab');
            if (!tabId) return;
            oiCloseHistory();
            $('#oi-right-tabs li').removeClass('current2');
            $page.find('.oprindex-right .tab-content2').removeClass('current2').removeAttr('style');
            $li.addClass('current2');
            $page.find('.oprindex-right #' + tabId).addClass('current2').removeAttr('style');
            setTimeout(oiRefreshSearch, 40);
        }

        $(function () {
            $('#txtsearch').on('input', function () {
                oiFilterTables($(this).val());
            });

            $(document).on('click', '#oi-left-tabs li', function (e) {
                e.preventDefault();
                oiSwitchLeftTab($(this));
            });

            $(document).on('click', '#oi-right-tabs li', function (e) {
                e.preventDefault();
                oiSwitchRightTab($(this));
            });

            $(document).on('click', '.OperatorIndex_Page .first-botton', function () {
                var $delete = $(this);
                var $confirm = $delete.siblings('.second-button');
                $delete.hide();
                $confirm.removeClass('oi-delete-hidden').addClass('oi-delete-confirm').show();
            });

            $(document).on('click', '.OperatorIndex_Page button.for-Distr', function (e) {
                oiScheduleHistoryOpen('.for-Distributor');
            });
            $(document).on('click', '.OperatorIndex_Page button.for-Reta', function (e) {
                oiScheduleHistoryOpen('.for-Retailer');
            });
            $(document).on('click', '.OperatorIndex_Page button.for-Whi-Lab', function (e) {
                oiScheduleHistoryOpen('.for-White-Label');
            });
            $(document).on('click', '.OperatorIndex_Page button.for-ap-us', function (e) {
                oiScheduleHistoryOpen('.for-Api-User');
            });

            // If a history form submits (AJAX or normal), ensure the correct panel is opened
            $(document).on('submit', '.OperatorIndex_Page form', function () {
                var $btn = $(document.activeElement);
                if (!$btn || !$btn.length) return;
                if ($btn.hasClass('for-Distr')) oiScheduleHistoryOpen('.for-Distributor');
                else if ($btn.hasClass('for-Reta')) oiScheduleHistoryOpen('.for-Retailer');
                else if ($btn.hasClass('for-Whi-Lab')) oiScheduleHistoryOpen('.for-White-Label');
                else if ($btn.hasClass('for-ap-us')) oiScheduleHistoryOpen('.for-Api-User');
            });
            $(document).on('click', '.OperatorIndex_Page .oi-history-close-btn, .OperatorIndex_Page .for-un .close-button', function (e) {
                e.preventDefault();
                e.stopPropagation();
                if (window.oiCloseHistory) {
                    window.oiCloseHistory();
                }
                return false;
            });

            oiRefreshSearch();

            $('.OperatorIndex_Page .table .second-button').addClass('oi-delete-hidden');

            if (typeof window.oiInitOperatorIndexSelects === 'function') {
                window.oiInitOperatorIndexSelects('.OperatorIndex_Page');
            }
        });
    })(jQuery);
</script>