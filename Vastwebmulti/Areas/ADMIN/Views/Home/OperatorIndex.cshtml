<script>
    var j = $.noConflict();

    function oiDestroySelect2($el) {
        if (!$.fn.select2 || !$el || !$el.length) {
            return;
        }
        try {
            if ($el.hasClass('select2-hidden-accessible')) {
                $el.select2('destroy');
            }
        } catch (e) { }
    }

    window.oiInitOperatorIndexSelects = function (root) {
        var $root = root ? $(root) : $('.OperatorIndex_Page');
        var $modal = $root.hasClass('modal') ? $root : $root.closest('.modal');
        var inModal = $modal.length > 0;
        var dropdownParent = inModal ? $modal : $(document.body);

        if ($.fn.selectpicker) {
            $root.find('select.selectpicker').each(function () {
                var $s = $(this);
                oiDestroySelect2($s);

                if ($s.data('selectpicker')) {
                    // Ensure button reflects latest options/state
                    try { $s.selectpicker('refresh'); } catch (e) { }
                    return;
                }

                // Always render dropdown in body (reliable), we handle z-index in CSS.
                $s.selectpicker({
                    liveSearch: true,
                    container: $s.data('container') || 'body',
                    dropupAuto: false,
                    width: '100%'
                });
            });
        }

        if ($.fn.select2) {
            $root.find('select').not('.selectpicker').not('.oi-modal-native-select').each(function () {
                var $el = $(this);
                if (inModal) {
                    // Ensure dropdownParent is the modal for proper stacking
                    oiDestroySelect2($el);
                } else if ($el.hasClass('select2-hidden-accessible')) {
                    return;
                }

                $el.select2({
                    width: '100%',
                    dropdownParent: dropdownParent,
                    minimumResultsForSearch: $el.find('option').length > 8 ? 0 : Infinity
                });
            });
        }
    };

    $(function () {
        oiInitOperatorIndexSelects('.OperatorIndex_Page');
    });

    $(document).on('shown.bs.modal', '.oi-modern-modal', function () {
        oiInitOperatorIndexSelects(this);
    });

    function BlockRetailer(result) {
        // $('select').select2().val('');
        if (result == 1) {
            j('#operatorsselect').hide();
            j('#servpro').hide();

            // Reset selects safely (Select2 v4 doesn't support select2("val", ...))
            try {
                j("#rem").val('').trigger('change');
                j('#RequireCategory').val('').trigger('change');
            } catch (e) {
                try {
                    j("#rem").val('');
                    j('#RequireCategory').val('');
                } catch (e2) { }
            }
            if (window.oiOpenHistory) {
                window.oiOpenHistory('.for-Retailer');
            }
        }
    }
</script>

