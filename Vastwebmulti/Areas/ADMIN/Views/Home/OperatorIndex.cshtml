    function oiBuildBlockAmountRow(b) {
        var user = b.User == null ? 'All' : b.User;
        var optEnc = encodeURI(b.OperatorName);
        var statusHtml = '';

        if (b.status == "Y") {
            statusHtml = "<td><div class='onoffswitch'><span class='costom-on' onclick=\"BlockAmountStatusUpdate('" + b.idno + "','" + optEnc + "','Y')\">on</span></div></td>";
        } else if (b.status == "N") {
            statusHtml = "<td><div class='onoffswitch'><span class='custom-off' onclick=\"BlockAmountStatusUpdate('" + b.idno + "','" + optEnc + "','N')\">off</span></div></td>";
        } else {
            statusHtml = "<td>-</td>";
        }

        return "<tr>" +
            "<td class='oi-ba-amount'>" + b.Amount + "</td>" +
            "<td class='oi-ba-user'>" + user + "</td>" +
            statusHtml +
            "<td class='oi-ba-del'><button type='button' class='oi-ba-delete-btn' title='Delete' aria-label='Delete' onclick=\"BlockAmountStatusDelete('" + b.idno + "','" + optEnc + "')\"><i class='fa fa-trash' aria-hidden='true'></i></button></td>" +
            "</tr>";
    }

    function oiRenderBlockAmountTable(result) {
        var tblHtml = "";

        if (result && result.length > 0) {
            $.each(result, function (a, b) {
                tblHtml += oiBuildBlockAmountRow(b);
            });
        } else {
            tblHtml = "<tr><td colspan='4' class='oi-ba-empty'>No blocked amounts found.</td></tr>";
        }

        $("#blockamounttable > tbody").html(tblHtml);
    }

