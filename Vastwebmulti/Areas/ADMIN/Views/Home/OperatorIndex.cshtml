                             tblHtml += "<td>  <center><img src='../../images/reportimage/switch_on.png' onclick=APIUSERstatusupdate('" + b.id + "','" + b.APIID + "','" + encodeURI(b.Operator_type) + "') style='margin-top:2px;height:23px;' /></center></td></tr>";
