
@model Vastwebmulti.Areas.ADMIN.Models.prepaid_card1

    <input id="btnsubmitusercommon" type="button" onclick="updatecommpc()" name="Button" value="Save Data" class="btn waves-effect vm-pg-slab-save-btn" style="display:none;" />
    <input id="btnsubmit" type="button" value="Save Now" class="btn waves-effect vm-pg-slab-save-btn" style="display:none;" />

    <div class="vm-pg-slab-table-scroll saas-acc-table-wrap vm-prepaid-slab-table-wrap">
        <table id="prepaidCardSlabTable" class="table table-bordered vm-pg-slab-table third-design-table slab-table example-second">
            <thead>
                <tr>
                    <th>Retailer&nbsp;%</th>
                    <th>Distributor&nbsp;%</th>
                    <th>Master&nbsp;%</th>
                </tr>
            </thead>
            <tbody id="tbodyshow" class="vm-pg-slab-tbody--view">
                @foreach (var item in Model.common_common)
                {
                    <tr>
                        <td id="text11">@item.rem_comm</td>
                        <td class="text-center" id="text12">@item.dlm_comm</td>
                        <td class="text-center" id="text13">@item.master_comm</td>
                    </tr>
                }
            </tbody>
            <tbody id="tbodyedit" class="vm-pg-slab-tbody--hidden">
                @for (int i = 0; i < Model.common_common.Count; i++)
                {
                    <tr>
                        @Html.HiddenFor(a => a.common_common[i].idno)
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.common_common[i].rem_comm, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input", id = "remcom" } })
                            @Html.ValidationMessageFor(a => a.common_common[i].rem_comm)
                        </td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.common_common[i].dlm_comm, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input", id = "dlmcom" } })
                            @Html.ValidationMessageFor(a => a.common_common[i].dlm_comm)
                        </td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.common_common[i].master_comm, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input", id = "mastercomm" } })
                            @Html.ValidationMessageFor(a => a.common_common[i].master_comm)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

<script>
    function updatecommpc() {
        var rmcom = $('#remcom').val();
        var dlmcomc = $('#dlmcom').val();
        var masterccomm = $('#mastercomm').val();
        $.ajax({
            url: '@Url.Action("updatesetpccommcommon", "Home")',
            type: 'POST',
            data: { remcom: rmcom, dlmcom: dlmcomc, mastercomm: masterccomm },
            dataType: "JSON"
        });
        if (typeof resetSlabViewMode === 'function') {
            resetSlabViewMode();
        } else {
            $('#btnsubmitusercommon').hide().removeClass('is-visible');
            $('#btnEdit').show().removeClass('is-hidden');
            $('#tbodyshow').removeClass('vm-pg-slab-tbody--hidden').addClass('vm-pg-slab-tbody--view');
            $('#tbodyedit').addClass('vm-pg-slab-tbody--hidden');
        }
        document.getElementById('text11').innerHTML = rmcom;
        document.getElementById('text12').innerHTML = dlmcomc;
        document.getElementById('text13').innerHTML = masterccomm;
    }
</script>
