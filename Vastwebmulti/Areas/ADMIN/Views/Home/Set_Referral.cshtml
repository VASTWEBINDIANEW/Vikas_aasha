@model IEnumerable<Vastwebmulti.Areas.ADMIN.ViewModel.RefferalListViewModel>
@{
    ViewBag.Title = "Set Referral";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-fund-transfer-modern.css?v=27" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-fund-transfer-mobile.css?v=23" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-master-list-modern.css?v=19" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-api-user-page.css?v=7" rel="stylesheet" />

<section class="content Set_Referral_Page New_Employee_Page saas-admin-account-page saas-admin-report-page saas-fund-transfer-page saas-fund-user-page saas-master-list-page saas-fund-transfer-premium">

    <div class="container-fluid vm-ft-page-shell">

        <!-- Toolbar -->
        <div class="vm-ft-page-toolbar vm-ft-page-toolbar--premium">
            <div class="vm-ft-page-hero">
                <ol class="vm-ft-breadcrumb">
                    <li><a href="@Url.Action("Dashboard","Home")"><i class="fas fa-home"></i> Dashboard</a></li>
                    <li>User's &amp; Account</li>
                    <li>Set/Exit Referral Earn</li>
                </ol>
            </div>
            <div class="vm-ft-search-wrap sr-toolbar-actions">
                <div id="refferalsetinpartial" class="sr-perm-wrap">
                    @Html.Action("_RefferalSettingpage")
                </div>
                <a href="@Url.Action("daywisecomm", "Home")" class="sr-toolbar-link" title="Extra Commission Status">
                    <i class="fas fa-chart-line"></i> Extra Comm Status
                </a>
                <a href="@Url.Action("daywisecommhistory", "Home")" class="sr-toolbar-link" title="Extra Commission History">
                    <i class="fas fa-history"></i> Extra Comm History
                </a>
                <div class="sr-info-wrap">
                    <i class="fas fa-info-circle sr-info-icon" title="Set Referral Earn"></i>
                    <div class="sr-info-tip">Set Referral Earn</div>
                </div>
            </div>
        </div>

        <!-- Two-column layout -->
        <div class="col-md-12 vm-ft-layout-wrap">
            <div class="row clearfix vm-ft-layout vm-ft-layout--full">

                <!-- LEFT: Referral Setting Form -->
                <div class="col-md-4 col-sm-12 vm-ft-form-col">
                    <div class="fund-trasfer-left fund-user-left vm-ft-form-card">

                        <div class="vm-ft-form-card-header">
                            <div class="vm-ft-form-card-header__icon"><i class="fas fa-user-friends"></i></div>
                            <div>
                                <span class="vm-ft-form-card-header__title">Referral Setting</span>
                                <span class="vm-ft-form-card-header__sub">Configure referral earn rules</span>
                            </div>
                        </div>

                        <div class="sr-form-body">
                            <form id="newsletter-form" method="post" onsubmit="return srSubmitForm(event)" novalidate>
                                <div class="sr-field">
                                    <label>Referral Type</label>
                                    <select id="changereferraltype" name="changereferraltype" class="form-control sr-input" onchange="changereferral(this)" required>
                                        <option value="1">Purchases Basis</option>
                                        <option value="2">Business Basis</option>
                                    </select>
                                </div>

                                <div class="purchase-basis purchase-basis1">
                                    <div class="sr-field">
                                        <label id="lblminlimit">Minimum Purchase Limit</label>
                                        <input id="txtminimiumpurchase" name="txtminimiumpurchase" type="number" class="form-control sr-input" required placeholder="Enter Amount" />
                                    </div>
                                </div>

                                <div class="business-basis" style="display:none;">
                                    <div class="sr-field">
                                        <label>Category</label>
                                        <select id="catetype" name="catetype" class="form-control sr-input">
                                            <option value="Prepaid/DTH">Prepaid/DTH</option>
                                            <option value="Utilities">Utilities</option>
                                            <option value="Financial">Financial</option>
                                            <option value="Travel/Hotel">Travel &amp; Hotel</option>
                                            <option value="Ecommerce">Ecommerce</option>
                                            <option value="Service/Repair">Service &amp; Repair</option>
                                            <option value="Other">Other</option>
                                        </select>
                                    </div>
                                </div>

                                <div class="sr-field">
                                    <label>Expiry No. Of Days</label>
                                    <input type="number" id="txtexpnoofday" name="txtexpnoofday" class="form-control sr-input" required placeholder="Enter Days" />
                                </div>

                                <div class="sr-field">
                                    <label>Sharing Type</label>
                                    <select id="ddlsharingtype" name="ddlsharingtype" class="form-control sr-input" required>
                                        <option value="Percentage">(%) Percentage</option>
                                        <option value="FixRupees">Fix Rupees</option>
                                    </select>
                                </div>

                                <div class="sr-field purchase-type">
                                    <label>Purchasing Type</label>
                                    <select id="ddlReferalcode" name="ddlReferalcode" class="form-control sr-input" required>
                                        <option value="SinglePurchasing">First Purchasing</option>
                                        <option value="MultiplePurchasing">Multiple Purchasing</option>
                                    </select>
                                </div>

                                <div class="sr-field">
                                    <label>Sharing Value</label>
                                    <input type="number" id="txtSharingValue" name="txtSharingValue" step="0.01" class="form-control sr-input" required placeholder="Enter Value" />
                                </div>

                                <div class="sr-form-footer">
                                    <label id="lblmsg" class="sr-msg"></label>
                                    <div class="sr-form-btns">
                                        <button type="reset" class="ne-btn-reset">
                                            <i class="fas fa-times"></i> Cancel
                                        </button>
                                        <button type="submit" id="btnshowdetails" class="ne-btn-submit">
                                            <i class="fas fa-check"></i> Submit
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>

                    </div>
                </div>
                <!-- END LEFT -->

                <!-- RIGHT: Referral Detail & History -->
                <div class="col-md-8 col-sm-12 fund-transfer-main-admin vm-ft-history-col">
                    <div class="fund-trasfer-right fund-user-right vm-ft-history-panel">
                        <div class="vm-ft-history-body">

                            <div class="vm-ft-history-toolbar vm-ft-history-toolbar--premium vm-ml-list-toolbar">
                                <div class="vm-ml-list-toolbar__row rc-right-toolbar-row">
                                    <div class="rc-right-tabs">
                                        <button type="button" class="au-tab-btn active" id="sr-rtab-detail"
                                                onclick="srRightTab('sr-rpanel-detail','sr-rtab-detail')">
                                            <i class="fas fa-list-alt"></i> Referral Set Detail
                                        </button>
                                        <button type="button" class="au-tab-btn" id="sr-rtab-achieve"
                                                onclick="srRightTab('sr-rpanel-achieve','sr-rtab-achieve'); srLoadAchieve();">
                                            <i class="fas fa-trophy"></i> Referral Achievement History
                                        </button>
                                        <button type="button" class="au-tab-btn" id="sr-rtab-unachieve"
                                                onclick="srRightTab('sr-rpanel-unachieve','sr-rtab-unachieve'); srLoadUnachieve();">
                                            <i class="fas fa-clock"></i> Referral Unachieved History
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Tab 1: Referral Set Detail -->
                            <div id="sr-rpanel-detail" class="rc-right-panel rc-right-panel--active">
                                <div id="home" class="sr-detail-wrap">
                                    <div class="sr-note">
                                        <i class="fas fa-exclamation-circle"></i>
                                        <span><b>NOTE:</b> Referrals can be given only in one way. If you want to set another method, you must remove the former.</span>
                                    </div>

                                    <div class="sr-type-grid">
                                        <!-- Purchases Basis -->
                                        <div class="sr-type-card" id="purchasetype" style="display:none;">
                                            <div class="sr-type-card__head">
                                                <i class="fas fa-shopping-cart"></i> Purchases Basis
                                                <div id="Statussetting" class="sr-status-btns">
                                                    <fieldset class="firstf fff" id="purchgreen" style="display:none;">
                                                        <button data-id="" onclick="Chkstatusonoffpurch('Purchases Basis',true)" type="button" class="sr-status-btn sr-status-btn--active">
                                                            <i class="fas fa-check-circle"></i> Active
                                                        </button>
                                                    </fieldset>
                                                    <fieldset class="secondf sss" id="purchred" style="display:none;">
                                                        <button data-id="" onclick="Chkstatusonoffpurch('Purchases Basis',false)" type="button" class="sr-status-btn sr-status-btn--inactive">
                                                            <i class="fas fa-times-circle"></i> Deactive
                                                        </button>
                                                    </fieldset>
                                                </div>
                                            </div>
                                            <ul class="sr-detail-list ulpurchaseshow">
                                                <li><span>Minimum Limit</span><strong id="spnbusneww"></strong></li>
                                                <li><span>Expiry No. Of Days</span><strong id="expnoofday"></strong></li>
                                                <li><span>Sharing Type</span><strong id="spansharingtypes"></strong></li>
                                                <li><span>Sharing Value</span><strong id="spnsharingvalue"></strong></li>
                                                <li><span>Repeat</span><strong id="spntotalsharingvalue"></strong></li>
                                            </ul>
                                            <ul class="sr-detail-list sr-detail-list--edit ulpurchasenotshow" style="display:none;">
                                                <li><span>Minimum Limit</span><input type="text" id="txtpurchaselimit" name="txtpurchaselimit" class="form-control sr-input-sm" /></li>
                                                <li><span>Expiry No. Of Days</span><input type="text" id="txtpurchasenoofday" name="txtpurchasenoofday" class="form-control sr-input-sm" /></li>
                                                <li>
                                                    <span>Sharing Type</span>
                                                    <select id="ddlpurchsharingtype" name="ddlpurchsharingtype" class="form-control sr-input-sm" required>
                                                        <option value="Percentage">(%) Percentage</option>
                                                        <option value="FixRupees">Fix Rupees</option>
                                                    </select>
                                                </li>
                                                <li><span>Sharing Value</span><input type="text" id="txtpurchassharingvlaue" name="txtpurchassharingvlaue" class="form-control sr-input-sm" /></li>
                                                <li><span>Repeat</span><input type="number" max="12" id="txtpurchastotalsharingvalue" name="txtpurchastotalsharingvalue" class="form-control sr-input-sm" /></li>
                                            </ul>
                                            <div class="sr-card-actions ulpurchaseshow">
                                                <button type="button" id="btneditdatapurchase" data-href="Purchases Basis" class="ne-btn-reset" onclick="srEditPurchase()">
                                                    <i class="fas fa-edit"></i> Edit
                                                </button>
                                                <button type="button" id="btnDeletepur" onclick="DeleteRefferedCode('Purchases Basis')" class="ne-btn-submit sr-btn-danger">
                                                    <i class="fas fa-trash"></i> Delete
                                                </button>
                                            </div>
                                            <div class="sr-card-actions ulpurchasenotshow" style="display:none">
                                                <button type="button" id="btneditdatapurchaseedit" data-href="Purchases Basis" class="ne-btn-submit" onclick="srSavePurchase()">
                                                    <i class="fas fa-save"></i> Save
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Business Basis -->
                                        <div class="sr-type-card" id="busnesstype" style="display:none;">
                                            <div class="sr-type-card__head">
                                                <i class="fas fa-briefcase"></i> Business Basis
                                                <div id="Statussettingbuss" class="sr-status-btns">
                                                    <fieldset class="firstf fff" id="busnessgreen" style="display:none;">
                                                        <button data-id="" onclick="Chkstatusonoff('business Basis',true)" type="button" class="sr-status-btn sr-status-btn--active">
                                                            <i class="fas fa-check-circle"></i> Active
                                                        </button>
                                                    </fieldset>
                                                    <fieldset class="secondf sss" id="busnessred" style="display:none">
                                                        <button data-id="" onclick="Chkstatusonoff('business Basis',false)" type="button" class="sr-status-btn sr-status-btn--inactive">
                                                            <i class="fas fa-times-circle"></i> Deactive
                                                        </button>
                                                    </fieldset>
                                                </div>
                                            </div>
                                            <ul class="sr-detail-list ulbussnessshow">
                                                <li><span>Minimum Business</span><strong id="bussminlimit"></strong></li>
                                                <li><span>Category</span><strong id="spncategry"></strong></li>
                                                <li><span>Expiry No. Of Days</span><strong id="bussnoofday"></strong></li>
                                                <li><span>Sharing Type</span><strong id="busssharingtype"></strong></li>
                                                <li><span>Sharing Value</span><strong id="busssharingvalue"></strong></li>
                                                <li><span>Repeat</span><strong id="spntotalbusness"></strong></li>
                                            </ul>
                                            <ul class="sr-detail-list sr-detail-list--edit ulbussnessnotshow" style="display:none;">
                                                <li><span>Minimum Business</span><input type="text" id="txtbusslimit" name="txtbusslimit" class="form-control sr-input-sm" /></li>
                                                <li>
                                                    <span>Category</span>
                                                    <select id="busscatetype" name="busscatetype" class="form-control sr-input-sm">
                                                        <option value="Prepaid/DTH">Prepaid/DTH</option>
                                                        <option value="Utilities">Utilities</option>
                                                        <option value="Financial">Financial</option>
                                                        <option value="Travel/Hotel">Travel &amp; Hotel</option>
                                                        <option value="Ecommerce">Ecommerce</option>
                                                        <option value="Service/Repair">Service &amp; Repair</option>
                                                        <option value="Other">Other</option>
                                                    </select>
                                                </li>
                                                <li><span>Expiry No. Of Days</span><input type="text" id="txtbusnessnoofday" name="txtbusnessnoofday" class="form-control sr-input-sm" /></li>
                                                <li>
                                                    <span>Sharing Type</span>
                                                    <select id="ddlbusnesssharingtype" name="ddlbusnesssharingtype" class="form-control sr-input-sm" required>
                                                        <option value="Percentage">(%) Percentage</option>
                                                        <option value="FixRupees">Fix Rupees</option>
                                                    </select>
                                                </li>
                                                <li><span>Sharing Value</span><input type="text" id="txtbusnessssharingvlaue" name="txtbusnessssharingvlaue" class="form-control sr-input-sm" /></li>
                                                <li><span>Repeat</span><input type="number" maxlength="1" id="txtbusnessstotalcount" name="txtbusnessstotalcount" class="form-control sr-input-sm" /></li>
                                            </ul>
                                            <div class="sr-card-actions ulbussnessshow">
                                                <button type="button" id="btneditbusness" data-href="business Basis" class="ne-btn-reset" onclick="srEditBusiness()">
                                                    <i class="fas fa-edit"></i> Edit
                                                </button>
                                                <button type="button" id="btnshowdetails123" onclick="DeleteRefferedCode('business Basis')" class="ne-btn-submit sr-btn-danger">
                                                    <i class="fas fa-trash"></i> Delete
                                                </button>
                                            </div>
                                            <div class="sr-card-actions ulbussnessnotshow" style="display:none">
                                                <button type="button" id="btneditdataBusnessedit" data-href="business Basis" class="ne-btn-submit" onclick="srSaveBusiness()">
                                                    <i class="fas fa-save"></i> Save
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Tab 2: Achievement History -->
                            <div id="sr-rpanel-achieve" class="rc-right-panel" style="display:none;">
                                <div id="menu1">
                                    <div class="rc-table-cover">
                                        <div class="rc-table-scroll rc-table-scroll--tab">
                                            <table class="table table-bordered rc-inner-table">
                                                <thead>
                                                    <tr>
                                                        <th>Benefit Holder</th>
                                                        <th>Referral Type</th>
                                                        <th>Got Benefit</th>
                                                        <th>Received Date</th>
                                                        <th>Referral User</th>
                                                        <th>Achieved Time</th>
                                                        <th>Achieved Amount</th>
                                                        <th>Sharing Type</th>
                                                        <th>Sharing Value</th>
                                                        <th>Pre &#8377;</th>
                                                        <th>Post &#8377;</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="mydivchange">
                                                    <tr id="loads" style="display:none">
                                                        <td colspan="11" class="sr-loading-cell"><div class="sr-loader"></div></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Tab 3: Unachieved History -->
                            <div id="sr-rpanel-unachieve" class="rc-right-panel" style="display:none;">
                                <div id="menu3">
                                    <div class="rc-table-cover">
                                        <div class="rc-table-scroll rc-table-scroll--tab">
                                            <table class="table table-bordered rc-inner-table">
                                                <thead>
                                                    <tr>
                                                        <th>Benefit Holder</th>
                                                        <th>Referral Type</th>
                                                        <th>Referral User</th>
                                                        <th>Min. Limit</th>
                                                        <th>Sharing Type</th>
                                                        <th>Sharing Value</th>
                                                        <th>Category</th>
                                                        <th>Start Date</th>
                                                        <th>Exp. Time</th>
                                                        <th>Repeat Benefit</th>
                                                        <th>Purchase Type</th>
                                                    </tr>
                                                </thead>
                                                <tbody id="mydivchange3">
                                                    <tr id="loads3" style="display:none">
                                                        <td colspan="11" class="sr-loading-cell"><div class="sr-loader"></div></td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                <!-- END RIGHT -->

            </div>
        </div>

    </div>
</section>

<style>
    /* Toolbar � shared compact height */
    .sr-toolbar-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .sr-perm-wrap { display: flex; align-items: center; min-width: 0; }

    .sr-toolbar-link,
    .sr-ref-btn {
        height: 32px;
        box-sizing: border-box;
    }

    /* Monthly Retailer Referral � compact, same height as toolbar links */
    .sr-ref-btn {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 0 10px; border-radius: 8px;
        border: 1.5px solid transparent; cursor: pointer;
        transition: background .14s, box-shadow .14s;
        box-shadow: 0 1px 4px rgba(15,23,42,.06);
        max-width: 100%; min-width: 0;
        font-family: inherit;
    }
    .sr-ref-btn:hover { box-shadow: 0 2px 8px rgba(15,23,42,.1); }

    .sr-ref-btn--green {
        background: linear-gradient(135deg,#ecfdf5,#f0fdf4);
        border-color: #86efac; color: #14532d;
    }
    .sr-ref-btn--yellow {
        background: linear-gradient(135deg,#fefce8,#fef9c3);
        border-color: #fde047; color: #713f12;
    }
    .sr-ref-btn--orange {
        background: linear-gradient(135deg,#fff7ed,#ffedd5);
        border-color: #fdba74; color: #9a3412;
    }
    .sr-ref-btn--red,
    .sr-ref-btn--off {
        background: linear-gradient(135deg,#fef2f2,#fee2e2);
        border-color: #fca5a5; color: #991b1b;
    }

    .sr-ref-btn__icon {
        width: 20px; height: 20px; border-radius: 5px;
        display: inline-flex; align-items: center; justify-content: center;
        flex-shrink: 0; font-size: .58rem;
    }
    .sr-ref-btn--green .sr-ref-btn__icon { background: #16a34a; color: #fff; }
    .sr-ref-btn--yellow .sr-ref-btn__icon { background: #ca8a04; color: #fff; }
    .sr-ref-btn--orange .sr-ref-btn__icon { background: #ea580c; color: #fff; }
    .sr-ref-btn--red .sr-ref-btn__icon,
    .sr-ref-btn--off .sr-ref-btn__icon { background: #dc2626; color: #fff; }

    .sr-ref-btn__text {
        display: inline-flex; align-items: center; gap: 4px;
        min-width: 0; flex: 1 1 auto; white-space: nowrap; overflow: hidden;
    }
    .sr-ref-btn__title {
        font-size: .72rem; font-weight: 700; line-height: 1;
        overflow: hidden; text-overflow: ellipsis;
    }
    .sr-ref-btn__dot { font-size: .72rem; opacity: .45; flex-shrink: 0; }
    .sr-ref-btn__status {
        font-size: .68rem; font-weight: 600; opacity: .8; flex-shrink: 0;
    }
    .sr-ref-btn__status--off { color: #dc2626; font-weight: 700; opacity: 1; }

    .sr-ref-btn__badge {
        display: inline-flex; align-items: center; justify-content: center;
        min-width: 22px; height: 20px; padding: 0 5px;
        border-radius: 5px; font-size: .72rem; font-weight: 800;
        background: rgba(255,255,255,.7); border: 1px solid rgba(15,23,42,.08);
        flex-shrink: 0; line-height: 1;
    }

    .sr-ref-btn__chev {
        font-size: .58rem; opacity: .4; flex-shrink: 0;
    }

    .sr-toolbar-link {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 0 12px; border-radius: 8px;
        border: 1.5px solid #cbd5e1; background: #fff;
        color: #475569; font-size: .72rem; font-weight: 600;
        text-decoration: none; transition: background .14s;
        white-space: nowrap;
    }
    .sr-toolbar-link:hover { background: #f1f5f9; color: #1e293b; text-decoration: none; }
    .sr-info-wrap { position: relative; }
    .sr-info-icon { font-size: 1.1rem; color: #64748b; cursor: pointer; }
    .sr-info-tip {
        display: none; position: absolute; top: 28px; right: 0;
        background: #166534; color: #fff; padding: 6px 12px;
        border-radius: 8px; font-size: .72rem; white-space: nowrap; z-index: 99;
    }
    .sr-info-wrap:hover .sr-info-tip { display: block; }

    /* Left form */
    .sr-form-body { padding: 14px 16px 16px; }
    .sr-field { margin-bottom: 12px; }
    .sr-field label {
        display: block; font-size: .72rem; font-weight: 600;
        color: #475569; margin-bottom: 4px; text-transform: uppercase; letter-spacing: .03em;
    }
    .sr-input {
        height: 36px !important; border-radius: 8px !important;
        border: 1.5px solid #cbd5e1 !important; font-size: .78rem !important;
        color: #1e293b !important; background: #fff !important;
    }
    .sr-form-footer { margin-top: 16px; padding-top: 12px; border-top: 1px solid #e2e8f0; }
    .sr-msg { display: block; font-size: .74rem; color: #16a34a; margin-bottom: 8px; min-height: 18px; }
    .sr-form-btns { display: flex; gap: 8px; justify-content: flex-end; }

    /* Right tabs */
    .rc-right-toolbar-row { flex-wrap: wrap; gap: 8px; align-items: center; padding: 10px 14px 0; }
    .rc-right-tabs { display: flex; gap: 6px; flex-wrap: wrap; flex: 1 1 auto; }
    .rc-right-tabs .au-tab-btn {
        flex: 0 1 auto; height: 34px; padding: 0 12px; font-size: .72rem;
        border-radius: 8px 8px 0 0; white-space: nowrap;
    }
    .rc-right-panel { padding: 10px 14px 14px; display: none; }
    .rc-right-panel--active { display: block; }

    /* Detail cards */
    .sr-note {
        display: flex; align-items: flex-start; gap: 8px;
        padding: 10px 14px; border-radius: 10px;
        background: linear-gradient(135deg,#eff6ff,#f0f9ff);
        border: 1.5px solid #bfdbfe; color: #1e40af;
        font-size: .74rem; margin-bottom: 14px;
    }
    .sr-note i { margin-top: 2px; flex-shrink: 0; }
    .sr-type-grid { display: flex; flex-direction: column; gap: 14px; }
    .sr-type-card {
        border: 1.5px solid #cbd5e1; border-radius: 10px;
        background: #fff; overflow: hidden;
        box-shadow: 0 1px 4px rgba(15,23,42,.06);
    }
    .sr-type-card__head {
        display: flex; align-items: center; justify-content: space-between; gap: 8px;
        padding: 10px 14px; background: linear-gradient(135deg,#0f766e,#0891b2);
        color: #fff; font-size: .78rem; font-weight: 700;
    }
    .sr-type-card__head i { margin-right: 6px; }
    .sr-detail-list { list-style: none; margin: 0; padding: 0; }
    .sr-detail-list li {
        display: flex; align-items: center; justify-content: space-between; gap: 10px;
        padding: 9px 14px; border-bottom: 1px solid #f1f5f9; font-size: .76rem;
    }
    .sr-detail-list li:last-child { border-bottom: none; }
    .sr-detail-list li span { color: #64748b; font-weight: 500; flex-shrink: 0; }
    .sr-detail-list li strong { color: #1e293b; font-weight: 700; text-align: right; }
    .sr-detail-list--edit li { flex-wrap: wrap; }
    .sr-input-sm {
        height: 30px !important; border-radius: 6px !important;
        border: 1.5px solid #cbd5e1 !important; font-size: .74rem !important;
        max-width: 180px; margin-left: auto;
    }
    .sr-card-actions {
        display: flex; gap: 8px; justify-content: flex-end;
        padding: 10px 14px; background: #f8fafc; border-top: 1px solid #e2e8f0;
    }
    .sr-btn-danger { background: linear-gradient(135deg,#dc2626,#ef4444) !important; }
    .sr-status-btns fieldset { border: none; margin: 0; padding: 0; display: inline; }
    .sr-status-btn {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 3px 10px; border-radius: 6px; border: none;
        font-size: .68rem; font-weight: 700; cursor: pointer;
    }
    .sr-status-btn--active { background: #dcfce7; color: #166534; }
    .sr-status-btn--inactive { background: #fee2e2; color: #991b1b; }

    /* Tables */
    .rc-table-cover {
        border: 1.5px solid #cbd5e1; border-radius: 10px;
        background: #fff; overflow: hidden;
        box-shadow: 0 1px 4px rgba(15,23,42,.06);
    }
    .rc-table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .rc-table-scroll--tab { max-height: 58vh; overflow-y: auto; }
    .Set_Referral_Page .rc-inner-table {
        width: 100%; border-collapse: collapse; margin: 0 !important; min-width: 900px;
    }
    .Set_Referral_Page .rc-inner-table thead tr { background: #64748b; }
    .Set_Referral_Page .rc-inner-table thead th {
        color: #fff; font-size: .68rem; font-weight: 600; padding: 7px 8px;
        white-space: nowrap; border: 1px solid #94a3b8 !important;
        text-transform: uppercase; letter-spacing: .02em;
    }
    .Set_Referral_Page .rc-inner-table tbody td {
        font-size: .72rem; padding: 7px 8px; color: #334155;
        border: 1px solid #e2e8f0 !important; vertical-align: middle;
        white-space: nowrap;
    }
    .Set_Referral_Page .rc-inner-table tbody tr:nth-child(even) td { background: #f8fafc; }
    .Set_Referral_Page .rc-inner-table tbody tr:hover td { background: #eff6ff !important; }

    /* Loader */
    .sr-loading-cell { text-align: center !important; padding: 30px !important; }
    .sr-loader {
        width: 36px; height: 36px; margin: 0 auto;
        border: 3px solid #e2e8f0; border-top-color: #2563eb;
        border-radius: 50%; animation: sr-spin .8s linear infinite;
    }
    @@keyframes sr-spin { to { transform: rotate(360deg); } }

    /* Mobile */
    @@media (max-width: 991px) {
        .Set_Referral_Page .vm-ft-layout { flex-direction: column !important; }
        .Set_Referral_Page .vm-ft-form-col,
        .Set_Referral_Page .vm-ft-history-col {
            width: 100% !important; max-width: 100% !important;
            float: none !important; padding-left: 0 !important; padding-right: 0 !important;
        }
        .Set_Referral_Page .fund-transfer-main-admin.vm-ft-history-col { margin-top: 14px; }
        .sr-toolbar-actions { justify-content: flex-start; flex-wrap: wrap; }
        .rc-right-tabs .au-tab-btn { font-size: .64rem; padding: 0 8px; }
    }
    @@media (max-width: 767px) {
        .Set_Referral_Page .vm-ft-page-toolbar {
            flex-direction: column !important; gap: 8px !important; align-items: flex-start !important;
        }
        .Set_Referral_Page .vm-ft-search-wrap,
        .Set_Referral_Page .sr-toolbar-actions {
            flex-direction: column !important; width: 100% !important; gap: 6px !important;
        }
        .Set_Referral_Page .sr-perm-wrap { width: 100%; }
        .Set_Referral_Page .sr-ref-btn {
            width: 100%; height: 32px;
        }
        .Set_Referral_Page .sr-toolbar-link { width: 100%; justify-content: center; height: 32px; }
        .Set_Referral_Page .rc-right-tabs {
            flex-direction: column; width: 100%; display: flex;
        }
        .Set_Referral_Page .rc-right-tabs .au-tab-btn {
            width: 100% !important; flex: 1 1 100% !important;
            border-radius: 8px !important; justify-content: center;
            height: 36px; font-size: .72rem; white-space: normal;
        }
        .rc-right-toolbar-row { flex-direction: column; align-items: stretch; padding: 8px 10px 0 !important; }
        .rc-right-panel { padding: 8px 10px 12px; }
        .rc-table-scroll--tab { max-height: 42vh; }
        .Set_Referral_Page .rc-inner-table { min-width: 600px; }
        .sr-type-card__head { flex-wrap: wrap; gap: 6px; }
        .sr-detail-list li { flex-direction: column; align-items: flex-start; gap: 4px; }
        .sr-detail-list li strong { text-align: left; }
        .sr-input-sm { max-width: 100%; width: 100%; margin-left: 0; }
        .sr-form-btns { flex-direction: column; }
        .sr-form-btns .ne-btn-reset, .sr-form-btns .ne-btn-submit { width: 100%; justify-content: center; }
        .sr-card-actions { flex-direction: column; }
        .sr-card-actions button { width: 100%; justify-content: center; }
        .sr-note { font-size: .7rem; }
    }
    @@media (max-width: 480px) {
        .Set_Referral_Page .sr-ref-btn { width: 100%; }
        .Set_Referral_Page .sr-ref-btn__title { max-width: 140px; }
    }
</style>

<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />

<script>
    /* -- Helpers -- */
    function srShowMsg(msg, isError) {
        var el = document.getElementById('lblmsg');
        if (!el) return;
        el.textContent = msg || '';
        el.style.color = isError ? '#dc2626' : '#16a34a';
    }

    function srGet$() {
        return window.jQuery || window.$;
    }

    /* -- Right tab switching -- */
    function srRightTab(panelId, btnId) {
        document.querySelectorAll('.Set_Referral_Page .rc-right-tabs .au-tab-btn').forEach(function (b) { b.classList.remove('active'); });
        var btn = document.getElementById(btnId);
        if (btn) btn.classList.add('active');
        document.querySelectorAll('.Set_Referral_Page .rc-right-panel').forEach(function (p) {
            p.style.display = 'none';
            p.classList.remove('rc-right-panel--active');
        });
        var panel = document.getElementById(panelId);
        if (panel) {
            panel.style.display = 'block';
            panel.classList.add('rc-right-panel--active');
        }
    }

    function srLoadAchieve() {
        var $ = srGet$();
        if (!$) return;
        $('#loads').show();
        $.ajax({
            url: "@Url.Action("SetRefferedList","Home")",
            success: function (data) {
                $('#loads').hide();
                $("#mydivchange").html(data);
            },
            error: function () {
                $('#loads').hide();
                $("#mydivchange").html('<tr><td colspan="11" class="sr-loading-cell">Failed to load data</td></tr>');
            }
        });
    }

    function srLoadUnachieve() {
        var $ = srGet$();
        if (!$) return;
        $('#loads3').show();
        $.ajax({
            url: "@Url.Action("RefferedListofrrefer", "Home")",
            success: function (data) {
                $('#loads3').hide();
                $("#mydivchange3").html(data);
            },
            error: function () {
                $('#loads3').hide();
                $("#mydivchange3").html('<tr><td colspan="11" class="sr-loading-cell">Failed to load data</td></tr>');
            }
        });
    }

    function refferalsetup(numberee, statuss) {
        var $ = srGet$();
        if (!$) return;
        $.ajax({
            url: '@Url.Action("Refferal_Setting", "Home")',
            type: 'POST',
            data: { status123: statuss, limit123: numberee },
            cache: false,
            success: function (dlmresponse) {
                $('#refferalsetinpartial').html(dlmresponse);
            }
        });
    }

    function DeleteRefferedCode(type) {
        var $ = srGet$();
        if (!$) return;
        $.ajax({
            url: '@Url.Action("DeleteReferedCode", "Home")',
            data: { type: type },
            success: function (data) {
                if (type == "Purchases Basis") {
                    $('.ulpurchaseshow').show();
                    $('.ulpurchasenotshow').hide();
                    $('#purchasetype').hide();
                    $('#purchred').show();
                    $('#purchgreen').hide();
                }
                if (type == "business Basis") {
                    $('.ulbussnessshow').show();
                    $('.ulbussnessnotshow').hide();
                    $('#busnesstype').hide();
                    $('#busnessred').show();
                    $('#busnessgreen').hide();
                }
                fillDivTable();
                srShowMsg('Deleted successfully.');
            },
            error: function () {
                srShowMsg('Delete failed.', true);
            }
        });
    }

    function Chkstatusonoffpurch(type, status) {
        var $ = srGet$();
        if (!$) return;
        $.ajax({
            url: "@Url.Action("CHKSTATSETREFFERED")",
            data: { name: type, status: status },
            success: function (data) {
                if (data == "Erroe") {
                    $('#purchred').show();
                    srShowMsg('Could not activate.', true);
                } else {
                    $('#purchgreen').show();
                    $('#purchred').hide();
                    $('#busnessred').show();
                    $('#busnessgreen').hide();
                    srShowMsg('Purchases Basis activated.');
                }
            }
        });
    }

    function Chkstatusonoff(type, status) {
        var $ = srGet$();
        if (!$) return;
        $.ajax({
            url: "@Url.Action("CHKSTATSETREFFERED")",
            data: { name: type, status: status },
            success: function (data) {
                if (data == "Erroe") {
                    $('#busnessred').show();
                    srShowMsg('Could not activate.', true);
                } else {
                    $('#busnessgreen').show();
                    $('#busnessred').hide();
                    $('#purchred').show();
                    $('#purchgreen').hide();
                    srShowMsg('Business Basis activated.');
                }
            }
        });
    }

    function fillDivTable() {
        var $ = srGet$();
        if (!$) return;
        $.ajax({
            url: "@Url.Action("GetRefferalSetting")",
            success: function (data) {
                $('#busnesstype').hide();
                $('#purchasetype').hide();
                if (data.purchaseBasic != null) {
                    $('#purchasetype').show();
                    $('#spnbusneww').text(data.purchaseBasic.minimiumimit);
                    $('#expnoofday').text(data.purchaseBasic.expnoofday);
                    $('#spansharingtypes').text(data.purchaseBasic.SharingType);
                    $('#spnsharingvalue').text(data.purchaseBasic.SharingValue);
                    $('#spntotalsharingvalue').text(data.purchaseBasic.benifitrepeat);
                }
                if (data.BusnewwBasic != null) {
                    $('#busnesstype').show();
                    $('#bussminlimit').text(data.BusnewwBasic.minimiumimit);
                    $('#bussnoofday').text(data.BusnewwBasic.expnoofday);
                    $('#busssharingtype').text(data.BusnewwBasic.SharingType);
                    $('#busssharingvalue').text(data.BusnewwBasic.SharingValue);
                    $('#spncategry').text(data.BusnewwBasic.category);
                    $('#spntotalbusness').text(data.BusnewwBasic.benifitrepeat);
                }
            }
        });
    }

    function changereferral(value) {
        var $ = srGet$();
        if (!$) return;
        var res = $(value).val();
        if (res == 1) {
            $('#lblminlimit').text('Minimum Purchase Limit');
            $('.purchase-basis').show();
            $('.business-basis').hide();
            $('.purchase-type').show();
            $('#ddlReferalcode').prop('required', true);
        } else if (res == 2) {
            $('#lblminlimit').text('Minimum Business');
            $('.purchase-basis').show();
            $('.business-basis').show();
            $('.purchase-type').hide();
            $('#ddlReferalcode').prop('required', false);
        }
    }

    /* -- Submit new referral setting -- */
    function srSubmitForm(event) {
        event.preventDefault();
        var $ = srGet$();
        if (!$) return false;

        var reffertype = $('#changereferraltype option:selected').text();
        var minlimit = $('#txtminimiumpurchase').val();
        var noofday = $('#txtexpnoofday').val();
        var sharingtype = $('#ddlsharingtype').val();
        var sharingvalue = $('#txtSharingValue').val();

        if (!minlimit || !noofday || !sharingvalue) {
            srShowMsg('Please fill all required fields.', true);
            return false;
        }

        var $btn = $('#btnshowdetails');
        $btn.prop('disabled', true);

        $.ajax({
            url: "@Url.Action("InsertRefferalsetting")",
            type: "POST",
            data: {
                reftype: reffertype,
                minlimit: minlimit,
                noofday: noofday,
                sharingtype: sharingtype,
                sharingvalue: sharingvalue,
                catetype: $('#catetype').val(),
                ddlReferalcode: $('#ddlReferalcode').val() || 'SinglePurchasing'
            },
            success: function (data) {
                $btn.prop('disabled', false);
                if (data == "Success") {
                    srShowMsg('Referral setting saved successfully.');
                    fillDivTable();
                    document.getElementById('newsletter-form').reset();
                    changereferral(document.getElementById('changereferraltype'));
                } else {
                    srShowMsg(data, true);
                }
            },
            error: function (xhr, textStatus, errorThrown) {
                $btn.prop('disabled', false);
                srShowMsg(textStatus + ' | ' + errorThrown, true);
            }
        });
        return false;
    }

    /* -- Edit Purchase Basis -- */
    function srEditPurchase() {
        var $ = srGet$();
        if (!$) return;
        $.ajax({
            url: "@Url.Action("GetRefferalSetting")",
            success: function (data) {
                if (!data || !data.purchaseBasic) {
                    srShowMsg('Purchase settings not found.', true);
                    return;
                }
                var p = data.purchaseBasic;
                $('#txtpurchaselimit').val(p.minimiumimit);
                $('#txtpurchasenoofday').val(p.expnoofday);
                $('#ddlpurchsharingtype').val(p.SharingType);
                $('#txtpurchassharingvlaue').val(p.SharingValue);
                $('#txtpurchastotalsharingvalue').val(p.benifitrepeat);
                $('.ulpurchaseshow').hide();
                $('.ulpurchasenotshow').show();
            },
            error: function () {
                srShowMsg('Failed to load purchase settings.', true);
            }
        });
    }

    /* -- Save Purchase Basis -- */
    function srSavePurchase() {
        var $ = srGet$();
        if (!$) return;
        var totalcount = parseInt($('#txtpurchastotalsharingvalue').val(), 10);
        if (!totalcount || totalcount < 1 || totalcount > 12) {
            srShowMsg('Repeat must be between 1 and 12.', true);
            return;
        }
        $('#btneditdatapurchaseedit').prop('disabled', true);
        $.ajax({
            url: "@Url.Action("InsertRefferalsettingEditdata")",
            type: "POST",
            data: {
                reftype: 'Purchases Basis',
                minlimit: $('#txtpurchaselimit').val(),
                noofday: $('#txtpurchasenoofday').val(),
                sharingtype: $('#ddlpurchsharingtype').val(),
                sharingvalue: $('#txtpurchassharingvlaue').val(),
                catetype: '',
                totalcount: totalcount
            },
            success: function (data) {
                $('#btneditdatapurchaseedit').prop('disabled', false);
                if (data == 'Success') {
                    $('.ulpurchasenotshow').hide();
                    $('.ulpurchaseshow').show();
                    fillDivTable();
                    srShowMsg('Purchase settings saved.');
                } else {
                    srShowMsg(data || 'Save failed.', true);
                }
            },
            error: function (xhr, textStatus, errorThrown) {
                $('#btneditdatapurchaseedit').prop('disabled', false);
                srShowMsg(textStatus + ' | ' + errorThrown, true);
            }
        });
    }

    /* -- Edit Business Basis -- */
    function srEditBusiness() {
        var $ = srGet$();
        if (!$) return;
        $.ajax({
            url: "@Url.Action("GetRefferalSetting")",
            success: function (data) {
                if (!data || !data.BusnewwBasic) {
                    srShowMsg('Business settings not found.', true);
                    return;
                }
                var b = data.BusnewwBasic;
                $('#txtbusslimit').val(b.minimiumimit);
                $('#txtbusnessnoofday').val(b.expnoofday);
                $('#ddlbusnesssharingtype').val(b.SharingType);
                $('#txtbusnessssharingvlaue').val(b.SharingValue);
                $('#txtbusnessstotalcount').val(b.benifitrepeat);
                $('#busscatetype').val(b.category);
                $('.ulbussnessshow').hide();
                $('.ulbussnessnotshow').show();
            },
            error: function () {
                srShowMsg('Failed to load business settings.', true);
            }
        });
    }

    /* -- Save Business Basis -- */
    function srSaveBusiness() {
        var $ = srGet$();
        if (!$) return;
        var totalcount = parseInt($('#txtbusnessstotalcount').val(), 10);
        if (!totalcount || totalcount < 1 || totalcount > 12) {
            srShowMsg('Repeat must be between 1 and 12.', true);
            return;
        }
        $('#btneditdataBusnessedit').prop('disabled', true);
        $.ajax({
            url: "@Url.Action("InsertRefferalsettingEditdata")",
            type: "POST",
            data: {
                reftype: 'business Basis',
                minlimit: $('#txtbusslimit').val(),
                noofday: $('#txtbusnessnoofday').val(),
                sharingtype: $('#ddlbusnesssharingtype').val(),
                sharingvalue: $('#txtbusnessssharingvlaue').val(),
                catetype: $('#busscatetype').val(),
                totalcount: totalcount
            },
            success: function (data) {
                $('#btneditdataBusnessedit').prop('disabled', false);
                if (data == 'Success') {
                    $('.ulbussnessnotshow').hide();
                    $('.ulbussnessshow').show();
                    fillDivTable();
                    srShowMsg('Business settings saved.');
                } else {
                    srShowMsg(data || 'Save failed.', true);
                }
            },
            error: function (xhr, textStatus, errorThrown) {
                $('#btneditdataBusnessedit').prop('disabled', false);
                srShowMsg(textStatus + ' | ' + errorThrown, true);
            }
        });
    }

    /* -- Page init (after layout jQuery loads) -- */
    function srInitPage() {
        var $ = srGet$();
        if (!$) return;
        $(".sweet-alert").addClass("fullbodydycolorbg");
        fillDivTable();
        changereferral(document.getElementById('changereferraltype'));

        $.ajax({
            url: "@Url.Action("CHKSTATSETREFFEREDONTIME")",
            success: function (data) {
                if (data == "Purchases Basis") {
                    $('#purchgreen').show();
                    $('#busnessred').show();
                } else if (data == "business Basis") {
                    $('#busnessgreen').show();
                    $('#purchred').show();
                } else {
                    $('#purchred').show();
                    $('#busnessred').show();
                }
            }
        });
    }

    if (document.readyState === 'complete') {
        srInitPage();
    } else {
        window.addEventListener('load', srInitPage);
    }
</script>
