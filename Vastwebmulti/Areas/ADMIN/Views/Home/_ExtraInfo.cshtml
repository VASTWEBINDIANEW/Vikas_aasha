@model Vastwebmulti.Areas.ADMIN.Models.PostpaidUtilitySlab
@using (Ajax.BeginForm("_ExtraInfo", "Home", new AjaxOptions { HttpMethod = "POST", OnSuccess = "OnSuccessExtra", UpdateTargetId = "divEditFormEXTRA", LoadingElementId = "div_Loader", InsertionMode = InsertionMode.Replace }))
{
    <div class="vm-postpaid-modal-toolbar">
        <button type="button" onclick="Replaceall()" class="saas-admin-modal-btn saas-admin-modal-btn--warning vm-postpaid-modal-btn--replace">
            <i class="fas fa-sync-alt" aria-hidden="true"></i>
            <span>Replace Table Data</span>
        </button>
        <button type="submit" class="saas-admin-modal-btn saas-admin-modal-btn--success">
            <i class="fas fa-save" aria-hidden="true"></i>
            <span>Save Data</span>
        </button>
        <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal">
            <i class="fas fa-times" aria-hidden="true"></i>
            <span>Close</span>
        </button>
    </div>

    <div class="vm-pg-slab-table-scroll saas-acc-table-wrap vm-prepaid-slab-table-wrap">
        <table id="tblEntAttributes" class="table table-bordered vm-pg-slab-table">
            <thead>
                <tr>
                    <th>Operator Name</th>
                    <th>0 to 1500(%)</th>
                    <th>1501 to& 10000(%)</th>
                    <th>10001 to 50000(%)</th>
                    <th>50001 to 100000(%)</th>
                    <th>100001 & Above(%)</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.Extra.Count; i++)
                {
                    @Html.HiddenFor(a => a.Extra[i].optcode)
                    <tr>
                        <td>
                            @Html.DisplayFor(a => a.Extra[i].operator_Name)
                        </td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.Extra[i].move1, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input move1" } })
                            @Html.ValidationMessageFor(a => a.Extra[i].move1)
                        </td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.Extra[i].move2, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input move2" } })
                            @Html.ValidationMessageFor(a => a.Extra[i].move2)
                        </td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.Extra[i].move3, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input move3" } })
                            @Html.ValidationMessageFor(a => a.Extra[i].move3)
                        </td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.Extra[i].move4, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input move4" } })
                            @Html.ValidationMessageFor(a => a.Extra[i].move4)
                        </td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.Extra[i].move5, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input move5" } })
                            @Html.ValidationMessageFor(a => a.Extra[i].move5)
                        </td>
                        @*<td>@item.retailercomm</td>*@
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
