@model IEnumerable<Vastwebmulti.Areas.ADMIN.Models.App_login_Allow_imei>

@{
    string usertype = (string)ViewBag.usertype;
    string ret = "";
    string deler = "";
    string master = "";
    string drop_select_name = "Select " + usertype + " ID";

    if (usertype == "Dealer")
    {
        deler = "active";
    }
    else if (usertype == "Master")
    {
        master = "active";
    }
    else
    {
        ret = "active";
    }
}

<div class="wl-imei-drawer wl-drawer-visible">
    <ul class="wl-imei-tabs" id="mode-out">
        <li class="@ret">
            <button type="button" class="wl-imei-tab-btn" onclick="modelpopupopen123('Retailer')">
                <i class="fas fa-store"></i>
                <span>Retailer</span>
            </button>
        </li>
        <li class="@deler">
            <button type="button" class="wl-imei-tab-btn" onclick="modelpopupopen123('Dealer')">
                <i class="fas fa-users"></i>
                <span>Distributor</span>
            </button>
        </li>
        <li class="@master">
            <button type="button" class="wl-imei-tab-btn" onclick="modelpopupopen123('Master')">
                <i class="fas fa-user-tie"></i>
                <span>Master</span>
            </button>
        </li>
    </ul>

    <input type="hidden" id="hdadminblockImeie" name="hdadminblockImeie" value="@usertype" />

    <div class="wl-imei-form-card">
        <div class="wl-imei-form-card__head">
            <i class="fas fa-sim-card"></i>
            <span>Add Allowed IMEI — @usertype</span>
        </div>
        <div class="wl-imei-form-row">
            <div class="wl-imei-field">
                <label for="Retailerid1">@usertype ID</label>
                @Html.DropDownList("Retailerid1", ViewBag.apiid as SelectList, drop_select_name, new { @class = "form-control", required = true })
            </div>
            <div class="wl-imei-field">
                <label for="txtimeino">IMEI Number</label>
                @Html.TextBox("txtimeino", "", new { @class = "form-control", placeholder = "Enter IMEI NO", required = true })
            </div>
            <div class="wl-imei-field wl-imei-field--action">
                <label>&nbsp;</label>
                <button type="button" id="RetailerSearch" class="wl-imei-save-btn">
                    <i class="fas fa-save"></i>
                    <span>Save IMEI</span>
                </button>
            </div>
        </div>
    </div>

    <div class="wl-imei-table-card">
        <div class="wl-imei-table-card__head">
            <i class="fas fa-list"></i>
            <span>Allowed IMEI List</span>
        </div>
        <div class="wl-imei-table-wrap">
            <table class="wl-imei-table">
                <thead>
                    <tr>
                        <th>Firm Name</th>
                        <th>Email</th>
                        <th>IMEI NO</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.firmname</td>
                            <td>@item.email</td>
                            <td><span class="wl-imei-chip">@item.imeino</span></td>
                            <td>
                                <button type="button" id="@item.idno" class="wl-imei-del-btn" onclick="deletedone('@item.idno', '@item.role')">
                                    <i class="fas fa-trash-alt"></i>
                                    <span>Delete</span>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    $("#RetailerSearch").off("click.wlImei").on("click.wlImei", function () {
        var Retailerid1 = $("#Retailerid1").val();
        var txtimeino = $("#txtimeino").val();
        var hdadminblockImeie = $("#hdadminblockImeie").val();

        $.ajax({
            type: "POST",
            data: { hdadminblockImeie: hdadminblockImeie, Retailerid1: Retailerid1, txtimeino: txtimeino },
            url: "@Url.Action("Retailerblockaddusingajax", "Home")",
            success: function (response) {
                $("#modeldeiv").html(response);
                if (typeof wlNormalizeDrawerContent === "function") {
                    wlNormalizeDrawerContent($("#modeldeiv"));
                }
                $("#hdadminblockImeie").val(hdadminblockImeie);
            },
            error: function (request, error) {
                alert(" Can't do because: " + request);
            }
        });
    });

    function modelpopupopen123(usertype) {
        $("#hdadminblockImeie").val(usertype);
        $.ajax({
            url: '@Url.Action("RetailerblockIMEI")',
            type: "POST",
            data: { typeuser: usertype },
            success: function (response) {
                $("#modeldeiv").html(response);
                if (typeof wlNormalizeDrawerContent === "function") {
                    wlNormalizeDrawerContent($("#modeldeiv"));
                }
                $("#hdadminblockImeie").val(usertype);
            },
            error: function (request, error) {
                alert(" Can't do because: " + request);
            }
        });
    }

    function deletedone(idno, role) {
        $.ajax({
            url: "@Url.Action("DeleteRetailerblockIMEI","Home")",
            type: 'POST',
            data: { idno: idno, role: role },
            success: function (response) {
                $("#modeldeiv").html(response);
                if (typeof wlNormalizeDrawerContent === "function") {
                    wlNormalizeDrawerContent($("#modeldeiv"));
                }
            },
            error: function () {
                alert("error occured");
            }
        });
    }
</script>
