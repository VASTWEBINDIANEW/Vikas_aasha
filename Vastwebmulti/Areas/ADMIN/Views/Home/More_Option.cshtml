<script>
    function moSaveSuccess(message, title, reloadPage) {
        var msg = message || 'Data saved successfully.';
        var ttl = title || 'Success';
        if (reloadPage === undefined) {
            reloadPage = true;
        }
        if (typeof swal === 'function') {
            swal({
                title: ttl,
                text: msg,
                type: 'success',
                confirmButtonText: 'OK'
            }, function () {
                if (reloadPage) {
                    window.location.reload();
                }
            });
        } else {
            alert(msg);
            if (reloadPage) {
                window.location.reload();
            }
        }
    }

    function moSaveError(message, title) {
        var msg = message || 'Something went wrong. Please try again.';
        var ttl = title || 'Error';
        if (typeof swal === 'function') {
            swal(ttl, msg, 'error');
        } else {
            alert(msg);
        }
    }

    function moChangeNameSuccess() {
        moSaveSuccess('Outer link name saved successfully.');
    }

    $(function () {
        @if (TempData["MoSaveSuccess"] != null)
        {
            <text>moSaveSuccess(@Html.Raw(Json.Encode(TempData["MoSaveSuccess"].ToString())), 'Success', false);</text>
        }
        @if (TempData["MoSaveError"] != null)
        {
            <text>moSaveError(@Html.Raw(Json.Encode(TempData["MoSaveError"].ToString())));</text>
        }
    });

    function setItemId(id) {
        $('#idnoInput').val(id);
    }

    $(document).on('change', '#ManualformFile', function () {
        var name = (this.files && this.files[0]) ? this.files[0].name : 'No file selected';
        $('#ManualformFileLabel').text(name);
    });
</script>

