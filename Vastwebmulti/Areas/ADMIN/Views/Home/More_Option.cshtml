    <!-- Modal — Manual Form (service name + image) -->
    <div id="myModalmanualform" class="modal fade saas-admin-modal saas-admin-modal-drawer saas-more-option-modal saas-mo-manual-modal Wallet-To-Bank-Charge-modal" tabindex="-1" role="dialog" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header saas-admin-modal-header">
                    <div>
                        <h2>Upload Service Name and Image</h2>
                        <span class="saas-mo-modal-note">Add retailer manual-form services with a PNG icon (max 50×50 px).</span>
                    </div>
                    <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close">&times;</button>
                </div>
                <div class="modal-body saas-mo-manual-body">
                    <section class="saas-mo-upload-card">
                        <div class="saas-mo-upload-card-head">
                            <span class="saas-mo-upload-card-icon"><i class="fa fa-cloud-upload" aria-hidden="true"></i></span>
                            <div>
                                <h3 class="saas-mo-upload-card-title">Add new service</h3>
                                <p class="saas-mo-upload-card-hint">Name + PNG image required for each service tile.</p>
                            </div>
                        </div>
                        @using (Html.BeginForm("Manual_FormName", "Home", FormMethod.Post, new { enctype = "multipart/form-data", @class = "saas-mo-manual-form" }))
                        {
                            <input type="hidden" id="id" name="id" />
                            <div class="saas-mo-form-row">
                                <label class="saas-mo-label" for="ManualFormName">Service name</label>
                                <input name="Name" id="ManualFormName" type="text" maxlength="17" required placeholder="e.g. Electricity Bill" class="form-control saas-mo-input" />
                            </div>
                            <div class="saas-mo-form-row">
                                <label class="saas-mo-label" for="ManualformFile">Service icon (PNG)</label>
                                <div class="saas-mo-file-picker">
                                    <label class="saas-mo-file-btn" for="ManualformFile">
                                        <i class="fa fa-image" aria-hidden="true"></i> Choose file
                                    </label>
                                    <input type="file" name="ManualformFile" id="ManualformFile" class="saas-mo-file-input" accept="image/png" required />
                                    <span class="saas-mo-file-name" id="ManualformFileLabel">No file selected</span>
                                </div>
                            </div>
                            <button type="submit" id="manualsubmit" class="btn saas-mo-btn-primary saas-mo-btn-block">
                                <i class="fa fa-check" aria-hidden="true"></i> Save service
                            </button>
                        }
                    </section>
                    <section class="saas-mo-services-panel">
                        <div class="saas-mo-services-panel-head">
                            <h3>Existing services</h3>
                            <span class="saas-mo-services-count">@imagmanual.Count item(s)</span>
                        </div>
                        <div class="saas-mo-service-grid-wrap" id="formmanual12">
                            @Html.Partial("_Manualform")
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </div>

