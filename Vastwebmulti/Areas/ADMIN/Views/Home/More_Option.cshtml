<script>

    function travel_hideshow() {
            $.ajax({
                type: "GET",
                url: '@Url.Action("Status_on_off", "Home")',
                cache: false,
                dataType: 'json',
                async: true,
                success: function (data) {
                    var obj = data;

                    for (var item in obj) {
                        var sts = obj[item].Status;
                        var name = obj[item].MenuName;
                        /*console.log(name, sts)*/
                        if (sts == "Y") {
                            $("#" + name + "").prop("checked", true);
                        }
                        else {
                            $("#" + name + "").prop("checked", false);
                        }
                    }
                }
            });
        }
    function travel_hideshow_update() {
            var optCode = []

            $("#RechargeSlipCheckUncheck1 input").each(function () {
                if ($(this).prop('checked') == true) {
                    optCode.push($(this).val() + ",Y");
                }
                if ($(this).prop('checked') == false) {
                    optCode.push($(this).val() + ",N");
                }
            });

            //document.getElementById("loadermoney").style.display = "block";

            $.ajax({
                type: "POST",
                url: '@Url.Action("Status_on_offSettingSave", "Home")',
                data: { 'ch': optCode },
                cache: false,
                dataType: 'json',
                async: true,

                success: function (data) {
                    var pp = data && data.status;
                    var mm = (data && data.Message) ? data.Message : 'Could not save Travel & Card settings.';
                    if (pp) {
                        moSaveSuccess('Travel & Card hide/show settings saved successfully.');
                    } else {
                        moSaveError(mm, 'Travel & Card');
                    }
                },
                error: function () {
                    moSaveError('Could not save Travel & Card settings.');
                }
            });

        }
</script>




