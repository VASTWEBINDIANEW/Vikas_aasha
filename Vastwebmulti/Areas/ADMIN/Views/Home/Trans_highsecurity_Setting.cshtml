@using Vastwebmulti.Models;
@using Newtonsoft.Json;
@model Tuple<ChangePasswordViewModel, ChangeTransactionViewModel, ChangeSecurityViewModel>
@{
    ViewBag.Title = "tran_passslabsetting";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
}
@{
    VastwebmultiEntities DB = new VastwebmultiEntities();
    string hspass = "OK";
    var chksec = DB.admin_new_pass.SingleOrDefault();
    DateTime currenttime = DateTime.Now;
    DateTime lastchangedpassdss = Convert.ToDateTime(chksec.lastupdatesec);
    lastchangedpassdss = lastchangedpassdss.AddDays(Convert.ToInt32(chksec.secexpdays));
    if (chksec.securitypass == "lOW3n9XMM8fCuXPLyaQkkQ==" || (lastchangedpassdss <= currenttime))
    {
        hspass = "NOTOK";
    }

    var msgError = ViewData["MSG"] as string ?? "";
    var msgRegenError = ViewData["MSG1"] as string ?? "";
    var msgRegenSuccess = ViewData["MSG1success"] as string ?? "";
}

<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-high-security-gate.css?v=1" rel="stylesheet" />

<div id="loadermoney" class="vm-hs-gate-loader" style="display:none;" aria-hidden="true"></div>

<section class="content saas-high-security-gate-page saas-admin-account-page">
    <div class="vm-hs-gate-shell">
        @if (hspass == "OK")
        {
            <div class="vm-hs-gate-card" role="dialog" aria-modal="true" aria-labelledby="hsGateVerifyTitle">
                <div class="vm-hs-gate-header">
                    <div class="vm-hs-gate-header__icon"><i class="fas fa-shield-alt" aria-hidden="true"></i></div>
                    <h2 class="vm-hs-gate-header__title" id="hsGateVerifyTitle">High Security Password</h2>
                    <p class="vm-hs-gate-header__sub">Enter your security password to continue to this protected page.</p>
                </div>
                <div class="vm-hs-gate-body">
                    @using (Html.BeginForm("Trans_highsecurity_Setting", "Home", FormMethod.Post, new { id = "Formsubmit" }))
                    {
                        if (!string.IsNullOrWhiteSpace(msgError))
                        {
                            <p class="vm-hs-gate-message vm-hs-gate-message--error">@msgError</p>
                        }

                        <div class="vm-hs-gate-field">
                            <label for="txtcode">Security password</label>
                            <div class="vm-hs-gate-input-wrap">
                                <i class="fas fa-lock" aria-hidden="true"></i>
                                <input type="password" id="txtcode" name="txtcode" class="form-control vm-hs-gate-input" autocomplete="off" placeholder="Enter security password" />
                            </div>
                            <p id="errormsg" class="vm-hs-gate-field-error"></p>
                        </div>

                        <div class="vm-hs-gate-actions vm-hs-gate-actions--split">
                            <a href="@Url.Action("Dashboard", "Home")" class="vm-hs-gate-btn vm-hs-gate-btn--ghost">
                                <i class="fas fa-home" aria-hidden="true"></i> Back to home
                            </a>
                            <button type="button" id="btn" class="vm-hs-gate-btn vm-hs-gate-btn--primary" onclick="showloader()">
                                <i id="loaderfa" class="" aria-hidden="true"></i>
                                <span id="submitbtn">Proceed now</span>
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="vm-hs-gate-card vm-hs-gate-card--wide" role="dialog" aria-modal="true" aria-labelledby="hsGateResetTitle">
                <div class="vm-hs-gate-header vm-hs-gate-header--warning">
                    <div class="vm-hs-gate-header__icon"><i class="fas fa-exclamation-triangle" aria-hidden="true"></i></div>
                    <h2 class="vm-hs-gate-header__title" id="hsGateResetTitle">Security pin expired</h2>
                    <p class="vm-hs-gate-header__sub">Your security pin is expired or must be changed. Please set a new security pin to continue.</p>
                </div>
                <div class="vm-hs-gate-body vm-hs-gate-validation">
                    @using (Html.BeginForm("ReGenerateSecuritypass", "Home", FormMethod.Post))
                    {
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        if (!string.IsNullOrWhiteSpace(msgRegenError))
                        {
                            <p class="vm-hs-gate-message vm-hs-gate-message--error">@msgRegenError</p>
                        }
                        if (!string.IsNullOrWhiteSpace(msgRegenSuccess))
                        {
                            <p class="vm-hs-gate-message vm-hs-gate-message--success" id="regenSuccessMsg">@msgRegenSuccess</p>
                        }

                        <div class="vm-hs-gate-field">
                            <label for="Item3_OldSecuritypass">Old password</label>
                            <div class="vm-hs-gate-input-wrap">
                                <i class="fas fa-key" aria-hidden="true"></i>
                                @Html.PasswordFor(tuple => tuple.Item3.OldSecuritypass, new { @class = "form-control vm-hs-gate-input", required = "", placeholder = "Old password", id = "Item3_OldSecuritypass" })
                            </div>
                            @Html.ValidationMessageFor(tuple => tuple.Item3.OldSecuritypass, "", new { @class = "text-danger" })
                        </div>

                        <div class="vm-hs-gate-field">
                            <label for="Item3_NewSecuritypass">New password</label>
                            <div class="vm-hs-gate-input-wrap">
                                <i class="fas fa-lock" aria-hidden="true"></i>
                                @Html.PasswordFor(tuple => tuple.Item3.NewSecuritypass, new { @class = "form-control vm-hs-gate-input", required = "", maxlength = "6", placeholder = "New password (max 6)", id = "Item3_NewSecuritypass" })
                            </div>
                            @Html.ValidationMessageFor(tuple => tuple.Item3.NewSecuritypass, "", new { @class = "text-danger" })
                        </div>

                        <div class="vm-hs-gate-field">
                            <label for="Item3_ConfirmSecuritypass">Confirm password</label>
                            <div class="vm-hs-gate-input-wrap">
                                <i class="fas fa-check-circle" aria-hidden="true"></i>
                                @Html.PasswordFor(tuple => tuple.Item3.ConfirmSecuritypass, new { @class = "form-control vm-hs-gate-input", required = "", maxlength = "6", placeholder = "Confirm password", id = "Item3_ConfirmSecuritypass" })
                            </div>
                            @Html.ValidationMessageFor(tuple => tuple.Item3.ConfirmSecuritypass, "", new { @class = "text-danger" })
                        </div>

                        <div class="vm-hs-gate-reset-row">
                            <button type="reset" class="vm-hs-gate-btn vm-hs-gate-btn--ghost">Reset</button>
                            <button type="button" class="vm-hs-gate-btn vm-hs-gate-btn--warning password-change">Change password</button>
                            <button type="submit" class="vm-hs-gate-btn vm-hs-gate-btn--warning password-sure" data-loading-text="<i class='fa fa-spinner fa-spin'></i>" style="display:none;">Sure?</button>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</section>

<script>
    $(document).ready(function () {
        var errormsgval = @Html.Raw(JsonConvert.SerializeObject(msgError ?? ""));
        if (errormsgval) {
            $("#loaderfa").removeClass("fa fa-circle-o-notch fa-spin");
        }

        var successmsg = @Html.Raw(JsonConvert.SerializeObject(msgRegenSuccess ?? ""));
        if (successmsg) {
            var errEl = document.getElementById("errormsg");
            if (errEl) {
                errEl.innerHTML = successmsg;
            }
        }
    });

    function showloader() {
        var txtcode = $("#txtcode").val();

        if (txtcode != null && txtcode != "") {
            $("#loaderfa").addClass("fa fa-circle-o-notch fa-spin");
            document.getElementById("btn").disabled = true;
            document.getElementById("submitbtn").style.display = "none";
            document.getElementById("Formsubmit").submit();
        } else {
            document.getElementById("errormsg").innerHTML = "Please enter security password";
            $("#loaderfa").removeClass("fa fa-circle-o-notch fa-spin");
        }
    }

    $('.password-change').click(function () {
        $(this).hide();
        $(this).next('.password-sure').show();
    });

    $('.password-sure').on('click', function () {
        var $this = $(this);
        if ($this.button) {
            $this.button('loading');
            setTimeout(function () {
                $this.button('reset');
            }, 200);
        }
    });
</script>
