<!-- Select2 -->
<link href="~/select2/dist/css/select2.css" rel="stylesheet" />
<script src="~/AdminDesign/plugins/jquery-slimscroll/jquery.slimscroll.js"></script>
<script src="~/Swalalert/sweetalert-dev.js"></script>
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<script src="~/AdminDesign/plugins/jquery-slimscroll/jquery.slimscroll.js"></script>

<script>
    var ravi = $.noConflict();

    /* -- Select2 init (exclude filters + modal selects) -- */
    function rcInitPageSelect2() {
        ravi("select:not(.rc-th-select):not(.rc-filter-select):not(.rc-modal-select):not(.rc-sur-select)").each(function () {
            if (!ravi(this).hasClass('select2-hidden-accessible')) {
                ravi(this).select2({ width: '100%' });
            }
        });
    }

    function rcInitModalSelect2(modalSel) {
        var $modal = ravi(modalSel);
        $modal.find('select.rc-modal-select').each(function () {
            var $sel = ravi(this);
            if ($sel.hasClass('select2-hidden-accessible')) {
                $sel.select2('destroy');
            }
            $sel.select2({ width: '100%', dropdownParent: $modal });
        });
    }

    ravi(document).ready(function () {
        rcInitPageSelect2();
        ravi('#defaultModal, #defaultModal2, #myModalnew').appendTo('body');
        ravi('#defaultModal').on('shown.bs.modal', function () { rcInitModalSelect2('#defaultModal'); });
        ravi('#defaultModal2').on('shown.bs.modal', function () { rcInitModalSelect2('#defaultModal2'); });
        ravi('#defaultModal, #defaultModal2').on('hidden.bs.modal', function () {
            ravi(this).find('select.rc-modal-select').each(function () {
                if (ravi(this).hasClass('select2-hidden-accessible')) {
                    ravi(this).select2('destroy');
                }
            });
        });
    });
    $(document).ajaxComplete(function () { rcInitPageSelect2(); });

    /* -- Left tab switching -- */
    function rcLeftTab(panelId, btnId) {
        document.querySelectorAll('.rc-left-tabs .au-tab-btn').forEach(function (b) { b.classList.remove('active'); });
        var btn = document.getElementById(btnId);
        if (btn) btn.classList.add('active');
        document.querySelectorAll('.rc-left-panel').forEach(function (p) { p.style.display = 'none'; });
        var panel = document.getElementById(panelId);
        if (panel) panel.style.display = 'block';
    }

    /* -- Right tab switching -- */
    function rcRightTab(panelId, btnId, addBtnId) {
        document.querySelectorAll('.rc-right-tabs .au-tab-btn').forEach(function (b) { b.classList.remove('active'); });
        var btn = document.getElementById(btnId);
        if (btn) btn.classList.add('active');
        document.querySelectorAll('.rc-right-panel').forEach(function (p) {
            p.style.display = 'none';
            p.classList.remove('rc-right-panel--active');
        });
        var panel = document.getElementById(panelId);
        if (panel) {
            panel.style.display = 'block';
            panel.classList.add('rc-right-panel--active');
        }
        document.querySelectorAll('.rc-token-add-btn').forEach(function (b) { b.style.display = 'none'; });
        if (addBtnId) {
            var addBtn = document.getElementById(addBtnId);
            if (addBtn) addBtn.style.display = 'inline-flex';
        }
        if (panelId === 'rc-rpanel-dlm' && typeof dlm_ddlVal === 'function') { dlm_ddlVal(); }
        if (panelId === 'rc-rpanel-md' && typeof md_ddlVal === 'function') { md_ddlVal(); }
    }

    /* -- Remain tokens AJAX -- */
    function md_dlm_remainTkn() {
        $.ajax({
            url: '@Url.Action("_Md_dlm_RemainToken","Home")',
            type: 'GET', cache: false,
            success: function (response) {
                var $r = $('<div>').html(response);
                var mdHtml = $r.find('#rc-remain-md-content').html();
                var dlmHtml = $r.find('#rc-remain-dlm-content').html();
                if (mdHtml)  { $('#rc-remain-md').html(mdHtml); }
                if (dlmHtml) { $('#rc-remain-dlm').html(dlmHtml); }
            }
        });
    }
    /* -- Sign Up Rights: Change Default Distributor -- */
    function showSURChange() {
        var ddl = document.getElementById('ddldealer11');
        var saveBtn = document.getElementById('sur-save-btn');
        var cancelBtn = document.getElementById('sur-cancel-btn');
        var changeBtn = document.getElementById('Change_Default1');
        var infoCard = document.getElementById('sur-infocard');
        if (ddl) ddl.style.display = 'block';
        if (saveBtn) saveBtn.style.display = 'inline-flex';
        if (cancelBtn) cancelBtn.style.display = 'inline-flex';
        if (changeBtn) changeBtn.style.display = 'none';
        if (infoCard) infoCard.style.display = 'none';
        rcInitSurSelect2();
    }

    function cancelSURChange() {
        var ddl = document.getElementById('ddldealer11');
        var saveBtn = document.getElementById('sur-save-btn');
        var cancelBtn = document.getElementById('sur-cancel-btn');
        var changeBtn = document.getElementById('Change_Default1');
        var infoCard = document.getElementById('sur-infocard');
        if (ddl) ddl.style.display = 'none';
        if (saveBtn) saveBtn.style.display = 'none';
        if (cancelBtn) cancelBtn.style.display = 'none';
        if (changeBtn) changeBtn.style.display = 'inline-flex';
        if (infoCard) infoCard.style.display = 'flex';
        rcDestroySurSelect2();
    }

    function rcInitSurSelect2() {
        var sel = ravi('#dealerId');
        if (!sel.length) return;
        if (sel.hasClass('select2-hidden-accessible')) sel.select2('destroy');
        sel.select2({ width: '100%', dropdownAutoWidth: true });
    }

    function rcDestroySurSelect2() {
        var sel = ravi('#dealerId');
        if (sel.length && sel.hasClass('select2-hidden-accessible')) sel.select2('destroy');
    }

    function SETsignUpRight() {
        var dlmid = ravi('#dealerId').val();
        if (!dlmid) {
            alert('Please select a distributor.');
            return;
        }
        ravi('#sur-save-btn').prop('disabled', true);
        ravi.ajax({
            url: '@Url.Action("dealer_sts_default_Authorise","Home")',
            type: 'GET',
            data: { dealerid: dlmid },
            cache: false,
            success: function () {
                ravi.ajax({
                    url: '@Url.Action("_DlmSignUpRight","Home")',
                    type: 'GET', cache: false,
                    success: function (r) {
                        ravi('#SignUpSetting').html(r);
                        ravi('#sur-save-btn').prop('disabled', false);
                    },
                    error: function () {
                        ravi('#sur-save-btn').prop('disabled', false);
                        alert('Failed to refresh distributor info.');
                    }
                });
            },
            error: function () {
                ravi('#sur-save-btn').prop('disabled', false);
                alert('Failed to update default distributor.');
            }
        });
    }

    function dlmSignUpRight() {
        ravi.ajax({
            url: '@Url.Action("_DlmSignUpRight","Home")',
            type: 'GET', cache: false,
            success: function (response) {
                ravi("#SignUpSetting").html(response);
            }
        });
    }

    /* -- Distributor token history -- */
    function dlm_ddlVal() {
        $.ajax({
            url: '@Url.Action("DLM_BuyTokenHistory","Home")',
            type: 'POST',
            data: { dealerId: $("#dlmId").val() || '' }, cache: false,
            success: function (dlmresponse) {
                var html = "";
                if (dlmresponse && dlmresponse.length) {
                    $.each(dlmresponse, function (a, b) {
                        var dt = b.CteatedOn ? converttoDate(new Date(parseInt(String(b.CteatedOn).replace(/\/Date\((\d+)\)\//, '$1')))) : (b.CteatedOn || '');
                        html += "<tr><td>" + (b.Email || '') + "</td><td>" + b.Tokens + "</td><td>" + b.PerTokenValue +
                                "</td><td>" + b.TotalDebit + "</td><td>" + b.DealerPost + "</td><td>" + b.pre +
                                "</td><td>" + b.post + "</td><td>" + dt + "</td></tr>";
                    });
                } else {
                    html = '<tr><td colspan="8" class="rc-empty-row">No records found</td></tr>';
                }
                $('#DLM_BuyTokenHistory > tbody').html(html);
            }
        });
    }

    /* -- Master token history -- */
    function md_ddlVal() {
        $.ajax({
            url: '@Url.Action("MD_BuyTokenHistory","Home")',
            type: 'POST',
            data: { masterId: $("#masterId").val() || '' }, cache: false,
            success: function (mdresponse) {
                var html = "";
                if (mdresponse && mdresponse.length) {
                    $.each(mdresponse, function (a, b) {
                        var dt = b.CteatedOn ? converttoDate(new Date(parseInt(String(b.CteatedOn).replace(/\/Date\((\d+)\)\//, '$1')))) : '';
                        html += "<tr><td>" + (b.Email || '') + "</td><td>" + b.Tokens + "</td><td>" + b.PerTokenValue +
                                "</td><td>" + b.TotalDebit + "</td><td>" + b.MasterPost + "</td><td>" + b.pre +
                                "</td><td>" + b.post + "</td><td>" + dt + "</td></tr>";
                    });
                } else {
                    html = '<tr><td colspan="8" class="rc-empty-row">No records found</td></tr>';
                }
                $('#MD_BuyTokenHistory > tbody').html(html);
            },
            error: function () {
                $('#MD_BuyTokenHistory > tbody').html('<tr><td colspan="8" class="rc-empty-row">Failed to load data</td></tr>');
            }
        });
    }

    /* -- Date converter -- */
    function converttoDate(str) {
        var date = (str instanceof Date) ? str : new Date(str);
        if (isNaN(date.getTime())) { return String(str || ''); }
        var mnth = ("0" + (date.getMonth() + 1)).slice(-2),
            day  = ("0" + date.getDate()).slice(-2);
        return [day, mnth, date.getFullYear()].join("-") + " " +
               [date.getHours(), date.getMinutes(), date.getSeconds()].join(":");
    }

    /* -- Token counter (Distributor) -- */
    function onPluseMinus(v) {
        event.stopPropagation();
        var n = parseInt($('#tokenCount').val());
        var newVal = v >= 0 ? n + v : n - 1;
        $('#tokenCount').val(newVal);
        $('#showPhysicalCount').html(newVal);
        $('#btnChildMinus').prop('disabled', newVal <= 0);
    }

    /* -- Token counter (Master) -- */
    function onPluseMinuss(v) {
        event.stopPropagation();
        var n = parseInt($('#tokenCount2').val());
        var newVal = v >= 0 ? n + v : n - 1;
        $('#tokenCount2').val(newVal);
        $('#showPhysicalCount2').html(newVal);
        $('#btnChildMinus2').prop('disabled', newVal <= 0);
    }

    /* -- Add Token: Distributor -- */
    $('#DlmbtnSubmit').click(function () {
        $.ajax({
            url: '@Url.Action("addJoiningToken","Home")',
            type: 'POST',
            data: { ddlDealer: $("#ddlDealer").val(), tokenCount: $("#tokenCount").val() }, cache: false,
            success: function (response) {
                if (response == "Insufficient balance." || response == "Set the Dealer token Value." || response == "Token Can Not Be Negative") {
                    $("#Lblmsg").css("color", 'red').text(response);
                } else {
                    $("#Lblmsg").css("color", 'green').text("Credited Successfully.");
                    setTimeout(function () { $("#Lblmsg").text(''); $("#defaultModal").modal('hide'); dlm_ddlVal(); md_dlm_remainTkn(); }, 1000);
                }
            }
        });
    });

    /* -- Add Token: Master -- */
    $('#MdbtnSubmit').click(function () {
        $.ajax({
            url: '@Url.Action("addJoiningTokenMaster","Home")',
            type: 'POST',
            data: { ddlMaster: $("#ddlMaster").val(), tokenCount: $("#tokenCount2").val() }, cache: false,
            success: function (response) {
                if (response == "Insufficient balance." || response == "Set the Dealer token Value." || response == "Token Can Not Be Negative") {
                    $("#Lblmsg2").css("color", 'red').text(response);
                } else {
                    $("#Lblmsg2").css("color", 'green').text("Credited Successfully.");
                    setTimeout(function () { $("#Lblmsg2").text(''); $("#defaultModal2").modal('hide'); md_ddlVal(); md_dlm_remainTkn(); }, 1000);
                }
            }
        });
    });

    /* -- Retailer capping reload after save -- */
    $('#retailercapping').click(function () { location.reload(); });

    /* -- Paid service edit by ID -- */
    function Editmode(id) {
        $.ajax({
            url: '@Url.Action("PaidServicesChargeByID","Home")',
            data: { id: id },
            success: function (data) { $('#paidservicetbl').html(data); }
        });
    }

    /* -- Referral setting -- */
    function refferalsetup(numberee, statuss) {
        $.ajax({
            url: '@Url.Action("Refferal_Setting", "Home")',
            type: 'POST', data: { status123: statuss, limit123: numberee }, cache: false,
            success: function (dlmresponse) { $('#refferalsetinpartial').html(dlmresponse); }
        });
    }

    function isNumber(evt) {
        var k = (evt.which) ? evt.which : evt.keyCode;
        return !(k != 45 && k > 31 && (k < 48 || k > 57));
    }

    /* -- OnSuccess / OnFailed for Ajax.BeginForm -- */
    function OnSuccess(data) {
        var respose = JSON.parse(data);
        if (respose.status == "Success") { swal("Good job!", respose.Message, "success"); }
        else if (respose.status == "Failed") { swal("Oops!", respose.Message, "error"); }
        setTimeout(function () { location.reload(); }, 2000);
    }
    function OnFailed() { swal("Oops!", "Failed to update.", "error"); }

    /* -- On page load -- */
    $(document).ready(function () {
        var from = '@ViewBag.fromdate';
        var to   = '@ViewBag.todate';
        if (typeof fundreciveonload === 'function') fundreciveonload(from, to);
        if (typeof answers === 'function') answers();
    });
</script>
