@model Vastwebmulti.Areas.ADMIN.Models.Token_PaidService_VM
@using Vastwebmulti.Models;
@{
    ViewBag.Title = "SignUp Setting";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
}
@{
    int? all_cappingretailer = 0;
    VastwebmultiEntities db = new VastwebmultiEntities();
    var all_cappingretailer1 = db.All_Retailercapping.SingleOrDefault();
    if (all_cappingretailer1 != null) { all_cappingretailer = all_cappingretailer1.All_Capping; }
    else { all_cappingretailer = 0; }
}

<script src="https://cdn.jsdelivr.net/momentjs/2.14.1/moment-with-locales.min.js"></script>

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-fund-transfer-modern.css?v=27" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-fund-transfer-mobile.css?v=23" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-master-list-modern.css?v=19" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-api-user-page.css?v=7" rel="stylesheet" />

<section class="content Retailer_Creation_Charge_Page New_Employee_Page Masterlist-page saas-admin-account-page saas-admin-report-page saas-fund-transfer-page saas-fund-user-page saas-master-list-page saas-fund-transfer-premium">

    <div class="container-fluid vm-ft-page-shell">

        <!-- -- Toolbar -- -->
        <div class="vm-ft-page-toolbar vm-ft-page-toolbar--premium">
            <div class="vm-ft-page-hero">
                <ol class="vm-ft-breadcrumb">
                    <li><a href="@Url.Action("Dashboard","Home")"><i class="fas fa-home"></i> Dashboard</a></li>
                    <li>Basic Setting</li>
                    <li>SignUp Setting</li>
                </ol>
            </div>
            <div class="vm-ft-search-wrap">
                <!-- Capping button -->
                <button type="button" class="rc-capping-btn" data-toggle="modal" data-target="#myModalnew"
                        onclick="travel_hideshow()" title="Self SignUp Retailers Capping">
                    <span class="rc-capping-badge">@all_cappingretailer</span>
                    <span class="rc-capping-text">Self SignUp Retailers<br><small>Default Capping</small></span>
                </button>
                <!-- Export buttons -->
                <button type="button" id="btnExport" class="vm-ft-export-btn vm-ft-export-btn--excel" title="Export Excel">
                    <i class="fas fa-file-excel"></i>
                </button>
                <button type="button" id="btnPDF" class="vm-ft-export-btn vm-ft-export-btn--pdf" title="Export PDF">
                    <i class="fas fa-file-pdf"></i>
                </button>
            </div>
        </div>

        <!-- -- Two-column layout -- -->
        <div class="col-md-12 vm-ft-layout-wrap">
            <div class="row clearfix vm-ft-layout vm-ft-layout--full">

                <!-- ====== LEFT: Settings Panel ====== -->
                <div class="col-md-4 col-sm-12 vm-ft-form-col">
                    <div class="fund-trasfer-left fund-user-left vm-ft-form-card">

                        <!-- Card header -->
                        <div class="vm-ft-form-card-header">
                            <div class="vm-ft-form-card-header__icon"><i class="fas fa-cog"></i></div>
                            <div>
                                <span class="vm-ft-form-card-header__title">SignUp Setting</span>
                                <span class="vm-ft-form-card-header__sub">Configure retailer creation</span>
                            </div>
                        </div>

                        <!-- Left tabs -->
                        <div class="au-tabs rc-left-tabs">
                            <button type="button" class="au-tab-btn active" id="rc-ltab-paid"
                                    onclick="rcLeftTab('rc-lpanel-paid','rc-ltab-paid')">
                                <i class="fas fa-credit-card"></i> Paid Services
                            </button>
                            <button type="button" class="au-tab-btn" id="rc-ltab-signup"
                                    onclick="rcLeftTab('rc-lpanel-signup','rc-ltab-signup'); dlmSignUpRight();">
                                <i class="fas fa-user-check"></i> Sign Up Rights
                            </button>
                            <button type="button" class="au-tab-btn" id="rc-ltab-token"
                                    onclick="rcLeftTab('rc-lpanel-token','rc-ltab-token')">
                                <i class="fas fa-ticket-alt"></i> Token's Price
                            </button>
                        </div>

                        <!-- Tab Panel: Paid Services -->
                        <div id="rc-lpanel-paid" class="rc-left-panel" style="display:block; overflow-y:auto; max-height:72vh;">
                            <div class="rc-table-cover rc-table-cover--left">
                                <div id="paidservicetbl" class="rc-table-scroll">
                                    @Html.Partial("_PaidService")
                                </div>
                            </div>
                        </div>

                        <!-- Tab Panel: Sign Up Rights -->
                        <div id="rc-lpanel-signup" class="rc-left-panel" style="display:none; overflow-y:auto; max-height:72vh;">
                            <div class="user-registration-right" id="SignUpSetting">
                                @Html.Partial("_DlmSignUpRight")
                            </div>
                            <div class="table-responsive" id="_SetSignUpCharge" style="border-top:3px solid #e2e8f0;">
                                @Html.Partial("_SetJoingChargeStatus")
                            </div>
                        </div>

                        <!-- Tab Panel: Token's Price -->
                        <div id="rc-lpanel-token" class="rc-left-panel" style="display:none; overflow-y:auto; max-height:72vh;">
                            <div id="AddTokenVal">
                                @Html.Partial("_AddTokenValue")
                            </div>
                        </div>

                    </div>
                </div>
                <!-- ====== END LEFT ====== -->

                <!-- ====== RIGHT: Token History (Tab layout) ====== -->
                <div class="col-md-8 col-sm-12 fund-transfer-main-admin vm-ft-history-col" style="padding-left:0;">
                    <div class="fund-trasfer-right fund-user-right vm-ft-history-panel">
                        <div class="vm-ft-history-body">

                            <!-- Right tabs toolbar -->
                            <div class="vm-ft-history-toolbar vm-ft-history-toolbar--premium vm-ml-list-toolbar">
                                <div class="vm-ml-list-toolbar__row rc-right-toolbar-row">
                                    <div class="rc-right-tabs">
                                        <button type="button" class="au-tab-btn active" id="rc-rtab-dlm"
                                                onclick="rcRightTab('rc-rpanel-dlm','rc-rtab-dlm','rc-add-dlm');">
                                            <i class="fas fa-building"></i> Distributor Buy Token's History
                                        </button>
                                        <button type="button" class="au-tab-btn" id="rc-rtab-md"
                                                onclick="rcRightTab('rc-rpanel-md','rc-rtab-md','rc-add-md'); md_ddlVal();">
                                            <i class="fas fa-sitemap"></i> M/D Buy Token's History
                                        </button>
                                        <button type="button" class="au-tab-btn" id="rc-rtab-rem"
                                                onclick="rcRightTab('rc-rpanel-rem','rc-rtab-rem',null); md_dlm_remainTkn();">
                                            <i class="fas fa-coins"></i> Remain Token's
                                        </button>
                                    </div>
                                    <div class="rc-right-actions">
                                        <button type="button" id="rc-add-dlm" class="rc-token-add-btn"
                                                data-toggle="modal" data-target="#defaultModal">
                                            <i class="fas fa-plus"></i> Token's
                                        </button>
                                        <button type="button" id="rc-add-md" class="rc-token-add-btn"
                                                data-toggle="modal" data-target="#defaultModal2" style="display:none;">
                                            <i class="fas fa-plus"></i> Token's
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Tab 1: Distributor History -->
                            <div id="rc-rpanel-dlm" class="rc-right-panel rc-right-panel--active">
                                <div class="rc-table-cover">
                                    <div class="rc-filter-bar">
                                        @Html.DropDownList("dlmId", ViewBag.ddlDealers as IEnumerable<SelectListItem>, "All Distributors",
                                            new { @class = "form-control rc-filter-select", @onchange = "dlm_ddlVal();" })
                                    </div>
                                    <div class="rc-table-scroll rc-table-scroll--tab">
                                        <table id="DLM_BuyTokenHistory" class="table table-bordered rc-inner-table rc-token-table">
                                            <thead>
                                                <tr>
                                                    <th>Distributor</th>
                                                    <th title="Tokens"><i class="fas fa-ticket-alt"></i></th>
                                                    <th>Price</th>
                                                    <th>Debit</th>
                                                    <th>Post&nbsp;Bal</th>
                                                    <th>Pre</th>
                                                    <th>Post</th>
                                                    <th>Date</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @if (Model.RetailerCreationTokenVM != null)
                                                {
                                                    foreach (var item in Model.RetailerCreationTokenVM)
                                                    {
                                                        <tr>
                                                            <td>@item.Email</td>
                                                            <td>@item.Tokens</td>
                                                            <td>@item.PerTokenValue</td>
                                                            <td>@item.TotalDebit</td>
                                                            <td>@item.DealerPost</td>
                                                            <td>@item.pre</td>
                                                            <td>@item.post</td>
                                                            <td>@item.CteatedOn</td>
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>

                            <!-- Tab 2: M/D History -->
                            <div id="rc-rpanel-md" class="rc-right-panel" style="display:none;">
                                <div class="rc-table-cover">
                                    <div class="rc-filter-bar">
                                        @Html.DropDownList("masterId", ViewBag.ddlMaster as IEnumerable<SelectListItem>, "All Masters",
                                            new { @class = "form-control rc-filter-select", @onchange = "md_ddlVal();" })
                                    </div>
                                    <div class="rc-table-scroll rc-table-scroll--tab">
                                        @using (Html.BeginForm("RetailerCreationCharge", "Home", FormMethod.Post))
                                        {
                                            <table id="MD_BuyTokenHistory" class="table table-bordered rc-inner-table rc-token-table">
                                                <thead>
                                                    <tr>
                                                        <th>Master</th>
                                                        <th title="Tokens"><i class="fas fa-ticket-alt"></i></th>
                                                        <th>Price</th>
                                                        <th>Debit</th>
                                                        <th>Post&nbsp;Bal</th>
                                                        <th>Pre</th>
                                                        <th>Post</th>
                                                        <th>Date</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @if (Model.DealerCreationTokenVM != null)
                                                    {
                                                        foreach (var item in Model.DealerCreationTokenVM)
                                                        {
                                                            <tr>
                                                                <td>@item.Email</td>
                                                                <td>@item.Tokens</td>
                                                                <td>@item.PerTokenValue</td>
                                                                <td>@item.TotalDebit</td>
                                                                <td>@item.MasterPost</td>
                                                                <td>@item.pre</td>
                                                                <td>@item.post</td>
                                                                <td>@item.CteatedOn</td>
                                                            </tr>
                                                        }
                                                    }
                                                </tbody>
                                            </table>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Tab 3: Remain Tokens -->
                            <div id="rc-rpanel-rem" class="rc-right-panel" style="display:none;">
                                <div class="rc-remain-grid">
                                    <div class="rc-table-cover">
                                        <div class="rc-remain-head"><i class="fas fa-sitemap"></i> Master Distributor Live Remain Token's</div>
                                        <div id="rc-remain-md">
                                            @Html.Partial("_MdRemainToken")
                                        </div>
                                    </div>
                                    <div class="rc-table-cover">
                                        <div class="rc-remain-head"><i class="fas fa-building"></i> Distributor Live Remain Token's</div>
                                        <div id="rc-remain-dlm">
                                            @Html.Partial("_DlmRemainToken")
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
                <!-- ====== END RIGHT ====== -->

            </div>
        </div>

    </div>
</section>

<!-- ====== Modal: Add Token (Distributor) ====== -->
<div class="modal fade wl-modal New_Employee_Page Retailer_Creation_Charge_Page" id="defaultModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document" style="max-width:480px;">
        <div class="modal-content">
            <div class="wl-modal-header">
                <div class="wl-modal-header__left">
                    <div class="wl-modal-header__icon"><i class="fas fa-ticket-alt"></i></div>
                    <div>
                        <div class="wl-modal-header__label">Distributor</div>
                        <div class="wl-modal-header__balance">Sign Up Token</div>
                    </div>
                </div>
                <button type="button" class="wl-modal-close" data-dismiss="modal"><i class="fas fa-times"></i></button>
            </div>
            <div class="modal-body wl-modal-body">
                <form>
                    <div class="form-group">
                        <label><i class="fas fa-building" style="color:#0891b2;margin-right:4px;font-size:.68rem;"></i> Select Distributor</label>
                        @Html.DropDownList("ddlDealer", ViewBag.ddlDealers as IEnumerable<SelectListItem>, "-- Select Distributor --",
                            new { @class = "form-control rc-modal-select", id = "ddlDealer" })
                    </div>
                    <div class="form-group">
                        <label><i class="fas fa-ticket-alt" style="color:#0891b2;margin-right:4px;font-size:.68rem;"></i> Token Count</label>
                        <input type="hidden" name="tokenCount" id="tokenCount" value="1" />
                        <div class="rc-token-counter">
                            <button type="button" id="btnChildMinus" class="rc-counter-btn" onclick="onPluseMinus(-1)" disabled="disabled">
                                <i class="fas fa-minus"></i>
                            </button>
                            <span id="showPhysicalCount" class="rc-counter-value">1</span>
                            <button type="button" id="btnChildPlus" class="rc-counter-btn" onclick="onPluseMinus(1)">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                    </div>
                    <div style="text-align:center;min-height:20px;margin-bottom:4px;">
                        <label id="Lblmsg" style="font-size:.8rem;"></label>
                    </div>
                    <div class="ne-form-footer">
                        <button type="button" class="ne-btn-reset" data-dismiss="modal">
                            <i class="fas fa-times"></i> Close
                        </button>
                        <button type="button" id="DlmbtnSubmit" class="ne-btn-submit">
                            <i class="fas fa-check"></i> Verify &amp; Sale Token
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ====== Modal: Add Token (Master Distributor) ====== -->
<div class="modal fade wl-modal New_Employee_Page Retailer_Creation_Charge_Page" id="defaultModal2" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document" style="max-width:480px;">
        <div class="modal-content">
            <div class="wl-modal-header">
                <div class="wl-modal-header__left">
                    <div class="wl-modal-header__icon"><i class="fas fa-ticket-alt"></i></div>
                    <div>
                        <div class="wl-modal-header__label">Master Distributor</div>
                        <div class="wl-modal-header__balance">Sign Up Token</div>
                    </div>
                </div>
                <button type="button" class="wl-modal-close" data-dismiss="modal"><i class="fas fa-times"></i></button>
            </div>
            <div class="modal-body wl-modal-body">
                <form>
                    <div class="form-group">
                        <label><i class="fas fa-sitemap" style="color:#0891b2;margin-right:4px;font-size:.68rem;"></i> Select Master Distributor</label>
                        @Html.DropDownList("ddlMaster", ViewBag.ddlMaster as IEnumerable<SelectListItem>, "-- Select Master --",
                            new { @class = "form-control rc-modal-select", id = "ddlMaster" })
                    </div>
                    <div class="form-group">
                        <label><i class="fas fa-ticket-alt" style="color:#0891b2;margin-right:4px;font-size:.68rem;"></i> Token Count</label>
                        <input type="hidden" name="tokenCount2" id="tokenCount2" value="1" />
                        <div class="rc-token-counter">
                            <button type="button" id="btnChildMinus2" class="rc-counter-btn" onclick="onPluseMinuss(-1)" disabled="disabled">
                                <i class="fas fa-minus"></i>
                            </button>
                            <span id="showPhysicalCount2" class="rc-counter-value">1</span>
                            <button type="button" id="btnChildPlus2" class="rc-counter-btn" onclick="onPluseMinuss(1)">
                                <i class="fas fa-plus"></i>
                            </button>
                        </div>
                    </div>
                    <div style="text-align:center;min-height:20px;margin-bottom:4px;">
                        <label id="Lblmsg2" style="font-size:.8rem;"></label>
                    </div>
                    <div class="ne-form-footer">
                        <button type="button" class="ne-btn-reset" data-dismiss="modal">
                            <i class="fas fa-times"></i> Close
                        </button>
                        <button type="button" id="MdbtnSubmit" class="ne-btn-submit">
                            <i class="fas fa-check"></i> Verify &amp; Sale Token
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- ====== Modal: Retailer Capping ====== -->
<div id="myModalnew" class="modal fade wl-modal New_Employee_Page Retailer_Creation_Charge_Page" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document" style="max-width:420px;">
        <div class="modal-content">
            <div class="wl-modal-header">
                <div class="wl-modal-header__left">
                    <div class="wl-modal-header__icon"><i class="fas fa-users-cog"></i></div>
                    <div>
                        <div class="wl-modal-header__label">Default Capping</div>
                        <div class="wl-modal-header__balance">Self SignUp Retailers</div>
                    </div>
                </div>
                <button type="button" class="wl-modal-close" data-dismiss="modal" id="closebtn"><i class="fas fa-times"></i></button>
            </div>
            <div class="modal-body wl-modal-body">
                @using (Ajax.BeginForm("Add_RetailerCapping", new AjaxOptions { HttpMethod = "Post", OnSuccess = "RetailerMobSearch", LoadingElementId = "div-loader" }))
                {
                    <div class="form-group">
                        <label><i class="fas fa-hashtag" style="color:#0891b2;margin-right:4px;font-size:.68rem;"></i> Default Capping (Retailers)</label>
                        <input name="Capping" type="text" maxlength="4" required placeholder="Enter capping number"
                               class="form-control" onkeypress="return isNumber(event)" />
                    </div>
                    <div class="ne-form-footer">
                        <button type="button" class="ne-btn-reset" data-dismiss="modal">
                            <i class="fas fa-times"></i> Cancel
                        </button>
                        <button type="submit" id="retailercapping" class="ne-btn-submit">
                            <i class="fas fa-save"></i> Save
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    /* -- Toolbar capping button -- */
    .rc-capping-btn {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 5px 12px; border-radius: 10px;
        border: 1.5px solid #fed7aa; background: #fff7ed;
        color: #9a3412; cursor: pointer; font-size: .76rem;
        transition: background .14s;
    }
    .rc-capping-btn:hover { background: #ffedd5; }
    .rc-capping-badge {
        background: #f97316; color: #fff;
        border-radius: 6px; padding: 2px 8px;
        font-weight: 700; font-size: .8rem; min-width: 28px; text-align: center;
    }
    .rc-capping-text { line-height: 1.3; text-align: left; }
    .rc-capping-text small { font-size: .68rem; color: #c2410c; display: block; }

    /* -- Right panel tabs -- */
    .rc-right-toolbar-row { flex-wrap: wrap; gap: 8px; align-items: center; padding: 10px 14px 0; }
    .rc-right-tabs { display: flex; gap: 6px; flex-wrap: wrap; flex: 1 1 auto; }
    .rc-right-tabs .au-tab-btn {
        flex: 0 1 auto; height: 34px; padding: 0 12px; font-size: .72rem;
        border-radius: 8px 8px 0 0; white-space: nowrap;
    }
    .rc-right-actions { display: flex; gap: 6px; align-items: center; flex-shrink: 0; }
    .rc-right-panel { padding: 10px 14px 14px; display: none; }
    .rc-right-panel--active { display: block; }

    .rc-token-add-btn {
        display: inline-flex; align-items: center; gap: 5px; flex-shrink: 0;
        padding: 6px 14px; border-radius: 8px; border: none;
        background: linear-gradient(135deg,#2563eb,#3b82f6); color: #fff;
        font-size: .74rem; font-weight: 700; cursor: pointer; transition: opacity .14s;
        box-shadow: 0 2px 8px rgba(37,99,235,.35);
    }
    .rc-token-add-btn:hover { opacity: .88; color: #fff; }

    .rc-remain-grid { display: flex; flex-direction: column; gap: 14px; width: 100%; }
    .rc-remain-grid .rc-table-cover { width: 100%; }
    .rc-remain-grid .rc-inner-table { min-width: 100% !important; width: 100% !important; table-layout: fixed; }
    .rc-remain-grid .rc-inner-table th,
    .rc-remain-grid .rc-inner-table td { white-space: normal; word-break: break-word; }
    .rc-remain-grid .rc-table-scroll--remain { max-height: none; overflow: visible; }
    .rc-remain-head {
        padding: 9px 12px; background: linear-gradient(135deg,#0f766e,#0891b2);
        color: #fff; font-size: .74rem; font-weight: 700;
        display: flex; align-items: center; gap: 7px;
        border-bottom: 1px solid #0891b2;
    }

    /* -- Table cover box (left + right) -- */
    .rc-table-cover {
        border: 1.5px solid #cbd5e1; border-radius: 10px;
        background: #fff; overflow: hidden;
        box-shadow: 0 1px 4px rgba(15,23,42,.06);
    }
    .rc-table-cover--left { margin: 0; }
    .rc-table-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
    .rc-table-scroll--tab { max-height: 58vh; overflow-y: auto; }
    .rc-table-scroll--remain { max-height: 42vh; overflow-y: auto; }

    .rc-filter-bar { padding: 8px 10px; background: #f8fafc; border-bottom: 1px solid #e2e8f0; }
    .rc-filter-select {
        height: 32px !important; width: 100% !important;
        border-radius: 8px !important; font-size: .76rem !important;
        border: 1.5px solid #cbd5e1 !important; background: #fff !important;
        color: #1e293b !important; padding: 4px 10px !important;
    }

    /* -- Inner tables (classic covered look) -- */
    .Retailer_Creation_Charge_Page .rc-inner-table {
        width: 100%; border-collapse: collapse; margin: 0 !important; min-width: 680px;
        table-layout: auto;
    }
    .Retailer_Creation_Charge_Page .rc-inner-table thead tr { background: #64748b; }
    .Retailer_Creation_Charge_Page .rc-inner-table thead th {
        color: #fff; font-size: .7rem; font-weight: 600; padding: 7px 8px;
        white-space: nowrap; border: 1px solid #94a3b8 !important;
        text-transform: uppercase; letter-spacing: .02em; vertical-align: middle;
    }
    .Retailer_Creation_Charge_Page .rc-inner-table tbody td {
        font-size: .74rem; padding: 7px 10px; color: #334155;
        border: 1px solid #e2e8f0 !important; vertical-align: middle;
        white-space: nowrap;
    }
    .Retailer_Creation_Charge_Page .rc-inner-table tbody td:first-child { white-space: normal; min-width: 120px; }
    .Retailer_Creation_Charge_Page .rc-inner-table tbody tr:nth-child(even) td { background: #f8fafc; }
    .Retailer_Creation_Charge_Page .rc-inner-table tbody tr:hover td { background: #eff6ff !important; }
    .rc-live-th { text-align: center !important; }
    .rc-live-label { color: #86efac; font-weight: 700; }
    .rc-live-td { text-align: center; }
    .rc-live-badge {
