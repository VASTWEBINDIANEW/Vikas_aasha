@model Vastwebmulti.Areas.ADMIN.Models.BlockUserViewModel

@{ var i = 1;}

@foreach (var item in Model.WLoginHistory)
{
    var badgeClass = item.LoginFrom == "Web" ? "wl-by-badge wl-by-badge--web" : "wl-by-badge wl-by-badge--app";
    var badgeText = item.LoginFrom == "Web" ? "WEB" : "APP";

    <tr>
        <td>@i</td>
        <td><span class="@badgeClass">@badgeText</span></td>
        <td>
            <strong>@item.Role</strong><br />
            <small>@item.firmname</small>
        </td>
        <td>
            @if (!string.IsNullOrEmpty(item.ImeiNo)) { <div><small>IMEI:</small> @item.ImeiNo</div> }
            @if (!string.IsNullOrEmpty(item.ModelNo)) { <div><small>Model:</small> @item.ModelNo</div> }
            @if (!string.IsNullOrEmpty(item.IP_Address)) { <div><small>IP:</small> @item.IP_Address</div> }
            @if (!string.IsNullOrEmpty(item.browser)) { <div><small>Browser:</small> @item.browser</div> }
        </td>
        <td>
            @if (!string.IsNullOrEmpty(item.Latitude)) { <div>@item.Latitude</div> }
            @if (!string.IsNullOrEmpty(item.Logitude)) { <div>@item.Logitude</div> }
        </td>
        <td>
            <strong>@item.CurrentLoginTime</strong>
            @if (!string.IsNullOrEmpty(item.City) || !string.IsNullOrEmpty(item.Location))
            {
                <div><span class="wl-by-badge">@item.City</span> @item.Location</div>
            }
        </td>
    </tr>
    i++;
}
