@model Vastwebmulti.Areas.ADMIN.Models.BlockUserViewModel

@{ var i = 1;}

@foreach (var item in Model.WLoginHistory)
{
    var badgeClass = item.LoginFrom == "Web" ? "wl-by-badge wl-by-badge--web" : "wl-by-badge wl-by-badge--app";
    var badgeText = item.LoginFrom == "Web" ? "WEB" : "APP";

    <tr class="wl-hist-row">
        <td class="wl-hist-cell wl-hist-cell--sr">@i</td>
        <td class="wl-hist-cell wl-hist-cell--by"><span class="@badgeClass">@badgeText</span></td>
        <td class="wl-hist-cell wl-hist-cell--user">
            <div class="wl-hist-user-role">@item.Role</div>
            <div class="wl-hist-user-name">@item.firmname</div>
        </td>
        <td class="wl-hist-cell wl-hist-cell--device">
            <ul class="wl-hist-kv-list">
                @if (!string.IsNullOrEmpty(item.ImeiNo)) { <li><span class="wl-hist-kv-label">IMEI</span><span class="wl-hist-kv-value">@item.ImeiNo</span></li> }
                @if (!string.IsNullOrEmpty(item.ModelNo)) { <li><span class="wl-hist-kv-label">Model</span><span class="wl-hist-kv-value">@item.ModelNo</span></li> }
                @if (!string.IsNullOrEmpty(item.IP_Address)) { <li><span class="wl-hist-kv-label">IP</span><span class="wl-hist-kv-value">@item.IP_Address</span></li> }
                @if (!string.IsNullOrEmpty(item.browser)) { <li><span class="wl-hist-kv-label">Browser</span><span class="wl-hist-kv-value">@item.browser</span></li> }
            </ul>
        </td>
        <td class="wl-hist-cell wl-hist-cell--geo">
            @if (!string.IsNullOrEmpty(item.Latitude)) { <div class="wl-hist-geo-line">@item.Latitude</div> }
            @if (!string.IsNullOrEmpty(item.Logitude)) { <div class="wl-hist-geo-line">@item.Logitude</div> }
        </td>
        <td class="wl-hist-cell wl-hist-cell--time">
            <div class="wl-hist-time">@item.CurrentLoginTime</div>
            @if (!string.IsNullOrEmpty(item.City) || !string.IsNullOrEmpty(item.Location))
            {
                <div class="wl-hist-addr">
                    @if (!string.IsNullOrEmpty(item.City)) { <span class="wl-by-badge wl-hist-city">@item.City</span> }
                    @if (!string.IsNullOrEmpty(item.Location)) { <span class="wl-hist-location">@item.Location</span> }
                </div>
            }
        </td>
    </tr>
    i++;
}
