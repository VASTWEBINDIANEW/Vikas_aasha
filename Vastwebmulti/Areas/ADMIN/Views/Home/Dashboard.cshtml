@using Microsoft.AspNet.Identity
@using Vastwebmulti.Models;


@model IEnumerable<Vastwebmulti.Models.DashBoard_Report_top_Result>

@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var recentTransactions = Model != null
        ? Model.ToList()
        : new List<Vastwebmulti.Models.DashBoard_Report_top_Result>();

    decimal retailerBalance = 0m;
    decimal retailerPosBalance = 0m;
    if (ViewData["Rem"] != null)
    {
        retailerBalance = Convert.ToDecimal(ViewData["Rem"]);
    }
    if (ViewData["posbal"] != null)
    {
        retailerPosBalance = Convert.ToDecimal(ViewData["posbal"]);
    }
    var retailersTotalBalance = retailerBalance + retailerPosBalance;

    var comnyname1 = "";
    VastwebmultiEntities DB1 = new VastwebmultiEntities();
    var companyname1 = DB1.Admin_details.ToList();
    if (companyname1.Count > 0)
    {
        comnyname1 = companyname1.FirstOrDefault().Companyname;
        ViewBag.companyname = comnyname1;
    }
    else
    {
        comnyname1 = "";
    }

}




