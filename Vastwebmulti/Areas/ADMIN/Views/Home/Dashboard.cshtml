<div id="loader" class="admin-global-loader" style="display:none;width: 100% !important;
  top: 0 !important;" aria-hidden="true" role="status">
    <div class="admin-global-loader-box">
        <i class="fas fa-spinner fa-spin" aria-hidden="true"></i>
        <span>Loading...</span>
    </div>
</div>

<script>
    var txnLoaded = { top100: false, today: false };

    function initSaasDashTxnTable($root) {
        var $tables = $root.find('table.saas-dash-txn-table');
        if (!$tables.length || !$.fn.DataTable) return;
        $tables.each(function () {
            var $t = $(this);
            if ($.fn.dataTable.isDataTable(this)) {
                $t.DataTable().destroy();
            }
            if ($t.find('tbody tr.saas-dt-empty-row').length) return;
            $t.DataTable({
                pageLength: 10,
                lengthChange: false,
                ordering: true,
                order: [[4, 'desc']],
                autoWidth: false,
                searching: true,
                info: true,
                paging: true,
                dom: '<"saas-dt-toolbar"f>rt<"saas-dt-footer"ip>',
                language: {
                    search: '',
                    searchPlaceholder: 'Search firm, type, description...',
                    emptyTable: 'No transactions found',
                    zeroRecords: 'No matching transactions',
                    info: 'Showing _START_–_END_ of _TOTAL_',
                    paginate: { previous: 'Prev', next: 'Next' }
                },
                columnDefs: [
                    { orderable: false, targets: [0, 2] },
                    { className: 'col-desc', targets: 3 },
                    { className: 'col-amount', targets: 5 },
                    { className: 'col-balance', targets: 6 }
                ]
            });
        });
    }

    function switchTxnTab(tabId) {
        var $panel = $('.sevent_box3');
        $panel.find('ul.tabs3 li').removeClass('current3').attr('aria-selected', 'false');
        $panel.find('.tab-content3').removeClass('current3').attr('hidden', 'hidden');

        $panel.find('ul.tabs3 li[data-tab="' + tabId + '"]').addClass('current3').attr('aria-selected', 'true');
        var $pane = $('#' + tabId);
        $pane.addClass('current3').removeAttr('hidden');

        if (tabId === 'tab-5') {
            if (!txnLoaded.top100) grossbusiness();
            else initSaasDashTxnTable($('#top100'));
        } else if (tabId === 'tab-6') {
            if (!txnLoaded.today) grossbusinessall();
            else initSaasDashTxnTable($('#topall'));
        } else if (tabId === 'tab-4') {
            initSaasDashTxnTable($('#tab-4'));
        }
    }

    function grossbusiness() {
        if (window.showAdminLoader) showAdminLoader(); else $('#loader').show();
        $.post('@Url.Action("_top100", "Home")', function (data) {
            $("#top100").html(data);
            txnLoaded.top100 = true;
            initSaasDashTxnTable($('#top100'));
        }).always(function () {
            if (window.hideAdminLoader) hideAdminLoader(); else $('#loader').hide();
        });
    }

    function grossbusinessall() {
        if (window.showAdminLoader) showAdminLoader(); else $('#loader').show();
        $.post('@Url.Action("_topALL", "Home")', function (data) {
            $("#topall").html(data);
            txnLoaded.today = true;
            initSaasDashTxnTable($('#topall'));
        }).always(function () {
            if (window.hideAdminLoader) hideAdminLoader(); else $('#loader').hide();
        });
    }
    function fillval() {
        $("#txtvirtual").val($("#virval").val());
        if (window.showAdminModal) {
            window.showAdminModal("#myModal");
        } else {
            $("#myModal").modal("show");
        }
    }
    function Alltab() {
        document.getElementById("Todaybusiness").style.display = "none";
        document.getElementById("rch").style.marginBottom = "22px";
    }
    function today(a) {
        document.getElementById("Todaybusiness").style.display = "block";
        $("#tabletoday").empty();
        $.ajax({
            url: '@Url.Action("Show_All_Recharge", "Home")',
            type: 'POST',
            dataType: "html",
            data: { type: a.id },
            success: function (data) {
                var x = JSON.parse(data);
                var newRow =
                    "<tr><td><i class='fa fa-desktop' style='color:#E91E63;font-size:20px;'></i></td><td>Recharge & bill</td><td>" + x.Recharge + "</td></tr>" +
                    "<tr><td><i class='fa fa-university' style='color:#2196F3;font-size:20px;'></i></td><td>Financial Services</td><td>" + x.Moneytransfer + "</td></tr>" +
                    "<tr><td><i class='material-icons' style='color:#FF9800;'>fingerprint</i></td><td>Aeps Services</td><td>" + x.Aeps + "</td></tr>" +
                    "<tr><td><i class='fa fa-id-card' style='font-size:20px;'></i></td><td>Pancard</td><td>" + x.Pancard + "</td></tr>";
                $('#tabletoday').append(newRow);
                $("#donut_chart").empty();
                if (typeof Morris !== 'undefined') {
                    Morris.Donut({
                        element: 'donut_chart',
                        data: [
                            { label: 'Recharge & bill', value: x.Recharge },
                            { label: 'Financial', value: x.Moneytransfer },
                            { label: 'Aeps', value: x.Aeps },
                            { label: 'Pancard', value: x.Pancard }
                        ],
                        colors: ['#e91e63', '#0080ff', '#ff9800', '#000']
                    });
                }
            }
        });
    }

    $(function () {
        var hash = document.URL.substring(document.URL.indexOf('#'));
        if (hash === "#setting") {
            $('#tab1click,#tab-1').removeClass("current2");
            $('#tab2click,#tab-2').addClass("current2");
        } else if (hash === "#useraccount") {
            $('#tab1click,#tab-2').removeClass("current2");
            $('#tab3click,#tab-3').addClass("current2");
        } else if (hash === "#setting7") {
            $('#tab17click,#tab-17').removeClass("current2");
            $('#tab27click,#tab-27').addClass("current2");
        } else if (hash === "#useraccount7") {
            $('#tab27click,#tab-27').removeClass("current2");
            $('#tab17click,#tab-17').addClass("current2");
        }

        $('.sevent_box0 > ul.tabs2 li').click(function () {
            var tab_id = $(this).attr('data-tab');
            $('.sevent_box0 > ul.tabs2 li').removeClass('current2');
            $('.sevent_box0 .tab-content2').removeClass('current2');
            $(this).addClass('current2');
            $('#' + tab_id).addClass('current2');
        });

        $('.sevent_box3').on('click', 'ul.tabs3 li[data-tab]', function (e) {
            e.preventDefault();
            var tabId = $(this).attr('data-tab');
            if (tabId) switchTxnTab(tabId);
        });

        initSaasDashTxnTable($('#tab-4'));
    });
</script>
