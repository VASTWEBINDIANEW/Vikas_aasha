<script>
    function OnSuccess1(data) {
        if (typeof resetSlabViewMode === 'function') {
            resetSlabViewMode();
        } else {
            $('#btnsubmituser').hide();
            $('#btnsubmitusercommon').hide();
            $('#btnEdit').show();
        }
        var chk = '@Model.role';
        if (chk == "Retailer") {
            showRetailerDrop();
        } else {
            showAllUsersDrop();
        }
    }
    function onfailed(error) {
        alert(error.responseText);
    }
</script>
