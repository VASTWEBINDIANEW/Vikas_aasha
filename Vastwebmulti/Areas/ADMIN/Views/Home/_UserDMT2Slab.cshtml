                            </div>
                        </div>
                    </div>
                    <div class="vm-prepaid-user-filter__item">
                        <div class="vm-pg-slab-field">
                            <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-user"></i></span>
                            <input class="form-control" type="text" placeholder="User Name" value="@Model.Name" readonly="readonly" />
                        </div>
                    </div>
                    <div class="vm-prepaid-user-filter__item">
                        <div class="vm-pg-slab-field">
                            <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-phone-alt"></i></span>
                            <input class="form-control" type="text" placeholder="User Registered Number" value="@Model.Phone" readonly="readonly" />
                        </div>
                    </div>
                    <div class="vm-prepaid-user-filter__item">
                        <div class="vm-pg-slab-field">
                            <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-envelope"></i></span>
                            <input class="form-control" type="text" placeholder="User Registered Mail" value="@Model.Email" readonly="readonly" />
