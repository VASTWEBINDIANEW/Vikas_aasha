@model IEnumerable<Vastwebmulti.Models.extracommhistory_Result>
@using System
@using System.Linq
@using System.Collections.Generic
@using Vastwebmulti.Models
@{
    ViewBag.Title = "Extra Commission Status";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    VastwebmultiEntities db = new VastwebmultiEntities();

    var reports = Model ?? Enumerable.Empty<extracommhistory_Result>();
    var rowCount = reports.Count();
    var onCount = reports.Count(i => i.sts == true);
    var offCount = rowCount - onCount;

    var settings = db.daywisesettelecomms.ToList();
    var settingsRow = settings.FirstOrDefault();
    var daysCount = settingsRow != null ? (settingsRow.dayscounts ?? 0) : 0;
    var minAmount = settingsRow != null ? (settingsRow.minamount ?? 0m) : 0m;
    var maxAmount = settingsRow != null ? (settingsRow.maxamount ?? 0m) : 0m;
    var settingsOn = settingsRow != null && settingsRow.sts == true;

    var masters = db.Superstokist_details.OrderBy(s => s.FarmName).ToList();
    var selectedMaster = (Request["maststs"] ?? "").Trim();
    var selectedDealer = (Request["dealesds"] ?? "").Trim();
    var selectedRetailer = (Request["retailss"] ?? "").Trim();
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=54" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=34" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-security-report-page saas-closing-balance-report-page saas-daywise-comm-report-page">

    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell vm-daywise-comm-toolbar">
            <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line vm-gift-toolbar-one-line">
                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>Settings</li>
                    <li>Extra Commission Status</li>
                </ol>
            </div>
        </div>

        <div class="vm-opr-main-card vm-security-report-main-card vm-gift-report-main-card vm-daywise-comm-settings-card">
            <div class="vm-opr-table-panel vm-security-report-table-panel vm-gift-report-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head vm-security-report-table-head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-sliders-h" aria-hidden="true"></i>
                        <span>Daywise commission settings</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-daywise-comm-info" title="Configure days, amount range and global ON/OFF for extra commission">
                            <i class="fas fa-info-circle" aria-hidden="true"></i>
                        </span>
                    </div>
                </div>
                <div class="vm-opr-table-wrap vm-daywise-comm-settings-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table class="table vm-opr-data-table vm-daywise-comm-settings-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Days</th>
                                    <th>Minimum</th>
                                    <th>Maximum</th>
                                    <th>Edit</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr id="vmDaywiseSettingsView" class="vm-daywise-settings-view-row">
                                    <td class="vm-daywise-settings-view-cell" data-label="Days">@daysCount</td>
                                    <td class="vm-daywise-settings-view-cell" data-label="Minimum">@minAmount.ToString("N2")</td>
                                    <td class="vm-daywise-settings-view-cell" data-label="Maximum">@maxAmount.ToString("N2")</td>
                                    <td class="vm-daywise-settings-view-cell vm-daywise-settings-view-cell--edit" data-label="Edit">
                                        <button type="button" class="vm-daywise-comm-edit-btn" onclick="vmDaywiseShowSettingsEdit()">
                                            <i class="fas fa-edit" aria-hidden="true"></i><span>Edit</span>
                                        </button>
                                    </td>
                                    <td class="vm-daywise-settings-view-cell vm-daywise-settings-view-cell--status" data-label="Status">
                                        @if (settingsOn)
                                        {
                                            <a href="@Url.Action("Updatestsofdaily", "Home", new { sts = false })" class="vm-daywise-status-pill vm-daywise-status-pill--on vm-daywise-status-pill--link"><i class="fas fa-check-circle" aria-hidden="true"></i><span>ON</span></a>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("Updatestsofdaily", "Home", new { sts = true })" class="vm-daywise-status-pill vm-daywise-status-pill--off vm-daywise-status-pill--link"><i class="fas fa-times-circle" aria-hidden="true"></i><span>OFF</span></a>
                                        }
                                    </td>
                                </tr>
                                <tr id="vmDaywiseSettingsEdit" class="vm-daywise-settings-edit-row is-hidden">
                                    @using (Html.BeginForm("setcommdaywisests", "Home", FormMethod.Post, new { @class = "vm-daywise-settings-edit-form" }))
                                    {
                                        <td class="vm-daywise-settings-edit-cell" data-label="Days">
                                            <input type="number" class="form-control vm-daywise-settings-input" name="dayscount" value="@daysCount" min="0" placeholder="Days" />
                                        </td>
                                        <td class="vm-daywise-settings-edit-cell" data-label="Minimum">
                                            <input type="number" class="form-control vm-daywise-settings-input" name="minimums" value="@minAmount" min="0" step="0.01" placeholder="Minimum" />
                                        </td>
                                        <td class="vm-daywise-settings-edit-cell" data-label="Maximum">
                                            <input type="number" class="form-control vm-daywise-settings-input" name="maximum" value="@maxAmount" min="0" step="0.01" placeholder="Maximum" />
                                        </td>
                                        <td class="vm-daywise-settings-edit-cell vm-daywise-settings-edit-cell--actions" data-label="Actions" colspan="2">
                                            <div class="vm-daywise-settings-action-group">
                                                <button type="submit" class="vm-daywise-comm-save-btn">
                                                    <i class="fas fa-save" aria-hidden="true"></i><span>Save</span>
                                                </button>
                                                <button type="button" class="vm-daywise-comm-cancel-btn" onclick="vmDaywiseHideSettingsEdit()">
                                                    <i class="fas fa-times" aria-hidden="true"></i><span>Cancel</span>
                                                </button>
                                            </div>
                                        </td>
                                    }
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        @using (Html.BeginForm("daywisecomm", "Home", FormMethod.Post, new { id = "daywiseCommFilterForm", @class = "vm-rpt-filters-panel__form" }))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">
                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line vm-gift-toolbar-one-line">
                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters vm-ecomm-filter-row--one-line vm-gift-filter-row--one-line vm-daywise-comm-filter-row">

                        <div class="vm-opr-field vm-dmt-field vm-daywise-comm-field vm-daywise-comm-field--master">
                            <select id="maststs" name="maststs" class="vm-opr-select vm-dmt-select form-control">
                                <option value="">ALL Master</option>
                                @foreach (var master in masters)
                                {
                                    <option value="@master.SSId" @(master.SSId == selectedMaster ? "selected=\"selected\"" : "")>@master.FarmName</option>
                                }
                            </select>
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-daywise-comm-field vm-daywise-comm-field--dealer">
                            <select id="dealesds" name="dealesds" class="vm-opr-select vm-dmt-select form-control">
                                <option value="">ALL Dealer</option>
                            </select>
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-daywise-comm-field vm-daywise-comm-field--retailer">
                            <select id="retailss" name="retailss" class="vm-opr-select vm-dmt-select form-control">
                                <option value="">ALL Retailer</option>
                            </select>
                        </div>

                        <div class="vm-dmt-filter-search-group">
                            <button type="submit" name="btntype" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="vm-opr-main-card vm-security-report-main-card vm-gift-report-main-card vm-daywise-comm-report-main-card">
            <div class="vm-opr-table-panel vm-security-report-table-panel vm-gift-report-table-panel vm-daywise-comm-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head vm-security-report-table-head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-percentage" aria-hidden="true"></i>
                        <span>Extra commission status</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong id="daywiseCommRecordCount">@rowCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total vm-daywise-comm-on-badge" title="Active retailers">
                            ON: <strong id="daywiseCommOnCount">@onCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total vm-daywise-comm-off-badge" title="Inactive retailers">
                            OFF: <strong id="daywiseCommOffCount">@offCount</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-daywise-comm-bulk-actions">
                            <a href="@Url.Action("allonoffextracommsts", "Home", new { sts = true })" class="vm-daywise-bulk-btn vm-daywise-bulk-btn--on" title="Turn all ON">
                                <i class="fas fa-toggle-on" aria-hidden="true"></i><span>All ON</span>
                            </a>
                            <a href="@Url.Action("allonoffextracommsts", "Home", new { sts = false })" class="vm-daywise-bulk-btn vm-daywise-bulk-btn--off" title="Turn all OFF">
                                <i class="fas fa-toggle-off" aria-hidden="true"></i><span>All OFF</span>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap vm-daywise-comm-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="daywiseCommReportTable" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Sr.</th>
                                    <th>User</th>
                                    <th>Dealer</th>
                                    <th>Master</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (rowCount == 0)
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="5">No records found for the selected filters.</td>
                                    </tr>
                                }
                                else
                                {
                                    var sr = 1;
                                    var rowIndex = 0;
                                    foreach (var item in reports)
                                    {
                                        var retailer = !string.IsNullOrWhiteSpace(item.retailerid)
                                            ? db.Retailer_Details.FirstOrDefault(s => s.RetailerId == item.retailerid)
                                            : null;
                                        var dealer = retailer != null
                                            ? db.Dealer_Details.FirstOrDefault(s => s.DealerId == retailer.DealerId)
                                            : null;
                                        var master = dealer != null
                                            ? db.Superstokist_details.FirstOrDefault(s => s.SSId == dealer.SSId)
                                            : null;

                                        var userFirm = retailer != null ? retailer.Frm_Name : "-";
                                        var userName = retailer != null ? retailer.RetailerName : "-";
                                        var dealerName = dealer != null ? dealer.FarmName : "-";
                                        var masterName = master != null ? master.FarmName : "-";
                                        var isOn = item.sts == true;

                                        <tr class="vm-daywise-comm-row @(isOn ? "vm-daywise-comm-row--on" : "vm-daywise-comm-row--off")" data-status="@(isOn ? "on" : "off")">
                                            <td class="vm-closing-balance-sr">@sr</td>
                                            <td>
                                                <div class="vm-closing-balance-user">
                                                    <strong class="vm-closing-balance-user__firm">@userFirm</strong>
                                                    @if (!string.IsNullOrWhiteSpace(userName) && userName != "-")
                                                    {
                                                        <span class="vm-closing-balance-user__name">@userName</span>
                                                    }
                                                </div>
                                            </td>
                                            <td>@dealerName</td>
                                            <td>@masterName</td>
                                            <td class="vm-daywise-comm-status-cell idchanges" data-row-index="@rowIndex">
                                                @if (isOn)
                                                {
                                                    <button type="button" class="vm-daywise-status-pill vm-daywise-status-pill--on vm-daywise-status-pill--btn" onclick="stsupd('@item.retailerid', @rowIndex, false)"><i class="fas fa-check-circle" aria-hidden="true"></i><span>ON</span></button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="vm-daywise-status-pill vm-daywise-status-pill--off vm-daywise-status-pill--btn" onclick="stsupd('@item.retailerid', @rowIndex, true)"><i class="fas fa-times-circle" aria-hidden="true"></i><span>OFF</span></button>
                                                }
                                            </td>
                                        </tr>
                                        sr++;
                                        rowIndex++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>


<script>
    function vmDaywiseShowSettingsEdit() {
        $('#vmDaywiseSettingsView').addClass('is-hidden');
        $('#vmDaywiseSettingsEdit').removeClass('is-hidden');
        $('.vm-daywise-comm-settings-wrap').addClass('is-editing');
    }

    function vmDaywiseHideSettingsEdit() {
        $('#vmDaywiseSettingsEdit').addClass('is-hidden');
        $('#vmDaywiseSettingsView').removeClass('is-hidden');
        $('.vm-daywise-comm-settings-wrap').removeClass('is-editing');
    }

    function refreshDaywiseCommSummary() {
        var rows = document.querySelectorAll('#daywiseCommReportTable tbody tr.vm-daywise-comm-row');
        var onCount = 0;
        for (var i = 0; i < rows.length; i++) {
            if (rows[i].getAttribute('data-status') === 'on') {
                onCount++;
            }
        }
        $('#daywiseCommRecordCount').text(rows.length);
        $('#daywiseCommOnCount').text(onCount);
        $('#daywiseCommOffCount').text(rows.length - onCount);
    }

    function destroyDaywiseSelect2($el) {
        if ($el && $el.length && $el.data('select2')) {
            $el.select2('destroy');
        }
    }

    function applyDaywiseSelect2($el) {
        if (!$el || !$el.length || !$.fn.select2) {
            return;
        }
        destroyDaywiseSelect2($el);
        $el.select2({
            width: '100%',
            minimumResultsForSearch: 6,
            dropdownParent: $('#daywiseCommFilterForm')
        });
    }

    function setDaywiseSelectValue($el, value) {
        if (!$el || !$el.length) {
            return;
        }
        $el.val(value || '');
        if ($el.data('select2')) {
            $el.trigger('change.select2');
        }
    }

    function resetDaywiseDealerSelect() {
        var $dealer = $('#dealesds');
        destroyDaywiseSelect2($dealer);
        $dealer.empty().append($('<option>', { value: '', text: 'ALL Dealer' }));
        applyDaywiseSelect2($dealer);
    }

    function resetDaywiseRetailerSelect() {
        var $retailer = $('#retailss');
        destroyDaywiseSelect2($retailer);
        $retailer.empty().append($('<option>', { value: '', text: 'ALL Retailer' }));
        applyDaywiseSelect2($retailer);
    }

    function bindDaywiseFilterEvents() {
        $('#maststs').off('change.daywise').on('change.daywise', function () {
            changeidss();
        });
        $('#dealesds').off('change.daywise').on('change.daywise', function () {
            changeretailrsidss();
        });
    }

    function syncDaywiseSelectWidth() {
        $('.vm-daywise-comm-field').css({ width: '100%', maxWidth: '100%' });
        $('#daywiseCommFilterForm select').css({ width: '100%', maxWidth: '100%' });
        $('#daywiseCommFilterForm .select2-container').css({ width: '100%', maxWidth: '100%' });
    }

    function initDaywiseSelect2() {
        applyDaywiseSelect2($('#maststs'));
        applyDaywiseSelect2($('#dealesds'));
        applyDaywiseSelect2($('#retailss'));
        bindDaywiseFilterEvents();
        window.setTimeout(syncDaywiseSelectWidth, 0);
        window.setTimeout(syncDaywiseSelectWidth, 120);
    }

    function changeidss(selectedDealer, callback) {
        var masterid = ($('#maststs').val() || '').trim();
        if (!masterid) {
            resetDaywiseDealerSelect();
            resetDaywiseRetailerSelect();
            syncDaywiseSelectWidth();
            if (typeof callback === 'function') {
                callback();
            }
            return;
        }

        $.ajax({
            url: '@Url.Action("GetDealerDetails", "Home")',
            type: 'GET',
            data: { masterId: masterid },
            cache: false,
            success: function (data) {
                var $dealer = $('#dealesds');
                destroyDaywiseSelect2($dealer);
                $dealer.empty().append($('<option>', { value: '', text: 'ALL Dealer' }));
                if (data && data.length) {
                    $.each(data, function (_, dealerDetail) {
                        $dealer.append($('<option>', {
                            value: dealerDetail.DealerId,
                            text: dealerDetail.FarmName
                        }));
                    });
                }
                applyDaywiseSelect2($dealer);
                setDaywiseSelectValue($dealer, selectedDealer || '');
                resetDaywiseRetailerSelect();
                syncDaywiseSelectWidth();
                if (typeof callback === 'function') {
                    callback();
                }
            },
            error: function (xhr, status, error) {
                console.error('Dealer load error:', error);
                resetDaywiseDealerSelect();
                resetDaywiseRetailerSelect();
            }
        });
    }

    function changeretailrsidss(selectedRetailer) {
        var dealerid = ($('#dealesds').val() || '').trim();
        if (!dealerid) {
            resetDaywiseRetailerSelect();
            syncDaywiseSelectWidth();
            return;
        }

        $.ajax({
            url: '@Url.Action("GetReailerDetails", "Home")',
            type: 'GET',
            data: { masterId: dealerid },
            cache: false,
            success: function (data) {
                var $retailer = $('#retailss');
                destroyDaywiseSelect2($retailer);
                $retailer.empty().append($('<option>', { value: '', text: 'ALL Retailer' }));
                if (data && data.length) {
                    $.each(data, function (_, retailerDetail) {
                        $retailer.append($('<option>', {
                            value: retailerDetail.RetailerId,
                            text: retailerDetail.Frm_Name
                        }));
                    });
                }
                applyDaywiseSelect2($retailer);
                setDaywiseSelectValue($retailer, selectedRetailer || '');
                syncDaywiseSelectWidth();
            },
            error: function (xhr, status, error) {
                console.error('Retailer load error:', error);
                resetDaywiseRetailerSelect();
            }
        });
    }

    function restoreDaywiseFilters() {
        var postMaster = '@selectedMaster';
        var postDealer = '@selectedDealer';
        var postRetailer = '@selectedRetailer';

        if (!postMaster) {
            return;
        }

        setDaywiseSelectValue($('#maststs'), postMaster);
        changeidss(postDealer, function () {
            if (postDealer) {
                changeretailrsidss(postRetailer);
            }
        });
    }

    function stsupd(userid, rowIndex, nextStatus) {
        $.ajax({
            url: '@Url.Action("daywisecommupdate", "Home")',
            type: 'POST',
            data: { userid: userid, sts: nextStatus },
            cache: false,
            success: function (response) {
                if (response !== 'OK') {
                    return;
                }

                var $cell = $('.idchanges[data-row-index="' + rowIndex + '"]');
                var $row = $cell.closest('tr');
                if (nextStatus === true) {
                    $cell.html('<button type="button" class="vm-daywise-status-pill vm-daywise-status-pill--on vm-daywise-status-pill--btn" onclick="stsupd(\'' + userid + '\', ' + rowIndex + ', false)"><i class="fas fa-check-circle" aria-hidden="true"></i><span>ON</span></button>');
                    $row.removeClass('vm-daywise-comm-row--off').addClass('vm-daywise-comm-row--on').attr('data-status', 'on');
                } else {
                    $cell.html('<button type="button" class="vm-daywise-status-pill vm-daywise-status-pill--off vm-daywise-status-pill--btn" onclick="stsupd(\'' + userid + '\', ' + rowIndex + ', true)"><i class="fas fa-times-circle" aria-hidden="true"></i><span>OFF</span></button>');
                    $row.removeClass('vm-daywise-comm-row--on').addClass('vm-daywise-comm-row--off').attr('data-status', 'off');
                }
                refreshDaywiseCommSummary();
            }
        });
    }

    $(document).ready(function () {
        initDaywiseSelect2();
        restoreDaywiseFilters();
        refreshDaywiseCommSummary();
        $(window).on('resize orientationchange', syncDaywiseSelectWidth);
    });
</script>
