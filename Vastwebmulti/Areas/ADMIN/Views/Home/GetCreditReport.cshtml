@model IEnumerable<Vastwebmulti.Models.GetCreditDetails_Result>

@{

    ViewBag.Title = "GetCreditReport";

    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();

    var toDate = (Request["txt_to_date"] ?? "").Trim();

    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var creditRows = Model == null ? new List<Vastwebmulti.Models.GetCreditDetails_Result>() : Model.ToList();
    var creditTotalAmount = creditRows.Sum(x => x.Amount ?? 0);
    var creditTotalBalance = creditRows.Sum(x => x.ToRemainPose ?? 0);
    var creditTotalDue = creditRows.Sum(x => x.CrPose ?? 0);
    var creditTotalLiveDue = creditRows.Sum(x => x.livecr ?? 0);
    var creditHasRows = creditRows.Count > 0;
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />

<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />

<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />

<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />

<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />

<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />

<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />

<link href="~/MainFrontDesign/css/admin-credit-report-modern.css?v=2" rel="stylesheet" />

<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />

<script src="~/MainFrontDesign/js/admin-financial-report.js?v=11"></script>

<script src="~/MainFrontDesign/js/admin-credit-report.js?v=1"></script>



<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-credit-report-page">

    <div class="container-fluid vm-opr-page-shell">



        @using (Html.BeginForm("GetCreditReport", "Home", FormMethod.Post, new { id = "creditReportForm", @class = "vm-rpt-filters-panel__form" }))

        {

            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb">

                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>

                        <li>Financial Services</li>

                        <li>Credit Report</li>

                    </ol>

                    <div class="vm-dmt-fin-nav-row">

                        @Html.Partial("_finicalmenureport")

                    </div>

                </div>



                <div class="vm-rpt-filters-panel">

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--credit vm-rpt-filters-panel__bar">

                        <div class="vm-opr-field vm-dmt-field">

                            <select class="vm-opr-select vm-dmt-select form-control" data-live-search="true" id="ddlusers" name="RoleType" title="User type" onchange="answers()">

                                <option value="ALL">All User</option>

                                <option value="master">Master</option>

                                <option value="Dealer">Distributor</option>

                                <option value="Retailer">Retailer</option>

                                <option value="API">Api User</option>

                            </select>

                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="allmaster" style="display:none;">

                            @Html.DropDownList("allmaster1", ViewBag.allmaster as SelectList, "All Master", new { @class = "vm-opr-select vm-dmt-select form-control", @title = "Master" })

                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="dlm" style="display:none;">

                            @Html.DropDownList("alldealer", ViewBag.alldealer as SelectList, "All Distributor", new { id = "alldealer", @class = "vm-opr-select vm-dmt-select form-control", @title = "Distributor" })

                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="rem" style="display:none;">

                            @Html.DropDownList("allretailer", ViewBag.allretailer as SelectList, "All Retailer", new { id = "allretailer", @class = "vm-opr-select vm-dmt-select form-control", @title = "Retailer" })

                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="apiid" style="display:none;">

                            @Html.DropDownList("allapiuser", ViewBag.apiid as SelectList, "All API", new { id = "allapiuser", @class = "vm-opr-select vm-dmt-select form-control", @title = "API user" })

                        </div>

                        <div class="vm-dmt-filter-search-group">

                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">

                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>

                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })

                            </div>

                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">

                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>

                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })

                            </div>

                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search" title="Search">

                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>

                            </button>

                        </div>

                    </div>

                </div>

            </div>

        }



        <div class="vm-opr-main-card">

            <div class="vm-opr-table-panel">

                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">

                    <div class="vm-opr-table-panel__title">

                        <i class="fas fa-credit-card" aria-hidden="true"></i>

                        <span>Credit report</span>

                    </div>

                    <div class="vm-dmt-table-panel__right">

                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">

                            <button type="button" id="btnExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel"><i class="fas fa-file-excel" aria-hidden="true"></i> Excel</button>

                            <button type="button" id="btnPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF"><i class="fas fa-file-pdf" aria-hidden="true"></i> PDF</button>

                        </div>

                    </div>

                </div>

                <div class="vm-opr-table-wrap">

                    <div class="table-responsive vm-opr-table-scroll">

                        <table id="creditreport" class="table vm-opr-data-table" cellspacing="0">

                            <thead>
                                <tr>
                                    <th class="vm-credit-th vm-credit-th--from">Transfer From</th>
                                    <th class="vm-credit-th vm-credit-th--to">Transfer To</th>
                                    <th class="vm-credit-th vm-credit-th--frm">Frm Name</th>
                                    <th class="vm-credit-th vm-credit-th--person">Person Name</th>
                                    <th class="vm-credit-th vm-credit-th--mobile">Mobile No.</th>
                                    <th class="vm-credit-th vm-credit-th--district">District</th>
                                    <th class="vm-credit-th vm-credit-th--state">State</th>
                                    <th class="vm-credit-th vm-credit-th--amount">Admin Credit Amount</th>
                                    <th class="vm-credit-th vm-credit-th--balance">Account Balance</th>
                                    <th class="vm-credit-th vm-credit-th--due">Due Credit</th>
                                    <th class="vm-credit-th vm-credit-th--live">Live Due Credit</th>
                                    <th class="vm-credit-th vm-credit-th--time">Transfer Time</th>
                                </tr>
                            </thead>
                            <tbody id="trow">
                                @Html.Partial("_GetCreditReport", Model)
                            </tbody>
                            @if (creditHasRows)
                            {
                                <tfoot>
                                    <tr class="vm-credit-total-row">
                                        <td colspan="7" class="vm-credit-total-label">Total</td>
                                        <td class="vm-credit-amt-cell vm-credit-total-value">@creditTotalAmount</td>
                                        <td class="vm-credit-amt-cell vm-credit-total-value">@creditTotalBalance</td>
                                        <td class="vm-credit-amt-cell vm-credit-total-value">@creditTotalDue</td>
                                        <td class="vm-credit-amt-cell vm-credit-total-value">@creditTotalLiveDue</td>
                                        <td class="vm-credit-total-time">—</td>
                                    </tr>
                                </tfoot>
                            }
                        </table>

                        <div id="loadingdiv" class="vm-opr-table-loading" style="display:none;">

                            <img src="~/img/ajax-loader.gif" alt="Loading" />

                        </div>

                    </div>

                </div>

            </div>

        </div>



    </div>

</section>



<script src="~/MainFrontDesign/select2/dist/js/select2.full.min.js"></script>



<script>

    function buildCreditExportQuery() {

        return 'txt_frm_date=' + encodeURIComponent($('#txt_frm_date').val())

            + '&txt_to_date=' + encodeURIComponent($('#txt_to_date').val())

            + '&RoleType=' + encodeURIComponent($('#ddlusers').val() || '')

            + '&allmaster1=' + encodeURIComponent($('#allmaster1').val() || '')

            + '&alldealer=' + encodeURIComponent($('#alldealer').val() || '')

            + '&allretailer=' + encodeURIComponent($('#allretailer').val() || '')

            + '&allapiuser=' + encodeURIComponent($('#allapiuser').val() || '');

    }



    $('#btnExport').click(function () {

        location.href = '@Url.Action("ExcelCreditReport", "Home")?' + buildCreditExportQuery();

    });



    $('#btnPDF').click(function () {

        window.open('@Url.Action("PDFCreditReport", "Home")?' + buildCreditExportQuery(), '_blank');

    });



    $(document).ready(function () {

        $('#txt_frm_date, #txt_to_date').datepicker({

            format: 'yyyy-mm-dd',

            todayHighlight: true,

            autoclose: true,

            orientation: 'bottom auto'

        });

        var val = '@ViewBag.chk';

        if (val != 'post') {

            $('#txt_frm_date').datepicker('setDate', new Date());

            $('#txt_to_date').datepicker('setDate', new Date());

        }

    });

</script>

