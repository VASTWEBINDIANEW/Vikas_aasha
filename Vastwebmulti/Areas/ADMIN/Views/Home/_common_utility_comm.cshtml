@model Vastwebmulti.Areas.ADMIN.Models.PostpaidUtilitySlab
@using (Ajax.BeginForm("_common_utility_comm", "Home", new AjaxOptions { HttpMethod = "POST", OnSuccess = "OnSuccess", UpdateTargetId = "divEditFormComm", LoadingElementId = "div_Loader", InsertionMode = InsertionMode.Replace }))
{
    <input id="btnsubmit" type="submit" value="Save Data" class="btn waves-effect vm-pg-slab-save-btn" style="display:none;" />
    <div class="vm-pg-slab-table-scroll saas-acc-table-wrap vm-prepaid-slab-table-wrap">
        <table id="postpaidUtilitySlabTable" class="table table-bordered vm-pg-slab-table third-design-table slab-table">
            <thead>
                <tr>
                    <th>Operator&nbsp;Name</th>
                    <th class="vm-postpaid-optype-head">
                        <span class="vm-postpaid-optype-head__label">Operator&nbsp;Type</span>
                        <div class="vm-postpaid-optype-filter">
                            @Html.DropDownList("ddlOPttype", Model.OPttype.Distinct(), new { @class = "form-control vm-postpaid-optype-select", @onchange = "ddlopttypeChange()" })
                        </div>
                    </th>
                    <th>Master&nbsp;(M/D)</th>
                    <th>Distributor</th>
                    <th>Retailer </th>
                    <th>Api User</th>
                    <th>Whitelabel</th>
                    @*<th>Retailer > Common</th>*@
                </tr>
                <tr class="vm-postpaid-reduce-row">
                    <th></th>
                    <th></th>
                    <th colspan="3" style="text-align:center;">
                        <button type="button" onclick="extraretailer()" class="vm-prepaid-reduce-btn">Reduce Commission by Categsory</button>
                    </th>
                    <th>
                        <button type="button" onclick="extraapi()" class="vm-prepaid-reduce-btn">Reduce..</button>
                    </th>
                    <th>
                        <button type="button" class="vm-prepaid-reduce-btn">Reduce..</button>
                    </th>
                </tr>
            </thead>
            <tbody id="tbodyshow" class="vm-pg-slab-tbody--view">
                @foreach (var item in Model.common)
                {
                    <tr>
                        <td><p>@item.OperatorName</p></td>
                        <td><p>@item.opttype</p></td>
                        <td>@item.mastercomm</td>
                        <td>@item.dlmcomm</td>
                        <td>@item.dlm_rem_comm</td>
                        <td>@item.apicomm</td>
                        <td>@item.whitelabelcomm</td>
                        @*<td>@item.retailercomm</td>*@
                    </tr>
                }
            </tbody>
            <tbody id="tbodyedit" class="vm-pg-slab-tbody--hidden">
                <tr>
                    <td></td>
                    <td>
                        <input type="button" value="Reduce Comm by Categsory" class="vm-prepaid-reduce-btn" onclick="commonreplace()" />
                    </td>
                    <td class="vm-pg-slab-edit-cell">
                        <input type="text" id="common1" placeholder="Master Comm" class="vm-pg-slab-cell-input" />
                    </td>
                    <td class="vm-pg-slab-edit-cell">
                        <input type="text" id="common2" placeholder="Distributor Comm" class="vm-pg-slab-cell-input" />
                    </td>
                    <td class="vm-pg-slab-edit-cell">
                        <input type="text" id="common3" placeholder="Retailer Comm" class="vm-pg-slab-cell-input" />
                    </td>
                    <td class="vm-pg-slab-edit-cell">
                        <input type="text" id="common4" placeholder="Api Comm" class="vm-pg-slab-cell-input" />
                    </td>
                    <td class="vm-pg-slab-edit-cell">
                        <input type="text" id="common5" placeholder="Whitelabel Comm" class="vm-pg-slab-cell-input" />
                    </td>
                </tr>
                @for (int i = 0; i < Model.common.Count; i++)
                {
                    <tr>
                        @Html.HiddenFor(a => a.common[i].idno)
                        <td>
                            @Html.DisplayFor(a => a.common[i].OperatorName)
                        </td>
                        <td>
                            @Html.DisplayFor(a => a.common[i].opttype)
                        </td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.common[i].mastercomm, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input commonmaster" } })
                            @Html.ValidationMessageFor(a => a.common[i].mastercomm)
                        </td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.common[i].dlmcomm, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input commondlm" } })
                            @Html.ValidationMessageFor(a => a.common[i].dlmcomm)
                        </td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.common[i].dlm_rem_comm, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input commonrem" } })
                            @Html.ValidationMessageFor(a => a.common[i].dlm_rem_comm)
                        </td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.common[i].apicomm, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input commonapi" } })
                            @Html.ValidationMessageFor(a => a.common[i].apicomm)
                        </td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.common[i].whitelabelcomm, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input commonwhite" } })
                            @Html.ValidationMessageFor(a => a.common[i].whitelabelcomm)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<script>
    function OnSuccess() {
        if (typeof resetSlabViewMode === 'function') {
            resetSlabViewMode();
        } else {
            $('#btnsubmit').hide();
            $('#btnEdit').show();
        }
    }
</script>
