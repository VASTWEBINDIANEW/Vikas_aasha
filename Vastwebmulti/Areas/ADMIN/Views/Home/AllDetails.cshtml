@model IEnumerable<Vastwebmulti.Models.show_all_account_Result>
@using System.Linq
@using Vastwebmulti.Models
@{
    ViewBag.Title = "AllDetails";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var rows = Model != null ? Model.ToList() : new List<show_all_account_Result>();
    var rowCount = rows.Count;
    var db = new VastwebmultiEntities();
    var virtualAmount = db.Remain_Admin_balance.FirstOrDefault()?.VirtualAmount ?? 0m;
    var mismatchCount = rows.Count(r => r.total != virtualAmount);
    var frmDate = (ViewBag.frmDate as string) ?? "";
    var toDate = (ViewBag.toDate as string) ?? "";
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-settings-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />

<section class="content tmw-Alldetails fourdesign-section-admin saas-admin-account-page saas-admin-settings-page saas-admin-report-page saas-alldetails-page">
    <div class="container-fluid">

        

        @using (Html.BeginForm("AllDetails", "Home", FormMethod.Post, new { @class = "saas-pan-toolbar-form saas-alldetails-filter", id = "allDetailsForm", data_date_mode = (ViewBag.chk as string) == "post" ? "post" : "get", data_frm_date = frmDate, data_to_date = toDate }))
        {
            <div class="saas-acc-toolbar saas-pan-toolbar-unified">
                <ol class="saas-acc-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>All Transaction Virtual Info</li>
                </ol>
                <div class="saas-acc-toolbar-right saas-pan-toolbar-dates">
                    <div class="saas-acc-report-date-controls saas-pan-date-controls">
                        <div class="saas-report-date-fields">
                            <div class="saas-acc-dp-field">
                                <label class="saas-acc-dp-label" for="txt_frm_date">From date</label>
                                <span class="saas-acc-dp-icon" title="From date"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "yyyy-mm-dd" })
                            </div>
                            <div class="saas-acc-dp-field">
                                <label class="saas-acc-dp-label" for="txt_to_date">To date</label>
                                <span class="saas-acc-dp-icon" title="To date"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "yyyy-mm-dd" })
                            </div>
                        </div>
                        <div class="saas-report-toolbar-actions">
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn saas-alldetails-search-btn">
                                <i class="fas fa-search" aria-hidden="true"></i> Search
                            </button>
                            <div class="saas-acc-export-group saas-pan-export-group">
                                <button type="button" class="saas-acc-btn saas-acc-btn--excel saas-pan-export-btn" id="btnExport">
                                    <i class="fas fa-file-excel" aria-hidden="true"></i> Export
                                </button>
                                <button type="button" class="saas-acc-btn saas-acc-btn--pdf saas-pan-export-btn" id="btnPDF">
                                    <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        

        <div class="saas-acc-table-card" id="allDetailsExport">
            <div class="saas-acc-table-card-head">
                <h3>Virtual transaction ledger</h3>
                <span>Red rows = total ≠ virtual balance</span>
            </div>
            <div class="saas-acc-table-wrap table-responsive alldetails-report" id="showreport">
                <table id="example" class="table saas-acc-table saas-acc-table--ledger example-second third-design-table">
                    <thead>
                        <tr>
                            <th>Order Id</th>
                            <th class="col-text">Transaction Details</th>
                            <th>Admin Bal</th>
                            <th>M/D Bal</th>
                            <th>Distributor Bal</th>
                            <th>Retailer Bal</th>
                            <th>POS Bal</th>
                            <th>API Bal</th>
                            <th>W/L Bal</th>
                            <th>Total</th>
                            <th>Date &amp; Time</th>
                        </tr>
                    </thead>
                    <tbody id="trow" class="alin">
                        @{ Html.RenderAction("AllDetails_paging", "Home", new { Model = Model }); }
                    </tbody>
                </table>
                <div id="loadingdiv" class="saas-acc-infinite-loader" style="display:none;">
                    <img src="~/img/ajax-loader.gif" alt="Loading" />
                    <p style="margin:8px 0 0;font-size:0.8rem;color:#64748b;">Loading more records…</p>
                </div>
            </div>
        </div>

    </div>
</section>

<script src="~/AdminDesign/plugins/jquery-datatable/jquery.dataTables.js"></script>
<script src="~/AdminDesign/js/pages/forms/basic-form-elements.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.22/pdfmake.min.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.4.1/html2canvas.min.js"></script>

<script>
    function cancel(e) {
        $('#disp-' + e).show();
        $('#confirm-' + e).hide();
        $('#close-' + e).hide();
    }

    function disputedata(e) {
        var txt_frm_date = $('#txt_frm_date').val();
        var txt_to_date = $('#txt_to_date').val();
        $.post("@Url.Action("dispute", "Home")", { "id": e, "txtregion": "" }, function () {
            $.post("@Url.Action("InfiniteScroll2", "Home")",
                { pageindex: pageindex, txt_frm_date: txt_frm_date, txt_to_date: txt_to_date },
                function (data) {
                    $("#trow").html(data.HTMLString);
                });
        });
    }
</script>

<script>
    var txt_frm_date = $('#txt_frm_date').val();
    var txt_to_date = $('#txt_to_date').val();
    var pageindex = 1;
    var NoMoredata = false;
    var inProgress = false;

    $(window).scroll(function () {
        var $table = $('#example');
        if (!$table.length) return;
        if ($(window).scrollTop() > $table.height() / 4 && !NoMoredata && !inProgress) {
            inProgress = true;
            $("#loadingdiv").show();
            txt_frm_date = $('#txt_frm_date').val();
            txt_to_date = $('#txt_to_date').val();
            $.post("@Url.Action("InfiniteScroll2", "Home")",
                { pageindex: pageindex, txt_frm_date: txt_frm_date, txt_to_date: txt_to_date },
                function (data) {
                    pageindex = pageindex + 1;
                    NoMoredata = data.NoMoredata;
                    $("#trow").append(data.HTMLString);
                    $("#loadingdiv").hide();
                    inProgress = false;
                });
        }
    });
</script>

<script>
    $("#btnExport").click(function () {
        var from = $('#txt_frm_date').val();
        var to = $('#txt_to_date').val();
        location.href = '@Url.Action("Excel_AllDetails_paging", "Home")?txt_frm_date=' + from + '&txt_to_date=' + to;
    });

    $("#btnPDF").click(function () {
        var el = document.getElementById('allDetailsExport');
        if (!el || typeof html2canvas === 'undefined') return;
        html2canvas(el, {
            onrendered: function (canvas) {
                pdfMake.createPdf({
                    content: [{ image: canvas.toDataURL(), width: 500 }]
                }).download('All_Account_Detail.pdf');
            }
        });
    });
</script>
