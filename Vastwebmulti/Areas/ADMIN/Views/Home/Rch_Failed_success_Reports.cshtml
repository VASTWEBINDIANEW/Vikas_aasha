@model List<Vastwebmulti.Models.Proc_Recharge_info_Failed_TO_Success_Reports_Result>
@using System.Linq
@{
    ViewBag.Title = "Recharge Failed Success Reports";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var rows = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.Proc_Recharge_info_Failed_TO_Success_Reports_Result>();
    var frmDate = (ViewBag.frmDate as string) ?? DateTime.Today.ToString("yyyy-MM-dd");
    var toDate = (ViewBag.toDate as string) ?? DateTime.Today.ToString("yyyy-MM-dd");
    var unreadCount = rows.Count(r => r.ISREAD == false);
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-settings-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-settings-page saas-admin-report-page">
    <div class="container-fluid">

        @using (Html.BeginForm("Rch_Failed_success_Reports", "Home", FormMethod.Post, new { id = "rchFailedReportForm", data_date_mode = (ViewBag.chk as string) == "post" ? "post" : "get", data_frm_date = frmDate, data_to_date = toDate, @style = "margin: 0 0 20px;" }))
        {
            <div class="saas-acc-toolbar saas-pan-toolbar-unified">
                <ol class="saas-acc-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>Recharge Failed to Success Reports</li>
                </ol>
                <div class="saas-acc-toolbar-right saas-pan-toolbar-dates">
                    <div class="saas-acc-report-date-controls saas-pan-date-controls">
                        <div class="saas-report-date-fields">
                            <div class="saas-acc-dp-field">
                                <label class="saas-acc-dp-label" for="txt_frm_date">From date</label>
                                <span class="saas-acc-dp-icon" title="From date"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "yyyy-mm-dd" })
                            </div>
                            <div class="saas-acc-dp-field">
                                <label class="saas-acc-dp-label" for="txt_to_date">To date</label>
                                <span class="saas-acc-dp-icon" title="To date"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "yyyy-mm-dd" })
                            </div>
                        </div>
                        <div class="saas-report-toolbar-actions">
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn">
                                <i class="fas fa-search" aria-hidden="true"></i> Search
                            </button>
                            <div class="saas-acc-export-group saas-pan-export-group">
                                <button type="button" class="saas-acc-btn saas-acc-btn--excel saas-pan-export-btn" id="btnExport">
                                    <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                                </button>
                                <button type="button" class="saas-acc-btn saas-acc-btn--pdf saas-pan-export-btn" id="btnPDF">
                                    <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="saas-acc-table-card">
            <div class="saas-acc-table-card-head">
                <h3>Failed to success recharge log</h3>
                <span class="saas-acc-row-count">
                    <i class="fas fa-list" aria-hidden="true"></i> @rows.Count records
                    @if (unreadCount > 0)
                    {
                        <span class="saas-pan-report-meta"><i class="fas fa-envelope" aria-hidden="true"></i> @unreadCount unread</span>
                    }
                    <span class="saas-pan-report-meta"><i class="fas fa-calendar-alt" aria-hidden="true"></i> @frmDate to @toDate</span>
                </span>
            </div>
            <div class="saas-acc-table-wrap table-responsive">
                <table class="table saas-acc-table table-bordered" id="rchFailedTable">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Rch time</th>
                            <th>Operator</th>
                            <th>Consumer</th>
                            <th>Port/API</th>
                            <th>Request</th>
                            <th>Operator ID</th>
                            <th>Response</th>
                            <th>Modify time</th>
                            <th>Modify status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (rows.Count == 0)
                        {
                            <tr>
                                <td colspan="10" class="saas-pan-empty-cell">No records for selected dates.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in rows)
                            {
                                var isUnread = item.ISREAD == false;
                                <tr class="rch-row-click @(isUnread ? "saas-rch-row--unread" : "")" data-idno="@item.idno" style="cursor:pointer;">
                                    <td data-label="User">
                                        <i class="fa @(isUnread ? "fa-envelope" : "fa-envelope-open")" id="iconechange_@item.idno" aria-hidden="true"></i>
                                        @item.usertype @item.frmname
                                    </td>
                                    <td data-label="Rch time">@item.Rch_time</td>
                                    <td data-label="Operator">@item.operator_Name</td>
                                    <td data-label="Consumer">@item.Mobile</td>
                                    <td data-label="Port">@item.portno</td>
                                    <td data-label="Request">@item.Rch_time</td>
                                    <td data-label="Op ID">@item.OPt_id</td>
                                    <td data-label="Response">@item.Resp_time</td>
                                    <td data-label="Modify time">@item.Modify_time</td>
                                    <td data-label="Status">@item.modifystaus <span>(@item.rchidno)</span></td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<script>
    $(document).on('click', '.rch-row-click', function () {
        var idno = $(this).data('idno');
        var $icon = $('#iconechange_' + idno);
        $.get('@Url.Action("StatusChangeReadreport", "Home")', { idno: idno }, function (result) {
            if (result === true) {
                $icon.removeClass('fa-envelope').addClass('fa-envelope-open');
                $('.rch-row-click[data-idno="' + idno + '"]').removeClass('saas-rch-row--unread');
            }
        });
    });

    $('#btnExport').on('click', function () {
        var f = $('#txt_frm_date').val();
        var t = $('#txt_to_date').val();
        location.href = '@Url.Action("Excel_Rch_Failed_success_Reports", "Home")?txt_frm_date=' + encodeURIComponent(f) + '&txt_to_date=' + encodeURIComponent(t);
    });

    $('#btnPDF').on('click', function () {
        var f = $('#txt_frm_date').val();
        var t = $('#txt_to_date').val();
        window.open('@Url.Action("PDF_Rch_Failed_success_Reports", "Home")?txt_frm_date=' + encodeURIComponent(f) + '&txt_to_date=' + encodeURIComponent(t), '_blank');
    });
</script>
