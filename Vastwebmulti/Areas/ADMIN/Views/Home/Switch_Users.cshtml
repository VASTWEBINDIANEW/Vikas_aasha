@model Vastwebmulti.Areas.ADMIN.ViewModel.SwitchUserModel
@{
    ViewBag.Title = "Switch Users";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-fund-transfer-modern.css?v=27" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-fund-transfer-mobile.css?v=23" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-master-list-modern.css?v=19" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-api-user-page.css?v=7" rel="stylesheet" />

<section class="content Switch_Users_Page New_Employee_Page Masterlist-page saas-admin-account-page saas-admin-report-page saas-fund-transfer-page saas-fund-user-page saas-master-list-page saas-fund-transfer-premium">

    <div class="container-fluid vm-ft-page-shell">

        <!-- -- Toolbar: Breadcrumb + Search -- -->
        <div class="vm-ft-page-toolbar vm-ft-page-toolbar--premium">
            <div class="vm-ft-page-hero">
                <ol class="vm-ft-breadcrumb">
                    <li><a href="@Url.Action("Dashboard","Home")"><i class="fas fa-home"></i> Dashboard</a></li>
                    <li>User's &amp; Account</li>
                    <li>Switch Users</li>
                </ol>
            </div>
            <div class="vm-ft-search-wrap">
                <input class="form-control vm-ne-search" type="text" id="myInput"
                       placeholder="Search switch history..." onkeyup="suSearchTable()" autocomplete="off" />
            </div>
        </div>

        <!-- -- Two-column layout -- -->
        <div class="col-md-12 vm-ft-layout-wrap">
            <div class="row clearfix vm-ft-layout vm-ft-layout--full">

                <!-- ====== LEFT: Switch User Form ====== -->
                <div class="col-md-4 col-sm-12 vm-ft-form-col">
                    <div class="fund-trasfer-left fund-user-left vm-ft-form-card">

                        <!-- Card header -->
                        <div class="vm-ft-form-card-header">
                            <div class="vm-ft-form-card-header__icon"><i class="fas fa-exchange-alt"></i></div>
                            <div>
                                <span class="vm-ft-form-card-header__title">Switch Users</span>
                                <span class="vm-ft-form-card-header__sub">Move user to new hierarchy</span>
                            </div>
                        </div>

                        <!-- Tabs -->
                        <div class="au-tabs">
                            <button type="button" class="au-tab-btn active" id="tab-btn-dist"
                                    onclick="switchSUTab('panel-dist','@Url.Action("ChangeTabtype","Home",new { Utype="dealer"})',this)">
                                <i class="fas fa-building"></i> Distributor Switch
                            </button>
                            <button type="button" class="au-tab-btn" id="tab-btn-ret"
                                    onclick="switchSUTab('panel-ret','@Url.Action("ChangeTabtype","Home",new { Utype="Retailer"})',this)">
                                <i class="fas fa-store"></i> Retailer Switch
                            </button>
                        </div>

                        <!-- -- Tab Panel 1: Distributor Switch -- -->
                        <div id="panel-dist" class="au-tab-content active su-tab-panel" style="display:block;padding:14px 16px;">
                            <form id="frmdealtomd" class="fund-transfer-form">

                                <div class="form-group">
                                    <label><i class="fas fa-building" style="color:#3b82f6;margin-right:4px;font-size:.68rem;"></i> Select Distributor</label>
                                    @Html.DropDownList("dealerid", new SelectList(ViewBag.dealerid, "Value", "Text"), "Select Dealer Id", new { @class = "form-control", @required = "required" })
                                </div>

                                <!-- Distributor detail info card (latest design) -->
                                <div class="distributor-detail su-detail-card" style="display:none;">
                                    <div class="su-detail-head">
                                        <span class="su-avatar" id="DISAVATAR">?</span>
                                        <span class="su-head-text">
                                            <span class="su-head-name" id="DISHEADNAME"></span>
                                            <span class="su-head-firm" id="DISHEADFIRM"></span>
                                        </span>
                                        <span class="su-verified"><i class="fas fa-check-circle"></i> Selected</span>
                                    </div>
                                    <div class="su-detail-body">
                                        <div class="su-detail-row"><span class="su-ic su-ic-user"><i class="fas fa-user"></i></span><span class="su-tx"><span class="su-detail-label">Name</span><span id="DISNAME" class="su-detail-value"></span></span></div>
                                        <div class="su-detail-row"><span class="su-ic su-ic-firm"><i class="fas fa-store"></i></span><span class="su-tx"><span class="su-detail-label">Firm</span><span id="DISfrmname" class="su-detail-value"></span></span></div>
                                        <div class="su-detail-row"><span class="su-ic su-ic-mobile"><i class="fas fa-mobile-alt"></i></span><span class="su-tx"><span class="su-detail-label">Mobile</span><span id="DISmobile" class="su-detail-value"></span></span></div>
                                        <div class="su-detail-row"><span class="su-ic su-ic-email"><i class="fas fa-envelope"></i></span><span class="su-tx"><span class="su-detail-label">Email</span><span id="DISEMAIL" class="su-detail-value"></span></span></div>
                                        <div class="su-detail-row"><span class="su-ic su-ic-addr"><i class="fas fa-map-marker-alt"></i></span><span class="su-tx"><span class="su-detail-label">Address</span><span id="DISADDRESS" class="su-detail-value"></span></span></div>
                                        <div class="su-detail-row"><span class="su-ic su-ic-md"><i class="fas fa-sitemap"></i></span><span class="su-tx"><span class="su-detail-label">Current M/D</span><span id="DISCRNTMD" class="su-detail-value"></span></span></div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label><i class="fas fa-sitemap" style="color:#3b82f6;margin-right:4px;font-size:.68rem;"></i> Select New M/D</label>
                                    @Html.DropDownList("masterid", new SelectList(ViewBag.masterid, "Value", "Text"), "Select Master Dealer Id", new { @class = "form-control", @required = "required" })
                                </div>

                                <div class="ne-form-footer">
                                    <button type="reset" class="ne-btn-reset">
                                        <i class="fas fa-times"></i> Cancel
                                    </button>
                                    <button type="submit" class="ne-btn-submit">
                                        <i class="fas fa-exchange-alt"></i> Move User
                                    </button>
                                </div>

                            </form>
                        </div>

                        <!-- -- Tab Panel 2: Retailer Switch -- -->
                        <div id="panel-ret" class="au-tab-content su-tab-panel" style="display:none;padding:14px 16px;">
                            <form id="frmretdeal" class="fund-transfer-form">

                                <div class="form-group">
                                    <label><i class="fas fa-store" style="color:#3b82f6;margin-right:4px;font-size:.68rem;"></i> Select Retailer</label>
                                    @Html.DropDownList("retailerid", new SelectList(ViewBag.Retailerids, "Value", "Text"), "Select Retailer Id", new { @class = "form-control", @required = "required" })
                                </div>

                                <!-- Retailer detail info card (latest design) -->
                                <div class="distributor-details su-detail-card" style="display:none;">
                                    <div class="su-detail-head su-detail-head-green">
                                        <span class="su-avatar" id="RETAVATAR">?</span>
                                        <span class="su-head-text">
                                            <span class="su-head-name" id="RETHEADNAME"></span>
                                            <span class="su-head-firm" id="RETHEADFIRM"></span>
                                        </span>
                                        <span class="su-verified"><i class="fas fa-check-circle"></i> Selected</span>
                                    </div>
                                    <div class="su-detail-body">
                                        <div class="su-detail-row"><span class="su-ic su-ic-user"><i class="fas fa-user"></i></span><span class="su-tx"><span class="su-detail-label">Name</span><span id="RETNAME" class="su-detail-value"></span></span></div>
                                        <div class="su-detail-row"><span class="su-ic su-ic-firm"><i class="fas fa-store"></i></span><span class="su-tx"><span class="su-detail-label">Firm</span><span id="RETfrmname" class="su-detail-value"></span></span></div>
                                        <div class="su-detail-row"><span class="su-ic su-ic-mobile"><i class="fas fa-mobile-alt"></i></span><span class="su-tx"><span class="su-detail-label">Mobile</span><span id="RETmobile" class="su-detail-value"></span></span></div>
                                        <div class="su-detail-row"><span class="su-ic su-ic-email"><i class="fas fa-envelope"></i></span><span class="su-tx"><span class="su-detail-label">Email</span><span id="RETEMAIL" class="su-detail-value"></span></span></div>
                                        <div class="su-detail-row"><span class="su-ic su-ic-addr"><i class="fas fa-map-marker-alt"></i></span><span class="su-tx"><span class="su-detail-label">Address</span><span id="RETADDRESS" class="su-detail-value"></span></span></div>
                                        <div class="su-detail-row"><span class="su-ic su-ic-md"><i class="fas fa-building"></i></span><span class="su-tx"><span class="su-detail-label">Distributor</span><span id="RETCRNTMD" class="su-detail-value"></span></span></div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label><i class="fas fa-building" style="color:#3b82f6;margin-right:4px;font-size:.68rem;"></i> Select New Distributor</label>
                                    @Html.DropDownList("dealerdetailsid", new SelectList(ViewBag.dealerid, "Value", "Text"), "Select Dealer Id", new { @class = "form-control", @required = "required" })
                                </div>

                                <div class="ne-form-footer">
                                    <button type="reset" class="ne-btn-reset">
                                        <i class="fas fa-times"></i> Cancel
                                    </button>
                                    <button type="submit" class="ne-btn-submit">
                                        <i class="fas fa-exchange-alt"></i> Move User
                                    </button>
                                </div>

                            </form>
                        </div>

                    </div>
                </div>
                <!-- ====== END LEFT ====== -->

                <!-- ====== RIGHT: Switch History ====== -->
                <div class="col-md-8 col-sm-12 fund-transfer-main-admin vm-ft-history-col" style="padding-left:0;">
                    <div class="fund-trasfer-right fund-user-right vm-ft-history-panel">
                        <div class="vm-ft-history-body">

                            <!-- Panel toolbar header -->
                            <div class="vm-ft-history-toolbar vm-ft-history-toolbar--premium vm-ml-list-toolbar">
                                <div class="vm-ml-list-toolbar__row">
                                    <div class="vm-ft-history-toolbar__head vm-ml-list-toolbar__head">
                                        <i class="fas fa-history" aria-hidden="true"></i>
                                        <div class="vm-ml-list-toolbar__text">
                                            <span class="vm-ft-history-toolbar__title">Switch History</span>
                                            <span class="vm-ft-history-toolbar__sub">View &amp; track user switch logs</span>
                                        </div>
                                    </div>
                                    <div class="vm-ft-export-group vm-ml-list-toolbar__exports">
                                        <button type="button" id="btnExport" class="vm-ft-export-btn vm-ft-export-btn--excel" title="Export Excel">
                                            <i class="fas fa-file-excel" aria-hidden="true"></i>
                                        </button>
                                        <button type="button" id="btnPDF" class="vm-ft-export-btn vm-ft-export-btn--pdf" title="Export PDF">
                                            <i class="fas fa-file-pdf" aria-hidden="true"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Switch history table (AJAX target) -->
                            <div id="dlmd" class="vm-ml-table-host" style="overflow-x:auto;overflow-y:auto;max-height:72vh;">
                                @Html.Partial("_SwitchUsertable", Model)
                            </div>
                            <div id="loadingdiv" style="text-align:center;display:none;margin-bottom:20px;">
                                <img src="~/img/ajax-loader.gif" />
                            </div>

                        </div>
                    </div>
                </div>
                <!-- ====== END RIGHT ====== -->

            </div>
        </div>

    </div>
</section>

<style>
    /* -- Select2 full width inside Switch Users form card -- */
    .Switch_Users_Page .fund-transfer-form .select2-container {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
    }
    .Switch_Users_Page .fund-transfer-form .select2-container--default .select2-selection--single {
        height: 34px !important;
        min-height: 34px !important;
        border-radius: 8px !important;
        border: 1px solid #dbe2ea !important;
        background: #f8fafc !important;
    }
    .Switch_Users_Page .fund-transfer-form .select2-selection--single .select2-selection__rendered {
        line-height: 32px !important;
        font-size: 0.78rem !important;
        color: #334155 !important;
        padding-left: 10px !important;
        padding-right: 28px !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        white-space: nowrap !important;
    }
    .Switch_Users_Page .fund-transfer-form .select2-selection__arrow {
        height: 32px !important;
        right: 6px !important;
    }

    /* -- Detail info card (latest design: gradient head + avatar + icon rows) -- */
    .su-detail-card {
        background: #fff;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
        margin: 6px 0 12px;
        box-shadow: 0 4px 14px rgba(15,23,42,.08);
        animation: suPop .25s ease;
    }
    @@keyframes suPop {
        from { opacity: 0; transform: translateY(-5px); }
        to { opacity: 1; transform: none; }
    }
    .su-detail-head {
        display: flex; align-items: center; gap: 10px;
        background: linear-gradient(135deg,#2563eb,#1d4ed8 60%,#1e3a8a);
        padding: 10px 12px; color: #fff;
    }
    .su-detail-head-green { background: linear-gradient(135deg,#059669,#047857 60%,#065f46); }
    .su-avatar {
        width: 38px; height: 38px; border-radius: 50%; flex: 0 0 auto;
        background: rgba(255,255,255,.22); border: 2px solid rgba(255,255,255,.75);
        display: flex; align-items: center; justify-content: center;
        font-weight: 700; font-size: 17px; text-transform: uppercase;
    }
    .su-head-text { display: flex; flex-direction: column; min-width: 0; flex: 1; }
    .su-head-name { font-weight: 700; font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .su-head-firm { font-size: 11.5px; opacity: .92; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .su-verified { font-size: 10.5px; background: rgba(255,255,255,.22); padding: 3px 9px; border-radius: 20px; white-space: nowrap; }
    .su-verified i { margin-right: 2px; }
    .su-detail-body { padding: 4px 12px 8px; }
    .su-detail-row {
        display: flex; align-items: center; gap: 10px;
        padding: 7px 0; font-size: 13px; color: #334155;
        border-bottom: 1px dashed #eef2f7;
    }
    .su-detail-row:last-child { border-bottom: none; }
    .su-detail-icon { display: none; }
    .su-ic {
        width: 28px; height: 28px; border-radius: 8px; flex: 0 0 auto;
        display: flex; align-items: center; justify-content: center;
        font-size: 12px; color: #fff;
    }
    .su-ic-user   { background: linear-gradient(135deg,#3b82f6,#1d4ed8); }
    .su-ic-firm   { background: linear-gradient(135deg,#8b5cf6,#6d28d9); }
    .su-ic-mobile { background: linear-gradient(135deg,#10b981,#047857); }
    .su-ic-email  { background: linear-gradient(135deg,#f59e0b,#b45309); }
    .su-ic-addr   { background: linear-gradient(135deg,#ef4444,#b91c1c); }
    .su-ic-md     { background: linear-gradient(135deg,#06b6d4,#0e7490); }
    .su-tx { display: flex; flex-direction: column; min-width: 0; flex: 1; }
    .su-detail-label { font-size: 10px; text-transform: uppercase; letter-spacing: .05em; color: #94a3b8; font-weight: 600; }
    .su-detail-label::after { content: none; }
    .su-detail-value { color: #0f172a; font-weight: 600; font-size: 13px; word-break: break-word; }

    /* -- Switch Users table scroll -- */
    .Switch_Users_Page #dlmd { overflow-x: auto; overflow-y: auto; max-height: 72vh; }
    .Switch_Users_Page .vm-ml-data-table { width: 100%; border-collapse: collapse; min-width: 640px; }
    .Switch_Users_Page .vm-ml-data-table thead tr { background: #1e293b; }
    .Switch_Users_Page .vm-ml-data-table thead th {
        color: #fff; font-size: .73rem; font-weight: 600; padding: 9px 10px;
        white-space: nowrap; border: none; text-transform: uppercase; letter-spacing: .03em;
    }
    .Switch_Users_Page .vm-ml-data-table tbody tr:nth-child(even) { background: #f8fafc; }
    .Switch_Users_Page .vm-ml-data-table tbody tr:nth-child(odd)  { background: #fff; }
    .Switch_Users_Page .vm-ml-data-table tbody tr:hover td { background: #eff6ff !important; }
    .Switch_Users_Page .vm-ml-data-table tbody td {
        font-size: .78rem; padding: 8px 10px; color: #334155;
        border-bottom: 1px solid #f1f5f9; vertical-align: middle;
    }

    /* -- Mobile: Switch Users -- */
    @@media (max-width: 767px) {
        .Switch_Users_Page .vm-ft-form-col,
        .Switch_Users_Page .vm-ft-history-col  { width: 100% !important; float: none !important; padding-left: 0 !important; padding-right: 0 !important; }
        .Switch_Users_Page .vm-ft-layout       { flex-direction: column !important; }
        .Switch_Users_Page .fund-transfer-main-admin.vm-ft-history-col { padding-left: 0 !important; margin-top: 14px; }
        .Switch_Users_Page .vm-ft-page-toolbar { flex-direction: column !important; gap: 8px !important; align-items: flex-start !important; }
        .Switch_Users_Page .vm-ft-search-wrap  { width: 100% !important; }
        .Switch_Users_Page .vm-ne-search.form-control { width: 100% !important; }
        .Switch_Users_Page .au-tabs            { flex-wrap: wrap; gap: 6px; }
        .Switch_Users_Page .au-tab-btn         { border-radius: 8px !important; flex: 1 1 calc(50% - 6px); }
        .Switch_Users_Page #dlmd               { overflow-x: auto !important; max-height: none; }
        .Switch_Users_Page .vm-ml-data-table   { min-width: 640px; }
        .su-detail-card { margin: 6px 0 10px; }
    }
    @@media (max-width: 480px) {
        .Switch_Users_Page .au-tab-btn { flex: 1 1 100%; }
        .Switch_Users_Page .ne-form-footer { flex-direction: column; }
        .Switch_Users_Page .ne-btn-submit,
        .Switch_Users_Page .ne-btn-reset  { width: 100%; justify-content: center; }
    }
</style>

<script src="~/AdminDesign/plugins/jquery-slimscroll/jquery.slimscroll.js"></script>

<script>
    var ravi = window.jQuery;
    try {
        if (window.$ && window.$.noConflict) { ravi = window.$.noConflict(); }
        if (!ravi) { ravi = window.jQuery; }
    } catch (e) {
        ravi = window.jQuery;
    }

    /* Layout me 2 jQuery hain (head 1.10.2 + bottom AdminDesign wali). select2 bottom
       wali par register hota hai — isliye select2 init + saare handlers HAMESHA
       current window.jQuery (suJq) par lagenge, warna select2 ka change event
       handlers ko sunai hi nahi deta (alag jQuery instance = alag event cache). */
    function suJq() {
        return window.jQuery || window.$ || ravi;
    }

    /* -- Select2 init -- */
    ravi(document).ready(function () {
        if (window.bootAdminSelect2) { window.bootAdminSelect2(); }
        suBootPage();
    });
    // NOTE: upar $.noConflict() hai, isliye yahan $ nahi — ravi use karo,
    // warna ye line throw karke neeche ke saare handlers (detail card + Move User) dead ho jate hain
    ravi(document).ajaxComplete(function () {
        if (window.bootAdminSelect2) { window.setTimeout(window.bootAdminSelect2, 120); }
        suBootPage();
    });

    function suBootPage() {
        suInitSelect2();
        suBindHandlers();
    }

    /* -- Searchable dropdowns (explicit, retry-safe) -- */
    function suInitSelect2() {
        var $j = suJq();
        if (!$j || !$j.fn || !$j.fn.select2) {
            window.setTimeout(suInitSelect2, 150);
            return;
        }
        ['#dealerid', '#masterid', '#retailerid', '#dealerdetailsid'].forEach(function (sel) {
            var $el = $j(sel);
            if (!$el.length || $el.hasClass('select2-hidden-accessible')) { return; }
            try {
                var ph = $el.find('option[value=""]').first().text() || 'Select';
                $el.select2({ width: '100%', minimumResultsForSearch: 0, allowClear: false, placeholder: ph });
            } catch (e) { }
        });
    }

    function suSwal(title, text, type) {
        if (typeof swal === 'function') {
            swal(title, text, type || 'info');
        } else {
            window.alert(String(title) + '\n' + String(text));
        }
    }

    function suConfirmMove(text, cb) {
        if (typeof swal === 'function') {
            swal({
                title: 'Are you sure?',
                text: text,
                type: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#10b981',
                confirmButtonText: 'Yes, Move User!',
                cancelButtonText: 'Cancel',
                closeOnConfirm: true,
                closeOnCancel: true
            }, function (isConfirm) {
                if (isConfirm) { cb(); }
            });
        } else if (window.confirm('Are you sure?\n' + text)) {
            cb();
        }
    }

    /* -- Server JSON response check (Success / error + msg) -- */
    function suHandleSwitchResponse(data, okMsg) {
        var res = data;
        if (typeof res === 'string') {
            try { res = JSON.parse(res); } catch (e) { res = null; }
        }
        if (res && res.Success === 'Success') {
            suSwal('Moved!', res.msg || okMsg, 'success');
            /* success alert dikhane ke baad page refresh — nayi history + fresh dropdowns */
            window.setTimeout(function () { window.location.reload(); }, 1200);
            return true;
        }
        var msg = (res && res.msg) || 'Move failed. Please try again.';
        suSwal('Error!', msg, 'error');
        return false;
    }

    function suReloadHistory(utype) {
        ravi.ajax({
            url: '@Url.Action("ChangeTabtype", "Home")',
            data: { Utype: utype },
            cache: false,
            success: function (data) {
                ravi('#dlmd').html(data);
                pageindex = 2;
                NoMoredata = false;
            }
        });
    }

    /* -- Tab switching -- */
    function switchSUTab(panelId, ajaxUrl, btn) {
        /* toggle button active state */
        document.querySelectorAll('.au-tab-btn').forEach(function (b) { b.classList.remove('active'); });
        btn.classList.add('active');

        /* show/hide panels */
        document.querySelectorAll('.su-tab-panel').forEach(function (p) {
            p.style.display = 'none';
            p.classList.remove('active');
        });
        var target = document.getElementById(panelId);
        if (target) { target.style.display = 'block'; target.classList.add('active'); }

        /* load matching history into right panel */
        ravi.ajax({
            url: ajaxUrl,
            cache: false,
            success: function (data) {
                ravi('#dlmd').html(data);
                pageindex = 2;
                NoMoredata = false;
            }
        });
    }

    /* -- Search history table -- */
    function suSearchTable() {
        var value = ravi("#myInput").val().toLowerCase();
        ravi("#dlmd tbody tr").filter(function () {
            ravi(this).toggle(ravi(this).text().toLowerCase().indexOf(value) > -1);
        });
    }

    /* -- Infinite scroll (append rows, no duplicates, no replace) -- */
    var pageindex  = 2;
    var NoMoredata = false;
    var inProgress = false;
    function suAppendHistoryRows(html) {
        var $tmp = ravi('<div>').append(ravi.parseHTML(html || ''));
        var $rows = $tmp.find('tbody tr');
        if (!$rows.length) { return; }
        var seen = {};
        ravi('#tbldata tbody tr').each(function () {
            seen[ravi.trim(ravi(this).text()).replace(/\s+/g, ' ')] = 1;
        });
        $rows.each(function () {
            var $tr = ravi(this);
            var t = $tr.text();
            // empty-state rows kabhi append nahi (initial page me pehle se hain)
            if (t.indexOf('No distributor switch records') > -1 || t.indexOf('No retailer switch records') > -1) {
                $tr.remove();
                return;
            }
            var sig = ravi.trim(t).replace(/\s+/g, ' ');
            if (seen[sig]) { $tr.remove(); }
            else { seen[sig] = 1; }
        });
        var $fresh = $tmp.find('tbody tr');
        if ($fresh.length) { ravi('#tbldata tbody').append($fresh); }
    }
    /* change/submit/reset bindings suJq instance par (select2 wali jQuery) —
       suBindHandlers() ready + ajaxComplete se call hota hai, off-first hai */
    function suBindHandlers() {
        var $j = suJq();
        if (!$j) { return; }
        /* doosri jQuery instance par lage purane handlers hatao (nahi to
           submit/double-POST aur double-AJAX hoga — dono instances sunte hain) */
        if (typeof ravi !== 'undefined' && ravi && ravi !== $j) {
            ravi(document).off('change.suDistDetail', '#dealerid');
            ravi(document).off('change.suRetDetail', '#retailerid');
            ravi(document).off('reset.suReset', '#frmdealtomd, #frmretdeal');
            ravi(document).off('submit.suDistMove', '#frmdealtomd');
            ravi(document).off('submit.suRetMove', '#frmretdeal');
        }
        suBindDetailHandlers($j);
        suBindMoveHandlers($j);
    }

    function suBindDetailHandlers($j) {
        $j(document).off('change.suDistDetail', '#dealerid').on('change.suDistDetail', '#dealerid', suOnDistributorChange);
        $j(document).off('change.suRetDetail', '#retailerid').on('change.suRetDetail', '#retailerid', suOnRetailerChange);
    }

    function suBindMoveHandlers($j) {
        $j(document).off('reset.suReset', '#frmdealtomd, #frmretdeal').on('reset.suReset', '#frmdealtomd, #frmretdeal', suOnFormReset);
        $j(document).off('submit.suDistMove', '#frmdealtomd').on('submit.suDistMove', '#frmdealtomd', suOnDistributorMove);
        $j(document).off('submit.suRetMove', '#frmretdeal').on('submit.suRetMove', '#frmretdeal', suOnRetailerMove);
    }

    function suOnWindowScroll() {
        var $tbl = ravi('#tbldata');
        if (!$tbl.length) { return; }
        if (ravi(window).scrollTop() > Number($tbl.height()) / 4 && !NoMoredata && !inProgress) {
            inProgress = true;
            ravi("#loadingdiv").show();
            ravi.post($tbl.attr('data-hrefscroll'),
                { pageindex: pageindex },
                function (data) {
                    pageindex++;
                    NoMoredata = data.NoMoredata;
                    suAppendHistoryRows(data.HTMLString);
                    ravi("#loadingdiv").hide();
                    inProgress = false;
                }).fail(function () {
                    ravi("#loadingdiv").hide();
                    inProgress = false;
                });
        }
    }
    ravi(window).off('scroll.suScroll').on('scroll.suScroll', suOnWindowScroll);

    /* -- Fetch distributor details on change (suJq instance par bound: select2 ke events pakde jaate hain) -- */
    function suOnDistributorChange() {
        var id = ravi(this).val();
        if (window.console && console.info) { console.info('[SwitchUsers] distributor change:', id); }
        if (!id) {
            ravi('.distributor-detail').hide();
            return;
        }
        ravi.ajax({
            url: "@Url.Action("FetchDetails","Home")",
            data: { id: id },
            dataType: 'json',
            cache: false,
            success: function (data) {
                if (window.console && console.info) { console.info('[SwitchUsers] FetchDetails rows:', data ? data.length : data); }
                if (data != null && data.length > 0) {
                    ravi('#DISNAME').text(data[0].Name);
                    ravi('#DISfrmname').text(data[0].farmname);
                    ravi('#DISmobile').text(data[0].mobile);
                    ravi('#DISEMAIL').text(data[0].EMAIL);
                    ravi('#DISADDRESS').text(data[0].ADDRESS);
                    ravi('#DISCRNTMD').text(data[0].MDNAME);
                    ravi('#DISAVATAR').text((data[0].Name || '?').charAt(0));
                    ravi('#DISHEADNAME').text(data[0].Name);
                    ravi('#DISHEADFIRM').text(data[0].farmname);
                    ravi('.distributor-detail').show();
                } else {
                    ravi('.distributor-detail').hide();
                }
            },
            error: function (xhr, st) {
                if (window.console && console.warn) { console.warn('[SwitchUsers] FetchDetails failed:', xhr.status, st); }
                ravi('.distributor-detail').hide();
            }
        });
    }

    /* -- Fetch retailer details on change (suJq instance par bound) -- */
    function suOnRetailerChange() {
        var id = ravi(this).val();
        if (window.console && console.info) { console.info('[SwitchUsers] retailer change:', id); }
        if (!id) {
            ravi('.distributor-details').hide();
            return;
        }
        ravi.ajax({
            url: "@Url.Action("FetchRetailerDetails","Home")",
            data: { id: id },
            dataType: 'json',
            cache: false,
            success: function (data) {
                if (window.console && console.info) { console.info('[SwitchUsers] FetchRetailerDetails rows:', data ? data.length : data); }
                if (data != null && data.length > 0) {
                    ravi('#RETNAME').text(data[0].Name);
                    ravi('#RETfrmname').text(data[0].farmname);
                    ravi('#RETmobile').text(data[0].mobile);
                    ravi('#RETEMAIL').text(data[0].EMAIL);
                    ravi('#RETADDRESS').text(data[0].ADDRESS);
                    ravi('#RETCRNTMD').text(data[0].DealerNAME);
                    ravi('#RETAVATAR').text((data[0].Name || '?').charAt(0));
                    ravi('#RETHEADNAME').text(data[0].Name);
                    ravi('#RETHEADFIRM').text(data[0].farmname);
                    ravi('.distributor-details').show();
                } else {
                    ravi('.distributor-details').hide();
                }
            },
            error: function (xhr, st) {
                if (window.console && console.warn) { console.warn('[SwitchUsers] FetchRetailerDetails failed:', xhr.status, st); }
                ravi('.distributor-details').hide();
            }
        });
    }

    /* -- Cancel (reset): selects + detail cards bhi clear -- */
    function suOnFormReset() {
        var frm = this;
        window.setTimeout(function () {
            (suJq() || ravi)(frm).find('select').val('').trigger('change');
            ravi('.distributor-detail, .distributor-details').hide();
        }, 0);
    }

    /* -- Form: Distributor ? M/D switch (sweet alert + checked ajax) -- */
    function suOnDistributorMove(e) {
        e.preventDefault();
        var dealerid = ravi('#dealerid').val();
        var masterid = ravi('#masterid').val();
        if (!dealerid) {
            suSwal('Oops!', 'Please select a distributor.', 'error');
            return;
        }
        if (!masterid) {
            suSwal('Oops!', 'Please select new M/D.', 'error');
            return;
        }
        var $btn = ravi(this).find('.ne-btn-submit');
        suConfirmMove('You want to move this distributor to the selected M/D!', function () {
            /* Yes click par turant feedback — pata chale request chal padi */
            var suOldHtml = $btn.html();
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Moving...');
            ravi.ajax({
                type: 'POST',
                url: '@Url.Action("DealerMD_switch","Home")',
                data: { dealerid: dealerid, masterid: masterid },
                dataType: 'json',
                cache: false,
                success: function (data) {
                    if (suHandleSwitchResponse(data, 'Distributor moved successfully.')) {
                        ravi('#frmdealtomd')[0].reset();
                        (suJq() || ravi)('#dealerid, #masterid').val('').trigger('change');
                        ravi('.distributor-detail').hide();
                        suReloadHistory('dealer');
                    }
                },
                error: function (xhr) {
                    suSwal('Error!', xhr.status === 0 ? 'Network error. Please try again.' : 'Server error. Please try again.', 'error');
                },
                complete: function () {
                    $btn.prop('disabled', false).html(suOldHtml);
                }
            });
        });
    }

    /* -- Form: Retailer ? Distributor switch (sweet alert + checked ajax) -- */
    function suOnRetailerMove(e) {
        e.preventDefault();
        var remid = ravi('#retailerid').val();
        var dlmid = ravi('#dealerdetailsid').val();
        if (!remid) {
            suSwal('Oops!', 'Please select a retailer.', 'error');
            return;
        }
        if (!dlmid) {
            suSwal('Oops!', 'Please select new distributor.', 'error');
            return;
        }
        var $btn = ravi(this).find('.ne-btn-submit');
        suConfirmMove('You want to move this retailer to the selected distributor!', function () {
            /* Yes click par turant feedback — pata chale request chal padi */
            var suOldHtml = $btn.html();
            $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Moving...');
            ravi.ajax({
                type: 'POST',
                url: '@Url.Action("dealer_retailer_Switch","Home")',
                data: { remid: remid, dlmid: dlmid },
                dataType: 'json',
                cache: false,
                success: function (data) {
                    if (suHandleSwitchResponse(data, 'Retailer moved successfully.')) {
                        ravi('#frmretdeal')[0].reset();
                        (suJq() || ravi)('#retailerid, #dealerdetailsid').val('').trigger('change');
                        ravi('.distributor-details').hide();
                        suReloadHistory('Retailer');
                    }
                },
                error: function (xhr) {
                    suSwal('Error!', xhr.status === 0 ? 'Network error. Please try again.' : 'Server error. Please try again.', 'error');
                },
                complete: function () {
                    $btn.prop('disabled', false).html(suOldHtml);
                }
            });
        });
    }
</script>
