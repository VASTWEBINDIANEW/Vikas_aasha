@model Vastwebmulti.Areas.ADMIN.Models.PrepaidSlab
@{
    ViewBag.Title = "Prepaid_Slab_setting";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-settings-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css?v=12" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-payment-gateway-slab-modern.css?v=10" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-prepaid-slab-modern.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-prepaid-slab-modals.css?v=2" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-prepaid-slab-mobile.css?v=6" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.0.1/css/toastr.css" rel="stylesheet" />

<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
<script src="~/MainFrontDesign/select2/dist/js/select2.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.0.1/js/toastr.js"></script>

<style>
    #div_Loader {
        background: rgba(0, 0, 0, 0.6) none repeat scroll 0 0;
        height: 100%;
        position: fixed;
        left: 0;
        top: 0;
        width: 100%;
        z-index: 999999;
    }

    .ldio-gs56nt525f > div {
        transform-origin: 100px 100px;
        animation: ldio-gs56nt525f 0.2s infinite linear;
    }

        .ldio-gs56nt525f > div div {
            position: absolute;
            width: 22px;
            height: 152px;
            background: var(--main-bg-lcolor);
            left: 100px;
            top: 100px;
            transform: translate(-50%,-50%);
        }

            .ldio-gs56nt525f > div div:nth-child(1) {
                width: 120px;
                height: 120px;
                border-radius: 50%;
            }

            .ldio-gs56nt525f > div div:nth-child(6) {
                width: 80px;
                height: 80px;
                background: #fff;
                border-radius: 50%;
            }

            .ldio-gs56nt525f > div div:nth-child(3) {
                transform: translate(-50%,-50%) rotate(45deg)
            }

            .ldio-gs56nt525f > div div:nth-child(4) {
                transform: translate(-50%,-50%) rotate(90deg)
            }

            .ldio-gs56nt525f > div div:nth-child(5) {
                transform: translate(-50%,-50%) rotate(135deg)
            }

    .loadingio-spinner-gear-94vo528ab8 {
        width: 200px;
        height: 200px;
        display: inline-block;
        overflow: hidden;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%,-50%);
    }

    .ldio-gs56nt525f {
        width: 100%;
        height: 100%;
        position: relative;
        transform: translateZ(0) scale(1);
        backface-visibility: hidden;
        transform-origin: 0 0;
    }

        .ldio-gs56nt525f div {
            box-sizing: content-box;
        }

    @@keyframes ldio-gs56nt525f {
        0% { transform: rotate(0deg) }
        50% { transform: rotate(22.5deg) }
        100% { transform: rotate(45deg) }
    }
</style>

<section class="content saas-admin-account-page saas-admin-settings-page saas-pg-slab-page saas-prepaid-slab-page">
    <div id="loadermoney" class="loadermoney" style="display:none;"></div>
    <div class="container-fluid">

        <div class="saas-acc-toolbar">
            <ol class="saas-acc-breadcrumb">
                <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                <li><a href="javascript:void(0);">Basic Setting</a></li>
                <li>Prepaid / DTH Commission</li>
            </ol>
        </div>

        <div class="vm-prepaid-slab-shell">
            @Html.Partial("_Slab_Menu")

            <div class="vm-prepaid-slab-main">
                <div class="vm-pg-slab-card">
                    <div class="vm-pg-slab-card__head">
                        <h3 class="vm-pg-slab-card__title">
                            <i class="fas fa-signal" aria-hidden="true"></i>
                            Prepaid / DTH Slab Setting
                        </h3>
                        <div class="vm-pg-slab-card__actions">
                            <div class="vm-pg-slab-tab-bar">
                                <div class="vm-pg-slab-tabs all-slab-header all-slab-header-second slab-btn-second">
                                    <a href="@Url.Action("Prepaid_Slab_setting","Home")" id="Comm" class="vm-pg-slab-tab vm-pg-slab-tab--active" aria-selected="true">
                                        <span class="vm-pg-slab-tab__icon" aria-hidden="true"><i class="fas fa-layer-group"></i></span>
                                        <span class="vm-pg-slab-tab__copy">Common Slab<span class="vm-pg-slab-tab__sub">For New Users</span></span>
                                    </a>
                                    <button type="button" id="Mdbtn" class="vm-pg-slab-tab vm-pg-slab-tab--inactive masterdealerclass" aria-selected="false" onclick="editUserWise('Master', 'EditFormUserWise')">
                                        <span class="vm-pg-slab-tab__icon" aria-hidden="true"><i class="fas fa-user-shield"></i></span>
                                        <span class="vm-pg-slab-tab__copy">MD Slab<span class="vm-pg-slab-tab__sub">Existing Users</span></span>
                                    </button>
                                    <button type="button" id="Dlmbtn" class="vm-pg-slab-tab vm-pg-slab-tab--inactive masterdealerclass" aria-selected="false" onclick="editUserWise('Dealer', 'EditFormUserWise')">
                                        <span class="vm-pg-slab-tab__icon" aria-hidden="true"><i class="fas fa-store"></i></span>
                                        <span class="vm-pg-slab-tab__copy">Distributor Slab<span class="vm-pg-slab-tab__sub">Existing Users</span></span>
                                    </button>
                                    <button type="button" id="Rembtn" class="vm-pg-slab-tab vm-pg-slab-tab--inactive" aria-selected="false" onclick="editUserWise('Retailer', 'EditFormUserWise')">
                                        <span class="vm-pg-slab-tab__icon" aria-hidden="true"><i class="fas fa-user-tag"></i></span>
                                        <span class="vm-pg-slab-tab__copy">Retailer Slab<span class="vm-pg-slab-tab__sub">Existing Users</span></span>
                                    </button>
                                    <button type="button" id="Apibtn" class="vm-pg-slab-tab vm-pg-slab-tab--inactive" aria-selected="false" onclick="editUserWise('API', 'EditFormUserWise')">
                                        <span class="vm-pg-slab-tab__icon" aria-hidden="true"><i class="fas fa-code"></i></span>
                                        <span class="vm-pg-slab-tab__copy">API Slab<span class="vm-pg-slab-tab__sub">Existing Users</span></span>
                                    </button>
                                    <button type="button" id="Whitebtn" class="vm-pg-slab-tab vm-pg-slab-tab--inactive" aria-selected="false" onclick="editUserWise('Whitelabel', 'EditFormUserWise')">
                                        <span class="vm-pg-slab-tab__icon" aria-hidden="true"><i class="fas fa-tag"></i></span>
                                        <span class="vm-pg-slab-tab__copy">White Label Slab<span class="vm-pg-slab-tab__sub">Existing Users</span></span>
                                    </button>
                                </div>
                            </div>
                            <div class="vm-prepaid-slab-actions">
                                <button id="btnEdit" type="button" class="vm-pg-slab-btn-edit" onclick="funcEdit(this, 'EditFormComm')">
                                    <img src="~/AdminDesign/images/edit.svg" alt="" />
                                    <span>Edit Slab</span>
                                </button>
                                <a href="@Url.Action("Commsion_Status_master_dlm","Home")" class="vm-prepaid-slab-action-btn vm-prepaid-slab-action-btn--hold utilitiescommission">
                                    Hold Setting
                                    <span>utilities commission</span>
                                </a>
                                <button type="button" data-toggle="modal" data-target="#myModalxyz" class="vm-prepaid-slab-action-btn predthrange">
                                    <i class="fas fa-cog" aria-hidden="true"></i>
                                    Slab Amount Range
                                </button>
                                <button type="button" data-toggle="modal" data-target="#myModal123" class="vm-prepaid-slab-action-btn">
                                    <i class="fas fa-receipt" aria-hidden="true"></i>
                                    Edit Slip
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="vm-pg-slab-body">
                        <div id="divEditFormComm" class="vm-pg-slab-edit-table slab-edit-table">
                            @Html.Partial("_prepaid_comm", Model)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div id="div_Loader" style="display:none;">
    <div class="loadingio-spinner-gear-94vo528ab8">
        <div class="ldio-gs56nt525f">
            <div><div></div><div></div><div></div><div></div><div></div><div></div></div>
        </div>
    </div>
</div>

<!-- Slab Amount Range -->
<div id="myModalxyz" class="modal fade saas-admin-modal vm-prepaid-modal vm-prepaid-modal--range" tabindex="-1" role="dialog" aria-labelledby="prepaidRangeModalLabel">
    <div class="modal-dialog modal-dialog-centered saas-admin-modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header saas-admin-modal-header accent-sky">
                <div class="saas-admin-modal-head-main">
                    <div class="saas-admin-modal-icon"><i class="fas fa-sliders-h" aria-hidden="true"></i></div>
                    <div class="saas-admin-modal-title-wrap">
                        <h4 class="modal-title saas-admin-modal-title" id="prepaidRangeModalLabel">Slab Amount Range</h4>
                        <p class="saas-admin-modal-subtitle">Set maximum amounts for prepaid &amp; DTH commission ranges</p>
                    </div>
                </div>
                <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
            </div>
            <div class="modal-body saas-admin-modal-body">
                <div id="body" class="vm-prepaid-range-cards">
                    @foreach (var item in Model.AmountRange)
                    {
                        <div class="vm-prepaid-range-card tr">
                            <div class="vm-prepaid-range-card__field">
                                <label>Maximum Range 1</label>
                                <span class="vm-prepaid-range-card__value">@item.maximum1</span>
                                <small>Amount from ₹1 up to this value</small>
                            </div>
                            <div class="vm-prepaid-range-card__field">
                                <label>Maximum Range 2</label>
                                <span class="vm-prepaid-range-card__value">@item.maximum2</span>
                                <small>Amount above range 1 up to this value</small>
                            </div>
                            <div class="vm-prepaid-range-card__actions">
                                <button id="btnEdit1" type="button" class="vm-prepaid-range-edit-btn" onclick="funcEdit1()">
                                    <img src="~/AdminDesign/images/edit.svg" alt="" />
                                    <span>Edit Range Values</span>
                                </button>
                            </div>
                        </div>
                    }
                </div>
                <div id="bodyedit" class="vm-prepaid-range-cards vm-prepaid-range-cards--edit" style="display:none;">
                    @using (Html.BeginForm("Edit_prePaid_amountRange", "Home", FormMethod.Post))
                    {
                        for (int i = 0; i < Model.AmountRange.Count; i++)
                        {
                            @Html.HiddenFor(aa => aa.AmountRange[i].idno)
                            <div class="vm-prepaid-range-card tr">
                                <div class="vm-prepaid-range-card__field">
                                    <label>Maximum Range 1</label>
                                    @Html.EditorFor(a => a.AmountRange[i].maximum1, new { htmlAttributes = new { @class = "vm-prepaid-modal-input", @required = "true" } })
                                    @Html.ValidationMessageFor(a => a.AmountRange[i].maximum1)
                                </div>
                                <div class="vm-prepaid-range-card__field">
                                    <label>Maximum Range 2</label>
                                    @Html.EditorFor(a => a.AmountRange[i].maximum2, new { htmlAttributes = new { @class = "vm-prepaid-modal-input", @required = "true" } })
                                    @Html.ValidationMessageFor(a => a.AmountRange[i].maximum2)
                                </div>
                                <div class="vm-prepaid-range-card__actions">
                                    <button id="btnsave" type="submit" class="saas-admin-modal-btn saas-admin-modal-btn--success" style="display:none; flex:1;">
                                        <i class="fas fa-save" aria-hidden="true"></i> Save Range
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>
                <p class="vm-prepaid-modal-note is-hidden" id="tabl_1">Amount exceeding range 2 maximum is calculated in range 3 automatically.</p>
            </div>
        </div>
    </div>
</div>

<!-- Edit Slip -->
<div id="myModal123" class="modal fade saas-admin-modal vm-prepaid-modal vm-prepaid-modal--slip" tabindex="-1" role="dialog" aria-labelledby="prepaidSlipModalLabel">
    <div class="modal-dialog modal-dialog-centered saas-admin-modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header saas-admin-modal-header accent-emerald">
                <div class="saas-admin-modal-head-main">
                    <div class="saas-admin-modal-icon"><i class="fas fa-receipt" aria-hidden="true"></i></div>
                    <div class="saas-admin-modal-title-wrap">
                        <h4 class="modal-title saas-admin-modal-title" id="prepaidSlipModalLabel">Edit Recharge Slip</h4>
                        <p class="saas-admin-modal-subtitle">Select which fields appear on the recharge slip</p>
                    </div>
                </div>
                <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
            </div>
            <div class="modal-body saas-admin-modal-body">
                <div class="vm-prepaid-slip-toolbar">
                    <button type="button" class="vm-prepaid-slip-chip vm-prepaid-slip-chip--block" onclick="eselectAll()">
                        <i class="far fa-check-square" aria-hidden="true"></i> Block All
                    </button>
                    <button type="button" class="vm-prepaid-slip-chip" onclick="eUnSelectAll()">
                        <i class="far fa-square" aria-hidden="true"></i> Unblock All
                    </button>
                </div>
                <div id="RechargeSlipCheckUncheck" class="vm-prepaid-slip-grid">
                    <label class="vm-prepaid-slip-item" for="Convence Fee">
                        <span class="vm-prepaid-slip-item__icon"><i class="fas fa-coins" aria-hidden="true"></i></span>
                        <input type="checkbox" id="Convence Fee" value="Convence Fee" name="acs11" onchange="syncSlipItemClass(this)" />
                        <span>Convence Fee</span>
                        <span class="vm-prepaid-slip-item__tick"><i class="fas fa-check" aria-hidden="true"></i></span>
                    </label>
                    <label class="vm-prepaid-slip-item" for="Mobile">
                        <span class="vm-prepaid-slip-item__icon"><i class="fas fa-mobile-alt" aria-hidden="true"></i></span>
                        <input type="checkbox" id="Mobile" value="Mobile" name="acs11" onchange="syncSlipItemClass(this)" />
                        <span>Mobile</span>
                        <span class="vm-prepaid-slip-item__tick"><i class="fas fa-check" aria-hidden="true"></i></span>
                    </label>
                    <label class="vm-prepaid-slip-item" for="Email">
                        <span class="vm-prepaid-slip-item__icon"><i class="fas fa-envelope" aria-hidden="true"></i></span>
                        <input type="checkbox" id="Email" value="Email" name="acs11" onchange="syncSlipItemClass(this)" />
                        <span>Email</span>
                        <span class="vm-prepaid-slip-item__tick"><i class="fas fa-check" aria-hidden="true"></i></span>
                    </label>
                    <label class="vm-prepaid-slip-item" for="Customer care">
                        <span class="vm-prepaid-slip-item__icon"><i class="fas fa-headset" aria-hidden="true"></i></span>
                        <input type="checkbox" id="Customer care" value="Customer care" name="acs11" onchange="syncSlipItemClass(this)" />
                        <span>Customer care</span>
                        <span class="vm-prepaid-slip-item__tick"><i class="fas fa-check" aria-hidden="true"></i></span>
                    </label>
                    <label class="vm-prepaid-slip-item" for="Website Name">
                        <span class="vm-prepaid-slip-item__icon"><i class="fas fa-globe" aria-hidden="true"></i></span>
                        <input type="checkbox" id="Website Name" value="Website Name" name="acs11" onchange="syncSlipItemClass(this)" />
                        <span>Website Name</span>
                        <span class="vm-prepaid-slip-item__tick"><i class="fas fa-check" aria-hidden="true"></i></span>
                    </label>
                    <label class="vm-prepaid-slip-item" for="TotalAmount">
                        <span class="vm-prepaid-slip-item__icon"><i class="fas fa-rupee-sign" aria-hidden="true"></i></span>
                        <input type="checkbox" id="TotalAmount" value="TotalAmount" name="acs11" onchange="syncSlipItemClass(this)" />
                        <span>Total Amount</span>
                        <span class="vm-prepaid-slip-item__tick"><i class="fas fa-check" aria-hidden="true"></i></span>
                    </label>
                </div>
            </div>
            <div class="modal-footer saas-admin-modal-footer">
                <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal">
                    <i class="fas fa-times" aria-hidden="true"></i> Close
                </button>
                <button type="button" id="SaveAll" class="saas-admin-modal-btn saas-admin-modal-btn--success">
                    <i class="fas fa-save" aria-hidden="true"></i> Save Details
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function funcEdit1() {
        $('#btnEdit1').hide();
        $('#btnsave').show();
        $('#body').hide();
        $('#bodyedit').show();
        $('#tabl_1').removeClass('is-hidden');
    }

    function syncSlipItemClass(el) {
        $(el).closest('.vm-prepaid-slip-item').toggleClass('is-checked', el.checked);
    }

    function syncAllSlipItems() {
        $('#RechargeSlipCheckUncheck input[type="checkbox"]').each(function () {
            syncSlipItemClass(this);
        });
    }

    function eselectAll() {
        var items = document.getElementsByName('acs11');
        for (var i = 0; i < items.length; i++) {
            if (items[i].type == 'checkbox') {
                items[i].checked = true;
                syncSlipItemClass(items[i]);
            }
        }
    }

    function eUnSelectAll() {
        var items = document.getElementsByName('acs11');
        for (var i = 0; i < items.length; i++) {
            if (items[i].type == 'checkbox') {
                items[i].checked = false;
                syncSlipItemClass(items[i]);
            }
        }
    }

    var FormId = "";
    var roleshow = "";

    function showRetailerDrop() {
        $('#retailerdrop').css('display', 'flex').addClass('show-retailer');
        $('#allshow').hide();
    }

    function showAllUsersDrop() {
        $('#retailerdrop').hide().removeClass('show-retailer');
        $('#allshow').show();
    }

    function resetSlabSaveButtons() {
        $('#btnsubmit, #btnsubmituser, #btnsubmitusercommon, #btnsubmitusercommondlmrem')
            .hide().removeClass('is-visible');
        $('#btnEdit').show().removeClass('is-hidden');
    }

    function resetSlabViewMode() {
        $('#tbodyshow').removeClass('vm-pg-slab-tbody--hidden').addClass('vm-pg-slab-tbody--view');
        $('#tbodyedit, #tbodyeditAll').addClass('vm-pg-slab-tbody--hidden');
        resetSlabSaveButtons();
    }

    function showSlabEditMode() {
        $('#tbodyshow').addClass('vm-pg-slab-tbody--hidden').removeClass('vm-pg-slab-tbody--view');
        $('#tbodyedit, #tbodyeditAll').addClass('vm-pg-slab-tbody--hidden');

        var ddlVal = $('#ddlUserId').val();
        var retailerval = $('#Retailerid').length ? $('#Retailerid').val() : null;
        var useEditAll = false;

        if ($('#tbodyeditAll').length) {
            if (ddlVal === '' || ddlVal === null) {
                useEditAll = true;
            }
            if (retailerval !== null && retailerval === '') {
                useEditAll = true;
            }
            if (retailerval !== null && retailerval !== '') {
                useEditAll = false;
            }
        }

        if (useEditAll) {
            $('#tbodyeditAll').removeClass('vm-pg-slab-tbody--hidden');
        } else if ($('#tbodyedit').length) {
            $('#tbodyedit').removeClass('vm-pg-slab-tbody--hidden');
        }

        $('#btnEdit').hide().addClass('is-hidden');
    }

    function showSlabSaveButtons() {
        $('#btnsubmit, #btnsubmituser, #btnsubmitusercommon, #btnsubmitusercommondlmrem').removeClass('is-visible').hide();

        var val = $('#ddlUserId').val();
        var ddldlm = $('#ddldealer').val();
        var ddlrem = $('#ddlUserIdrem').val();

        if ($('#btnsubmit').length) {
            $('#btnsubmit').show().addClass('is-visible');
        }
        if ($('#btnsubmituser').length) {
            $('#btnsubmituser').show().addClass('is-visible');
        }
        if (val === '' || val === null) {
            if ($('#btnsubmitusercommon').length) {
                $('#btnsubmitusercommon').show().addClass('is-visible');
            }
        }
        if (roleshow === 'Retailer' && ddldlm !== '' && ddlrem === '') {
            if ($('#btnsubmitusercommondlmrem').length) {
                $('#btnsubmitusercommondlmrem').show().addClass('is-visible');
            }
        }
    }

    function updateUserDesc(userRole) {
        if (['Master', 'Dealer'].includes(userRole)) {
            $('#user_desc').text('Including GST (Goods and Service Tax) if commission agent');
        } else {
            $('#user_desc').text('Including GST (Goods and Service Tax)');
        }
    }

    function initPgSlabPartialUi() {
        if ($.fn.select2) {
            $('.saas-prepaid-slab-page .for-select2').each(function () {
                var $el = $(this);
                try {
                    if ($el.hasClass('select2-hidden-accessible')) {
                        $el.select2('destroy');
                    }
                } catch (e) { }
                $el.select2({
                    width: '100%',
                    dropdownParent: $(document.body)
                });
            });
        }
    }

    function bindPgSlabTableHover() {
        $(document).off('mouseenter.pgslab mouseleave.pgslab', '.saas-prepaid-slab-page .third-design-table tbody td');
        $(document).on('mouseenter.pgslab', '.saas-prepaid-slab-page .third-design-table tbody td', function () {
            var colIndex = $(this).parent().children().index($(this)) + 1;
            var rowIndex = $(this).parent().parent().children().index($(this).parent()) + 1;
            $(".saas-prepaid-slab-page .third-design-table td:nth-child(" + colIndex + ")").css({ background: 'var(--main-bg-rcolor, #2563eb)', color: '#fff' });
            $(".saas-prepaid-slab-page .third-design-table tbody tr:nth-child(" + rowIndex + ")").css('background', 'var(--main-bg-rcolor, #2563eb)');
        });
        $(document).on('mouseleave.pgslab', '.saas-prepaid-slab-page .third-design-table tbody td', function () {
            var colIndex = $(this).parent().children().index($(this)) + 1;
            var rowIndex = $(this).parent().parent().children().index($(this).parent()) + 1;
            $(".saas-prepaid-slab-page .third-design-table td:nth-child(" + colIndex + ")").css({ background: '', color: '' });
            $(".saas-prepaid-slab-page .third-design-table tbody tr:nth-child(" + rowIndex + ")").css('background', '');
        });
    }

    var slabTabByRole = {
        'Common': '#Comm',
        'Master': '#Mdbtn',
        'Dealer': '#Dlmbtn',
        'Retailer': '#Rembtn',
        'API': '#Apibtn',
        'Whitelabel': '#Whitebtn'
    };

    function setSlabTabActive(selector) {
        $('.vm-pg-slab-tab')
            .removeClass('vm-pg-slab-tab--active')
            .addClass('vm-pg-slab-tab--inactive')
            .attr('aria-selected', 'false');

        $(selector)
            .removeClass('vm-pg-slab-tab--inactive')
            .addClass('vm-pg-slab-tab--active')
            .attr('aria-selected', 'true');
    }

    function setSlabTabByRole(userRole) {
        var selector = slabTabByRole[userRole] || '#Comm';
        setSlabTabActive(selector);
    }

    function toggleUtilitiesHold(showHold) {
        if (showHold) {
            $('.utilitiescommission').addClass('is-visible');
            $('.predthrange').hide();
        } else {
            $('.utilitiescommission').removeClass('is-visible');
            $('.predthrange').show();
        }
    }

    function funcEdit(event, frmId) {
        if (FormId === '') {
            FormId = frmId;
        }
        showSlabEditMode();
        showSlabSaveButtons();
        var $scroll = $('.saas-prepaid-slab-page .vm-pg-slab-table-scroll').first();
        if ($scroll.length) {
            $scroll[0].scrollLeft = 0;
        }
    }

    function funcSave() {
        $("#" + FormId + "").submit();
    }

    function editUserWise(userRole, frmId) {
        roleshow = userRole;
        setSlabTabByRole(userRole);
        toggleUtilitiesHold(['Master', 'Dealer'].includes(userRole));
        $('#div_Loader').show();
        resetSlabViewMode();

        var url = '@Url.Action("_UserPrepaidSlab", "Home")';
        $.post(url, { role: userRole }, function (data) {
            $('#div_Loader').hide();
            $("#divEditFormComm").html(data);
            FormId = frmId;
            $("#role").val(userRole);
            initPgSlabPartialUi();
            resetSlabViewMode();
            if (userRole == "Retailer") {
                showRetailerDrop();
            } else {
                showAllUsersDrop();
            }
            updateUserDesc(userRole);
        })
            .fail(function (xhr, status, error) {
                $('#div_Loader').hide();
                alert("error");
                console.log(xhr.responseText);
            });
    }

