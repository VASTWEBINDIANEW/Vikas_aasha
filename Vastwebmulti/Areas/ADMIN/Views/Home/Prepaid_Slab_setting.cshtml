    $(document).ready(function () {
        bindPgSlabTableHover();
        initPgSlabPartialUi();
        resetSlabViewMode();
        setSlabTabByRole('Common');
        toggleUtilitiesHold(false);
        loadRechargeSlipBlockStatus();
        syncAllSlipItems();

        $("#SaveAll").click(function () {
            var optCode = [];
            $("#RechargeSlipCheckUncheck input").each(function () {
                if ($(this).prop('checked') == true) {
                    optCode.push($(this).val() + ",Y");
                } else {
                    optCode.push($(this).val() + ",N");
                }
            });

            document.getElementById("loadermoney").style.display = "block";

            $.ajax({
                type: "POST",
                url: '@Url.Action("Blocked_Recharge_Slip_SettingSave", "Home")',
                data: { 'ch': optCode },
                cache: false,
                dataType: 'json',
                async: true,
                success: function (data) {
                    document.getElementById("loadermoney").style.display = "none";
                    if (data.status) {
                        toastr.success('Recharge Slip Mode Successfully Blocked', 'Recharge Slip Block');
                    } else {
                        toastr.error(data.Message, 'Recharge Slip Block Error');
                    }
                }
            });
        });
    });

    function loadRechargeSlipBlockStatus() {
        $.ajax({
            type: "GET",
            url: '@Url.Action("Check_Unchek_Recharge_slip_Setting", "Home")',
            cache: false,
            dataType: 'json',
            async: true,
                    success: function (data) {
                        for (var item in data) {
                            var sts = data[item].status;
                            var name = data[item].Upi_Mode;
                            var $el = $("#" + name + "");
                            $el.prop("checked", sts == "Y");
                            syncSlipItemClass($el[0]);
                        }
                    }
        });
    }
</script>
