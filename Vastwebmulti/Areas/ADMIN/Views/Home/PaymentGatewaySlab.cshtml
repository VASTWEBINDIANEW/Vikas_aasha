@model Vastwebmulti.Areas.ADMIN.Models.GatewayPayment
@{
    ViewBag.Title = "PaymentGatewaySlab";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-settings-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-payment-gateway-slab-modern.css?v=8" rel="stylesheet" />

<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

<style>
    #div_Loader {
        background: rgba(0, 0, 0, 0.6) none repeat scroll 0 0;
        height: 100%;
        position: fixed;
        left: 0;
        top: 0;
        width: 100%;
        z-index: 999999;
    }

    .ldio-gs56nt525f > div {
        transform-origin: 100px 100px;
        animation: ldio-gs56nt525f 0.2s infinite linear;
    }

        .ldio-gs56nt525f > div div {
            position: absolute;
            width: 22px;
            height: 152px;
            background: var(--main-bg-lcolor);
            left: 100px;
            top: 100px;
            transform: translate(-50%,-50%);
        }

            .ldio-gs56nt525f > div div:nth-child(1) {
                width: 120px;
                height: 120px;
                border-radius: 50%;
            }

            .ldio-gs56nt525f > div div:nth-child(6) {
                width: 80px;
                height: 80px;
                background: #fff;
                border-radius: 50%;
            }

            .ldio-gs56nt525f > div div:nth-child(3) {
                transform: translate(-50%,-50%) rotate(45deg)
            }

            .ldio-gs56nt525f > div div:nth-child(4) {
                transform: translate(-50%,-50%) rotate(90deg)
            }

            .ldio-gs56nt525f > div div:nth-child(5) {
                transform: translate(-50%,-50%) rotate(135deg)
            }

    .loadingio-spinner-gear-94vo528ab8 {
        width: 200px;
        height: 200px;
        display: inline-block;
        overflow: hidden;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%,-50%);
    }

    .ldio-gs56nt525f {
        width: 100%;
        height: 100%;
        position: relative;
        transform: translateZ(0) scale(1);
        backface-visibility: hidden;
        transform-origin: 0 0;
    }

    .ldio-gs56nt525f div {
        box-sizing: content-box;
    }

    @@keyframes ldio-gs56nt525f {
        0% { transform: rotate(0deg) }
        50% { transform: rotate(22.5deg) }
        100% { transform: rotate(45deg) }
    }
</style>

<section class="content saas-admin-account-page saas-admin-settings-page saas-pg-slab-page">
    <div class="container-fluid">

        <div class="saas-acc-toolbar">
            <ol class="saas-acc-breadcrumb">
                <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                <li><a href="@Url.Action("UPIAndGatewaySetting", "Home")">Payment Gateway</a></li>
                <li>Slab Setting</li>
            </ol>
        </div>


        <div class="vm-pg-slab-card">
            <div class="vm-pg-slab-card__head">
                <h3 class="vm-pg-slab-card__title">
                    <i class="fas fa-layer-group" aria-hidden="true"></i>
                    Payment Gateway Slab Setting
                </h3>
                <div class="vm-pg-slab-card__actions">
                    <div class="vm-pg-slab-tab-bar">
                        <div class="vm-pg-slab-tabs all-slab-header slab-buttonadminch all-slab-header-second slab-btn-second">
                            <a href="@Url.Action("PaymentGatewaySlab", "Home")" id="Comm" class="vm-pg-slab-tab vm-pg-slab-tab--active" aria-selected="true">
                                Common Slab
                                <span>For New Users</span>
                            </a>
                            <button type="button" id="Mdbtn" class="vm-pg-slab-tab vm-pg-slab-tab--inactive" aria-selected="false" onclick="editUserWise('Master', 'EditFormUserWise')">
                                MD Slab
                                <span>Existing Users</span>
                            </button>
                            <button type="button" id="Dlmbtn" class="vm-pg-slab-tab vm-pg-slab-tab--inactive" aria-selected="false" onclick="editUserWise('Dealer', 'EditFormUserWise')">
                                Distributor Slab
                                <span>Existing Users</span>
                            </button>
                            <button type="button" id="Rembtn" class="vm-pg-slab-tab vm-pg-slab-tab--inactive" aria-selected="false" onclick="editUserWise('Retailer', 'EditFormUserWise')">
                                Retailer Slab
                                <span>Existing Users</span>
                            </button>
                            <button type="button" id="Apibtn" class="vm-pg-slab-tab vm-pg-slab-tab--inactive" aria-selected="false" onclick="editUserWise('API', 'EditFormUserWise')">
                                API Slab
                                <span>Existing Users</span>
                            </button>
                        </div>
                    </div>
                    <button id="btnEdit" type="button" class="vm-pg-slab-btn-edit" onclick="funcEdit(this, 'EditFormComm')">
                        <img src="~/AdminDesign/images/edit.svg" alt="" />
                        <span>Edit Slab</span>
                    </button>
                </div>
            </div>

            <div class="vm-pg-slab-body">
                <div id="divEditFormComm" class="vm-pg-slab-edit-table slab-edit-table">
                    @Html.Partial("_common_PaymentGatewaySlab", Model)
                </div>
            </div>
        </div>
    </div>
</section>

<div id="div_Loader" style="display:none;">
    <div class="loadingio-spinner-gear-94vo528ab8">
        <div class="ldio-gs56nt525f">
            <div><div></div><div></div><div></div><div></div><div></div><div></div></div>
        </div>
    </div>
</div>

<script>
    var FormId = "";
    var UpdateGstOnly = false;
    var roleshow = "";

    function showRetailerDrop() {
        $('#retailerdrop').css('display', 'flex');
        $('#allshow').hide();
    }

    function showAllUsersDrop() {
        $('#retailerdrop').hide();
        $('#allshow').show();
    }

    function resetSlabSaveButtons() {
        $('#btnsubmit, #btnsubmituser, #btnsubmitusercommon, #btnsubmitusercommondlmrem')
            .hide().removeClass('is-visible');
        $('#btnEdit').show().removeClass('is-hidden');
    }

    function resetSlabViewMode() {
        $('#tbodyshow').removeClass('vm-pg-slab-tbody--hidden').addClass('vm-pg-slab-tbody--view');
        $('#tbodyedit, #tbodyeditAll').addClass('vm-pg-slab-tbody--hidden');
        resetSlabSaveButtons();
    }

    function showSlabEditMode() {
        $('#tbodyshow').addClass('vm-pg-slab-tbody--hidden').removeClass('vm-pg-slab-tbody--view');
        $('#tbodyedit, #tbodyeditAll').addClass('vm-pg-slab-tbody--hidden');

        var ddlVal = $('#ddlUserId').val();
        if ($('#tbodyeditAll').length && (ddlVal === '' || ddlVal === null)) {
            $('#tbodyeditAll').removeClass('vm-pg-slab-tbody--hidden');
        } else {
            $('#tbodyedit').removeClass('vm-pg-slab-tbody--hidden');
        }

        $('#btnEdit').hide().addClass('is-hidden');
    }

    function showSlabSaveButtons() {
        $('#btnsubmit, #btnsubmituser, #btnsubmitusercommon, #btnsubmitusercommondlmrem').removeClass('is-visible').hide();

        var val = $('#ddlUserId').val();
        var ddldlm = $('#ddldealer').val();
        var ddlrem = $('#ddlUserIdrem').val();

        if ($('#btnsubmit').length) {
            $('#btnsubmit').show().addClass('is-visible');
        }
        if ($('#btnsubmituser').length) {
            $('#btnsubmituser').show().addClass('is-visible');
        }
        if (val === '' || val === null) {
            if ($('#btnsubmitusercommon').length) {
                $('#btnsubmitusercommon').show().addClass('is-visible');
            }
        }
        if (roleshow === 'Retailer' && ddldlm !== '' && ddlrem === '') {
            if ($('#btnsubmitusercommondlmrem').length) {
                $('#btnsubmitusercommondlmrem').show().addClass('is-visible');
            }
        }
    }

    function initPgSlabPartialUi() {
        if ($.fn.select2) {
            $('.saas-pg-slab-page .for-select2').each(function () {
                var $el = $(this);
                try {
                    if ($el.hasClass('select2-hidden-accessible')) {
                        $el.select2('destroy');
                    }
                } catch (e) { }
                $el.select2({ width: '100%' });
            });
        }
    }

    function bindPgSlabTableHover() {
        $(document).off('mouseenter.pgslab mouseleave.pgslab', '.saas-pg-slab-page .third-design-table tbody td');
        $(document).on('mouseenter.pgslab', '.saas-pg-slab-page .third-design-table tbody td', function () {
            var colIndex = $(this).parent().children().index($(this)) + 1;
            var rowIndex = $(this).parent().parent().children().index($(this).parent()) + 1;
            $(".saas-pg-slab-page .third-design-table td:nth-child(" + colIndex + ")").css({ background: 'var(--main-bg-rcolor, #2563eb)', color: '#fff' });
            $(".saas-pg-slab-page .third-design-table tbody tr:nth-child(" + rowIndex + ")").css('background', 'var(--main-bg-rcolor, #2563eb)');
        });
        $(document).on('mouseleave.pgslab', '.saas-pg-slab-page .third-design-table tbody td', function () {
            var colIndex = $(this).parent().children().index($(this)) + 1;
            var rowIndex = $(this).parent().parent().children().index($(this).parent()) + 1;
            $(".saas-pg-slab-page .third-design-table td:nth-child(" + colIndex + ")").css({ background: '', color: '' });
            $(".saas-pg-slab-page .third-design-table tbody tr:nth-child(" + rowIndex + ")").css('background', '');
        });
    }

    $(document).ready(function () {
        bindPgSlabTableHover();
        initPgSlabPartialUi();
        resetSlabViewMode();
        setSlabTabByRole(roleshow || 'Common');
    });

    var slabTabByRole = {
        'Common': '#Comm',
        'Master': '#Mdbtn',
        'Dealer': '#Dlmbtn',
        'Retailer': '#Rembtn',
        'API': '#Apibtn'
    };

    function setSlabTabActive(selector) {
        $('.vm-pg-slab-tab')
            .removeClass('vm-pg-slab-tab--active')
            .addClass('vm-pg-slab-tab--inactive')
            .attr('aria-selected', 'false');

        $(selector)
            .removeClass('vm-pg-slab-tab--inactive')
            .addClass('vm-pg-slab-tab--active')
            .attr('aria-selected', 'true');
    }

    function setSlabTabByRole(userRole) {
        var selector = slabTabByRole[userRole] || '#Comm';
        setSlabTabActive(selector);
    }

    function funcEdit(event, frmId) {
        if (FormId === '') {
            FormId = frmId;
        }
        showSlabEditMode();
        showSlabSaveButtons();
        var $scroll = $('.saas-pg-slab-page .vm-pg-slab-table-scroll').first();
        if ($scroll.length) {
            $scroll[0].scrollLeft = 0;
        }
    }

    function funcSave() {
        $("#" + FormId + "").submit();
    }

    function editUserWise(userRole, frmId) {
        roleshow = userRole;
        setSlabTabByRole(userRole);
        $('#div_Loader').show();
        resetSlabViewMode();

        var url = '@Url.Action("_UserPaymentGatewaySlab", "Home")';
        $.post(url, { role: userRole }, function (data) {
            $('#div_Loader').hide();
            $("#divEditFormComm").html(data);
            FormId = frmId;
            $("#role").val(userRole);
            initPgSlabPartialUi();
            resetSlabViewMode();
            if (userRole == "Retailer") {
                showRetailerDrop();
            }
            else {
                showAllUsersDrop();
            }
        })
            .fail(function (xhr, status, error) {
                $('#div_Loader').hide();
                alert("error");
                console.log(xhr.responseText);
            });
    }

    function ddlUserIdChange() {
        var ddlVal = $('#ddlUserId').val();
        var role = $("#role").val();
        resetSlabViewMode();
        var url = '@Url.Action("_UserPaymentGatewaySlab", "Home")';
        $.post(url, { role: role, userid: ddlVal }, function (data) {
            $("#divEditFormComm").html(data);
            initPgSlabPartialUi();
            resetSlabViewMode();
        })
            .fail(function (xhr, status, error) {
                console.log(xhr.responseText);
            });
    }

    function ddlRetailerIdChange() {
        resetSlabViewMode();
        var ddlVal = $('#ddlUserId').val();
        var role = $("#role").val();
        var url = '@Url.Action("_UserPaymentGatewaySlab", "Home")';
        $.post(url, { role: role, userid: ddlVal }, function (data) {
            $("#divEditFormComm").html(data);
            initPgSlabPartialUi();
            resetSlabViewMode();
        })
            .fail(function (xhr, status, error) {
                console.log(xhr.responseText);
            });
    }

    function ddlretailerid() {
        var dlmid = $('#ddldealer').val();
        var role = $("#role").val();
        resetSlabViewMode();
        var url = '@Url.Action("_UserPaymentGatewaySlab", "Home")';
        $.post(url, { role: role, dlmid: dlmid }, function (data) {
            $("#divEditFormComm").html(data);
            showRetailerDrop();
            initPgSlabPartialUi();
            resetSlabViewMode();
        })
            .fail(function (xhr, status, error) {
                console.log(xhr.responseText);
            });
    }

    function ddlUserIdChangerem() {
        var dlmid = $('#ddldealer').val();
        var ddlVal = $('#ddlUserIdrem').val();
        var role = $("#role").val();
        resetSlabViewMode();
        var url = '@Url.Action("_UserPaymentGatewaySlab", "Home")';
        $.post(url, { role: role, userid: ddlVal, dlmid: dlmid }, function (data) {
            $("#divEditFormComm").html(data);
            showRetailerDrop();
            initPgSlabPartialUi();
            resetSlabViewMode();
        })
            .fail(function (xhr, status, error) {
                console.log(xhr.responseText);
            });
    }
</script>
