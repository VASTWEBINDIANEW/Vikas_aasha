<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-mpos-report-page">
    <div class="container-fluid vm-opr-page-shell">

        @using (Html.BeginForm("m_Possreport", "Home", FormMethod.Post, new { id = "mposReportForm", @class = "vm-rpt-filters-panel__form" }))
