<script>
    function hideMposTotals() {
        var $panel = $('#mposTotalsPanel');
        var $btn = $('.vm-mpos-totals-btn');
        $panel.removeClass('is-open').hide().attr('aria-hidden', 'true');
        $btn.removeClass('is-active').attr({ title: 'Show totals', 'aria-expanded': 'false' });
    }

    function findtotal() {
        var $panel = $('#mposTotalsPanel');
        var $btn = $('.vm-mpos-totals-btn');

        if ($panel.hasClass('is-open')) {
            hideMposTotals();
            return;
        }

        var ddlusers = $('#ddlusers').val();
        var allmaster = $('#allmaster2').val();
        var alldealer = $('#alldealer').val();
        var allretailer = $('#allretailer').val();
        var ddl_status = $('#ddl_status').val();
        var txt_frm_date = $('#txt_frm_date').val();
        var txt_to_date = $('#txt_to_date').val();

        $panel.addClass('is-open').show().attr('aria-hidden', 'false');
        $btn.addClass('is-active').attr({ title: 'Hide totals', 'aria-expanded': 'true' });

        $.post("@Url.Action("mpos_Total", "Home")",
            { "ddlusers": ddlusers, "allmaster2": allmaster, "alldealer": alldealer, "allretailer": allretailer, "ddl_status": ddl_status, "txt_frm_date": txt_frm_date, "txt_to_date": txt_to_date },
            function (data) {
                $('#successtotal').text("₹ " + data.success);
                $('#Failedtotal').text("₹ " + data.failed);
            });
    }

    function mdActionBtn(Idno) {
        $('#loadredmodel').show();
        $.ajax({
            url: '@Url.Action("m_Possreport_View", "Home")',
            type: "POST",
            data: { Idno: Idno },
            cache: false,
            success: function (Response) {
                $("#cardnumber").val(Response[0].cardnumber);
                $("#cardholdername").val(Response[0].cardholdername);
                $("#TxnId").val(Response[0].TxnId);
                $("#merchatID").val(Response[0].merchatID);
                $("#bankmerchantID").val(Response[0].bankmerchantID);
                $("#invoiceno").val(Response[0].invoiceno);
                $("#paymentid").val(Response[0].paymentid);
                $("#merchantnameaddress").val(Response[0].merchantnameaddress);
                $("#AdminPre").val(Response[0].AdminPre);
                $("#AdminPost").val(Response[0].AdminPost);
                $("#adminincome").val(Response[0].dlmincome);
                $("#MasterPre").val(Response[0].MasterPre);
                $("#MasterPost").val(Response[0].MasterPost);
                $("#MdComm").val(Response[0].MdComm);
                $("#mdincome").val(Response[0].mdincome);
                $("#mdgst").val(Response[0].mdgst);
                $("#DealerPre").val(Response[0].DealerPre);
                $("#DealerPost").val(Response[0].DealerPost);
                $("#Dlm_Comm").val(Response[0].Dlm_Comm);
                $("#dlmincome").val(Response[0].dlmincome);
                $("#dlmgst").val(Response[0].dlmgst);
                $("#RetailerPre").val(Response[0].RetailerPre);
                $("#RetailerPost").val(Response[0].RetailerPost);
                $("#remincome").val(Response[0].mdincome);
                $("#remgst").val(Response[0].remgst);
                $("#Message").val(Response[0].Message);
            },
            complete: function () {
                $('#loadredmodel').hide();
            }
        });
    }

    var pageindex = 2;
    var NoMoredata = false;
    var inProgress = false;
    $(window).scroll(function () {
        var ddlusers = $('#ddlusers').val();
        var allmaster = $('#allmaster2').val();
        var allwhitelabel = $('#allwhitelabel1').val();
        var alldealer = $('#alldealer').val();
        var allretailer = $('#allretailer').val();
        var ddl_status = $('#ddl_status').val();
        var txt_frm_date = $('#txt_frm_date').val();
        var txt_to_date = $('#txt_to_date').val();
        if ($(window).scrollTop() > Number($("#mpos").height()) / 4 && !NoMoredata && !inProgress) {
            inProgress = true;
            $("#loadingdiv").show();
            $.post("@Url.Action("InfiniteScroll_mpos", "Home")",
                { "pageindex": pageindex, "ddlusers": ddlusers, "allmaster2": allmaster, "allwhitelabel1": allwhitelabel, "alldealer": alldealer, "allretailer": allretailer, "ddl_status": ddl_status, "txt_frm_date": txt_frm_date, "txt_to_date": txt_to_date },
                function (data) {
                    pageindex = pageindex + 1;
                    NoMoredata = data.NoMoredata;
                    $("#trow").append(data.HTMLString);
                    $("#loadingdiv").hide();
                    inProgress = false;
                    if (window.vmMposRenumberSr) {
                        window.vmMposRenumberSr();
                    }
                });
        }
    });

    $("#btnPDF").click(function () {
        var txt_frm_date = $('#txt_frm_date').val();
        var txt_to_date = $('#txt_to_date').val();
        var ddlusers = $('#ddlusers').val();
        var ddl_status = $('#ddl_status').val();
        var allmaster = $('#allmaster2').val();
        var alldealer = $('#alldealer').val();
        var allretailer = $('#allretailer').val();
        var url = '@Url.Action("PDFMposReport", "Home")?txt_frm_date=' + txt_frm_date + '&txt_to_date=' + txt_to_date + '&ddlusers=' + ddlusers + '&ddl_status=' + ddl_status + '&allmaster2=' + allmaster + '&alldealer=' + alldealer + '&allretailer=' + allretailer;
        window.open(url, '_blank');
    });

    $("#btnExport").click(function () {
        var txt_frm_date = $('#txt_frm_date').val();
        var txt_to_date = $('#txt_to_date').val();
        var ddlusers = $('#ddlusers').val();
        var ddl_status = $('#ddl_status').val();
        var allmaster = $('#allmaster2').val();
        var alldealer = $('#alldealer').val();
        var allretailer = $('#allretailer').val();
        var url = '@Url.Action("ExcelRechargereport_mpos", "Home")?txt_frm_date=' + txt_frm_date + '&txt_to_date=' + txt_to_date + '&ddlusers=' + ddlusers + '&ddl_status=' + ddl_status + '&allmaster2=' + allmaster + '&alldealer=' + alldealer + '&allretailer=' + allretailer;
        location.href = url;
    });

    function answers() {
        var e = document.getElementById("ddlusers");
        var answer = e.options[e.selectedIndex].value;
        var fields = ["allwhitelabel", "allmaster", "dlm", "rem"];
        fields.forEach(function (id) {
            document.getElementById(id).style.display = "none";
        });
        if (answer == "Dealer") {
            document.getElementById("dlm").style.display = "block";
        } else if (answer == "Whitelabel") {
            document.getElementById("allwhitelabel").style.display = "block";
        } else if (answer == "Master") {
            document.getElementById("allmaster").style.display = "block";
        } else if (answer == "Retailer") {
            document.getElementById("rem").style.display = "block";
        }
    }

    function GotoView(idno) {
        $.ajax({
            url: '@Url.Action("MposStatus", "Home")',
            type: "Post",
            dataType: 'json',
            cache: false,
            data: { idno: idno },
            success: function (result) {
                var resp = result.split('~');
                var output = resp[0];
                var Tid = resp[1];
                $('#TID').val(Tid);
                if (output == "RefundPending") {
                    $('#myModal').modal('show');
                }
                else if (output == "Success") {
                    swal({ title: "Response !", text: "Money Transfer Success.", type: "success" },
                        function () { location.reload(); });
                }
                else if (output == "Failed" || output == "Refunded") {
                    swal({ title: "Response !", text: "Money Transfer Failed.", type: "error" },
                        function () { location.reload(); });
                }
                else if (output == "Pending") {
                    swal({ title: "Response !", text: "Money Transfer Pending.", type: "warning" },
                        function () { location.reload(); });
                }
            }
        });
    }

    $(document).ready(function () {
        $('#txt_frm_date, #txt_to_date').datepicker({
            format: "yyyy-mm-dd",
            todayHighlight: true,
            autoclose: true,
            orientation: "bottom auto"
        });
        var val = '@ViewBag.chk';
        if (val != "post") {
            $("#txt_frm_date").datepicker("setDate", new Date());
            $("#txt_to_date").datepicker("setDate", new Date());
        }
        answers();
    });

    $(function () {
        var loc = window.location.href;
        if (loc.indexOf('/ADMIN/Home/m_Possreport') !== -1) {
            $('.sidebar .kkli li:nth-child(2) a').addClass('activee');
        }
    });
</script>
