@model IEnumerable<Vastwebmulti.Areas.ADMIN.Models.ApiCallBack>
@using System.Linq
@{
    ViewBag.Title = "ApiCallBackUrl";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var rows = Model != null ? Model.ToList() : new List<Vastwebmulti.Areas.ADMIN.Models.ApiCallBack>();
    var apiSelectList = ViewBag.apiinfo as SelectList;
    var reqtypeList = ViewBag.reqtype as SelectList;
    var reqbodytypeList = ViewBag.reqbodytype as SelectList;
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=28" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-api-operator-modern.css?v=32" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-api-operator-page saas-recharge-api-response-page saas-recharge-api-callback-url-page">
    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
            <div class="saas-acc-toolbar-top vm-api-operator-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-api-operator-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li><a href="@Url.Action("Dashboard", "Home")#setting">Basic Setting</a></li>
                    <li>Recharge API Call Back</li>
                </ol>
                <div class="vm-dmt-fin-nav-row vm-api-operator-nav-wrap">
                    @Html.Partial("_menuapinm")
                </div>
            </div>

            <div class="vm-rpt-filters-panel vm-api-operator-filter-panel">
                <div class="saas-acc-filter-bar vm-opr-filter-row vm-api-operator-filter-row vm-rpt-filters-panel__bar vm-recharge-api-toolbar-one-line">
                    <div class="vm-recharge-api-sub-tabs" role="tablist" aria-label="Recharge API">
                        <a href="@Url.Action("RechargeAPIUrl", "Home")" class="vm-recharge-api-sub-tab" role="tab" aria-selected="false">Recharge API URL</a>
                        <a href="@Url.Action("RechargeApiResponse", "Home")" class="vm-recharge-api-sub-tab" role="tab" aria-selected="false">Recharge API Response</a>
                        <a href="@Url.Action("ApiCallBackUrl", "Home")" class="vm-recharge-api-sub-tab is-active" role="tab" aria-selected="true">Recharge API Call Back</a>
                        <a href="@Url.Action("ApiCallBack", "Home")" class="vm-recharge-api-sub-tab" role="tab" aria-selected="false">Call Back Page</a>
                    </div>
                    <div class="vm-recharge-api-toolbar-actions">
                        <button type="button" class="saas-acc-btn saas-acc-btn--search vm-api-nm-add-btn vm-recharge-api-callback-add-btn" title="Add New Call Back">
                            <i class="fas fa-plus" aria-hidden="true"></i><span>Add New</span>
                        </button>
                        <div class="vm-recharge-api-search-group">
                            @using (Html.BeginForm("ApiCallBackUrl", "Home", FormMethod.Post, new { id = "rechargeApiCallbackFilterForm", @class = "vm-recharge-api-filter-form" }))
                            {
                                @Html.AntiForgeryToken()
                                <div class="vm-opr-field vm-api-operator-field vm-recharge-api-field--api">
                                    @Html.DropDownList("apiinfomove", apiSelectList, "Select Api Name", new { id = "apiinfomove", @class = "form-control vm-opr-select vm-dmt-select vm-api-operator-select" })
                                </div>
                                <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-api-operator-search-btn" title="Search">
                                    <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-phone-volume" aria-hidden="true"></i>
                        <span>Recharge API callback configuration</span>
                    </div>
                    <label class="vm-api-operator-table-search" for="rechargeApiCallbackSearch">
                        <i class="fas fa-search" aria-hidden="true"></i>
                        <input type="text" id="rechargeApiCallbackSearch" placeholder="Search records..." autocomplete="off" />
                    </label>
                </div>
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <div id="datashoww">
                            @Html.Partial("_PartialCallBack", rows)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Add Call Back Modal -->
<div class="modal fade saas-admin-modal vm-sm-modal vm-api-operator-modal vm-api-nm-modal vm-recharge-api-modal" id="rechargeApiCallbackAddModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered saas-admin-modal-dialog vm-sm-modal-dialog vm-sm-modal-dialog--editor" role="document">
        <div class="modal-content">
            @using (Ajax.BeginForm("ApiCallbackAdd", "Home", new AjaxOptions { HttpMethod = "POST", UpdateTargetId = "datashoww", OnSuccess = "rechargeApiCallbackAddSuccess" }, new { id = "rechargeApiCallbackAddForm" }))
            {
                @Html.AntiForgeryToken()
                @Html.Hidden("uniqueid", "", new { id = "uniqueid" })
                <div class="modal-header saas-admin-modal-header accent-sky">
                    <div class="saas-admin-modal-head-main">
                        <div class="saas-admin-modal-icon"><i class="fas fa-plus" aria-hidden="true"></i></div>
                        <div class="saas-admin-modal-title-wrap">
                            <h4 class="modal-title saas-admin-modal-title">Add Recharge API Call Back</h4>
                            <p class="saas-admin-modal-subtitle">Configure callback request mapping and status keys</p>
                        </div>
                    </div>
                    <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
                </div>
                <div class="modal-body saas-admin-modal-body saas-admin-modal-scroll vm-sm-modal-body">
                    <div class="vm-sm-modal-panel vm-api-operator-form-grid">
                        <div class="vm-sm-modal-field">
                            <label for="apiinfo">API Name</label>
                            @Html.DropDownList("apiinfo", apiSelectList, "Select Api Name", new { id = "apiinfo", @class = "form-control", required = "required" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="reqtype">Request Type</label>
                            @Html.DropDownList("reqtype", reqtypeList, "Select Request Type", new { id = "reqtype", @class = "form-control", required = "required" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="reqbodytype">Body Type</label>
                            @Html.DropDownList("reqbodytype", reqbodytypeList, "Select Body Type", new { id = "reqbodytype", @class = "form-control", required = "required" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="addKeyStatus">Key Status</label>
                            @Html.TextBox("addKeyStatus", "", new { id = "addKeyStatus", @class = "form-control", placeholder = "Enter Key Status" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="addvalsuccess">Value Success Status</label>
                            @Html.TextBox("addvalsuccess", "", new { id = "addvalsuccess", @class = "form-control", placeholder = "Enter Value Success Status", required = "required" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="addvalfailed">Value Failed Status</label>
                            @Html.TextBox("addvalfailed", "", new { id = "addvalfailed", @class = "form-control", placeholder = "Enter Value Failed Status", required = "required" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="addKeyrch">Key Rch ID</label>
                            @Html.TextBox("addKeyrch", "", new { id = "addKeyrch", @class = "form-control", placeholder = "Key Rch ID", required = "required" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="KeyMessage">Key Message</label>
                            @Html.TextBox("KeyMessage", "", new { id = "KeyMessage", @class = "form-control", placeholder = "Key Message" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="keyoptid">Key Operator ID</label>
                            @Html.TextBox("keyoptid", "", new { id = "keyoptid", @class = "form-control", placeholder = "Key Operator ID", required = "required" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="keybalance">Key Balance</label>
                            @Html.TextBox("keybalance", "", new { id = "keybalance", @class = "form-control", placeholder = "Key Balance" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="otp">OTP</label>
                            @Html.TextBox("otp", "", new { id = "otp", @class = "form-control", placeholder = "Enter 4 digit OTP", required = "required", pattern = "[0-9]{4}", title = "Enter 4 digit OTP" })
                        </div>
                    </div>
                </div>
                <div class="modal-footer saas-admin-modal-footer vm-sm-modal-footer">
                    <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal">
                        <i class="fas fa-times" aria-hidden="true"></i> Cancel
                    </button>
                    <button type="submit" class="saas-admin-modal-btn saas-admin-modal-btn--success">
                        <i class="fas fa-save" aria-hidden="true"></i> Submit
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Edit Call Back Modal -->
<div class="modal fade saas-admin-modal vm-sm-modal vm-api-operator-modal vm-api-nm-modal vm-recharge-api-modal" id="rechargeApiCallbackEditModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered saas-admin-modal-dialog vm-sm-modal-dialog vm-sm-modal-dialog--editor" role="document">
        <div class="modal-content">
            @using (Ajax.BeginForm("UpdateRechargeApiCallBack", "Home", new AjaxOptions { HttpMethod = "POST", UpdateTargetId = "datashoww", OnSuccess = "rechargeApiCallbackEditSuccess" }, new { id = "rechargeApiCallbackEditForm" }))
            {
                @Html.AntiForgeryToken()
                @Html.Hidden("unique_update", "", new { id = "unique_update" })
                @Html.Hidden("editidno", "", new { id = "editidno" })
                @Html.Hidden("editapiinfo1", "", new { id = "editapiinfo1" })
                <div class="modal-header saas-admin-modal-header accent-emerald">
                    <div class="saas-admin-modal-head-main">
                        <div class="saas-admin-modal-icon"><i class="fas fa-edit" aria-hidden="true"></i></div>
                        <div class="saas-admin-modal-title-wrap">
                            <h4 class="modal-title saas-admin-modal-title">Edit Recharge API Call Back</h4>
                            <p class="saas-admin-modal-subtitle">Update callback request mapping and status keys</p>
                        </div>
                    </div>
                    <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
                </div>
                <div class="modal-body saas-admin-modal-body saas-admin-modal-scroll vm-sm-modal-body">
                    <div class="vm-sm-modal-panel vm-api-operator-form-grid">
                        <div class="vm-sm-modal-field">
                            <label for="editapiinfo">API Name</label>
                            @Html.DropDownList("editapiinfo", apiSelectList, "Select Api Name", new { id = "editapiinfo", @class = "form-control", @disabled = "disabled" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="editreqtype">Request Type</label>
                            @Html.DropDownList("editreqtype", reqtypeList, "Select Request Type", new { id = "editreqtype", @class = "form-control", required = "required" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="editreqbodytype">Body Type</label>
                            @Html.DropDownList("editreqbodytype", reqbodytypeList, "Select Body Type", new { id = "editreqbodytype", @class = "form-control", required = "required" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="editKeyStatus">Key Status</label>
                            @Html.TextBox("editKeyStatus", "", new { id = "editKeyStatus", @class = "form-control", placeholder = "Enter Key Status", required = "required" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="editvalsuccess">Value Success Status</label>
                            @Html.TextBox("editvalsuccess", "", new { id = "editvalsuccess", @class = "form-control", placeholder = "Enter Value Success Status", required = "required" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="editvalfailed">Value Failed Status</label>
                            @Html.TextBox("editvalfailed", "", new { id = "editvalfailed", @class = "form-control", placeholder = "Enter Value Failed Status", required = "required" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="editKeyrch">Key Rch ID</label>
                            @Html.TextBox("editKeyrch", "", new { id = "editKeyrch", @class = "form-control", placeholder = "Key Rch ID", required = "required" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="editKeyMessage">Key Message</label>
                            @Html.TextBox("editKeyMessage", "", new { id = "editKeyMessage", @class = "form-control", placeholder = "Key Message" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="editkeyoptid">Key Operator ID</label>
                            @Html.TextBox("editkeyoptid", "", new { id = "editkeyoptid", @class = "form-control", placeholder = "Key Operator ID", required = "required" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="editkeybalance">Key Balance</label>
                            @Html.TextBox("editkeybalance", "", new { id = "editkeybalance", @class = "form-control", placeholder = "Key Balance" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="otp_update">OTP</label>
                            @Html.TextBox("otp_update", "", new { id = "otp_update", @class = "form-control", placeholder = "Enter 4 digit OTP", required = "required", pattern = "[0-9]{4}", title = "Enter 4 digit OTP" })
                        </div>
                    </div>
                </div>
                <div class="modal-footer saas-admin-modal-footer vm-sm-modal-footer">
                    <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal">
                        <i class="fas fa-times" aria-hidden="true"></i> Cancel
                    </button>
                    <button type="submit" class="saas-admin-modal-btn saas-admin-modal-btn--success">
                        <i class="fas fa-save" aria-hidden="true"></i> Save Changes
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<script>
    window.rechargeApiCallbackAddSuccess = function () {
        if (typeof window.hideAdminModal === 'function') {
            window.hideAdminModal('#rechargeApiCallbackAddModal');
        } else if (window.jQuery) {
            window.jQuery('#rechargeApiCallbackAddModal').modal('hide');
        }
    };

    window.rechargeApiCallbackEditSuccess = function () {
        if (typeof window.hideAdminModal === 'function') {
            window.hideAdminModal('#rechargeApiCallbackEditModal');
        } else if (window.jQuery) {
            window.jQuery('#rechargeApiCallbackEditModal').modal('hide');
        }
    };

    (function () {
        function applyRechargeApiCallbackSearch() {
            var q = ($('#rechargeApiCallbackSearch').val() || '').trim().toLowerCase();
            $('#rechargeApiCallbackTable tbody tr').each(function () {
                var text = $(this).text().toLowerCase();
                $(this).toggle(!q || text.indexOf(q) > -1);
            });
        }

        function openRechargeApiCallbackModal(selector) {
            if (typeof window.showAdminModal === 'function') {
                window.showAdminModal(selector);
            } else if (window.jQuery) {
                window.jQuery(selector).modal('show');
            }
        }

        function closeRechargeApiCallbackModal(selector) {
            var target = selector;
            if (selector && selector.jquery) {
                target = '#' + selector.attr('id');
            }
            if (typeof window.hideAdminModal === 'function') {
                window.hideAdminModal(target);
            } else if (window.jQuery) {
                window.jQuery(target).modal('hide');
            }
        }

        function recharge_api_callback_otp(type, done) {
            if (type === 'ApiCallbackInsert') {
                $('#uniqueid').val('');
            } else if (type === 'ApiCallbackUpdate') {
                $('#unique_update').val('');
            }

            fetch('@Url.Action("ApiResponseInsert_SendOtp", "Home")?type=' + encodeURIComponent(type))
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    if (data && data.status) {
                        if (type === 'ApiCallbackInsert') {
                            $('#uniqueid').val(data.uniqueid || '');
                        } else if (type === 'ApiCallbackUpdate') {
                            $('#unique_update').val(data.uniqueid || '');
                        }
                        if (typeof done === 'function') {
                            done();
                        }
                    } else if (window.swal) {
                        swal('Error', (data && data.message) ? data.message : 'Unable to send OTP.', 'error');
                    }
                })
                .catch(function () {
                    if (window.swal) {
                        swal('Error', 'Unable to send OTP.', 'error');
                    }
                });
        }

        function fillRechargeApiCallbackEditForm(row) {
            $('#editidno').val(row.idno);
            $('#editapiinfo').val(row.id).trigger('change');
            $('#editapiinfo1').val(row.id);
            $('#editreqtype').val(row.Requesttype).trigger('change');
            $('#editreqbodytype').val(row.bodytype).trigger('change');
            $('#editKeyStatus').val(row.keystatus || '');
            $('#editvalsuccess').val(row.valstatussuccess || '');
            $('#editvalfailed').val(row.valstatusfailed || '');
            $('#editKeyrch').val(row.keyrchid || '');
            $('#editKeyMessage').val(row.keymsg || '');
            $('#editkeyoptid').val(row.keyoperatorid || '');
            $('#editkeybalance').val(row.keybalance || '');
            $('#otp_update').val('');
        }

        function openRechargeApiCallbackEdit(idno) {
            var $btn = $('.vm-recharge-api-callback-edit-btn[data-idno="' + idno + '"]');
            $btn.prop('disabled', true);

            recharge_api_callback_otp('ApiCallbackUpdate');

            fetch('@Url.Action("EditcallBack", "Home")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ idno: idno })
            })
                .then(function (response) { return response.json(); })
                .then(function (res) {
                    if (!res || !res.length) {
                        if (window.swal) {
                            swal('Error', 'Unable to load callback details.', 'error');
                        }
                        return;
                    }

                    fillRechargeApiCallbackEditForm(res[0]);
                    openRechargeApiCallbackModal('#rechargeApiCallbackEditModal');
                })
                .catch(function () {
                    if (window.swal) {
                        swal('Error', 'Unable to load callback details.', 'error');
                    }
                })
                .finally(function () {
                    $btn.prop('disabled', false);
                });
        }

        function initRechargeApiCallbackFilter($) {
            var $api = $('#apiinfomove');
            if (!$api.length || !$.fn.select2) {
                return;
            }
            if ($api.hasClass('select2-hidden-accessible')) {
                $api.select2('destroy');
            }
            $api.select2({
                width: '100%',
                placeholder: 'Select Api Name',
                allowClear: true,
                dropdownParent: $(document.body)
            });
        }

        function bootRechargeApiCallbackPage() {
            var $ = window.jQuery;
            if (!$ || !$.fn || !$.fn.modal) {
                window.setTimeout(bootRechargeApiCallbackPage, 50);
                return;
            }

            initRechargeApiCallbackFilter($);
            $('#rechargeApiCallbackSearch').off('keyup.rechargeApiCb').on('keyup.rechargeApiCb', applyRechargeApiCallbackSearch);

            $(document).off('click.rechargeApiCbAdd', '.vm-recharge-api-callback-add-btn').on('click.rechargeApiCbAdd', '.vm-recharge-api-callback-add-btn', function (e) {
                e.preventDefault();
                recharge_api_callback_otp('ApiCallbackInsert');
                openRechargeApiCallbackModal('#rechargeApiCallbackAddModal');
            });

            $(document).off('click.rechargeApiCbEdit', '.vm-recharge-api-callback-edit-btn').on('click.rechargeApiCbEdit', '.vm-recharge-api-callback-edit-btn', function () {
                openRechargeApiCallbackEdit($(this).data('idno'));
            });

            $('#rechargeApiCallbackAddModal, #rechargeApiCallbackEditModal').off('click.rechargeApiCbClose', '[data-dismiss="modal"]').on('click.rechargeApiCbClose', '[data-dismiss="modal"]', function (e) {
                e.preventDefault();
                closeRechargeApiCallbackModal($(this).closest('.modal'));
            });

            $('#rechargeApiCallbackAddModal').off('hidden.bs.modal.rechargeApiCb').on('hidden.bs.modal.rechargeApiCb', function () {
                var form = document.getElementById('rechargeApiCallbackAddForm');
                if (form) {
                    form.reset();
                }
                $('#uniqueid').val('');
            });

            $('#rechargeApiCallbackEditModal').off('hidden.bs.modal.rechargeApiCb').on('hidden.bs.modal.rechargeApiCb', function () {
                $('#unique_update').val('');
                $('#otp_update').val('');
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', bootRechargeApiCallbackPage);
        } else {
            bootRechargeApiCallbackPage();
        }
    })();
</script>
