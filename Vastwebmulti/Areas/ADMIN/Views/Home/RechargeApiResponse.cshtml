@model IEnumerable<Vastwebmulti.Areas.ADMIN.Models.RchApiResponse>
@using System.Linq
@{
    ViewBag.Title = "RechargeApiResponse";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var rows = Model != null ? Model.ToList() : new List<Vastwebmulti.Areas.ADMIN.Models.RchApiResponse>();
    var apiSelectList = ViewBag.apiinfo as SelectList;
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=28" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-api-operator-modern.css?v=31" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-api-operator-page saas-recharge-api-response-page">
    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
            <div class="saas-acc-toolbar-top vm-api-operator-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-api-operator-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li><a href="@Url.Action("Dashboard", "Home")#setting">Basic Setting</a></li>
                    <li>Recharge API Response</li>
                </ol>
                <div class="vm-dmt-fin-nav-row vm-api-operator-nav-wrap">
                    @Html.Partial("_menuapinm")
                </div>
            </div>

            <div class="vm-rpt-filters-panel vm-api-operator-filter-panel">
                <div class="saas-acc-filter-bar vm-opr-filter-row vm-api-operator-filter-row vm-rpt-filters-panel__bar vm-recharge-api-toolbar-one-line">
                    <div class="vm-recharge-api-sub-tabs" role="tablist" aria-label="Recharge API">
                        <a href="@Url.Action("RechargeAPIUrl", "Home")" class="vm-recharge-api-sub-tab" role="tab" aria-selected="false">Recharge API URL</a>
                        <a href="@Url.Action("RechargeApiResponse", "Home")" class="vm-recharge-api-sub-tab is-active" role="tab" aria-selected="true">Recharge API Response</a>
                        <a href="@Url.Action("ApiCallBackUrl", "Home")" class="vm-recharge-api-sub-tab" role="tab" aria-selected="false">Recharge API Call Back</a>
                        <a href="@Url.Action("ApiCallBack", "Home")" class="vm-recharge-api-sub-tab" role="tab" aria-selected="false">Call Back Page</a>
                    </div>
                    <div class="vm-recharge-api-toolbar-actions">
                        <button type="button" class="saas-acc-btn saas-acc-btn--search vm-api-nm-add-btn vm-recharge-api-response-add-btn" title="Add New Response">
                            <i class="fas fa-plus" aria-hidden="true"></i><span>Add New</span>
                        </button>
                        <div class="vm-recharge-api-search-group">
                            @using (Html.BeginForm("RechargeApiResponse", "Home", FormMethod.Post, new { id = "rechargeApiResponseFilterForm", @class = "vm-recharge-api-filter-form" }))
                            {
                                @Html.AntiForgeryToken()
                                <div class="vm-opr-field vm-api-operator-field vm-recharge-api-field--api">
                                    @Html.DropDownList("apiinfomove", apiSelectList, "Select Api Name", new { id = "apiinfomove", @class = "form-control vm-opr-select vm-dmt-select vm-api-operator-select" })
                                </div>
                                <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-api-operator-search-btn" title="Search">
                                    <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-reply" aria-hidden="true"></i>
                        <span>Recharge API response configuration</span>
                    </div>
                    <label class="vm-api-operator-table-search" for="rechargeApiResponseSearch">
                        <i class="fas fa-search" aria-hidden="true"></i>
                        <input type="text" id="rechargeApiResponseSearch" placeholder="Search records..." autocomplete="off" />
                    </label>
                </div>
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <div id="datashoww">
                            @Html.Partial("_PartialRechargeApiResponse", rows)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Add Response Modal -->
<div class="modal fade saas-admin-modal vm-sm-modal vm-api-operator-modal vm-api-nm-modal vm-recharge-api-modal" id="rechargeApiResponseAddModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered saas-admin-modal-dialog vm-sm-modal-dialog vm-sm-modal-dialog--editor" role="document">
        <div class="modal-content">
            @using (Ajax.BeginForm("ApiResponseInsert", "Home", new AjaxOptions { HttpMethod = "POST", UpdateTargetId = "datashoww", OnSuccess = "rechargeApiResponseAddSuccess" }, new { id = "rechargeApiResponseAddForm" }))
            {
                @Html.AntiForgeryToken()
                @Html.Hidden("uniqueid", "", new { id = "uniqueid" })
                <div class="modal-header saas-admin-modal-header accent-sky">
                    <div class="saas-admin-modal-head-main">
                        <div class="saas-admin-modal-icon"><i class="fas fa-plus" aria-hidden="true"></i></div>
                        <div class="saas-admin-modal-title-wrap">
                            <h4 class="modal-title saas-admin-modal-title">Add Recharge API Response</h4>
                            <p class="saas-admin-modal-subtitle">Map API response keys and status values</p>
                        </div>
                    </div>
                    <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
                </div>
                <div class="modal-body saas-admin-modal-body saas-admin-modal-scroll vm-sm-modal-body">
                    <div class="vm-sm-modal-panel vm-api-operator-form-grid">
                        <div class="vm-sm-modal-field">
                            <label for="apiinfo">API Name</label>
                            @Html.DropDownList("apiinfo", apiSelectList, "Select Api Name", new { id = "apiinfo", @class = "form-control", required = "required" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="restype">Response Type</label>
                            @Html.DropDownList("restype", ViewBag.resptype as SelectList, "Select Response Type", new { id = "restype", @class = "form-control", required = "required" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="addKeyRequestid">Key Requestid</label>
                            @Html.TextBox("addKeyRequestid", "", new { id = "addKeyRequestid", @class = "form-control", placeholder = "Enter Key Requestid" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="addKeyStatus">Key Status</label>
                            @Html.TextBox("addKeyStatus", "", new { id = "addKeyStatus", @class = "form-control", placeholder = "Enter Key Status", required = "required" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="addKeyOptID">Key OptID</label>
                            @Html.TextBox("addKeyOptID", "", new { id = "addKeyOptID", @class = "form-control", placeholder = "Enter Key OptID", required = "required" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="addKeymsg">Key Message</label>
                            @Html.TextBox("addKeymsg", "", new { id = "addKeymsg", @class = "form-control", placeholder = "Enter Message" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="KeyRemainBal">Key Remain Bal</label>
                            @Html.TextBox("KeyRemainBal", "", new { id = "KeyRemainBal", @class = "form-control", placeholder = "Key Remain Bal" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="ValStatusSucess">Value Status Success</label>
                            @Html.TextBox("ValStatusSucess", "", new { id = "ValStatusSucess", @class = "form-control", placeholder = "Value Status Success", required = "required" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="ValStatusFailed">Value Status Failed</label>
                            @Html.TextBox("ValStatusFailed", "", new { id = "ValStatusFailed", @class = "form-control", placeholder = "Value Status Failed", required = "required" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="ValStatusPending">Value Status Pending</label>
                            @Html.TextBox("ValStatusPending", "", new { id = "ValStatusPending", @class = "form-control", placeholder = "Value Status Pending", required = "required" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="sapratewith">Split With</label>
                            @Html.TextBox("sapratewith", "", new { id = "sapratewith", @class = "form-control", placeholder = "Split with" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="Keyerror">Key Error</label>
                            @Html.TextBox("Keyerror", "", new { id = "Keyerror", @class = "form-control", placeholder = "Key Error" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="KeyerrorMessage">Key Error Message</label>
                            @Html.TextBox("KeyerrorMessage", "", new { id = "KeyerrorMessage", @class = "form-control", placeholder = "Key Error Message" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="valerror">Value Error</label>
                            @Html.TextBox("valerror", "", new { id = "valerror", @class = "form-control", placeholder = "Value Error" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="valerrorMessage">Value Error Message</label>
                            @Html.TextBox("valerrorMessage", "", new { id = "valerrorMessage", @class = "form-control", placeholder = "Value Error Message" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="otp">OTP</label>
                            @Html.TextBox("otp", "", new { id = "otp", @class = "form-control", placeholder = "Enter 4 digit OTP", required = "required", pattern = "[0-9]{4}", title = "Enter 4 digit OTP" })
                        </div>
                    </div>
                </div>
                <div class="modal-footer saas-admin-modal-footer vm-sm-modal-footer">
                    <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal">
                        <i class="fas fa-times" aria-hidden="true"></i> Cancel
                    </button>
                    <button type="submit" class="saas-admin-modal-btn saas-admin-modal-btn--success">
                        <i class="fas fa-save" aria-hidden="true"></i> Submit
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Edit Response Modal -->
<div class="modal fade saas-admin-modal vm-sm-modal vm-api-operator-modal vm-api-nm-modal vm-recharge-api-modal" id="rechargeApiResponseEditModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered saas-admin-modal-dialog vm-sm-modal-dialog vm-sm-modal-dialog--editor" role="document">
        <div class="modal-content">
            @using (Ajax.BeginForm("rechargerespUpdate", "Home", new AjaxOptions { HttpMethod = "POST", UpdateTargetId = "datashoww", OnSuccess = "rechargeApiResponseEditSuccess" }, new { id = "rechargeApiResponseEditForm" }))
            {
                @Html.AntiForgeryToken()
                @Html.Hidden("unique_update", "", new { id = "unique_update" })
                @Html.Hidden("editidno", "", new { id = "editidno" })
                @Html.Hidden("editapiinfo1", "", new { id = "editapiinfo1" })
                <div class="modal-header saas-admin-modal-header accent-emerald">
                    <div class="saas-admin-modal-head-main">
                        <div class="saas-admin-modal-icon"><i class="fas fa-edit" aria-hidden="true"></i></div>
                        <div class="saas-admin-modal-title-wrap">
                            <h4 class="modal-title saas-admin-modal-title">Edit Recharge API Response</h4>
                            <p class="saas-admin-modal-subtitle">Update response mapping and status values</p>
                        </div>
                    </div>
                    <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
                </div>
                <div class="modal-body saas-admin-modal-body saas-admin-modal-scroll vm-sm-modal-body">
                    <div class="vm-sm-modal-panel vm-api-operator-form-grid">
                        <div class="vm-sm-modal-field">
                            <label for="editapiinfo">API Name</label>
                            @Html.DropDownList("editapiinfo", apiSelectList, "Select Api Name", new { id = "editapiinfo", @class = "form-control", @disabled = "disabled" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="editresptype">Response Type</label>
                            @Html.DropDownList("editresptype", ViewBag.resptype as SelectList, "Select Response Type", new { id = "editresptype", @class = "form-control", required = "required" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="editKeyRequestid">Key Request ID</label>
                            @Html.TextBox("editKeyRequestid", "", new { id = "editKeyRequestid", @class = "form-control", placeholder = "Enter Key Requestid" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="editKeyStatus">Key Status</label>
                            @Html.TextBox("editKeyStatus", "", new { id = "editKeyStatus", @class = "form-control", placeholder = "Enter Key Status", required = "required" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="editKeyOptID">Key OptID</label>
                            @Html.TextBox("editKeyOptID", "", new { id = "editKeyOptID", @class = "form-control", placeholder = "Enter Key OptID", required = "required" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="EditKeymsg">Key Message</label>
                            @Html.TextBox("EditKeymsg", "", new { id = "EditKeymsg", @class = "form-control", placeholder = "Key Message" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="editRemainBal">Key Remain Bal</label>
                            @Html.TextBox("editRemainBal", "", new { id = "editRemainBal", @class = "form-control", placeholder = "Key Remain Bal" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="editValStatusSucess">Value Status Success</label>
                            @Html.TextBox("editValStatusSucess", "", new { id = "editValStatusSucess", @class = "form-control", placeholder = "Value Status Success", required = "required" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="editValStatusFailed">Value Status Failed</label>
                            @Html.TextBox("editValStatusFailed", "", new { id = "editValStatusFailed", @class = "form-control", placeholder = "Value Status Failed", required = "required" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="editValStatusPending">Value Status Pending</label>
                            @Html.TextBox("editValStatusPending", "", new { id = "editValStatusPending", @class = "form-control", placeholder = "Value Status Pending", required = "required" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="editsapratewith">Split With</label>
                            @Html.TextBox("editsapratewith", "", new { id = "editsapratewith", @class = "form-control", placeholder = "Split with" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="editKeyerror">Key Error</label>
                            @Html.TextBox("editKeyerror", "", new { id = "editKeyerror", @class = "form-control", placeholder = "Key Error" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="editKeyerrorMessage">Key Error Message</label>
                            @Html.TextBox("editKeyerrorMessage", "", new { id = "editKeyerrorMessage", @class = "form-control", placeholder = "Key Error Message" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="editvalerror">Value Error</label>
                            @Html.TextBox("editvalerror", "", new { id = "editvalerror", @class = "form-control", placeholder = "Value Error" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="editvalerrorMessage">Value Error Message</label>
                            @Html.TextBox("editvalerrorMessage", "", new { id = "editvalerrorMessage", @class = "form-control", placeholder = "Value Error Message" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="otp_update">OTP</label>
                            @Html.TextBox("otp_update", "", new { id = "otp_update", @class = "form-control", placeholder = "Enter 4 digit OTP", required = "required", pattern = "[0-9]{4}", title = "Enter 4 digit OTP" })
