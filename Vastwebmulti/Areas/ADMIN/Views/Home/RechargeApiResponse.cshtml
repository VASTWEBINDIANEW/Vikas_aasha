<script>
    window.rechargeApiResponseAddSuccess = function () {
        if (typeof window.hideAdminModal === 'function') {
            window.hideAdminModal('#rechargeApiResponseAddModal');
        } else if (window.jQuery) {
            window.jQuery('#rechargeApiResponseAddModal').modal('hide');
        }
    };

    window.rechargeApiResponseEditSuccess = function () {
        if (typeof window.hideAdminModal === 'function') {
            window.hideAdminModal('#rechargeApiResponseEditModal');
        } else if (window.jQuery) {
            window.jQuery('#rechargeApiResponseEditModal').modal('hide');
        }
    };

    (function () {
        function applyRechargeApiResponseSearch() {
            var q = ($('#rechargeApiResponseSearch').val() || '').trim().toLowerCase();
            $('#rechargeApiResponseTable tbody tr').each(function () {
                var text = $(this).text().toLowerCase();
                $(this).toggle(!q || text.indexOf(q) > -1);
            });
        }

        function openRechargeApiModal(selector) {
            if (typeof window.showAdminModal === 'function') {
                window.showAdminModal(selector);
            } else if (window.jQuery) {
                window.jQuery(selector).modal('show');
            }
        }

        function closeRechargeApiModal(selector) {
            var target = selector;
            if (selector && selector.jquery) {
                target = '#' + selector.attr('id');
            }
            if (typeof window.hideAdminModal === 'function') {
                window.hideAdminModal(target);
            } else if (window.jQuery) {
                window.jQuery(target).modal('hide');
            }
        }

        function recharge_api_insert_otp(type, done) {
            if (type === 'RechargeApiInsert') {
                $('#uniqueid').val('');
            } else if (type === 'RechargeApiUpdate') {
                $('#unique_update').val('');
            }

            fetch('@Url.Action("ApiResponseInsert_SendOtp", "Home")?type=' + encodeURIComponent(type))
                .then(function (res) { return res.json(); })
                .then(function (data) {
                    if (data && data.status) {
                        if (type === 'RechargeApiInsert') {
                            $('#uniqueid').val(data.uniqueid || '');
                        } else if (type === 'RechargeApiUpdate') {
                            $('#unique_update').val(data.uniqueid || '');
                        }
                        if (typeof done === 'function') {
                            done();
                        }
                    } else if (window.swal) {
                        swal('Error', (data && data.message) ? data.message : 'Unable to send OTP.', 'error');
                    }
                })
                .catch(function () {
                    if (window.swal) {
                        swal('Error', 'Unable to send OTP.', 'error');
                    }
                });
        }

        function fillRechargeApiResponseEditForm(row) {
            $('#editidno').val(row.Idno);
            $('#editapiinfo').val(row.id).trigger('change');
            $('#editapiinfo1').val(row.id);
            $('#editresptype').val(row.Resptype).trigger('change');
            $('#editKeyRequestid').val(row.KeyRequestid || '');
            $('#editKeyStatus').val(row.KeyStatus || '');
            $('#editKeyOptID').val(row.KeyOptID || '');
            $('#EditKeymsg').val(row.KeyMsg || '');
            $('#editRemainBal').val(row.KeyRemainBal || '');
            $('#editValStatusSucess').val(row.ValStatusSucess || '');
            $('#editValStatusFailed').val(row.ValStatusFailed || '');
            $('#editValStatusPending').val(row.ValStatusPending || '');
            $('#editsapratewith').val(row.sapratewith || '');
            $('#editKeyerror').val(row.Keyerror || '');
            $('#editKeyerrorMessage').val(row.KeyerrorMessage || '');
            $('#editvalerror').val(row.valerror || '');
            $('#editvalerrorMessage').val(row.valerrorMessage || '');
            $('#otp_update').val('');
        }

        function openRechargeApiResponseEdit(idno) {
            var $btn = $('.vm-recharge-api-response-edit-btn[data-idno="' + idno + '"]');
            $btn.prop('disabled', true);

            recharge_api_insert_otp('RechargeApiUpdate');

            fetch('@Url.Action("EditRchApiResponse", "Home")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ idno: idno })
            })
                .then(function (response) { return response.json(); })
                .then(function (res) {
                    if (!res || !res.length) {
                        if (window.swal) {
                            swal('Error', 'Unable to load response details.', 'error');
                        }
                        return;
                    }

                    fillRechargeApiResponseEditForm(res[0]);
                    openRechargeApiModal('#rechargeApiResponseEditModal');
                })
                .catch(function () {
                    if (window.swal) {
                        swal('Error', 'Unable to load response details.', 'error');
                    }
                })
                .finally(function () {
                    $btn.prop('disabled', false);
                });
        }

        function initRechargeApiResponseFilter($) {
            var $api = $('#apiinfomove');
            if (!$api.length || !$.fn.select2) {
                return;
            }
            if ($api.hasClass('select2-hidden-accessible')) {
                $api.select2('destroy');
            }
            $api.select2({
                width: '100%',
                placeholder: 'Select Api Name',
                allowClear: true,
                dropdownParent: $(document.body)
            });
        }

        function bootRechargeApiResponsePage() {
            var $ = window.jQuery;
            if (!$ || !$.fn || !$.fn.modal) {
                window.setTimeout(bootRechargeApiResponsePage, 50);
                return;
            }

            initRechargeApiResponseFilter($);
            $('#rechargeApiResponseSearch').off('keyup.rechargeApiResp').on('keyup.rechargeApiResp', applyRechargeApiResponseSearch);

            $(document).off('click.rechargeApiRespAdd', '.vm-recharge-api-response-add-btn').on('click.rechargeApiRespAdd', '.vm-recharge-api-response-add-btn', function (e) {
                e.preventDefault();
                recharge_api_insert_otp('RechargeApiInsert');
                openRechargeApiModal('#rechargeApiResponseAddModal');
            });

            $(document).off('click.rechargeApiRespEdit', '.vm-recharge-api-response-edit-btn').on('click.rechargeApiRespEdit', '.vm-recharge-api-response-edit-btn', function () {
                openRechargeApiResponseEdit($(this).data('idno'));
            });

            $('#rechargeApiResponseAddModal, #rechargeApiResponseEditModal').off('click.rechargeApiRespClose', '[data-dismiss="modal"]').on('click.rechargeApiRespClose', '[data-dismiss="modal"]', function (e) {
                e.preventDefault();
                closeRechargeApiModal($(this).closest('.modal'));
            });

            $('#rechargeApiResponseAddModal').off('hidden.bs.modal.rechargeApiResp').on('hidden.bs.modal.rechargeApiResp', function () {
                var form = document.getElementById('rechargeApiResponseAddForm');
                if (form) {
                    form.reset();
                }
                $('#uniqueid').val('');
            });

            $('#rechargeApiResponseEditModal').off('hidden.bs.modal.rechargeApiResp').on('hidden.bs.modal.rechargeApiResp', function () {
                $('#unique_update').val('');
                $('#otp_update').val('');
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', bootRechargeApiResponsePage);
        } else {
            bootRechargeApiResponsePage();
        }
    })();
</script>
