@model Vastwebmulti.Areas.ADMIN.Models.PancardSlabModel
@using (Ajax.BeginForm("_UserPANSlab_manual", "Home", new AjaxOptions { HttpMethod = "POST", OnSuccess = "OnSuccess1", OnFailure = "onfailed", UpdateTargetId = "divEditFormComm", LoadingElementId = "div_Loader", InsertionMode = InsertionMode.Replace }))
{
    <input id="btnsubmituser" type="submit" value="Update For Existing Users" class="btn waves-effect vm-pg-slab-save-btn" style="display:none;" />

    @Html.HiddenFor(m => m.role, new { id = "role" })
    <div class="row clearfix" style="margin-right:0px;">
        <div class="col-md-12">
            <div class="slab-master-block vm-prepaid-user-filter vm-prepaid-user-filter--inline">
                <div id="slab-master-message" class="slab-master-message slab-master-message-show" style="display: none;">
                    <p>If you edit the slabs of all the master distributors, you are given a data view of the common slabs.</p>
                </div>
                <div id="slab-master-detail" class="slab-master-detail slab-master-detail-hide vm-prepaid-user-filter__row" style="display: block;">
                    <div id="allshow" class="vm-prepaid-user-filter__item vm-prepaid-user-filter__item--select">
                        <div class="vm-pg-slab-field">
                            <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-users"></i></span>
                            @Html.DropDownList("ddlUserId", Model.UserId, "All Users", new { @class = "for-select2 form-control", @onchange = "ddlUserIdChange()" })
                        </div>
                    </div>
                    <div id="retailerdrop" class="vm-prepaid-user-filter__retailer" style="display:none;">
                        <div class="vm-prepaid-user-filter__item">
                            <div class="vm-pg-slab-field">
                                <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-user-tie"></i></span>
                                @Html.DropDownList("ddldealer", Model.UserId, "All Distributor", new { @class = "for-select2 form-control", @onchange = "ddlretailerid()" })
                            </div>
                        </div>
                        <div class="vm-prepaid-user-filter__item">
                            <div class="vm-pg-slab-field">
                                <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-store"></i></span>
                                @Html.DropDownList("ddlUserIdrem", Model.Retailerid, "All Retailer", new { @class = "for-select2 form-control", @onchange = "ddlUserIdChangerem()" })
                            </div>
                        </div>
                    </div>
                    <div class="vm-prepaid-user-filter__item">
                        <div class="vm-pg-slab-field">
                            <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-user"></i></span>
                            <input class="form-control" type="text" placeholder="User Name" value="@Model.Name" readonly="readonly" />
                        </div>
                    </div>
                    <div class="vm-prepaid-user-filter__item">
                        <div class="vm-pg-slab-field">
                            <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-phone-alt"></i></span>
                            <input class="form-control" type="text" placeholder="User Registered Number" value="@Model.Phone" readonly="readonly" />
                        </div>
                    </div>
                    <div class="vm-prepaid-user-filter__item">
                        <div class="vm-pg-slab-field">
                            <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-envelope"></i></span>
                            <input class="form-control" type="text" placeholder="User Registered Mail" value="@Model.Email" readonly="readonly" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="vm-pg-slab-table-scroll saas-acc-table-wrap vm-dmt2-slab-table-scroll vm-prepaid-slab-table-wrap">
        <table id="pancardManualUserSlabTable" class="table table-bordered vm-pg-slab-table vm-dmt2-slab-table third-design-table slab-table">
            <thead>
                <tr>
                    <th>User&nbsp;ID</th>
                    <th>Comm&nbsp;(%)</th>
                </tr>
            </thead>
            <tbody id="tbodyshow" class="vm-pg-slab-tbody--view">
                @if (Model.Materuser != null)
                {
                    for (int i = 0; i < Model.Materuser.Count; i++)
                    {
                        <tr>
                            <td>@Html.DisplayFor(a => a.Materuser[i].userid)</td>
                            <td>@Html.DisplayFor(a => a.Materuser[i].comm)</td>
                        </tr>
                    }
                }
                @if (Model.Dealeruser != null)
                {
                    for (int i = 0; i < Model.Dealeruser.Count; i++)
                    {
                        <tr>
                            <td>@Html.DisplayFor(a => a.Dealeruser[i].userid)</td>
                            <td>@Html.DisplayFor(a => a.Dealeruser[i].comm)</td>
                        </tr>
                    }
                }
                @if (Model.Retaileruser != null)
                {
                    for (int i = 0; i < Model.Retaileruser.Count; i++)
                    {
                        <tr>
                            <td>@Html.DisplayFor(a => a.Retaileruser[i].userid)</td>
                            <td>@Html.DisplayFor(a => a.Retaileruser[i].comm)</td>
                        </tr>
                    }
                }
                @if (Model.dlmremuser != null)
                {
                    for (int i = 0; i < Model.dlmremuser.Count; i++)
                    {
                        <tr>
                            <td>@Html.DisplayFor(a => a.dlmremuser[i].userid)</td>
                            <td>@Html.DisplayFor(a => a.dlmremuser[i].comm)</td>
                        </tr>
                    }
                }
                @if (Model.Whitelabeluser != null)
                {
                    for (int i = 0; i < Model.Whitelabeluser.Count; i++)
                    {
                        <tr>
                            <td>@Html.DisplayFor(a => a.Whitelabeluser[i].userid)</td>
                            <td>@Html.DisplayFor(a => a.Whitelabeluser[i].comm)</td>
                        </tr>
                    }
                }
            </tbody>
            <tbody id="tbodyedit" class="vm-pg-slab-tbody--hidden">
                @if (Model.Materuser != null)
                {
                    for (int i = 0; i < Model.Materuser.Count; i++)
                    {
                        <tr>
                            @Html.HiddenFor(a => a.Materuser[i].idno)
                            <td>@Html.DisplayFor(a => a.Materuser[i].userid)</td>
                            <td>
                                @Html.EditorFor(a => a.Materuser[i].comm, new { htmlAttributes = new { @style = "width:100%" } })
                                @Html.ValidationMessageFor(a => a.Materuser[i].comm)
                            </td>
                        </tr>
                    }
                }
                @if (Model.Dealeruser != null)
                {
                    for (int i = 0; i < Model.Dealeruser.Count; i++)
                    {
                        <tr>
                            @Html.HiddenFor(a => a.Dealeruser[i].idno)
                            <td>@Html.DisplayFor(a => a.Dealeruser[i].userid)</td>
                            <td>
                                @Html.EditorFor(a => a.Dealeruser[i].comm, new { htmlAttributes = new { @style = "width:100%" } })
                                @Html.ValidationMessageFor(a => a.Dealeruser[i].comm)
                            </td>
                        </tr>
                    }
                }
                @if (Model.Retaileruser != null)
                {
                    for (int i = 0; i < Model.Retaileruser.Count; i++)
                    {
                        <tr>
                            @Html.HiddenFor(a => a.Retaileruser[i].idno)
                            <td>@Html.DisplayFor(a => a.Retaileruser[i].userid)</td>
                            <td>
                                @Html.EditorFor(a => a.Retaileruser[i].comm, new { htmlAttributes = new { @style = "width:100%" } })
                                @Html.ValidationMessageFor(a => a.Retaileruser[i].comm)
                            </td>
                        </tr>
                    }
                }
                @if (Model.dlmremuser != null)
                {
                    for (int i = 0; i < Model.dlmremuser.Count; i++)
                    {
                        <tr>
                            @Html.HiddenFor(a => a.dlmremuser[i].idno)
                            <td>@Html.DisplayFor(a => a.dlmremuser[i].userid)</td>
                            <td>
                                @Html.EditorFor(a => a.dlmremuser[i].comm, new { htmlAttributes = new { @style = "width:100%" } })
                                @Html.ValidationMessageFor(a => a.dlmremuser[i].comm)
                            </td>
                        </tr>
                    }
                }
                @if (Model.Whitelabeluser != null)
                {
                    for (int i = 0; i < Model.Whitelabeluser.Count; i++)
                    {
                        <tr>
                            @Html.HiddenFor(a => a.Whitelabeluser[i].idno)
                            <td>@Html.DisplayFor(a => a.Whitelabeluser[i].userid)</td>
                            <td>
                                @Html.EditorFor(a => a.Whitelabeluser[i].comm, new { htmlAttributes = new { @style = "width:100%" } })
                                @Html.ValidationMessageFor(a => a.Whitelabeluser[i].comm)
                            </td>
                        </tr>
                    }
                }
            </tbody>
            <tbody id="tbodyeditAll" class="vm-pg-slab-tbody--hidden">
                @{
                    var ads = Session["comm"];
                    var ads1 = Convert.ToString(ads);
                }
                @if (ads1 == "dlm")
                {
                    <tr>
                        <td><p>All</p></td>
                        <td><input type="text" name="all_comm1" value="0.00" /></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td><p>All</p></td>
                        <td><input type="text" name="all_comm" value="0.00" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<script>
    function OnSuccess1(data) {
        if (typeof resetSlabViewMode === 'function') {
            resetSlabViewMode();
        } else {
            $('#btnsubmituser').hide();
            $('#btnEdit').show();
        }
        var chk = '@Model.role';
        if (chk == "Retailer") {
            showRetailerDrop();
        } else {
            showAllUsersDrop();
        }
        if (typeof initPgSlabPartialUi === 'function') {
            initPgSlabPartialUi();
        }
    }
    function onfailed(error) {
        if (typeof resetSlabViewMode === 'function') {
            resetSlabViewMode();
        } else {
            $('#btnsubmituser').hide();
            $('#btnEdit').show();
        }
        var chk = '@Model.role';
        if (chk == "Retailer") {
            showRetailerDrop();
        } else {
            showAllUsersDrop();
        }
        alert(error.responseText);
    }
</script>
