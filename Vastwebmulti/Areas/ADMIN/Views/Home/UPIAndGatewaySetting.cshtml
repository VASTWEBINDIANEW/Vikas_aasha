@model Vastwebmulti.Areas.ADMIN.Models.UPI_status_setting
@using System.Linq
@{
    ViewBag.Title = "UPIAndGatewaySetting";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var gatewayCount = Model.upiandgateway?.Count() ?? 0;
    var upiQrCount = Model.upiqr?.Count() ?? 0;
    var upiIntentCount = Model.upiintent?.Count() ?? 0;
    var upiCollectionCount = Model.upicollection?.Count() ?? 0;
    var pgApiCount = Model.gateway?.Count() ?? 0;
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-settings-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-upi-gateway-setting-modern.css?v=8" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-settings-page saas-upi-gateway-setting-page">
    <div class="container-fluid">

        <div class="saas-acc-toolbar">
            <ol class="saas-acc-breadcrumb">
                <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                
                <li>UPI &amp; Gateway Setting</li>
            </ol>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.msg))
        {
            <div class="vm-upi-set-msg" role="alert">@Model.msg</div>
        }

        <div class="saas-acc-table-card">
            <div class="saas-acc-table-card-head">
                <h3><i class="fas fa-sliders-h" aria-hidden="true"></i> UPI &amp; Payment Gateway Status</h3>
                <span class="saas-acc-row-count"><i class="fas fa-list" aria-hidden="true"></i> @gatewayCount records</span>
            </div>
            <div class="saas-acc-table-wrap table-responsive">
                <table class="table saas-acc-table table-bordered vm-upi-set-table">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th class="vm-upi-set-status-col">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.upiandgateway)
                        {
                            <tr>
                                <td data-label="Type" class="vm-upi-set-name-cell">@item.Name</td>
                                <td data-label="Status" class="vm-upi-set-status-cell">
                                    @if (item.Status == true)
                                    {
                                        <button type="button" class="vm-upi-set-toggle vm-upi-set-toggle--on" onclick="UPIGATEWAYSTS('upiandgateway','@item.Idno')" title="Click to disable" aria-pressed="true">
                                            <span class="vm-upi-set-toggle__track" aria-hidden="true"></span>
                                            <span class="vm-upi-set-toggle__label">ON</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="vm-upi-set-toggle vm-upi-set-toggle--off" onclick="UPIGATEWAYSTS('upiandgateway','@item.Idno')" title="Click to enable" aria-pressed="false">
                                            <span class="vm-upi-set-toggle__track" aria-hidden="true"></span>
                                            <span class="vm-upi-set-toggle__label">OFF</span>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="saas-acc-table-card vm-upi-set-api-section">
            <div class="saas-acc-table-card-head vm-upi-set-card-head">
                <h3><i class="fas fa-qrcode" aria-hidden="true"></i> UPI API Setting</h3>
                <div class="vm-upi-set-card-head-actions">
                    @if (ViewBag.KYCCHECK != null)
                    {
                        <div class="vm-upi-set-kyc">
                            <span>KYC Status</span>
                            @if (ViewBag.KYCCHECK.isekyc == true)
                            {
                                <button type="button" class="vm-upi-set-toggle vm-upi-set-toggle--on" onclick="KYCONOFF('KYCON')" title="Toggle KYC" aria-pressed="true">
                                    <span class="vm-upi-set-toggle__track" aria-hidden="true"></span>
                                    <span class="vm-upi-set-toggle__label">ON</span>
                                </button>
                            }
                            else
                            {
                                <button type="button" class="vm-upi-set-toggle vm-upi-set-toggle--off" onclick="KYCONOFF('KYCON')" title="Toggle KYC" aria-pressed="false">
                                    <span class="vm-upi-set-toggle__track" aria-hidden="true"></span>
                                    <span class="vm-upi-set-toggle__label">OFF</span>
                                </button>
                            }
                        </div>
                    }
                    <button type="button" class="vm-upi-set-btn" data-toggle="modal" data-target="#myModal">
                        <i class="fas fa-cog" aria-hidden="true"></i> Set UPI Charges
                    </button>
                    <button type="button" class="vm-upi-set-btn vm-upi-set-btn--primary" id="myModal123showdata" data-toggle="modal" data-target="#myModal123">
                        <i class="fas fa-exchange-alt" aria-hidden="true"></i> Set UPI Transaction
                    </button>
                </div>
            </div>

            <div class="vm-upi-set-api-grid">
                <div class="vm-upi-set-api-panel">
                    <div class="vm-upi-set-api-panel__head">UPI QR API</div>
                    <div class="vm-upi-set-api-panel__body">
                        <div class="saas-acc-table-wrap vm-upi-set-api-table-wrap">
                            <table class="table saas-acc-table vm-upi-set-table">
                                <thead>
                                    <tr>
                                        <th>API Name</th>
                                        <th class="vm-upi-set-status-col">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.upiqr)
                                    {
                                        <tr>
                                            <td data-label="API Name" class="vm-upi-set-name-cell">@item.Name</td>
                                            <td data-label="Status" class="vm-upi-set-status-cell">
                                                @if (item.Sts == true)
                                                {
                                                    <button type="button" class="vm-upi-set-toggle vm-upi-set-toggle--on" onclick="UPIGATEWAYSTS('upiqr','@item.Idno')" title="Click to disable" aria-pressed="true">
                                                        <span class="vm-upi-set-toggle__track" aria-hidden="true"></span>
                                                        <span class="vm-upi-set-toggle__label">ON</span>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="vm-upi-set-toggle vm-upi-set-toggle--off" onclick="UPIGATEWAYSTS('upiqr','@item.Idno')" title="Click to enable" aria-pressed="false">
                                                        <span class="vm-upi-set-toggle__track" aria-hidden="true"></span>
                                                        <span class="vm-upi-set-toggle__label">OFF</span>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="vm-upi-set-api-panel">
                    <div class="vm-upi-set-api-panel__head">UPI Intent API</div>
                    <div class="vm-upi-set-api-panel__body">
                        <div class="saas-acc-table-wrap vm-upi-set-api-table-wrap">
                            <table class="table saas-acc-table vm-upi-set-table">
                                <thead>
                                    <tr>
                                        <th>API Name</th>
                                        <th class="vm-upi-set-status-col">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.upiintent)
                                    {
                                        <tr>
                                            <td data-label="API Name" class="vm-upi-set-name-cell">@item.Name</td>
                                            <td data-label="Status" class="vm-upi-set-status-cell">
                                                @if (item.Sts == true)
                                                {
                                                    <button type="button" class="vm-upi-set-toggle vm-upi-set-toggle--on" onclick="UPIGATEWAYSTS('upiintent','@item.Idno')" title="Click to disable" aria-pressed="true">
                                                        <span class="vm-upi-set-toggle__track" aria-hidden="true"></span>
                                                        <span class="vm-upi-set-toggle__label">ON</span>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="vm-upi-set-toggle vm-upi-set-toggle--off" onclick="UPIGATEWAYSTS('upiintent','@item.Idno')" title="Click to enable" aria-pressed="false">
                                                        <span class="vm-upi-set-toggle__track" aria-hidden="true"></span>
                                                        <span class="vm-upi-set-toggle__label">OFF</span>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="vm-upi-set-api-panel">
                    <div class="vm-upi-set-api-panel__head">UPI Collection API</div>
                    <div class="vm-upi-set-api-panel__body">
                        <div class="saas-acc-table-wrap vm-upi-set-api-table-wrap">
                            <table class="table saas-acc-table vm-upi-set-table">
                                <thead>
                                    <tr>
                                        <th>API Name</th>
                                        <th class="vm-upi-set-status-col">Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.upicollection)
                                    {
                                        <tr>
                                            <td data-label="API Name" class="vm-upi-set-name-cell">@item.Name</td>
                                            <td data-label="Status" class="vm-upi-set-status-cell">
                                                @if (item.sts == true)
                                                {
                                                    <button type="button" class="vm-upi-set-toggle vm-upi-set-toggle--on" onclick="UPIGATEWAYSTS('upicollection','@item.Idno')" title="Click to disable" aria-pressed="true">
                                                        <span class="vm-upi-set-toggle__track" aria-hidden="true"></span>
                                                        <span class="vm-upi-set-toggle__label">ON</span>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="vm-upi-set-toggle vm-upi-set-toggle--off" onclick="UPIGATEWAYSTS('upicollection','@item.Idno')" title="Click to enable" aria-pressed="false">
                                                        <span class="vm-upi-set-toggle__track" aria-hidden="true"></span>
                                                        <span class="vm-upi-set-toggle__label">OFF</span>
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="saas-acc-table-card">
            <div class="saas-acc-table-card-head vm-upi-set-card-head">
                <h3><i class="fas fa-credit-card" aria-hidden="true"></i> Payment Gateway API Setting</h3>
                <div class="vm-upi-set-card-head-actions">
                    @if (ViewBag.KYCGATEWAY != null)
                    {
                        <div class="vm-upi-set-kyc">
                            <span>KYC Status</span>
                            @if (ViewBag.KYCGATEWAY.isekyc == true)
                            {
                                <button type="button" class="vm-upi-set-toggle vm-upi-set-toggle--on" onclick="KYCONOFFGATEWAY('KYCON')" title="Toggle gateway KYC" aria-pressed="true">
                                    <span class="vm-upi-set-toggle__track" aria-hidden="true"></span>
                                    <span class="vm-upi-set-toggle__label">ON</span>
                                </button>
                            }
                            else
                            {
                                <button type="button" class="vm-upi-set-toggle vm-upi-set-toggle--off" onclick="KYCONOFFGATEWAY('KYCON')" title="Toggle gateway KYC" aria-pressed="false">
                                    <span class="vm-upi-set-toggle__track" aria-hidden="true"></span>
                                    <span class="vm-upi-set-toggle__label">OFF</span>
                                </button>
                            }
                        </div>
                    }
                    <a href="@Url.Action("PaymentGatewaySlab", "Home")" target="_blank" class="vm-upi-set-btn vm-upi-set-btn--primary">
                        <i class="fas fa-cog" aria-hidden="true"></i> PG Charges Setting
                    </a>
                </div>
            </div>
            <div class="saas-acc-table-wrap table-responsive">
                <table class="table saas-acc-table table-bordered vm-upi-set-table">
                    <thead>
                        <tr>
                            <th>API Name</th>
                            <th class="vm-upi-set-status-col">Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.gateway)
                        {
                            <tr>
                                <td data-label="API Name" class="vm-upi-set-name-cell">@item.Name</td>
                                <td data-label="Status" class="vm-upi-set-status-cell">
                                    @if (item.Sts == true)
                                    {
                                        <button type="button" class="vm-upi-set-toggle vm-upi-set-toggle--on" onclick="UPIGATEWAYSTS('gateway','@item.idno')" title="Click to disable" aria-pressed="true">
                                            <span class="vm-upi-set-toggle__track" aria-hidden="true"></span>
                                            <span class="vm-upi-set-toggle__label">ON</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="vm-upi-set-toggle vm-upi-set-toggle--off" onclick="UPIGATEWAYSTS('gateway','@item.idno')" title="Click to enable" aria-pressed="false">
                                            <span class="vm-upi-set-toggle__track" aria-hidden="true"></span>
                                            <span class="vm-upi-set-toggle__label">OFF</span>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</section>

<div id="loadermoney" class="loadermoney" style="display:none;"></div>

<div id="myModal" class="modal fade Wallet-To-Bank-Charge-modal vm-upi-set-modal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="defaultModalLabel">Add UPI Charge</h4>
                <button type="button" class="vm-upi-set-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
            </div>
            <div class="modal-body upi-charge-modal">
                <form id="form_validation" method="POST">
                    <div class="vm-upi-set-form-row">
                        <label for="RemMinAmt">Minimum Charge (Rs)</label>
                        <select class="form-control" id="RemMinAmt" name="RemMinAmt">
                            <option value="">Select one</option>
                            <option value="0.00">0.00</option>
                            <option value="0.05">0.05</option>
                            <option value="0.15">0.15</option>
                            <option value="0.25">0.25</option>
                            <option value="0.50">0.50</option>
                            <option value="0.75">0.75</option>
                            <option value="1.00 ">1.00 </option>
                            <option value="1.25">1.25</option>
                            <option value="1.50">1.50</option>
                            <option value="1.75">1.75</option>
                            <option value="2.00">2.00</option>
                        </select>
                    </div>
                    <div class="vm-upi-set-form-row">
                        <label for="RemMaxAmt">Charge (%)</label>
                        <select class="form-control" id="RemMaxAmt" name="RemMaxAmt">
                            <option value="">Select one</option>
                            <option value="0.00">0.00</option>
                            <option value="0.01">0.01</option>
                            <option value="0.02">0.02</option>
                            <option value="0.03">0.03</option>
                            <option value="0.04">0.04</option>
                            <option value="0.05">0.05</option>
                            <option value="0.75">0.75</option>
                            <option value="1.00 ">1.00 </option>
                            <option value="1.25">1.25</option>
                            <option value="1.50">1.50</option>
                            <option value="1.75">1.75</option>
                            <option value="2.00">2.00</option>
                        </select>
                    </div>
                    <div class="modal-footer">
                        <button id="SaveChargeREM" type="button" class="btn waves-effect enableOnInput">Save Change</button>
                        <button type="button" class="vm-upi-set-btn" data-dismiss="modal">Close</button>
                    </div>
                </form>
                <div class="vm-upi-set-section-divider"></div>
                <h2>Current Active UPI Charge Detail</h2>
                <div class="table-responsive" id="RemTbl">
                    @Html.Partial("_Upi_slabList")
                </div>
            </div>
        </div>
    </div>
</div>

<div id="myModal123" class="modal fade Wallet-To-Bank-Charge-modal vm-upi-set-modal vm-upi-set-modal--wide" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Set UPI Transaction</h4>
                <button type="button" class="vm-upi-set-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
            </div>
            <div class="modal-body upi-charge-modal">
                <h2>Set Variable QR / UPI Request Transaction Limit</h2>
                <div class="table-responsive" id="RemTblQRCODE">
                    @Html.Partial("_Upi_VARIBALE_QR")
                </div>
                <div class="vm-upi-set-section-divider"></div>
                <h2>
                    Self UPI Transaction Limit
                    <span style="color:#dc2626;font-size:0.82rem;font-weight:600;">&nbsp;(*Self UPI Range Between 10 To 3000)</span>
                </h2>
                <label id="lblmsg"></label>
                <input type="hidden" id="hideupiid" />
                <input type="hidden" id="hidemin" />
                <input type="hidden" id="hidemax" />
                <input type="hidden" id="hidddlpaymenttype" />
                <div id="RemTbl111">
                    @Html.Partial("_upi_SelfList")
                </div>
                <h2>VPA Details</h2>
                <div id="RemTbl222">
                    @Html.Partial("_VPAset_SelfList")
                </div>
                <h2>Selected UPI Mode Are Blocked</h2>
                <div id="RemTbl333">
                    <div class="vm-upi-set-block-actions">
                        <button type="button" class="vm-upi-set-btn" onclick="eselectAll()">
                            <i class="far fa-check-square" aria-hidden="true"></i> Block All
                        </button>
                        <button type="button" class="vm-upi-set-btn" onclick="eUnSelectAll()">
                            <i class="far fa-square" aria-hidden="true"></i> Unblock All
                        </button>
                        <button type="button" id="SaveAll" class="vm-upi-set-btn vm-upi-set-btn--primary">
                            <i class="fas fa-save" aria-hidden="true"></i> Save Details
                        </button>
                    </div>
                    <div class="vm-upi-set-check-grid" id="SelfUpiCheckUncheck">
                        <div class="vm-upi-set-check-item">
                            <input type="checkbox" id="Paytm" value="Paytm" class="filled-in chk-col-red" name="acs1">
                            <label for="Paytm">Paytm</label>
                        </div>
                        <div class="vm-upi-set-check-item">
                            <input type="checkbox" id="PhonePe" value="PhonePe" class="filled-in chk-col-red" name="acs1">
                            <label for="PhonePe">PhonePe</label>
                        </div>
                        <div class="vm-upi-set-check-item">
                            <input type="checkbox" id="GooglePay" value="Google Pay" class="filled-in chk-col-red" name="acs1">
                            <label for="GooglePay">Google Pay</label>
                        </div>
                        <div class="vm-upi-set-check-item">
                            <input type="checkbox" id="AmazonPay" value="Amazon Pay" class="filled-in chk-col-red" name="acs1">
                            <label for="AmazonPay">Amazon Pay</label>
                        </div>
                        <div class="vm-upi-set-check-item">
                            <input type="checkbox" id="WhatsApp" value="WhatsApp" class="filled-in chk-col-red" name="acs1">
                            <label for="WhatsApp">WhatsApp</label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<!--=======    Scripts   ========-->
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    function ddlnamechange() {
        var selectname = $('#ddlname').val();
        if (selectname == "Retailer") {
            $('#drpretailer').show()
            $('#drpdealer').hide();
            $('#drpmaster').hide();
            $('#drpwhite').hide();
        }
        else if (selectname == "Distributor") {
            $('#drpretailer').hide()
            $('#drpdealer').show();
            $('#drpmaster').hide();
            $('#drpwhite').hide();
        }
        else if (selectname == "Master") {
            $('#drpretailer').hide()
            $('#drpdealer').hide();
            $('#drpmaster').show();
            $('#drpwhite').hide();
        }
        else if (selectname == "Whitelabel") {
            $('#drpretailer').hide()
            $('#drpdealer').hide();
            $('#drpmaster').hide();
            $('#drpwhite').show();
        }
        else {
            $('#drpretailer').hide()
            $('#drpdealer').hide();
            $('#drpmaster').hide();
            $('#drpwhite').hide();
        }
    }
</script>
