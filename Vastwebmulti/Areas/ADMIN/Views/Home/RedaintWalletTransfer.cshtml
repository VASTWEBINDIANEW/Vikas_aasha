@model IEnumerable<Vastwebmulti.Models.RadiantTransfer_Report>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Redaint Wallet Transfer";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    string role = Session["role"]?.ToString();

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Now.AddDays(-30).ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
    var reports = Model ?? Enumerable.Empty<Vastwebmulti.Models.RadiantTransfer_Report>();
    var rowCount = reports.Count();

    decimal totalAmount = reports.Sum(i => i.amount);
    decimal totalApproved = reports.Where(i => string.Equals(i.Sts, "Approved", StringComparison.OrdinalIgnoreCase)).Sum(i => i.amount);
    decimal totalReject = reports.Where(i => string.Equals(i.Sts, "Reject", StringComparison.OrdinalIgnoreCase)).Sum(i => i.amount);
    decimal totalPending = reports.Where(i => string.Equals(i.Sts, "pending", StringComparison.OrdinalIgnoreCase) || string.Equals(i.Sts, "PENDING", StringComparison.OrdinalIgnoreCase)).Sum(i => i.amount);
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=45" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=30" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-security-report-page saas-giftcard-report-page saas-prepaid-card-report-page saas-radiant-wallet-report-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var walletFormAttrs = new Dictionary<string, object>
            {
                { "id", "radiantWalletReportForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("RedaintWalletTransfer", "Home", FormMethod.Post, walletFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line vm-gift-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Report's</li>
                        <li>Radiant Wallet Transfer</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters vm-ecomm-filter-row--one-line vm-gift-filter-row--one-line">

                        <div class="vm-opr-field vm-dmt-field vm-radiant-wallet-field--retailer">
                            @Html.DropDownList("allretailer", ViewBag.allretailer as SelectList, "All Retailer", new { id = "allretailer", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-radiant-wallet-field--status">
                            @Html.DropDownList("ddl_status", ViewBag.StatusList as SelectList, "Status", new { @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar" aria-hidden="true"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar" aria-hidden="true"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" name="btntype" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="radiantWalletTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Radiant wallet transfer totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideRadiantWalletTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Approved</span>
                            <strong class="vm-opr-total-card__value" id="radiantWalletTotalApproved">@totalApproved.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Reject</span>
                            <strong class="vm-opr-total-card__value" id="radiantWalletTotalReject">@totalReject.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Pending</span>
                            <strong class="vm-opr-total-card__value" id="radiantWalletTotalPending">@totalPending.ToString("N2")</strong>
                        </div>
                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card vm-security-report-main-card vm-gift-report-main-card vm-radiant-wallet-report-main-card">
            <div class="vm-opr-table-panel vm-security-report-table-panel vm-gift-report-table-panel vm-radiant-wallet-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head vm-security-report-table-head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-wallet" aria-hidden="true"></i>
                        <span>Radiant wallet transfer report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong id="radiantWalletRecordCount">@rowCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total" title="Total amount for current filter">
                            Total: <strong id="radiantWalletInlineTotal">? @totalAmount.ToString("N2")</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-gift-totals-btn vm-radiant-wallet-totals-btn" onclick="findRadiantWalletTotals()" title="Show totals" aria-expanded="false" aria-controls="radiantWalletTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap vm-radiant-wallet-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="radiantWalletReportTable" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Retailer&nbsp;Name</th>
                                    <th>Firm&nbsp;Name</th>
                                    <th>Status</th>
                                    <th>CEID</th>
                                    <th>Request&nbsp;Date</th>
                                    <th>Amount</th>
                                    <th>Remain&nbsp;Pre</th>
                                    <th>Remain&nbsp;Post</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (rowCount == 0)
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="8">No records found for the selected filters.</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var item in reports)
                                    {
                                        var statusKey = (item.Sts ?? "").Trim();
                                        var rowClass = "vm-radiant-wallet-row";
                                        if (string.Equals(statusKey, "Approved", StringComparison.OrdinalIgnoreCase))
                                        {
                                            rowClass += " vm-radiant-wallet-row--approved";
                                        }
                                        else if (string.Equals(statusKey, "Reject", StringComparison.OrdinalIgnoreCase))
                                        {
                                            rowClass += " vm-radiant-wallet-row--reject";
                                        }
                                        else if (string.Equals(statusKey, "pending", StringComparison.OrdinalIgnoreCase))
                                        {
                                            rowClass += " vm-radiant-wallet-row--pending";
                                        }

                                        <tr class="@rowClass" data-status="@statusKey" data-amount="@item.amount">
                                            <td>@item.RetailerName</td>
                                            <td>@item.Frm_Name</td>
                                            <td><span class="vm-radiant-wallet-status">@item.Sts</span></td>
                                            <td>@item.CEID</td>
                                            <td>@item.Insertdate</td>
                                            <td>@item.amount</td>
                                            <td>@item.Remainpre</td>
                                            <td>@item.Remainpost</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<script src="~/MainFrontDesign/select2/dist/js/select2.full.min.js"></script>

<script>
    function hideRadiantWalletTotals() {
        var $panel = $('#radiantWalletTotalsPanel');
        var $btn = $('.vm-radiant-wallet-totals-btn');
        $panel.hide().attr('aria-hidden', 'true');
        $btn.attr('aria-expanded', 'false');
    }

    function findRadiantWalletTotals() {
        var $panel = $('#radiantWalletTotalsPanel');
        var $btn = $('.vm-radiant-wallet-totals-btn');
        if ($panel.is(':visible')) {
            hideRadiantWalletTotals();
            return;
        }
        $panel.show().attr('aria-hidden', 'false');
        $btn.attr('aria-expanded', 'true');
    }

    function formatRadiantWalletAmount(value) {
        var num = parseFloat(value);
        if (isNaN(num)) {
            return '0.00';
        }
        return num.toFixed(2);
    }

    function refreshRadiantWalletSummary() {
        var rows = document.querySelectorAll('#radiantWalletReportTable tbody tr:not(.vm-opr-table-empty-row)');
        var count = rows.length;
        var total = 0;
        var approved = 0;
        var reject = 0;
        var pending = 0;

        for (var i = 0; i < rows.length; i++) {
            var row = rows[i];
            var amount = parseFloat(row.getAttribute('data-amount') || '0');
            var status = (row.getAttribute('data-status') || '').toLowerCase();
            if (isNaN(amount)) {
                amount = 0;
            }
            total += amount;
            if (status === 'approved') {
                approved += amount;
            } else if (status === 'reject') {
                reject += amount;
            } else if (status === 'pending') {
                pending += amount;
            }
        }

        $('#radiantWalletRecordCount').text(count);
        $('#radiantWalletInlineTotal').text('? ' + formatRadiantWalletAmount(total));
        $('#radiantWalletTotalApproved').text(formatRadiantWalletAmount(approved));
        $('#radiantWalletTotalReject').text(formatRadiantWalletAmount(reject));
        $('#radiantWalletTotalPending').text(formatRadiantWalletAmount(pending));
    }

    function destroyRadiantWalletSelect2($el) {
        if ($el && $el.length && $el.data('select2')) {
            $el.select2('destroy');
        }
    }

    function applyRadiantWalletSelect2($el) {
        if (!$el || !$el.length || !$.fn.select2) {
            return;
        }
        destroyRadiantWalletSelect2($el);
        $el.select2({
            width: '100%',
            minimumResultsForSearch: 6
        });
    }

    function initRadiantWalletSelect2() {
        applyRadiantWalletSelect2($('#allretailer'));
        applyRadiantWalletSelect2($('#ddl_status'));
    }

    function initRadiantWalletDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initRadiantWalletDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm('#radiantWalletReportForm');
        }
    }

    $(document).ready(function () {
        initRadiantWalletSelect2();
        initRadiantWalletDatepickers();
        refreshRadiantWalletSummary();
        $('#radiantWalletReportForm .select2-container').css('width', '100%');
    });

    $("#btnExport").click(function () {
        var txt_frm_date = $('#txt_frm_date').val();
        var txt_to_date = $('#txt_to_date').val();
        var allretailer = $('#allretailer').val();
        var ddl_status = $('#ddl_status').val();
        var url = '@Url.Action("ExcelWalletUnloadReport", "Home")?txt_frm_date=' + txt_frm_date + '&txt_to_date=' + txt_to_date + '&allretailer=' + allretailer + '&ddl_status=' + ddl_status;
        location.href = url;
    });

    $("#btnPDF").click(function () {
        var txt_frm_date = $('#txt_frm_date').val();
        var txt_to_date = $('#txt_to_date').val();
        var allretailer = $('#allretailer').val();
        var ddl_status = $('#ddl_status').val();
        var url = '@Url.Action("pdfWalletUnloadReport", "Home")?txt_frm_date=' + txt_frm_date + '&txt_to_date=' + txt_to_date + '&allretailer=' + allretailer + '&ddl_status=' + ddl_status;
        window.open(url, '_blank');
    });
</script>
