@model IEnumerable<Vastwebmulti.Models.select_api_info_Test_Result>
@using System.Linq
@{
    ViewBag.Title = "Api_Operator";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var apiRows = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.select_api_info_Test_Result>();
    var selectedApinm = (Request["apinm"] ?? "").Trim();
    var selectedCategories = Request.Form.GetValues("myCategories") ?? new string[0];
    var selectedCategorySet = new HashSet<string>(selectedCategories, StringComparer.OrdinalIgnoreCase);
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=28" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-api-operator-modern.css?v=24" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-api-operator-page">
    <div class="container-fluid vm-opr-page-shell">

        @using (Html.BeginForm("Api_Operator", "Home", FormMethod.Post, new { id = "apiOperatorFilterForm", @class = "vm-rpt-filters-panel__form" }))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
                <div class="saas-acc-toolbar-top vm-api-operator-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-api-operator-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li><a href="@Url.Action("Dashboard", "Home")#setting">Basic Setting</a></li>
                        <li>OPT Switching</li>
                    </ol>
                    <div class="vm-dmt-fin-nav-row vm-api-operator-nav-wrap">
                        @Html.Partial("_menuapinm")
                    </div>
                </div>

                <div class="vm-rpt-filters-panel vm-api-operator-filter-panel">
                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-api-operator-filter-row vm-rpt-filters-panel__bar">
                        <div class="vm-api-operator-filter-group">
                            <div class="vm-opr-field vm-api-operator-field vm-api-operator-field--api">
                                @{
                                    var apinmList = ViewBag.apinm as SelectList;
                                    if (apinmList != null && !string.IsNullOrEmpty(selectedApinm))
                                    {
                                        apinmList = new SelectList(apinmList.Items, apinmList.DataValueField, apinmList.DataTextField, selectedApinm);
                                    }
                                }
                                @Html.DropDownList("apinm", apinmList, "Select Api Name", new { id = "filterApinm", @class = "form-control for-select2 vm-opr-select vm-dmt-select vm-api-operator-select vm-admin-select-search", data_live_search = "true", @required = "required", @title = "Select Api Name" })
                            </div>
                            <div class="vm-opr-field vm-api-operator-field vm-api-operator-field--operators">
                                <select id="myCategories" name="myCategories" title="Select Operator Category" class="form-control for-select2 vm-opr-select vm-dmt-select vm-api-operator-select vm-admin-select-search" data-live-search="true">
                                    <option value="">All Categories</option>
                                    @if (ViewBag.OptCategories != null)
                                    {
                                        foreach (var item in ViewBag.OptCategories)
                                        {
                                            if (item.Text != null)
                                            {
                                                if (selectedCategorySet.Contains(item.Value ?? ""))
                                                {
                                                    <option value="@item.Value" selected="selected">@item.Text</option>
                                                }
                                                else
                                                {
                                                    <option value="@item.Value">@item.Text</option>
                                                }
                                            }
                                        }
                                    }
                                </select>
                            </div>
                            <button type="submit" id="btnGetSkills" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-api-operator-search-btn vm-api-operator-search-btn--modern btnssl222" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-cog" aria-hidden="true"></i>
                        <span>API operator mapping</span>
                    </div>
                    <label class="vm-api-operator-table-search" for="apiOperatorSearch">
                        <i class="fas fa-search" aria-hidden="true"></i>
                        <input type="text" id="apiOperatorSearch" placeholder="Search operators..." autocomplete="off" />
                    </label>
                </div>
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="apiOperatorTable" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>API Name</th>
                                    <th>Operator</th>
                                    <th>My Code</th>
                                    <th>Api Code</th>
                                    <th>Purchase <span class="vm-api-th-unit">(&#8377; / %)</span></th>
                                    <th>Status</th>
                                    <th>Edit</th>
                                </tr>
                            </thead>
                            <tbody id="apiOperatorTableBody">
                                @foreach (var item in apiRows)
                                {
                                    <tr>
                                        <td data-label="API Name">@item.apiname</td>
                                        <td data-label="Operator">@item.optnm</td>
                                        <td data-label="My Code">@item.opt_code</td>
                                        <td data-label="Api Code">@item.apioptcode</td>
                                        <td class="vm-api-purchase-cell" data-label="Purchase">
                                            @if (item.purchasetype == "Rupees")
                                            {
                                                <span class="vm-api-purchase-val">@item.Purchase</span>
                                                <span class="vm-api-purchase-unit vm-api-purchase-unit--rupee" aria-label="Rupees">&#8377;</span>
                                            }
                                            else if (item.purchasetype == "Percentage")
                                            {
                                                <span class="vm-api-purchase-val">@item.Purchase</span>
                                                <span class="vm-api-purchase-unit vm-api-purchase-unit--pct" aria-label="Percentage">%</span>
                                            }
                                            else
                                            {
                                                @item.Purchase
                                            }
                                        </td>
                                        <td data-label="Status">
                                            @using (Html.BeginForm("Api_Status", "Home", FormMethod.Get, new { @class = "vm-api-status-form" }))
                                            {
                                                @Html.Hidden("id", item.id)
                                                @Html.Hidden("apinm", item.api_nm)
                                                <button type="submit" class="vm-api-status-toggle @(item.status == "Y" ? "is-on" : "is-off")" title="@(item.status == "Y" ? "Turn off" : "Turn on")" aria-pressed="@(item.status == "Y" ? "true" : "false")">
                                                    <span class="vm-api-status-toggle__track">
                                                        <span class="vm-api-status-toggle__thumb" aria-hidden="true"></span>
                                                        <span class="vm-api-status-toggle__label">@(item.status == "Y" ? "ON" : "OFF")</span>
                                                    </span>
                                                </button>
                                            }
                                        </td>
                                        <td data-label="Edit">
                                            <button type="button"
                                                    class="vm-api-operator-edit-btn vm-api-operator-edit-btn--modern"
                                                    data-api-nm="@item.api_nm"
                                                    data-id="@item.id"
                                                    data-apinm="@item.apiname"
                                                    data-optnm="@item.optnm"
                                                    data-apiopt="@item.apioptcode"
                                                    data-purchase="@item.Purchase"
                                                    data-purchasetype="@item.purchasetype"
                                                    data-toggle="modal"
                                                    data-target="#apiOperatorEditModal">
                                                <i class="fas fa-edit" aria-hidden="true"></i> Edit
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Edit Modal -->
<div class="modal fade saas-admin-modal vm-sm-modal vm-api-operator-modal" id="apiOperatorEditModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered saas-admin-modal-dialog vm-sm-modal-dialog" role="document">
        <div class="modal-content">
            @using (Html.BeginForm("Api_Operator", "Home", FormMethod.Post, new { id = "apiOperatorEditForm" }))
            {
                <div class="modal-header saas-admin-modal-header accent-emerald">
                    <div class="saas-admin-modal-head-main">
                        <div class="saas-admin-modal-icon"><i class="fas fa-edit" aria-hidden="true"></i></div>
                        <div class="saas-admin-modal-title-wrap">
                            <h4 class="modal-title saas-admin-modal-title">Edit API Operator</h4>
                            <p class="saas-admin-modal-subtitle">Update API code and purchase settings</p>
                        </div>
                    </div>
                    <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
                </div>

                <div class="modal-body saas-admin-modal-body saas-admin-modal-scroll vm-sm-modal-body">
                    @Html.TextBox("apinm", "", new { id = "editApinm", style = "display:none" })
                    @Html.TextBox("txtidno", "", new { id = "editTxtidno", style = "display:none" })
                    <div class="vm-sm-modal-panel vm-api-operator-form-grid">
                        <div class="vm-sm-modal-field vm-sm-modal-field--full">
                            <label for="txtapinm">API Name</label>
                            @Html.TextBox("txtapinm", "", new { id = "txtapinm", @class = "form-control", placeholder = "API Name", @required = "required", @readonly = "readonly" })
                        </div>
                        <div class="vm-sm-modal-field vm-sm-modal-field--full">
                            <label for="txtoptnm">Operator Name</label>
                            @Html.TextBox("txtoptnm", "", new { id = "txtoptnm", @class = "form-control", placeholder = "Operator Name", @readonly = "readonly" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="txtapiopt">API Code</label>
                            @Html.TextBox("txtapiopt", "", new { id = "txtapiopt", @class = "form-control", placeholder = "Enter Api Opt Code", @required = "required" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="purchasetype">Purchase Type</label>
                            <select id="purchasetype" name="purchasetype" class="form-control" required="">
                                <option value="">Select Type</option>
                                <option value="Rupees">Flat Rupees (&#8377;)</option>
                                <option value="Percentage">Percentage (%)</option>
                            </select>
                        </div>
                        <div class="vm-sm-modal-field vm-sm-modal-field--full">
                            <label for="txtpurcharge">Purchase Value</label>
                            @Html.TextBox("txtpurcharge", "", new { id = "txtpurcharge", @class = "form-control", placeholder = "Enter purchase value", @required = "required" })
                        </div>
                    </div>
                </div>

                <div class="modal-footer saas-admin-modal-footer vm-sm-modal-footer">
                    <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal">
                        <i class="fas fa-times" aria-hidden="true"></i> Cancel
                    </button>
                    <button type="submit" class="saas-admin-modal-btn saas-admin-modal-btn--success" id="apiOperatorSaveBtn">
                        <i class="fas fa-save" aria-hidden="true"></i> Save Changes
                    </button>
                </div>
            }
        </div>
    </div>
</div>

@section PostSelect2Scripts {
    <script src="~/Swalalert/sweetalert-dev.js"></script>
    <script src="~/select2/dist/js/select2.js"></script>
    <script>
        (function () {
            'use strict';

            function getPageJq() {
                if (window.jQuery && window.jQuery.fn && window.jQuery.fn.select2) {
                    return window.jQuery;
                }
                if (window.ravi && window.ravi.fn && window.ravi.fn.select2) {
                    return window.ravi;
                }
                return window.jQuery || window.ravi;
            }

            var apiOperatorSearchUrl = '@Url.Action("Api_Operator", "Home", new { area = "ADMIN" })';

            function hasApiSelected($) {
                var val = ($('#filterApinm').val() || '').trim();
                return val.length > 0 && val !== 'Select Api Name';
            }

            function destroySelect2($el) {
                if ($el.hasClass('select2-hidden-accessible')) {
                    try {
                        $el.select2('destroy');
                    } catch (e) { /* ignore */ }
                }
                $el.next('.select2-container').remove();
            }

            function initApiOperatorSelect2() {
                var $ = getPageJq();
                if (!$ || !$.fn || !$.fn.select2) {
                    return false;
                }

                var $api = $('#filterApinm');
                var $cats = $('#myCategories');
                if (!$api.length || !$cats.length) {
                    return false;
                }

                $api.add($cats).prop('disabled', false);

                destroySelect2($api);
                destroySelect2($cats);

                var commonOpts = {
                    width: '100%',
                    dropdownParent: $(document.body),
                    minimumResultsForSearch: 0,
                    language: {
                        noResults: function () { return 'No match found'; },
                        searching: function () { return 'Searching...'; }
                    }
                };

                $api.select2($.extend({}, commonOpts, {
                    placeholder: 'Select Api Name',
                    allowClear: false
                }));

                $cats.select2($.extend({}, commonOpts, {
                    placeholder: 'All Categories',
                    allowClear: true
                }));

                return true;
            }

            function bootApiOperatorSelect2() {
                var ok = initApiOperatorSelect2();
                if (!ok && typeof window.bootAdminSelect2 === 'function') {
                    window.bootAdminSelect2();
                    initApiOperatorSelect2();
                }
            }

            function prepareApiOperatorFilterSubmit($) {
                var $cats = $('#myCategories');
                var category = ($cats.val() || '').trim();

                $cats.prop('disabled', false);

                if (!category) {
                    $cats.prop('disabled', true);
                }
            }

            function bindApiOperatorSelect2SearchFocus($) {
                $(document).off('select2:open.vmApiOperator').on('select2:open.vmApiOperator', '#filterApinm, #myCategories', function () {
                    window.setTimeout(function () {
                        var $field = $('.select2-container--open .select2-search__field');
                        if (!$field.length) {
                            return;
                        }
                        $field.attr('placeholder', 'Type to search...').trigger('focus');
                    }, 0);
                });
            }

            function readyApiOperatorPage() {
                var $ = getPageJq();
                if (!$) {
                    return;
                }

                bootApiOperatorSelect2();
                bindApiOperatorSelect2SearchFocus($);

                window.setTimeout(bootApiOperatorSelect2, 150);
                window.setTimeout(bootApiOperatorSelect2, 600);
                window.setTimeout(bootApiOperatorSelect2, 1400);

                $('#apiOperatorFilterForm').on('submit', function (e) {
                    if (!hasApiSelected($)) {
                        e.preventDefault();
                        if (window.swal) {
                            swal('Required', 'Please select API name first.', 'warning');
                        }
                        return false;
                    }

                    prepareApiOperatorFilterSubmit($);
                    return true;
                });

                var resizeTimer;
                $(window).on('resize orientationchange', function () {
                    clearTimeout(resizeTimer);
                    resizeTimer = setTimeout(function () {
                        var apiVal = $('#filterApinm').val();
                        var catVal = $('#myCategories').val();
                        bootApiOperatorSelect2();
                        if (apiVal) {
                            $('#filterApinm').val(apiVal).trigger('change.select2');
                        }
                        if (catVal) {
                            $('#myCategories').val(catVal).trigger('change.select2');
                        }
                    }, 250);
                });

                var editdata = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Convert.ToString(ViewData["edit"])))';
                if (editdata && window.swal) {
                    swal('Good job!', editdata, 'success');
                }

                $('#apiOperatorSearch').on('keyup', function () {
                    var q = $(this).val().toLowerCase();
                    $('#apiOperatorTableBody tr').each(function () {
                        var text = $(this).text().toLowerCase();
                        $(this).toggle(text.indexOf(q) > -1);
                    });
                });
            }

            if (getPageJq()) {
                getPageJq()(document).ready(readyApiOperatorPage);
            } else {
                document.addEventListener('DOMContentLoaded', readyApiOperatorPage);
            }

            function openApiOperatorEdit($btn) {
                var $ = getPageJq();
                $('#editApinm').val($btn.data('api-nm') || '');
                $('#editTxtidno').val($btn.data('id') || '');
                $('#txtapinm').val($btn.data('apinm') || '');
                $('#txtoptnm').val($btn.data('optnm') || '');
                $('#txtapiopt').val($btn.data('apiopt') || '');
                $('#txtpurcharge').val($btn.data('purchase') || '');
                $('#purchasetype').val($btn.data('purchasetype') || '');
            }

            getPageJq()(document).on('click', '.vm-api-operator-edit-btn', function () {
                openApiOperatorEdit(getPageJq()(this));
            });

            getPageJq()(document).on('submit', '#apiOperatorEditForm', function (e) {
                e.preventDefault();
                var $ = getPageJq();
                var $form = $(this);
                $.ajax({
                    type: 'POST',
                    url: apiOperatorSearchUrl,
                    data: $form.serialize(),
                    success: function () {
                        $('#apiOperatorEditModal').modal('hide');
                        window.setTimeout(function () { window.location.reload(); }, 500);
                    },
                    error: function () {
                        if (window.swal) {
                            swal('Error', 'Unable to save changes. Please try again.', 'error');
                        }
                    }
                });
            });

            getPageJq()(document).on('submit', '.vm-api-status-form', function (e) {
                e.preventDefault();
                var $ = getPageJq();
                var $form = $(this);
                var $btn = $form.find('button[type="submit"]');
                $btn.prop('disabled', true);
                $.ajax({
                    type: 'GET',
                    url: '@Url.Action("Api_Status", "Home", new { area = "ADMIN" })',
                    data: $form.serialize(),
                    success: function () {
                        window.setTimeout(function () { window.location.reload(); }, 500);
                    },
                    error: function () {
                        $btn.prop('disabled', false);
                        if (window.swal) {
                            swal('Error', 'Unable to update status. Please try again.', 'error');
                        }
                    }
                });
            });
        })();
    </script>
}
