@model Vastwebmulti.Areas.ADMIN.ViewModel.GetAllDeviceinfo


<table class="table table-bordered vm-ecom-table" id="mdList">
    <thead>
        <tr>
            <th>Device&nbsp;ID</th>
            <th>Plan&nbsp;Name</th>
            <th>Firm&nbsp;Name</th>
            <th>Mobile</th>
            <th>Inserted&nbsp;Date</th>
            <th>Start&nbsp;Date</th>
            <th>Expire&nbsp;Date</th>
            <th>Remain&nbsp;Days</th>
            <th>Charge&nbsp;Type</th>
            <th>Edit</th>

        </tr>
    </thead>

    <tbody id="body">

        @foreach (var item in Model.devicelist)
        {
            string paymenttype = "";
            int totalremainday = 0;
            System.TimeSpan diffResult;
            if (item.expdate == null)
            {
                paymenttype = "Full Payment Mode";

            }
            else
            {
                diffResult = item.expdate.Value - DateTime.Now.Date;
                if (diffResult.Days < 1)
                {
                    paymenttype = "Full Payment";

                }
                else
                {
                    paymenttype = "";
                    totalremainday = diffResult.Days;
                }
            }

            <tr class="tr">
                <td>@item.deviceid</td>
                <td>@item.planname</td>
              
                <td>
                    @if (item.idno == Model.DevicelistByid.idno)
                    {
                        
                            <div class="vm-matm-edit-select">
                                @Html.DropDownList("Frm_Name", (IEnumerable<SelectListItem>)ViewBag.remid,
                               new { @class = "for-select2 form-control", required = "required" })
                            </div>
                   @Html.TextBox("txtdevicenm",item.userid,new { style = "display:none;" })

                    }
                    else
                    {
                        @item.Frm_Name
                    }
                </td>

                <td>@item.Mobile</td>
                <td> @item.inseteddate</td>
                <td> @item.startdate</td>
                <td> @item.expdate</td>
                <td>
                    @if (paymenttype == "")
                    {
                        <span class="vm-matm-remain-badge @(totalremainday <= 7 ? "vm-matm-remain-badge--warn" : "vm-matm-remain-badge--ok")">@totalremainday&nbsp;days</span>
                    }
                    else
                    {
                        <span class="vm-matm-remain-badge vm-matm-remain-badge--info">@paymenttype</span>

                    }
                </td>
                <td>
                    @if (item.idno == Model.DevicelistByid.idno)
                    {
                        <div class="vm-matm-edit-select">
                            @Html.DropDownList("chargetypeEdit", new List<SelectListItem>
         {
          new SelectListItem{ Text="Daily",Value="Daily"},
              new SelectListItem{Text="Monthly",Value="Monthly"}
          }, new { @class = "form-control vm-matm-edit-native-select", required = "required" })
                        </div>
                        @Html.TextBox("txtchargetype", item.chargetype, new { style = "display:none;" })
                    }
                    else
                    {
                        @item.chargetype
                    }
                </td>
                @if (item.idno == Model.DevicelistByid.idno)
                {
                    <td>
                        <button type="button" class="switch-edit-button custom-table-loading vm-matm-save-btn" onclick="Savebyamount(@item.idno)" data-loading-text="<i class='fa fa-spinner fa-spin'></i>">
                            <i class="fas fa-check" aria-hidden="true"></i> Save
                        </button>
                    </td>
                }
                else
                {
                    <td>
                        <button class="btn btn default micro-edit-button vm-matm-edit-btn" id="EditBtn_@item.idno" onclick="Editbyamount('@item.idno')" title="Edit Information">
                            <i class="fas fa-pen" aria-hidden="true"></i>
                            <span id="editmicro_@item.idno">Edit</span>
                            <span class="editbutton-spinclass" id="microloader_@item.idno"></span>
                        </button>
                    </td>
                }
            </tr>
        }

    </tbody>
</table>