@model IEnumerable<Vastwebmulti.Models.money_api_status1>
@using System.Linq
@{
    ViewBag.Title = "money_api_statss1";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var rows = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.money_api_status1>();
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=28" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-api-operator-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-api-operator-page saas-money-api-stats-page">
    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
            <div class="saas-acc-toolbar-top vm-api-operator-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-api-operator-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li><a href="@Url.Action("Dashboard", "Home")#setting">Basic Setting</a></li>
                    <li>Money API Setting</li>
                </ol>
                <div class="vm-dmt-fin-nav-row vm-api-operator-nav-wrap">
                    @Html.Partial("_menuapinm")
                </div>
            </div>

            <div class="vm-rpt-filters-panel vm-api-operator-filter-panel">
                <div class="saas-acc-filter-bar vm-opr-filter-row vm-api-operator-filter-row vm-rpt-filters-panel__bar">
                    <div class="vm-api-operator-filter-group vm-money-api-stats-filter-group">
                        <div class="vm-money-api-bank-tabs" role="tablist" aria-label="Bank API">
                            <a href="@Url.Action("money_api_statss", "Home")" class="vm-money-api-bank-tab" role="tab" aria-selected="false">BANK1</a>
                            <a href="@Url.Action("money_api_statss1", "Home")" class="vm-money-api-bank-tab is-active" role="tab" aria-selected="true">BANK2</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-money-bill-wave" aria-hidden="true"></i>
                        <span>Money API status - BANK2</span>
                    </div>
                    <label class="vm-api-operator-table-search" for="moneyApiStatsSearch">
                        <i class="fas fa-search" aria-hidden="true"></i>
                        <input type="text" id="moneyApiStatsSearch" placeholder="Search records..." autocomplete="off" />
                    </label>
                </div>
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="moneyApiStatsTable" class="table vm-opr-data-table vm-money-api-stats-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>API Name</th>
                                    <th>Slab</th>
                                    <th>API Category</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in rows)
                                {
                                    var apiSelectId = "apis+" + item.idno;
                                    var slabSelectId = "apis1+" + item.idno;
                                    <tr data-api="@(item.api_name ?? "")" data-category="@(item.catagory ?? "")">
                                        <td class="vm-money-api-stats-cell vm-money-api-stats-cell--select">
                                            <select id="@apiSelectId" class="form-control vm-money-api-stats-select vm-money-api-stats-api-select" data-idno="@item.idno" title="API Name">
                                                @if (item.catagory != "DMT")
                                                {
                                                    <option @(item.api_name == "VASTWEB" ? "selected=\"selected\"" : "")>VASTWEB</option>
                                                }
                                                <option @(item.api_name == "RADIANT" ? "selected=\"selected\"" : "")>RADIANT</option>
                                            </select>
                                        </td>
                                        <td class="vm-money-api-stats-cell vm-money-api-stats-cell--slab">
                                            @if (item.catagory == "PAYOUT")
                                            {
                                                <select id="@slabSelectId" class="form-control vm-money-api-stats-select vm-money-api-stats-slab-select" data-idno="@item.idno" title="Slab">
                                                    <option>Slab1</option>
                                                    <option @(item.Slabnm == "Slab2" ? "selected=\"selected\"" : "")>Slab2</option>
                                                </select>
                                            }
                                            else
                                            {
                                                <span class="vm-money-api-stats-empty">N/A</span>
                                            }
                                        </td>
                                        <td class="vm-money-api-stats-cell vm-money-api-stats-cell--category">@item.catagory</td>
                                        <td class="vm-money-api-stats-cell vm-money-api-stats-cell--status">
                                            @if (item.status == true)
                                            {
                                                <button type="button" class="vm-money-api-stats-toggle vm-money-api-stats-toggle--on" data-idno="@item.idno" data-sts="false" title="Turn off">
                                                    <span class="onoffswitch"><span class="costom-on">on</span></span>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="vm-money-api-stats-toggle vm-money-api-stats-toggle--off" data-idno="@item.idno" data-sts="true" title="Turn on">
                                                    <span class="onoffswitch"><span class="custom-off">off</span></span>
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    (function () {
        function applyMoneyApiStatsSearch() {
            var q = ($('#moneyApiStatsSearch').val() || '').trim().toLowerCase();
            $('#moneyApiStatsTable tbody tr').each(function () {
                var text = $(this).text().toLowerCase();
                $(this).toggle(!q || text.indexOf(q) > -1);
            });
        }

        function bootMoneyApiStatsPage() {
            var $ = window.jQuery;
            if (!$ || !$.fn) {
                window.setTimeout(bootMoneyApiStatsPage, 50);
                return;
            }

            $('#moneyApiStatsSearch').off('keyup.moneyApiStats').on('keyup.moneyApiStats', applyMoneyApiStatsSearch);

            $(document).off('change.moneyApiStatsApi', '.vm-money-api-stats-api-select').on('change.moneyApiStatsApi', '.vm-money-api-stats-api-select', function () {
                var idno = $(this).data('idno');
                var value = $(this).val();
                $.ajax({
                    url: '@Url.Action("updatestsmoneyapiyes1", "Home")',
                    cache: false,
                    data: { idno: idno, cat: value },
                    type: 'GET',
                    success: function () {
                        location.reload();
                    }
                });
            });

            $(document).off('change.moneyApiStatsSlab', '.vm-money-api-stats-slab-select').on('change.moneyApiStatsSlab', '.vm-money-api-stats-slab-select', function () {
                var idno = $(this).data('idno');
                var value = $(this).val();
                $.ajax({
                    url: '@Url.Action("updatestsmoneyapiyesSlab1", "Home")',
                    cache: false,
                    data: { idno: idno, cat: value },
                    type: 'GET',
                    success: function () {
                        location.reload();
                    }
                });
            });

            $(document).off('click.moneyApiStatsToggle', '.vm-money-api-stats-toggle').on('click.moneyApiStatsToggle', '.vm-money-api-stats-toggle', function () {
                var idno = $(this).data('idno');
                var sts = $(this).data('sts');
                var $btn = $(this);
                $btn.prop('disabled', true);

                $.ajax({
                    url: '@Url.Action("updatestsmoneyapi1", "Home")',
                    cache: false,
                    data: { idno: idno, sts: sts },
                    type: 'GET',
                    success: function () {
                        location.reload();
                    },
                    error: function () {
                        $btn.prop('disabled', false);
                        if (window.swal) {
                            swal('Error', 'Unable to update status. Please try again.', 'error');
                        }
                    }
                });
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', bootMoneyApiStatsPage);
        } else {
            bootMoneyApiStatsPage();
        }
    })();
</script>
