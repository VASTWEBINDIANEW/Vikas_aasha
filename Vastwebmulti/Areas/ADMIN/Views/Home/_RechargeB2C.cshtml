@model IEnumerable<Vastwebmulti.Models.RechargeB2CStatus>
@using System.Linq
@using Vastwebmulti.Models
@{
    VastwebmultiEntities db = new VastwebmultiEntities();
    var reports = Model ?? Enumerable.Empty<RechargeB2CStatus>();
    var rowCount = reports.Count();
}

@if (rowCount == 0)
{
    <tr class="vm-opr-table-empty-row">
        <td colspan="4">No records found for the selected filters.</td>
    </tr>
}
else
{
    var sr = 1;
    var rowIndex = 0;
    foreach (var item in reports)
    {
        var retailer = !string.IsNullOrWhiteSpace(item.userid)
            ? db.Retailer_Details.FirstOrDefault(s => s.RetailerId == item.userid)
            : null;
        var dealer = retailer != null
            ? db.Dealer_Details.FirstOrDefault(s => s.DealerId == retailer.DealerId)
            : null;

        var userFirm  = retailer != null ? retailer.Frm_Name      : "-";
        var userName  = retailer != null ? retailer.RetailerName   : "-";
        var dealerName = dealer != null  ? dealer.FarmName         : "-";
        var isOn      = item.Sts == true;
        var userId    = item.userid ?? "";

        <tr class="vm-recharge-b2c-row @(isOn ? "vm-recharge-b2c-row--on" : "vm-recharge-b2c-row--off")" data-status="@(isOn ? "on" : "off")">
            <td class="vm-recharge-b2c-sr">@sr</td>
            <td>
                <div class="vm-recharge-b2c-user">
                    <strong class="vm-recharge-b2c-user__firm">@userFirm</strong>
                    @if (!string.IsNullOrWhiteSpace(userName) && userName != "-")
                    {
                        <span class="vm-recharge-b2c-user__name">@userName</span>
                    }
                </div>
            </td>
            <td>@dealerName</td>
            <td class="vm-recharge-b2c-status-cell" data-row-index="@rowIndex">
                @if (isOn)
                {
                    <button type="button"
                            class="vm-recharge-b2c-status-pill vm-recharge-b2c-status-pill--on vm-recharge-b2c-status-pill--btn"
                            data-uid="@userId"
                            data-ridx="@rowIndex"
                            data-next="OFF">
                        <i class="fas fa-check-circle" aria-hidden="true"></i><span>ON</span>
                    </button>
                }
                else
                {
                    <button type="button"
                            class="vm-recharge-b2c-status-pill vm-recharge-b2c-status-pill--off vm-recharge-b2c-status-pill--btn"
                            data-uid="@userId"
                            data-ridx="@rowIndex"
                            data-next="ON">
                        <i class="fas fa-times-circle" aria-hidden="true"></i><span>OFF</span>
                    </button>
                }
            </td>
        </tr>
        sr++;
        rowIndex++;
    }
}
