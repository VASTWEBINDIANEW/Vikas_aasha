@model List<Vastwebmulti.Models.Mpos_Report_New_paging_Result>
@{
    Layout = null;
}

@if (Model != null && Model.Count > 0)
{
    var srIndex = ViewBag.SrOffset != null ? Convert.ToInt32(ViewBag.SrOffset) : 0;
    foreach (var item in Model)
    {
        srIndex++;
        var isSuccess = item.status == "00";
        var statusTone = isSuccess ? "success" : "failed";
        var statusFa = isSuccess ? "fa-check" : "fa-times";
        var userName = !string.IsNullOrWhiteSpace(item.Frm_Name) ? item.Frm_Name : item.Email;
        <tr class="vm-dmt-row vm-dmt-row--@statusTone">
            <td class="vm-dmt-sr-cell">
                <span class="vm-dmt-sr-num">@srIndex</span>
                <span class="vm-dmt-status vm-dmt-status--@statusTone" title="@(isSuccess ? "Success" : "Failed")">
                    <i class="fa @statusFa" aria-hidden="true"></i>
                </span>
            </td>
            <td class="vm-dmt-user-cell">
                <span class="vm-dmt-user-name">@userName</span>
            </td>
            <td>@item.transType</td>
            <td>@item.cardtype</td>
            <td>@item.cardbrand</td>
            <td>@item.mPOSid</td>
            <td>@item.amount</td>
            <td>@item.Rem_comm</td>
            <td>@item.totalamount</td>
            <td class="vm-mpos-rrn-cell">@item.BankRRN</td>
            <td>@item.date</td>
            <td>@item.bankterminalID</td>
            <td class="vm-dmt-action-cell">
                <div class="nrch vm-dmt-action-bar">
                    <button type="button" class="fftt vm-dmt-act-btn vm-dmt-act-btn--detail" title="View details" data-toggle="modal" data-target="#defaultModal222" onclick="mdActionBtn('@item.Idno')">
                        <i class="fa fa-angle-double-right" aria-hidden="true"></i>
                    </button>
                </div>
            </td>
        </tr>
    }
}
else
{
    <tr class="vm-opr-table-empty-row">
        @if (@ViewBag.checkdata != null)
        {
            <td colspan="13" class="vm-opr-table-empty vm-dmt-table-empty">
                <i class="fa fa-search fas fa-search" aria-hidden="true"></i>
                <span>No transactions found for current search.</span>
            </td>
        }
        else
        {
            <td colspan="13" class="vm-opr-table-empty vm-dmt-table-empty">
                <i class="fa fa-credit-card fas fa-credit-card" aria-hidden="true"></i>
                <span>M-POS transaction not found.</span>
            </td>
        }
    </tr>
}
