
@{
    ViewBag.Title = "businessbyOperator";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=46" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=38" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-business-by-operator-modern.css?v=3" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-security-report-page saas-giftcard-report-page saas-prepaid-card-report-page saas-business-by-operator-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var bboFormAttrs = new Dictionary<string, object>
            {
                { "id", "businessByOperatorForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate }
            };
        }
        @using (Html.BeginForm("businessbyOperator", "Home", FormMethod.Get, bboFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line vm-gift-toolbar-one-line" style="margin:0 !important;">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Account</li>
                        <li>Business By Operator</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters vm-ecomm-filter-row--one-line vm-gift-filter-row--one-line">

                        <div class="vm-opr-field vm-dmt-field vm-bbo-field--quick">
                            <button type="button" class="vm-bbo-quick-btn" id="bboTodayBtn" onclick="grossbusiness1('today')" title="Today business">
                                <i class="fas fa-sun" aria-hidden="true"></i><span>Today</span>
                            </button>
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-bbo-field--quick">
                            <button type="button" class="vm-bbo-quick-btn" id="bboYesterdayBtn" onclick="grossbusiness1('lastday')" title="Yesterday business">
                                <i class="fas fa-history" aria-hidden="true"></i><span>Yesterday</span>
                            </button>
                        </div>

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date vm-bbo-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "Date", title = "Business date" })
                            </div>
                            <button type="button" onclick="grossbusiness1('date')" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

            </div>
        }

        <div class="vm-opr-main-card vm-security-report-main-card vm-gift-report-main-card vm-prepaid-report-main-card vm-bbo-results-card">
            <div class="vm-opr-table-panel vm-security-report-table-panel vm-gift-report-table-panel vm-prepaid-report-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head vm-security-report-table-head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-chart-pie" aria-hidden="true"></i>
                        <span>Business by operator</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Selected date">
                            Date: <strong id="bboSelectedDate">@frmDate</strong>
                        </span>
                    </div>
                </div>

                <div class="vm-opr-table-wrap vm-prepaid-table-wrap">
                    <div id="busn_show"></div>
                </div>
            </div>
        </div>

    </div>

    <div class="vm-bbo-page-loader" id="bboPageLoader" aria-hidden="true">
        <div class="vm-bbo-page-loader__spinner" role="status" aria-label="Loading"></div>
    </div>

</section>

<script>
    function bboShowLoader(show) {
        var $loader = $('#bboPageLoader');
        if (show) {
            $loader.addClass('is-visible').attr('aria-hidden', 'false');
        } else {
            $loader.removeClass('is-visible').attr('aria-hidden', 'true');
        }
    }

    function bboUpdateSelectedDate() {
        var dateVal = $('#txt_frm_date').val() || '';
        $('#bboSelectedDate').text(dateVal);
    }

    function bboSetQuickActive(mode) {
        $('#bboTodayBtn, #bboYesterdayBtn').removeClass('is-active');
        if (mode === 'today') {
            $('#bboTodayBtn').addClass('is-active');
        } else if (mode === 'lastday') {
            $('#bboYesterdayBtn').addClass('is-active');
        }
    }

    function initBboDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initBboDatepickers, 50);
            return;
        }

        var $form = $('#businessByOperatorForm');
        var $input = $('#txt_frm_date');
        if (!$input.length) {
            return;
        }

        $('.saas-business-by-operator-page .saas-acc-dp-field').each(function () {
            var $field = $(this);
            if ($field.data('datepicker')) {
                $field.datepicker('destroy');
            }
            $field.find('.datepicker-inline').remove();
        });

        if ($input.data('datepicker')) {
            $input.datepicker('destroy');
        }

        $input.datepicker({
            format: 'yyyy-mm-dd',
            todayHighlight: true,
            autoclose: true,
            orientation: 'bottom auto',
            container: 'body',
            forceParse: false
        });

        var frmVal = ($form.attr('data-frm-date') || '').trim();
        if (frmVal) {
            $input.datepicker('update', frmVal);
        } else {
            $input.datepicker('setDate', new Date());
        }

        $input.off('changeDate.bbo show.bbo').on('changeDate.bbo', function () {
            bboUpdateSelectedDate();
            bboSetQuickActive('');
        });

        $input.siblings('.saas-acc-dp-icon').off('click.bboDate').on('click.bboDate', function (e) {
            e.preventDefault();
            e.stopPropagation();
            $input.datepicker('show');
        });

        $input.off('click.bboDate').on('click.bboDate', function (e) {
            e.preventDefault();
            $input.datepicker('show');
        });

        bboUpdateSelectedDate();
    }

    function grossbusiness1(out) {
        if (out === 'date') {
            out = $('#txt_frm_date').val();
            bboSetQuickActive('');
        } else if (out === 'today') {
            $('#txt_frm_date').datepicker('setDate', new Date());
            bboSetQuickActive('today');
        } else if (out === 'lastday') {
            var yesterday = new Date();
            yesterday.setDate(yesterday.getDate() - 1);
            $('#txt_frm_date').datepicker('setDate', yesterday);
            bboSetQuickActive('lastday');
        }

        bboUpdateSelectedDate();
        bboShowLoader(true);

        var url = '@Url.Action("_business", "Home")';
        $.post(url, { data: out }, function (data) {
            bboShowLoader(false);
            $('#busn_show').html(data);
            bindBboTotalsToggle();
        }).fail(function () {
            bboShowLoader(false);
        });
    }

    function bindBboTotalsToggle() {
        /* Summary tiles are always visible in the modern grid layout */
    }

    function loadBusinessByOperatorInitial() {
        bboShowLoader(true);
        var url = '@Url.Action("_business", "Home")';
        $.post(url, function (data) {
            bboShowLoader(false);
            $('#busn_show').html(data);
            bindBboTotalsToggle();
        }).fail(function () {
            bboShowLoader(false);
        });
    }

    $(document).ready(function () {
        initBboDatepickers();
        bboSetQuickActive('today');
        loadBusinessByOperatorInitial();

        $('#txt_frm_date').off('change.bbo changeDate.bbo').on('changeDate.bbo change.bbo', function () {
            bboUpdateSelectedDate();
            bboSetQuickActive('');
        });
    });
</script>
