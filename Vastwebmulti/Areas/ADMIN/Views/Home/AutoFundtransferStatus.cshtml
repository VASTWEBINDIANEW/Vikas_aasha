@model Vastwebmulti.Areas.ADMIN.Models.FundAutoTransferModel
@using System.Linq
@{
    ViewBag.Title = "AutoFundtransferStatus";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    ViewBag.AutoFundNavActive = "retailer";
    var reports = Model != null && Model.autocredittransferreports != null
        ? Model.autocredittransferreports.ToList()
        : new List<Vastwebmulti.Models.Autocredittransferreports_Result>();
    var rowCount = reports.Count;
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=30" rel="stylesheet" />
<script src="~/MainFrontDesign/js/admin-financial-report.js?v=5"></script>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-auto-fund-status-page">

    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
            <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>Report's</li>
                    <li>Auto Credit Transfer Setting</li>
                </ol>
                <div class="vm-dmt-fin-nav-row">
                    @Html.Partial("_AutoFundTransferNav")
                </div>
            </div>
        </div>

        <div class="vm-opr-main-card vm-auto-fund-main-card">
            <div class="vm-opr-table-panel vm-auto-fund-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-sync-alt" aria-hidden="true"></i>
                        <span>Auto fund transfer to retailer status</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong id="autoFundRecordCount">@rowCount</strong>
                        </span>
                        <div class="vm-auto-fund-search-wrap">
                            <i class="fas fa-search" aria-hidden="true"></i>
                            <input class="form-control vm-auto-fund-search-input" type="text" value="" id="myInput" placeholder="Search retailer..." name="myInput" autocomplete="off" />
                        </div>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" id="btnExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel" onclick="excel()">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF" onclick="PDF()">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap vm-auto-fund-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll" id="autoFundTransferExportWrap">
                        <table id="autoFundTransferTable" class="table vm-opr-data-table vm-auto-fund-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Retailer&nbsp;Firm</th>
                                    <th>Retailer&nbsp;Min&nbsp;Balance&nbsp;&#8377;</th>
                                    <th>Transfer&nbsp;Amount&nbsp;&#8377;</th>
                                    <th>Day&nbsp;Count</th>
                                    <th>Credit&nbsp;Limit&nbsp;&#8377;</th>
                                    <th>Last&nbsp;Transaction&nbsp;Date</th>
                                    <th>Last&nbsp;Update&nbsp;Time</th>
                                    <th>Transfer&nbsp;Type</th>
                                    <th>Current&nbsp;Status</th>
                                </tr>
                            </thead>
                            <tbody id="body">
                                @if (rowCount == 0)
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="9">No auto fund transfer records found.</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var item in reports)
                                    {
                                        <tr class="tr vm-auto-fund-row">
                                            <td>
                                                <div class="vm-auto-fund-firm">
                                                    <strong>@item.Frm_Name</strong>
                                                    <span>@item.Mobile</span>
                                                </div>
                                            </td>
                                            <td class="tbltdshow" id="tbltdminiumamntshow_@item.idno">
                                                <span id="spanminimium_@item.idno">@item.Rem_minimiumamnt</span>
                                            </td>
                                            <td class="tbltdNOTshow" id="tbltdminiumamntNOTshow_@item.idno" style="display:none">
                                                <input type="number" id="miniumamnttxtbox_@item.idno" value="0" min="0" oninput="this.value = Math.abs(this.value)" class="vm-auto-fund-edit-input form-control" />
                                                <span class="vm-auto-fund-field-error" style="display:none;" id="errormsg_@item.idno">Minimum amount must be 500</span>
                                            </td>

                                            <td class="tbltdshow" id="tbltdtransamntshow_@item.idno">
                                                <span id="spantransferamnt_@item.idno">@item.transferamount</span>
                                            </td>
                                            <td class="tbltdNOTshow" id="tbltdtransamntNOTshow_@item.idno" style="display:none;">
                                                <input type="number" id="transamnttxtbox_@item.idno" value="0" min="0" oninput="this.value = Math.abs(this.value)" class="vm-auto-fund-edit-input form-control" />
                                                <span class="vm-auto-fund-field-error" style="display:none;" id="errormsg1_@item.idno">Minimum amount must be 500</span>
                                            </td>

                                            <td class="tbltdshow" id="datcountshow_@item.idno">
                                                <span id="spandaycount_@item.idno">@item.Totalfundytranfersete</span>
                                            </td>
                                            <td class="tbltdNOTshow" id="DaycountNOTshow_@item.idno" style="display:none;">
                                                <input type="number" id="counttbox_@item.idno" value="0" min="0" oninput="this.value = Math.abs(this.value)" class="vm-auto-fund-edit-input form-control" />
                                            </td>

                                            <td class="tbltdshow" id="UPtolimitshow_@item.idno">
                                                <span id="spanuptolimit_@item.idno">@item.MaxCredit</span>
                                            </td>
                                            <td class="tbltdNOTshow" id="UptolimitNOTshow_@item.idno" style="display:none;">
                                                <input type="number" id="Uptolimitbox_@item.idno" value="0" min="0" oninput="this.value = Math.abs(this.value)" class="vm-auto-fund-edit-input form-control" />
                                            </td>

                                            <td>@item.transferdate</td>
                                            <td>@item.remupdatestatusdate</td>

                                            <td class="vm-auto-fund-type-cell">
                                                @if (item.transfertype == "Credit")
                                                {
                                                    <span class="vm-auto-fund-type-pill vm-auto-fund-type-pill--credit">
                                                        <i class="fas fa-credit-card" aria-hidden="true"></i>
                                                        <button type="button" class="costom-on clscall vm-auto-fund-type-btn" id="btntransfersts_@item.idno" value="Cash" onclick="calltransfertype('@item.idno')">BY CREDIT</button>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="vm-auto-fund-type-pill vm-auto-fund-type-pill--cash">
                                                        <i class="fas fa-money-bill-wave" aria-hidden="true"></i>
                                                        <button type="button" class="costom-on clscall vm-auto-fund-type-btn" id="btntransfersts_@item.idno" onclick="calltransfertype('@item.idno')" value="Credit">BY CASH</button>
                                                    </span>
                                                }
                                            </td>
                                            <td class="vm-auto-fund-status-cell">
                                                <div class="vm-auto-fund-status-actions">
                                                    @if (item.remcurrentstatus == "Y")
                                                    {
                                                        <span class="onoffswitch costom-on-second vm-auto-fund-switch-wrap">
                                                            <button type="button" class="costom-on clscall vm-auto-fund-switch-btn" id="btnsts_@item.idno" value="ON" onclick="callstats('@item.idno')">ON</button>
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="onoffswitch costom-off-second vm-auto-fund-switch-wrap">
                                                            <button type="button" class="custom-off clscall vm-auto-fund-switch-btn" id="btnsts_@item.idno" onclick="callstats('@item.idno')" value="OFF">OFF</button>
                                                        </span>
                                                    }

                                                    <div class="tbltdshow vm-auto-fund-edit-show" id="editbtnshow_@item.idno">
                                                        <button type="button" value="EDIT" onclick="Edittransferinform('@item.idno')" class="btnssl22 vm-auto-fund-edit-btn">Edit</button>
                                                    </div>
                                                    <div class="tbltdNOTshow vm-auto-fund-edit-save" id="savebtnNotshow_@item.idno" style="display:none;">
                                                        <button type="button" value="Save" onclick="Savetransferamnt('@item.idno', '@item.remid')" class="btnssl22 vm-auto-fund-save-btn">Save</button>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.22/pdfmake.min.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.4.1/html2canvas.min.js"></script>

<script>
    function excel() {
        var table = document.getElementById('autoFundTransferTable');
        if (!table) {
            return;
        }
        var html = '<html><head><meta charset="utf-8" /></head><body>' + table.outerHTML + '</body></html>';
        var blob = new Blob(['\ufeff', html], { type: 'application/vnd.ms-excel;charset=utf-8;' });
        var link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = 'Auto_Fund_Transfer_Retailer.xls';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    function PDF() {
        var el = document.getElementById('autoFundTransferExportWrap');
        if (!el || typeof html2canvas === 'undefined' || typeof pdfMake === 'undefined') {
            return;
        }
        html2canvas(el, {
            onrendered: function (canvas) {
                var data = canvas.toDataURL();
                pdfMake.createPdf({
                    content: [{ image: data, width: 500 }]
                }).download('Auto_Fund_Transfer_Retailer.pdf');
            }
        });
    }

    function refreshAutoFundRecordCount() {
        var count = $('#body tr.tr:visible').length;
        $('#autoFundRecordCount').text(count);
    }

    function calltransfertype(idno) {
        var btntransfersts = '#btntransfersts_' + idno;
        var trnstypes = $('#btntransfersts_' + idno).val();

        $.ajax({
            url: "@Url.Action("ChangeStatusAutoCreditTrnasfer")",
            type: "POST",
            data: { idno: idno, curntsts: trnstypes },
            success: function (result) {
                if (result == 'Credit') {
                    $(btntransfersts).val('Cash');
                    $(btntransfersts).text('BY CREDIT');
                } else if (result == 'Cash') {
                    $(btntransfersts).val('Credit');
                    $(btntransfersts).text('BY CASH');
                }
            }
        });
    }

    function callstats(idno) {
        var btnstss = '#btnsts_' + idno;
        var ssss = $(btnstss).val();
        var crnrsts;
        if (ssss == 'OFF') {
            crnrsts = 'Y';
        } else {
            crnrsts = 'N';
        }
        $.ajax({
            url: "@Url.Action("ChangeStatusAutoCreditTrnasfer")",
            type: "POST",
            data: { idno: idno, curntsts: crnrsts },
            success: function (result) {
                var curntst;
                if (result == 'Y') {
                    curntst = 'ON';
                } else if (result == 'N') {
                    curntst = 'OFF';
                }

                if (curntst == 'OFF') {
                    $(btnstss).removeClass('costom-on');
                    $(btnstss).addClass('custom-off');
                    $(btnstss).val('OFF');
                    $(btnstss).text('OFF');
                } else if (curntst == 'ON') {
                    $(btnstss).removeClass('custom-off');
                    $(btnstss).addClass('costom-on');
                    $(btnstss).val('ON');
                    $(btnstss).text('ON');
                }
            }
        });
    }

    var transamnttxt, miniumamnttxtbox, countperday, uplimit;

    function Edittransferinform(id) {
        $('.tbltdshow').show();
        $('.tbltdNOTshow').hide();

        var tbltranstdamntnotshow = 'tbltdtransamntNOTshow_' + id;
        var tbltranstdamntshow = 'tbltdtransamntshow_' + id;
        transamnttxt = 'transamnttxtbox_' + id;
        miniumamnttxtbox = 'miniumamnttxtbox_' + id;
        countperday = 'counttbox_' + id;
        uplimit = 'Uptolimitbox_' + id;
        var editbtnshows = 'editbtnshow_' + id;
        var savebtnNotshow = 'savebtnNotshow_' + id;
        var tbltdminiumamntNOTshow = 'tbltdminiumamntNOTshow_' + id;
        var tbltdminiumamntshow = 'tbltdminiumamntshow_' + id;
        var Datcountnotshow = 'DaycountNOTshow_' + id;
        var Uptolimitnotshow = 'UptolimitNOTshow_' + id;
        var datcountshow = 'datcountshow_' + id;
        var UPtolimitshow = 'UPtolimitshow_' + id;

        $('#' + tbltranstdamntnotshow).show();
        $('#' + savebtnNotshow).show();
        $('#' + tbltdminiumamntNOTshow).show();
        $('#' + Datcountnotshow).show();
        $('#' + Uptolimitnotshow).show();
        $('#' + tbltranstdamntshow).hide();
        $('#' + editbtnshows).hide();
        $('#' + tbltdminiumamntshow).hide();
        $('#' + datcountshow).hide();
        $('#' + UPtolimitshow).hide();

        $.ajax({
            url: "@Url.Action("GetAutoTransferAmountDetails")",
            type: "GET",
            data: { idno: id },
            dataType: "html",
            success: function (result) {
                var ssssd = JSON.parse(result);
                $('#' + transamnttxt).val(ssssd.transferamnt);
                $('#' + miniumamnttxtbox).val(ssssd.minimiumbal);
                $('#' + countperday).val(ssssd.totalfundtrsf);
                $('#' + uplimit).val(ssssd.uptolimit);
            }
        });
    }

    function Savetransferamnt(idno, remidids) {
        var transamnt = $('#' + transamnttxt).val();
        var minimiumset = $('#' + miniumamnttxtbox).val();
        var totalfundtrns = $('#' + countperday).val();
        var Uptolimitt = $('#' + uplimit).val();
        var tbltranstdamntnotshow = 'tbltdtransamntNOTshow_' + idno;
        var tbltranstdamntshow = 'tbltdtransamntshow_' + idno;
        transamnttxt = 'transamnttxtbox_' + idno;
        miniumamnttxtbox = 'miniumamnttxtbox_' + idno;
        countperday = 'counttbox_' + idno;
        uplimit = 'Uptolimitbox_' + idno;
        var editbtnshows = 'editbtnshow_' + idno;
        var savebtnNotshow = 'savebtnNotshow_' + idno;
        var tbltdminiumamntNOTshow = 'tbltdminiumamntNOTshow_' + idno;
        var tbltdminiumamntshow = 'tbltdminiumamntshow_' + idno;
        var Datcountnotshow = 'DaycountNOTshow_' + idno;
        var Uptolimitnotshow = 'UptolimitNOTshow_' + idno;
        var datcountshow = 'datcountshow_' + idno;
        var UPtolimitshow = 'UPtolimitshow_' + idno;

        $('#errormsg_' + idno).hide();
        $('#errormsg1_' + idno).hide();

        if (transamnt < 500) {
            $('#errormsg1_' + idno).show();
        }

        if (minimiumset < 500) {
            $('#errormsg_' + idno).show();
        }

        if (transamnt >= 500 && minimiumset >= 500) {
            $('#errormsg_' + idno).hide();
            $('#errormsg1_' + idno).hide();
            $.ajax({
                url: "@Url.Action("SaveautoTransferamount")",
                type: "POST",
                data: { transamnt: transamnt, minimiumset: minimiumset, totalfundtrns: totalfundtrns, Uptolimitt: Uptolimitt, remid: remidids },
                dataType: "html",
                success: function (result) {
                    $('#' + tbltranstdamntnotshow).hide();
                    $('#' + savebtnNotshow).hide();
                    $('#' + tbltdminiumamntNOTshow).hide();
                    $('#' + Datcountnotshow).hide();
                    $('#' + Uptolimitnotshow).hide();
                    $('#' + tbltranstdamntshow).show();
                    $('#' + editbtnshows).show();
                    $('#' + tbltdminiumamntshow).show();
                    $('#' + datcountshow).show();
                    $('#' + UPtolimitshow).show();
                    var aaaaa = JSON.parse(result);
                    $('#spanminimium_' + idno).text(aaaaa.minimiumbal);
                    $('#spantransferamnt_' + idno).text(aaaaa.transferamnt);
                    $('#spandaycount_' + idno).text(aaaaa.totalfundtrsf);
                    $('#spanuptolimit_' + idno).text(aaaaa.uptolimit);
                }
            });
        }
    }

    $(document).ready(function () {
        refreshAutoFundRecordCount();

        $("#myInput").on("keyup", function () {
            var value = $(this).val().toLowerCase();
            $("#body .tr").filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
            });
            refreshAutoFundRecordCount();
        });
    });
</script>
