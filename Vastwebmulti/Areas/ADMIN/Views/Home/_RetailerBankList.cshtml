@model IEnumerable<Vastwebmulti.Models.ShowBankRequest_Result>
@using System.Linq
@{
    var rows = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.ShowBankRequest_Result>();
}

<div class="modal fade saas-admin-modal" id="retailerBankImageModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                <h4 class="modal-title">Cancel cheque</h4>
            </div>
            <div class="modal-body text-center">
                <img src="" alt="Cheque" id="retailerBankImageFull" />
            </div>
        </div>
    </div>
</div>

<div class="modal fade saas-admin-modal" id="retailerBankApproveModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            @using (Html.BeginForm("RetailerBnkApprove", "Home", FormMethod.Post))
            {
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" id="retailerBankApproveTitle">Approve bank</h4>
                </div>
                <div class="modal-body saas-admin-modal-body">
                    <img src="" alt="Cheque preview" class="saas-bank-check-preview" id="imgcheck" />
                    <input type="hidden" id="hdidno" name="hdidno" value="" />
                    <input type="hidden" id="hduserid" name="hduserid" value="" />
                    <div class="form-group">
                        <label>Account holder name</label>
                        <input type="text" class="form-control" id="txtaccountholdername" name="txtaccountholdername" readonly />
                    </div>
                    <div class="form-group">
                        <label>IFSC code</label>
                        <input type="text" class="form-control" id="txtifsccode" name="txtifsccode" readonly />
                    </div>
                    <div class="form-group">
                        <label>Account number</label>
                        <input type="text" class="form-control" id="txtaccountnumber" name="txtaccountnumber" readonly />
                    </div>
                    <div class="form-group">
                        <label for="remotp">Retailer OTP</label>
                        <input type="text" class="form-control" id="remotp" name="remotp" required autocomplete="off" />
                    </div>
                    <div class="form-group">
                        <label for="adminotp">Admin OTP</label>
                        <input type="text" class="form-control" id="adminotp" name="adminotp" required autocomplete="off" />
                    </div>
                </div>
                <div class="modal-footer saas-admin-modal-footer">
                    <button type="button" class="saas-admin-btn saas-admin-btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="saas-admin-btn saas-admin-btn-primary">Submit</button>
                </div>
            }
        </div>
    </div>
</div>

<div class="saas-acc-table-wrap table-responsive">
    <table class="table saas-acc-table saas-acc-table--bank table-bordered" id="retailerBankTable">
        <thead>
            <tr>
                <th>Cheque</th>
                <th>User / Firm</th>
                <th>Account holder</th>
                <th>Account no.</th>
                <th>IFSC</th>
                <th>Bank name</th>
                <th>Branch</th>
                <th>Added</th>
                <th>Approved</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (rows.Count == 0)
            {
                <tr><td colspan="10" class="saas-pan-empty-cell">No bank requests found.</td></tr>
            }
            else
            {
                foreach (var item in rows)
                {
                    var pending = (item.Status ?? "").Equals("PENDING", StringComparison.OrdinalIgnoreCase);
                    var approved = (item.Status ?? "").Equals("APPROVED", StringComparison.OrdinalIgnoreCase);
                    <tr>
                        <td data-label="Cheque">
                            @if (string.IsNullOrEmpty(item.CancelCheckFile))
                            {
                                <span class="text-muted">No image</span>
                            }
                            else
                            {
                                <button type="button" class="btn btn-link p-0" onclick="retailerBankShowImage('@item.Idno')" title="View cheque">
                                    <img src="@Url.Content("~/" + item.CancelCheckFile)" class="saas-bank-thumb" id="upload-@item.Idno" alt="Cheque" />
                                </button>
                            }
                        </td>
                        <td data-label="User">
                            <div class="saas-bank-user-cell">
                                @if (pending)
                                {
                                    <img src="~/ashok-images/clock.svg" alt="Pending" />
                                }
                                else
                                {
                                    <img src="~/ashok-images/correct.svg" class="saas-dispute-sts-icon--app" alt="Approved" style="width:19px;border-radius:50%;padding:3px;background:#059669;" />
                                }
                                <span><strong>@((item.Firm_Name ?? "").ToUpperInvariant())</strong> � @item.Mobile</span>
                            </div>
                        </td>
                        <td data-label="Holder">@item.AcconutHolderName</td>
                        <td data-label="Account">@item.BankAccountNo</td>
                        <td data-label="IFSC">@item.IFSC_CODE</td>
                        <td data-label="Bank">
                            @if (!string.IsNullOrWhiteSpace(item.topfilter))
                            {
                                @((item.Bank_Name ?? "").ToUpperInvariant())<span> &gt; </span><strong>@item.topfilter</strong>
                            }
                            else
                            {
                                @((item.Bank_Name ?? "").ToUpperInvariant())
                            }
                        </td>
                        <td data-label="Branch">@item.Bank_Address</td>
                        <td data-label="Added">@item.Date</td>
                        <td data-label="Approved">@item.Approved_Date</td>
                        <td data-label="Action">
                            @if (pending)
                            {
                                <div class="saas-pur-actions">
                                    <button type="button" class="saas-pur-btn saas-pur-btn--approve saas-bank-approve-btn"
                                            data-userid="@item.UserId" data-idno="@item.Idno"
                                            data-firm="@item.Firm_Name" data-holder="@item.AcconutHolderName"
                                            data-bankno="@item.BankAccountNo" data-ifsc="@item.IFSC_CODE"
                                            title="Approve"><i class="fa fa-check"></i></button>
                                    <button type="button" class="saas-pur-btn saas-pur-btn--reject"
                                            onclick="return retailerBankConfirmReject('@Url.Action("RetailerBnkReject", new { Idno = item.Idno })');"
                                            title="Reject"><i class="fa fa-times"></i></button>
                                </div>
                            }
                            else if (approved)
                            {
                                <div class="saas-pur-actions">
                                    <button type="button" class="saas-pur-btn saas-pur-btn--reject saas-bank-delete-reveal" title="Delete"><i class="fa fa-trash"></i></button>
                                    <button type="button" class="saas-pur-btn saas-pur-btn--approve saas-bank-delete-confirm" style="display:none;"
                                            onclick="return retailerBankConfirmDelete('@Url.Action("DeleteRetailerBnkt", new { Idno = item.Idno })');"
                                            title="Confirm delete">Sure?</button>
                                </div>
                            }
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

<script>
    $(function () {
        $(document).on("click", ".saas-bank-approve-btn", function () {
            var $b = $(this);
            retailerBankSendOtp(
                $b.data("userid"),
                $b.data("idno"),
                $b.data("firm"),
                $b.data("holder"),
                $b.data("bankno"),
                $b.data("ifsc")
            );
        });
    });
</script>
