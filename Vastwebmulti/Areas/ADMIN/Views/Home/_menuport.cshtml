<div id="vmHardwareNav" class="vm-slab-category-nav vm-hardware-nav">
    <h2 class="vm-slab-category-nav__title">Hardware</h2>
    <ul class="nav nav-tabs vm-slab-category-nav__list vm-hardware-nav__list">
        <li>
            <a href="@Url.Action("PortReport", "Home")">
                <i class="fas fa-plug vm-hardware-nav__icon" aria-hidden="true"></i>
                <span>Port Setting</span>
            </a>
        </li>
        <li>
            <a href="@Url.Action("LapuReport", "Home")">
                <i class="fas fa-sim-card vm-hardware-nav__icon" aria-hidden="true"></i>
                <span>Lapu Setting</span>
            </a>
        </li>
        @*<li><a href="@Url.Action("Assign_port", "Home")">Assign Port</a></li>*@
        <li>
            <a href="@Url.Action("Status_master", "Home")">
                <i class="fas fa-list-alt vm-hardware-nav__icon" aria-hidden="true"></i>
                <span>Status Manager</span>
            </a>
        </li>
    </ul>
    <div class="vm-hardware-network-legend-wrap">
        <p class="vm-hardware-network-legend__title">Network Status</p>
        <ul class="vm-hardware-network-legend">
            <li>
                <img src="~/AdminDesign/images/strong-network.svg" alt="" /><span>Strong Network</span>
            </li>
            <li>
                <img src="~/AdminDesign/images/avg-network.svg" alt="" /><span>Average Network</span>
            </li>
            <li>
                <img src="~/AdminDesign/images/weak-network.svg" alt="" /><span>Weak Network</span>
            </li>
            <li>
                <img src="~/AdminDesign/images/poor-network.svg" alt="" /><span>Poor Network</span>
            </li>
            <li>
                <img src="~/AdminDesign/images/no-network.svg" alt="" /><span>No Network</span>
            </li>
        </ul>
    </div>
</div>
<script>
    $(document).ready(function () {
        var current = location.pathname;
        $('#vmHardwareNav .vm-slab-category-nav__list li a').each(function () {
            var $this = $(this);
            if ($this.attr('href').indexOf(current) !== -1) {
                $this.parent().addClass('active');
                $this.addClass('active');
            }
        });
    });
</script>
