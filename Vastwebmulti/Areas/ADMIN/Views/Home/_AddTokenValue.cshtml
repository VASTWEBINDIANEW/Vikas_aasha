<div class="atv-wrapper">
    <div class="atv-section-head">
        <div class="atv-section-icon"><i class="fas fa-tags"></i></div>
        <div>
            <div class="atv-section-title">Token's Price Setting</div>
            <div class="atv-section-sub">Set token price for Master &amp; Distributor</div>
        </div>
    </div>

    <div class="atv-field-card">
        <label class="atv-label"><i class="fas fa-sitemap"></i> Master Distributor Token Price</label>
        <input type="text" id="txtmastervalue" name="txtmastervalue" class="form-control atv-input"
               placeholder="Enter Master token price" onkeyup="rcTokenPriceInput()" onkeypress="return rcTokenNumOnly(event)" />
        <div class="atv-old-price">Old Fixed Price: <strong>&#8377; @ViewBag.mastervalue.00</strong></div>
    </div>

    <div class="atv-field-card">
        <label class="atv-label"><i class="fas fa-building"></i> Distributor Token Price</label>
        <input type="text" id="txtdealervalue" name="txtdealervalue" class="form-control atv-input"
               placeholder="Enter Distributor token price" onkeyup="rcTokenPriceInput()" onkeypress="return rcTokenNumOnly(event)" />
        <div class="atv-old-price">Old Fixed Price: <strong>&#8377; @ViewBag.dealervalue.00</strong></div>
    </div>

    <div class="atv-btn-row">
        <button type="button" id="start_button" class="ne-btn-submit" disabled onclick="AddToken();">
            <i class="fas fa-save"></i> Save Change
        </button>
    </div>
</div>

<style>
    .atv-wrapper { padding: 14px 16px; }
    .atv-section-head { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
    .atv-section-icon { width: 36px; height: 36px; border-radius: 10px; background: linear-gradient(135deg,#2563eb,#4f46e5); display: flex; align-items: center; justify-content: center; color: #fff; font-size: .9rem; }
    .atv-section-title { font-size: .88rem; font-weight: 700; color: #0f172a; }
    .atv-section-sub { font-size: .7rem; color: #64748b; margin-top: 1px; }
    .atv-field-card { background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 10px; padding: 10px 12px; margin-bottom: 10px; }
    .atv-label { font-size: .74rem; font-weight: 600; color: #334155; margin-bottom: 6px; display: flex; align-items: center; gap: 6px; }
    .atv-label i { color: #2563eb; font-size: .72rem; }
    .atv-input { height: 34px !important; border-radius: 8px !important; font-size: .78rem !important; border: 1.5px solid #cbd5e1 !important; background: #fff !important; }
    .atv-old-price { font-size: .7rem; color: #64748b; margin-top: 6px; }
    .atv-old-price strong { color: #0891b2; }
    .atv-btn-row { display: flex; justify-content: flex-end; padding-top: 4px; }
</style>

<script>
    function rcTokenNumOnly(evt) {
        var k = evt.which ? evt.which : evt.keyCode;
        return (k >= 48 && k <= 57) || k === 46 || k === 8 || k === 9;
    }
    function rcTokenPriceInput() {
        var m = $.trim($('#txtmastervalue').val());
        var d = $.trim($('#txtdealervalue').val());
        $('#start_button').prop('disabled', !(m.length && d.length));
    }
    function AddToken() {
        var m = $.trim($('#txtmastervalue').val());
        var d = $.trim($('#txtdealervalue').val());
        if (!m || !d) return;
        $.ajax({
            url: '@Url.Action("_AddTokenValue","Home")',
            type: 'POST',
            data: { txtmastervalue: m, txtdealervalue: d },
            cache: false,
            success: function (response) {
                $("#AddTokenVal").html(response);
            }
        });
    }
</script>
