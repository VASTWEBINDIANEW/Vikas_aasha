<script src="~/select2/dist/js/select2.min.js"></script>

<script>
    function myFunction() {
        var copyText = document.getElementById("txthdlink");
        if (!copyText || !copyText.value) {
            return;
        }
        copyText.select();
        copyText.setSelectionRange(0, 99999);
        if (navigator.clipboard && window.isSecureContext) {
            navigator.clipboard.writeText(copyText.value);
        } else {
            document.execCommand("copy");
        }

        var tooltip = document.getElementById("myTooltip");
        if (tooltip) {
            tooltip.innerHTML = "Copied: " + copyText.value;
        }
    }

    function outFunc() {
        var tooltip = document.getElementById("myTooltip");
        tooltip.innerHTML = "Copy to clipboard";
    }
</script>

<script>
    $('.for-select2').select2();
</script>

<script>
    $(document).ready(function () {
        $('#txtApkSearch').on('input', function () {
            var q = $.trim($(this).val()).toLowerCase();
            var $blocks = $('.saas-upload-apk-page [data-apk-search]');

            if (!q) {
                $blocks.removeClass('vm-ft-apk-search-hidden');
                $('.vm-ft-apk-col').removeClass('vm-ft-apk-col--empty');
                return;
            }

            $blocks.each(function () {
                var text = (($(this).attr('data-apk-search') || '') + ' ' + $(this).text()).toLowerCase();
                $(this).toggleClass('vm-ft-apk-search-hidden', text.indexOf(q) === -1);
            });

            $('.vm-ft-apk-col').each(function () {
                var visible = $(this).find('[data-apk-search]').not('.vm-ft-apk-search-hidden').length > 0;
                $(this).toggleClass('vm-ft-apk-col--empty', !visible);
            });
        });
    });
</script>

<script>
    $(document).ready(function () {
        var succ = @Html.Raw(Json.Encode(ViewBag.success));
        var error = @Html.Raw(Json.Encode(ViewBag.error));
        if (succ) {
            swal("Good job!", succ, "success");
        }
        if (error) {
            swal("Oops...", error, "error");
        }
    });
</script>

<script type="text/javascript">
    function deleteadminapk(e, email) {
        swal({
            title: "Are you sure?",
            text: "Do you want to delete APK File",
            type: "warning",
            showCancelButton: true,
            confirmButtonColor: "#DD6B55",
            confirmButtonText: "Yes, delete it!",
            closeOnConfirm: false
        },
        function () {
            $.ajax({
                type: "POST", url: '@Url.Action("deleteadminapk", "Home")', dataType: 'json', cache: false, success: function (result) {
                    if (result == "Success") {
                        swal("Deleted!", "APK Deleted Successfully.", "success");
                        var url = '@Url.Action("UploadAPK", "Home")';
                        window.location.href = url;
                    }
                    else {
                        swal("Failed!", "Something went wrong.", "error");
                        var url = '@Url.Action("UploadAPK", "Home")';
                        window.location.href = url;
                    }
                }
            });
        });
    }
</script>

