@model IEnumerable<Vastwebmulti.Models.pos_ledger_report_Result>
@using System.Linq
@using System.Collections.Generic
@{
    var posRows = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.pos_ledger_report_Result>();
    var rowCount = posRows.Count;
    decimal totalCredit = posRows.Sum(x => x.cr ?? 0m);
    decimal totalDebit = posRows.Sum(x => x.dr ?? 0m);
}

<div id="posLedgerPartialRoot"
     data-record-count="@rowCount"
     data-total-credit="@totalCredit.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)"
     data-total-debit="@totalDebit.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)">

    <div id="posLedgerTableScroll" class="table-responsive vm-opr-table-scroll vm-ledger-table-scroll">
        <table id="posLedgerTable" class="table vm-opr-data-table saas-acc-table saas-acc-table--ledger vm-pos-ledger-table" cellspacing="0">
            <thead>
                <tr>
                    <th>Details</th>
                    <th>Firm&nbsp;Name</th>
                    <th>Remain&nbsp;Pre</th>
                    <th>Cr</th>
                    <th>Dr</th>
                    <th>?&nbsp;Amount</th>
                    <th>Comm</th>
                    <th>Gst</th>
                    <th>Tds</th>
                    <th>Remain&nbsp;Post</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody id="posLedgerTableBody">
                @if (rowCount == 0)
                {
                    <tr class="vm-opr-table-empty-row">
                        <td colspan="11" class="vm-opr-table-empty vm-dmt-table-empty">
                            <i class="fas fa-inbox" aria-hidden="true"></i>
                            <span>No data found.</span>
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var item in posRows)
                    {
                        <tr>
                            <td class="col-particulars">@item.Details</td>
                            <td>@item.Frm_Name</td>
                            <td class="col-balance">@item.remainpre</td>
                            <td>@item.cr</td>
                            <td>@item.dr</td>
                            <td class="col-amount">@item.Amount</td>
                            <td>@item.comm</td>
                            <td>@item.gst</td>
                            <td>@item.tds</td>
                            <td class="col-balance">@item.remainpost</td>
                            <td>@item.ledgerdate</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
