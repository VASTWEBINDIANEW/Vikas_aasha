@model IEnumerable<Vastwebmulti.Areas.ADMIN.Models.RadiantPrepayReportVM>
@{
    Layout = null;
    var items = Model ?? Enumerable.Empty<Vastwebmulti.Areas.ADMIN.Models.RadiantPrepayReportVM>();
}
@if (items.Any())
{
    foreach (var item in items)
    {
        var statusTone = "pending";
        var statusFa = "fa-clock-o";
        var statusLabel = item.Status ?? "";

        if (!string.IsNullOrEmpty(item.Status) && item.Status.Equals("Failed", StringComparison.OrdinalIgnoreCase))
        {
            statusTone = "failed";
            statusFa = "fa-times";
        }
        else if (!string.IsNullOrEmpty(item.Status) && item.Status.Equals("Success", StringComparison.OrdinalIgnoreCase))
        {
            statusTone = "success";
            statusFa = "fa-check";
        }
        else if (!string.IsNullOrEmpty(item.Status) && item.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase))
        {
            statusTone = "pending";
            statusFa = "fa-clock-o";
        }

        <tr class="vm-dmt-row vm-dmt-row--@statusTone" data-amount="@(item.Amount ?? 0)" data-status="@statusLabel">
            <td class="vm-radiant-firm-cell">@item.Firmname</td>
            <td>@item.CEID</td>
            <td class="vm-dmt-amt-cell">@(item.Amount.HasValue ? Math.Round(item.Amount.Value, 2).ToString() : "—")</td>
            <td class="vm-dmt-amt-cell">@(item.RemainPre.HasValue ? Math.Round(item.RemainPre.Value, 2).ToString() : "—")</td>
            <td class="vm-dmt-amt-cell">@(item.RemainPost.HasValue ? Math.Round(item.RemainPost.Value, 2).ToString() : "—")</td>
            <td class="vm-radiant-request-cell">@item.RequestID</td>
            <td class="vm-ticket-time-cell">
                @(item.InsertDate.HasValue ? item.InsertDate.Value.ToString("dd-MMM-yyyy HH:mm:ss") : "—")
            </td>
            <td class="vm-ticket-time-cell">
                @(item.UpdateDate.HasValue ? item.UpdateDate.Value.ToString("dd-MMM-yyyy HH:mm:ss") : "—")
            </td>
            <td class="vm-radiant-status-cell vm-ticket-status-cell">
                <span class="vm-dmt-status vm-dmt-status--@statusTone" title="@statusLabel">
                    <i class="fa @statusFa" aria-hidden="true"></i>
                </span>
                <span class="vm-radiant-status-text">@statusLabel</span>
            </td>
            <td class="vm-dmt-action-cell">
                @if (item.Status == "Pending")
                {
                    <div class="vm-dmt-action-bar">
                        <button type="button"
                                class="vm-dmt-act-btn vm-dmt-act-btn--success btn-status"
                                data-id="@item.RequestID"
                                data-status="Success"
                                title="Mark as Success">
                            <i class="fa fa-check" aria-hidden="true"></i>
                        </button>
                        <button type="button"
                                class="vm-dmt-act-btn vm-dmt-act-btn--danger btn-status"
                                data-id="@item.RequestID"
                                data-status="Failed"
                                title="Mark as Failed">
                            <i class="fa fa-times" aria-hidden="true"></i>
                        </button>
                    </div>
                }
            </td>
        </tr>
    }
}
else
{
    <tr class="vm-opr-table-empty-row">
        <td colspan="10" class="vm-opr-table-empty vm-dmt-table-empty">
            <i class="fas fa-wallet" aria-hidden="true"></i>
            <span>Radiant prepay report not found.</span>
        </td>
    </tr>
}
