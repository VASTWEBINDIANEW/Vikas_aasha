<div id="otpmodal" class="modal fade mastermodal-second-design" role="dialog">
    <div class="modal-dialog" style="float: right;margin: 0px;width: 520px;">
        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 id="headershow" class="modal-title"><img src="~/MainFrontDesign/images/delete.svg" style="width:18px;margin-top:-4px;" />&nbsp;One Time Password</h4>
            </div>
            <div class="modal-body">
                @using (Ajax.BeginForm("ConfirmDeleteOTP", "Home", new AjaxOptions { HttpMethod = "POST", UpdateTargetId = "Masterlistupdate", OnSuccess = "OnSuccessdistributor", OnFailure = "OnFailureotperror" }))
                {
                    @Html.Hidden("ssiddelete")
                    <div class="row">
                        <div class="col-md-12 col-sm-12 col-xs-12">
                            <div class="form-group">
                                <label>OTP</label>
                                @Html.TextBox("Deleteotp", "", new { @class = "form-control", placeholder = "Enter OTP", required = "required", @style = "background: #f5f5f5;border: 1px solid #bbb;" })
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-12 col-sm-12 col-xs-12 button-seconddesign">
                            <span id="otpwrong" style="color:red;float:left; "></span>
                            <button type="submit" value="SaveChange" class="btn special-iii btnssl2233 fullbodydycolorbg btn-first" data-loading-text="<i class='fa fa-spinner fa-spin'></i>" style="float: right;color: #fff;font-weight: 600;width:93px;"><span style="color:#fff;">Delete User</span></button>
                        </div>
                    </div>

                }
            </div>
        </div>

    </div>
</div>


