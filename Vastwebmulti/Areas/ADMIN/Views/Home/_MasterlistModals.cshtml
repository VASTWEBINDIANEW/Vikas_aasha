                        </ul>
                    </div>
                    <button type="button" class="saas-admin-modal-close vm-ml-side-close" data-dismiss="modal" aria-label="Close">
                        <i class="fas fa-times" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="float-left width100 vm-ml-modal-content-wrap">

                    <form class="first-form vm-ml-modal-form">
                        @Html.Hidden("ssidshow")
                        <div class="vm-ml-modal-grid">
                            <div class="vm-ml-modal-field vm-ml-modal-field--full">
                                <label>Email</label>
                                @Html.TextBox("Email11", "", new { @class = "form-control", placeholder = "Enter Email", @style = "text-transform:uppercase", required = "required", @readonly = "readonly" })
                            </div>
                            <div class="vm-ml-modal-field">
                                <label>Distributor's Balance</label>
                                @Html.TextBox("dealerremain", "", new { @class = "form-control vm-ml-field-highlight", placeholder = "Distributor Balance", @style = "text-transform:uppercase", required = "required", @readonly = "readonly" })
                            </div>
                            <div class="vm-ml-modal-field">
                                <label>Retailer's Balance</label>
                                @Html.TextBox("retailerremain", "", new { @class = "form-control vm-ml-field-highlight", placeholder = "Retailer Balance", @style = "text-transform:uppercase", required = "required", @readonly = "readonly" })
                            </div>
                            <div class="vm-ml-modal-field">
                                <label>Pancard</label>
                                @Html.TextBox("Pancard11", "", new { @class = "form-control", placeholder = "Enter Pancard No", maxlength = 10, @style = "text-transform:uppercase", required = "required", @readonly = "readonly" })
                            </div>
                            <div class="vm-ml-modal-field">
                                <label>Aadhar Card</label>
                                @Html.TextBox("Aadhar11", "", new { @class = "form-control", placeholder = "Enter Aadhar No", maxlength = 12, @style = "text-transform:uppercase", required = "required", @readonly = "readonly" })
                            </div>
                            <div class="vm-ml-modal-field vm-ml-modal-field--full">
                                <label>Farm Aggreement</label>
                                @Html.TextBox("frmagr11", "", new { @class = "form-control", placeholder = "Farm agreement", @style = "text-transform:uppercase", required = "required", @readonly = "readonly" })
                            </div>
                            <div class="vm-ml-modal-field">
                                <label>Pin Code</label>
                                @Html.TextBox("pincode11", "", new { @class = "form-control", placeholder = "Enter Pin Code", maxlength = 6, @style = "text-transform:uppercase", required = "required", @readonly = "readonly" })
                            </div>
                            <div class="vm-ml-modal-field">
                                <label>GST Reg. No</label>
                                @Html.TextBox("GSTRegistrationNo11", "", new { @class = "form-control", placeholder = "Enter Gst No", maxlength = 15, @style = "text-transform:uppercase", required = "required", @readonly = "readonly" })
                            </div>
                            <div class="vm-ml-modal-field">
                                <label>Margine (Offline) %</label>
                                <span id="offmargine" class="vm-ml-readonly-field"></span>
                            </div>
                            <div class="vm-ml-modal-field">
                                <label>Capping</label>
                                <span id="Capping" class="vm-ml-readonly-field"></span>
                            </div>
                            <div class="vm-ml-modal-field">
                                <label>State</label>
                                @Html.TextBox("State11", "", new { @class = "form-control", placeholder = "Enter State", @style = "text-transform:uppercase", required = "required", @readonly = "readonly" })
                            </div>
                            <div class="vm-ml-modal-field">
                                <label>District</label>
                                @Html.TextBox("District11", "", new { @class = "form-control", placeholder = "Enter District", @style = "text-transform:uppercase", required = "required", @readonly = "readonly" })
                            </div>
                            <div class="vm-ml-modal-field vm-ml-modal-field--full">
                                <label>Address</label>
                                @Html.TextArea("address11", "", new { @class = "form-control", placeholder = "Enter Address", @style = "text-transform:uppercase;height:72px", required = "required", @readonly = "readonly" })
                            </div>
                        </div>
                        <div class="vm-ml-modal-actions modal-footer width100 float-left button-seconddesign">
                            <div class="vm-ml-modal-alert" id="errormsg"></div>
                            <div class="vm-ml-modal-actions__grid">
                                <button type="button" value="Edit" class="btn vm-ml-modal-btn vm-ml-modal-btn--primary"><i class="fas fa-edit" aria-hidden="true"></i> Edit &amp; Update KYC</button>
                                <button type="button" value="SaveChange" class="btn vm-ml-modal-btn vm-ml-modal-btn--save One2" style="display:none;" data-loading-text="<i class='fa fa-spinner fa-spin'></i>"><i class="fas fa-save" aria-hidden="true"></i> Save Change</button>
                                <button type="button" value="Email_Verify" class="btn vm-ml-modal-btn vm-ml-modal-btn--outline" onclick="EmailVerify()"><i class="fas fa-envelope" aria-hidden="true"></i> Email Verify</button>
                                <button type="button" value="Delet" class="btn vm-ml-modal-btn vm-ml-modal-btn--danger" onclick="Deleteuser()"><i class="fas fa-trash-alt" aria-hidden="true"></i> Delete MD</button>
                            </div>
                            <div class="vm-ml-modal-alert vm-ml-modal-alert--error"><span id="error"></span></div>
                        </div>

                    </form>

                    <!--=============-->
                    <div class="second-form vm-ml-modal-form vm-ml-edit-kyc-form" style="display:none;">
                        @using (Ajax.BeginForm("Edit_master_dealer", "Home", new AjaxOptions { HttpMethod = "POST", InsertionMode = InsertionMode.Replace, UpdateTargetId = "Masterlistupdate", OnBegin = "chkvalidation", OnSuccess = "OnSuccess" }))
                        {
                            @Html.Hidden("ssid")
                            <div class="vm-ml-edit-kyc-head">
                                <h5><i class="fas fa-user-edit" aria-hidden="true"></i> Edit &amp; Update KYC</h5>
                                <p>Update profile details, verify documents and save changes</p>
                            </div>
                            <div class="vm-ml-modal-grid">
                            <div class="vm-ml-modal-field">
                                <label>Name</label>
                                @Html.TextBox("NameEdit", "", new { @class = "form-control", placeholder = "Enter Name", required = "required" })
                            </div>
                            <div class="vm-ml-modal-field">
                                <label>Firm Name</label>
                                @Html.TextBox("FirmEdit", "", new { @class = "form-control", placeholder = "Enter FirmName", required = "required" })
                            </div>
                            <div class="vm-ml-form-section-label"><i class="fas fa-id-card" aria-hidden="true"></i> KYC Documents</div>
                            <div class="vm-ml-modal-field vm-ml-kyc-field">
                                <label>Pancard <a href="https://www1.incometaxindiaefiling.gov.in/e-FilingGS/Services/VerifyYourPanDeatils.html?lang=eng" target="_blank" class="vm-ml-verify-link">Verify</a></label>
                                @Html.TextBox("pancardEdit", "", new { @class = "form-control", placeholder = "Enter Pancard No", maxlength = 10, minlength = 10 })
