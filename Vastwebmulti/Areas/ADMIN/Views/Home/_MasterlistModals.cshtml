                                    <div id="pandocshow" class="vm-ml-doc-actions__group">
                                        <button type="button" class="btn vm-ml-doc-btn" data-toggle="modal" data-target="#panviewdoc" title="View"><i class="fas fa-eye" aria-hidden="true"></i> View</button>
                                        <button type="button" class="btn vm-ml-doc-btn vm-ml-doc-btn--reject" title="Reject" onclick="Rejected('pan')"><i class="fas fa-times" aria-hidden="true"></i></button>
                                        <button type="button" class="btn vm-ml-doc-btn vm-ml-doc-btn--approve" id="panapproved" title="Approve" onclick="Approved('pan')"><i class="fa fa-check" aria-hidden="true"></i></button>
                                    </div>
                                    <div id="pandocnotshow">
                                        <span class="vm-ml-doc-badge vm-ml-doc-badge--missing"><i class="fas fa-file-excel" aria-hidden="true"></i> Doc Not Found</span>
                                    </div>
                                </div>
                            </div>
                            <div class="vm-ml-modal-field vm-ml-kyc-field">
                                <label>Aadhar Card <a href="https://resident.uidai.gov.in/verify" target="_blank" class="vm-ml-verify-link">Verify</a></label>
                                @Html.TextBox("AadhaarEdit", "", new { @class = "form-control", placeholder = "Enter Aadhaar Number", @style = "text-transform:uppercase", onkeypress = "return isNumber(event)", maxlength = "12", minlength = 12 })
                                <div class="vm-ml-doc-actions">
                                    <div id="aadhardocshow" class="vm-ml-doc-actions__group">
                                        <button type="button" class="btn vm-ml-doc-btn" data-toggle="modal" data-target="#aadharviewdoc" title="View"><i class="fas fa-eye" aria-hidden="true"></i> View</button>
                                        <button type="button" class="btn vm-ml-doc-btn vm-ml-doc-btn--reject" title="Reject" onclick="Rejected('aadhar')"><i class="fas fa-times" aria-hidden="true"></i></button>
                                        <button type="button" class="btn vm-ml-doc-btn vm-ml-doc-btn--approve" id="aadharapproved" title="Approve" onclick="Approved('aadhar')"><i class="fa fa-check" aria-hidden="true"></i></button>
                                    </div>
                                    <div id="aadhardocnotshow">
                                        <span class="vm-ml-doc-badge vm-ml-doc-badge--missing"><i class="fas fa-file-excel" aria-hidden="true"></i> Doc Not Found</span>
                                    </div>
                                </div>
                            </div>
                            <div class="vm-ml-modal-field vm-ml-kyc-field vm-ml-modal-field--full">
                                <label>GST Registration No <a href="https://services.gst.gov.in/services/searchtp" target="_blank" class="vm-ml-verify-link">Verify</a></label>
                                @Html.TextBox("gstEdit", "", new { @class = "form-control", placeholder = "Enter GST Registration No", @style = "text-transform:uppercase" })
                                <div class="vm-ml-doc-actions">
                                    <div id="gstdocshow" class="vm-ml-doc-actions__group">
                                        <button type="button" class="btn vm-ml-doc-btn" data-toggle="modal" data-target="#gstviewdoc" title="View"><i class="fas fa-eye" aria-hidden="true"></i> View</button>
                                        <button type="button" class="btn vm-ml-doc-btn vm-ml-doc-btn--reject" title="Reject" onclick="Rejected('gst')"><i class="fas fa-times" aria-hidden="true"></i></button>
                                        <button type="button" class="btn vm-ml-doc-btn vm-ml-doc-btn--approve" id="gstapproved" title="Approve" onclick="Approved('gst')"><i class="fa fa-check" aria-hidden="true"></i></button>
                                    </div>
                                    <div id="gstdocnotshow">
                                        <span class="vm-ml-doc-badge vm-ml-doc-badge--missing"><i class="fas fa-file-excel" aria-hidden="true"></i> Doc Not Found</span>
                                    </div>
                                </div>
                            </div>
                            <div class="vm-ml-modal-field vm-ml-kyc-field vm-ml-modal-field--full">
                                <label>Farm Agreement</label>
                                <input type="text" id="frmagrEdit" name="frmagrEdit" readonly class="form-control vm-ml-readonly-field vm-ml-status-field" />
                                <div class="vm-ml-doc-actions">
                                    <div id="frmagrdocshow" class="vm-ml-doc-actions__group">
                                        <button type="button" class="btn vm-ml-doc-btn" data-toggle="modal" data-target="#frmagrviewdoc" title="View"><i class="fas fa-eye" aria-hidden="true"></i> View</button>
                                        <button type="button" class="btn vm-ml-doc-btn vm-ml-doc-btn--reject" title="Reject" onclick="Rejected('Aggrement')"><i class="fas fa-times" aria-hidden="true"></i></button>
                                        <button type="button" class="btn vm-ml-doc-btn vm-ml-doc-btn--approve" id="frmagrapproved" title="Approve" onclick="Approved('Aggrement')"><i class="fa fa-check" aria-hidden="true"></i></button>
                                    </div>
                                    <div id="frmagrdocnotshow">
                                        <span class="vm-ml-doc-badge vm-ml-doc-badge--missing"><i class="fas fa-file-excel" aria-hidden="true"></i> Doc Not Found</span>
                                    </div>
                                </div>
                            </div>

                            <div class="vm-ml-form-section-label"><i class="fas fa-map-marker-alt" aria-hidden="true"></i> Location &amp; Settings</div>
                            <div class="vm-ml-modal-field">
                                <label>State</label>
                                <div class="vm-ml-select-wrap custom-district">
                                    <select id="StateEdit" onchange="Editstatechange()" name="StateEdit" class="form-control vm-ml-edit-select for-select2">
                                        <option value="">Select State</option>
                                    </select>
                                </div>
                            </div>
                            <div class="vm-ml-modal-field">
                                <label>District</label>
                                <div class="vm-ml-select-wrap custom-district">
                                    @Html.DropDownList("DistrictEdit",
                                        new SelectList(Enumerable.Empty<SelectListItem>(), "Dist_id", "Dist_Desc"),
                                        "Select district",
                                        new { @class = "form-control vm-ml-edit-select for-select2", data_live_search = "true" })
                                </div>
                            </div>
                            <div class="vm-ml-modal-field" id="roleShowNot">
                                <label>Financial Role</label>
                                <div id="DivEditddlrole" class="vm-ml-select-wrap custom-district">
                                    <select id="Editddlrole" name="Editddlrole" class="form-control vm-ml-edit-select for-select2" required="required">
                                        <option value="">Select Role</option>
                                        <option value="TeamManager">Team Manager</option>
                                        <option value="CommissionAgent">Commission Agent</option>
                                    </select>
                                </div>
                                <input type="text" readonly value="" class="form-control vm-ml-readonly-field" style="display:none;" id="Edittxtlrole" name="Edittxtlrole" />
                            </div>
                            <div class="vm-ml-modal-field">
                                <label>Pin Code</label>
                                @Html.TextBox("PinEdit", "", new { @class = "form-control", placeholder = "Enter Pin Code", @style = "text-transform:uppercase", required = "required" })
                            </div>
                            <div class="vm-ml-modal-field">
                                <label>Margine <span class="vm-ml-field-hint">(Offline)</span></label>
                                @Html.TextBox("offmargineEdit", "", new { @class = "form-control", placeholder = "Enter Offline Margine Value", @style = "text-transform:uppercase", required = "required", @onkeypress = "javascript:return isNumber(event)" })
                            </div>
                            <div class="vm-ml-modal-field">
                                <label>Capping <span class="vm-ml-field-hint">(Amount)</span></label>
                                @Html.TextBox("CappingEdit", "", new { @class = "form-control", placeholder = "Enter Capping Value", @style = "text-transform:uppercase", required = "required", @onkeypress = "javascript:return isNumber(event)" })
                            </div>
                            <div class="vm-ml-modal-field vm-ml-modal-field--full">
                                <label>Address</label>
                                @Html.TextArea("AddressEdit", "", new { @class = "form-control", placeholder = "Enter Address", @style = "text-transform:uppercase;height:72px", required = "required" })
                            </div>

                            <div class="vm-ml-modal-actions modal-footer width100 float-left button-seconddesign vm-ml-modal-actions--edit">
                                <div class="vm-ml-modal-actions__grid vm-ml-modal-actions__grid--single">
                                    <button type="button" class="btn vm-ml-modal-btn vm-ml-modal-btn--ghost vm-ml-back-to-view" onclick="vmMlBackToViewForm()"><i class="fas fa-arrow-left" aria-hidden="true"></i> Back to View</button>
                                    <button type="submit" value="SaveChange" class="btn vm-ml-modal-btn vm-ml-modal-btn--save One2" data-loading-text="<i class='fa fa-spinner fa-spin'></i>"><i class="fas fa-save" aria-hidden="true"></i> Save Change</button>
                                </div>
                            </div>
                            </div><!--vm-ml-modal-grid-->
                        }
                    </div>

                </div>
            </div><!--.modal-body-->


        </div>

    </div>
</div>

