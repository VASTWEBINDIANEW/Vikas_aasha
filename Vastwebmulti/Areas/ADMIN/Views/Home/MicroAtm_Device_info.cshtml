<style>
    /* Loading spinner used on the inline "Edit" button of the device table. */
    @@keyframes microatmspin111 {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    .editbutton-spinclass {
        width: 15px;
        height: 15px;
        border: 2px solid #aaa4a4;
        border-top-color: transparent;
        border-radius: 50%;
        animation: microatmspin111 2s linear infinite;
        display: none;
        float: left;
    }
</style>

<section class="content MicroAtmDevice_Page Ecommerce_Page saas-admin-account-page saas-admin-report-page saas-fund-transfer-page saas-fund-transfer-premium">
    <div class="container-fluid vm-ft-page-shell">
        <div class="vm-ft-page-toolbar vm-ft-page-toolbar--premium">
            <div class="vm-ft-page-hero">
                <ol class="vm-ft-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li><a href="@Url.Action("Dashboard", "Home")#setting">Basic Setting</a></li>
                    <li>M-ATM Device's</li>
                </ol>
            </div>
            <div class="vm-ft-search-wrap vm-matm-toolbar-actions">
                <a href="@Url.Action("Microatm_charge_list", "Home")" class="vm-matm-toolbar-btn"><i class="fas fa-list-ul" aria-hidden="true"></i>&nbsp;Charge List</a>
                <a href="@Url.Action("Admin_Microatm_rental_report", "Home")" class="vm-matm-toolbar-btn"><i class="fas fa-file-invoice" aria-hidden="true"></i>&nbsp;Rental Report</a>
                <input class="form-control" type="text" id="txtsearch" placeholder="Search devices..." autocomplete="off" />
            </div>
            <iframe id="txtArea1" style="display:none"></iframe>
        </div>

        <div class="col-md-12 vm-ft-layout-wrap">
            <div class="row clearfix vm-ft-layout vm-ft-layout--full">
                <div class="col-md-4 col-sm-12 col-xs-12 vm-ft-form-col">
                    <div class="fund-trasfer-left vm-ecom-left-card vm-ft-form-card">
                        <div class="vm-ft-form-card-header">
                            <div class="vm-ft-form-card-header__icon" aria-hidden="true"><i class="fas fa-sim-card"></i></div>
                            <div>
                                <span class="vm-ft-form-card-header__title">Device Info</span>
                                <span class="vm-ft-form-card-header__sub">Create a new M-ATM device</span>
                            </div>
                        </div>
                        <div id="tab-9" class="tab-content current" style="overflow-y:auto;">
                            @using (Ajax.BeginForm("Insert_microAtm_deviceinfo", new AjaxOptions { HttpMethod = "Post", UpdateTargetId = "devicelist_tbl", LoadingElementId = "div-loader" }))
                            {
                                <div class="ecommerce-left-first vm-ecom-form-panel">
                                    <div class="row clearfix">
                                        <div class="col-md-12 col-sm-12 col-xs-12 vm-ecom-field-row">
                                            <label class="vm-ecom-field-label" for="Remid">Retailer ID</label>
                                            <div class="vm-ecom-select-wrap">
                                                @Html.DropDownList("Remid", (IEnumerable<SelectListItem>)ViewBag.remid, "Select Retailerid", new { @class = "vm-ecom-select form-control", required = "required" })
                                            </div>
                                        </div>
                                    </div><!--.row-->
                                    <div class="row clearfix">
                                        <div class="col-md-12 col-sm-12 col-xs-12 vm-ecom-field-row">
                                            <label class="vm-ecom-field-label" for="deviceid">Device Name</label>
                                            <div class="vm-ecom-select-wrap">
                                                @Html.DropDownList("deviceid", (IEnumerable<SelectListItem>)ViewBag.deviceid, "Select deviceid", new { @class = "vm-ecom-select form-control", required = "required" })
                                            </div>
                                        </div>
                                    </div><!--.row-->

                                    <div class="row clearfix">
                                        <div class="col-md-12 col-sm-12 col-xs-12 vm-ecom-field-row">
                                            <label class="vm-ecom-field-label" for="plannm">Plan Name</label>
                                            <div class="vm-ecom-select-wrap">
                                                @Html.DropDownList("plannm", (IEnumerable<SelectListItem>)ViewBag.planchk, "Select PlanName", new { @class = "vm-ecom-select form-control", required = "required" })
                                            </div>
                                        </div>
                                    </div><!--.row-->
                                    <div class="row clearfix">
                                        <div class="col-md-12 col-sm-12 col-xs-12 vm-ecom-field-row">
                                            <label class="vm-ecom-field-label" for="chargetype">Plan Charge Type</label>
                                            <div class="vm-ecom-select-wrap">
                                                @Html.DropDownList("chargetype", new List<SelectListItem>
                                                 {
                                                  new SelectListItem{ Text="Daily",Value="Daily"},
                                                      new SelectListItem{Text="Monthly",Value="Monthly"}
                                                  }, new { @class = "vm-ecom-select form-control", required = "required" })
                                            </div>
                                        </div>
                                    </div><!--.row-->

                                    <div class="row clearfix">
                                        <div class="col-md-12 col-sm-12 col-xs-12 vm-ecom-field-row">
                                            <label class="vm-ecom-field-label" for="txt_frm_date">Start Date</label>
                                            <div class="input-daterange vm-matm-date-wrap">
                                                <div class="saas-acc-dp-field vm-matm-date-field">
                                                    <span class="saas-acc-dp-icon"><i class="fa fa-calendar" aria-hidden="true"></i></span>
                                                    @Html.TextBox("txt_frm_date", "", new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off" })
                                                </div>
                                            </div>
                                        </div>
                                    </div><!--.row-->

                                    <div id="lblSuccess">
                                        <label id="lblmsg1" class="danger vm-matm-msg vm-matm-msg--ok"></label>
                                    </div>
                                    <div id="lblerror">
                                        <label id="lblmsg" class="danger vm-matm-msg vm-matm-msg--err"></label>
                                    </div>

                                    <div class="row clearfix">
                                        <div class="col-md-12 col-sm-12 col-xs-12 vm-ecom-action-row">
                                            <button type="submit" class="fullbodydycolorbg insert-errorshow vm-ecom-btn-primary" style="color:#fff;"><i class="fas fa-plus" aria-hidden="true"></i>&nbsp;Insert Device</button>
                                            <button type="reset" class="vm-ecom-btn-secondary"><i class="fas fa-undo" aria-hidden="true"></i>&nbsp;Reset</button>
                                        </div>
                                    </div>
                                    <label id="error-mictigit"></label>
                                </div><!--.vm-ecom-form-panel-->
                            }
                        </div>
                    </div>
                </div>

                <div class="col-md-8 col-sm-12 col-xs-12 vm-ft-history-col">
                    <div class="vm-ecom-right-card fund-trasfer-right vm-ft-history-panel">
                        <div class="vm-ft-history-body">
                            <div class="vm-ft-history-toolbar vm-ft-history-toolbar--premium">
                                <div class="vm-ft-history-toolbar__head">
                                    <i class="fas fa-microchip" aria-hidden="true"></i>
                                    <div>
                                        <span class="vm-ft-history-toolbar__title">Device List</span>
                                        <span class="vm-ft-history-toolbar__sub">Manage every registered M-ATM device</span>
                                    </div>
                                </div>
                            </div>
                            <div class="table-responsive vm-ecom-table-wrap" id="devicelist_tbl">
                                @Html.Action("Get_allDeviceList")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div id="div-loader" style="display:none; position: fixed;top: 0px;background: rgba(0,0,0,.5);left: 0px;bottom: 0px;right: 0px;width: 100%;height: 100vh;z-index: 9999;">
        <div id="loader" style="position: absolute;right: 34%;top: 50%;display:block; transform: translate(-34%,-50%);">
            <div class="loadingio-spinner-ripple-92ar2pfqk5j" style="background:transparent;">
                <div class="ldio-zdyd6mf6t5">
                    <div></div><div></div>
                </div>
            </div>
        </div>
    </div>
</section>
