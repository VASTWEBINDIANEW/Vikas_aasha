<script src="~/select2/dist/js/select2.min.js"></script>
<!--Add State dropdown list-->


<script>
    $('.for-select2').select2();
</script>

<script>
    var ravi = $.noConflict()
    ravi(document).ready(function () {

        // Initialize select2
        ravi("select").select2();

        // Read selected option

            $('.input-daterange').datepicker({
            format: "yyyy-mm-dd",
            todayHighlight: true,
            autoclose: true,
            orientation: "bottom auto",

        });
        var val = '@ViewBag.chk';
        if (val != "post") {
            $("#txt_frm_date").datepicker("setDate", new Date());
            $("#txt_to_date").datepicker("setDate", new Date());
        }

    });
    $(document).ajaxComplete(function () {
        ravi("select").select2();
    });
</script>

<script>
    function initMatmDeviceEditRow() {
        var $wrap = $('#devicelist_tbl');
        if (!$wrap.length) {
            return;
        }

        var $ctype = $wrap.find('#chargetypeEdit');
        var ct = $wrap.find('#txtchargetype').val();
        if ($ctype.length && ct) {
            $ctype.val(ct);
        }

        var $frm = $wrap.find('#Frm_Name.for-select2');
        var uid = $wrap.find('#txtdevicenm').val();
        if ($frm.length && ravi.fn.select2) {
            if ($frm.data('select2')) {
                $frm.select2('destroy');
            }
            $frm.select2({
                width: '100%',
                minimumResultsForSearch: 6,
                dropdownParent: $wrap.closest('.vm-ft-history-body')
            });
            if (uid) {
                $frm.val(uid).trigger('change');
            }
        }
    }

    function Editbyamount(e) {
        $("#microloader_" + e).show();
        $("#editmicro_" + e).hide();
        $.ajax({
            type: 'POST',
            url: '@Url.Action("Check_DevicelistByid", "Home")',
            data: { idno: e },
            success: function (result) {
                $('#devicelist_tbl').html(result);
                initMatmDeviceEditRow();
            },
            complete: function () {
                $("#microloader_" + e).hide();
                $("#editmicro_" + e).show();
            }
        });
    }
</script>

<script>
    function Savebyamount(e) {
        var $wrap = $('#devicelist_tbl');
        var userid = $wrap.find('#Frm_Name').val();
        var ctype = $wrap.find('#chargetypeEdit').val();
        var $btn = $wrap.find('.vm-matm-save-btn');

        $btn.prop('disabled', true);

        $.ajax({
            type: 'POST',
            url: '@Url.Action("Edit_Get_All_Devicelist", "Home")',
            data: { idno: e, userid: userid, ctype: ctype },
            success: function (result) {
                $wrap.html(result);
            },
            complete: function () {
                $btn.prop('disabled', false);
            }
        });
    }
</script>

<script>
    $(document).ready(function () {
        $("#txtsearch").on("keyup", function () {

            var value = $(this).val().toLowerCase();
            $("#body .tr").filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
            });
        });
    });
</script>
