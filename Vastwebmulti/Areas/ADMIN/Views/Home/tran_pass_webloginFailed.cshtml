@using Newtonsoft.Json
@{
    ViewBag.Title = "Web Failed Login";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var msgError = ViewData["MSG"] as string ?? "";
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-high-security-gate.css?v=1" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-app-login-history-modern.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-app-login-history-mobile.css?v=3" rel="stylesheet" />

<div id="loadermoney" class="vm-hs-gate-loader" style="display:none;" aria-hidden="true"></div>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-app-login-report-page saas-web-failed-pass-page">
    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
            <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>Login Reports</li>
                    <li>Web Failed Login</li>
                </ol>
                <div class="vm-dmt-fin-nav-row vm-login-report-nav-row">
                    @Html.Partial("_loginReportNav")
                </div>
            </div>
        </div>

        <div class="vm-opr-main-card vm-web-failed-pass-main">
            <div class="vm-web-failed-pass-shell">
                <div class="vm-hs-gate-card vm-web-failed-pass-card" role="dialog" aria-modal="true" aria-labelledby="webFailedPassTitle">
                    <div class="vm-hs-gate-header">
                        <div class="vm-hs-gate-header__icon"><i class="fas fa-lock" aria-hidden="true"></i></div>
                        <h2 class="vm-hs-gate-header__title" id="webFailedPassTitle">Transaction Password</h2>
                        <p class="vm-hs-gate-header__sub">Enter your transaction password to view web failed login history.</p>
                    </div>
                    <div class="vm-hs-gate-body">
                        @using (Html.BeginForm("tran_pass_webloginFailed", "Home", FormMethod.Post, new { id = "Formsubmit" }))
                        {
                            if (!string.IsNullOrWhiteSpace(msgError))
                            {
                                <p class="vm-hs-gate-message vm-hs-gate-message--error">@msgError</p>
                            }

                            <div class="vm-hs-gate-field">
                                <label for="txtcode">Transaction password</label>
                                <div class="vm-hs-gate-input-wrap">
                                    <i class="fas fa-key" aria-hidden="true"></i>
                                    <input type="password" id="txtcode" name="txtcode" class="form-control vm-hs-gate-input" autocomplete="off" placeholder="Enter transaction password" />
                                </div>
                                <p id="errormsg" class="vm-hs-gate-field-error"></p>
                            </div>

                            <div class="vm-hs-gate-actions vm-hs-gate-actions--split">
                                <a href="@Url.Action("Dashboard", "Home")" class="vm-hs-gate-btn vm-hs-gate-btn--ghost">
                                    <i class="fas fa-home" aria-hidden="true"></i> Back to home
                                </a>
                                <button type="button" id="btn" class="vm-hs-gate-btn vm-hs-gate-btn--primary" onclick="showloader()">
                                    <i id="loaderfa" class="" aria-hidden="true"></i>
                                    <span id="submitbtn">Proceed now</span>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    $(document).ready(function () {
        var errormsgval = @Html.Raw(JsonConvert.SerializeObject(msgError ?? ""));
        if (errormsgval) {
            $("#loaderfa").removeClass("fa fa-circle-o-notch fa-spin");
        }
    });

    function showloader() {
        var txtcode = $("#txtcode").val();

        if (txtcode != null && txtcode != "") {
            $("#loaderfa").addClass("fa fa-circle-o-notch fa-spin");
            document.getElementById("btn").disabled = true;
            document.getElementById("submitbtn").style.display = "none";
            document.getElementById("Formsubmit").submit();
        } else {
            document.getElementById("errormsg").innerHTML = "Please enter transaction password";
            $("#loaderfa").removeClass("fa fa-circle-o-notch fa-spin");
        }
    }
</script>
