@model Vastwebmulti.Areas.ADMIN.Models.SchduleFundInfo
<table class="table vm-ml-data-table">
        <thead>
            <tr>
                <th>API Name</th>
                <th>Amount</th>
                <th>Mode</th>
                <th>Min Fund</th>
                <th>Max Hours</th>
                <th>Time</th>
                <th>Schedule Frequency</th>
                <th>Daily Frequency</th>
                <th>Status</th>
                <th>Del</th>
            </tr>
        </thead>
        <tbody>
            @{ var hasScheduleRows = false; }
            @if (Model.infoaccount_Schdule != null)
            {
                foreach (var item in Model.infoaccount_Schdule)
                {
                    hasScheduleRows = true;
                    var mode = "";
                    var scfree = "";
                    var dailysch = "";

                    if (item.type == "LOWBAL") { mode = "Low Alert Basis"; }
                    else if (item.type == "TIME") { mode = "Timing Basis"; }

                    string time = Convert.ToDateTime(item.timeset).ToShortTimeString();
                    if (item.type == "LOWBAL") { time = ""; }

                    if (item.schdulefre == 1) { scfree = "Daily"; }
                    else if (item.schdulefre == 3) { scfree = "2 Days Gap"; }
                    else if (item.schdulefre == 7) { scfree = "1 Week"; }
                    else if (item.schdulefre == 30) { scfree = "1 Month"; }

                    if (item.dailysch == 1) { dailysch = "One Time"; }
                    else if (item.dailysch == 2) { dailysch = "Two Time"; }
                    else if (item.dailysch == 3) { dailysch = "Three Time"; }
                    else if (item.dailysch == 4) { dailysch = "Four Time"; }

                    <tr>
                        <td>@item.Apiname</td>
                        <td>@item.amount</td>
                        <td>@mode</td>
                        <td>@item.minfund</td>
                        <td>@item.maxhours</td>
                        <td>@time</td>
                        <td>@scfree</td>
                        <td>@dailysch</td>
                        <td class="ap-col-action">
                            @if (item.status == "Y")
                            {
                                <button type="button" class="ap-io-switch ap-io-switch--on" data-action="sch-status" data-apinm="@item.Apiname" data-mode="@item.type" title="Active — click to deactivate" aria-label="Deactivate schedule">
                                    <span class="ap-io-switch__track"><span class="ap-io-switch__thumb"></span></span>
                                    <span class="ap-io-switch__text">On</span>
                                </button>
                            }
                            else
                            {
                                <button type="button" class="ap-io-switch ap-io-switch--off" data-action="sch-status" data-apinm="@item.Apiname" data-mode="@item.type" title="Inactive — click to activate" aria-label="Activate schedule">
                                    <span class="ap-io-switch__track"><span class="ap-io-switch__thumb"></span></span>
                                    <span class="ap-io-switch__text">Off</span>
                                </button>
                            }
                        </td>
                        <td class="ap-col-action">
                            <button type="button" class="ap-icon-del" data-action="sch-delete" data-apinm="@item.Apiname" data-mode="@item.type" title="Delete schedule" aria-label="Delete schedule">
                                <i class="fas fa-trash-alt" aria-hidden="true"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
            @if (!hasScheduleRows)
            {
                <tr class="ap-empty-row">
                    <td colspan="10">No schedule records found.</td>
                </tr>
            }
        </tbody>
    </table>

<script>
    function success2() {
        var mshh = '@Model.msg';
        if (mshh == "NotAllow") {
            $('#schdulelable').text("Same Information Not Allow");
        }
        $('#resetallschdu').click();
        if (typeof apOpenRightTab === 'function') {
            apOpenRightTab('tab-9');
        } else {
            $('#tab9').click();
        }
    }
    function fail2() {
        alert("error");
    }
</script>
<script>
    function statusupdate_sch(apinm, mode) {
        $.ajax({
            url: '@Url.Action("Update_sch_sts", "Home")',
            type: "POST",
            data: { Apinm: apinm, mode: mode },
            cache: false,
            success: function (data2) {
                $('#apScheduleTableHost').html(data2);
            }
        });
    }
    function del1(apinm, mode) {
        $.ajax({
            url: '@Url.Action("del_schinfo", "Home")',
            type: "POST",
            data: { Apinm: apinm, mode: mode },
            cache: false,
            success: function (data2) {
                $('#apScheduleTableHost').html(data2);
            }
        });
    }
</script>
