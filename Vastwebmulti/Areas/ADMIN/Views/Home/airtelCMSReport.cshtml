@model List<Vastwebmulti.Models.Airtel_Report_paging_Result>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "airtelCMSReport";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
    var reports = Model ?? new List<Vastwebmulti.Models.Airtel_Report_paging_Result>();
    var rowCount = reports.Count;
    var totalSuccess = reports.Count(i => string.Equals(i.sts, "Success", StringComparison.OrdinalIgnoreCase) || string.Equals(i.sts, "SUCCESS", StringComparison.OrdinalIgnoreCase));
    var totalPending = reports.Count(i => string.Equals(i.sts, "Pending", StringComparison.OrdinalIgnoreCase) || string.Equals(i.sts, "PENDING", StringComparison.OrdinalIgnoreCase));
    var totalFailed = reports.Count(i => string.Equals(i.sts, "Failed", StringComparison.OrdinalIgnoreCase) || string.Equals(i.sts, "FAILED", StringComparison.OrdinalIgnoreCase));
    var totalRefund = reports.Count(i => !string.Equals(i.sts, "Success", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(i.sts, "SUCCESS", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(i.sts, "Pending", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(i.sts, "PENDING", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(i.sts, "Failed", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(i.sts, "FAILED", StringComparison.OrdinalIgnoreCase));
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=40" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=25" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-cms-report-status.css?v=1" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />

<style>
    body.saas-admin-ui .saas-airtel-cms-report-page.saas-dmt-report-page .vm-dmt-filter-row .vm-airtel-cms-consumer-input,
    body.saas-admin-ui .saas-airtel-cms-report-page.saas-dmt-report-page .vm-dmt-filter-search-group #airtelCmsConsumerNo {
        display: block;
        width: 100%;
        height: 38px;
        min-height: 38px;
        border: 1px solid #dbe4f0;
        border-radius: 9px;
        background: #fff !important;
        background-color: #fff !important;
        background-image: none !important;
        background-repeat: no-repeat !important;
        background-position: initial !important;
        background-size: auto !important;
        padding: 0 12px !important;
        font-size: 0.82rem;
        font-weight: 600;
        color: #334155;
        box-sizing: border-box;
        box-shadow: inset 0 1px 2px rgba(15, 23, 42, 0.04);
        appearance: none !important;
        -webkit-appearance: none !important;
        cursor: text !important;
    }

    body.saas-admin-ui .saas-airtel-cms-report-page.saas-dmt-report-page .vm-dmt-filter-row .vm-airtel-cms-consumer-input:focus,
    body.saas-admin-ui .saas-airtel-cms-report-page.saas-dmt-report-page .vm-dmt-filter-search-group #airtelCmsConsumerNo:focus {
        border-color: #2563eb;
        outline: none;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }

    body.saas-admin-ui .saas-airtel-cms-report-page .vm-dmt-filter-search-group .vm-dmt-field--search {
        flex: 1 1 180px;
        min-width: 140px;
        max-width: 220px;
    }

    body.saas-admin-ui .saas-airtel-cms-report-page #airtelCmsConsumerNo::-webkit-calendar-picker-indicator,
    body.saas-admin-ui .saas-airtel-cms-report-page #airtelCmsConsumerNo::-webkit-list-button,
    body.saas-admin-ui .saas-airtel-cms-report-page #airtelCmsConsumerNo::-webkit-inner-spin-button {
        display: none !important;
    }
</style>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-airtel-cms-report-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var airtelCmsFormAttrs = new Dictionary<string, object>
            {
                { "id", "airtelCmsReportForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("airtelCMSReport", "Home", FormMethod.Post, airtelCmsFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Report's</li>
                        <li>Airtel CMS Report</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters vm-ecomm-filter-row--one-line">

                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("status", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "ALL Status", Value = "" },
                                new SelectListItem { Text = "SUCCESS", Value = "Success" },
                                new SelectListItem { Text = "Pending", Value = "Pending" },
                                new SelectListItem { Text = "FAILED", Value = "Failed" }
                            }, new { @id = "status", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("Retailers", ViewBag.Retailers as SelectList, "All Retailers", new { id = "Retailers", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div class="vm-dmt-filter-search-group">
                            <div class="vm-opr-field vm-dmt-field vm-dmt-field--search">
                                <input type="text"
                                       name="search"
                                       id="airtelCmsConsumerNo"
                                       class="vm-airtel-cms-consumer-input"
                                       placeholder="Consumer Number"
                                       title="Consumer Number"
                                       autocomplete="off"
                                       style="background-image:none !important; cursor:text !important; padding-right:12px !important;"
                                       value="@(Request["search"] ?? "")" />
                            </div>

                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                            </div>

                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                            </div>

                            <button type="submit" name="btntype" value="LIVE" id="btntype" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="airtelCmsTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Airtel CMS totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideAirtelCmsTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--primary">
                            <span class="vm-opr-total-card__label">Total Records</span>
                            <strong class="vm-opr-total-card__value">@rowCount</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Success</span>
                            <strong class="vm-opr-total-card__value">@totalSuccess</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Failed</span>
                            <strong class="vm-opr-total-card__value">@totalFailed</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Pending</span>
                            <strong class="vm-opr-total-card__value">@totalPending</strong>
                        </div>
                        @if (totalRefund > 0)
                        {
                            <div class="vm-opr-total-card">
                                <span class="vm-opr-total-card__label">Refund</span>
                                <strong class="vm-opr-total-card__value">@totalRefund</strong>
                            </div>
                        }
                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card vm-airtel-cms-main-card">
            <div class="vm-opr-table-panel vm-airtel-cms-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-file-invoice-dollar" aria-hidden="true"></i>
                        <span>Airtel CMS report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong>@rowCount</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-airtel-cms-totals-btn" onclick="toggleAirtelCmsTotals()" title="Show totals" aria-expanded="false" aria-controls="airtelCmsTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll" id="airtelCmsReportExportWrap">
                        <table id="airtelCmsReportTable" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Status</th>
                                    <th>Retailer&nbsp;Firm</th>
                                    <th>Operator</th>
                                    <th>Number</th>
                                    <th>Amount</th>
                                    <th>Operator&nbsp;Id</th>
                                    <th>Request&nbsp;Time</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (rowCount == 0)
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="8" class="vm-opr-table-empty vm-dmt-table-empty">
                                            <i class="fas fa-file-invoice-dollar" aria-hidden="true"></i>
                                            <span>No Airtel CMS records found.</span>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var item in reports)
                                    {
                                        var reqTimeText = item.req_time.HasValue ? item.req_time.Value.ToString("yyyy-MM-dd HH:mm:ss") : "—";
                                        var amountText = item.amount.HasValue ? item.amount.Value.ToString("N2") : "—";

                                        <tr class="vm-auto-fund-row">
                                            <td>
                                                @Html.Partial("_ReportStatusBadge", item.sts, new ViewDataDictionary(ViewData) { { "AllowRefund", true } })
                                            </td>
                                            <td>
                                                <div class="vm-auto-fund-firm">
                                                    <strong>@item.RetailerFirm</strong>
                                                    @if (!string.IsNullOrWhiteSpace(item.RetailerMobile))
                                                    {
                                                        <span> - @item.RetailerMobile</span>
                                                    }
                                                </div>
                                            </td>
                                            <td>@item.optcode</td>
                                            <td>@item.number</td>
                                            <td>@amountText</td>
                                            <td>@item.operatorId</td>
                                            <td>@reqTimeText</td>
                                            <td></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<script src="~/MainFrontDesign/select2/dist/js/select2.full.min.js"></script>

<script>
    function hideAirtelCmsTotals() {
        var $panel = $('#airtelCmsTotalsPanel');
        var $btn = $('.vm-airtel-cms-totals-btn');
        $panel.hide().attr('aria-hidden', 'true');
        $btn.attr('aria-expanded', 'false');
    }

    function toggleAirtelCmsTotals() {
        var $panel = $('#airtelCmsTotalsPanel');
        var $btn = $('.vm-airtel-cms-totals-btn');
        if ($panel.is(':visible')) {
            hideAirtelCmsTotals();
            return;
        }
        $panel.show().attr('aria-hidden', 'false');
        $btn.attr('aria-expanded', 'true');
    }

    function exportAirtelCmsTable(type) {
        var table = document.getElementById('airtelCmsReportTable');
        if (!table) {
            return;
        }

        var stamp = new Date().toISOString().slice(0, 10);
        var title = 'Airtel CMS Report';
        var clone = table.cloneNode(true);
        var emptyRow = clone.querySelector('.vm-opr-table-empty-row');
        if (emptyRow) {
            alert('No data available to export.');
            return;
        }

        if (type === 'excel') {
            var excelHtml = '<html><head><meta charset="utf-8"></head><body>' + clone.outerHTML + '</body></html>';
            var blob = new Blob(['\ufeff', excelHtml], { type: 'application/vnd.ms-excel' });
            var link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'AirtelCMSReport_' + stamp + '.xls';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            return;
        }

        var printWin = window.open('', '_blank');
        if (!printWin) {
            alert('Please allow pop-ups to export PDF.');
            return;
        }
        printWin.document.write(
            '<html><head><title>' + title + '</title>'
            + '<style>body{font-family:Arial,sans-serif;padding:16px}h3{margin:0 0 12px}table{border-collapse:collapse;width:100%;font-size:10px}th,td{border:1px solid #ccc;padding:4px;text-align:left}th{background:#f3f4f6}</style>'
            + '</head><body><h3>' + title + '</h3>' + clone.outerHTML + '</body></html>'
        );
        printWin.document.close();
        printWin.focus();
        printWin.print();
    }

    function initAirtelCmsSelect2() {
        if (!$.fn.select2) {
            return;
        }
        $('#status, #Retailers').select2({
            width: '100%',
            minimumResultsForSearch: 8
        });
    }

    function initAirtelCmsDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initAirtelCmsDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm('#airtelCmsReportForm');
        }
    }

    $(document).ready(function () {
        initAirtelCmsSelect2();
        initAirtelCmsDatepickers();
        $('#airtelCmsReportForm .select2-container').css('width', '100%');

        $('#btnExport').on('click', function () {
            exportAirtelCmsTable('excel');
        });
        $('#btnPDF').on('click', function () {
            exportAirtelCmsTable('pdf');
        });
    });
</script>
