@model Vastwebmulti.Areas.ADMIN.Models.Vandorlist
@{
    var vendorList = (Model != null && Model.Vendor_list != null)
                     ? Model.Vendor_list.ToList()
                     : new System.Collections.Generic.List<Vastwebmulti.Models.Vendor_Select_Details_Result>();
}

<!-- ===== Table ===== -->
<div class="table-responsive vm-ml-table-scroll saas-acc-table-wrap">
<table class="table table-bordered saas-acc-table vm-ml-data-table third-design-table" id="mdList">
    <thead>
        <tr>
            <th>Sr</th>
            <th>User&nbsp;Firm</th>
            <th>User&nbsp;Name</th>
            <th>Mobile&nbsp;No</th>
            <th>PAN&nbsp;No</th>
            <th>Email&nbsp;V/F</th>
        </tr>
    </thead>
    <tbody id="body">
        @if (vendorList.Any())
        {
            int id = 1;
            foreach (var item in vendorList)
            {
                <tr class="tr">
                    <td>@id</td>
                    <td><strong>@item.Firmname</strong></td>
                    <td>@item.Name</td>
                    <td style="font-weight:600;">@item.mobile</td>
                    <td>@item.pancardnumber</td>
                    <td>
                        <span style="display:inline-flex;align-items:center;gap:4px;">
                            @if (item.EmailConfirmed == true)
                            {
                                <span class="wl-badge wl-badge--done"><i class="fas fa-envelope-open" style="margin-right:3px;"></i>Done</span>
                            }
                            else
                            {
                                <span class="wl-badge wl-badge--due"><i class="fas fa-envelope" style="margin-right:3px;"></i>Due</span>
                            }
                            <button class="wl-detail-btn js-vendor-open-modal" data-vendorid="@item.userid" title="View Details">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </span>
                    </td>
                </tr>
                id++;
            }
        }
        else
        {
            <tr>
                <td colspan="6" style="text-align:center;padding:32px;color:#94a3b8;">
                    <i class="fas fa-store" style="font-size:2rem;display:block;margin-bottom:8px;opacity:.4;"></i>
                    No sellers found
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

<!-- ===== Vendor Detail / Edit Modal ===== -->
<div class="modal fade wl-modal mastetr222Modal" id="defaultModal222" tabindex="-1" role="dialog" aria-labelledby="vendorModalTitle">
    <div class="modal-dialog" role="document">
        <div class="modal-content">

            <!-- Header -->
            <div class="wl-modal-header">
                <div class="wl-modal-header__left">
                    <div class="wl-modal-header__icon"><i class="fas fa-store"></i></div>
                    <div>
                        <div class="wl-modal-header__label">Seller</div>
                        <div class="wl-modal-header__balance" id="vendorModalTitle">Seller Details</div>
                    </div>
                </div>
                <button type="button" class="wl-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times"></i></button>
            </div>

            <!-- Profile strip -->
            <div class="wl-modal-profile">
                <img src="~/AdminDesign/images/user.png" class="wl-modal-avatar" alt="User" />
                <div class="wl-modal-profile__info">
                    <div class="wl-modal-profile__name"><span id="Names"></span></div>
                    <div class="wl-modal-profile__firm"><i class="fas fa-building" style="margin-right:4px;color:#94a3b8;"></i><span id="FirmName"></span></div>
                    <div class="wl-modal-profile__date"><i class="far fa-clock" style="margin-right:4px;"></i><span id="RegisteredDate"></span></div>
                </div>
                <span id="error" class="wl-modal-profile__error"></span>
            </div>

            <!-- Body -->
            <div class="wl-modal-body">

                <!-- Hidden fields accessible from both forms -->
                <input type="hidden" id="venderid" value="" />
                <input type="hidden" id="venderiddelete" value="" />

                <!-- VIEW form (read-only) -->
                <form class="first-form">
                    <input type="hidden" id="venderidshow" value="" />

                    <div class="wl-view-row">
                        <div class="wl-view-field">
                            <div class="wl-view-field__label"><i class="fas fa-envelope" style="margin-right:3px;"></i>Email</div>
                            <div class="wl-view-field__val" id="view_Email">—</div>
                        </div>
                        <div class="wl-view-field">
                            <div class="wl-view-field__label"><i class="fas fa-id-card" style="margin-right:3px;"></i>PAN Card</div>
                            <div class="wl-view-field__val" id="view_Pan">—</div>
                        </div>
                        <div class="wl-view-field">
                            <div class="wl-view-field__label"><i class="fas fa-fingerprint" style="margin-right:3px;"></i>Aadhaar</div>
                            <div class="wl-view-field__val" id="view_Aadhar">—</div>
                        </div>
                        <div class="wl-view-field">
                            <div class="wl-view-field__label"><i class="fas fa-hashtag" style="margin-right:3px;"></i>GST No</div>
                            <div class="wl-view-field__val" id="view_GST">—</div>
                        </div>
                        <div class="wl-view-field">
                            <div class="wl-view-field__label"><i class="fas fa-map-pin" style="margin-right:3px;"></i>Pin Code</div>
                            <div class="wl-view-field__val" id="view_Pin">—</div>
                        </div>
                        <div class="wl-view-field">
                            <div class="wl-view-field__label"><i class="fas fa-map" style="margin-right:3px;"></i>State</div>
                            <div class="wl-view-field__val" id="view_State">—</div>
                        </div>
                        <div class="wl-view-field">
                            <div class="wl-view-field__label"><i class="fas fa-city" style="margin-right:3px;"></i>District</div>
                            <div class="wl-view-field__val" id="view_District">—</div>
                        </div>
                    </div>
                    <div class="wl-view-field" style="margin-top:8px;">
                        <div class="wl-view-field__label"><i class="fas fa-location-arrow" style="margin-right:3px;"></i>Address</div>
                        <div class="wl-view-field__val" id="view_Address">—</div>
                    </div>

                    <!-- View mode footer -->
                    <div class="wl-modal-footer">
                        <ul>
                            <li class="one">
                                <button type="button" value="Edit" class="wl-mf-btn wl-mf-btn--edit"><i class="fas fa-edit"></i> Edit</button>
                            </li>
                            <li class="three">
                                <button type="button" value="Email_Verify" class="wl-mf-btn wl-mf-btn--verify" onclick="EmailVerify()"><i class="fas fa-envelope-open-text"></i> Verify Email</button>
                            </li>
                            <li class="four">
                                <button type="button" value="Delet" class="wl-mf-btn wl-mf-btn--delete" onclick="Deleteuser()"><i class="fas fa-trash-alt"></i> Delete</button>
                            </li>
                        </ul>
                    </div>
                </form>

                <!-- EDIT form -->
                <div class="second-form" style="display:none;">
                    @using (Ajax.BeginForm("Edit_Vendoruser", "Home", new AjaxOptions { InsertionMode = InsertionMode.Replace, HttpMethod = "POST", OnBegin = "chkvalidation", UpdateTargetId = "vendorlisttable", OnSuccess = "OnSuccess" }))
                    {
                        @Html.Hidden("venderid", "", new { id = "edit_venderid" })

                        <div class="wl-modal-section-label"><i class="fas fa-user-edit" style="margin-right:5px;"></i>Edit Seller Details</div>
                        <div class="wl-edit-grid">
                            <div class="wl-edit-field">
                                <div class="wl-edit-field__icon wl-icon--blue"><i class="fas fa-user"></i></div>
                                <div class="wl-edit-field__body">
                                    <label>Name</label>
                                    @Html.TextBox("NameEdit", "", new { @class = "form-control", placeholder = "Enter Name", required = "required" })
                                </div>
                            </div>
                            <div class="wl-edit-field">
                                <div class="wl-edit-field__icon wl-icon--purple"><i class="fas fa-building"></i></div>
                                <div class="wl-edit-field__body">
                                    <label>Firm Name</label>
                                    @Html.TextBox("FirmEdit", "", new { @class = "form-control", placeholder = "Enter Firm Name", required = "required" })
                                </div>
                            </div>
                            <div class="wl-edit-field">
                                <div class="wl-edit-field__icon wl-icon--orange"><i class="fas fa-id-card"></i></div>
                                <div class="wl-edit-field__body">
                                    <label>PAN Card</label>
                                    @Html.TextBox("pancardEdit", "", new { @class = "form-control upper-case", placeholder = "PAN Card No", maxlength = "10" })
                                </div>
                            </div>
                            <div class="wl-edit-field">
                                <div class="wl-edit-field__icon wl-icon--green"><i class="fas fa-fingerprint"></i></div>
                                <div class="wl-edit-field__body">
                                    <label>Aadhaar Card</label>
                                    @Html.TextBox("AadhaarEdit", "", new { @class = "form-control", placeholder = "Aadhaar Number", onkeypress = "return isNumber(event)", maxlength = "12" })
                                </div>
                            </div>
                            <div class="wl-edit-field">
                                <div class="wl-edit-field__icon wl-icon--teal"><i class="fas fa-hashtag"></i></div>
                                <div class="wl-edit-field__body">
                                    <label>GST Number</label>
                                    @Html.TextBox("gstEdit", "", new { @class = "form-control upper-case", placeholder = "GST Number", maxlength = "15" })
                                </div>
                            </div>
                            <div class="wl-edit-field">
                                <div class="wl-edit-field__icon wl-icon--red"><i class="fas fa-map-pin"></i></div>
                                <div class="wl-edit-field__body">
                                    <label>Pin Code</label>
                                    @Html.TextBox("PinEdit", "", new { @class = "form-control", placeholder = "Pin Code", required = "required" })
                                </div>
                            </div>
                            <div class="wl-edit-field">
                                <div class="wl-edit-field__icon wl-icon--teal"><i class="fas fa-map"></i></div>
                                <div class="wl-edit-field__body">
                                    <label>State</label>
                                    <select id="StateEdit" onchange="Editstatechange()" name="StateEdit" class="form-control">
                                        <option value="">Select State</option>
                                    </select>
                                </div>
                            </div>
                            <div class="wl-edit-field">
                                <div class="wl-edit-field__icon wl-icon--slate"><i class="fas fa-city"></i></div>
                                <div class="wl-edit-field__body">
                                    <label>District</label>
                                    @Html.DropDownList("DistrictEdit", new SelectList(Enumerable.Empty<SelectListItem>(), "Dist_id", "Dist_Desc"), "Select district", new { @class = "form-control" })
                                </div>
                            </div>
                        </div>
                        <div class="wl-edit-field wl-edit-field--full" style="margin-top:8px;">
                            <div class="wl-edit-field__icon wl-icon--slate"><i class="fas fa-location-arrow"></i></div>
                            <div class="wl-edit-field__body">
                                <label>Address</label>
                                @Html.TextArea("AddressEdit", "", new { @class = "form-control", placeholder = "Enter Address", required = "required", rows = "2" })
                            </div>
                        </div>

                        <div id="vendor-edit-errmsg" style="margin:6px 0;font-size:.8rem;color:#dc2626;"></div>

                        <!-- Edit form footer -->
                        <div class="wl-modal-footer">
                            <ul>
                                <li>
                                    <button type="button" class="wl-mf-btn wl-mf-btn--back js-vendor-back"><i class="fas fa-arrow-left"></i> Back</button>
                                </li>
                                <li>
                                    <button type="submit" value="SaveChange" class="wl-mf-btn wl-mf-btn--save">
                                        <i class="fas fa-save"></i> Save Changes
                                    </button>
                                </li>
                            </ul>
                        </div>
                    }
                </div>

            </div><!-- /.wl-modal-body -->
        </div><!-- /.modal-content -->
    </div><!-- /.modal-dialog -->
</div><!-- /#defaultModal222 -->

<!-- ===== OTP Confirmation Modal ===== -->
<div id="otpmodal" class="modal fade wl-modal" role="dialog" tabindex="-1">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="wl-modal-header">
                <div class="wl-modal-header__left">
                    <div class="wl-modal-header__icon" style="background:#dc2626;"><i class="fas fa-trash-alt"></i></div>
                    <div>
                        <div class="wl-modal-header__label">Confirm Delete</div>
                        <div class="wl-modal-header__balance">Enter OTP to confirm</div>
                    </div>
                </div>
                <button type="button" class="wl-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times"></i></button>
            </div>
            <div class="wl-modal-body">
                @using (Ajax.BeginForm("ConfirmDeleteVendorOTP", "Home", new AjaxOptions { HttpMethod = "POST", UpdateTargetId = "vendorlisttable", OnSuccess = "OnSuccessconfirm", OnFailure = "OnFailureotperror" }))
                {
                    @Html.Hidden("venderiddelete", "", new { id = "otp_venderiddelete" })
                    <div class="wl-edit-field wl-edit-field--full">
                        <div class="wl-edit-field__icon wl-icon--red"><i class="fas fa-key"></i></div>
                        <div class="wl-edit-field__body">
                            <label>OTP</label>
                            @Html.TextBox("Deleteotp", "", new { @class = "form-control", placeholder = "Enter OTP", required = "required" })
                        </div>
                    </div>
                    <span id="otpwrong" style="color:#dc2626;font-size:.8rem;display:block;margin-top:4px;"></span>
                    <div class="wl-modal-footer" style="margin-top:10px;">
                        <ul>
                            <li>
                                <button type="button" class="wl-mf-btn wl-mf-btn--back" data-dismiss="modal"><i class="fas fa-times"></i> Cancel</button>
                            </li>
                            <li>
                                <button type="submit" class="wl-mf-btn wl-mf-btn--delete"><i class="fas fa-trash-alt"></i> Delete User</button>
                            </li>
                        </ul>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    /* -- Move modals to <body> so they are never clipped by overflow -- */
    $(function () {
        $('#defaultModal222').appendTo('body');
        $('#otpmodal').appendTo('body');
    });

    /* -- Arrow button opens detail modal -- */
    $(document).off('click.vendorModal').on('click.vendorModal', '.js-vendor-open-modal', function () {
        var vid = $(this).data('vendorid');
        mdActionBtn(vid);
    });

    /* -- Edit / Back toggle -- */
    $(document).off('click.vendorEdit').on('click.vendorEdit', '.mastetr222Modal button[value="Edit"]', function () {
        $('.mastetr222Modal .first-form').hide();
        $('.mastetr222Modal .second-form').show();
    });
    $(document).off('click.vendorBack').on('click.vendorBack', '.js-vendor-back', function () {
        $('.mastetr222Modal .second-form').hide();
        $('.mastetr222Modal .first-form').show();
    });
</script>

<script>
    /* -- Load vendor data into modal -- */
    function mdActionBtn(venderid) {
        $.ajax({
            url: '@Url.Action("VendorBYIdSearch","Home")',
            type: "POST",
            data: { venderid: venderid },
            cache: false,
            success: function (data2) {
                $('#error').text("");
                /* Reset to view mode */
                $('.mastetr222Modal .first-form').show();
                $('.mastetr222Modal .second-form').hide();

                var row = data2.list[0];
                var createddate = '—';
                if (row.joindate) {
                    var date = new Date(parseInt(row.joindate.match(/\d+/)[0]));
                    createddate = converttoDate(date);
                }

                /* Hidden IDs */
                $('#venderid').val(row.userid);
                $('#venderiddelete').val(row.userid);
                $('#venderidshow').val(row.userid);
                $('#edit_venderid').val(row.userid);

                /* Profile strip */
                $('#Names').text(row.Name);
                $('#FirmName').text(row.Firmname);
                $('#RegisteredDate').text(createddate);

                /* View mode divs */
                $('#view_Email').text(row.emailid || '—');
                $('#view_Pan').text(row.pancardnumber || '—');
                $('#view_Aadhar').text(row.aadharnumber || '—');
                $('#view_GST').text(row.gstnumber || '—');
                $('#view_Pin').text(row.pin || '—');
                $('#view_State').text(row.State_name || '—');
                $('#view_District').text(row.Dist_Desc || '—');
                $('#view_Address').text(row.address || '—');

                /* Edit mode inputs */
                $('#NameEdit').val(row.Name);
                $('#FirmEdit').val(row.Firmname);
                $('#pancardEdit').val(row.pancardnumber);
                $('#AadhaarEdit').val(row.aadharnumber);
                $('#gstEdit').val(row.gstnumber);
                $('#PinEdit').val(row.pin);
                $('#AddressEdit').val(row.address);

                /* Populate State dropdown and load Districts */
                $('#StateEdit').html('');
                var options = '<option value="">Select</option>';
                for (var i = 0; i < data2.state.length; i++) {
                    var sel = data2.state[i].Selected ? ' selected' : '';
                    options += '<option value="' + data2.state[i].Value + '"' + sel + '>' + data2.state[i].Text + '</option>';
                }
                $('#StateEdit').html(options);
                var objDist = document.getElementById("DistrictEdit");
                binddistmdAction(row.state, row.district, objDist);

                $('#defaultModal222').modal('show');
            }
        });
    }

    function converttoDate(str) {
        var date = new Date(str),
            mnth = ("0" + (date.getMonth() + 1)).slice(-2),
            day  = ("0" + date.getDate()).slice(-2),
            Hrs  = date.getHours(),
            mnts = date.getMinutes(),
            sec  = date.getSeconds();
        return [day, mnth, date.getFullYear()].join("-") + " " + [Hrs + ":" + mnts + ":" + sec];
    }

    function binddistmdAction(staid, dist, objSelect) {
        $.ajax({
            url: '@Url.Action("DistrictList","Home")',
            data: { Id: staid }, cache: false, type: "POST",
            success: function (data1) {
                var markup = "<option value='0'>Select District</option>";
                for (var x = 0; x < data1.length; x++) {
                    markup += "<option value=" + data1[x].Value + ">" + data1[x].Text + "</option>";
                }
                $("#DistrictEdit").html(markup).show();
                setSelectedValue(objSelect, dist);
            }
        });
    }

    function setSelectedValue(selectObj, valueToSet) {
        for (var i = 0; i < selectObj.options.length; i++) {
            if (selectObj.options[i].value == valueToSet) {
                selectObj.options[i].selected = true;
                return;
            }
        }
    }

    function Editstatechange() {
        var stid = $('#StateEdit').val();
        GetDistrict11(stid);
    }

    function GetDistrict11(_stateId) {
        var procemessage = "<option value='0'>Please wait...</option>";
        $("#DistrictEdit").html(procemessage).show();
        $.ajax({
            url: '@Url.Action("DistrictList","Home")',
            data: { Id: _stateId }, cache: false, type: "POST",
            success: function (data3) {
                $("#DistrictEdit").html("");
                for (var x = 0; x < data3.length; x++) {
                    $("#DistrictEdit").append($('<option></option>').val(data3[x].Value).html(data3[x].Text));
                }
            }
        });
    }
</script>

<script>
    /* -- Edit form validation (OnBegin) -- */
    function chkvalidation() {
        $('#vendor-edit-errmsg').text('');
        var name    = $('#NameEdit').val();
        var firm    = $('#FirmEdit').val();
        var state   = $('#StateEdit').val();
        var district = $('#DistrictEdit').val();
        var address = $('#AddressEdit').val();
        var pincode = $('#PinEdit').val();
        var pancard = $('#pancardEdit').val();
        var adhar   = $('#AadhaarEdit').val();
        var gst     = $('#gstEdit').val();
        function showErr(msg) { $('#vendor-edit-errmsg').text(msg); return false; }
        if (!name)     return showErr('Name Required');
        if (!firm)     return showErr('Firm Name Required');
        if (!state)    return showErr('State Required');
        if (!district) return showErr('District Required');
        if (!address)  return showErr('Address Required');
        if (!pincode)  return showErr('Pincode Required');
        if (pancard.length > 0) {
            var regex = /([A-Z]){5}([0-9]){4}([A-Z]){1}$/;
            if (!regex.test(pancard.toUpperCase())) return showErr('Invalid PAN Card No');
        }
        if (adhar.length > 0 && typeof validatesss === 'function' && !validatesss(adhar)) {
            return showErr('Invalid AADHAR No');
        }
        if (gst.length > 0) {
            var gstinformat = new RegExp('^([0][1-9]|[1-2][0-9]|[3][0-5])([a-zA-Z]{5}[0-9]{4}[a-zA-Z]{1}[1-9a-zA-Z]{1}[zZ]{1}[0-9a-zA-Z]{1})+$$');
            if (!gstinformat.test(gst)) return showErr('Invalid GST No');
        }
    }

    /* -- Edit success — hide modal, refresh list -- */
    function OnSuccess() {
        $('#defaultModal222').modal('hide');
        $(".modal-backdrop").remove();
    }
</script>

<script>
    /* -- Delete flow -- */
    function Deleteuser() {
        var venderid = $('#venderid').val();
        $.ajax({
            url: '@Url.Action("DeleteVendorByID","Home")',
            type: 'POST',
            data: { venderid: venderid },
            cache: false,
            success: function (response) {
                if (response == "success") {
                    $('#otp_venderiddelete').val(venderid);
                    $('#defaultModal222').modal('hide');
                    $('#otpmodal').modal('show');
                } else {
                    $('#error').text(response);
                }
            }
        });
    }

    function OnSuccessconfirm(data) {
        $('#vendorlisttable').html(data);
        $('#otpmodal').modal('hide');
        $(".modal-backdrop").remove();
        if (typeof ToastrMessage === 'function') { ToastrMessage(); }
        toastr.success("Account Deleted Successfully");
    }

    function OnFailureotperror() {
        $('#otpmodal').modal('show');
        $('#otpwrong').text("OTP Mismatch – please enter correct OTP");
        if (typeof ToastrMessage === 'function') { ToastrMessage(); }
        toastr.warning("OTP Mismatch, Please enter Correct OTP");
    }

    function OnFailure() {
        $('#otpwrong').text("OTP MissMatch");
    }
</script>

<script>
    /* -- Email Verify -- */
    function EmailVerify() {
        var venderid = $('#venderid').val();
        $.ajax({
            url: '@Url.Action("emailverifyforvender","Home")',
            type: "POST",
            data: { venderid: venderid },
            cache: false,
            dataType: "html",
            success: function (data2) {
                $('#vendorlisttable').html(data2);
                $('#defaultModal222').modal('hide');
                $(".modal-backdrop").remove();
                if (typeof ToastrMessage === 'function') { ToastrMessage(); }
                toastr.success("Email Verified Successfully");
            }
        });
    }
</script>
