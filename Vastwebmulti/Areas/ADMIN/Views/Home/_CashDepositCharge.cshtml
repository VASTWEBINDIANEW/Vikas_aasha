@model Vastwebmulti.Areas.ADMIN.Models.CashDepositeAndBank_Info_VM
@using (Ajax.BeginForm("_CashDepositCharge", "Home", new AjaxOptions { HttpMethod = "POST", OnSuccess = "success1", OnFailure = "failed1", UpdateTargetId = "remcash" }))
{
    <div class="cdc-deposit-save-bar">
        <button id="btnsubmit1" type="submit" class="ne-btn-submit cdc-btn-save"><i class="fas fa-save" aria-hidden="true"></i><span>Save Now</span></button>
    </div>
    <div id="tblRetailer" class="cdc-deposit-table-host">
        <table class="table table-bordered cdc-deposit-table example-second">
            <thead>
                <tr>
                    <th>User ID</th>
                    <th>Payment&nbsp;Type</th>
                    <th>Charge&nbsp;(%)</th>
                </tr>
            </thead>
            @if (Model.creditchargeRetailer != null)
            {
                <tbody id="tbodyshowretailer" class="cdc-deposit-view">
                    @foreach (var item in Model.creditchargeRetailer)
                    {
                        <tr>
                            <td>@item.userid</td>
                            <td>@item.ctype</td>
                            <td class="cdc-deposit-charge-val">@item.Charge</td>
                        </tr>
                    }
                </tbody>
                <tbody id="tbodyeditretailer" class="cdc-deposit-edit" style="display:none;">
                    @for (int i = 0; i < Model.creditchargeRetailer.Count; i++)
                    {
                        <tr>
                            @Html.HiddenFor(a => a.creditchargeRetailer[i].userinfo)
                            <td>@Html.DisplayFor(a => a.creditchargeRetailer[i].userid)</td>
                            <td>
                                @Html.HiddenFor(a => a.creditchargeRetailer[i].ctype)
                                @Html.DisplayFor(a => a.creditchargeRetailer[i].ctype)
                            </td>
                            <td>
                                @Html.EditorFor(a => a.creditchargeRetailer[i].Charge, new { htmlAttributes = new { @class = "form-control cdc-cell-input" } })
                                @Html.ValidationMessageFor(a => a.creditchargeRetailer[i].Charge)
                            </td>
                        </tr>
                    }
                </tbody>
            }
        </table>
    </div>
}
