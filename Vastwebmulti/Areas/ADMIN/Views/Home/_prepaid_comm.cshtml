@model Vastwebmulti.Areas.ADMIN.Models.PrepaidSlab
@using (Ajax.BeginForm("_prepaid_comm", "Home", new AjaxOptions { HttpMethod = "POST", OnSuccess = "OnSuccess", UpdateTargetId = "divEditFormComm", LoadingElementId = "div_Loader", InsertionMode = InsertionMode.Replace }))
{
    <input id="btnsubmit" type="submit" value="Save Slab" class="btn waves-effect vm-pg-slab-save-btn" style="display: none;" />
    <div class="vm-pg-slab-table-scroll saas-acc-table-wrap vm-prepaid-slab-table-wrap">
        <table id="updatecolm" class="table table-bordered vm-pg-slab-table third-design-table slab-table">
            <thead>
                <tr>
                    <th rowspan="2" style="text-align:center">Operator&nbsp;Name</th>
                    <th colspan="3" style="text-align:center">Master&nbsp;Distributor&nbsp;(M/D)&nbsp;% <br /><small class="font-10">Including GST (Goods and Service Tax) if commission agent</small></th>
                    <th colspan="3" style="text-align:center">Distributor&nbsp;% <br /><small class="font-10">Including GST (Goods and Service Tax) if commission agent</small></th>
                    <th colspan="3" style="text-align:center">Retailer&nbsp;% <br /><small class="font-10">Including GST (Goods and Service Tax)</small></th>
                    <th colspan="3" style="text-align:center">API&nbsp;% <br /><small class="font-10">Including GST (Goods and Service Tax)</small></th>
                    <th colspan="3" style="text-align:center">WhiteLabel&nbsp;% <br /><small class="font-10">Including GST (Goods and Service Tax)</small></th>
                </tr>
                <tr>
                    @{
                        var range1 = Convert.ToInt32(@Model.AmountRange[0].maximum1);
                        var range2 = Convert.ToInt32(@Model.AmountRange[0].maximum2);
                        var rangee1 = range1 + 1;
                        var rangee = range2 + 1;
                    }
                    <th class="vm-prepaid-range-head"><p class="vm-prepaid-range-label"><span class="vm-prepaid-range-badge">1</span> 1-@range1</p></th>
                    <th class="vm-prepaid-range-head"><p class="vm-prepaid-range-label"><span class="vm-prepaid-range-badge">2</span> @rangee1-@range2</p></th>
                    <th class="vm-prepaid-range-head"><p class="vm-prepaid-range-label"><span class="vm-prepaid-range-badge">3</span> @rangee-Above</p></th>
                    <th class="vm-prepaid-range-head"><p class="vm-prepaid-range-label"><span class="vm-prepaid-range-badge">1</span> 1-@range1</p></th>
                    <th class="vm-prepaid-range-head"><p class="vm-prepaid-range-label"><span class="vm-prepaid-range-badge">2</span> @rangee1-@range2</p></th>
                    <th class="vm-prepaid-range-head"><p class="vm-prepaid-range-label"><span class="vm-prepaid-range-badge">3</span> @rangee-Above</p></th>
                    <th class="vm-prepaid-range-head"><p class="vm-prepaid-range-label"><span class="vm-prepaid-range-badge">1</span> 1-@range1</p></th>
                    <th class="vm-prepaid-range-head"><p class="vm-prepaid-range-label"><span class="vm-prepaid-range-badge">2</span> @rangee1-@range2</p></th>
                    <th class="vm-prepaid-range-head"><p class="vm-prepaid-range-label"><span class="vm-prepaid-range-badge">3</span> @rangee-Above</p></th>
                    <th class="vm-prepaid-range-head"><p class="vm-prepaid-range-label"><span class="vm-prepaid-range-badge">1</span> 1-@range1</p></th>
                    <th class="vm-prepaid-range-head"><p class="vm-prepaid-range-label"><span class="vm-prepaid-range-badge">2</span> @rangee1-@range2</p></th>
                    <th class="vm-prepaid-range-head"><p class="vm-prepaid-range-label"><span class="vm-prepaid-range-badge">3</span> @rangee-Above</p></th>
                    <th class="vm-prepaid-range-head"><p class="vm-prepaid-range-label"><span class="vm-prepaid-range-badge">1</span> 1-@range1</p></th>
                    <th class="vm-prepaid-range-head"><p class="vm-prepaid-range-label"><span class="vm-prepaid-range-badge">2</span> @rangee1-@range2</p></th>
                    <th class="vm-prepaid-range-head"><p class="vm-prepaid-range-label"><span class="vm-prepaid-range-badge">3</span> @rangee-Above</p></th>
                </tr>
            </thead>
            <tbody id="tbodyshow" class="vm-pg-slab-tbody--view">
                @foreach (var item in Model.common)
                {
                    <tr>
                        <td>@item.OperatorName</td>
                        <td>@item.mastercomm</td>
                        <td>@item.mastercomm1</td>
                        <td>@item.mastercomm2</td>
                        <td>@item.dlmcomm</td>
                        <td>@item.dlmcomm1</td>
                        <td>@item.dlmcomm2</td>
                        <td>@item.dlm_rem_comm</td>
                        <td>@item.dlm_rem_comm1</td>
                        <td>@item.dlm_rem_comm2</td>
                        <td>@item.apicomm</td>
                        <td>@item.apicomm1</td>
                        <td>@item.apicomm2</td>
                        <td>@item.whitelabelcomm</td>
                        <td>@item.whitelabelcomm1</td>
                        <td>@item.whitelabelcomm2</td>
                    </tr>
                }
            </tbody>
            <tbody id="tbodyedit" class="vm-pg-slab-tbody--hidden">
                @for (int i = 0; i < Model.common.Count; i++)
                {
                    <tr>
                        @Html.HiddenFor(a => a.common[i].idno)
                        <td>@Html.DisplayFor(a => a.common[i].OperatorName)</td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.common[i].mastercomm, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input" } })
                            @Html.ValidationMessageFor(a => a.common[i].mastercomm)
                        </td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.common[i].mastercomm1, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input" } })
                            @Html.ValidationMessageFor(a => a.common[i].mastercomm1)
                        </td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.common[i].mastercomm2, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input" } })
                            @Html.ValidationMessageFor(a => a.common[i].mastercomm2)
                        </td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.common[i].dlmcomm, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input" } })
                            @Html.ValidationMessageFor(a => a.common[i].dlmcomm)
                        </td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.common[i].dlmcomm1, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input" } })
                            @Html.ValidationMessageFor(a => a.common[i].dlmcomm1)
                        </td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.common[i].dlmcomm2, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input" } })
                            @Html.ValidationMessageFor(a => a.common[i].dlmcomm2)
                        </td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.common[i].dlm_rem_comm, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input" } })
                            @Html.ValidationMessageFor(a => a.common[i].dlm_rem_comm)
                        </td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.common[i].dlm_rem_comm1, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input" } })
                            @Html.ValidationMessageFor(a => a.common[i].dlm_rem_comm1)
                        </td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.common[i].dlm_rem_comm2, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input" } })
                            @Html.ValidationMessageFor(a => a.common[i].dlm_rem_comm2)
                        </td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.common[i].apicomm, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input" } })
                            @Html.ValidationMessageFor(a => a.common[i].apicomm)
                        </td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.common[i].apicomm1, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input" } })
                            @Html.ValidationMessageFor(a => a.common[i].apicomm1)
                        </td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.common[i].apicomm2, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input" } })
                            @Html.ValidationMessageFor(a => a.common[i].apicomm2)
                        </td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.common[i].whitelabelcomm, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input" } })
                            @Html.ValidationMessageFor(a => a.common[i].whitelabelcomm)
                        </td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.common[i].whitelabelcomm1, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input" } })
                            @Html.ValidationMessageFor(a => a.common[i].whitelabelcomm1)
                        </td>
                        <td class="vm-pg-slab-edit-cell">
                            @Html.EditorFor(a => a.common[i].whitelabelcomm2, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input" } })
                            @Html.ValidationMessageFor(a => a.common[i].whitelabelcomm2)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<script>
    function OnSuccess() {
        if (typeof resetSlabViewMode === 'function') {
            resetSlabViewMode();
        } else {
            $('#btnsubmit').hide();
            $('#btnEdit').show();
        }
    }
</script>
