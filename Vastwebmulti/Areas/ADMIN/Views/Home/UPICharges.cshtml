<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.0.1/js/toastr.js"></script>
<script src="~/Swalalert/sweetalert-dev.js"></script>

<script>
    function hideUpiChargesTotals() {
        var $panel = $('#upiChargesTotalsPanel');
        var $btn = $('.vm-upi-charges-totals-btn');
        $panel.hide().attr('aria-hidden', 'true');
        $btn.attr('aria-expanded', 'false');
    }

    function toggleUpiChargesTotals() {
        var $panel = $('#upiChargesTotalsPanel');
        var $btn = $('.vm-upi-charges-totals-btn');
        if ($panel.is(':visible')) {
            hideUpiChargesTotals();
            return;
        }
        $panel.show().attr('aria-hidden', 'false');
        $btn.attr('aria-expanded', 'true');
    }

    var upiExtraWrapSelectors = ['#drpretailer', '#drpdealer', '#drpmaster', '#drpwhite'];
    var upiExtraSelectSelectors = ['#Retailerid', '#Dealerid', '#Masterid', '#Whitelabelid'];

    function destroyUpiSelect2($el) {
        if ($el && $el.length && $el.data('select2')) {
            $el.select2('destroy');
        }
    }

    function applyUpiSelect2($el) {
        if (!$el || !$el.length || !$.fn.select2) {
            return;
        }
        destroyUpiSelect2($el);
        $el.select2({
            width: '100%',
            minimumResultsForSearch: 6
        });
    }

    function hideUpiFilterExtras() {
        $(upiExtraWrapSelectors.join(', ')).each(function () {
            $(this).removeClass('is-visible').attr('hidden', 'hidden');
        });
        $(upiExtraSelectSelectors.join(', ')).each(function () {
            destroyUpiSelect2($(this));
        });
    }

    function showUpiFilterExtra(selector) {
        var $wrap = $(selector);
        $wrap.addClass('is-visible').removeAttr('hidden');
        var $select = $wrap.find('select');
        applyUpiSelect2($select);
        if ($select.length && $select.data('select2')) {
            $select.next('.select2-container').css('width', '100%');
        }
    }

    function upiChargesRoleFilter() {
        var answer = $('#ddlname').val();
        hideUpiFilterExtras();

        if (answer === 'Retailer') {
            showUpiFilterExtra('#drpretailer');
        } else if (answer === 'Distributor') {
            showUpiFilterExtra('#drpdealer');
        } else if (answer === 'Master') {
            showUpiFilterExtra('#drpmaster');
        } else if (answer === 'Whitelabel') {
            showUpiFilterExtra('#drpwhite');
        }
    }

    function ddlnamechange() {
        upiChargesRoleFilter();
    }

    function UPIRESPONSEsss(status, idno, firmname, txndate, amount) {
        $('#txtBankRRN').val('');
        $('#txtcode').val('');
        if (status === 'REJECTED') {
            $('#defaultModalLabel').text('Fail Transection');
            $('#txtBankRRN').prop('disabled', true);
        } else {
            $('#defaultModalLabel').text('Confirm Transection');
            $('#txtBankRRN').prop('disabled', false);
        }
        $('#hideupiidres').val(idno);
        $('#hideupiidrestypes').val(status);
        $('#txtremfrmname').val(firmname);
        $('#txttxndate').val(txndate);
        $('#txtremamount').val(amount);
    }

    function initUpiChargesSelect2() {
        applyUpiSelect2($('#ddlname'));
        applyUpiSelect2($('#ddlstatus'));
        applyUpiSelect2($('#ddlfiltertable'));
        $('#ddlname').off('change.upiCharges').on('change.upiCharges', upiChargesRoleFilter);
    }

    function initUpiChargesDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initUpiChargesDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm('#upiChargesForm');
        }
    }

    function exportUpiChargesReport(type) {
        var txt_frm_date = $('#txt_frm_date').val();
        var txt_to_date = $('#txt_to_date').val();
        var ddlname = $('#ddlname').val();
        var Retailerid = $('#Retailerid').val() || '';
        var Dealerid = $('#Dealerid').val() || '';
        var Masterid = $('#Masterid').val() || '';
        var Whitelabelid = $('#Whitelabelid').val() || '';
        var ddlstatus = $('#ddlstatus').val();
        var ddlfiltertable = $('#ddlfiltertable').val();
        var base = type === 'pdf'
            ? '@Url.Action("PdfUPICharges", "Home")'
            : '@Url.Action("ExcelUPIChargesReport", "Home")';
        var url = base
            + '?txt_frm_date=' + encodeURIComponent(txt_frm_date)
            + '&txt_to_date=' + encodeURIComponent(txt_to_date)
            + '&ddlname=' + encodeURIComponent(ddlname)
            + '&Retailerid=' + encodeURIComponent(Retailerid)
            + '&Dealerid=' + encodeURIComponent(Dealerid)
            + '&Masterid=' + encodeURIComponent(Masterid)
            + '&Whitelabelid=' + encodeURIComponent(Whitelabelid)
            + '&ddlstatus=' + encodeURIComponent(ddlstatus)
            + '&ddlfiltertable=' + encodeURIComponent(ddlfiltertable);

        if (type === 'pdf') {
            window.open(url, '_blank');
            return;
        }
        location.href = url;
    }

    function UPIOnOff(usefor) {
        $.ajax({
            url: '@Url.Action("Hide_Show_UPI", "Home")',
            type: 'POST',
            data: { usefor: usefor },
            success: function (data) {
                if (data.status === 'Success') {
                    if (data.Message === 'ON') {
                        $('.' + usefor + '.onoffswitch span').removeClass('custom-off').addClass('costom-on');
                    } else if (data.Message === 'OFF') {
                        $('.' + usefor + '.onoffswitch span').removeClass('costom-on').addClass('custom-off');
                    }
                } else if (typeof toastr !== 'undefined') {
                    toastr.error(data.Message);
                }
            }
        });
    }

    function KYCONOFF(usefor) {
        $.ajax({
            url: '@Url.Action("KYC_ON_OFF", "Home")',
            type: 'GET',
            success: function (data) {
                if (data.status === 'Success') {
                    if (data.Message === true) {
                        $('.' + usefor + '.onoffswitch span').removeClass('custom-off').addClass('costom-on');
                    } else if (data.Message === false) {
                        $('.' + usefor + '.onoffswitch span').removeClass('costom-on').addClass('custom-off');
                    }
                } else if (typeof toastr !== 'undefined') {
                    toastr.error(data.Message);
                }
            }
        });
    }

    function GETUpiQRCODEMINMAX() {
        $.ajax({
            url: '@Url.Action("GETUpiQRCODEMINMAX", "Home")',
            type: 'GET',
            success: function (response) {
                $('#RemTblQRCODE').html(response);
                $('#txtminbalUPIQRCODE').attr('readonly', true);
                $('#txtmaxbalUPIQRCODE').attr('readonly', true);
            }
        });
    }

    $(document).ready(function () {
        initUpiChargesSelect2();
        upiChargesRoleFilter();
        initUpiChargesDatepickers();
        $('#upiChargesForm .select2-container').css('width', '100%');

        $('#btnExport').on('click', function () {
            exportUpiChargesReport('excel');
        });
        $('#btnPDF').on('click', function () {
            exportUpiChargesReport('pdf');
        });

        $('.buttonqrtype').click(function () {
            $.ajax({
                url: '@Url.Action("Upi_Qr_statusChange", "Home")',
                type: 'POST',
                success: function (response) {
                    GETUpiQRCODEMINMAX();
                    if (response === true) {
                        $('.buttonqrtype span').text('variable QR');
                    } else {
                        $('.buttonqrtype span').text('fixed QR');
                    }
                }
            });
        });

        $('.buttonQRAPI').click(function () {
            $.ajax({
                url: '@Url.Action("Upi_Qr_API", "Home")',
                type: 'POST',
                success: function (response) {
                    GETUpiQRCODEMINMAX();
                    if (response === 'CFREE') {
                        $('.buttonQRAPI span').text('CFREE');
                        $('.buttonqrtype span').text('variable QR');
                    } else if (response === 'PHONEPE') {
                        $('.buttonQRAPI span').text('PHONEPE');
                        $('.buttonqrtype span').text('variable QR');
                    } else if (response === 'PAYU') {
                        $('.buttonQRAPI span').text('PAYU');
                        $('.buttonqrtype span').text('fixedqr');
                    } else {
                        $('.buttonQRAPI span').text('ICICI');
                        $('.buttonqrtype span').text('fixedqr');
                    }
                }
            });
        });

        $('#myModal123showdata').click(function () {
            GETUpiQRCODEMINMAX();
        });

        $('#SaveChargeREM').click(function () {
            $('#lblmsg').text('');
            $.ajax({
                url: '@Url.Action("AddUpiCharge", "Home")',
                type: 'POST',
                data: { min: $('#RemMinAmt').val(), charge: $('#RemMaxAmt').val() },
                success: function (response) {
                    $('#RemTbl').html(response);
                    $('#RemMinAmt').val('');
                    $('#RemMaxAmt').val('');
                    $('#RemTime').val('');
                    $('#RemIMPSFee').val('');
                    $('#RemNEFTFee').val('');
                }
            });
        });

        if (typeof loadSelfUpiBlockStatus === 'function') {
            loadSelfUpiBlockStatus();
        }

        $('#SaveAll').click(function () {
            var optCode = [];
            $('#SelfUpiCheckUncheck input').each(function () {
                if ($(this).prop('checked') === true) {
                    optCode.push($(this).val() + ',Y');
                } else {
                    optCode.push($(this).val() + ',N');
                }
            });
            document.getElementById('loadermoney').style.display = 'block';
            $.ajax({
                type: 'POST',
                url: '@Url.Action("Blocked_Self_Upi_SettingSave", "Home")',
                data: { ch: optCode },
                cache: false,
                dataType: 'json',
                async: true,
                success: function (data) {
                    document.getElementById('loadermoney').style.display = 'none';
                    if (data.status) {
                        if (typeof toastr !== 'undefined') {
                            toastr.success('SUCCESS', 'Self UPI Block/Unblock');
                        }
                    } else if (typeof toastr !== 'undefined') {
                        toastr.error(data.Message, 'Self UPI Block Error');
                    }
                }
            });
        });

        var msg = '@TempData["msgupi"]';
        if (msg) {
            alert(msg);
        }

        var succMsg = '@TempData["msgupisucc"]';
        if (succMsg && typeof swal === 'function') {
            swal('Success', 'Pending To Success', 'success');
        }
    });

    window.onload = function () {
        var message = '@ViewData["successorder"]';
        if (message && typeof swal === 'function') {
            swal('Good job!', message, 'success');
        }
        var errormessage = '@ViewData["failedorder"]';
        if (errormessage && typeof swal === 'function') {
            swal('Oops!', errormessage, 'error');
        }
        var data = '@ViewData["show"]';
        if (data && typeof sweetAlert === 'function') {
            sweetAlert('Oops...', data, 'error');
        }
    };

    function loadSelfUpiBlockStatus() {
        $.ajax({
            type: 'GET',
            url: '@Url.Action("Check_Unchek_Blocked_Self_Upi_Setting", "Home")',
            cache: false,
            dataType: 'json',
            async: true,
            success: function (data) {
                for (var item in data) {
                    if (!Object.prototype.hasOwnProperty.call(data, item)) {
                        continue;
                    }
                    var sts = data[item].status;
                    var name = (data[item].Upi_Mode || '').replace(' ', '');
                    if (sts === 'Y') {
                        $('#' + name).prop('checked', true);
                    }
                }
            }
        });
    }
</script>
