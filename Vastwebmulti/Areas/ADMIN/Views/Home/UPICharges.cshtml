@model Vastwebmulti.Areas.ADMIN.Models.upiChargeAndgateway
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "UPICharges";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
    var reports = Model.UPIREPORT?.ToList() ?? new List<Vastwebmulti.Models.show_upi_txn_details_Result>();
    var rowCount = reports.Count;
    var totalSuccess = reports.Count(i => string.Equals(i.status, "Success", StringComparison.OrdinalIgnoreCase) || string.Equals(i.status, "SUCCESS", StringComparison.OrdinalIgnoreCase));
    var totalPending = reports.Count(i => string.Equals(i.status, "Pending", StringComparison.OrdinalIgnoreCase) || string.Equals(i.status, "PENDING", StringComparison.OrdinalIgnoreCase));
    var totalFailed = reports.Count(i =>
        string.Equals(i.status, "Failed", StringComparison.OrdinalIgnoreCase)
        || string.Equals(i.status, "FAILED", StringComparison.OrdinalIgnoreCase)
        || string.Equals(i.status, "Rejected", StringComparison.OrdinalIgnoreCase)
        || string.Equals(i.status, "REJECTED", StringComparison.OrdinalIgnoreCase));
    var totalAmount = reports.Sum(i => i.amt ?? 0M);
    var totalCharge = reports.Sum(i => i.charge ?? 0M);
    var totalNet = reports.Sum(i => i.finalpay ?? 0M);
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=28" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=40" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=25" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-cms-report-status.css?v=2" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-upi-charges-modern.css?v=4" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.0.1/css/toastr.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-upi-charges-report-page">

    <div id="loadermoney" class="loadermoney" style="display:none;"></div>

    <div class="container-fluid vm-opr-page-shell">

        @if (!string.IsNullOrWhiteSpace(Model.msg))
        {
            <div class="vm-upi-msg" role="alert">@Model.msg</div>
        }

        @{
            var upiChargesFormAttrs = new Dictionary<string, object>
            {
                { "id", "upiChargesForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("UPICharges", "Home", FormMethod.Post, upiChargesFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Report's</li>
                        <li>UPI Charges</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-dmt-filter-row--upi vm-upi-filter-row--one-line vm-radiant-inline-filters vm-ecomm-filter-row--one-line">

                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("ddlname", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "All Roles", Value = "ALL" },
                                new SelectListItem { Text = "Retailer", Value = "Retailer" },
                                new SelectListItem { Text = "Distributor", Value = "Distributor" },
                                new SelectListItem { Text = "Master", Value = "Master" },
                                new SelectListItem { Text = "Whitelabel", Value = "Whitelabel" }
                            }, new { @id = "ddlname", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div id="drpretailer" class="vm-opr-field vm-dmt-field vm-opr-filter-extra" hidden>
                            @Html.DropDownList("Retailerid", ViewBag.Retailerid as SelectList, "Select Retailer", new { @id = "Retailerid", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div id="drpdealer" class="vm-opr-field vm-dmt-field vm-opr-filter-extra" hidden>
                            @Html.DropDownList("Dealerid", ViewBag.Dealerid as SelectList, "Select Distributor", new { @id = "Dealerid", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div id="drpmaster" class="vm-opr-field vm-dmt-field vm-opr-filter-extra" hidden>
                            @Html.DropDownList("Masterid", ViewBag.Masterid as SelectList, "Select Master", new { @id = "Masterid", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div id="drpwhite" class="vm-opr-field vm-dmt-field vm-opr-filter-extra" hidden>
                            @Html.DropDownList("Whitelabelid", ViewBag.whitelabelid as SelectList, "Select Whitelabel", new { @id = "Whitelabelid", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("ddlstatus", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "ALL Status", Value = "ALL" },
                                new SelectListItem { Text = "Pending", Value = "Pending" },
                                new SelectListItem { Text = "Success", Value = "Success" },
                                new SelectListItem { Text = "Rejected", Value = "Failed" }
                            }, new { @id = "ddlstatus", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("ddlfiltertable", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "By ALL", Value = "ALL" },
                                new SelectListItem { Text = "By QR", Value = "VASTBAZAAR" },
                                new SelectListItem { Text = "By Self", Value = "SELF" }
                            }, new { @id = "ddlfiltertable", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                            </div>

                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                            </div>

                            <button type="submit" id="RetailerSearch" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="upiChargesTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>UPI charges totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideUpiChargesTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--primary">
                            <span class="vm-opr-total-card__label">Total Records</span>
                            <strong class="vm-opr-total-card__value">@rowCount</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Success</span>
                            <strong class="vm-opr-total-card__value">@totalSuccess</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Pending</span>
                            <strong class="vm-opr-total-card__value">@totalPending</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Failed</span>
                            <strong class="vm-opr-total-card__value">@totalFailed</strong>
                        </div>
                        <div class="vm-opr-total-card">
                            <span class="vm-opr-total-card__label">Total Amount</span>
                            <strong class="vm-opr-total-card__value">@totalAmount.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card">
                            <span class="vm-opr-total-card__label">Total Charges</span>
                            <strong class="vm-opr-total-card__value">@totalCharge.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card">
                            <span class="vm-opr-total-card__label">Net Pay</span>
                            <strong class="vm-opr-total-card__value">@totalNet.ToString("N2")</strong>
                        </div>
                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card vm-upi-charges-main-card">
            <div class="vm-opr-table-panel vm-upi-charges-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-qrcode" aria-hidden="true"></i>
                        <span>UPI charges report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong>@rowCount</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-upi-charges-totals-btn" onclick="toggleUpiChargesTotals()" title="Show totals" aria-expanded="false" aria-controls="upiChargesTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll" id="upiChargesExportWrap">
                        <table id="upiChargesTable" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>S&nbsp;No</th>
                                    <th class="vm-upi-status-col">Status</th>
                                    <th>Role</th>
                                    <th>User</th>
                                    <th>Payer&nbsp;Name</th>
                                    <th>Remain&nbsp;Pre</th>
                                    <th>Amount</th>
                                    <th>Charges</th>
                                    <th>Net&nbsp;Pay</th>
                                    <th>Remain&nbsp;Post</th>
                                    <th>Bank&nbsp;RRN</th>
                                    <th>Transaction&nbsp;Time</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (rowCount == 0)
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="13" class="vm-opr-table-empty vm-dmt-table-empty">
                                            <i class="fas fa-qrcode" aria-hidden="true"></i>
                                            <span>No UPI charge records found.</span>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    var srIndex = 0;
                                    foreach (var item in reports)
                                    {
                                        srIndex++;
                                        var frmname = string.IsNullOrWhiteSpace(item.Frm_Name) ? item.RetailerName : item.Frm_Name;
                                        var bankRrn = string.IsNullOrWhiteSpace(item.ApprovalRefNo) || item.ApprovalRefNo == "null" ? item.BankRRN : item.ApprovalRefNo;
                                        var txnTime = item.txndate.HasValue ? item.txndate.Value.ToString("yyyy-MM-dd HH:mm:ss") : "�";
                                        var isPending = string.Equals(item.status, "Pending", StringComparison.OrdinalIgnoreCase) || string.Equals(item.status, "PENDING", StringComparison.OrdinalIgnoreCase);
                                        var statusBadge = item.status ?? "";
                                        if (string.Equals(statusBadge, "Rejected", StringComparison.OrdinalIgnoreCase)
                                            || string.Equals(statusBadge, "REJECTED", StringComparison.OrdinalIgnoreCase))
                                        {
                                            statusBadge = "Failed";
                                        }
                                        var rowClass = "vm-upi-report-row vm-auto-fund-row";
                                        if (string.Equals(statusBadge, "Success", StringComparison.OrdinalIgnoreCase) || string.Equals(statusBadge, "SUCCESS", StringComparison.OrdinalIgnoreCase))
                                        {
                                            rowClass += " vm-upi-report-row--success";
                                        }
                                        else if (isPending)
                                        {
                                            rowClass += " vm-upi-report-row--pending";
                                        }
                                        else if (string.Equals(statusBadge, "Failed", StringComparison.OrdinalIgnoreCase) || string.Equals(statusBadge, "FAILED", StringComparison.OrdinalIgnoreCase))
                                        {
                                            rowClass += " vm-upi-report-row--failed";
                                        }

                                        <tr class="@rowClass">
                                            <td class="vm-dmt-sr-cell">@srIndex</td>
                                            <td class="vm-upi-status-cell">
                                                @Html.Partial("_ReportStatusBadge", statusBadge)
                                            </td>
                                            <td>@item.rolename</td>
                                            <td class="vm-upi-user-cell-wrap">
                                                <div class="vm-upi-user-cell">
                                                    <strong>@frmname</strong>
                                                </div>
                                            </td>
                                            <td class="vm-upi-payer-cell-wrap">
                                                <span class="vm-upi-payer-name">@item.PayerName</span>
                                            </td>
                                            <td class="vm-upi-num-cell">@item.remainpre</td>
                                            <td class="vm-upi-num-cell">@item.amt</td>
                                            <td class="vm-upi-num-cell">@item.charge</td>
                                            <td class="vm-upi-num-cell">@item.finalpay</td>
                                            <td class="vm-upi-num-cell">@item.remainpost</td>
                                            <td>@bankRrn</td>
                                            <td>@txnTime</td>
                                            <td class="vm-dmt-action-cell">
                                                @if (isPending)
                                                {
                                                    <div class="vm-upi-action-group">
                                                        <button type="button" class="vm-upi-action-btn vm-upi-action-btn--approve" data-toggle="modal" data-target="#myModalUPITXN" onclick="UPIRESPONSEsss('APPROVED', '@item.idno','@frmname' ,'@txnTime', '@item.amt')" title="Approve">
                                                            <i class="fa fa-check" aria-hidden="true"></i>
                                                        </button>
                                                        <button type="button" class="vm-upi-action-btn vm-upi-action-btn--reject" data-toggle="modal" data-target="#myModalUPITXN" onclick="UPIRESPONSEsss('REJECTED', '@item.idno','@frmname','@txnTime' ,'@item.amt')" title="Reject">
                                                            <i class="fa fa-times" aria-hidden="true"></i>
                                                        </button>
                                                    </div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    <tr class="vm-upi-totals-row">
                                        <td colspan="6">TOTAL</td>
                                        <td class="vm-upi-num-cell">@totalAmount</td>
                                        <td class="vm-upi-num-cell">@totalCharge</td>
                                        <td class="vm-upi-num-cell">@totalNet</td>
                                        <td colspan="5"></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

