@model IEnumerable<Vastwebmulti.Models.token_limit>

@foreach (var item in Model)
{
    var nextLimit = "";
    var nextStatus = "";
    var tone = "green";
    var statusText = "Active";
    var isOff = false;

    if (item.limit == 1 && item.status == "Y") { nextLimit = "2"; nextStatus = "Y"; }
    else if (item.limit == 2 && item.status == "Y") { nextLimit = "3"; nextStatus = "Y"; }
    else if (item.limit == 3 && item.status == "Y") { nextLimit = "4"; nextStatus = "Y"; }
    else if (item.limit == 4 && item.status == "Y") { nextLimit = "5"; nextStatus = "Y"; }
    else if (item.limit == 5 && item.status == "Y") { nextLimit = "10"; nextStatus = "Y"; }
    else if (item.limit == 10 && item.status == "Y") { nextLimit = "15"; nextStatus = "Y"; tone = "yellow"; }
    else if (item.limit == 15 && item.status == "Y") { nextLimit = "0"; nextStatus = "N"; tone = "orange"; }
    else if (item.limit == 0 && item.status == "Y") { nextLimit = "1"; nextStatus = "Y"; tone = "red"; statusText = "OFF"; isOff = true; }
    else if (item.status == "N") { nextLimit = "1"; nextStatus = "Y"; tone = "red"; statusText = "OFF"; isOff = true; }
    else { continue; }

    <button type="button"
            class="sr-ref-btn sr-ref-btn--@tone@(isOff ? " sr-ref-btn--off" : "")"
            onclick="refferalsetup('@nextLimit','@nextStatus')"
            title="Monthly Retailer Referral � tap to change limit">
        <span class="sr-ref-btn__icon"><i class="fas fa-users"></i></span>
        <span class="sr-ref-btn__text">
            <span class="sr-ref-btn__title">Monthly Retailer Referral</span>
            <span class="sr-ref-btn__dot">�</span>
            <span class="sr-ref-btn__status@(isOff ? " sr-ref-btn__status--off" : "")">@statusText</span>
        </span>
        <span class="sr-ref-btn__badge">@item.limit</span>
        <i class="fas fa-chevron-right sr-ref-btn__chev"></i>
    </button>
}
