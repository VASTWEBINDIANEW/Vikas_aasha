@using Vastwebmulti.Models
@using Microsoft.AspNet.Identity
@model List<Vastwebmulti.Models.proc_BusReport_Result>
@{
    ViewBag.Title = "Bus Booking Report";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var userid = User.Identity.GetUserId();
    var logoimage = "";
    using (var db = new VastwebmultiEntities())
    {
        var logo = db.tblHeaderLogoes.Where(p => p.Role == "ADMIN").ToList();
        logoimage = logo.Count > 0 ? logo.SingleOrDefault().LogoImage : "";
        ViewBag.AdminMobile = db.Admin_details.Where(a => a.userid == userid).Select(a => a.mobile).FirstOrDefault();
    }

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var selectedUsers = (Request["ddlusers"] ?? "Admin").Trim();
    var selectedStatus = (Request["ddl_status"] ?? "").Trim();
    var ticketNoValue = (Request["TicketNo"] ?? "").Trim();
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=11" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=2" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<script src="~/MainFrontDesign/js/admin-financial-report.js?v=15"></script>

<div id="loadermoney" class="vm-dmt-loader" style="display:none;"></div>
<div id="BusLoader" class="vm-dmt-loader" style="display:none;"></div>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-bus-booking-report-page">

    <div class="container-fluid vm-opr-page-shell">

        @using (Html.BeginForm("BusBookingReport", "Home", FormMethod.Post, new { id = "busBookingReportForm", @class = "vm-rpt-filters-panel__form" }))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Travel &amp; Hotels</li>
                        <li>Bus Booking Report</li>
                    </ol>

                    <div class="vm-dmt-fin-nav-row vm-ticket-travel-nav-row">
                        @Html.Partial("~/Areas/ADMIN/Views/Air/_ticketTravelNav.cshtml")
                    </div>
                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="busTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Bus booking totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideBusTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Success</span>
                            <strong class="vm-opr-total-card__value" id="successtotal">—</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Failed</span>
                            <strong class="vm-opr-total-card__value" id="Failedtotal">—</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Pending</span>
                            <strong class="vm-opr-total-card__value" id="Pendingtotal">—</strong>
                        </div>
                    </div>
                </div>

                <div class="vm-rpt-filters-panel">
                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-rpt-filters-panel__bar">

                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("ddlusers", new SelectList(new[]
                            {
                                new SelectListItem{ Text="All User", Value="Admin"},
                                new SelectListItem{ Text="Master", Value="Master"},
                                new SelectListItem{ Text="Distributor", Value="Dealer"},
                                new SelectListItem{ Text="Retailer", Value="Retailer"},
                                new SelectListItem{ Text="Whitelabel", Value="Whitelabel"}
                            }, "Value", "Text", selectedUsers), new { id = "ddlusers", @class = "vm-opr-select vm-dmt-select form-control", @title = "User type", @onchange = "answers()" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="ticket-wrap-whitelabel" style="display:none;" hidden>
                            @Html.DropDownList("allwhitelabel", ViewBag.allwhitelabel as SelectList, "All Whitelabel", new { id = "allwhitelabel", @class = "vm-opr-select vm-dmt-select form-control", @title = "Whitelabel" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="ticket-wrap-master" style="display:none;" hidden>
                            @Html.DropDownList("allmaster", ViewBag.allmaster as SelectList, "All Master", new { id = "allmaster", @class = "vm-opr-select vm-dmt-select form-control", @title = "Master" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="dlm" style="display:none;" hidden>
                            @Html.DropDownList("alldealer", ViewBag.alldealer as SelectList, "All Distributor", new { id = "alldealer", @class = "vm-opr-select vm-dmt-select form-control", @title = "Distributor" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="rem" style="display:none;" hidden>
                            @Html.DropDownList("allretailer", ViewBag.allretailer as SelectList, "All Retailer", new { id = "allretailer", @class = "vm-opr-select vm-dmt-select form-control", @title = "Retailer" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field" id="sts">
                            @Html.DropDownList("ddl_status", new SelectList(new[]
                            {
                                new SelectListItem{ Text="All Status", Value=""},
                                new SelectListItem{ Text="Success", Value="SUCCESS"},
                                new SelectListItem{ Text="Pending", Value="PENDING"},
                                new SelectListItem{ Text="Failed", Value="FAILED"}
                            }, "Value", "Text", selectedStatus), new { id = "ddl_status", @class = "vm-opr-select vm-dmt-select form-control", @title = "Status" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-dmt-field--pnr">
                            <input type="text" name="TicketNo" id="TicketNo" class="form-control vm-dmt-search-input vm-ticket-pnr-input" placeholder="Ticket No" autocomplete="off" title="Ticket No" value="@ticketNoValue" />
                        </div>

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-bus" aria-hidden="true"></i>
                        <span>Bus booking report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-bus-totals-btn" onclick="findtotalBus()" title="Show totals" aria-expanded="false" aria-controls="busTotalsPanel"><i class="fas fa-chart-pie" aria-hidden="true"></i></button>
                            <button type="button" id="btnExportA" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel"><i class="fas fa-file-excel" aria-hidden="true"></i> Excel</button>
                            <button type="button" id="btnPDFA" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF"><i class="fas fa-file-pdf" aria-hidden="true"></i> PDF</button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="busBookingReport" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Status</th>
                                    <th>Ticket&nbsp;Status</th>
                                    <th>Firm&nbsp;Name</th>
                                    <th>Passanger&nbsp;Name</th>
                                    <th>Source&nbsp;(From)</th>
                                    <th>Destination&nbsp;(To)</th>
                                    <th>Date&nbsp;Of&nbsp;Journey</th>
                                    <th>Fare</th>
                                    <th>Retailer&nbsp;Pre</th>
                                    <th>Dr&nbsp;/&nbsp;Cr</th>
                                    <th>Retailer&nbsp;Post</th>
                                    <th>Earn</th>
                                    <th>PNR</th>
                                    <th>Booking&nbsp;Time</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody id="busReportRows">
                                @Html.Partial("_BusBookingReportRows", Model)
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<div class="modal fade saas-admin-modal vm-dmt-modal vm-ticket-detail-modal" id="busDetailModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header saas-admin-modal-header accent-sky">
                <div class="saas-admin-modal-head-main">
                    <div class="saas-admin-modal-icon"><i class="fas fa-bus" aria-hidden="true"></i></div>
                    <div>
                        <h4 class="modal-title saas-admin-modal-title">Bus booking details</h4>
                        <p class="saas-admin-modal-sub">Commission and API information</p>
                    </div>
                </div>
                <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
            </div>
            <div class="modal-body vm-dmt-modal-body">
                <div class="vm-dmt-modal-grid vm-dmt-modal-grid--2">
                    <div class="vm-dmt-modal-field"><label>Retailer Pre</label><input type="text" id="busRemPre" class="form-control vm-dmt-modal-input" readonly="readonly" /></div>
                    <div class="vm-dmt-modal-field"><label>Retailer Inc</label><input type="text" id="busRemInc" class="form-control vm-dmt-modal-input" readonly="readonly" /></div>
                    <div class="vm-dmt-modal-field"><label>Retailer Post</label><input type="text" id="busRemPost" class="form-control vm-dmt-modal-input" readonly="readonly" /></div>
                    <div class="vm-dmt-modal-field"><label>Distributor Inc</label><input type="text" id="busDlmInc" class="form-control vm-dmt-modal-input" readonly="readonly" /></div>
                    <div class="vm-dmt-modal-field"><label>Distributor Pre</label><input type="text" id="busDlmPre" class="form-control vm-dmt-modal-input" readonly="readonly" /></div>
                    <div class="vm-dmt-modal-field"><label>Distributor Post</label><input type="text" id="busDlmPost" class="form-control vm-dmt-modal-input" readonly="readonly" /></div>
                    <div class="vm-dmt-modal-field"><label>Master Inc</label><input type="text" id="busMdInc" class="form-control vm-dmt-modal-input" readonly="readonly" /></div>
                    <div class="vm-dmt-modal-field"><label>Master Pre</label><input type="text" id="busMdPre" class="form-control vm-dmt-modal-input" readonly="readonly" /></div>
                    <div class="vm-dmt-modal-field"><label>Master Post</label><input type="text" id="busMdPost" class="form-control vm-dmt-modal-input" readonly="readonly" /></div>
                    <div class="vm-dmt-modal-field"><label>Whitelabel Inc</label><input type="text" id="busWlInc" class="form-control vm-dmt-modal-input" readonly="readonly" /></div>
                    <div class="vm-dmt-modal-field"><label>Whitelabel Pre</label><input type="text" id="busWlPre" class="form-control vm-dmt-modal-input" readonly="readonly" /></div>
                    <div class="vm-dmt-modal-field"><label>Whitelabel Post</label><input type="text" id="busWlPost" class="form-control vm-dmt-modal-input" readonly="readonly" /></div>
                </div>
                <div class="vm-dmt-modal-field" style="margin-top:12px;">
                    <label>Request</label>
                    <textarea id="busRequestJson" class="form-control vm-dmt-modal-input" rows="3" readonly="readonly"></textarea>
                </div>
                <div class="vm-dmt-modal-field">
                    <label>Response</label>
                    <textarea id="busResponseJson" class="form-control vm-dmt-modal-input" rows="4" readonly="readonly"></textarea>
                </div>
            </div>
            <div class="modal-footer saas-admin-modal-footer">
                <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal"><i class="fas fa-times" aria-hidden="true"></i> Close</button>
            </div>
        </div>
    </div>
</div>

<div id="BookingDetailsModel" class="modal fade saas-admin-modal vm-dmt-modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header saas-admin-modal-header accent-sky">
                <div class="saas-admin-modal-head-main">
                    @if (!string.IsNullOrEmpty(logoimage))
                    {
                        <img src="@Url.Content("~/" + logoimage)" alt="Logo" style="max-height:36px;margin-right:10px;" />
                    }
                    <div>
                        <h4 class="modal-title saas-admin-modal-title">Boarding details</h4>
                        <p class="saas-admin-modal-sub"><i class="fa fa-headphones" aria-hidden="true"></i> @ViewBag.AdminMobile</p>
                    </div>
                </div>
                <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
            </div>
            <div class="modal-body vm-dmt-modal-body">
                <div class="row" style="margin-bottom:12px;">
                    <div class="col-md-5"><strong><span id="spanSourceCityName"></span><br /><span id="spanDepartureDateTime"></span><br /><small>(Source)</small></strong></div>
                    <div class="col-md-2 text-center"><i class="fas fa-shuttle-van" style="font-size:22px;color:#92400e;"></i></div>
                    <div class="col-md-5 text-right"><strong><span id="spanDestinationCityName"></span><br /><span id="spanArrivalDateTime"></span><br /><small>(Destination)</small></strong></div>
                </div>
                <div class="vm-dmt-modal-field"><strong>Boarding Point:</strong> <span id="spanBoardingPoint"></span></div>
                <div class="vm-dmt-modal-field"><strong>Boarding Contact:</strong> <span id="spanBoardingcontantno"></span></div>
                <div class="vm-dmt-modal-field"><strong>Landmark:</strong> <span id="spanDroppingPoint"></span></div>
                <div class="vm-dmt-modal-field"><strong>Bus Operator:</strong> <span id="spanBusOptName"></span></div>
                <div class="row" style="margin-top:10px;">
                    <div class="col-md-3"><strong>Ticket No</strong><br /><small id="spanTicketNum"></small></div>
                    <div class="col-md-2"><strong>PNR</strong><br /><small id="spanPNR"></small></div>
                    <div class="col-md-2"><strong>Total Fare</strong><br /><i class="fa fa-inr"></i><span id="spanBaseFare"></span></div>
                    <div class="col-md-2"><strong>Charge/Tax</strong><br /><i class="fa fa-inr"></i><span id="spanTaxAmount"></span></div>
                    <div class="col-md-3"><strong>Total Amount</strong><br /><i class="fa fa-inr"></i><span id="spanTotalFareWithTax"></span></div>
                </div>
                <div class="table-responsive" style="margin-top:12px;">
                    <table class="table vm-opr-data-table">
                        <thead><tr><th>#</th><th>Name</th><th>Seat No</th><th>Gender</th></tr></thead>
                        <tbody id="travellerDetails"></tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer saas-admin-modal-footer">
                <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal"><i class="fas fa-times" aria-hidden="true"></i> Close</button>
            </div>
        </div>
    </div>
</div>

<script src="~/MainFrontDesign/select2/dist/js/select2.full.min.js"></script>
<script src="~/MainFrontDesign/js/admin-ticket-report.js?v=8"></script>
<script src="~/Swalalert/sweetalert-dev.js"></script>
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />

<script>
    window.busReportBaseUrl = '@Url.Action("BusBookingReport", "Home")';

    function buildBusExportQuery() {
        return 'txt_frm_date=' + encodeURIComponent($('#txt_frm_date').val())
            + '&txt_to_date=' + encodeURIComponent($('#txt_to_date').val())
            + '&ddl_status=' + encodeURIComponent($('#ddl_status').val() || '')
            + '&TicketNo=' + encodeURIComponent($('#TicketNo').val() || '')
            + '&ddlusers=' + encodeURIComponent($('#ddlusers').val() || '')
            + '&allmaster=' + encodeURIComponent($('select#allmaster').val() || '')
            + '&alldealer=' + encodeURIComponent($('#alldealer').val() || '')
            + '&allretailer=' + encodeURIComponent($('#allretailer').val() || '')
            + '&allwhitelabel=' + encodeURIComponent($('select#allwhitelabel').val() || '');
    }

    function downloadBusExport(type) {
        var url = window.busReportBaseUrl + '?export=' + encodeURIComponent(type) + '&' + buildBusExportQuery();
        var frame = document.getElementById('busExportFrame');
        if (!frame) {
            frame = document.createElement('iframe');
            frame.id = 'busExportFrame';
            frame.style.display = 'none';
            document.body.appendChild(frame);
        }
        frame.src = url;
    }

    $('#btnExportA').click(function () { downloadBusExport('excel'); });
    $('#btnPDFA').click(function () { downloadBusExport('pdf'); });

    function busActionBtn(el, remPre, remInc, remPost, dlmInc, dlmPre, dlmPost, mdInc, mdPre, mdPost, wlInc, wlPre, wlPost) {
        $('#busRemPre').val(remPre);
        $('#busRemInc').val(remInc);
        $('#busRemPost').val(remPost);
        $('#busDlmInc').val(dlmInc);
        $('#busDlmPre').val(dlmPre);
        $('#busDlmPost').val(dlmPost);
        $('#busMdInc').val(mdInc);
        $('#busMdPre').val(mdPre);
        $('#busMdPost').val(mdPost);
        $('#busWlInc').val(wlInc);
        $('#busWlPre').val(wlPre);
        $('#busWlPost').val(wlPost);
        $('#busRequestJson').val($(el).data('req') || '');
        $('#busResponseJson').val($(el).data('res') || '');
        $('#busDetailModal').modal('show');
    }

    function BookingDetails(id) {
        $('#BusLoader').show();
        $.post('@Url.Action("getBookingDetails", "Home")', { TraceId: id }, function (data) {
            var response = JSON.parse(data);
            if (response.Status === 'Success' && response.Message.Error.ErrorCode === 0) {
                $('#BusLoader').hide();
                $('#spanSourceCityName').html(response.Message.Itinerary.Origin);
                $('#spanDepartureDateTime').html(response.Message.Itinerary.DepartureTime + ',' + response.Message.Itinerary.DateOfJourney);
                $('#spanDestinationCityName').html(response.Message.Itinerary.Destination);
                $('#spanArrivalDateTime').html(response.Message.Itinerary.ArrivalTime);
                $('#spanBoardingPoint').html(response.Message.Itinerary.BoardingPointdetails.CityPointName);
                $('#spanBoardingcontantno').html(response.Message.Itinerary.BoardingPointdetails.CityPointContactNumber);
                $('#spanDroppingPoint').html(response.Message.Itinerary.BoardingPointdetails.CityPointLandmark);
                $('#spanBusOptName').html(response.Message.Itinerary.TravelName);
                $('#spanTicketNum').html(response.Message.Itinerary.TicketNo);
                $('#spanPNR').html(response.Message.Itinerary.TravelOperatorPNR);
                $('#spanBaseFare').html(response.Message.Itinerary.Price.BasePrice);
                $('#spanTaxAmount').html(parseInt(response.Message.Itinerary.Price.OtherCharges + response.Message.Itinerary.Price.Tax));
                $('#spanTotalFareWithTax').html(response.Message.Itinerary.Price.PublishedPriceRoundedOff);
                var tabRow = '';
                var PaxCount = 1;
                response.Message.Itinerary.Passenger.forEach(function (entry) {
                    var Paxgender = entry.Gender === '1' ? 'Male' : 'Female';
                    tabRow += '<tr><th scope="row">' + PaxCount + '</th><td>' + entry.FirstName + ' ' + entry.LastName + '</td><td>' + entry.Seat.SeatName + '</td><td>' + Paxgender + '</td></tr>';
                    PaxCount += 1;
                });
                $('#travellerDetails').html(tabRow);
                $('#BookingDetailsModel').modal('show');
            } else {
                $('#BusLoader').hide();
                swal('Oops!!!', response.Message.Error ? response.Message.Error.ErrorMessage : response.Message, 'error');
            }
        }).fail(function (jqXHR) {
            $('#BusLoader').hide();
            swal('Oops!!!', jqXHR.responseText, 'error');
        });
    }

    $(document).ready(function () {
        $('#txt_frm_date, #txt_to_date').datepicker({
            format: 'yyyy-mm-dd',
            todayHighlight: true,
            autoclose: true,
            orientation: 'bottom auto'
        });
        var val = '@ViewBag.chk';
        if (val !== 'post') {
            $('#txt_frm_date').datepicker('setDate', new Date());
            $('#txt_to_date').datepicker('setDate', new Date());
        }
    });
</script>
