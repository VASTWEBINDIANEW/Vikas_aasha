@model Vastwebmulti.Areas.ADMIN.Models.PostpaidUtilitySlab

<div class="vm-pg-slab-table-scroll saas-acc-table-wrap vm-prepaid-slab-table-wrap">
    <table class="table table-bordered vm-pg-slab-table vm-postpaid-charge-table slab-table">
        <thead>
            <tr>
                <th>User&nbsp;Type</th>
                <th> Rch&nbsp;Type</th>
                <th>Fixed Charge (Rs)</th>
                <th>Fixed Charge (%)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.chargetype)
            {
                <tr>
                    <td>@item.user_type</td>
                    <td>@item.rch_type</td>
                    <td>
                        <div class="onoffswitch">
                            @if (item.fixedrs == true)
                            {
                                <button type="button" class="vm-commission-hold-btn costom-on" onclick="change('@item.user_type','@item.rch_type')"><span>ON</span></button>
                            }
                            else
                            {
                                <button type="button" class="vm-commission-hold-btn custom-off" onclick="change('@item.user_type','@item.rch_type')"><span>OFF</span></button>
                            }
                        </div>
                    </td>
                    <td>
                        <div class="onoffswitch">
                            @if (item.fixedrs == false)
                            {
                                <button type="button" class="vm-commission-hold-btn costom-on" onclick="change('@item.user_type','@item.rch_type')"><span>ON</span></button>
                            }
                            else
                            {
                                <button type="button" class="vm-commission-hold-btn custom-off" onclick="change('@item.user_type','@item.rch_type')"><span>OFF</span></button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
