@{
    var action = ViewContext.RouteData.Values["action"].ToString().ToLower();
}


<style>

    /*new page css v */

    .Retailers_menu a.active {
        background-image: linear-gradient(to right, var(--main-bg-lcolor), var(--main-bg-rcolor)) !important;
        color: #fff !important;
    }

    #custnav a.active {
        color: #fff !important;
    }

        .Retailers_menu a.active::before {
            border-left: 2px solid #fff !important;
            border-bottom: 2px solid #fff !important;
        }

    #custnav.Retailers_menu a:hover {
        background-color: #000 !important;
        color: #fff !important;
    }

        .Retailers_menu a:hover::before {
            border-left: 2px solid #fff !important;
            border-bottom: 2px solid #fff !important;
        }

    #custnav .nav > li > a {
        padding: 10px 10px;
    }

    .slab-first-tab .nav-tabs li a {
        font-size: 14px;
    }

    .slab-first-tab ul li {
        margin-top: 15px;
    }

    /*new page css v */

    .slab-first-tab .nav-tabs li a::before {
        content: '';
        border-left: 2px solid #555;
        border-bottom: 2px solid #555;
        width: 8px;
        height: 8px;
        display: block;
        right: 20px !important;
        left: auto;
        bottom: 15px !important;
        transform: rotate(-131deg);
        float: right !important;
        margin-top: 6px !important;
    }

    .slab-first-tab {
        margin: auto;
        height: auto;
        display: flow-root;
        margin-bottom: 11px;
        background: rgb(255 255 255 / 95%);
        padding: 5px;
        box-shadow: 0px 0px 5px -2px;
        border-radius: 4px;
        width: 12%;
    }

    .col-md-10.slab-first-tab-content {
        float: right;
        width: 87%;
        margin: 0;
        padding: 0px;
    }

    /* new css */
    @@media only screen and (max-width:480px) {
        .all-slab-header-second button {
            width: 33% !important;
            margin: 0 !important;
            float: left !important;
            margin-bottom: 4px !important;
        }

        .all-slab-header-second a {
            width: 33% !important;
            margin: 0 !important;
            float: left !important;
            margin-bottom: 4px !important;
        }

        .p_range {
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .page-header-third {
            width: 100% !important;
        }
    }


    /* new css */


</style>



<div id="custnav" class="col-md-2 slab-first-tab Retailers_menu" style="width: 100%; height: 90vh;">
    <h2 class="borderbottom-second">Category's</h2>

    <ul class="nav nav-tabs">
        <li>
            <a class="@(action == "showclosingbalance" ? "active" : "")"
               href="@Url.Action("Showclosingbalance","Home")">
                Show Opening Balance
            </a>
        </li>

        <li>
            <a class="@(action == "daywisecomm" ? "active" : "")"
               href="@Url.Action("daywisecomm","Home")">
                Extra Comm Status
            </a>
        </li>

        <li>
            <a class="@(action == "daywisecommhistory" ? "active" : "")"
               href="@Url.Action("daywisecommhistory","Home")">
                Extra Comm History
            </a>
        </li>

        <li>
            <a class="@(action == "passbyretailerdmtsd" ? "active" : "")"
               href="@Url.Action("passbyretailerdmtsd","Home")">
                By Pass DMT
            </a>
        </li>

        <li>
            <a class="@(action == "userwisewhatsappstatus" ? "active" : "")"
               href="@Url.Action("userwisewhatsappstatus","Home")">
                Whatsapp Status User
            </a>
        </li>

        <li>
            <a class="@(action == "rechargeb2c" ? "active" : "")"
               href="@Url.Action("RechargeB2C","Home")">
                Recharge B2c
            </a>
        </li>

        <li>
            <a class="@(action == "retailerekyccheck" ? "active" : "")"
               href="@Url.Action("retailerekyccheck","Home")">
                AEPS e-kyc Report
            </a>
        </li>

        <li>
            <a class="@(action == "unloadlimitset" ? "active" : "")"
               href="@Url.Action("Unloadlimitset","Home")">
                Wallet unload Limit
            </a>
        </li>
    </ul>
</div>

