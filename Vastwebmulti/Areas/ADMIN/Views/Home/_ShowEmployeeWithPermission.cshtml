@model Vastwebmulti.Areas.ADMIN.ViewModel.EmployeePermissionViewmodel
@{
    /* Materialise once — prevents double-enumeration of IEnumerable */
    var services = (Model != null && Model.ServicelistALL != null)
                   ? Model.ServicelistALL.ToList()
                   : new List<Vastwebmulti.Models.tbl_permission_Services>();
}

@* NOTE: No <form> here — the main page wraps #tblpermission in the form.
         The hidden EmployeeIDforpart field is also on the main page. *@

<!-- ── Permission Cards Grid ── -->
@if (services.Any())
{
    <div class="vm-ep-grid">
        @foreach (var item in services)
        {
            var chkRead  = item.isRead  == true ? "checked" : "";
            var chkWrite = item.iswrite == true ? "checked" : "";
            var rdClass  = item.isRead  == true ? "vm-ep-chk--checked" : "";
            var wrClass  = item.iswrite == true ? "vm-ep-chk--checked" : "";
            <div class="vm-ep-card">
                <div class="vm-ep-card__head">
                    <i class="fas fa-cogs"></i>
                    <span class="vm-ep-card__name">@item.Servicename</span>
                </div>
                <div class="vm-ep-card__body">
                    <label class="vm-ep-chk @rdClass">
                        <input type="checkbox" name="isRead"
                               id="Read_@item.Servicename"
                               value="Read_@item.Servicename" @chkRead />
                        <span class="vm-ep-chk__box"><i class="fas fa-check"></i></span>
                        <span class="vm-ep-chk__label">Read</span>
                    </label>
                    <label class="vm-ep-chk @wrClass">
                        <input type="checkbox" name="iswrite"
                               id="write_@item.Servicename"
                               value="write_@item.Servicename" @chkWrite />
                        <span class="vm-ep-chk__box"><i class="fas fa-check"></i></span>
                        <span class="vm-ep-chk__label">Write</span>
                    </label>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="vm-emp-perm-empty">
        <i class="fas fa-info-circle"></i>
        <p>No service permissions found for this employee.</p>
    </div>
}

<!-- ── Advanced Permission Section ── -->
<div class="vm-ep-advanced">
    <div class="vm-ep-advanced__head">
        <i class="fas fa-sliders-h"></i>
        <span>Advanced Permissions</span>
    </div>
    <div class="vm-ep-advanced__filters">
        <div class="vm-ep-adv-field">
            <label>Filter Type</label>
            <select id="ddlStatewise" class="form-control vm-opr-select vm-dmt-select">
                <option value="">Select Type</option>
                <option value="Statewise">State Wise</option>
                <option value="Userwise">User Wise</option>
            </select>
        </div>
        <div class="vm-ep-adv-field" id="ddlstatefilldiv">
            <label>User Type</label>
            <select id="ddlstatefill" class="form-control vm-opr-select vm-dmt-select">
                <option value="">Select User</option>
                <option value="master">MASTER Distributor</option>
                <option value="dealer">Distributor</option>
            </select>
        </div>
    </div>
    <div id="advasncepermisionstatewise" class="vm-ep-adv-result" style="display:none;"></div>
</div>

<script>
    /* Checkbox visual toggle — delegated so it works after AJAX injection */
    $(document).off('change.vmEpChk').on('change.vmEpChk', '.vm-ep-chk input[type="checkbox"]', function () {
        var $lbl = $(this).closest('.vm-ep-chk');
        $lbl.toggleClass('vm-ep-chk--checked', $(this).is(':checked'));
    });

    $('#ddlStatewise').off('change.vmEpAdv').on('change.vmEpAdv', function () {
        $('#ddlstatefill').val('');
        $('#advasncepermisionstatewise').hide().empty();
    });

    $('#ddlstatefill').off('change.vmEpAdv2').on('change.vmEpAdv2', function () {
        $('#advasncepermisionstatewise').hide().empty();
        var filterby = $('#ddlStatewise').val();
        var usertype = $(this).val();
        if (!filterby || !usertype) {
            alert('Please select both filter type and user type.');
            $('#ddlStatewise').val(''); $('#ddlstatefill').val('');
            return;
        }
        var empids = '@(Model != null ? Model.EmployeeIDforpart : "0")';
        $('#div_Loader').css('display', 'flex');
        $.ajax({
            url: '@Url.Action("ShowAllstateWisedateBYID", "Home")',
            data: { users: usertype, filterby: filterby, empids: empids },
            type: 'GET',
            success: function (data) {
                $('#advasncepermisionstatewise').show().html(data);
                $('#div_Loader').hide();
            },
            error: function () { $('#div_Loader').hide(); }
        });
    });
</script>
