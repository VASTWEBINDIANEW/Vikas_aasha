@model Vastwebmulti.Areas.ADMIN.ViewModel.GeltALLEmployee
@{
    var empList = (Model != null && Model.Emplist != null)
                  ? Model.Emplist.ToList()
                  : new System.Collections.Generic.List<Vastwebmulti.Models.Select_all_employee_Result>();
}

<table class="table vm-ml-data-table" id="mdList">
    <thead>
        <tr>
            <th>Status</th>
            <th>Employee Name</th>
            <th>Address</th>
            <th>Pincode</th>
            <th>Mobile No</th>
            <th>Joining Date</th>
            <th>Date of Birth</th>
            <th>Email ID</th>
            <th>Aadhaar No</th>
            <th>PAN No</th>
            <th>Email V/F</th>
        </tr>
    </thead>
    <tbody id="body">
        @if (empList.Any())
        {
            foreach (var item in empList)
            {
                var input     = item.AadharCard ?? "";
                var aadharcard = "";
                if (!string.IsNullOrEmpty(input) && input.Length >= 10)
                {
                    aadharcard = "XXXXXXXX" + input.Substring(input.Length - 4, 4);
                }
                else if (!string.IsNullOrEmpty(input))
                {
                    aadharcard = input;
                }

                <tr class="tr">

                    <td>
                        @if (item.Status == true)
                        {
                            <button type="button" class="ne-sts-btn ne-sts-btn--on"
                                    onclick="statusIsActive('@item.EmployeeID')" title="Click to deactivate">
                                <i class="fas fa-toggle-on"></i> Active
                            </button>
                        }
                        else
                        {
                            <button type="button" class="ne-sts-btn ne-sts-btn--off"
                                    onclick="statusIsActive('@item.EmployeeID')" title="Click to activate">
                                <i class="fas fa-toggle-off"></i> Inactive
                            </button>
                        }
                    </td>

                    <td>
                        <div style="display:flex;align-items:center;gap:8px;">
                            <div class="ne-avatar">
                                @(string.IsNullOrEmpty(item.Employee_name) ? "E" : item.Employee_name.Substring(0,1).ToUpper())
                            </div>
                            <span class="ne-name">@item.Employee_name</span>
                        </div>
                    </td>

                    <td class="ne-td-truncate" title="@item.Address">@item.Address</td>
                    <td>@item.Pincode</td>
                    <td class="ne-td-bold">@item.Mobile</td>
                    <td class="ne-td-muted">@(item.JoinDate.HasValue ? item.JoinDate.Value.ToString("dd MMM yyyy") : "-")</td>
                    <td class="ne-td-muted">@(item.DOB.HasValue ? item.DOB.Value.ToString("dd MMM yyyy") : "-")</td>
                    <td class="ne-td-truncate" title="@item.E_mail">@item.E_mail</td>
                    <td class="ne-td-masked">@aadharcard</td>
                    <td class="ne-td-pan">@item.PanCard</td>

                    <td>
                        @if (item.EmailConfirmed == true)
                        {
                            <span class="ne-badge-done"><i class="fas fa-check-circle"></i> Verified</span>
                        }
                        else
                        {
                            <span class="ne-badge-due" onclick="clickVerifyEmail('@item.EmployeeID')"
                                  title="Click to verify email">
                                <i class="fas fa-clock"></i> Verify
                            </span>
                        }
                    </td>

                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="11" class="ne-empty-state">
                    <i class="fas fa-users"></i>
                    <span>No employees found</span>
                </td>
            </tr>
        }
    </tbody>
</table>
