    <div class="modal fade es-modal" id="defaultModal" tabindex="-1" role="dialog" aria-labelledby="defaultModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="es-modal-header">
                    <h4 class="es-modal-header__title" id="defaultModalLabel"><i class="fas fa-pen"></i> Update Sender Email</h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                </div>
                @using (Ajax.BeginForm("Edit_Email_Security", "Home", new AjaxOptions { HttpMethod = "POST", OnSuccess = "SuccessRequest" }))
                {
                    <div class="modal-body es-modal-body">
                        <input type="hidden" id="txtidno" name="idno" />
                        <div class="form-group">
                            <label for="txtemail">Sender Email ID</label>
                            <input type="email" id="txtemail" name="EmailID" class="form-control" required placeholder="Enter Valid Email-ID" />
                        </div>
                        <div class="form-group">
                            <label for="txtpass">Password</label>
                            <input type="password" id="txtpass" name="Paswrd" class="form-control" placeholder="Enter Password." required="required" />
                        </div>
                        <div class="form-group">
                            <label for="txtsmpthost">SMTP Host</label>
                            <input type="text" id="txtsmpthost" name="SMTPHost" class="form-control" placeholder="Enter SMTP Host Name." required="required" />
                        </div>
                        <div class="form-group">
                            <label for="txtport">Mail Server Port</label>
                            <input type="text" id="txtport" name="Port" class="form-control" placeholder="Enter Port Number." required="required" />
                        </div>
                    </div>
                    <div class="modal-footer es-modal-footer">
                        <button type="button" id="MyClose" class="btn es-btn-secondary" data-dismiss="modal">Back</button>
                        <button type="submit" class="btn es-btn-primary" data-loading-text="<i class='fa fa-spinner fa-spin'></i>">Save Change</button>
                    </div>
                }
            </div>
        </div>
    </div>
