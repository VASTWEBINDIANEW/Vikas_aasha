    <script type="text/javascript">
    $(document).ready(function () {
        $("#SaveAll").click(function () {
            var optCode = [];
            $(".for-mail input[name='acs1']").each(function () {
                if ($(this).prop('checked') === true) {
                    optCode.push($(this).val() + ",Y");
                } else {
                    optCode.push($(this).val() + ",N");
                }
            });

            if (!optCode.length) {
                ToastrMessage();
                toastr.error('No email settings found to save.');
                return false;
            }

            var MsgType = "Email's";
            document.getElementById("loadermoney").style.display = "block";

            $.ajax({
                type: "POST",
                url: '@Url.Action("SMSSettingSave", "Home")',
                data: { ch: optCode, MsgType: MsgType },
                cache: false,
                dataType: 'json',
                success: function (data) {
                    document.getElementById("loadermoney").style.display = "none";
                    var pp = data.status;
                    var mm = data.Message;

                    if (pp == "Success") {
                        $.ajax({
                            type: "GET",
                            url: '@Url.Action("Check_UnchekEMAIL_Setting", "Home")',
                            cache: false,
                            dataType: 'html',
                            success: function (resp) {
                                var obj = JSON.parse(resp);
                                for (var item in obj) {
                                    var sts = obj[item].Status;
                                    var name = obj[item].ServiceName;
                                    $("#" + name).prop("checked", sts == "Y");
                                }
                            }
                        });
                        ToastrMessage();
                        toastr.success(mm);
                    } else {
                        ToastrMessage();
                        toastr.error(mm || 'Something went wrong.');
                    }
                },
                error: function () {
                    document.getElementById("loadermoney").style.display = "none";
                    ToastrMessage();
                    toastr.error('Unable to save email settings.');
                }
            });
            return false;
        });

        });
    </script>
    <script>
