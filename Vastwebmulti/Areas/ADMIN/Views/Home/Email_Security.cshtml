    <script type="text/javascript">
    function GetMailList() {
            $.ajax({
            url: '@Url.Action("GetEmailbyId", "Home")',
            type: 'POST',
                data: { idno: 0 },
                success: function (data) {

                    var i = 1;
                    var mdtblHtml = "";
                    $.each(data, function (a, b) {
                        var idno = "subTbl";
                        idno = idno + i;

                        var btnOnOff = "";
                        if (b.Enablessl == "true") {
                            btnOnOff = "<div class='onoffswitch'><span class='costom-on'  onclick=sslOnOff('" + b.idno + "')>ON</span></div>";
                        }
                        else {
                            btnOnOff = "<div class='onoffswitch'><span class='custom-off' onclick=sslOnOff('" + b.idno + "')>OFF</span></div>";
                        }

                        mdtblHtml += "<tr><td style ='border: 1px solid !important;'><p><span style='background: #bbb; font-size: 10px; padding: 0px 5px; margin-right: 2px;'>" + i + "</span>" + b.Smpthost + "</p><p>" + b.Email + "</p></td>";
                     /*   mdtblHtml += "<td style ='border: 1px solid !important;'>********</td>";*/
                        mdtblHtml += "<td style ='border: 1px solid !important;'>" + btnOnOff + "</td>";
                        mdtblHtml += "<td style ='border: 1px solid !important;'><button type='button' class='es-action-btn' onclick=\"editBussMail('" + b.idno + "')\">Edit</button><button type='button' class='es-action-btn es-action-btn--danger' onclick=\"delBussMail('" + b.idno + "')\">Del</button></td>";
                        mdtblHtml += "</tr>";
                        i++;
                    });

                    $('#maillist > tbody').html(mdtblHtml);
            }
        });
    }


    function BussMail() {
        var smtp = $.trim($('#SMTPHost').val() || '');
        var email = $.trim($('#EmailID').val() || '');
        var pass = $.trim($('#Paswrd').val() || '');
        var port = $.trim($('#Port').val() || '');

        if (!smtp || !email || !pass || !port) {
            ToastrMessage();
            toastr.error('Please fill all sender email fields.');
            return;
        }

        $.ajax({
            url: '@Url.Action("Email_Security", "Home")',
            type: 'POST',
            data: { SMTPHost: smtp, EmailID: email, Paswrd: pass, Port: port },
            success: function (data) {
                    if (data.status == "Success") {

                        GetMailList();
                        ToastrMessage();
                        toastr.success(data.Message);
                    }
                    else {
                        ToastrMessage();
                        toastr.error(data.Message);
                    }

                    resetSenderForm();
            }
        });
    }

    function delBussMail(idno) {
            $.ajax({

            url: '@Url.Action("DeleteEmail", "Home")',
            type: 'POST',
            data: { idno: idno },
                success: function (data) {
                    if (data.status == "Success") {

                        GetMailList();
                        ToastrMessage();
                        toastr.success(data.Message);
                    }
                    else {
                        ToastrMessage();
                        toastr.error(data.Message);
                    }
            }
        });
    }

    function sslOnOff(idno) {
            $.ajax({

            url: '@Url.Action("Email_enablessl", "Home")',
            type: 'POST',
            data: { id: idno },
                success: function (data) {
                    if (data.status == "Success") {
                        if (data.Message == "SSL True") {
                            GetMailList();
                            ToastrMessage();
                            toastr.success(data.Message);
                        }
                        else {
                            if (data.Message == "SSL False") {
                                GetMailList();
                                ToastrMessage();
                                toastr.error(data.Message);
                            }
                        }
                    }
                    else {
                        ToastrMessage();
                        toastr.error(data.Message);
                    }
            }
        });
    }

    function editBussMail(idno) {
            $.ajax({
            url: '@Url.Action("GetEmailbyId", "Home")',
            type: 'POST',
                data: { idno: idno },
                success: function (data) {
                    $('#EditBtnidno').val(data.idno);
                    $('#SMTPHost').val(data.Smpthost);
                    $('#EmailID').val(data.Email);
                    $('#Paswrd').val(data.Password);
                    $('#Port').val(data.Port);

                    $('#AddMBtn').addClass('is-hidden');
                    $('#EditBtn').addClass('is-visible');
            }
        });
    }

    function editSaveMail() {
        if (!$('#EditBtnidno').val()) {
            ToastrMessage();
            toastr.error('No sender email selected for update.');
            return;
        }

        $.ajax({
            url: '@Url.Action("Edit_Email_Security", "Home")',
            type: 'POST',
            data: { idno: $('#EditBtnidno').val(), SMTPHost: $('#SMTPHost').val(), EmailID: $('#EmailID').val(), Paswrd: $('#Paswrd').val(), Port: $('#Port').val() },
            success: function (data) {

                    if (data.status == "Success") {

                        GetMailList();
                        ToastrMessage();
                        toastr.success(data.Message);
                    }
                    else {
                        ToastrMessage();
                        toastr.error(data.Message);
                    }

                    $('#EditBtnidno').val('');
                    $('#SMTPHost').val('');
                    $('#EmailID').val('');
                    $('#Paswrd').val('');
                    $('#Port').val('');

                    resetSenderForm();
            }
        });
    }
    </script>

    <script>
        function onlyNumberKey(evt) {

            // Only ASCII charactar in that range allowed
            var ASCIICode = (evt.which) ? evt.which : evt.keyCode
            if (ASCIICode > 31 && (ASCIICode < 48 || ASCIICode > 57))
                return false;
            return true;
        }

        function UpdateCC() {
            var ccMail = $.trim($("#tocc").val() || '');
            if (!ccMail) {
                ToastrMessage();
                toastr.error('Please enter CC email address.');
                return;
            }

            $.ajax({
                type: "POST",
                url: '@Url.Action("UpdateCC", "Home")',
                data: { CCmail: ccMail },
                cache: false,
                dataType: 'json',
                success: function (data) {
                    if (data == "Success") {
                        toastr.success("Your CC mail is Update Successfully.")
                        $("#tocc").val('')
                        $("#showdivv").removeClass('is-open');
                    }
                    else {
                        toastr.error(data);
                    }
                }
            });
        }
        $(document).ready(function () {
            if ($('#Userform1').length) {
                var hiddenDiv = document.getElementById("SelectID");
                if (hiddenDiv) {
                    hiddenDiv.style.display = ($('#Userform1').val() === "") ? "block" : "none";
                }
            }

            $("#btnnshow").on('click', function () {
                $("#showdivv").toggleClass('is-open');
                if ($("#showdivv").hasClass('is-open')) {
                    $("#tocc").trigger('focus');
                }
            });

            $('#txtSubject, #txtMsgBody, #txtEmail').on('keyup change', esToggleSendEmailBtn);
            $('#Userform1').on('change', function () {
                var hiddenDiv = document.getElementById("SelectID");
                if (hiddenDiv) {
                    hiddenDiv.style.display = (this.value === "") ? "block" : "none";
                }
                esToggleSendEmailBtn();
            });
            esToggleSendEmailBtn();
        });

        function esToggleSendEmailBtn() {
            var subject = $.trim($('#txtSubject').val() || '');
            var body = $.trim($('#txtMsgBody').val() || '');
            var userType = $('#Userform1').val();
            var email = $.trim($('#txtEmail').val() || '');
            var canSend = subject && body && (userType || email);
            $('#start_button').prop('disabled', !canSend);
        }
    </script>