    <script>

        function openEmailSecurityModal() {
            var $modal = $('#defaultModal');
            function showModal() {
                if ($modal.length && typeof $.fn.modal === 'function') {
                    $modal.appendTo('body').modal('show');
                }
            }
            if (typeof $.fn.modal === 'function') {
                showModal();
            } else {
                $(window).on('load', showModal);
            }
        }

        function closeEmailSecurityModal() {
            var $modal = $('#defaultModal');
            if ($modal.length && typeof $modal.modal === 'function') {
                $modal.modal('hide');
            }
        }

        function resetSenderForm() {
            $('#EditBtnidno').val('');
            $('#SMTPHost').val('');
            $('#EmailID').val('');
            $('#Paswrd').val('');
            $('#Port').val('');
            $('#AddMBtn').removeClass('is-hidden');
            $('#EditBtn').removeClass('is-visible');
        }

        function SuccessRequest(data) {
            if (data && data.status === "Success") {
                GetMailList();
                ToastrMessage();
                toastr.success(data.Message || "Email Updated Successfully.");
            } else if (data && data.Message) {
                ToastrMessage();
                toastr.error(data.Message);
            }
            closeEmailSecurityModal();
        }

        $(document).ready(function () {
            $("#MyClose").on('click', function () {
                closeEmailSecurityModal();
            });

            $('#defaultModal').on('hidden.bs.modal', function () {
                $('body').removeClass('modal-open');
                $('.modal-backdrop').remove();
            });
        });

    </script>


