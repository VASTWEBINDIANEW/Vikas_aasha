@model IEnumerable<Vastwebmulti.Models.passbyretailerdmt>
@using System
@using System.Linq
@using System.Collections.Generic
@using Vastwebmulti.Models
@{
    ViewBag.Title = "By Pass DMT";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    VastwebmultiEntities db = new VastwebmultiEntities();

    var selectedRetailer = (Request["allretailer"] ?? "").Trim();
    var reports = Model ?? Enumerable.Empty<passbyretailerdmt>();
    var rowCount = reports.Count();
    var onCount = reports.Count(i => i.status == true);
    var offCount = rowCount - onCount;

    var retailerItems = (ViewBag.allretailer as SelectList)?.ToList() ?? new List<SelectListItem>();
    if (!string.IsNullOrEmpty(selectedRetailer))
    {
        foreach (var item in retailerItems)
        {
            item.Selected = string.Equals(item.Value, selectedRetailer, StringComparison.OrdinalIgnoreCase);
        }
    }
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=56" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=36" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-security-report-page saas-passby-retailer-dmt-page">

    <div class="container-fluid vm-opr-page-shell">

        @using (Html.BeginForm("passbyretailerdmtsd", "Home", FormMethod.Post, new { id = "passbyRetailerDmtForm", @class = "vm-rpt-filters-panel__form" }))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line vm-gift-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Settings</li>
                        <li>By Pass DMT</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters vm-ecomm-filter-row--one-line vm-gift-filter-row--one-line vm-passby-dmt-filter-row">

                        <div class="vm-opr-field vm-dmt-field vm-passby-dmt-field--retailer">
                            @Html.DropDownList("allretailer", retailerItems, "All Retailer", new { id = "allretailer", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div class="vm-dmt-filter-search-group">
                            <button type="submit" name="btntype" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

            </div>
        }

        <div class="vm-opr-main-card vm-security-report-main-card vm-gift-report-main-card vm-passby-dmt-main-card">
            <div class="vm-opr-table-panel vm-security-report-table-panel vm-gift-report-table-panel vm-passby-dmt-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head vm-security-report-table-head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-random" aria-hidden="true"></i>
                        <span>Bypass DMT status</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong id="passbyDmtRecordCount">@rowCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total vm-passby-dmt-on-badge" title="Bypass ON retailers">
                            ON: <strong id="passbyDmtOnCount">@onCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total vm-passby-dmt-off-badge" title="Bypass OFF retailers">
                            OFF: <strong id="passbyDmtOffCount">@offCount</strong>
                        </span>
                    </div>
                </div>

                <div class="vm-opr-table-wrap vm-passby-dmt-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="passbyRetailerDmtTable" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Sr.</th>
                                    <th>User</th>
                                    <th>Dealer</th>
                                    <th>Master</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (rowCount == 0)
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="5">No records found for the selected filters.</td>
                                    </tr>
                                }
                                else
                                {
                                    var sr = 1;
                                    var rowIndex = 0;
                                    foreach (var item in reports)
                                    {
                                        var retailer = !string.IsNullOrWhiteSpace(item.userid)
                                            ? db.Retailer_Details.FirstOrDefault(s => s.RetailerId == item.userid)
                                            : null;
                                        var dealer = retailer != null
                                            ? db.Dealer_Details.FirstOrDefault(s => s.DealerId == retailer.DealerId)
                                            : null;
                                        var master = dealer != null
                                            ? db.Superstokist_details.FirstOrDefault(s => s.SSId == dealer.SSId)
                                            : null;

                                        var userFirm = retailer != null ? retailer.Frm_Name : "-";
                                        var userName = retailer != null ? retailer.RetailerName : "-";
                                        var dealerName = dealer != null ? dealer.FarmName : "-";
                                        var masterName = master != null ? master.FarmName : "-";
                                        var isOn = item.status == true;

                                        <tr class="vm-passby-dmt-row @(isOn ? "vm-passby-dmt-row--on" : "vm-passby-dmt-row--off")" data-status="@(isOn ? "on" : "off")">
                                            <td class="vm-passby-dmt-sr">@sr</td>
                                            <td>
                                                <div class="vm-passby-dmt-user">
                                                    <strong class="vm-passby-dmt-user__firm">@userFirm</strong>
                                                    @if (!string.IsNullOrWhiteSpace(userName) && userName != "-")
                                                    {
                                                        <span class="vm-passby-dmt-user__name">@userName</span>
                                                    }
                                                </div>
                                            </td>
                                            <td>@dealerName</td>
                                            <td>@masterName</td>
                                            <td class="vm-passby-dmt-status-cell" data-row-index="@rowIndex">
                                                @if (isOn)
                                                {
                                                    <button type="button" class="vm-passby-dmt-status-pill vm-passby-dmt-status-pill--on vm-passby-dmt-status-pill--btn" onclick="passbyDmtUpdate('@item.userid', @rowIndex, false)"><i class="fas fa-check-circle" aria-hidden="true"></i><span>ON</span></button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="vm-passby-dmt-status-pill vm-passby-dmt-status-pill--off vm-passby-dmt-status-pill--btn" onclick="passbyDmtUpdate('@item.userid', @rowIndex, true)"><i class="fas fa-times-circle" aria-hidden="true"></i><span>OFF</span></button>
                                                }
                                            </td>
                                        </tr>
                                        sr++;
                                        rowIndex++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<script src="~/MainFrontDesign/select2/dist/js/select2.full.min.js"></script>

<script>
    function refreshPassbyDmtSummary() {
        var rows = document.querySelectorAll('#passbyRetailerDmtTable tbody tr.vm-passby-dmt-row');
        var onCount = 0;
        for (var i = 0; i < rows.length; i++) {
            if (rows[i].getAttribute('data-status') === 'on') {
                onCount++;
            }
        }
        $('#passbyDmtRecordCount').text(rows.length);
        $('#passbyDmtOnCount').text(onCount);
        $('#passbyDmtOffCount').text(rows.length - onCount);
    }

    function destroyPassbyDmtSelect2($el) {
        if ($el && $el.length && $el.data('select2')) {
            $el.select2('destroy');
        }
    }

    function applyPassbyDmtSelect2($el) {
        if (!$el || !$el.length || !$.fn.select2) {
            return;
        }
        destroyPassbyDmtSelect2($el);
        $el.select2({
            width: '100%',
            minimumResultsForSearch: 6,
            dropdownParent: $('#passbyRetailerDmtForm')
        });
    }

    function syncPassbyDmtSelectWidth() {
        $('.vm-passby-dmt-field--retailer').css({ width: '100%', maxWidth: '100%' });
        $('#allretailer').css({ width: '100%', maxWidth: '100%' });
        $('#passbyRetailerDmtForm .select2-container').css({ width: '100%', maxWidth: '100%' });
    }

    function initPassbyDmtSelect2() {
        applyPassbyDmtSelect2($('#allretailer'));
        window.setTimeout(syncPassbyDmtSelectWidth, 0);
        window.setTimeout(syncPassbyDmtSelectWidth, 120);
    }

    function passbyDmtUpdate(userid, rowIndex, nextStatus) {
        $.ajax({
            url: '@Url.Action("passbyupdate", "Home")',
            type: 'POST',
            data: { userid: userid, sts: nextStatus },
            cache: false,
            success: function (response) {
                if (response !== 'OK') {
                    return;
                }

                var $cell = $('.vm-passby-dmt-status-cell[data-row-index="' + rowIndex + '"]');
                var $row = $cell.closest('tr');
                if (nextStatus === true) {
                    $cell.html('<button type="button" class="vm-passby-dmt-status-pill vm-passby-dmt-status-pill--on vm-passby-dmt-status-pill--btn" onclick="passbyDmtUpdate(\'' + userid + '\', ' + rowIndex + ', false)"><i class="fas fa-check-circle" aria-hidden="true"></i><span>ON</span></button>');
                    $row.removeClass('vm-passby-dmt-row--off').addClass('vm-passby-dmt-row--on').attr('data-status', 'on');
                } else {
                    $cell.html('<button type="button" class="vm-passby-dmt-status-pill vm-passby-dmt-status-pill--off vm-passby-dmt-status-pill--btn" onclick="passbyDmtUpdate(\'' + userid + '\', ' + rowIndex + ', true)"><i class="fas fa-times-circle" aria-hidden="true"></i><span>OFF</span></button>');
                    $row.removeClass('vm-passby-dmt-row--on').addClass('vm-passby-dmt-row--off').attr('data-status', 'off');
                }
                refreshPassbyDmtSummary();
            }
        });
    }

    $(document).ready(function () {
        initPassbyDmtSelect2();
        refreshPassbyDmtSummary();
        $(window).on('resize orientationchange', syncPassbyDmtSelectWidth);
    });
</script>
