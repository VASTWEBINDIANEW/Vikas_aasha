@model Vastwebmulti.Areas.ADMIN.Models.FlightSlab
@using (Ajax.BeginForm("_common_Flight", "Home", new AjaxOptions { HttpMethod = "POST", OnSuccess = "OnSuccess", UpdateTargetId = "divEditFormComm", LoadingElementId = "div_Loader", InsertionMode = InsertionMode.Replace }))
{
    <input id="btnsubmit" type="submit" value="Save Data" class="btn waves-effect vm-pg-slab-save-btn" style="display:none;" />

    <div class="vm-pg-slab-table-scroll saas-acc-table-wrap vm-dmt2-slab-table-scroll vm-prepaid-slab-table-wrap">
    <table id="flightSlabTable" class="table table-bordered vm-pg-slab-table vm-dmt2-slab-table third-design-table slab-table example-second">
        <thead>
            <tr>
                <th>User&nbsp;&&nbsp;Purchase</th>
                <th>Flight&nbsp;Type</th>
                <th>Charge&nbsp;&&nbsp;Sharing(%)</th>
                @*<th>Retailer&nbsp;Markup&nbsp;</th>
                    <th>GST(%)</th>
                    <th>TDS(%)</th>*@
                @*<th>Gst</th>*@
            </tr>
        </thead>
        <tbody id="tbodyshow" class="vm-pg-slab-tbody--view">
            @foreach (var item in Model.common)
            {
                var type = "% Share"; var jj = " - Offered Fare MarkUP";
                var usertype = item.Role; var backcolor = "";var color = "";
                if(usertype== "Retailer" || usertype== "Whitelabel")
                {
                    type = "% Charge";
                    usertype = usertype + "" + jj;
                    backcolor = "Black";
                    color = "White";
                }
                if (usertype == "Dealer")
                {
                    usertype = "Distributor";
                }
                <tr style="background-color:@backcolor;color:@color">
                    <td>@usertype</td>
                    <td>@string.Format("{0}", item.IsDomestic ? "Domestic" : "International")</td>
                    <td>@item.marginPercentage &nbsp; @type</td>
                   
                </tr>
            }

        </tbody>
        <tbody id="tbodyedit" class="vm-pg-slab-tbody--hidden">
            @for (int i = 0; i < Model.common.Count; i++)
            {
                var type = "% Share"; var jj = " - Offered Fare MarkUP";
                var backcolor = ""; var color = "";
                var name = Model.common[i].Role;
                if (name == "Dealer")
                {
                    name = "Distributor";
                }
                if (name == "Retailer" || name == "Whitelabel")
                {
                    type = "% Charge";
                    name = name + "" + jj;
                    backcolor = "Black";
                    color = "White";
                }
                <tr style="background-color:@backcolor;color:@color">
                    @Html.HiddenFor(a => a.common[i].idno)
                    @Html.HiddenFor(a => a.common[i].Email)
                    @Html.HiddenFor(a => a.common[i].UserId)
                    @Html.HiddenFor(a => a.common[i].IsDomestic)
                    @*@Html.HiddenFor(a => a[i].RetailerMarkupCharge)*@
                    <td>


                        @name
                    </td>
                    <td>@string.Format("{0}", Model.common[i].IsDomestic ? "Domestic" : "International")</td>
                    <td>
                        <div>
                            @if (Model.common[i].Role == "Retailer" || Model.common[i].Role == "Whitelabel")
                            {
                                @Html.DropDownListFor(a => a.common[i].marginPercentage, new List<SelectListItem>
                                {
                                new SelectListItem{Text="0.00%",Value="0.00",Selected= Model.common[i].marginPercentage==Convert.ToDecimal(0.00)? true:false},
                                new SelectListItem{Text="0.25%",Value="0.25",Selected= Model.common[i].marginPercentage==Convert.ToDecimal(0.25)? true:false},
                                new SelectListItem{Text="0.50%",Value="0.50",Selected= Model.common[i].marginPercentage==Convert.ToDecimal(0.50)? true:false},
                                new SelectListItem{Text="0.75%",Value="0.75",Selected= Model.common[i].marginPercentage==Convert.ToDecimal(0.75)? true:false},
                                new SelectListItem{Text="1.00%",Value="1.00",Selected= Model.common[i].marginPercentage==Convert.ToDecimal(1.00)? true:false},
                                new SelectListItem{Text="1.25%",Value="1.25",Selected= Model.common[i].marginPercentage==Convert.ToDecimal(1.25)? true:false},
                                new SelectListItem{Text="1.50%",Value="1.50",Selected= Model.common[i].marginPercentage==Convert.ToDecimal(1.50)? true:false}
                                 }, "Select Commission", new { @class = "form-control", @style = "padding:0px; -webkit-appearance:none;" })
                            }
                            else
                            {
                                @Html.TextBoxFor(aa => aa.common[i].marginPercentage, new { @class = "form-control", @style = "padding:0px; -webkit-appearance:none;" })
                            }
                        </div>
                        @*@Html.EditorFor(a => a[i].marginPercentage, new { htmlAttributes = new { @style = "width:100%" } })*@
                        @Html.ValidationMessageFor(a => a.common[i].marginPercentage)
                    </td>
                    @*<td>
                    @Html.DisplayFor(a => a[i].RetailerMarkupCharge)
                </td>*@
                    @*<td>
                    @Html.EditorFor(a => a[i].gst, new { htmlAttributes = new { @style = "width:100%" } })
                    @Html.ValidationMessageFor(a => a[i].gst)
                </td>
                <td>
                    @Html.EditorFor(a => a[i].tds, new { htmlAttributes = new { @style = "width:100%" } })
                    @Html.ValidationMessageFor(a => a[i].tds)
                </td>*@

                    @*<td>
                    @Html.EditorFor(a => a.common[i].gst, new { htmlAttributes = new { @style = "width:100%" } })
                    @Html.ValidationMessageFor(a => a.common[i].gst)
                </td>*@
                </tr>
            }

        </tbody>
    </table>
    </div>
}

<script>
    function OnSuccess() {
        $('#btnsubmit').hide().removeClass('is-visible');
        $('#btnEdit').show().removeClass('is-hidden');
        if (typeof resetSlabViewMode === 'function') {
            resetSlabViewMode();
        }
    }
</script>