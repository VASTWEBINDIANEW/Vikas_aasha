@model IEnumerable<Vastwebmulti.Areas.ADMIN.ViewModel.Sending_SMS_TemplatesViewmodel>
<table id="tbldata" data-hrefscroll="" class="table table-bordered table-striped table-hover third-design-table">
    <thead>
        <tr>
            <th>SMS FOR</th>
            <th>Template</th>
            <th>Template ID</th>
            <th>SMS API</th>
            <th>Uploaded</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model.OrderByDescending(x => x.idno))
        {
            var apiUrl = item.SMSAPI ?? string.Empty;
            var apiDisplay = apiUrl.Contains("?") ? apiUrl.Substring(0, apiUrl.IndexOf('?')) : apiUrl;
            <tr>
                <td>@item.SMS_TYPE</td>
                <td><p class="sa-template-cell-text">@item.Templates</p></td>
                <td>@item.Templateid</td>
                <td><p class="sa-template-cell-text">@apiDisplay</p></td>
                <td>@item.UploadBy</td>
                <td class="sa-template-action-cell">
                    <button type="button" class="sa-delete-btn sa-template-delete-btn" data-id="@item.idno" title="Delete template">
                        <img class="before-delete" src="~/MainFrontDesign/images/delete.svg" alt="Delete" width="16" height="16" />
                        <span class="after-delete sa-delete-confirm">Sure?</span>
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>
