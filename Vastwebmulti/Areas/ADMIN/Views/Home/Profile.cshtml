@model Vastwebmulti.Models.User
@using Vastwebmulti.Models;
@using RestSharp;
@using System;
@using System.Collections.Generic;
@using System.Data;
@using System.Data.Entity.Validation;
@using System.IO;
@using System.Linq;
@using System.Net;
@using System.Text;
@using System.Threading.Tasks;
@using System.Web;
@using System.Web.Mvc;
@using System.Web.Script.Serialization;
@using System.Web.UI.WebControls;
@using Vastwebmulti.Areas.ADMIN.Controllers;
@using Vastwebmulti.Areas.WHITELABEL.Models;
@using Vastwebmulti.Models;



@{
    ViewBag.Title = "Profile";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var passcodeset = ViewBag.passcodesetings;

    var masterpasscodeset = ViewBag.masterpasscodesetings;
    var dealerpasscodesetings = ViewBag.dealerpasscodesetings;
    var Retailerpasscodesetings = ViewBag.Retailerpasscodesetings;
    var APIpasscodesetings = ViewBag.APIpasscodesetings;
    var Whitelabelpasscodesetings = ViewBag.Whitelabelpasscodesetings;
    var roleStatusList = ViewBag.RoleStatus as List<Vastwebmulti.Models.AdminProfileAllUserOTP>
        ?? new List<Vastwebmulti.Models.AdminProfileAllUserOTP>();
    
}



<link href="~/MainFrontDesign/css/admin-profile-modern.css?v=16" rel="stylesheet" />


<section class="content fourdesign-section-admin saas-admin-account-page saas-admin-profile-page saas-prof-page"
         data-update-support-url="@Url.Action("UpdateSupportData", "Home")"
         data-profile-url="@Url.Action("Profile", "Home")"
         data-otp-list-url="@Url.Action("GetTwoFactor", "Home")"
         data-otp-user-url="@Url.Action("DisablePassCodeBYUserID", "Home")"
         data-otp-role-url="@Url.Action("DisableTwoFactor", "Home")"
         data-otp-status-url="@Url.Action("AdminOTPStatus", "Home")">

    <div class="container-fluid saas-profile-container">

        <div class="saas-acc-toolbar saas-profile-toolbar">
            <ol class="saas-acc-breadcrumb">
                <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                <li>Profile</li>
            </ol>
            <div class="saas-profile-page-head">
                <h1 class="saas-profile-page-title"><i class="fas fa-user-circle" aria-hidden="true"></i> Admin Profile</h1>
                <p class="saas-profile-page-desc">Manage company details, security, documents and support settings</p>
            </div>
        </div>

        <div class="row clearfix saas-prof-layout">
            <div class="col-md-4 col-sm-12 saas-prof-layout__aside">
                <article class="saas-prof-card saas-prof-card--identity">
                    <div class="saas-prof-identity__hero">
                        <div class="saas-prof-identity__avatar-wrap">
                            @if (!string.IsNullOrWhiteSpace(ViewBag.image))
                            {
                                <div class="image" style="margin-top:24px;">
                                    <img id="Adminimage" src="@Url.Content("~/" + ViewBag.image)" class="saas-prof-identity__avatar" alt="User" title="Click to upload profile photo" onclick="uploadimage(@ViewBag.admin.ID)" />
                                </div>
                            }
                            else
                            {
                                <div class="image" style="margin-top:24px;">
                                    <img id="Adminimage" src="~/AdminDesign/images/user.png" class="saas-prof-identity__avatar" alt="User" title="Click to upload profile photo" onclick="uploadimage(@ViewBag.admin.ID)">
                                </div>
                            }

                            <h2 class="saas-prof-identity__name">@ViewBag.admin.Name</h2>
                            <p class="saas-prof-identity__role">Administrator</p>
                        </div>
                    </div>

                    <div class="saas-prof-identity__action">

                        <h3 class="saas-prof-identity__action-title"><i class="fas fa-coins" aria-hidden="true"></i> Auto Credit</h3>

                        @{
                            VastwebmultiEntities db = new VastwebmultiEntities();
                            var emailPassRow = db.Email_show_passcode.FirstOrDefault();
                            var set = emailPassRow != null && emailPassRow.cr_status == true;
                        }
                        @if (set == true)
                        {
                            @Html.ActionLink("ON", "CreaditSetting", "ADMIN", new { @class = "saas-prof-pill saas-prof-pill--success" })
                            
                        }
                        else
                        {
                            @Html.ActionLink("OFF", "CreaditSetting", "ADMIN", new { @class = "saas-prof-pill saas-prof-pill--danger" })
                            
                        }
                    </div>

                    <div class="saas-prof-identity__action">

                        <h3 class="saas-prof-identity__action-title"><i class="fas fa-satellite-dish" aria-hidden="true"></i> Rediant Status</h3>

                        @{

                            var set1 = db.rediantdistresponses.ToList();
                            var set2 = db.radiantauths.ToList();
                        }
                        @if (set1.Count == 0)
                        {
                            if (set2.Count == 0)
                            {
                                <span class="saas-prof-pill saas-prof-pill--warn">Auth required</span>
                            }
                            else
                            {
                            @Html.ActionLink("Create Distributor", "rediantdisform", "ADMIN", new { @class = "saas-prof-pill saas-prof-pill--primary" })
                            }
                        }
                        else if (set1.Count > 0 && set1[0].status == "Approved")
                        {
                            <span class="saas-prof-pill saas-prof-pill--success">Approved</span>
                        }
                        else if (set1.Count > 0)
                        {
                            <div id="redfull" class="saas-rediant-status">  <div id="redtext" class="saas-prof-pill saas-prof-pill--warn">@set1[0].status</div> <div id="redbutton"><button type="button" class="saas-prof-btn-sm" onclick="checkrediantsts();">Check Status</button></div> </div>
                        }
                        <script>
                           function checkrediantsts() {
                               $.ajax({
                                type: "POST", url: '@Url.Action("checkrediantdissts", "Home")',
                          
                                   cache: false,
                                   success: function (data) {
                                       alert(data);
                                       if (data == "Approved") {
                                        document.getElementById('redfull').innerHTML = "APPROVED";

                                    }

                                }
                            });
                        }
                        </script>
                    </div>
                </article>

            </div>

            <div class="col-lg-8 col-md-8 col-sm-12 col-xs-12 saas-prof-layout__main saas-prof-layout__main--overview">

                <div id="profileOverviewRow" class="saas-prof-overview-row">

                    <div id="saveaddressModal" class="saas-prof-overview-col saas-prof-overview-col--company">
                        <article class="saas-prof-card saas-prof-card--company">
                            <header class="saas-prof-card__head">
                                <div class="saas-prof-overview-head">
                                    <span class="saas-prof-overview-icon" aria-hidden="true"><i class="fas fa-building"></i></span>
                                    <div class="saas-prof-overview-head-text">
                                        <p class="saas-prof-overview-kicker">Company</p>
                                        <h2 class="saas-prof-card__title" id="spncompny">@(string.IsNullOrWhiteSpace(ViewBag.admin.Companyname as string) ? "No company name" : ViewBag.admin.Companyname)</h2>
                                    </div>
                                    <button type="button" class="editprofile-second" onclick="editeaddress(@ViewBag.admin.ID)"><i class="fas fa-pen" aria-hidden="true"></i> Edit</button>
                                </div>
                            </header>
                            <div id="saasProfCompanyView" class="saas-prof-card__body saas-prof-company__view">
                                <h3 class="saas-prof-block-title"><i class="fas fa-map-marker-alt" aria-hidden="true"></i> Registered Business Address</h3>
                                <dl class="saas-prof-info-grid">
                                    <div class="saas-prof-info-row saas-prof-info-row--full">
                                        <dt>Address</dt>
                                        <dd id="spnaddress">@(string.IsNullOrWhiteSpace(ViewBag.admin.Address as string) ? "Address not found" : ViewBag.admin.Address)</dd>
                                    </div>
                                    <div class="saas-prof-info-row">
                                        <dt>Zip Code</dt>
                                        <dd id="spnpincode">@(ViewBag.admin.pincode ?? "�")</dd>
                                    </div>
                                    <div class="saas-prof-info-row">
                                        <dt>State</dt>
                                        <dd id="spnstate">@ViewBag.ddlstate</dd>
                                    </div>
                                    <div class="saas-prof-info-row">
                                        <dt>District</dt>
                                        <dd id="spndistrict">@ViewBag.dddistrict</dd>
                                    </div>
                                </dl>
                            </div>

                            <div id="EditaddressModal" class="saas-prof-card__body saas-prof-company__edit" style="display:none;">
                                @using (Ajax.BeginForm("UpdateAddressProfile", "Home", new AjaxOptions
                                {
                                    InsertionMode = InsertionMode.Replace,
                                    OnSuccess = "OnSuccessEditAddress",
                                    OnFailure = "OnFailure"
                                }))
                                {
                                    <input type="hidden" id="hdidadmin" name="hdidadmin" value="" />
                                    <div class="saas-prof-edit-toolbar">
                                        <button type="submit" class="saas-prof-btn saas-prof-btn--primary"><i class="fas fa-check" aria-hidden="true"></i> Save</button>
                                        <button type="button" class="saas-prof-btn saas-prof-btn--muted" onclick="saasProfCancelAddressEdit()">Cancel</button>
                                    </div>
                                    <div class="saas-prof-form-grid saas-prof-form-grid--address">
                                        <div class="saas-prof-form-field saas-prof-form-field--full">
                                            <label>Company Name</label>
                                            @Html.TextBox("txtcompany", "", new { @class = "form-control", placeholder = "Enter company name", required = "required" })
                                        </div>
                                        <div class="saas-prof-form-field saas-prof-form-field--full">
                                            <label>Registered Business Address</label>
                                            @Html.TextBox("txtaddress", "", new { @class = "form-control", placeholder = "Enter full address", required = "required" })
                                        </div>
                                        <div class="saas-prof-form-field">
                                            <label>Zip Code</label>
                                            @Html.TextBox("txtzipcode", "", new { @required = "required", @class = "form-control", @placeholder = "Enter zip code", onkeypress = "return isNumber(event)" })
                                        </div>
                                        <div class="saas-prof-form-field">
                                            <label>State</label>
                                            @Html.DropDownList("State", (IEnumerable<SelectListItem>)ViewBag.Sate, "-- Select State --", new { @class = "form-control", @required = "required", @onchange = "FillDistict()" })
                                        </div>
                                        <div class="saas-prof-form-field saas-prof-form-field--full">
                                            <label>District</label>
                                            @Html.DropDownList("District", (IEnumerable<SelectListItem>)ViewBag.District, "-- Select District --", new { @class = "form-control" })
                                        </div>
                                    </div>
                                }
                            </div>
                        </article>
                    </div>

                    <div class="saas-prof-overview-col saas-prof-overview-col--account">
                        @{
                            var launchDateDisplay = "�";
                            if (ViewBag.admin.Date != null)
                            {
                                launchDateDisplay = ((DateTime)ViewBag.admin.Date).ToString("dd-MM-yyyy HH:mm:ss");
                            }
                            var aadharDisplay = "Data Not Found !";
                            if (ViewBag.admin.Aadhar != null && ViewBag.admin.Aadhar != "")
                            {
                                var aadharRaw = ViewBag.admin.Aadhar as string;
                                if (aadharRaw != null && aadharRaw.Length >= 4)
                                {
                                    aadharDisplay = new string('X', 8) + aadharRaw.Substring(aadharRaw.Length - 4, 4);
                                }
                            }
                        }
                        <article class="saas-prof-card saas-prof-card--account">
                            <header class="saas-prof-card__head saas-prof-card__head--launch">
                                <div class="saas-prof-overview-head">
                                    <span class="saas-prof-overview-icon saas-prof-overview-icon--calendar" aria-hidden="true"><i class="fas fa-calendar-check"></i></span>
                                    <div class="saas-prof-overview-head-text">
                                        <p class="saas-prof-overview-kicker">Website</p>
                                        <h2 class="saas-prof-card__title">Launching Date</h2>
                                    </div>
                                    <button type="button" class="editprofile-second" onclick="editemobileandpancard(@ViewBag.admin.ID)"><i class="fas fa-pen" aria-hidden="true"></i> Edit</button>
                                </div>
                                <p class="saas-prof-launch-date" id="lblLaunchDateDisplay">@launchDateDisplay</p>
                                <p class="saas-prof-launch-hint">Website go-live date (read-only)</p>
                            </header>

                            <div class="saas-prof-card__body saas-prof-details__view">
                                <dl class="saas-prof-info-grid saas-prof-info-grid--account">
                                    <div class="saas-prof-info-row">
                                        <dt>Name</dt>
                                        <dd id="lbladminname">@(ViewBag.admin.Name ?? "Data Not Found !")</dd>
                                    </div>
                                    <div class="saas-prof-info-row">
                                        <dt>Email-ID</dt>
                                        <dd id="lbladminemail">@(ViewBag.admin.email ?? "Data Not Found !")</dd>
                                    </div>
                                    <div class="saas-prof-info-row">
                                        <dt>Mobile</dt>
                                        <dd id="lbladminmobile">@(ViewBag.admin.mobile ?? "Data Not Found !")</dd>
                                    </div>
                                    <div class="saas-prof-info-row">
                                        <dt>Aadharcard</dt>
                                        <dd id="lbladminaadhar">@aadharDisplay</dd>
                                    </div>
                                    <div class="saas-prof-info-row">
                                        <dt>Pancard</dt>
                                        <dd id="lbladminpencard">@(string.IsNullOrWhiteSpace(ViewBag.admin.pencardno as string) ? "Data Not Found !" : ViewBag.admin.pencardno)</dd>
                                    </div>
                                    <div class="saas-prof-info-row">
                                        <dt>GST No</dt>
                                        <dd id="lbladmingst">@(string.IsNullOrWhiteSpace(ViewBag.admin.Gstno as string) ? "Data Not Found !" : ViewBag.admin.Gstno)</dd>
                                    </div>
                                    <div class="saas-prof-info-row">
                                        <dt>TAN No.</dt>
                                        <dd id="lbladmintan">@(string.IsNullOrWhiteSpace(ViewBag.admin.tanno as string) ? "Data Not Found !" : ViewBag.admin.tanno)</dd>
                                    </div>
                                    <div class="saas-prof-info-row saas-prof-info-row--full">
                                        <dt>Business Registration No.</dt>
                                        <dd id="lbladminregistration">@(string.IsNullOrWhiteSpace(ViewBag.admin.registrationno as string) ? "Data Not Found !" : ViewBag.admin.registrationno)</dd>
                                    </div>
                                </dl>
                            </div>

                            <div id="EditnameandpancardModal" class="saas-prof-card__body saas-prof-details__edit" style="display:none;">
                                @using (Ajax.BeginForm("UpdatePanccardandmobile", "Home", new AjaxOptions { HttpMethod = "POST", OnSuccess = "UpdateProfilesOnsucc", OnBegin = "ajaxValidate()" }))
                                {
                                    <div class="saas-prof-edit-toolbar">
                                        <button type="submit" class="saas-prof-btn saas-prof-btn--primary"><i class="fas fa-check" aria-hidden="true"></i> Save</button>
                                        <button type="button" class="saas-prof-btn saas-prof-btn--muted" onclick="saasProfCancelDetailsEdit()">Cancel</button>
                                    </div>
                                    <input type="hidden" id="hdid1" name="hdid1" value="0" />
                                    <div class="saas-prof-form-field saas-prof-form-field--full saas-prof-form-field--readonly">
                                        <label>Website Launching Date</label>
                                        <input type="text" id="txtLaunchDateReadonly" class="form-control" readonly="readonly" value="@launchDateDisplay" />
                                    </div>
                                    <div class="saas-prof-form-grid">
                                        <div class="saas-prof-form-field">
                                            <label>Name</label>
                                            @Html.TextBox("txtname", "", new { @class = "form-control", placeholder = "Enter your name", required = "required" })
                                        </div>
                                        <div class="saas-prof-form-field">
                                            <label>Mobile</label>
                                            @Html.TextBox("txtmobile", "", new { @class = "form-control", placeholder = "Enter mobile number", onkeypress = "return isNumber(event)", maxlength = "10" })
                                        </div>
                                        <div class="saas-prof-form-field">
                                            <label>Aadharcard</label>
                                            @Html.TextBox("txtaadhaarcard", "", new { @class = "form-control", placeholder = "Enter Aadhaar number", onkeypress = "return isNumber(event)", maxlength = "12" })
                                        </div>
                                        <div class="saas-prof-form-field">
                                            <label>Pancard</label>
                                            @Html.TextBox("txtpancard", "", new { @class = "form-control", placeholder = "Enter PAN", maxlength = "10", style = "text-transform:uppercase" })
                                        </div>
                                        <div class="saas-prof-form-field">
                                            <label>GST No</label>
                                            @Html.TextBox("txtgst", "", new { @class = "form-control", placeholder = "Enter GST number", maxlength = "15", style = "text-transform:uppercase" })
                                        </div>
                                        <div class="saas-prof-form-field">
                                            <label>TAN No</label>
                                            @Html.TextBox("txtTAN", "", new { @class = "form-control", placeholder = "Enter TAN", maxlength = "15", style = "text-transform:uppercase" })
                                        </div>
                                        <div class="saas-prof-form-field saas-prof-form-field--full">
                                            <label>Business Registration No</label>
                                            @Html.TextBox("txtregistration", "", new { @class = "form-control", placeholder = "Enter registration number", maxlength = "15", style = "text-transform:uppercase" })
                                        </div>
                                    </div>
                                    <label id="lblmsg" class="saas-prof-form-msg"></label>
                                }
                            </div>
                        </article>
                    </div>

                </div>

            </div>

        </div>

        <div class="row clearfix saas-prof-layout saas-prof-layout--stack saas-prof-layout--stack-full">
            <div class="col-md-12 col-sm-12 saas-prof-layout__stack-main saas-prof-layout__stack-full">
                <article class="saas-prof-card saas-prof-card--security">
                    <header class="saas-prof-card__head saas-prof-card__head--security">
                        <h2 class="saas-prof-card__title"><i class="fas fa-shield-alt" aria-hidden="true"></i> Security Settings</h2>
                    </header>
                    <div class="saas-prof-card__body saas-prof-security-wrap">
                        <ul class="saas-prof-sec-grid">
                                <li class="saas-prof-sec-item saas-prof-sec-item--admin">
                                    <p class="saas-prof-sec-label"><i class="fa fa-lock" aria-hidden="true"></i> Admin Security</p>
                                    <div class="saas-prof-sec-control">
                                        <div class="saas-prof-sec-select-wrap">
                                            <span id="adminoff" class="saas-prof-sec-dot saas-prof-sec-dot--off securtyoff-show"></span>
                                            <span id="adminon" class="saas-prof-sec-dot saas-prof-sec-dot--on securtyon-show" style="display:none;"></span>
                                            <select id="Sortby" name="Sortby" class="profileseclet form-control vm-no-select2">
                                                <option value="OFF">SECURITY OFF</option>
                                                <option value="OTP">LOGIN OTP</option>
                                                <option value="PERDAY">DAY PASSCODE</option>
                                                <option value="WEAKS">WEAKLY PASSCODE</option>
                                                <option value="MONTHS">MONTH PASSCODE</option>
                                            </select>
                                        </div>
                                    </div>
                                    <div class="onoffswitch onofswicnewaddclass saas-prof-sec-hidden-toggle" id="UserWiseOTPbtn" style="display:none;">
                                        @if (Model.TwoFactorEnabled)
                                        {
                                            using (Html.BeginForm("DisableTwoFactorAuthentication", "Manage", new { area = "" }, FormMethod.Post, new { encType = "multipart/form-data" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="costom-on" value="ON" id="btnon" name="btnon">ON</button>
                                            }
                                        }
                                        else
                                        {
                                            using (Html.BeginForm("EnableTwoFactorAuthentication", "Manage", new { area = "" }, FormMethod.Post, new { encType = "multipart/form-data" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="custom-off" value="Off" id="btnff" name="btnff">OFF</button>
                                            }
                                        }
                                    </div>
                                </li>
                                <li class="saas-prof-sec-item">
                                    <p class="saas-prof-sec-label">Master Security</p>
                                    <div class="saas-prof-sec-control">
                                        <div class="saas-prof-sec-select-wrap">
                                            <span id="masteroff" class="saas-prof-sec-dot saas-prof-sec-dot--off securtyoff-show"></span>
                                            <span id="masteron" class="saas-prof-sec-dot saas-prof-sec-dot--on securtyon-show" style="display:none;"></span>
                                            <select id="Sortbymaster" name="Sortbymaster" class="profileseclet form-control vm-no-select2">
                                                <option value="OFF">SECURITY OFF</option>
                                                <option value="OTP">LOGIN OTP</option>
                                                <option value="PERDAY">DAY PASSCODE</option>
                                                <option value="WEAKS">WEAKLY PASSCODE</option>
                                                <option value="MONTHS">MONTH PASSCODE</option>
                                            </select>
                                        </div>
                                        <button type="button" onclick="GetUser('master')" class="saas-prof-users-btn" title="View users"><i class="fas fa-users" aria-hidden="true"></i></button>
                                    </div>

                                    <div class="onoffswitch saas-prof-sec-hidden-toggle" id="masterref">
                                        @if (roleStatusList.Count > 0 && roleStatusList[0].RoleName == "master")
                                        {

                                            if (roleStatusList[0].Status == "N")
                                            {
                                                <button class="custom-off change-class" id="masterotpoff" onclick="RoleWiseOTP('master','Y')" style="border:1px solid;display:none;width: 100%;">
                                                    OFF
                                                </button>
                                                <i class="fa fa-circle-o-notch fa-spin onofloaderclass" id="dealeronloaderq"></i>
                                            }
                                            else
                                            {
                                                <button class="costom-on change-class" id="masterotpon" onclick="RoleWiseOTP('master','N')" style="border:1px solid;display:none;width: 100%;">ON</button>
                                                <i class="fa fa-circle-o-notch fa-spin onofloaderclass" id="dealeronloaderq"></i>
                                            }

                                        }
                                    </div>




                                </li>
                                <li class="saas-prof-sec-item">
                                    <p class="saas-prof-sec-label">Distributor Security</p>
                                    <div class="saas-prof-sec-control">
                                        <div class="saas-prof-sec-select-wrap">
                                            <span id="dealeroff" class="saas-prof-sec-dot saas-prof-sec-dot--off securtyoff-show"></span>
                                            <span id="dealeron" class="saas-prof-sec-dot saas-prof-sec-dot--on securtyon-show" style="display:none;"></span>
                                            <select id="Sortbydealer" name="Sortbydealer" class="profileseclet form-control vm-no-select2">
                                                <option value="OFF">SECURITY OFF</option>
                                                <option value="OTP">LOGIN OTP</option>
                                                <option value="PERDAY">DAY PASSCODE</option>
                                                <option value="WEAKS">WEAKLY PASSCODE</option>
                                                <option value="MONTHS">MONTH PASSCODE</option>
                                            </select>
                                        </div>
                                        <button type="button" onclick="GetUser('Dealer')" class="saas-prof-users-btn" title="View users"><i class="fas fa-users" aria-hidden="true"></i></button>
                                    </div>
                                    <div class="onoffswitch saas-prof-sec-hidden-toggle dealerotpoffclass">
                                        @if (roleStatusList.Count > 1 && roleStatusList[1].RoleName == "Dealer")
                                        {
                                            if (roleStatusList[1].Status == "N")
                                            {
                                                <button class="custom-off" id="dealerotpoff" onclick="RoleWiseOTP('Dealer','Y')" style="border:1px solid;display:none;width: 100%;">OFF</button>
                                                <i class="fa fa-circle-o-notch fa-spin onofloaderclass" id="dealeronloader"></i>
                                            }
                                            else
                                            {
                                                <button class="costom-on" id="dealerotpon" onclick="RoleWiseOTP('Dealer','N')" style="border:1px solid;display:none;width: 100%;">ON</button>
                                                <i class="fa fa-circle-o-notch fa-spin onofloaderclass" id="dealeronloader"></i>
                                            }

                                        }
                                    </div>

                                </li>
                                <li class="saas-prof-sec-item">
                                    <p class="saas-prof-sec-label">Retailer Security</p>
                                    <div class="saas-prof-sec-control">
                                        <div class="saas-prof-sec-select-wrap">
                                            <span id="retaileroff" class="saas-prof-sec-dot saas-prof-sec-dot--off securtyoff-show"></span>
