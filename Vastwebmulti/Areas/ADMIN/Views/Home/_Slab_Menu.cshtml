<script>
    $(document).ready(function () {
        var current = location.pathname;
        current = current.replace("Money_Transfer_Slab_DMT1", "Money_Transfer_Slab_DMT2");
        current = current.replace("Money_Transfer_Slab_UPI", "Money_Transfer_Slab_DMT2");
        current = current.replace("dmtSlab", "Money_Transfer_Slab_DMT2");
        current = current.replace("DmtSlabPPI", "Money_Transfer_Slab_DMT2");
        current = current.replace("M_Poss", "Money_Transfer_Slab_DMT2");
        current = current.replace("Micro_Atm", "Money_Transfer_Slab_DMT2");
        current = current.replace("MIcroatm_Cash_Slab", "Money_Transfer_Slab_DMT2");
        current = current.replace("AepsSlab", "Money_Transfer_Slab_DMT2");
        current = current.replace("Pancard_Slab_Setting", "Money_Transfer_Slab_DMT2");
        current = current.replace("BUS_Slab", "Flight_Slab");
        current = current.replace("Hotel_Slab", "Flight_Slab");
        $('#vmSlabCategoryNav ul li a').each(function () {
            var $this = $(this);
            if ($this.attr('href').indexOf(current) !== -1) {
                $this.parent().addClass('active');
                $this.addClass('active');
            }
        });
    });
</script>
