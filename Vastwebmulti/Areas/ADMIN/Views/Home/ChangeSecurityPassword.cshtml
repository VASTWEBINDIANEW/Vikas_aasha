@using Vastwebmulti.Models;
@model Tuple<ChangePasswordViewModel, ChangeTransactionViewModel, ChangeSecurityViewModel>

@{
    ViewBag.Title = "ChangeSecurityPassword";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
}

<link href="~/select2/dist/css/select2.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-fund-transfer-modern.css?v=34" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-fund-transfer-mobile.css?v=35" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.0.1/css/toastr.css" rel="stylesheet" />
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.0.1/js/toastr.js"></script>

<section class="content saas-admin-account-page saas-admin-report-page saas-fund-transfer-page saas-fund-transfer-premium saas-upload-apk-page saas-security-password-page">

    <div class="container-fluid vm-ft-page-shell">

        <div class="vm-ft-page-toolbar vm-ft-page-toolbar--premium vm-ft-apk-toolbar vm-csp-toolbar-line">
            <div class="vm-ft-page-hero vm-csp-toolbar-breadcrumb">
                <ol class="vm-ft-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li><a href="@Url.Action("Dashboard", "Home")#setting">Basic Setting</a></li>
                    <li>Set Password</li>
                </ol>
            </div>
            <div class="vm-csp-toolbar-right">
            <div class="vm-csp-toolbar-actions">
                @if (ViewBag.dmtotpsts != null)
                {
                    if (ViewBag.dmtotpsts.status == true)
                    {
                        <div class="vm-csp-switch-pill KYCON onoffswitch is-on">
                            <span class="costom-on" onclick="KYCONOFF('KYCON')">IMPS PIN/OTP SWITCH</span>
                        </div>
                    }
                    else
                    {
                        <div class="vm-csp-switch-pill KYCON onoffswitch">
                            <span class="custom-off" onclick="KYCONOFF('KYCON')">IMPS PIN/OTP SWITCH</span>
                        </div>
                    }
                }
                @if (ViewBag.rechargeotpsts != null)
                {
                    if (ViewBag.rechargeotpsts.status == true)
                    {
                        <div class="vm-csp-switch-pill RECHARGEON onoffswitch is-on">
                            <span class="costom-on" onclick="RECHARGEPINONOFF('RECHARGEON')">RECHARGE PIN</span>
                        </div>
                    }
                    else
                    {
                        <div class="vm-csp-switch-pill RECHARGEON onoffswitch">
                            <span class="custom-off" onclick="RECHARGEPINONOFF('RECHARGEON')">RECHARGE PIN</span>
                        </div>
                    }
                }
                @if (ViewBag.failedotpsts != null)
                {
                    if (ViewBag.failedotpsts == true)
                    {
                        <div class="vm-csp-switch-pill KYCON onoffswitch onoffswitch1 is-on">
                            <span class="costom-on" onclick="Recharge('ON')">Recharge/Utility Failed OTP</span>
                        </div>
                    }
                    else
                    {
                        <div class="vm-csp-switch-pill KYCON onoffswitch onoffswitch1">
                            <span class="custom-off" onclick="Recharge('OFF')">Recharge/Utility Failed OTP</span>
                        </div>
                    }
                }
                <button type="button" class="vm-csp-toolbar-btn" data-toggle="modal" data-target="#myModal3">
                    <i class="fas fa-cog" aria-hidden="true"></i> Reset Distributors Pin
                </button>
                <button type="button" class="vm-csp-toolbar-btn" data-toggle="modal" data-target="#myModal2">
                    <i class="fas fa-cog" aria-hidden="true"></i> Reset Retailers Pin
                </button>
            </div>
            <div class="vm-ft-search-wrap vm-ft-apk-page-search vm-csp-toolbar-search">
                <input class="form-control" type="text" value="" id="txtCspSearch" placeholder="Search..." autocomplete="off" />
            </div>
            </div>
        </div>

        <!-- Distributor Modal -->
        <div class="modal fade saas-admin-modal vm-sm-modal vm-csp-modal" id="myModal3" role="dialog" aria-labelledby="myModalLabel3" tabindex="-1">
            <div class="modal-dialog vm-sm-modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header saas-admin-modal-header accent-slate">
                        <div class="saas-admin-modal-head-main">
                            <span class="saas-admin-modal-icon"><i class="fas fa-user-tie" aria-hidden="true"></i></span>
                            <div class="saas-admin-modal-title-wrap">
                                <h4 class="modal-title saas-admin-modal-title" id="myModalLabel3">Distributor Information</h4>
                                <span class="saas-admin-modal-subtitle">Reset transaction pin for a distributor</span>
                            </div>
                        </div>
                        <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
                    </div>
                    <div class="modal-body saas-admin-modal-body saas-admin-modal-scroll vm-sm-modal-body">
                        <div class="vm-sm-modal-panel">
                            <span class="vm-sm-modal-panel__title">Account Selection</span>
                            <div class="vm-sm-modal-field vm-sm-modal-field--full vm-csp-modal-select-wrap">
                                <label for="DistributorDDL">Select Distributor</label>
                                @Html.DropDownList("DistributorList", (IEnumerable<SelectListItem>)ViewBag.DealerList, "Select Distributor", new { id = "DistributorDDL", @class = "for-select2 vm-rl-select-search vm-csp-modal-select form-control", data_live_search = "true", @required = "required", @onchange = "GetDistributorDetails();" })
                            </div>
                        </div>
                        <div class="vm-sm-modal-panel">
                            <span class="vm-sm-modal-panel__title">Distributor Details</span>
                            <div class="vm-sm-modal-grid vm-csp-modal-grid">
                                <div class="vm-sm-modal-field">
                                    <label for="DistributorName">Distributor Name</label>
                                    @Html.TextBox("DistributorName", "", new { id = "DistributorName", @class = "form-control", @readonly = "readonly" })
                                </div>
                                <div class="vm-sm-modal-field">
                                    <label for="DistributorFirmName">Firm Name</label>
                                    @Html.TextBox("DistributorFirmName", "", new { id = "DistributorFirmName", @class = "form-control", @readonly = "readonly" })
                                </div>
                                <div class="vm-sm-modal-field">
                                    <label for="DistributorMobileNo">Mobile No</label>
                                    @Html.TextBox("DistributorMobileNo", "", new { @class = "form-control", @readonly = "readonly", id = "DistributorMobileNo" })
                                </div>
                                <div class="vm-sm-modal-field">
                                    <label for="DistributorAddress">Address</label>
                                    @Html.TextBox("DistributorAddress", "", new { id = "DistributorAddress", @class = "form-control", @readonly = "readonly" })
                                </div>
                            </div>
                        </div>
                        @{
                            var asd1 = Convert.ToString(Session["chk1"]);
                            if (asd1 != null && asd1 != "0" && asd1 != "")
                            {
                                <div class="vm-sm-modal-panel vm-csp-otp-wrap">
                                    <span class="vm-sm-modal-panel__title">OTP Verification</span>
                                    <a href="#" onclick="otpsendD('12'); return false;" class="vm-csp-otp-send"><i class="fas fa-paper-plane" aria-hidden="true"></i> Send OTP</a>
                                    <div class="hide_otp">
                                        <div class="vm-csp-otp-field">
                                            <label class="required">Enter OTP</label>
                                            <div class="vm-csp-otp-box otp_set2">
                                                <input class="vm-csp-otp-input tested" type="number" id="oTP" maxlength="1" onkeyup="onKeyUpEvent(1, event)" onfocus="onFocusEvent(1)" required>
                                                <input class="vm-csp-otp-input tested" type="number" id="oTP1" maxlength="1" onkeyup="onKeyUpEvent(2, event)" onfocus="onFocusEvent(2)" required>
                                                <input class="vm-csp-otp-input tested" type="number" id="oTP2" maxlength="1" onkeyup="onKeyUpEvent(3, event)" onfocus="onFocusEvent(3)" required>
                                                <input class="vm-csp-otp-input tested" type="number" id="oTP3" maxlength="1" onkeyup="onKeyUpEvent(4, event)" onfocus="onFocusEvent(4)" required>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                    <div class="saas-admin-modal-footer vm-sm-modal-footer">
                        <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal">Cancel</button>
                        <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--success" onclick="DistributorResetPin()">
                            <i class="fas fa-key" aria-hidden="true"></i> Reset Transaction Pin
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Retailer Modal -->
        <div class="modal fade saas-admin-modal vm-sm-modal vm-csp-modal" id="myModal2" role="dialog" aria-labelledby="myModalLabel2" tabindex="-1">
            <div class="modal-dialog vm-sm-modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header saas-admin-modal-header accent-emerald">
                        <div class="saas-admin-modal-head-main">
                            <span class="saas-admin-modal-icon"><i class="fas fa-store" aria-hidden="true"></i></span>
                            <div class="saas-admin-modal-title-wrap">
                                <h4 class="modal-title saas-admin-modal-title" id="myModalLabel2">Retailer Information</h4>
                                <span class="saas-admin-modal-subtitle">Reset transaction pin for a retailer</span>
                            </div>
                        </div>
                        <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
                    </div>
                    <div class="modal-body saas-admin-modal-body saas-admin-modal-scroll vm-sm-modal-body">
                        <div class="vm-sm-modal-panel">
                            <span class="vm-sm-modal-panel__title">Account Selection</span>
                            <div class="vm-sm-modal-field vm-sm-modal-field--full vm-csp-modal-select-wrap">
                                <label for="RetailerList">Retailer</label>
                                @Html.DropDownList("RetailerList", (IEnumerable<SelectListItem>)ViewBag.RetailerList, "Select Retailer", new { id = "RetailerList", @class = "for-select2 vm-rl-select-search vm-csp-modal-select form-control", data_live_search = "true", @required = "required", @onchange = "GetRetaileretails();" })
                            </div>
                        </div>
                        <div class="vm-sm-modal-panel">
                            <span class="vm-sm-modal-panel__title">Retailer Details</span>
                            <div class="vm-sm-modal-grid vm-csp-modal-grid">
                                <div class="vm-sm-modal-field">
                                    <label for="RetailerName">Retailer Name</label>
                                    @Html.TextBox("RetailerName", "", new { id = "RetailerName", @class = "form-control", @readonly = "readonly" })
                                </div>
                                <div class="vm-sm-modal-field">
                                    <label for="FirmName">Firm Name</label>
                                    @Html.TextBox("FirmName", "", new { @class = "form-control", @readonly = "readonly", id = "FirmName" })
                                </div>
                                <div class="vm-sm-modal-field">
                                    <label for="MobileNo">Mobile No</label>
                                    @Html.TextBox("MobileNo", "", new { @class = "form-control", @readonly = "readonly", id = "MobileNo" })
                                </div>
                                <div class="vm-sm-modal-field">
                                    <label for="RetailerAddress">Address</label>
                                    @Html.TextBox("RetailerAddress", "", new { id = "RetailerAddress", @class = "form-control", @readonly = "readonly" })
                                </div>
                            </div>
                        </div>
                        @{
                            var asd2 = Convert.ToString(Session["chk1"]);
                            if (asd2 != null && asd2 != "0" && asd2 != "")
                            {
                                <div class="vm-sm-modal-panel vm-csp-otp-wrap">
                                    <span class="vm-sm-modal-panel__title">OTP Verification</span>
                                    <a href="#" onclick="otpsendR('12'); return false;" class="vm-csp-otp-send"><i class="fas fa-paper-plane" aria-hidden="true"></i> Send OTP</a>
                                    <div class="hide_otp">
                                        <div class="vm-csp-otp-field">
                                            <label class="required">Enter OTP</label>
                                            <div class="vm-csp-otp-box otp_set3">
                                                <input class="vm-csp-otp-input tested" type="number" id="oTP4" maxlength="1" onkeyup="onKeyUpEvent(1, event)" onfocus="onFocusEvent(1)" required>
                                                <input class="vm-csp-otp-input tested" type="number" id="oTP5" maxlength="1" onkeyup="onKeyUpEvent(2, event)" onfocus="onFocusEvent(2)" required>
                                                <input class="vm-csp-otp-input tested" type="number" id="oTP6" maxlength="1" onkeyup="onKeyUpEvent(3, event)" onfocus="onFocusEvent(3)" required>
                                                <input class="vm-csp-otp-input tested" type="number" id="oTP7" maxlength="1" onkeyup="onKeyUpEvent(4, event)" onfocus="onFocusEvent(4)" required>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>
                    <div class="saas-admin-modal-footer vm-sm-modal-footer">
                        <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal">Cancel</button>
                        <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--success" onclick="ResetPin()">
                            <i class="fas fa-key" aria-hidden="true"></i> Reset Transaction Pin
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-12 vm-ft-layout-wrap">
            <label id="error-message-one" class="vm-csp-alert vm-csp-page-alert"></label>

            <div class="vm-ft-layout vm-ft-layout--stacked vm-csp-rows">

                <!-- Row 1: Login Password -->
                <div class="vm-csp-row vm-ft-layout vm-ft-layout--split-equal">
                    <div class="col-md-6 col-sm-12 vm-ft-apk-col">
                        <div class="fund-trasfer-left vm-ft-form-card" data-apk-search="login password important rules">
                            <div class="vm-ft-form-card-header">
                                <div class="vm-ft-form-card-header__icon" aria-hidden="true">
                                    <i class="fas fa-info-circle"></i>
                                </div>
                                <div>
                                    <span class="vm-ft-form-card-header__title">Important</span>
                                    <span class="vm-ft-form-card-header__sub">Password requirements for login credentials</span>
                                </div>
                            </div>
                            <div class="width100 float-left tabcurrent-seconddesign input-border-third vm-csp-card-body">
                                <div class="vm-ft-apk-section vm-csp-rules-panel">
                                <ul class="vm-csp-rules">
                                    <li><i class="fas fa-check-circle" aria-hidden="true"></i> Password must be Required one Special character</li>
                                    <li><i class="fas fa-check-circle" aria-hidden="true"></i> Password must be Required one Digit Number</li>
                                    <li><i class="fas fa-check-circle" aria-hidden="true"></i> Password must be Required one Lowercase character</li>
                                    <li><i class="fas fa-check-circle" aria-hidden="true"></i> Password must be Required one Uppercase character</li>
                                    <li><i class="fas fa-check-circle" aria-hidden="true"></i> Password must be Required one alphabet character</li>
                                    <li><i class="fas fa-check-circle" aria-hidden="true"></i> Password must be Required Minimum Length Six character</li>
                                </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-12 vm-ft-apk-col">
                        <div class="fund-trasfer-left vm-ft-form-card" data-apk-search="change login password">
                            <div class="vm-ft-form-card-header">
                                <div class="vm-ft-form-card-header__icon vm-ft-form-card-header__icon--wl" aria-hidden="true">
                                    <i class="fas fa-lock"></i>
                                </div>
                                <div>
                                    <span class="vm-ft-form-card-header__title">Change Login Password</span>
                                    <span class="vm-ft-form-card-header__sub">Update your website login credentials</span>
                                </div>
                            </div>
                            <div class="width100 float-left tabcurrent-seconddesign input-border-third vm-csp-card-body">
                                <div class="fund-transfer-form vm-ft-apk-form">
                                <div class="vm-ft-apk-section">
                                @using (Html.BeginForm("ChangePassword", "Home", FormMethod.Post, new { @class = "", role = "form" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                    <div class="vm-csp-field">
                                        <label class="required">Old Password</label>
                                        @Html.PasswordFor(tuple => tuple.Item1.OldPassword, new { @class = "form-control", @required = "" })
                                        @Html.ValidationMessageFor(tuple => tuple.Item1.OldPassword, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="vm-csp-field">
                                        <label class="required">New Password</label>
                                        @Html.PasswordFor(tuple => tuple.Item1.NewPassword, new { @class = "form-control", @required = "" })
                                        @Html.ValidationMessageFor(tuple => tuple.Item1.NewPassword, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="vm-csp-field">
                                        <label class="required">Confirm Password</label>
                                        @Html.PasswordFor(tuple => tuple.Item1.ConfirmPassword, new { @class = "form-control", @required = "" })
                                        @Html.ValidationMessageFor(tuple => tuple.Item1.ConfirmPassword, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="vm-csp-actions">
                                        <button type="reset" class="btn vm-csp-btn-secondary">Reset</button>
                                        <button type="button" class="vm-csp-btn-primary password-change"><i class="fas fa-key" aria-hidden="true"></i> Change Password</button>
                                        <button type="submit" class="vm-csp-btn-confirm password-sure" data-loading-text="<i class='fa fa-spinner fa-spin'></i>" style="display:none;"><i class="fas fa-check" aria-hidden="true"></i> Sure?</button>
                                    </div>
                                }
                                </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Row 2: Transaction Password -->
                <div class="vm-csp-row vm-ft-layout vm-ft-layout--split-equal">
                    <div class="col-md-6 col-sm-12 vm-ft-apk-col">
                        <div class="fund-trasfer-left vm-ft-form-card" data-apk-search="reset transaction password email">
                            <div class="vm-ft-form-card-header">
                                <div class="vm-ft-form-card-header__icon" aria-hidden="true">
                                    <i class="fas fa-envelope-open-text"></i>
                                </div>
                                <div>
                                    <span class="vm-ft-form-card-header__title">Reset Transaction Password</span>
                                    <span class="vm-ft-form-card-header__sub">Request a reset link via registered email</span>
                                </div>
                            </div>
                            <div class="width100 float-left tabcurrent-seconddesign input-border-third vm-csp-card-body">
                                <div class="fund-transfer-form vm-ft-apk-form">
                                <div class="vm-ft-apk-section">
                                @using (Html.BeginForm("Resend_Transactionpass", "Home", FormMethod.Post, new { id = "resttarnspass" }))
                                {
                                    <div class="vm-csp-field">
                                        <label class="required">Email Id</label>
                                        <input type="text" id="txtemail" required name="txtemail" class="form-control" placeholder="Enter Registered Email" />
                                        <label id="error-message" class="vm-csp-alert vm-csp-alert--err"></label>
                                    </div>
                                    var asd = Convert.ToString(Session["chk1"]);
                                    if (asd != null && asd != "0" && asd != "")
                                    {
                                        <div class="vm-csp-otp-wrap">
                                            <a href="#" onclick="otpsend('12'); return false;" class="vm-csp-otp-send"><i class="fas fa-paper-plane" aria-hidden="true"></i> Send OTP</a>
                                            <div class="hide_otp">
                                                <div class="vm-csp-otp-field">
                                                    <label class="required">Enter OTP</label>
                                                    <div class="vm-csp-otp-box otp_set">
                                                        <input class="vm-csp-otp-input tested" type="number" name="oTP" maxlength="1" onkeyup="onKeyUpEvent(1, event)" onfocus="onFocusEvent(1)" required>
                                                        <input class="vm-csp-otp-input tested" type="number" name="oTP1" maxlength="1" onkeyup="onKeyUpEvent(2, event)" onfocus="onFocusEvent(2)" required>
                                                        <input class="vm-csp-otp-input tested" type="number" name="oTP2" maxlength="1" onkeyup="onKeyUpEvent(3, event)" onfocus="onFocusEvent(3)" required>
                                                        <input class="vm-csp-otp-input tested" type="number" name="oTP3" maxlength="1" onkeyup="onKeyUpEvent(4, event)" onfocus="onFocusEvent(4)" required>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    <div class="vm-csp-actions">
                                        <button type="button" class="vm-csp-btn-primary password-change"><i class="fas fa-key" aria-hidden="true"></i> Change Password</button>
                                        <button type="submit" class="vm-csp-btn-confirm password-sure" data-loading-text="<i class='fa fa-spinner fa-spin'></i>" style="display:none;" onclick="confrim()"><i class="fas fa-check" aria-hidden="true"></i> Sure?</button>
                                    </div>
                                }
                                </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-12 vm-ft-apk-col">
                        <div class="fund-trasfer-left vm-ft-form-card" data-apk-search="change transaction password">
                            <div class="vm-ft-form-card-header">
                                <div class="vm-ft-form-card-header__icon vm-ft-form-card-header__icon--wl" aria-hidden="true">
                                    <i class="fas fa-exchange-alt"></i>
                                </div>
                                <div>
                                    <span class="vm-ft-form-card-header__title">Change Transaction Password</span>
                                    <span class="vm-ft-form-card-header__sub">Update your transaction PIN credentials</span>
                                </div>
                            </div>
                            <div class="width100 float-left tabcurrent-seconddesign input-border-third vm-csp-card-body">
                                <div class="fund-transfer-form vm-ft-apk-form">
                                <div class="vm-ft-apk-section">
                                @using (Html.BeginForm("Edit_Transactionpass", "Home", FormMethod.Post))
                                {
                                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                    <div class="vm-csp-field">
                                        <label class="required">Old Password</label>
                                        @Html.PasswordFor(tuple => tuple.Item2.Oldtransactionpass, new { @class = "form-control", @required = "" })
                                        @Html.ValidationMessageFor(tuple => tuple.Item2.Oldtransactionpass, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="vm-csp-field">
                                        <label class="required">New Password</label>
                                        @Html.PasswordFor(tuple => tuple.Item2.Newtransactionpass, new { @class = "form-control", @required = "", @maxlength = "6" })
                                        @Html.ValidationMessageFor(tuple => tuple.Item2.Newtransactionpass, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="vm-csp-field">
                                        <label class="required">Confirm Password</label>
                                        @Html.PasswordFor(tuple => tuple.Item2.Confirmtransactionpass, new { @class = "form-control", @required = "", @maxlength = "6" })
                                        @Html.ValidationMessageFor(tuple => tuple.Item2.Confirmtransactionpass, "", new { @class = "text-danger" })
                                    </div>
                                    <div class="vm-csp-actions">
                                        <button type="reset" class="btn vm-csp-btn-secondary">Reset</button>
                                        <button type="button" class="vm-csp-btn-primary password-change"><i class="fas fa-key" aria-hidden="true"></i> Change Password</button>
                                        <button type="submit" class="vm-csp-btn-confirm password-sure" data-loading-text="<i class='fa fa-spinner fa-spin'></i>" style="display:none;"><i class="fas fa-check" aria-hidden="true"></i> Sure?</button>
                                    </div>
                                }
                                </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

