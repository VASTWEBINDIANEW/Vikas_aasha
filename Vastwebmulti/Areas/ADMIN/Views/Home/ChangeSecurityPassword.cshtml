<script>
    function bindOtpBoxNavigation(className) {
        var container = document.getElementsByClassName(className)[0];
        if (!container) {
            return;
        }
        container.onkeyup = function (e) {
            var target = e.srcElement || e.target;
            var maxLength = parseInt(target.attributes["maxlength"].value, 10);
            var myLength = target.value.length;
            if (myLength >= maxLength) {
                var next = target;
                while (next = next.nextElementSibling) {
                    if (next == null)
                        break;
                    if (next.tagName.toLowerCase() === "input") {
                        next.focus();
                        break;
                    }
                }
            }
            else if (myLength === 0) {
                var previous = target;
                while (previous = previous.previousElementSibling) {
                    if (previous == null)
                        break;
                    if (previous.tagName.toLowerCase() === "input") {
                        previous.focus();
                        break;
                    }
                }
            }
        };
    }

    bindOtpBoxNavigation("otp_set");
    bindOtpBoxNavigation("otp_set1");
    bindOtpBoxNavigation("otp_set2");
    bindOtpBoxNavigation("otp_set3");
</script>


<script>
    function clearDistributorDetails() {
        $('#DistributorName, #DistributorFirmName, #DistributorMobileNo, #DistributorAddress').val('');
    }

    function clearRetailerDetails() {
        $('#RetailerName, #FirmName, #MobileNo, #RetailerAddress').val('');
    }

    var cspRetailerDetailsCache = {};
    var cspDistributorDetailsCache = {};

    function fillRetailerDetails(data) {
        if (!data) {
            clearRetailerDetails();
            return;
        }
        if (typeof data === 'string') {
            clearRetailerDetails();
            return;
        }
        var row = Array.isArray(data) ? data[0] : data;
        if (!row) {
            clearRetailerDetails();
            return;
        }
        $('#RetailerName').val(row.RetailerName || row.retailerName || '');
        $('#FirmName').val(row.Frm_Name || row.frm_Name || row.FirmName || '');
        $('#MobileNo').val(row.Mobile || row.mobile || '');
        $('#RetailerAddress').val(row.Address || row.address || '');
    }

    function fillDistributorDetails(data) {
        if (!data) {
            clearDistributorDetails();
            return;
        }
        if (typeof data === 'string') {
            clearDistributorDetails();
            return;
        }
        var row = Array.isArray(data) ? data[0] : data;
        if (!row) {
            clearDistributorDetails();
            return;
        }
        $('#DistributorName').val(row.DealerName || row.dealerName || '');
        $('#DistributorFirmName').val(row.FarmName || row.farmName || row.FirmName || '');
        $('#DistributorMobileNo').val(row.Mobile || row.mobile || '');
        $('#DistributorAddress').val(row.Address || row.address || '');
    }

    function GetRetaileretails() {
        var userId = ($('#RetailerList').val() || '').toString().trim();
        if (!userId) {
            clearRetailerDetails();
            return;
        }

        if (cspRetailerDetailsCache[userId]) {
            fillRetailerDetails(cspRetailerDetailsCache[userId]);
            return;
        }

        $.ajax({
            type: 'POST',
            url: '@Url.Action("GetDLM_REM_Details", "Home", new { area = "ADMIN" })',
            data: { UserType: 'Retailer', UserId: userId },
            dataType: 'json',
            cache: false,
            success: function (data) {
                if (!data || typeof data === 'string' || !data.length) {
                    clearRetailerDetails();
                    return;
                }
                cspRetailerDetailsCache[userId] = data;
                fillRetailerDetails(data);
            },
            error: function () {
                clearRetailerDetails();
                if (typeof ToastrMessage === 'function') {
                    ToastrMessage();
                    toastr.error('Unable to load retailer details.');
                }
            }
        });
    }

    function GetDistributorDetails() {
        var userId = ($('#DistributorDDL').val() || '').toString().trim();
        if (!userId) {
            clearDistributorDetails();
            return;
        }

        if (cspDistributorDetailsCache[userId]) {
            fillDistributorDetails(cspDistributorDetailsCache[userId]);
            return;
        }

        $.ajax({
            type: 'POST',
            url: '@Url.Action("GetDLM_REM_Details", "Home", new { area = "ADMIN" })',
            data: { UserType: 'Distributor', UserId: userId },
            dataType: 'json',
            cache: false,
            success: function (data) {
                if (!data || typeof data === 'string' || !data.length) {
                    clearDistributorDetails();
                    return;
                }
                cspDistributorDetailsCache[userId] = data;
                fillDistributorDetails(data);
            },
            error: function () {
                clearDistributorDetails();
                if (typeof ToastrMessage === 'function') {
                    ToastrMessage();
                    toastr.error('Unable to load distributor details.');
                }
            }
        });
    }

    function wireCspSelectAutoFill($retailer, $distributor) {
        if ($retailer && $retailer.length) {
            $retailer.off('select2:select.cspFill select2:clear.cspFill change.cspFill');
            $retailer.on('select2:select.cspFill change.cspFill', function () {
                window.setTimeout(GetRetaileretails, 0);
            });
            $retailer.on('select2:clear.cspFill', function () {
                clearRetailerDetails();
            });
        }

        if ($distributor && $distributor.length) {
            $distributor.off('select2:select.cspFill select2:clear.cspFill change.cspFill');
            $distributor.on('select2:select.cspFill change.cspFill', function () {
                window.setTimeout(GetDistributorDetails, 0);
            });
            $distributor.on('select2:clear.cspFill', function () {
                clearDistributorDetails();
            });
        }
    }

    function bootCspModalSelects() {
        var $ = window.jQuery;
        if (!$) {
            return;
        }

        var $retailer = $('#RetailerList');
        var $distributor = $('#DistributorDDL');
        if (!$retailer.length && !$distributor.length) {
            return;
        }

        var opts = {
            width: '100%',
            dropdownParent: $(document.body),
            minimumResultsForSearch: 0,
            allowClear: true
        };

        if (typeof window.applyAdminSelect2 === 'function') {
            if ($retailer.length) {
                window.applyAdminSelect2($retailer, $.extend({}, opts, { placeholder: 'Select Retailer' }), true);
            }
            if ($distributor.length) {
                window.applyAdminSelect2($distributor, $.extend({}, opts, { placeholder: 'Select Distributor' }), true);
            }
        } else if ($.fn.select2) {
            [$retailer, $distributor].forEach(function ($el) {
                if (!$el.length) {
                    return;
                }
                if ($el.hasClass('select2-hidden-accessible')) {
                    try { $el.select2('destroy'); } catch (e) { }
                }
                $el.select2($.extend({}, opts, {
                    placeholder: $el.attr('id') === 'RetailerList' ? 'Select Retailer' : 'Select Distributor'
                }));
            });
        } else if (typeof window.bootAdminSelect2 === 'function') {
            window.bootAdminSelect2();
        }

        wireCspSelectAutoFill($retailer, $distributor);
    }

    function bindCspModalSelectEvents() {
        wireCspSelectAutoFill($('#RetailerList'), $('#DistributorDDL'));
    }

    function syncCspModalSelect2ZIndex() {
        var $modal = $('.modal.in, .modal.show').filter(function () {
            return $(this).css('display') === 'block';
        }).last();
        var modalZ = parseInt($modal.css('z-index'), 10) || 11000;
        var dropZ = modalZ + 50;
        $('.select2-container--open').css('z-index', dropZ);
        $('.select2-dropdown').css('z-index', dropZ + 1);
    }

    function readyCspModalSelects() {
        var $ = window.jQuery;
        if (!$) {
            return;
        }

        $(document).off('select2:select.cspGlobalFill', '#RetailerList').on('select2:select.cspGlobalFill', '#RetailerList', function () {
            window.setTimeout(GetRetaileretails, 0);
        });
        $(document).off('select2:select.cspGlobalFill', '#DistributorDDL').on('select2:select.cspGlobalFill', '#DistributorDDL', function () {
            window.setTimeout(GetDistributorDetails, 0);
        });
        $(document).off('select2:clear.cspGlobalFill', '#RetailerList').on('select2:clear.cspGlobalFill', '#RetailerList', clearRetailerDetails);
        $(document).off('select2:clear.cspGlobalFill', '#DistributorDDL').on('select2:clear.cspGlobalFill', '#DistributorDDL', clearDistributorDetails);

        $('#myModal2, #myModal3').appendTo('body');
        bootCspModalSelects();
        bindCspModalSelectEvents();

        window.setTimeout(function () { bootCspModalSelects(); bindCspModalSelectEvents(); }, 150);
        window.setTimeout(function () { bootCspModalSelects(); bindCspModalSelectEvents(); }, 600);
        window.setTimeout(function () { bootCspModalSelects(); bindCspModalSelectEvents(); }, 1400);

        $('#myModal2, #myModal3').on('shown.bs.modal', function () {
            bootCspModalSelects();
            bindCspModalSelectEvents();
        });

        $('[data-target="#myModal2"], [data-target="#myModal3"]').on('click', function () {
            window.setTimeout(function () { bootCspModalSelects(); bindCspModalSelectEvents(); }, 250);
        });

        $(document).off('select2:open.cspModalZ').on('select2:open.cspModalZ', '#RetailerList, #DistributorDDL', function () {
            $(this).closest('.modal').addClass('vm-csp-select2-open');
            syncCspModalSelect2ZIndex();
            window.setTimeout(function () {
                syncCspModalSelect2ZIndex();
                $('.select2-search--dropdown').removeClass('select2-search--hide').show();
            }, 0);
        });

        $(document).off('select2:close.cspModalZ').on('select2:close.cspModalZ', '#RetailerList, #DistributorDDL', function () {
            $(this).closest('.modal').removeClass('vm-csp-select2-open');
        });
    }

    window.jQuery(document).ready(readyCspModalSelects);
</script>
