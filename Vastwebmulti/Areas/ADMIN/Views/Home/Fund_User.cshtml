<script>
    function activateLeftFundTab(tabID) {
        if (!tabID || !$('#' + tabID).length) {
            tabID = 'home';
        }

        $('#tabs li').removeClass('active current vm-ft-role-tab-li--active').addClass('vm-ft-role-tab-li--inactive');
        var $activeLi = $('#tabs a[href="#' + tabID + '"]').parent('li');
        $activeLi.removeClass('vm-ft-role-tab-li--inactive').addClass('active current vm-ft-role-tab-li--active');
        $('#tabs li a').attr({ 'aria-selected': 'false', 'aria-expanded': 'false' });
        $('#tabs a[href="#' + tabID + '"]').attr({ 'aria-selected': 'true', 'aria-expanded': 'true' });

        $('.tabcurrent-seconddesign .tab-pane').removeClass('active in').removeAttr('style');
        $('#' + tabID).addClass('active in');
    }

    function refreshFundTransferSelect2($scope) {
        if (!window.jQuery || !$.fn.select2) {
            return;
        }
        var $targets = $scope && $scope.length ? $scope.find('.for-select2') : $('.saas-fund-transfer-page .for-select2');
        $targets.each(function () {
            var $el = $(this);
            if ($el.hasClass('select2-hidden-accessible')) {
                $el.select2('destroy');
            }
            $el.select2({
                width: '100%',
                dropdownAutoWidth: false
            });
        });
    }

    $(document).ready(function () {
        activateLeftFundTab('home');
        refreshFundTransferSelect2();

        $(document).on('click', '#tblshowMasterD tr[data-target]', function (e) {
            var target = $(this).attr('data-target');
            if (!target) {
                return;
            }
            e.preventDefault();
            e.stopPropagation();
            window.setTimeout(function () {
                if (window.showAdminModal) {
                    window.showAdminModal(target);
                } else {
                    $(target).modal('show');
                }
            }, 0);
        });

        $('#tabs').attr('role', 'tablist');
        $('#tabs li a').attr('role', 'tab');
    });
</script>

<script>
    $('#tabs a').on('click', function (e) {
        e.preventDefault();

        var tabID = $(this).attr('href').substr(1);
        var $li = $(this).parent('li');

        activateLeftFundTab(tabID);

        $('#retailerdatafrom').hide();
        $('#btnddbackshow').trigger('click');
        $('#btnbackshow').trigger('click');
        $('#btnRRbackshow').trigger('click');

        if (tabID === 'home') {
            $('#masterdrop').show();
            $('#dealerdrop').hide();
            $('#retailerdrop').hide();
        }

        var historyUrl = $li.attr('data-href');
        if (historyUrl) {
            $.ajax({
                url: historyUrl,
                success: function (data) {
                    $('#tblshowMasterD').html(data);
                }
            });
        }

        $.ajax({
            url: "@Url.Action("FillDealerDropDownList")",
            cache: false,
            type: "POST",
            data: { nameoftab: tabID },
            success: function (result) {
                if (tabID === 'menu1') {
                    $('#masterdrop').hide();
                    $('#dealerdrop').show();
                    $('#retailerdrop').hide();

                    var s = '<option value="">Please Select a Distributor</option>';
                    for (var i = 0; i < result.length; i++) {
                        s += '<option value="' + result[i].Value + '">' + result[i].Text + '</option>';
                    }
                    $("#ddlDistributor1").html(s);
                    refreshFundTransferSelect2($('#dealerdrop'));
                }
                if (tabID === 'menu2') {
                    $('#masterdrop').hide();
                    $('#dealerdrop').hide();
                    $('#retailerdrop').show();
                    $('#retailerdatafrom').show();

                    var s2 = '<option value="">Please Select a Retailer</option>';
                    for (var j = 0; j < result.length; j++) {
                        s2 += '<option value="' + result[j].Value + '">' + result[j].Text + '</option>';
                    }
                    $("#RLMID1").html(s2);
                    refreshFundTransferSelect2($('#retailerdrop'));
                    refreshFundTransferSelect2($('#retailerdatafrom'));
                }
            }
        });
    });
</script>

<script>
    $(document).ready(function()
    {
        if (!$.fn.datepicker) {
            return;
        }

        var dateOpts = {
            format: "yyyy-mm-dd",
            todayHighlight: true,
            autoclose: true,
            orientation: "bottom auto",
            forceParse: false,
            enableOnReadonly: true,
            container: 'body'
        };

        var $frm = $("#txt_frm_date");
        var $to = $("#txt_to_date");

        $frm.datepicker(dateOpts);
        $to.datepicker(dateOpts);

        $frm.on('focus', function () {
            $(this).datepicker('show');
        });
        $to.on('focus', function () {
            $(this).datepicker('show');
        });

        $('.saas-fund-transfer-page .saas-acc-dp-icon').on('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var $input = $(this).closest('.saas-acc-dp-field').find('.saas-acc-dp-input');
            if ($input.length && $input.data('datepicker')) {
                $input.datepicker('show');
            }
        });

        $frm.on('show', function () {
            $(this).closest('.saas-acc-dp-field').addClass('is-active');
        }).on('hide changeDate', function () {
            $(this).closest('.saas-acc-dp-field').removeClass('is-active');
        });

        $to.on('show', function () {
            $(this).closest('.saas-acc-dp-field').addClass('is-active');
        }).on('hide changeDate', function () {
            $(this).closest('.saas-acc-dp-field').removeClass('is-active');
        });

        $('.input-daterange').datepicker(dateOpts);

        var val = '@ViewBag.chk';
        if (val != "post") {
            $frm.datepicker("setDate", new Date());
            $to.datepicker("setDate", new Date());
        }

    })
</script>
