<script>
$(document).ready(function(){
    $("button.shownextrow").click(function () {
        $(this).closest("tr").next().show();
        $(this).closest("tr").hide();
    });

    if (!$.fn.datepicker) {
        return;
    }

    var dateOpts = {
        format: "yyyy-mm-dd",
        todayHighlight: true,
        autoclose: true,
        orientation: "bottom auto",
        forceParse: false,
        enableOnReadonly: true,
        container: 'body'
    };

    $('.Cash_Deposit_Charge_Page .saas-acc-dp-input').each(function () {
        $(this).datepicker(dateOpts);
    });

    $('.Cash_Deposit_Charge_Page .saas-acc-dp-icon').on('click', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var $input = $(this).closest('.saas-acc-dp-field').find('.saas-acc-dp-input');
        if ($input.length && $input.data('datepicker')) {
            $input.datepicker('show');
        }
    });

    var val = '@ViewBag.chk';
    if (val != "post") {
        var today = new Date();
        $('#txt_frm_date').datepicker("setDate", today);
        $('#txt_to_date').datepicker("setDate", today);
        $('#txt_frm_datepos').datepicker("setDate", today);
        $('#txt_to_datepos').datepicker("setDate", today);
        $('#txt_frm_date_wadmin').datepicker("setDate", today);
        $('#txt_to_date_wadmin').datepicker("setDate", today);
    }
});
