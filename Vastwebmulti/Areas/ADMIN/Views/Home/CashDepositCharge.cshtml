@model Vastwebmulti.Areas.ADMIN.Models.CashDepositeAndBank_Info_VM
@{
    ViewBag.Title = "CashDepositCharge";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-fund-transfer-modern.css?v=27" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-fund-transfer-mobile.css?v=25" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-master-list-modern.css?v=19" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-add-purchase-modern.css?v=23" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<link href="~/select2/dist/css/select2.css" rel="stylesheet" />

<section class="content Add_Purchase_Page Cash_Deposit_Charge_Page saas-admin-account-page saas-admin-report-page saas-fund-transfer-page saas-fund-transfer-premium saas-cash-deposit-charge-page cas-hdeposi-tcharge-page">

    <div class="container-fluid vm-ft-page-shell">

        <div class="vm-ft-page-toolbar vm-ft-page-toolbar--premium">
            <div class="vm-ft-page-hero">
                <ol class="vm-ft-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Basic Setting</li>
                        <li>Cash Charge's</li>
                    </ol>
            </div>
            <div class="vm-ft-search-wrap">
                <input class="form-control" type="text" value="" id="txtCdcSearch" placeholder="Search retailer, wallet, charges..." name="txtCdcSearch" autocomplete="off" />
            </div>
        </div>

        <div class="col-md-12 vm-ft-layout-wrap">
            <div class="row clearfix vm-ft-layout vm-ft-layout--full">

                <div class="col-md-4 col-sm-12 vm-ft-form-col">
                    <div class="fund-trasfer-left vm-ft-form-card">

                        <div class="vm-ft-form-card-header">
                            <div class="vm-ft-form-card-header__icon" aria-hidden="true">
                                <i class="fas fa-coins"></i>
                            </div>
                            <div>
                                <span class="vm-ft-form-card-header__title">Cash &amp; Unload Charges</span>
                                <span class="vm-ft-form-card-header__sub">Configure deposit and wallet unload fees</span>
                            </div>
                        </div>

                        <div class="ap-segment-bar cdc-main-segment" id="cdc-main-tabs" role="tablist" aria-label="Cash charge mode">
                            <button type="button" class="ap-segment-btn active ap-left-tab" data-tab="tab3-1" aria-selected="true">
                                <i class="fas fa-cog" aria-hidden="true"></i><span>Unload</span>
                            </button>
                            <button type="button" class="ap-segment-btn ap-left-tab" data-tab="tab3-2" aria-selected="false">
                                <i class="fas fa-money-bill-wave" aria-hidden="true"></i><span>Deposit</span>
                            </button>
                        </div>

                        <div class="width100 float-left tabcurrent-seconddesign input-border-third cdc-left-body">
                    <div id="tab3-1" class="width100 float-left tab-pane vm-ft-left-tab-pane active in ap-tab-panel cdc-left-panel" data-cdc-search="unload charges retailer white label wallet">
                        <div class="bank-name">
                            <div class="ap-segment-bar" id="cdc-unload-segment" role="tablist" aria-label="Unload role">
                                <button type="button" class="ap-segment-btn active RemTab" data-tab="tab-5">
                                    <i class="fas fa-store" aria-hidden="true"></i><span>Retailer</span>
                                </button>
                                <button type="button" class="ap-segment-btn WhiteLabelTab" data-tab="tab-6">
                                    <i class="fas fa-tag" aria-hidden="true"></i><span>White Label</span>
                                </button>
                            </div>
                            <ul class="tabs2 cdc-unload-tabs-legacy" for="retailer" style="display:none !important;">
                                <li class="tab-link2 current2" data-tab="tab-5">
                                    <input type="radio" value="value1" name="group1" id="byapi1" class="RemTab" checked>
                                    <label for="byapi1">Retailer</label>
                                </li>
                                <li class="tab-link2" data-tab="tab-6">
                                    <input type="radio" value="value2" name="group1" id="bysim1" class="WhiteLabelTab">
                                    <label for="bysim1">White Label</label>
                                    <input type="radio" name="retailer" value="value2" />
                                </li>
                            </ul>
                        </div>
                        <div id="tab-5" class="tab-content2 current2 current-tab-seconddesign tabcurrent-seconddesign">
                            <div class="fund-transfer-form cdc-charge-form">
                                <fieldset class="cdc-charge-fieldset">
                                    <legend>Add Charges</legend>
                                    <div class="cdc-form-grid">
                                        <div class="cdc-form-field cdc-form-field--full">
                                            <label for="RetailerId12">Select Retailer</label>
                                            @Html.DropDownList("RetailerId", (IEnumerable<SelectListItem>)ViewBag.RetailerId, "Select Retailer", new { id = "RetailerId12", @class = "for-select2 vm-opr-select form-control", data_live_search = "true" })
                                        </div>
                                        <div class="cdc-form-field">
                                            <label for="RemMinAmt">Minimum</label>
                                            <input class="form-control" type="text" placeholder="Min Amount" id="RemMinAmt">
                                        </div>
                                        <div class="cdc-form-field">
                                            <label for="RemMaxAmt">Maximum</label>
                                            <input class="form-control" type="text" placeholder="Max Amount" id="RemMaxAmt">
                                        </div>
                                        <div class="cdc-form-field">
                                            <label for="RemIMPSFee">IMPS (Fee)</label>
                                            <input class="form-control" type="text" placeholder="IMPS Fee" id="RemIMPSFee">
                                        </div>
                                        <div class="cdc-form-field">
                                            <label for="RemNEFTFee">NEFT (Fee)</label>
                                            <input class="form-control" type="text" placeholder="NEFT Fee" id="RemNEFTFee">
                                        </div>
                                    </div>
                                    <div class="cdc-form-footer">
                                        <button type="button" class="ne-btn-submit fieldset-save" id="SaveChargeREM"><i class="fas fa-save" aria-hidden="true"></i><span>Save</span></button>
                                    </div>
                                </fieldset>

                                <fieldset class="cdc-charge-fieldset cdc-wallet-setting">
                                    <legend>Wallet Unload Setting</legend>
                                    <div id="First" class="cdc-wallet-setting__view">
                                        <div class="cdc-wallet-setting__info">
                                            <span class="cdc-wallet-setting__label">Current Active</span>
                                            <span class="cdc-wallet-setting__value">@ViewBag.unload</span>
                                        </div>
                                        <button type="button" onclick="Edit1()" class="cdc-btn-chip cdc-btn-chip--edit">Edit</button>
                                    </div>
                                    <div id="Second" class="cdc-wallet-setting__edit" style="display:none;">
                                        <div class="cdc-wallet-setting__edit-row">
                                            @Html.DropDownList("apinm", new List<SelectListItem>
                                            {
                                              new SelectListItem{Text="24*7 Live", Value="0"},
                                              new SelectListItem{Text="9:00 AM to 6:00 PM", Value="1"},
                                              new SelectListItem{Text="10:00 AM to 7:00 PM", Value="2"},
                                              new SelectListItem{Text="11:00 AM to 8:00 PM", Value="3"},
                                              new SelectListItem{Text="8:00 AM to 10:00 AM", Value="4"},
                                              new SelectListItem{Text="11:00 AM to 1:00 PM", Value="5"},
                                              new SelectListItem{Text="11:00 AM to 4:00 PM", Value="6"},
                                              new SelectListItem{Text="4:00 PM to 6:00 PM", Value="7"},
                                              new SelectListItem{Text="Only Sunday Off", Value="8"},
                                              new SelectListItem{Text="Permanent Off", Value="9"}
                                           }, new { @class = "form-control vm-opr-select cdc-wallet-setting__select" })
                                            <button type="button" onclick="Save()" class="cdc-btn-chip cdc-btn-chip--save cdc-wallet-setting__save"><i class="fas fa-save" aria-hidden="true"></i><span>Save</span></button>
                                        </div>
                                    </div>
                                </fieldset>

                                <div class="cdc-slab-section">
                                    @using (Ajax.BeginForm("_WalletToBankSlabList", "Home", new AjaxOptions { HttpMethod = "GET", OnFailure = "failed", UpdateTargetId = "remcash1" }))
                                    {
                                        <div id="EditPurchageOrder1" class="cdc-slab-search">
                                            @Html.DropDownList("Retailerid", ViewBag.RetailerId2 as SelectList, "Select Retailer ID", new { @class = "for-select2 vm-opr-select form-control" })
                                            <button id="Retailersubmit1" type="submit" class="saas-acc-btn saas-acc-btn--search vm-ft-search-btn cdc-slab-search__btn">
                                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                                            </button>
                                        </div>
                                    }
                                    <div id="remcash1" class="cdc-slab-table-wrap">
                                        @Html.Partial("_WalletToBankSlabList")
                                    </div>
                                </div>
                            </div>
                        </div><!--  #tab-5 -->
                        <div id="tab-6" class="tab-content2">
                            <div class="fund-transfer-form cdc-charge-form" id="banks-modal3">
                                <fieldset class="cdc-charge-fieldset">
                                    <legend>Add Charges</legend>
                                    <div class="cdc-form-grid cdc-form-grid--wl">
                                        <div class="cdc-form-field">
                                            <label for="WhiteMinAmt">Minimum</label>
                                            <input class="form-control" type="text" placeholder="Min Amount" id="WhiteMinAmt">
                                        </div>
                                        <div class="cdc-form-field">
                                            <label for="WhiteMaxAmt">Maximum</label>
                                            <input class="form-control" type="text" placeholder="Max Amount" id="WhiteMaxAmt">
                                        </div>
                                        <div class="cdc-form-field">
                                            <label for="WhiteIMPSFee">IMPS (Fee)</label>
                                            <input class="form-control" type="text" placeholder="IMPS Fee" id="WhiteIMPSFee">
                                        </div>
                                        <div class="cdc-form-field">
                                            <label for="WhiteNEFTFee">NEFT (Fee)</label>
                                            <input class="form-control" type="text" placeholder="NEFT Fee" id="WhiteNEFTFee">
                                        </div>
                                    </div>
                                    <div class="cdc-form-footer">
                                        <button type="button" class="ne-btn-submit fieldset-save" id="SaveChargeWhite"><i class="fas fa-save" aria-hidden="true"></i><span>Save</span></button>
                                    </div>
                                </fieldset>
                                <div id="WhiteTbl" class="cdc-slab-table-wrap">
                                    @Html.Partial("_WalletToBankSlabList")
                                </div>
                            </div>
                        </div><!--  .#tab-6-->

                    </div><!-- #tab3-1 -->
                    <div id="tab3-2" class="width100 float-left tab-pane vm-ft-left-tab-pane ap-tab-panel cdc-left-panel" data-cdc-search="cash deposit charge retailer distributor master api whitelabel">
                        <div class="ap-segment-bar cdc-cash-segment" id="cdc-cash-segment" role="tablist" aria-label="Cash deposit role">
                            <button type="button" class="ap-segment-btn active" data-target="#Retailer">Retailer</button>
                            <button type="button" class="ap-segment-btn" data-target="#Distributor">Distributor</button>
                            <button type="button" class="ap-segment-btn" data-target="#Master">Master</button>
                            <button type="button" class="ap-segment-btn" data-target="#API">API</button>
                            <button type="button" class="ap-segment-btn" data-target="#WhiteLabel">WhiteLabel</button>
                        </div>
                        <div class="cash-charg-tab" style="display:none;">
                            <ul class="nav nav-pills" role="tablist">
                                <li class="nav-item active"><a class="nav-link active" data-toggle="pill" href="#Retailer">Retailer</a></li>
                                <li class="nav-item"><a class="nav-link" data-toggle="pill" href="#Distributor">Distributor</a></li>
                                <li class="nav-item"><a class="nav-link" data-toggle="pill" href="#Master">Master</a></li>
                                <li class="nav-item"><a class="nav-link" data-toggle="pill" href="#API">API</a></li>
                                <li class="nav-item"><a class="nav-link" data-toggle="pill" href="#WhiteLabel">WhiteLabel</a></li>
                            </ul>
                        </div>
                        <div class="tab-content cash-charg-tab-first cdc-deposit-tabs">
                            <div id="Retailer" class="tab-pane active">
                                <div class="cdc-deposit-panel">
                                    @using (Ajax.BeginForm("_CashDepositCharge", "Home", new AjaxOptions { HttpMethod = "GET", OnFailure = "failed", UpdateTargetId = "remcash" }))
                                    {
                                        <div id="EditPurchageOrder" class="cdc-deposit-toolbar">
                                            @Html.DropDownList("Retailerid", ViewBag.Retailerid as SelectList, "Select Retailer ID", new { @class = "for-select2 vm-opr-select form-control" })
                                            <button id="Retailersubmit" type="submit" class="saas-acc-btn saas-acc-btn--search vm-ft-search-btn cdc-deposit-toolbar__search"><i class="fas fa-search" aria-hidden="true"></i><span>Search</span></button>
                                            <button type="button" id="editbuttonRetailer" onclick="editRetailer()" class="cdc-btn-chip cdc-btn-chip--outline">Edit</button>
                                        </div>
                                    }
                                    <div id="remcash" class="cdc-deposit-table-wrap">
                                        @Html.Partial("_CashDepositCharge", Model)
                                    </div>
                                </div>
                            </div>
                            <div id="Distributor" class="tab-pane fade">
                                <div class="cdc-deposit-panel">
                                    @using (Ajax.BeginForm("_dlm_CashDepositCharge", "Home", new AjaxOptions { HttpMethod = "GET", OnFailure = "failed", UpdateTargetId = "dlmcash" }))
                                    {
                                        <div class="cdc-deposit-toolbar">
                                            @Html.DropDownList("Dealerid", ViewBag.Dealerid as SelectList, "Select Distributor ID", new { @class = "for-select2 vm-opr-select form-control" })
                                            <button id="Dealersubmit" type="submit" class="saas-acc-btn saas-acc-btn--search vm-ft-search-btn cdc-deposit-toolbar__search"><i class="fas fa-search" aria-hidden="true"></i><span>Search</span></button>
                                            <button type="button" id="editbuttonDealer" onclick="editDealer()" class="cdc-btn-chip cdc-btn-chip--outline">Edit</button>
                                        </div>
                                    }
                                    <div id="dlmcash" class="cdc-deposit-table-wrap">
                                        @Html.Partial("_dlm_CashDepositCharge", Model)
                                    </div>
                                </div>
                            </div>
                            <div id="Master" class="tab-pane fade">
                                <div class="cdc-deposit-panel">
                                    @using (Ajax.BeginForm("_EditPurchageOrder", "Home", new AjaxOptions { HttpMethod = "GET", OnFailure = "failed", UpdateTargetId = "farziidhye" }))
                                    {
                                        <div class="cdc-deposit-toolbar">
                                            @Html.DropDownList("Masterid", ViewBag.Masterid as SelectList, "Select Master ID", new { @class = "for-select2 vm-opr-select form-control" })
                                            <button id="mastersubmit" type="submit" class="saas-acc-btn saas-acc-btn--search vm-ft-search-btn cdc-deposit-toolbar__search"><i class="fas fa-search" aria-hidden="true"></i><span>Search</span></button>
                                            <button type="button" id="editbuttonmaster" onclick="editmaster()" class="cdc-btn-chip cdc-btn-chip--outline">Edit</button>
                                        </div>
                                    }
                                    <div id="farziidhye" class="cdc-deposit-table-wrap">
                                        @Html.Partial("_EditPurchageOrder", Model)
                                    </div>
                                </div>
                            </div>
                            <div id="API" class="tab-pane fade">
                                <div class="cdc-deposit-panel">
                                    @using (Ajax.BeginForm("_api_CashDepositCharge", "Home", new AjaxOptions { HttpMethod = "GET", OnFailure = "failed", UpdateTargetId = "apicash" }))
                                    {
                                        <div class="cdc-deposit-toolbar">
                                            @Html.DropDownList("Apiid", ViewBag.Apiid as SelectList, "Select API ID", new { @class = "for-select2 vm-opr-select form-control" })
                                            <button id="apisubmit" type="submit" class="saas-acc-btn saas-acc-btn--search vm-ft-search-btn cdc-deposit-toolbar__search"><i class="fas fa-search" aria-hidden="true"></i><span>Search</span></button>
                                            <button type="button" id="editbuttonapi" onclick="editApi()" class="cdc-btn-chip cdc-btn-chip--outline">Edit</button>
                                        </div>
                                    }
                                    <div id="apicash" class="cdc-deposit-table-wrap">
                                        @Html.Partial("_api_CashDepositCharge", Model)
                                    </div>
                                </div>
                            </div>
                            <div id="WhiteLabel" class="tab-pane fade">
                                <div class="cdc-deposit-panel">
                                    @using (Ajax.BeginForm("_white_CashDepositCharge", "Home", new AjaxOptions { HttpMethod = "GET", OnFailure = "failed", UpdateTargetId = "whitecash" }))
                                    {
                                        <div class="cdc-deposit-toolbar">
                                            @Html.DropDownList("Whitelabelid", ViewBag.White as SelectList, "Select WhiteLabel ID", new { @class = "for-select2 vm-opr-select form-control" })
                                            <button id="whitesubmit" type="submit" class="saas-acc-btn saas-acc-btn--search vm-ft-search-btn cdc-deposit-toolbar__search"><i class="fas fa-search" aria-hidden="true"></i><span>Search</span></button>
                                            <button type="button" id="editbuttonwhite" onclick="editWhite()" class="cdc-btn-chip cdc-btn-chip--outline">Edit</button>
                                        </div>
                                    }
                                    <div id="whitecash" class="cdc-deposit-table-wrap">
                                        @Html.Partial("_white_CashDepositCharge", Model)
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div><!-- #tab3-2 -->
                        </div><!-- cdc-left-body -->
                    </div><!-- vm-ft-form-card -->
                </div><!-- vm-ft-form-col -->

                <div class="col-md-8 col-sm-12 fund-transfer-main-admin vm-ft-history-col" style="padding-left:0;">
                    <div class="fund-trasfer-right vm-ft-history-panel">
                        <div class="vm-ft-history-body cdc-right-body">

                            <div class="vm-ft-history-toolbar vm-ft-history-toolbar--premium ap-history-head">
                                <div class="vm-ft-history-toolbar__head">
                                    <i class="fas fa-wallet" aria-hidden="true"></i>
                                    <div>
                                        <span class="vm-ft-history-toolbar__title" id="cdcRightPanelTitle">Unload Retailer Wallet</span>
                                        <span class="vm-ft-history-toolbar__sub">Unload &amp; POS wallet history</span>
                                    </div>
                                </div>
                            </div>

                            <ul class="nav nav-tabs fullbodydycolorbg1 tab-seconddesign tab-third-design vm-ft-role-tabs ap-right-role-tabs" id="ap-right-tabs">
                                <li class="tab-link vm-ft-role-tab-li vm-ft-role-tab-li--active current active ap-right-tab" data-tab="RetailerSRC" data-title="Unload Retailer Wallet" role="presentation">
                                    <a href="javascript:void(0);" class="vm-ft-role-tab" aria-expanded="true" aria-selected="true">Retailer Wallet</a>
                                </li>
                                <li class="tab-link vm-ft-role-tab-li vm-ft-role-tab-li--inactive ap-right-tab" data-tab="RetailerPOS" data-title="Pos To Main Wallet" role="presentation">
                                    <a href="javascript:void(0);" class="vm-ft-role-tab" aria-expanded="false" aria-selected="false">POS Wallet</a>
                                </li>
                                <li class="tab-link vm-ft-role-tab-li vm-ft-role-tab-li--inactive ap-right-tab" data-tab="WAdminSRC" data-title="Unload White Label Wallet" role="presentation">
                                    <a href="javascript:void(0);" class="vm-ft-role-tab" aria-expanded="false" aria-selected="false">White Label</a>
                                </li>
                            </ul>

                            <div id="cdcFiltersRetailer" class="vm-ft-history-toolbar__filters vm-ft-history-filters-row ap-seller-filter-toolbar is-visible cdc-filter-toolbar" data-cdc-search="unload retailer wallet search export">
                                <div class="vm-ft-history-field vm-opr-field vm-ft-history-field--user">
                                    @Html.DropDownList("RetailerId", (IEnumerable<SelectListItem>)ViewBag.RetailerId1, "Select Retailer", new { @class = "for-select2 vm-opr-select vm-dmt-select form-control", data_live_search = "true" })
                                </div>
                                <div class="vm-ft-history-field vm-opr-field vm-ft-history-field--mode">
                                    @Html.DropDownList("ddlstatus", new List<SelectListItem>
                                      {
                                  new SelectListItem{ Text="Status",Value="ALL"},
                                   new SelectListItem{ Text="Pending",Value="Pending"},
                                   new SelectListItem{Text="Success",Value="Success"},
                                   new SelectListItem{Text="Rejected",Value="Rejected"}
                                  }, new { @class = "for-select2 vm-opr-select vm-dmt-select form-control", data_live_search = "false" })
                                </div>
                                <div class="vm-dmt-filter-search-group vm-ft-date-search-group">
                                    <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                        <span class="saas-acc-dp-icon"><i class="fa fa-calendar" aria-hidden="true"></i></span>
                                        @Html.TextBox("txt_frm_date", "", new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", placeholder = "From", title = "From date" })
                                    </div>
                                    <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                        <span class="saas-acc-dp-icon"><i class="fa fa-calendar" aria-hidden="true"></i></span>
                                        @Html.TextBox("txt_to_date", "", new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", placeholder = "To", title = "To date" })
                                    </div>
                                    <button type="button" id="RetailerSearch" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-ft-search-btn">
                                        <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                                    </button>
                                    <div class="vm-ft-export-group ap-export-group pdfexpoer-second cashpdfclass">
                                        <button type="button" class="vm-ft-export-btn vm-ft-export-btn--excel" value="Export" title="Export Excel"><i class="fas fa-file-excel" aria-hidden="true"></i></button>
                                        <button type="button" class="vm-ft-export-btn vm-ft-export-btn--pdf" value="PDF" title="Export PDF"><i class="fas fa-file-pdf" aria-hidden="true"></i></button>
                                    </div>
                                </div>
                            </div>

                            <div id="cdcFiltersPOS" class="vm-ft-history-toolbar__filters vm-ft-history-filters-row ap-seller-filter-toolbar cdc-filter-toolbar" data-cdc-search="pos main wallet retailer">
                                <div class="vm-ft-history-field vm-opr-field vm-ft-history-field--user">
                                    @Html.DropDownList("RetailerIdpos", (IEnumerable<SelectListItem>)ViewBag.RetailerId11, "Select Retailer", new { @class = "for-select2 vm-opr-select vm-dmt-select form-control", data_live_search = "true" })
                                </div>
                                <div class="vm-dmt-filter-search-group vm-ft-date-search-group">
                                    <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                        <span class="saas-acc-dp-icon"><i class="fa fa-calendar" aria-hidden="true"></i></span>
                                        @Html.TextBox("txt_frm_datepos", "", new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", placeholder = "From", title = "From date" })
                                    </div>
                                    <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                        <span class="saas-acc-dp-icon"><i class="fa fa-calendar" aria-hidden="true"></i></span>
                                        @Html.TextBox("txt_to_datepos", "", new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", placeholder = "To", title = "To date" })
                                    </div>
                                    <button type="button" id="RetailerPOSMAINSearch" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-ft-search-btn">
