<script type="text/javascript">
    function cdcActivateRoleTabs($tabs, tabId) {
        $tabs.find('li').removeClass('active current vm-ft-role-tab-li--active acttt').addClass('vm-ft-role-tab-li--inactive');
        var $activeLi = $tabs.find('li[data-tab="' + tabId + '"]');
