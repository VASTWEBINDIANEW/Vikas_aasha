<script>
    function cdcResetDeleteActions($scope) {
        var $root = $scope && $scope.length ? $scope : $('.Cash_Deposit_Charge_Page');
        $root.find('.deleteCharged1').removeClass('is-hidden');
        $root.find('.deleteCharge').removeClass('is-visible');
    }

    function DeleteChrg(Idno, UserRole) {
        $.ajax({
            url: '@Url.Action("DeleteWalletToBankSlab", "Home")',
            data: { id: Idno, Role: UserRole },
            cache: false,
            type: "GET",
            success: function () {
                if (UserRole === "Retailer") {
                    $.ajax({
                        url: '@Url.Action("_WalletToBankSlabList", "Home")',
                        type: 'GET',
                        data: { Role: "Retailer", RetailerId: $("#Retailerid").val() || $("#RetailerId12").val() },
                        success: function (response) {
                            $('#remcash1').html(response);
                            cdcResetDeleteActions($('#remcash1'));
                        }
                    });
                } else if (UserRole === "WhiteLabel") {
                    $.ajax({
                        url: '@Url.Action("_WalletToBankSlabList", "Home")',
                        type: 'GET',
                        data: { Role: "WhiteLabel" },
                        success: function (response) {
                            $('#WhiteTbl').html(response);
                            cdcResetDeleteActions($('#WhiteTbl'));
                        }
                    });
                } else if (UserRole === "Seller") {
                    $.ajax({
                        url: '@Url.Action("_WalletToBankSlabList", "Home")',
                        type: 'GET',
                        data: { Role: "Seller" },
                        success: function (response) {
                            $('#SellerTbl').html(response);
                            cdcResetDeleteActions($('#SellerTbl'));
                        }
                    });
                }
            }
        });
    }

    $(document).on('click', '.Cash_Deposit_Charge_Page .deleteCharged1', function (e) {
        e.preventDefault();
        e.stopPropagation();
        var $wrap = $(this).closest('#remcash1, #WhiteTbl, #SellerTbl, .cdc-slab-table-wrap');
        cdcResetDeleteActions($wrap.length ? $wrap : $('.Cash_Deposit_Charge_Page'));
        var $group = $(this).closest('.cdc-table-actions__group');
        $group.find('.deleteCharged1').addClass('is-hidden');
        $group.find('.deleteCharge').addClass('is-visible');
    });
</script>
<script>
    function Edit1() {
        var mn = '@ViewBag.unload1';
        $("#apinm").val(mn).trigger('change');
        $('#First').hide();
        $('#Second').addClass('is-visible');
