    function Save() {
      $.ajax({
            url: '@Url.Action("updatecashcharge", "Home")',
            type: 'POST',
          data: { apinm: $("#apinm").val()},
            success: function (response) {
                location.reload();
            },
            error: function (xhr, status, error) {
                alert(error);
            }
        });
    }
</script>

