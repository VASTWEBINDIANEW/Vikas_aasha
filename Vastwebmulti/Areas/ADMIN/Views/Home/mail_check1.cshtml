@model Vastwebmulti.Models.Email_show_passcode
@{
    ViewBag.Title = "Email OTP Verification";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    ViewBag.OtpError = Convert.ToString(TempData["message12"]) ?? "";
}
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-high-security-gate.css?v=2" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-email-security-page.css?v=4" rel="stylesheet" />
<script src="~/Swalalert/sweetalert-dev.js"></script>
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />

<section class="content Email_Security_Page saas-admin-account-page" style="min-height:0;padding:0;">
    <div class="container-fluid vm-ft-page-shell" style="visibility:hidden;height:0;overflow:hidden;" aria-hidden="true"></div>
</section>

@Html.Partial("~/Areas/ADMIN/Views/Home/_EmailOtpGate.cshtml", Model)

<script>
    $(function () {
        var otpErr = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.OtpError as string ?? ""));
        if (otpErr && typeof swal === 'function') {
            swal({ title: "Invalid OTP", text: otpErr, type: "error", confirmButtonText: "Try again" });
        }
        $('#passcode').trigger('focus');
    });
</script>
