@model IEnumerable<Vastwebmulti.Models.admin_income_report_Result>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "My Day Book";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var reports = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.admin_income_report_Result>();
    var rowCount = reports.Count;

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
    DateTime postedToDate;
    if (dateMode == "post" && DateTime.TryParse(toDate, out postedToDate))
    {
        toDate = postedToDate.Date.AddDays(-1).ToString("yyyy-MM-dd");
    }

    decimal totalAmount = reports.Sum(x => x.amount ?? 0m);
    decimal totalPurchase = reports.Sum(x => x.purchase ?? 0m);
    decimal totalIncome = reports.Sum(x => x.income ?? 0m);

    Func<decimal?, string> fmtAmount = v => (v ?? 0m).ToString("N0");
    Func<decimal?, string> fmtMoney = v => (v ?? 0m).ToString("N2");
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=46" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=35" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-actual-daybook-modern.css?v=10" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-actual-daybook-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var dayBookFormAttrs = new Dictionary<string, object>
            {
                { "id", "actualDayBookForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("Actual_Admin_income", "Home", FormMethod.Post, dayBookFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-adb-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb vm-adb-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Account</li>
                        <li>Day Book</li>
                    </ol>

                    <div class="vm-adb-nav-row-shell vm-daybook-nav-row">
                        @Html.Partial("~/Areas/ADMIN/Views/Home/_DayBookNav.cshtml")
                    </div>

                    <div class="vm-dmt-filter-search-group vm-adb-filter-search-group">
                        <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                            <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                            @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                        </div>
                        <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                            <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                            @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                        </div>
                        <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn vm-adb-search-btn" title="Search">
                            <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                        </button>
                    </div>

                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="actualDayBookTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Day book totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideActualDayBookTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--primary">
                            <span class="vm-opr-total-card__label">Total Amount</span>
                            <strong class="vm-opr-total-card__value" id="adbTotalAmount">@totalAmount.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Total Purchase</span>
                            <strong class="vm-opr-total-card__value" id="adbTotalPurchase">@totalPurchase.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Total Income</span>
                            <strong class="vm-opr-total-card__value" id="adbTotalIncome">@totalIncome.ToString("N2")</strong>
                        </div>
                    </div>
                </div>

            </div>

            <input type="hidden" name="btnExport" id="hdnBtnExport" value="" />
        }

        <div class="vm-opr-main-card vm-prepaid-report-main-card" id="tblpdf">
            <div class="vm-opr-table-panel vm-prepaid-report-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head vm-adb-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-book-open" aria-hidden="true"></i>
                        <span>My day book</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong id="adbRecordCount">@rowCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total" title="Total income for current filter">
                            Income: <strong id="adbInlineIncome">@totalIncome.ToString("N2")</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-adb-totals-btn" onclick="findActualDayBookTotals()" title="Show totals" aria-expanded="false" aria-controls="actualDayBookTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnExportA" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDFA" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap vm-prepaid-table-wrap vm-adb-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="actualDayBookTable" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Sr.&nbsp;No</th>
                                    <th>Type</th>
                                    <th>Amount</th>
                                    <th>Purchase</th>
                                    <th>Retailer&nbsp;Comm</th>
                                    <th>Dealer&nbsp;Comm</th>
                                    <th>Master&nbsp;Comm</th>
                                    <th>Income</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (rowCount == 0)
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="8" class="vm-opr-table-empty vm-dmt-table-empty">
                                            <i class="fas fa-inbox" aria-hidden="true"></i>
                                            <span>No data found.</span>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    int srNo = 1;
                                    foreach (var item in reports)
                                    {
                                        <tr>
                                            <td class="vm-adb-num">@srNo</td>
                                            <td class="vm-adb-text">@item.trntype</td>
                                            <td class="vm-adb-num">@fmtAmount(item.amount)</td>
                                            <td class="vm-adb-num">@fmtMoney(item.purchase)</td>
                                            <td class="vm-adb-num">@fmtMoney(item.retailerfinal)</td>
                                            <td class="vm-adb-num">@fmtMoney(item.dealerfinal)</td>
                                            <td class="vm-adb-num">@fmtMoney(item.mdfinal)</td>
                                            <td class="vm-adb-num">@fmtMoney(item.income)</td>
                                        </tr>
                                        srNo++;
                                    }
                                    <tr class="vm-adb-row-total">
                                        <td class="vm-adb-text"><strong>Total</strong></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td class="vm-adb-num vm-adb-num--income"><strong>@totalIncome.ToString("N2")</strong></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<script src="~/MainFrontDesign/js/admin-report-pdf-export.js?v=1"></script>
<script src="~/MainFrontDesign/js/admin-report-excel-export.js?v=2"></script>

<script>
    function adbFormatYmd(dateObj) {
        var y = dateObj.getFullYear();
        var m = ('0' + (dateObj.getMonth() + 1)).slice(-2);
        var d = ('0' + dateObj.getDate()).slice(-2);
        return y + '-' + m + '-' + d;
    }

    function adbAddOneDayYmd(ymd) {
        if (!ymd) {
            return ymd;
        }
        var parts = ymd.split('-');
        if (parts.length !== 3) {
            return ymd;
        }
        var dt = new Date(parseInt(parts[0], 10), parseInt(parts[1], 10) - 1, parseInt(parts[2], 10));
        dt.setDate(dt.getDate() + 1);
        return adbFormatYmd(dt);
    }

    function submitActualDayBookForm(formEl) {
        if (!formEl) {
            return;
        }

        var $form = $(formEl);
        var frmVal = ($('#txt_frm_date').val() || '').trim();
        var toDisplay = ($('#txt_to_date').val() || '').trim();
        var toServer = adbAddOneDayYmd(toDisplay);

        $form.find('input[name="txt_frm_date"], input[name="txt_to_date"]').not('#txt_frm_date, #txt_to_date').remove();

        $('#txt_frm_date, #txt_to_date').removeAttr('name');

        $('<input>', { type: 'hidden', name: 'txt_frm_date', value: frmVal }).appendTo($form);
        $('<input>', { type: 'hidden', name: 'txt_to_date', value: toServer }).appendTo($form);

        formEl.submit();
    }

    function hideActualDayBookTotals() {
        var $panel = $('#actualDayBookTotalsPanel');
        var $btn = $('.vm-adb-totals-btn');
        $panel.hide().attr('aria-hidden', 'true');
        $btn.attr('aria-expanded', 'false');
    }

    function findActualDayBookTotals() {
        var $panel = $('#actualDayBookTotalsPanel');
        var $btn = $('.vm-adb-totals-btn');
        if ($panel.is(':visible')) {
            hideActualDayBookTotals();
            return;
        }
        $panel.show().attr('aria-hidden', 'false');
        $btn.attr('aria-expanded', 'true');
    }

    function initActualDayBookDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initActualDayBookDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm('#actualDayBookForm');
        }
    }

    function exportActualDayBookExcel() {
        var table = document.getElementById('actualDayBookTable');
        if (!table || typeof window.openAdminModernReportExcel !== 'function') {
            return;
        }

        window.openAdminModernReportExcel({
            table: table,
            title: 'My Day Book',
            subtitle: 'Actual admin income day book report',
            fromDate: document.getElementById('txt_frm_date') ? document.getElementById('txt_frm_date').value : '',
            toDate: document.getElementById('txt_to_date') ? document.getElementById('txt_to_date').value : '',
            recordCount: parseInt((document.getElementById('adbRecordCount') || {}).textContent, 10) || 0,
            filePrefix: 'DayBook_MyBook',
            sheetName: 'My Day Book'
        });
    }

    function exportActualDayBookPdf() {
        var table = document.getElementById('actualDayBookTable');
        if (!table || typeof window.openAdminModernReportPdf !== 'function') {
            return;
        }

        window.openAdminModernReportPdf({
            table: table,
            title: 'My Day Book',
            subtitle: 'Actual admin income day book report',
            fromDate: document.getElementById('txt_frm_date') ? document.getElementById('txt_frm_date').value : '',
            toDate: document.getElementById('txt_to_date') ? document.getElementById('txt_to_date').value : '',
            orientation: 'landscape',
            recordCount: parseInt((document.getElementById('adbRecordCount') || {}).textContent, 10) || 0
        });
    }

    $(document).ready(function () {
        initActualDayBookDatepickers();

        $('#actualDayBookForm').on('submit', function (e) {
            e.preventDefault();
            submitActualDayBookForm(this);
        });

        $('#actualDayBookForm button[type="submit"]').on('click', function () {
            $('#hdnBtnExport').val('');
        });

        $('#btnExportA').on('click', exportActualDayBookExcel);
        $('#btnPDFA').on('click', exportActualDayBookPdf);

        var $form = $('#actualDayBookForm');
        if ($form.length && ($form.attr('data-date-mode') || '').toLowerCase() === 'get') {
            var today = adbFormatYmd(new Date());
            $('#txt_frm_date').val(today);
            $('#txt_to_date').val(today);
            submitActualDayBookForm($form[0]);
        }
    });
</script>
