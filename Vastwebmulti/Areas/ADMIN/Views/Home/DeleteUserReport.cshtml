@model Vastwebmulti.Areas.ADMIN.Models.DeleteUser
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Delete User Report";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var reports  = (Model != null && Model.Deleteuserall != null)
                   ? Model.Deleteuserall.ToList()
                   : new List<Vastwebmulti.Models.DeleteUserHistory>();
    var rowCount = reports.Count;

    decimal totalRecovery = reports.Sum(i => i.RecoveryAmount ?? 0m);
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=42" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=27" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-security-report-page saas-delete-report-page">

    <div class="container-fluid vm-opr-page-shell">

        <!-- -- Toolbar: Breadcrumb + Search + Export -- -->
        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">
            <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line vm-gift-toolbar-one-line">

                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                    <li><a href="@Url.Action("Dashboard","Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>Report's</li>
                    <li>Delete User Report</li>
                </ol>

                <div class="vm-dur-filter-right">
                    <div class="vm-dur-search-field">
                        <i class="fas fa-search vm-dur-search-icon"></i>
                        <input id="myInput" type="text" placeholder="Search records..."
                               class="vm-dur-search-input"
                               onkeyup="durSearch()" autocomplete="off" />
                    </div>
                    <button type="button" id="btnExportA" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                        <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                    </button>
                    <button type="button" id="btnPDFA" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                        <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                    </button>
                </div>

            </div>
        </div>

        <!-- -- Main Card -- -->
        <div class="vm-opr-main-card vm-security-report-main-card vm-gift-report-main-card">
            <div class="vm-opr-table-panel vm-security-report-table-panel vm-gift-report-table-panel">

                <!-- Panel header -->
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head vm-security-report-table-head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-user-slash" aria-hidden="true"></i>
                        <span>Delete User Report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong>@rowCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total" title="Total recovery amount">
                            Recovery: <strong>&#8377; @totalRecovery.ToString("N2")</strong>
                        </span>
                    </div>
                </div>

                <!-- Table -->
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="deleteUserReportTable" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Sr</th>
                                    <th>User&nbsp;Role</th>
                                    <th>Firm&nbsp;Name</th>
                                    <th>User&nbsp;Name</th>
                                    <th>Contact&nbsp;No</th>
                                    <th>Register&nbsp;Email</th>
                                    <th>Joining&nbsp;Date</th>
                                    <th>Deleted&nbsp;Date</th>
                                    <th>Recovery&nbsp;&#8377;</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (reports.Any())
                                {
                                    int sr = 1;
                                    foreach (var item in reports)
                                    {
                                        var roleClass = "vm-role-badge";
                                        var role = (item.Role ?? "").ToLower();
                                        if (role.Contains("admin"))       { roleClass += " vm-role-badge--admin"; }
                                        else if (role.Contains("master")) { roleClass += " vm-role-badge--master"; }
                                        else if (role.Contains("dealer") || role.Contains("distributor")) { roleClass += " vm-role-badge--dealer"; }
                                        else if (role.Contains("retailer")) { roleClass += " vm-role-badge--retailer"; }
                                        else if (role.Contains("white"))  { roleClass += " vm-role-badge--wl"; }
                                        else                              { roleClass += " vm-role-badge--other"; }

                                        <tr>
                                            <td>@sr</td>
                                            <td><span class="@roleClass">@item.Role</span></td>
                                            <td>@item.FarmName</td>
                                            <td>@item.Name</td>
                                            <td>@item.ContectNo</td>
                                            <td>@item.Email</td>
                                            <td>@(item.JoiningDate.HasValue ? item.JoiningDate.Value.ToString("dd-MM-yyyy") : "—")</td>
                                            <td>@(item.DeleteDate.HasValue ? item.DeleteDate.Value.ToString("dd-MM-yyyy") : "—")</td>
                                            <td>@(item.RecoveryAmount.HasValue ? item.RecoveryAmount.Value.ToString("N2") : "0.00")</td>
                                        </tr>
                                        sr++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="9" style="text-align:center;padding:36px;color:#94a3b8;">
                                            <i class="fas fa-user-slash" style="font-size:2rem;display:block;margin-bottom:8px;opacity:.35;"></i>
                                            No deleted user records found.
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>

    </div>
</section>

<style>
    /* -- Role Badges -- */
    .vm-role-badge           { display:inline-flex; align-items:center; padding:2px 9px; border-radius:6px; font-size:.63rem; font-weight:700; white-space:nowrap; }
    .vm-role-badge--admin    { background:#fef3c7; color:#78350f; border:1px solid #fde68a; }
    .vm-role-badge--master   { background:#dbeafe; color:#1e40af; border:1px solid #bfdbfe; }
    .vm-role-badge--dealer   { background:#dcfce7; color:#14532d; border:1px solid #bbf7d0; }
    .vm-role-badge--retailer { background:#f3e8ff; color:#581c87; border:1px solid #d8b4fe; }
    .vm-role-badge--wl       { background:#fce7f3; color:#831843; border:1px solid #fbcfe8; }
    .vm-role-badge--other    { background:#f1f5f9; color:#475569; border:1px solid #e2e8f0; }

    /* -- Toolbar right group -- */
    .vm-dur-filter-right {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        margin-left: auto;
        flex-shrink: 0;
    }

    /* -- Modern Search Input -- */
    .vm-dur-search-field {
        position: relative;
        display: flex;
        align-items: center;
        min-width: 220px;
    }
    .vm-dur-search-icon {
        position: absolute;
        left: 10px;
        color: #94a3b8;
        font-size: .75rem;
        pointer-events: none;
        z-index: 1;
    }
    .vm-dur-search-input {
        width: 100%;
        height: 34px;
        padding: 0 12px 0 30px;
        border: 1.5px solid #e2e8f0;
        border-radius: 8px;
        font-size: .8rem;
        color: #1e293b;
        background: #f8fafc;
        outline: none;
        transition: border-color .15s, box-shadow .15s, background .15s;
        box-shadow: 0 1px 3px rgba(15,23,42,.06);
    }
    .vm-dur-search-input:focus {
        border-color: #0891b2;
        background: #fff;
        box-shadow: 0 0 0 3px rgba(8,145,178,.12);
    }
    .vm-dur-search-input::placeholder { color: #94a3b8; }

    /* -- Table scroll on all screens -- */
    .saas-delete-report-page .vm-opr-table-scroll {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }
    .saas-delete-report-page .vm-opr-data-table {
        min-width: 860px;
    }

    /* -- Mobile responsive -- */
    @@media (max-width: 767px) {
        /* page shell padding */
        body.saas-admin-ui .saas-delete-report-page .vm-opr-page-shell {
            padding-left: 8px !important;
            padding-right: 8px !important;
        }
        /* toolbar unified padding */
        body.saas-admin-ui .saas-delete-report-page .vm-opr-toolbar-unified {
            padding: 6px 8px 8px !important;
            margin-bottom: 12px !important;
        }
        /* right group fills full width */
        .vm-dur-filter-right {
            width: 100%;
            margin-left: 0;
            flex-wrap: wrap;
        }
        /* search takes full width */
        .vm-dur-search-field {
            flex: 1 1 100%;
            min-width: 0;
        }
        /* Excel + PDF buttons share a row */
        .vm-dur-filter-right .saas-acc-btn {
            flex: 1;
            justify-content: center;
            min-width: 0;
        }
        /* panel header: stack title above badges */
        body.saas-admin-ui .saas-delete-report-page .vm-dmt-table-panel__head {
            flex-direction: column !important;
            align-items: stretch !important;
            gap: 8px !important;
        }
        /* badge row: keep Records + Recovery side-by-side */
        body.saas-admin-ui .saas-delete-report-page .vm-dmt-table-panel__right {
            display: flex !important;
            flex-direction: row !important;
            flex-wrap: wrap !important;
            gap: 6px !important;
            width: 100% !important;
            margin-left: 0 !important;
            justify-content: flex-start !important;
        }
        /* override the width:100% applied via saas-security-report-page */
        body.saas-admin-ui .saas-delete-report-page .vm-radiant-record-badge,
        body.saas-admin-ui .saas-delete-report-page .vm-radiant-inline-total {
            width: auto !important;
            flex: 0 1 auto !important;
            text-align: left !important;
        }
        /* main card clear-fix */
        body.saas-admin-ui .saas-delete-report-page .vm-gift-report-main-card {
            margin-top: 10px !important;
            clear: both !important;
        }
    }
    @@media (max-width: 480px) {
        .vm-dur-filter-right {
            gap: 6px;
        }
    }
</style>

<script>
    function durSearch() {
        var value = $("#myInput").val().toLowerCase();
        $("#deleteUserReportTable tbody tr").filter(function () {
            $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
        });
    }

    $(document).ready(function () {
        $('#btnExportA').on('click', function () {
            location.href = '@Url.Action("Excel_DeleteUserReport", "Home")';
        });
        $('#btnPDFA').on('click', function () {
            window.open('@Url.Action("Pdf_DeleteUserReport", "Home")', '_blank');
        });
    });
</script>
