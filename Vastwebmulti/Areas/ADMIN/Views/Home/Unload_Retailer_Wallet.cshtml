@model Vastwebmulti.Areas.ADMIN.Models.CashDepositeAndBank_Info_VM

<style>
   /* new css */
    .table-responsive.action-design {
        background: #fff !important;
    }
   
   
   /* new css */

    .action-design table tr td:last-child button::after {
        display: none !important;
        content: none !important;
    }

    .action-design .btn:not(.btn-link):not(.btn-circle) i {
        top: 0px;
    }

    .Un-rwls-modal .modal-body label + span {
        min-height: 30px;
    }
</style>
<div class="row clearfix cdc-unload-report-root">
    <div class="col-md-12 col-sm-12 col-xs-12" style="padding:0;">
        <div class="card tablefourdesign-admin cdc-unload-report-card">

            <div class="body cdc-unload-report-body">

                <div class="table-responsive action-design cdc-unload-report-scroll">
                    <table class="table table-bordered third-design-table vm-ml-data-table cdc-unload-report-table">
                        <thead>
                            <tr>
                                <th>ReQ&nbsp;Status</th>
                                <th>User&nbsp;Firm</th>
                                <th>Transfer&nbsp;Type</th>
                                <th>Bank&nbsp;Account</th>
                                <th>TF&nbsp;Amount</th>
                                <th>Charge</th>
                                <th>Bank&nbsp;RRN</th>
                                <th>Request&nbsp;Date</th>
                                <th>Action&nbsp;&&nbsp;View</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.WalletUnloadReportAdmin.Count() > 0)
                            {
                                foreach (var item in Model.WalletUnloadReportAdmin)
                                {
                                    var i = item.Idno;
                                    var idno = "MNLSuccess";
                                    idno = idno + i;
                                    var idno1 = "MNLFailed";
                                    idno1 = idno1 + i;

                                    var color = ""; var sts = ""; var src = "";
                                    if (item.Status.ToUpper().Contains("PENDING"))
                                    {
                                        color = "#ff9f3a";
                                        sts = "Pending";
                                        src = "../../ashok-images/clock.svg";
                                    }
                                    else if (item.Status.ToUpper().Contains("SUCCESS"))
                                    {
                                        color = "#008000";
                                        sts = item.Status;
                                        src = "../../ashok-images/correct.svg";
                                    }
                                    else if (item.Status.ToUpper().Contains("REJECTED"))
                                    {
                                        color = "#ff0000";
                                        sts = "Rejected";
                                        src = "../../ashok-images/closes.svg";
                                    }
                                    else if (item.Status.ToUpper().Contains("REFUND"))
                                    {
                                        color = "brown";
                                        sts = "Refund";
                                        src = "../../ashok-images/backresnd.svg";

                                    }
                                    <tr>
                                        <td><img src=@src style="font-size: 14px;float: left;width: 20px;background:@color;padding: 4px;border-radius: 50%;" /><p>&nbsp;@sts</p></td>
                                        <td><p style="font-size:12px;">@Html.DisplayFor(modelItem => item.FirmName)</p></td>
                                        <td><p style="font-size:12px;">@Html.DisplayFor(modelItem => item.TransferType)</p></td>
                                        <td><p style="font-size:12px;">@Html.DisplayFor(modelItem => item.BankAccount)</p></td>
                                        <td><p style="font-size:12px;">@Html.DisplayFor(modelItem => item.Amount)</p></td>
                                        <td><p style="font-size:12px;">@Html.DisplayFor(modelItem => item.ProcessingCharge)</p></td>
                                        <td><p style="font-size:12px;">@Html.DisplayFor(modelItem => item.BankRRN)</p></td>
                                        <td><p style="font-size:12px;">@Html.DisplayFor(modelItem => item.RequestDate)</p></td>
                                        <td class="cdc-table-actions btn-succes-second">
                                            @if (item.Status.ToUpper().Contains("PENDING"))
                                            {
                                                <div class="cdc-table-actions__group">
                                                    <button type="button" class="cdc-table-action cdc-table-action--success checks btn-firstwhite-second" id="@idno" onclick="ManualSuccessAction('@item.Idno')" title="Manual Success" aria-label="Approve">
                                                        <i class="fas fa-check" aria-hidden="true"></i>
                                                    </button>
                                                    <button type="button" class="cdc-table-action cdc-table-action--danger time btn-firstwhite-second" onclick="ManualReject('@item.Idno')" title="Manual Reject" aria-label="Reject">
                                                        <i class="fas fa-times" aria-hidden="true"></i>
                                                    </button>
                                                    <button type="button" onclick="Actions('@item.Idno')" class="cdc-table-action cdc-table-action--view special-iii btn-firstwhite-second" title="View details" aria-label="View details" data-toggle="modal">
                                                        <i class="fas fa-chevron-right" aria-hidden="true"></i>
                                                    </button>
                                                </div>
                                            }
                                            else if (item.Status.ToUpper().Contains("REJECTED"))
                                            {
                                                <div class="cdc-table-actions__group">
                                                    <button type="button" class="cdc-table-action cdc-table-action--success checks btn-firstwhite-second" id="@idno" onclick="FailedToSuccess('@item.Idno', '@item.Status')" title="Manual Success" aria-label="Approve">
                                                        <i class="fas fa-check" aria-hidden="true"></i>
                                                    </button>
                                                    <button type="button" onclick="Actions('@item.Idno')" class="cdc-table-action cdc-table-action--view special-iii btn-firstwhite-second" title="View details" aria-label="View details" data-toggle="modal">
                                                        <i class="fas fa-chevron-right" aria-hidden="true"></i>
                                                    </button>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="cdc-table-actions__group">
                                                    <button type="button" onclick="Actions('@item.Idno')" class="cdc-table-action cdc-table-action--view special-iii btn-firstwhite-second" title="View details" aria-label="View details" data-toggle="modal">
                                                        <i class="fas fa-chevron-right" aria-hidden="true"></i>
                                                    </button>
                                                </div>
                                            }

                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr class="cdc-empty-row">
                                    <td colspan="9">No wallet unload records found. Use filters above and click Search.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <!-- Static Data End-->
                <!-- Table for modal -->
            </div>
        </div>
    </div>
</div>
<!-- Script For Loder -->
<script>
    $('.btnssl2233').on('click', function () {
        var $this = $(this);
        $this.button('loading');
        setTimeout(function () {
            $this.button('reset');
        }, 500);
    });
</script>

<script>
    function cdcGetUnloadReloadParams() {
        var isWAdmin = $('#WAdminSRC').hasClass('active') || $('#WAdminSRC').hasClass('current3');
        if (isWAdmin) {
            return {
                ddlusers: 'WAdmin',
                RetailerId: $('#Whitelabel').val() || '',
                ddlstatus: $('#ddlstatus_wadmin').val() || '',
                txt_frm_date: $('#txt_frm_date_wadmin').val() || '',
                txt_to_date: $('#txt_to_date_wadmin').val() || '',
                target: '#WAdminSearchList'
            };
        }
        return {
            ddlusers: 'Retailer',
            RetailerId: $('#RetailerId').val() || '',
            ddlstatus: $('#ddlstatus').val() || '',
            txt_frm_date: $('#txt_frm_date').val() || '',
            txt_to_date: $('#txt_to_date').val() || '',
            target: '#RetailerSearchList'
        };
    }

    function cdcReloadUnloadTable() {
        var $ = window.vmAdminJq || window.jQuery;
        var cfg;
        if (!$) {
            return;
        }
        if (typeof window.cdcReloadUnloadWalletList === 'function') {
            window.cdcReloadUnloadWalletList();
            return;
        }
        cfg = cdcGetUnloadReloadParams();
        $.ajax({
            url: '@Url.Action("Unload_Retailer_Wallet","Home")',
            type: 'POST',
            data: {
                ddlusers: cfg.ddlusers,
                RetailerId: cfg.RetailerId,
                ddlstatus: cfg.ddlstatus,
                txt_frm_date: cfg.txt_frm_date,
                txt_to_date: cfg.txt_to_date
            },
            success: function (response) {
                $(cfg.target).html(response);
                if (typeof window.bootVmAdminSelectSearch === 'function') {
                    window.bootVmAdminSelectSearch($(cfg.target));
                } else if (typeof window.refreshAdminSelect2 === 'function') {
                    window.refreshAdminSelect2($(cfg.target));
                }
            }
        });
    }

    function FailedToSuccess(idno, status) {
        if (status !== 'Rejected') {
            return;
        }
        swal({
            title: 'Mark as success?',
            text: 'This will change rejected request to success.',
            type: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, continue',
            cancelButtonText: 'Cancel',
            closeOnConfirm: true
        }, function (isConfirm) {
            if (!isConfirm) {
                return;
            }
            $.ajax({
                url: '@Url.Action("wallet_upload_failed_to_success", "Home")',
                type: 'POST',
                data: { idno: idno },
                success: function () {
                    swal('Success!', 'Request updated successfully.', 'success');
                    cdcReloadUnloadTable();
                },
                error: function () {
                    swal('Oops!', 'Unable to update request.', 'error');
                }
            });
        });
    }
</script>


<script>
    $('.third-design .third-design-table tbody td').mouseenter(function () {
        var colIndex = $(this).parent().children().index($(this)) + 1;
        var rowIndex = $(this).parent().parent().children().index($(this).parent()) + 1;
        $(".third-design-table td:nth-child(" + colIndex + ")").css('background', 'var(--main-bg-rcolor)');
        $(".third-design-table td:nth-child(" + colIndex + ")").css('color', '#fff');
        $(".third-design-table tbody tr:nth-child(" + rowIndex + ")").css('background', 'var(--main-bg-rcolor)');
    });

    $('.third-design .third-design-table tbody td').mouseleave(function () {
        var colIndex = $(this).parent().children().index($(this)) + 1;
        var rowIndex = $(this).parent().parent().children().index($(this).parent()) + 1;
        $(".third-design-table td:nth-child(" + colIndex + ")").css('background', 'transparent');
        $(".third-design-table td:nth-child(" + colIndex + ")").css('color', '#333');
        $(".third-design-table tbody tr:nth-child(" + rowIndex + ")").css('background', 'transparent');
    });

    function SuccessToFailed(idno, status) {
        if (status !== 'Success') {
            return;
        }
        swal({
            title: 'Mark as failed?',
            text: 'This will change success request to failed.',
            type: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, continue',
            cancelButtonText: 'Cancel',
            closeOnConfirm: true
        }, function (isConfirm) {
            if (!isConfirm) {
                return;
            }
            $.ajax({
                url: '@Url.Action("wallet_upload_success_to_failed", "Home")',
                type: 'POST',
                data: { idno: idno },
                success: function () {
                    swal('Updated!', 'Request updated successfully.', 'success');
                    cdcReloadUnloadTable();
                },
                error: function () {
                    swal('Oops!', 'Unable to update request.', 'error');
                }
            });
        });
    }
</script>