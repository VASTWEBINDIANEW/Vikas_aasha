@model Vastwebmulti.Areas.ADMIN.Models.optmergeforsell
@using Vastwebmulti.Models
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Sell Recharge Operator List";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    VastwebmultiEntities db = new VastwebmultiEntities();
    var retailerIds = new HashSet<string>(db.Retailer_Details.Select(s => s.RetailerId));
    var mergeCount = Model.optmerge != null ? Model.optmerge.Count() : 0;
    var commCount = Model.optcomm != null ? Model.optcomm.Count() : 0;
    var pendingCount = Model.optcomm != null ? Model.optcomm.Count(c => c.status == "Pending") : 0;
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-settings-page-modern.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-support-pages-modern.css?v=2" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-settings-page saas-sell-recharge-opt-page">
    <div class="container-fluid">

        
        <div class="saas-acc-toolbar">
            <ol class="saas-acc-breadcrumb">
                <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                <li><a href="@Url.Action("More_Option", "Home")">More Options</a></li>
                <li>Sell Recharge Comm %</li>
            </ol>
            <div class="saas-acc-toolbar-right">
                @using (Html.BeginForm("merge_opt1", "Home", FormMethod.Post, new { @class = "saas-set-merge-form" }))
                {
                    @Html.DropDownList("OPTCODEOFAPI", ViewBag.OPTCODEOFAPI as SelectList, "Select API Operator", new { @class = "form-control" })
                    @Html.DropDownList("OPTCODEOFService", ViewBag.OPTCODEOFService as SelectList, "Select Your Operator", new { @class = "form-control" })
                    <input type="submit" value="Save mapping" class="saas-set-btn-primary" />
                }
            </div>
        </div>

        <div class="saas-acc-table-card">
            <div class="saas-acc-table-card-head">
                <h3>Operator mapping</h3>
                <span class="saas-acc-row-count"><i class="fas fa-list" aria-hidden="true"></i> @mergeCount records</span>
            </div>
            <div class="saas-acc-table-wrap table-responsive">
                <table class="table saas-acc-table table-bordered">
                    <thead>
                        <tr>
                            <th>API Operator</th>
                            <th>API Operator Code</th>
                            <th>My Operator</th>
                            <th>My Operator Code</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.optmerge != null)
                        {
                            foreach (var i in Model.optmerge)
                            {
                                <tr>
                                    <td data-label="API Operator">@i.api_operator</td>
                                    <td data-label="API Code">@i.api_optcode</td>
                                    <td data-label="My Operator">@i.self_operator</td>
                                    <td data-label="My Code">@i.self_optcode</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="saas-acc-table-card">
            <div class="saas-acc-table-card-head">
                <h3>Commission requests</h3>
                <span class="saas-acc-row-count"><i class="fas fa-list" aria-hidden="true"></i> @commCount records</span>
            </div>
            <div class="saas-acc-table-wrap table-responsive">
                <table class="table saas-acc-table table-bordered">
                    <thead>
                        <tr>
                            <th>User</th>
                            <th>Email</th>
                            <th>Firm Name</th>
                            <th>Operator</th>
                            <th>Comm %</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.optcomm != null)
                        {
                            foreach (var i in Model.optcomm)
                            {
                                var isRetailer = retailerIds.Contains(i.userid);
                                <tr>
                                    <td data-label="User">@i.dlm_Name <span class="saas-set-user-type"><i class="fas fa-user-tag" aria-hidden="true"></i> @(isRetailer ? "Retailer" : "Distributor")</span></td>
                                    <td data-label="Email">@i.Email</td>
                                    <td data-label="Firm">@i.farmname</td>
                                    <td data-label="Operator">@i.operator_1</td>
                                    <td data-label="Comm %">@i.comm %</td>
                                    <td data-label="Status">
                                        @if (i.status == "Pending")
                                        {
                                            <span class="saas-set-badge-pending">Pending</span>
                                        }
                                        else
                                        {
                                            <span class="saas-set-badge-done">@i.status</span>
                                        }
                                    </td>
                                    <td data-label="Action">
                                        @if (i.status == "Pending")
                                        {
                                            <div class="saas-set-action-group">
                                                <a href="@Url.Action("sellrechargeoptUpdate", "Home", new { idno = i.idno, status = "Reject" })" class="saas-set-btn-danger">Reject</a>
                                                <a href="@Url.Action("sellrechargeoptUpdate", "Home", new { idno = i.idno, status = "Success" })" class="saas-set-btn-success">Approve</a>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</section>
