@model IEnumerable<Vastwebmulti.Models.retailer_Ekycreport_Result>
@using System.Linq
@{
    Layout = null;
    var rows         = (Model ?? Enumerable.Empty<Vastwebmulti.Models.retailer_Ekycreport_Result>()).ToList();
    var recordCount  = rows.Count;
    var verCount     = rows.Count(r => r.ekycstatus == true);
    var unverCount   = rows.Count(r => r.ekycstatus == false);
    var unreg        = recordCount - verCount - unverCount;
    var generatedOn  = DateTime.Now.ToString("dd MMM yyyy, hh:mm tt");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Retailer eKYC Report</title>
    <style type="text/css">
        @@page { size: A4 landscape; margin: 12mm 10mm 14mm 10mm; }
        * { box-sizing: border-box; }
        body { margin:0; padding:0; font-family:Arial,Helvetica,sans-serif; font-size:10px; color:#1e293b; background:#fff; -webkit-print-color-adjust:exact; print-color-adjust:exact; }
        table { page-break-inside:auto; border-collapse:collapse; }
        tr { page-break-inside:avoid; page-break-after:auto; }
        thead { display:table-header-group; }
        .vm-ml-pdf { width:100%; }
        .vm-ml-pdf__header { width:100%; margin-bottom:14px; border:1px solid #dbe2ea; border-radius:10px; overflow:hidden; }
        .vm-ml-pdf__hero { padding:12px 20px; background:#2563eb; background:-webkit-linear-gradient(135deg,#2563eb,#4f46e5); background:linear-gradient(135deg,#2563eb 0%,#4f46e5 100%); color:#fff; -webkit-print-color-adjust:exact; print-color-adjust:exact; }
        .vm-ml-pdf__title { margin:0; font-size:16px; font-weight:700; }
        .vm-ml-pdf__subtitle { margin:3px 0 0; font-size:10px; opacity:.9; }
        .vm-ml-pdf__meta { width:100%; border-top:1px solid #e2e8f0; background:#f8fafc; }
        .vm-ml-pdf__meta td { padding:7px 10px; border-right:1px solid #e2e8f0; vertical-align:middle; }
        .vm-ml-pdf__meta td:last-child { border-right:none; }
        .vm-ml-pdf__meta-label { display:block; font-size:8px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:#64748b; margin-bottom:2px; }
        .vm-ml-pdf__meta-value { font-size:10px; font-weight:700; color:#0f172a; }
        .vm-ml-pdf__table-wrap { width:100%; border:1px solid #dbe2ea; border-radius:10px; overflow:hidden; }
        .vm-ml-pdf__table { width:100%; border:none; }
        .vm-ml-pdf__table thead th { padding:8px 4px; text-align:left; font-size:7.5px; font-weight:700; text-transform:uppercase; letter-spacing:.04em; color:#fff; background:#334155; -webkit-print-color-adjust:exact; print-color-adjust:exact; border-bottom:2px solid #1e293b; white-space:nowrap; }
        .vm-ml-pdf__table tbody td { padding:6px 4px; border-bottom:1px solid #e2e8f0; vertical-align:middle; font-size:9px; color:#334155; }
        .vm-ml-pdf__table tbody tr:nth-child(even) td { background:#f8fafc; }
        .vm-ml-pdf__sr { width:28px; text-align:center; }
        .vm-ml-pdf__firm { font-weight:700; color:#0f172a; }
        .vm-ml-pdf__mono { font-family:"Courier New",monospace; font-size:8.5px; }
        .vm-ml-pdf__badge { display:inline-block; min-width:44px; padding:3px 7px; border-radius:999px; font-size:7.5px; font-weight:700; text-align:center; line-height:1.2; -webkit-print-color-adjust:exact; print-color-adjust:exact; }
        .vm-ml-pdf__badge--done { background:#ecfdf5; color:#047857; border:1px solid #bbf7d0; }
        .vm-ml-pdf__badge--due  { background:#fee2e2; color:#b91c1c; border:1px solid #fecaca; }
        .vm-ml-pdf__badge--off  { background:#f1f5f9; color:#475569; border:1px solid #cbd5e1; }
        .vm-ml-pdf__empty { padding:24px 16px; text-align:center; color:#64748b; font-size:11px; font-weight:600; }
        .vm-ml-pdf__footer { margin-top:10px; padding-top:7px; border-top:1px dashed #dbe2ea; font-size:8.5px; color:#94a3b8; text-align:center; }
    </style>
</head>
<body>
    <div class="vm-ml-pdf">

        <div class="vm-ml-pdf__header">
            <div class="vm-ml-pdf__hero">
                <h1 class="vm-ml-pdf__title">Retailer eKYC Report</h1>
                <p class="vm-ml-pdf__subtitle">eKYC verification status &mdash; Admin Panel</p>
            </div>
            <table class="vm-ml-pdf__meta" cellpadding="0" cellspacing="0">
                <tr>
                    <td style="width:22%;"><span class="vm-ml-pdf__meta-label">Generated On</span><span class="vm-ml-pdf__meta-value">@generatedOn</span></td>
                    <td style="width:14%;"><span class="vm-ml-pdf__meta-label">Total Records</span><span class="vm-ml-pdf__meta-value">@recordCount</span></td>
                    <td style="width:14%;"><span class="vm-ml-pdf__meta-label">Verified</span><span class="vm-ml-pdf__meta-value">@verCount</span></td>
                    <td style="width:14%;"><span class="vm-ml-pdf__meta-label">Unverified</span><span class="vm-ml-pdf__meta-value">@unverCount</span></td>
                    <td style="width:14%;"><span class="vm-ml-pdf__meta-label">Unregistered</span><span class="vm-ml-pdf__meta-value">@unreg</span></td>
                    <td style="width:22%;"><span class="vm-ml-pdf__meta-label">Report Type</span><span class="vm-ml-pdf__meta-value">Retailer eKYC Status</span></td>
                </tr>
            </table>
        </div>

        <div class="vm-ml-pdf__table-wrap">
            @if (recordCount > 0)
            {
                <table class="vm-ml-pdf__table" cellpadding="0" cellspacing="0">
                    <thead>
                        <tr>
                            <th class="vm-ml-pdf__sr">SR</th>
                            <th style="text-align:center;">Status</th>
                            <th>Firm Name</th>
                            <th>Email Id</th>
                            <th>Mobile No</th>
                            <th>Aadhaar No</th>
                            <th>PAN Card</th>
                            <th>Merchant Id</th>
                            <th>eKYC Mobile</th>
                            <th>eKYC Aadhaar</th>
                            <th>In Date</th>
                            <th>Update Date</th>
                            <th>Device Info</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var id = 1; }
                        @foreach (var item in rows)
                        {
                            string badgeCls, badgeTxt;
                            if (item.ekycstatus == true)       { badgeCls = "vm-ml-pdf__badge--done";  badgeTxt = "Verified";     }
                            else if (item.ekycstatus == false) { badgeCls = "vm-ml-pdf__badge--due";   badgeTxt = "Unverified";   }
                            else                               { badgeCls = "vm-ml-pdf__badge--off";   badgeTxt = "Unregistered"; }
                            <tr>
                                <td class="vm-ml-pdf__sr">@(id++)</td>
                                <td style="text-align:center;"><span class="vm-ml-pdf__badge @badgeCls">@badgeTxt</span></td>
                                <td><span class="vm-ml-pdf__firm">@item.frm_name</span></td>
                                <td>@item.email</td>
                                <td class="vm-ml-pdf__mono">@item.mobile</td>
                                <td class="vm-ml-pdf__mono">@item.AadharCard</td>
                                <td class="vm-ml-pdf__mono">@item.Pancard</td>
                                <td class="vm-ml-pdf__mono">@item.AepsMerchandId</td>
                                <td class="vm-ml-pdf__mono">@item.ekycmobile</td>
                                <td class="vm-ml-pdf__mono">@item.ekycadhaar</td>
                                <td>@item.insertdate</td>
                                <td>@item.updatedate</td>
                                <td>@item.devicename @item.devicesrno</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="vm-ml-pdf__empty">No eKYC records found.</div>
            }
        </div>

        <div class="vm-ml-pdf__footer">Retailer eKYC Report &mdash; @generatedOn</div>
    </div>
</body>
</html>
