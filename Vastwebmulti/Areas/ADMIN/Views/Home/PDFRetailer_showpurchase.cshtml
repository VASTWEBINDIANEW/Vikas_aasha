@model IEnumerable<Vastwebmulti.Models.select_rem_pur_order_Result>
@using System.Linq
@{
    Layout = null;
    var rows = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.select_rem_pur_order_Result>();
    var generatedOn = DateTime.Now.ToString("dd MMM yyyy, hh:mm tt");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Retailer Purchase Orders</title>
    <style type="text/css">
        @@page { size: A4 landscape; margin: 12mm 10mm 14mm 10mm; }
        * { box-sizing: border-box; }
        body { margin:0; padding:0; font-family:Arial,Helvetica,sans-serif; font-size:10px; color:#1e293b; background:#fff; -webkit-print-color-adjust:exact; print-color-adjust:exact; }
        table { page-break-inside:auto; border-collapse:collapse; }
        tr { page-break-inside:avoid; page-break-after:auto; }
        thead { display:table-header-group; }
        .vm-ml-pdf { width:100%; }
        .vm-ml-pdf__header { width:100%; margin-bottom:14px; border:1px solid #dbe2ea; border-radius:10px; overflow:hidden; }
        .vm-ml-pdf__hero { padding:12px 20px; background:#2563eb; background:-webkit-linear-gradient(135deg,#2563eb,#4f46e5); background:linear-gradient(135deg,#2563eb 0%,#4f46e5 100%); color:#fff; -webkit-print-color-adjust:exact; print-color-adjust:exact; }
        .vm-ml-pdf__title { margin:0; font-size:16px; font-weight:700; }
        .vm-ml-pdf__subtitle { margin:3px 0 0; font-size:10px; opacity:.9; }
        .vm-ml-pdf__meta { width:100%; border-top:1px solid #e2e8f0; background:#f8fafc; }
        .vm-ml-pdf__meta td { padding:7px 10px; border-right:1px solid #e2e8f0; vertical-align:middle; }
        .vm-ml-pdf__meta td:last-child { border-right:none; }
        .vm-ml-pdf__meta-label { display:block; font-size:8px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:#64748b; margin-bottom:2px; }
        .vm-ml-pdf__meta-value { font-size:10px; font-weight:700; color:#0f172a; }
        .vm-ml-pdf__table-wrap { width:100%; border:1px solid #dbe2ea; border-radius:10px; overflow:hidden; }
        .vm-ml-pdf__table { width:100%; border:none; }
        .vm-ml-pdf__table thead th { padding:8px 6px; text-align:left; font-size:8px; font-weight:700; text-transform:uppercase; letter-spacing:.04em; color:#fff; background:#334155; -webkit-print-color-adjust:exact; print-color-adjust:exact; border-bottom:2px solid #1e293b; white-space:nowrap; }
        .vm-ml-pdf__table tbody td { padding:7px 6px; border-bottom:1px solid #e2e8f0; vertical-align:middle; font-size:9.5px; color:#334155; }
        .vm-ml-pdf__table tbody tr:nth-child(even) td { background:#f8fafc; }
        .vm-ml-pdf__table tfoot td { padding:7px 6px; font-weight:700; background:#f1f5f9; border-top:2px solid #334155; font-size:9.5px; }
        .vm-ml-pdf__firm { font-weight:700; color:#0f172a; }
        .vm-ml-pdf__mono { font-family:"Courier New",monospace; font-size:9px; }
        .vm-ml-pdf__amt  { font-weight:700; color:#2563eb; white-space:nowrap; }
        .vm-ml-pdf__badge { display:inline-block; min-width:44px; padding:3px 8px; border-radius:999px; font-size:8px; font-weight:700; text-align:center; line-height:1.2; -webkit-print-color-adjust:exact; print-color-adjust:exact; }
        .vm-ml-pdf__badge--success { background:#ecfdf5; color:#047857; border:1px solid #bbf7d0; }
        .vm-ml-pdf__badge--fail    { background:#fee2e2; color:#b91c1c; border:1px solid #fecaca; }
        .vm-ml-pdf__badge--pending { background:#fef9c3; color:#854d0e; border:1px solid #fde68a; }
        .vm-ml-pdf__empty { padding:24px 16px; text-align:center; color:#64748b; font-size:11px; font-weight:600; }
        .vm-ml-pdf__footer { margin-top:10px; padding-top:7px; border-top:1px dashed #dbe2ea; font-size:8.5px; color:#94a3b8; text-align:center; }
    </style>
</head>
<body>
<div class="vm-ml-pdf">
    <div class="vm-ml-pdf__header">
        <div class="vm-ml-pdf__hero">
            <h1 class="vm-ml-pdf__title">Retailer Purchase Orders</h1>
            <p class="vm-ml-pdf__subtitle">Retailer wallet load purchase orders &mdash; Admin Panel</p>
        </div>
        <table class="vm-ml-pdf__meta" cellpadding="0" cellspacing="0">
            <tr>
                <td style="width:25%;"><span class="vm-ml-pdf__meta-label">Generated On</span><span class="vm-ml-pdf__meta-value">@generatedOn</span></td>
                <td style="width:25%;"><span class="vm-ml-pdf__meta-label">Total Records</span><span class="vm-ml-pdf__meta-value">@rows.Count</span></td>
                <td style="width:25%;"><span class="vm-ml-pdf__meta-label">Total Amount</span><span class="vm-ml-pdf__meta-value">@rows.Sum(a => a.amount)</span></td>
                <td style="width:25%;"><span class="vm-ml-pdf__meta-label">Report Type</span><span class="vm-ml-pdf__meta-value">Retailer Purchase</span></td>
            </tr>
        </table>
    </div>
    <div class="vm-ml-pdf__table-wrap">
        @if (rows.Any())
        {
            <table class="vm-ml-pdf__table" cellpadding="0" cellspacing="0">
                <thead>
                    <tr>
                        <th>Order No</th>
                        <th>Status</th>
                        <th>Retailer Info</th>
                        <th>Request Date</th>
                        <th>Payment Mode</th>
                        <th>Amount</th>
                        <th>Charge</th>
                        <th>Bank Name</th>
                        <th>Admin Acc No</th>
                        <th>UTR No / Slip No</th>
                        <th>Comment</th>
                        <th>Response Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in rows)
                    {
                        var sts1 = item.sts.ToUpper().Contains("REQ") ? "Pending" : item.sts;
                        string badgeCls = sts1.Contains("Success") || sts1.Contains("Approved") ? "vm-ml-pdf__badge--success" : sts1.Contains("Pending") ? "vm-ml-pdf__badge--pending" : "vm-ml-pdf__badge--fail";
                        <tr>
                            <td class="vm-ml-pdf__mono">@item.orderno</td>
                            <td><span class="vm-ml-pdf__badge @badgeCls">@sts1</span></td>
                            <td class="vm-ml-pdf__firm">@item.RemEmail</td>
                            <td>@item.reqdate</td>
                            <td>@item.paymode</td>
                            <td class="vm-ml-pdf__amt">@item.amount</td>
                            <td>@item.cashDepositCharge</td>
                            <td>@item.banknm</td>
                            <td class="vm-ml-pdf__mono">@item.Toaccountno</td>
                            <td class="vm-ml-pdf__mono">@item.utrno</td>
                            <td>@item.details</td>
                            <td>@item.responsedate</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="5">Total</td>
                        <td class="vm-ml-pdf__amt">@rows.Sum(a => a.amount)</td>
                        <td colspan="6"></td>
                    </tr>
                </tfoot>
            </table>
        }
        else { <div class="vm-ml-pdf__empty">No records found.</div> }
    </div>
    <div class="vm-ml-pdf__footer">Retailer Purchase Orders &mdash; @generatedOn</div>
</div>
</body>
</html>
