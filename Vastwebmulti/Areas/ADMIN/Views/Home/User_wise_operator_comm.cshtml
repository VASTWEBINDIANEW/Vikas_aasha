@using Vastwebmulti.Models
@model IEnumerable<Vastwebmulti.Models.User_wise_comm_report_Result>
@using System.Linq
@{
    ViewBag.Title = "User_wise_operator_comm";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var reports = Model ?? Enumerable.Empty<User_wise_comm_report_Result>();
    var rowCount = reports.Count();

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";

    var selDdlUsers = (Request["ddlusers"] ?? "Admin").Trim();
    if (string.IsNullOrEmpty(selDdlUsers)) { selDdlUsers = "Admin"; }
    var selAllmaster = (Request["allmaster"] ?? "").Trim();
    var selAlldealer = (Request["alldealer"] ?? "").Trim();
    var selAllretailer = (Request["allretailer"] ?? "").Trim();
    var selAllwhitelabel = (Request["allwhitelabel"] ?? "").Trim();
    var selAllapiuser = (Request["allapiuser"] ?? "").Trim();

    Func<object, IEnumerable<SelectListItem>> getSelectItems = bag =>
    {
        var selectList = bag as SelectList;
        if (selectList != null) { return selectList; }
        return bag as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
    };

    var ddlUsersItems = new List<SelectListItem>
    {
        new SelectListItem { Text = "Admin", Value = "Admin" },
        new SelectListItem { Text = "Master Distributor", Value = "Master" },
        new SelectListItem { Text = "Distributor", Value = "Dealer" },
        new SelectListItem { Text = "Retailer", Value = "Retailer" },
        new SelectListItem { Text = "API User", Value = "APIID" },
        new SelectListItem { Text = "Whitelabel", Value = "Whitelabel" }
    };
    var ddlUsersList = new SelectList(ddlUsersItems, "Value", "Text", selDdlUsers);

    var allmasterBag = ViewBag.allmaster as SelectList;
    var allmasterList = allmasterBag != null
        ? new SelectList(allmasterBag.Items, allmasterBag.DataValueField, allmasterBag.DataTextField, string.IsNullOrEmpty(selAllmaster) ? null : selAllmaster)
        : new SelectList(Enumerable.Empty<SelectListItem>());

    var allwhitelabelBag = ViewBag.allwhitelabel as SelectList;
    var allwhitelabelList = allwhitelabelBag != null
        ? new SelectList(allwhitelabelBag.Items, allwhitelabelBag.DataValueField, allwhitelabelBag.DataTextField, string.IsNullOrEmpty(selAllwhitelabel) ? null : selAllwhitelabel)
        : new SelectList(Enumerable.Empty<SelectListItem>());

    var alldealerList = new SelectList(getSelectItems(ViewBag.alldealer), "Value", "Text", string.IsNullOrEmpty(selAlldealer) ? null : selAlldealer);
    var allretailerList = new SelectList(getSelectItems(ViewBag.allretailer), "Value", "Text", string.IsNullOrEmpty(selAllretailer) ? null : selAllretailer);

    var apiidBag = ViewBag.apiid as SelectList;
    var allapiuserList = apiidBag != null
        ? new SelectList(apiidBag.Items, apiidBag.DataValueField, apiidBag.DataTextField, string.IsNullOrEmpty(selAllapiuser) ? null : selAllapiuser)
        : new SelectList(Enumerable.Empty<SelectListItem>());

    decimal totalIncome = reports.Sum(a => a.remincome ?? 0m);
    decimal totalSuccess = reports.Sum(a => a.total ?? 0m);

    var dealerIncomeDict = ViewBag.DealerIncome as Dictionary<string, decimal> ?? new Dictionary<string, decimal>();
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=46" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=38" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-user-wise-comm-modern.css?v=9" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-security-report-page saas-giftcard-report-page saas-prepaid-card-report-page saas-user-wise-comm-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var uwcFormAttrs = new Dictionary<string, object>
            {
                { "id", "userWiseCommForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("User_wise_operator_comm", "Home", FormMethod.Post, uwcFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line vm-gift-toolbar-one-line" style="margin:0 !important;">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Account</li>
                        <li>Business By User's</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters vm-ecomm-filter-row--one-line vm-gift-filter-row--one-line">

                        <div class="vm-opr-field vm-dmt-field vm-uwc-field--usertype">
                            @Html.DropDownList("ddlusers", ddlUsersList, new { id = "ddlusers", @class = "vm-opr-select vm-dmt-select form-control", title = "User type", onchange = "uwcAnswers()" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra vm-uwc-field--wide" id="uwc-wrap-whitelabel">
                            @Html.DropDownList("allwhitelabel", allwhitelabelList, "All Whitelabel", new { id = "allwhitelabel", @class = "vm-opr-select vm-dmt-select form-control", title = "Whitelabel" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra vm-uwc-field--wide" id="uwc-wrap-master">
                            @Html.DropDownList("allmaster", allmasterList, "All Master", new { id = "allmaster", @class = "vm-opr-select vm-dmt-select form-control", title = "Master distributor" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra vm-uwc-field--wide" id="uwc-wrap-dealer">
                            @Html.DropDownList("alldealer", alldealerList, "All Distributor", new { id = "alldealer", @class = "vm-opr-select vm-dmt-select form-control", title = "Distributor" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra vm-uwc-field--wide" id="uwc-wrap-retailerlist">
                            <select id="retailerlist_Main" class="vm-opr-select vm-dmt-select form-control" title="Retailer by distributor">
                                <option value="">Select Retailer</option>
                            </select>
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra vm-uwc-field--wide" id="uwc-wrap-servicelist">
                            <select id="Servicelist_Main" class="vm-opr-select vm-dmt-select form-control" title="Service list">
                                <option value="">Service List</option>
                            </select>
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra vm-uwc-field--wide" id="uwc-wrap-retailer">
                            @Html.DropDownList("allretailer", allretailerList, "All Retailer", new { id = "allretailer", @class = "vm-opr-select vm-dmt-select form-control", title = "Retailer" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra vm-uwc-field--wide" id="uwc-wrap-api">
                            @Html.DropDownList("allapiuser", allapiuserList, "All API", new { id = "allapiuser", @class = "vm-opr-select vm-dmt-select form-control", title = "API user" })
                        </div>

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="userWiseCommTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Business by user's totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideUserWiseCommTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Income</span>
                            <strong class="vm-opr-total-card__value" id="userWiseCommTotalIncome">@totalIncome.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Total Success</span>
                            <strong class="vm-opr-total-card__value" id="userWiseCommTotalSuccess">@totalSuccess.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Records</span>
                            <strong class="vm-opr-total-card__value" id="userWiseCommTotalRecords">@rowCount</strong>
                        </div>
                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card vm-security-report-main-card vm-gift-report-main-card vm-prepaid-report-main-card">
            <div class="vm-opr-table-panel vm-security-report-table-panel vm-gift-report-table-panel vm-prepaid-report-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head vm-security-report-table-head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-users" aria-hidden="true"></i>
                        <span>Business by user's</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong id="userWiseCommRecordCount">@rowCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total" title="Total income for current filter">
                            Total: <strong id="userWiseCommInlineTotal">&#8377; @totalIncome.ToString("N2")</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-gift-totals-btn vm-prepaid-totals-btn vm-uwc-totals-btn" onclick="findUserWiseCommTotals()" title="Show totals" aria-expanded="false" aria-controls="userWiseCommTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnExportA" class="saas-acc-btn saas-acc-btn--excel vm-uwc-export-btn vm-uwc-export-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i>
                                <span>Excel</span>
                            </button>
                            <button type="button" id="btnPDFA" class="saas-acc-btn saas-acc-btn--pdf vm-uwc-export-btn vm-uwc-export-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i>
                                <span>PDF</span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap vm-prepaid-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="userWiseCommReportTable" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Mobile No.</th>
                                    <th>Email-ID</th>
                                    <th>Name</th>
                                    <th>Firm Name</th>
                                    <th>Operator Name</th>
                                    <th id="distributor_income1" class="vm-uwc-col-hidden">Distributor Income</th>
                                    <th>Income</th>
                                    <th>Total Success</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    VastwebmultiEntities db = new VastwebmultiEntities();
                                }
                                @foreach (var item in reports)
                                {
                                    var mobileNumber = db.Retailer_Details
                                        .Where(rd => rd.Email == item.Email)
                                        .Select(rd => rd.Mobile)
                                        .FirstOrDefault();
                                    <tr>
                                        <td class="vm-uwc-text" data-label="Mobile No.">@mobileNumber</td>
                                        <td class="vm-uwc-text" data-label="Email-ID">@item.Email</td>
                                        <td class="vm-uwc-text" data-label="Name">@item.RetailerName</td>
                                        <td class="vm-uwc-text" data-label="Firm Name">@item.Frm_Name</td>
                                        <td class="vm-uwc-text" data-label="Operator Name">@item.optnm</td>
                                        <td class="vm-uwc-num distributor_income2" data-label="Distributor Income">
                                            @(dealerIncomeDict.ContainsKey(item.RetailerName) ? dealerIncomeDict[item.RetailerName] : 0)
                                        </td>
                                        <td class="vm-uwc-num" data-label="Income">@item.remincome</td>
                                        <td class="vm-uwc-num" data-label="Total Success">@item.total</td>
                                    </tr>
                                }
                                <tr class="vm-uwc-row-total">
                                    <td class="vm-uwc-text" data-label="Total"><strong>Total</strong></td>
                                    <td data-label="Email-ID"></td>
                                    <td data-label="Name"></td>
                                    <td data-label="Firm Name"></td>
                                    <td data-label="Operator Name"></td>
                                    <td id="distributor_income3" class="vm-uwc-num vm-uwc-col-hidden" data-label="Distributor Income"></td>
                                    <td class="vm-uwc-num" data-label="Income">@reports.Sum(a => a.remincome)</td>
                                    <td class="vm-uwc-num" data-label="Total Success">@reports.Sum(a => a.total)</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<script src="~/MainFrontDesign/js/admin-report-pdf-export.js?v=1"></script>
<script>
    function hideUserWiseCommTotals() {
        var $panel = $('#userWiseCommTotalsPanel');
        var $btn = $('.vm-uwc-totals-btn');
        $panel.hide().attr('aria-hidden', 'true');
        $btn.attr('aria-expanded', 'false');
    }

    function findUserWiseCommTotals() {
        var $panel = $('#userWiseCommTotalsPanel');
        var $btn = $('.vm-uwc-totals-btn');
        if ($panel.is(':visible')) {
            hideUserWiseCommTotals();
            return;
        }
        $panel.show().attr('aria-hidden', 'false');
        $btn.attr('aria-expanded', 'true');
    }

    function uwcShowExtra(id, visible) {
        var $el = $('#' + id);
        if (!$el.length) { return; }
        if (visible) {
            $el.addClass('is-visible').removeAttr('hidden').css('display', '');
        } else {
            $el.removeClass('is-visible').attr('hidden', 'hidden').css('display', 'none');
        }
    }

    function uwcSetDealerIncomeVisible(visible) {
        var method = visible ? 'removeClass' : 'addClass';
        $('#distributor_income1')[method]('vm-uwc-col-hidden');
        $('#distributor_income3')[method]('vm-uwc-col-hidden');
    }

    function uwcAnswers() {
        var answer = document.getElementById('ddlusers').value;

        uwcShowExtra('uwc-wrap-master', false);
        uwcShowExtra('uwc-wrap-whitelabel', false);
        uwcShowExtra('uwc-wrap-dealer', false);
        uwcShowExtra('uwc-wrap-retailerlist', false);
        uwcShowExtra('uwc-wrap-servicelist', false);
        uwcShowExtra('uwc-wrap-retailer', false);
        uwcShowExtra('uwc-wrap-api', false);
        uwcSetDealerIncomeVisible(false);

        if (answer === 'Dealer') {
            uwcShowExtra('uwc-wrap-dealer', true);
            uwcShowExtra('uwc-wrap-retailerlist', true);
            uwcShowExtra('uwc-wrap-servicelist', true);
            uwcSetDealerIncomeVisible(true);
        } else if (answer === 'Whitelabel') {
            uwcShowExtra('uwc-wrap-whitelabel', true);
        } else if (answer === 'Master') {
            uwcShowExtra('uwc-wrap-master', true);
        } else if (answer === 'Retailer') {
            uwcShowExtra('uwc-wrap-retailer', true);
        } else if (answer === 'APIID') {
            uwcShowExtra('uwc-wrap-api', true);
        }
    }

    function applyUwcSelect2($el) {
        if (!$el || !$el.length || !$.fn.select2) {
            return;
        }
        if ($el.data('select2')) {
            $el.select2('destroy');
        }
        $el.select2({
            width: '100%',
            minimumResultsForSearch: 6
        });
    }

    function initUwcSelect2() {
        applyUwcSelect2($('#ddlusers'));
        applyUwcSelect2($('#allwhitelabel'));
        applyUwcSelect2($('#allmaster'));
        applyUwcSelect2($('#alldealer'));
        applyUwcSelect2($('#retailerlist_Main'));
        applyUwcSelect2($('#Servicelist_Main'));
        applyUwcSelect2($('#allretailer'));
        applyUwcSelect2($('#allapiuser'));
    }

    function initUwcDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initUwcDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm('#userWiseCommForm');
        }
    }

    function exportUserWiseCommTable(type) {
        var table = document.getElementById('userWiseCommReportTable');
        if (!table) {
            return;
        }

        var stamp = new Date().toISOString().slice(0, 10);
        var title = 'Business By User\'s';
        var clone = table.cloneNode(true);

        if (type === 'excel') {
            var excelHtml = '<html><head><meta charset="utf-8"></head><body>' + clone.outerHTML + '</body></html>';
            var blob = new Blob(['\ufeff', excelHtml], { type: 'application/vnd.ms-excel' });
            var link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'UserWiseOperatorComm_' + stamp + '.xls';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            return;
        }

        if (type === 'pdf') {
            if (typeof window.openAdminModernReportPdf === 'function') {
                window.openAdminModernReportPdf({
                    table: table,
                    title: title,
                    subtitle: 'Business performance by user hierarchy',
                    fromDate: document.getElementById('txt_frm_date') ? document.getElementById('txt_frm_date').value : '',
                    toDate: document.getElementById('txt_to_date') ? document.getElementById('txt_to_date').value : '',
                    orientation: 'portrait',
                    recordCount: parseInt((document.getElementById('userWiseCommRecordCount') || {}).textContent, 10) || 0
                });
            }
            return;
        }
    }

    function exportUserWiseCommServerExcel() {
        var txt_frm_date = $('#txt_frm_date').val();
        var txt_to_date = $('#txt_to_date').val();
        var ddlusers = $('#ddlusers').val();
        var allmaster = $('#allmaster').val() || '';
        var alldealer = $('#alldealer').val() || '';
        var allretailer = $('#allretailer').val() || '';
        var allwhitelabel = $('#allwhitelabel').val() || '';
        var ddl_top = '';
        var allapiuser = $('#allapiuser').val() || '';

        var url = '@Url.Action("ExcelUserWiseOperatorCommreport", "Home")'
            + '?txt_frm_date=' + encodeURIComponent(txt_frm_date)
            + '&txt_to_date=' + encodeURIComponent(txt_to_date)
            + '&ddlusers=' + encodeURIComponent(ddlusers)
            + '&allmaster=' + encodeURIComponent(allmaster)
            + '&alldealer=' + encodeURIComponent(alldealer)
            + '&allretailer=' + encodeURIComponent(allretailer)
            + '&allwhitelabel=' + encodeURIComponent(allwhitelabel)
            + '&ddl_top=' + encodeURIComponent(ddl_top)
            + '&allapiuser=' + encodeURIComponent(allapiuser);

        location.href = url;
    }

    function resetUserWiseCommTableScroll() {
        var $scroll = $('.saas-user-wise-comm-page .vm-opr-table-scroll, .saas-user-wise-comm-page .vm-prepaid-table-wrap .table-responsive');
        $scroll.each(function () {
            this.scrollLeft = 0;
        });
    }

    $(document).ready(function () {
        initUwcSelect2();
        initUwcDatepickers();
        uwcAnswers();
        $('#userWiseCommForm .select2-container').css('width', '100%');
        if (window.matchMedia && window.matchMedia('(max-width: 991px)').matches) {
            $('#ddlusers').next('.select2-container').css({ width: '100%', maxWidth: '100%' });
            $('.saas-user-wise-comm-page .vm-uwc-field--usertype .select2-container').css({ width: '100%', maxWidth: '100%' });
        }
        resetUserWiseCommTableScroll();
        window.setTimeout(resetUserWiseCommTableScroll, 100);

        $('#alldealer').on('change', function () {
            var dealerId = $(this).val();
            var $retailer = $('#retailerlist_Main');

            if (!dealerId) {
                $retailer.empty().append($('<option>', { value: '', text: 'Select Retailer' }));
                applyUwcSelect2($retailer);
                return;
            }

            $.ajax({
                url: '@Url.Action("GetRetailerByDealer", "Home")',
                type: 'GET',
                data: { dealerId: dealerId },
                success: function (data) {
                    $retailer.empty();
                    $retailer.append($('<option>', { value: '', text: 'Select Retailer' }));
                    $.each(data, function (i, retailer) {
                        $retailer.append($('<option>', {
                            value: retailer.Value,
                            text: retailer.Text
                        }));
                    });
                    applyUwcSelect2($retailer);
                }
            });
        });

        $('#retailerlist_Main').on('change', function () {
            var retailerId = $(this).val();
            var $service = $('#Servicelist_Main');

            if (!retailerId) {
                $service.empty().append($('<option>', { value: '', text: 'Service List' }));
                applyUwcSelect2($service);
                return;
            }

            $.ajax({
                url: '@Url.Action("GetServiceListByRetailer", "Home")',
                type: 'GET',
                data: { retailerId: retailerId },
                success: function (data) {
                    $service.empty();
                    $service.append($('<option>', { value: '', text: 'Service List' }));
                    $.each(data, function (i, service) {
                        $service.append($('<option>', {
                            value: service.Value,
                            text: service.Text
                        }));
                    });
                    applyUwcSelect2($service);
                }
            });
        });

        $('#btnExportA').on('click', function () {
            exportUserWiseCommServerExcel();
        });

        $('#btnPDFA').on('click', function () {
            exportUserWiseCommTable('pdf');
        });
    });
</script>
