    .toast-top-right1 { top: 65px; left: 81%; }
    .master-form-select .select2-container { height: 38px; }
    .DistibutorList_page .onoffswitch { width: auto; min-width: 110px; height: 32px; margin: 0; }
    .DistibutorList_page .costom-on, .DistibutorList_page .custom-off { font-size: 11px !important; }
    .vm-dl-recharge-seller-link { display: inline-flex; align-items: center; gap: 6px; padding: 8px 12px; border-radius: 9px; border: 1px solid #dbe2ea; background: #fff; color: #2563eb; font-size: 0.78rem; font-weight: 700; text-decoration: none !important; white-space: nowrap; }
    .vm-dl-recharge-seller-link:hover { background: #eff6ff; color: #1d4ed8; }

    /* ── Form field spacing compact ── */
    .DistibutorList_page .vm-ft-form-card .row.clearfix { margin-bottom: 0 !important; }
    .DistibutorList_page .vm-ft-form-card .form-group { margin-bottom: 8px !important; }
    .DistibutorList_page .vm-ft-form-card label { margin-bottom: 3px !important; font-size: 0.75rem !important; font-weight: 600 !important; color: #475569 !important; display: block !important; }
    .DistibutorList_page .vm-ft-form-card .form-control { height: 36px !important; font-size: 0.8rem !important; border-radius: 8px !important; }
    .DistibutorList_page .vm-ft-form-card textarea.form-control { height: auto !important; min-height: 70px !important; }

    /* ── Tab buttons (Create Distributor / Bulk Users) medium height ── */
    .DistibutorList_page .vm-ft-role-tab-li { flex: 1 !important; }
    .DistibutorList_page .vm-ft-role-tab {
        height: 38px !important;
        padding: 0 12px !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 6px !important;
        border-radius: 8px !important;
        font-size: 0.76rem !important;
        font-weight: 600 !important;
        cursor: pointer !important;
        transition: all .15s !important;
        width: 100% !important;
    }
    .DistibutorList_page .vm-ft-role-tab-li--active .vm-ft-role-tab {
        background: linear-gradient(135deg,#1d4ed8,#2563eb) !important;
        color: #fff !important;
        box-shadow: 0 2px 8px rgba(37,99,235,.3) !important;
    }
    .DistibutorList_page .vm-ft-role-tab-li--inactive .vm-ft-role-tab {
        background: #f1f5f9 !important;
        color: #475569 !important;
        border: 1.5px solid #e2e8f0 !important;
    }
    .DistibutorList_page .vm-ft-role-tab-li--inactive .vm-ft-role-tab:hover {
        background: #e2e8f0 !important;
        color: #1e293b !important;
    }
    .DistibutorList_page .vm-ft-role-tab__icon { font-size: 0.78rem !important; }
    .DistibutorList_page .vm-ft-role-tab__label { font-size: 0.75rem !important; }

    /* Tab list row */
    .DistibutorList_page .vm-ft-role-tabs {
        display: flex !important;
        gap: 6px !important;
        padding: 10px 12px 8px !important;
        margin: 0 !important;
        list-style: none !important;
        border-bottom: 1.5px solid #e2e8f0 !important;
        background: #f8fafc !important;
    }

    
</style>

