        idno = idno + id;
           var idshow = "subTblshow";
                    idshow = idshow +id;
                    var idhide = "subTblhide";
                    idhide = idhide + id;
    $.ajax({
        url: '@Url.Action("SelectRetailerID","Home")',
        data: { MdId: DealerId },
        type: 'POST',
        cache: false,
        success: function (response) {

            $('#' + idno).html(response);
             $('#' + idshow).css("display", "none");
            $('#' + idhide).css("display", "inline-flex");
            $('#' + id).css("display", "table-row");
            $('#' + id).prev('tr.vm-ml-parent-row').addClass('vm-ml-parent-row--expanded');
           }
        })
    }

    function md_dlm_Listhide( id) {
          var idno = "subTbl";
        idno = idno + id;
           var idshow = "subTblshow";
                    idshow = idshow +id;
                    var idhide = "subTblhide";
                    idhide = idhide + id;
            $('#' + idshow).css("display", "inline-flex");
            $('#' + idhide).css("display", "none");
            $('#' + id).css("display", "none");
            $('#' + id).prev('tr.vm-ml-parent-row').removeClass('vm-ml-parent-row--expanded');
    }


</script>

<!--Insert Popuop-->
<script>
    $(document).ready(function () {
        var chkanyerrorbulk = $.trim("@TempData["errorexist"]");
        if (chkanyerrorbulk) {
            var htm = "@Html.Raw(TempData["errortable"])";
            $('#htmleerrrorrtable').empty().append(htm);
            $('#myModal').modal('show');
        }

        $('#myModal').on('hidden.bs.modal', function () {
            $(this).removeClass('in show').css('display', '');
            $('#htmleerrrorrtable').empty();
        });

    @{
        var errorMessages = TempData["Error"] as IEnumerable<string>;
         }

        if (@errorMessages != null) {
            swal("Oooops..!", @errorMessages, "success");

        }

        var message = '@TempData["msgrem"]'
        if (message != "" && message != null) {
            swal("Good job!", message, "success");

        }
        var mobileconfrimation = '@TempData["mobileno"]'
        if (mobileconfrimation != "" && mobileconfrimation != null) {
            swal("Oops...", mobileconfrimation, "error");

        }

        var mailconfrimation = '@TempData["emailconfrim"]'
        if (mailconfrimation != "" && mailconfrimation != null) {
            swal("Oops...", mailconfrimation, "error");

        }
        //Edit Message
        var editdata = '@TempData["edit"]'
        if (editdata != null && editdata != "") {
            swal("Good job!", editdata, "success");
        }
        //Wrong OTP
        var wrong = '@TempData["wrong"]'
        if (wrong != null && wrong != "") {
            swal("Oops...", wrong, "error");
        }
        //delete Dealer
        var deletemsg = '@TempData["delete"]'
        if (deletemsg != null && deletemsg != "") {
            swal("Good job!", deletemsg, "success");
        }
        var resendmail = '@ViewData["ResendMail"]'
        if (resendmail != null && resendmail != "") {
            swal("Good job!", resendmail, "success");
        }
    });
</script>


<!--Add Slab By master Id-->
<script language="javascript" type="text/javascript">
                    $(function () {
                        $('#masterid').change(function () {
                            // alert('Value:' + ' ' + $('#State1').val())
                            var dealerid = $('#masterid').val()
                            if (dealerid === "") {
                                dealerid = 0;

                            }
                            else {
                                //alert(dealerid)
                                GetDistrict(dealerid)
                            }
                            function GetDistrict(dealerid) {
                                var procemessage = "<option value='0'> Please wait...</option>";
                                $("#slab_name").html(procemessage).show();
                                var url = '@Url.Action("SlabList1","Home")'
                                $.ajax({
                                    url: url,
                                    data: { Id: dealerid },
                                    cache: false,
                                    type: "POST",
                                    success: function (data) {
                                        var markup = "<option value=' '>Select Slab</option>";
                                        for (var x = 0; x < data.length; x++) {
                                            markup += "<option value=" + data[x].Value + ">" + data[x].Text + "</option>";
                                            //alert(markup)
                                        }
                                        $("#slab_name").html(markup).show();
                                    },
                                    //error: function (reponse) {
                                    //    alert("error : " + reponse);
                                    //}
                                });
                            }
                        });
                    })
</script>


