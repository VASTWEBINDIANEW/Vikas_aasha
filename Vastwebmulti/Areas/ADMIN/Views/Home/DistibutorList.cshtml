                            @Html.ValidationMessageFor(m => m.State, "", new { @class = "text-danger" })
                        </div>
                        <div class="vm-ml-modal-field">
                            <label>District</label>
                            @Html.DropDownListFor(m => m.District, new SelectList(Enumerable.Empty<SelectListItem>(), "Dist_id", "Dist_Desc"), "Select district", new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.District, "", new { @class = "text-danger" })
                        </div>
                        <div class="vm-ml-modal-field">
