                </div>
                <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
            </div>
            @using (Html.BeginForm("insert_super", "Home", FormMethod.Post))
            {
                <div class="modal-body saas-admin-modal-body vm-ml-modal-body">
                    <div class="vm-ml-modal-grid">
                        <div class="vm-ml-modal-field vm-ml-modal-field--full">
                            <label>Master Distributor ID</label>
                            @Html.DropDownList("masterid", new SelectList(ViewBag.masterid, "Value", "Text"), "Select Master Id", new { @class = "selectpicker form-control", data_live_search = "true", @required = "required" })
                        </div>
                        <div class="vm-ml-modal-field">
                            <label>Name</label>
                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Enter Name", required = "required" })
                            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                        </div>
                        <div class="vm-ml-modal-field">
                            <label>Firm Name</label>
                            @Html.TextBoxFor(m => m.FarmName, new { @class = "form-control", placeholder = "Enter Firm Name", required = "required" })
                            @Html.ValidationMessageFor(m => m.FarmName, "", new { @class = "text-danger" })
                        </div>
                        <div class="vm-ml-modal-field">
                            <label>State</label>
