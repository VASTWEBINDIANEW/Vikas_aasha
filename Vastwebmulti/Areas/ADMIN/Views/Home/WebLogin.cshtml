    var wlSecurityBusy = false;

    function SecurityChange(mode) {
        if (wlSecurityBusy) return false;

        var isHighActive = document.querySelector('.WebLogin_Page .wl-sec-card2--high.wl-sec-card2--active') !== null;
        var wantHigh = (mode === 'high');

        if (wantHigh && isHighActive) {
            swal('Already Active', 'High Security is already enabled.', 'info');
            return false;
        }
        if (!wantHigh && !isHighActive) {
            swal('Already Active', 'Low Security is already enabled.', 'info');
            return false;
        }

        var title = wantHigh ? 'Activate High Security?' : 'Activate Low Security?';
        var text = wantHigh
            ? 'Email verification will be required for high security login.'
            : 'No extra security required. Password will be sent to registered mobile.';
        var confirmText = wantHigh ? 'Yes, Activate High' : 'Yes, Activate Low';

        swal({
            title: title,
            text: text,
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#2563eb',
            cancelButtonColor: '#94a3b8',
            confirmButtonText: confirmText,
            cancelButtonText: 'Cancel',
            closeOnConfirm: false,
            showLoaderOnConfirm: true
        }, function (isConfirm) {
            if (!isConfirm) return;
            wlDoSecurityChange(wantHigh);
        });

        return false;
    }

    function wlDoSecurityChange(wantHigh) {
        wlSecurityBusy = true;
        $.ajax({
            type: 'POST',
            url: '@Url.Action("ChangeSecuritySetting","Home")',
            success: function (data) {
                $('#Statussetting').html(data);
                var msg = wantHigh
                    ? 'High Security is now Active.'
                    : 'Low Security is now Active.';
                swal('Success!', msg, 'success');
            },
            error: function () {
                swal('Failed!', 'Could not update security setting. Please try again.', 'error');
            },
            complete: function () {
                wlSecurityBusy = false;
            }
        });
    }



