                        </div>
                    <div class="modal-body wl-modal-body wl-ip-modal-body">
                        <div class="wl-drawer-section wl-drawer-section--form">
                            <div class="add-ip-out">
                                <div class="ip-add-top">
                                    <h4><i class="fas fa-plus-circle"></i> Add IP Address For Login Setting</h4>
                                </div>
                                <div class="wl-ip-form-wrap">
                                    @using (Ajax.BeginForm("Insert_IPaddressdata", "Home",
                                          new AjaxOptions
                                          {
                                              InsertionMode = InsertionMode.Replace,
                                              LoadingElementId = "outer-loader",
                                              UpdateTargetId = "tbllayoutpage",
                                              OnSuccess = "IPINSERTONSUCCESSGETDATA",
                                              OnFailure = "IPINSERTONFAILEDGETDATA"
                                          }, new { @id = "formIdxghcghgvnh" }))
                                    {
                                        <div class="wl-ip-form forminput-set forminput-set-first">
                                            <label class="wl-ip-label" for="txtIPADDRESS">IP Address</label>
                                            <input type="text" class="form-control" id="txtIPADDRESS" name="txtIPADDRESS" pattern="^([0-9]{1,3}\.){3}[0-9]{1,3}$" title="Please enter a valid IP address" placeholder="Enter Or Fetch IP Address" />
                                            <div class="wl-ip-actions showdataforms">
                                                <button type="button" id="btnfetchsdfsdIP" name="btnfetchasIP" onclick="btnfetchIPasdsdfdsfg()" class="ne-btn-reset"><i class="fas fa-globe"></i> Fetch IP</button>
                                                <button type="button" id="btnsshownext" name="btnnamekonsa" class="ne-btn-submit showdataforms"><i class="fas fa-arrow-right"></i> Proceed</button>
                                            </div>
                                        </div>

                                        <div class="notshowformsdata wl-ip-form" style="display:none;">
                                            <label class="wl-ip-label" for="txthighsecuritypwd">High Security Password</label>
                                            <input type="password" autocomplete="new-password" required class="form-control" id="txthighsecuritypwd" name="txthighsecuritypwd" placeholder="Enter High Security Password" />
                                            <div class="wl-ip-actions">
                                                <button type="submit" id="btnshowinsert" name="btnnamekonsa" class="ne-btn-submit"><i class="fas fa-check"></i> Confirm</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                                <span class="ipmsgsuccess wl-ip-msg"></span>
                            </div>
                        </div>
                        <div class="wl-drawer-section wl-drawer-section--table add-ip-list">
                            <div class="wl-ip-list-head"><i class="fas fa-list"></i> Successfully Added IP Address List</div>
                            <div class="rc-table-cover wl-drawer-table-wrap">
                            <table class="table rc-inner-table wl-ip-table">
                                <thead>
                                    <tr>
                                        <th>Sr. No.</th>
                                        <th>IP Address</th>
                                        <th>Status</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>

                                <tbody id="tbllshowipaddlist"></tbody>
                            </table>
                            </div>
                        </div>
                    </div>
                    </div><!-- modal-content -->
                </div>
            </div>
        </div>


