<script>
    $(document).ready(() => {
        fetch_videokyc_status();
        fetch_aadhar_pan_status();
        fetch_verification_type_status();
        fetch_signup_kyc_status();
    })

    // ====================videokyc====================
    function wlApplyVideoKycUI(type) {
        var btn = document.getElementById('retailer_videokyc_by');
        if (!btn) return;
        btn.setAttribute("created_type", type);
        var chip = btn.closest('.wl-toggle-chip');
        if (type == "ON") {
            $("#videokyc_tst").text("Active");
            btn.style.background = "green";
            if (chip) { chip.classList.remove('wl-chip--off'); chip.classList.add('wl-chip--on'); }
        } else {
            $("#videokyc_tst").text("Off");
            btn.style.background = "red";
            if (chip) { chip.classList.remove('wl-chip--on'); chip.classList.add('wl-chip--off'); }
        }
    }

    function fetch_videokyc_status() {
        $.ajax({
            url: '@Url.Action("fetchVideoKycStatus_Data")',
            success: (data) => {
                data = typeof (data) == 'string' ? JSON.parse(data) : data;
                wlApplyVideoKycUI(data.type);
            }
        })
    }

    function handle_videokyc_change(val) {
        if (!val) return;
        $.ajax({
            url: '@Url.Action("ChangeVideoKycStatus", "Home")',
            type: 'POST',
            dataType: 'json',
            success: function (data) {
                data = typeof (data) == 'string' ? JSON.parse(data) : data;
                wlApplyVideoKycUI(data.type);
            },
            error: function (err) { console.error("VideoKycStatus Error", err); }
        });
    }

    function wlSetChipState(chipId, state) {
        var chip = document.getElementById(chipId);
        if (!chip) return;
        chip.classList.remove('wl-chip--off', 'wl-chip--warn', 'wl-chip--on', 'wl-chip--info');
        if (state) chip.classList.add(state);
    }

    function wlUpdateSignupKycDot(type, displayName) {
        var wrap = document.getElementById('wl_kyc_select');
        if (wrap) wrap.setAttribute('data-kyc', type || 'ZERO');
        var $ddl = $('#ddlSignupKYCType');
        var text = displayName || ($ddl.length ? ($ddl.find('option:selected').text() || $ddl.val()) : '') || 'Select';
        $('#wl_kyc_selected_text').text(text);
    }

    function fetch_signup_kyc_status() {
        $.ajax({
            url: '@Url.Action("fetchSignupKYCSetting_Data", "Home")',
            type: 'GET',
            cache: false,
            success: (data) => {
                data = typeof (data) == 'string' ? JSON.parse(data) : data;
                var $ddl = $('#ddlSignupKYCType');
                if (!$ddl.length) return;

                if (!data || !data.length) {
                    $ddl.empty().append($('<option></option>').val('').text('No KYC Type'));
                    $('#wl_kyc_selected_text').text('No KYC Type');
                    return;
                }

                $ddl.empty();
                var activeType = '';
                var activeName = '';
                $.each(data, function (i, item) {
                    var isSel = (item.IsActive === true || item.IsActive === 1 || item.IsActive === '1' || item.IsActive === 'true');
                    if (isSel) {
                        activeType = item.KYCType;
                        activeName = item.DisplayName;
                    }
                    $ddl.append(
                        $('<option></option>')
                            .val(item.KYCType)
                            .text(item.DisplayName)
                            .prop('selected', isSel)
                    );
                });
                if (!activeType) {
                    activeType = $ddl.val();
                    activeName = $ddl.find('option:selected').text();
                }
                wlUpdateSignupKycDot(activeType, activeName);
            },
            error: (err) => {
                console.error("fetchSignupKYCSetting_Data Error", err);
                $('#wl_kyc_selected_text').text('Load failed');
            }
        });
    }

    function handle_signup_kyc_change(val) {
        var $ddl = $(val);
        var selectedType = $ddl.val();
        if (!selectedType) return;
        var selectedName = $ddl.find('option:selected').text();
        wlUpdateSignupKycDot(selectedType, selectedName);

        $.ajax({
            url: '@Url.Action("ChangeSignupKYCSetting", "Home")',
            type: 'POST',
            dataType: 'json',
            data: { type: selectedType },
            success: function (data) {
                data = typeof (data) == 'string' ? JSON.parse(data) : data;
                if (data && (data.Status === true || data.Status === 'True' || data.Status === 1)) {
                    wlUpdateSignupKycDot(data.type || selectedType, data.DisplayName || selectedName);
                } else {
                    alert((data && data.Message) ? data.Message : 'KYC Type update failed.');
                    fetch_signup_kyc_status();
                }
            },
            error: function (xhr) {
                console.error("ChangeSignupKYCSetting Error", xhr);
                // fallback: send type in querystring if body binding fails
                $.ajax({
                    url: '@Url.Action("ChangeSignupKYCSetting", "Home")' + '?type=' + encodeURIComponent(selectedType),
                    type: 'POST',
                    dataType: 'json',
                    success: function (data2) {
                        data2 = typeof (data2) == 'string' ? JSON.parse(data2) : data2;
                        if (data2 && (data2.Status === true || data2.Status === 'True' || data2.Status === 1)) {
                            wlUpdateSignupKycDot(data2.type || selectedType, data2.DisplayName || selectedName);
                        } else {
                            alert((data2 && data2.Message) ? data2.Message : 'KYC Type update failed.');
                            fetch_signup_kyc_status();
                        }
                    },
                    error: function () {
                        alert('KYC Type update failed. Please try again.');
                        fetch_signup_kyc_status();
                    }
                });
            }
        });
    }

