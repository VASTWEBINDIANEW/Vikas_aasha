                        <span class="wl-toolbar-btn__icon"><i class="fas fa-cog"></i></span>
                        <span class="wl-toolbar-btn__text">Set Admin Login IP</span>
                    </button>
                    <button type="button" class="wl-toolbar-btn wl-toolbar-btn--perm" onclick="wlOpenPermissionDrawer(); return false;">
                        <span class="wl-toolbar-btn__icon"><i class="fas fa-unlock-alt"></i></span>
                        <span class="wl-toolbar-btn__text">My Login Permission</span>
                    </button>
                    <button type="button" class="wl-toolbar-btn wl-toolbar-btn--imei" onclick="wlOpenImeiDrawer('Retailer'); return false;">
                        <span class="wl-toolbar-btn__icon"><i class="fas fa-sim-card"></i></span>
                        <span class="wl-toolbar-btn__text">Allow IMEI</span>
                    </button>

                    <div class="wl-toggle-chip wl-chip--off" onclick="handle_videokyc_change(document.getElementById('retailer_videokyc_by'))">
                        <span class="wl-toggle-chip__dot" id="retailer_videokyc_by" created_type="OFF" style="background:#94a3b8;"></span>
                        <span class="wl-toggle-chip__text"><small>Video KYC</small><strong id="videokyc_tst">Setting</strong></span>
                    </div>
                    @if (Session["yes"] == "ON")
                    {
                        <a href="@Url.Action("updateotpsetting", "Home")" class="wl-toggle-chip wl-chip--on">
                            <span class="wl-toggle-chip__dot" style="background:#16a34a;"></span>
                            <span class="wl-toggle-chip__text"><small>Forget OTP</small><strong>ON</strong></span>
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("updateotpsetting", "Home")" class="wl-toggle-chip wl-chip--off">
                            <span class="wl-toggle-chip__dot" style="background:#dc2626;"></span>
                            <span class="wl-toggle-chip__text"><small>Forget OTP</small><strong>OFF</strong></span>
                        </a>
