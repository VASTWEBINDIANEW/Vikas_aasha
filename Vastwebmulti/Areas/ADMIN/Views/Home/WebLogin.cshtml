<script>
    function wlGet$() { return window.jQuery || window.$; }

    function wlSyncManageSidebar() {
        var $ = wlGet$();
        if (!$) return;
        var onManageTab = $('#tab-3').is(':visible');
        var hasUser = $('.blocklogin').is(':visible');
        var hasCities = $('.Citynamelogin').children().length > 0;
        if (onManageTab) {
            if (hasUser || hasCities) {
                $('.about-block').hide();
            } else {
                $('.about-block').show();
            }
        }
    }

    function wlResetManageSidebar() {
        var $ = wlGet$();
        if (!$) return;
        $('.about-block').hide();
        $('.blocklogin').hide();
        $('.Citynamelogin').empty().hide();
        $('#hdinputdata').hide();
        $('#hdchkseletval').val('');
        $('#remuserid').val('');
        $('.error-show').hide();
    }

    function wlLeftTab(panelId, btnId, tabopenArg) {
        document.querySelectorAll('.WebLogin_Page .rc-left-tabs .au-tab-btn').forEach(function (b) { b.classList.remove('active'); });
        var btn = document.getElementById(btnId);
        if (btn) btn.classList.add('active');
        document.querySelectorAll('.WebLogin_Page .rc-left-panel').forEach(function (p) {
            p.style.display = 'none';
        });
        var panel = document.getElementById(panelId);
        if (panel) {
            panel.style.display = 'block';
        }
        var isManage = tabopenArg === 'for-Distr';
        var historyWrap = document.querySelector('.WebLogin_Page .wl-history-wrap');
        var managePanel = document.querySelector('.WebLogin_Page .for-Distributor');
        if (historyWrap) historyWrap.style.display = isManage ? 'none' : '';
        if (managePanel) managePanel.style.display = isManage ? '' : 'none';
        if (!isManage) {
            wlResetManageSidebar();
        }
        if (typeof tabopen === 'function') tabopen(tabopenArg);
        if (isManage) wlSyncManageSidebar();
    }

    function wlRightTab(panelId, btnId) {
        document.querySelectorAll('.WebLogin_Page .rc-right-tabs .au-tab-btn').forEach(function (b) { b.classList.remove('active'); });
        var btn = document.getElementById(btnId);
        if (btn) btn.classList.add('active');
        document.querySelectorAll('.WebLogin_Page .rc-right-panel').forEach(function (p) {
            p.style.display = 'none';
            p.classList.remove('rc-right-panel--active');
        });
        var panel = document.getElementById(panelId);
        if (panel) {
            panel.style.display = 'block';
            panel.classList.add('rc-right-panel--active');
        }
    }

    function wlInitSelect2() {
        var $ = wlGet$();
        if (!$ || !$.fn.select2) return;
        $('.WebLogin_Page .for-select2, .WebLogin_Page .rc-filter-select.for-select2, .WebLogin_Page .vm-opr-select').each(function () {
            if (!$(this).hasClass('select2-hidden-accessible')) {
                $(this).select2({ width: '100%' });
            }
        });
    }

    function wlSetDrawerModal(title, iconClass) {
        var titleEl = document.getElementById('wlDrawerModalTitle');
        var iconEl = document.getElementById('wlDrawerModalIcon');
        if (titleEl) titleEl.textContent = title || 'Login Setting';
        if (iconEl) iconEl.innerHTML = '<i class="' + (iconClass || 'fas fa-cog') + '"></i>';
    }

    function wlNormalizeDrawerContent($container) {
        var $ = wlGet$();
        if (!$ || !$container || !$container.length) return;

        var $root = $container;
        var $content = $root.find('section.content.cas-hdeposi-tcharge-page').first();
        if (!$content.length) {
            $content = $root.find('section.content').first();
        }

        if ($content.length) {
            var $scripts = $content.find('script').detach();
            $root.html($content.html());
            $scripts.each(function () {
                var code = this.text || this.textContent || '';
                if (code.trim()) { $.globalEval(code); }
            });
        } else {
            var $scripts = $root.find('script').detach();
            var html = $root.html();
            $root.html(html);
            $scripts.each(function () {
                var code = this.text || this.textContent || '';
                if (code.trim()) { $.globalEval(code); }
            });
        }

        $root.addClass('wl-drawer-injected-root');
        $root.find('.page-title-box-fourde-admin, .page-header-third, .bread-same-all-page, .dust-gr-terw, .four-noneclass-admin-only, .navbar, .sidebar, .left-sidebar, .right-sidebar, .slimScrollDiv').hide();
        $root.find('section.content').css({ padding: 0, margin: 0, background: 'transparent', display: 'block' });
        $root.find('.container-fluid.payugateway-admin-respo').css({ padding: '0', width: '100%' });
        $root.find('.cas-hdeposi-tcharge-page').addClass('wl-drawer-injected');
        $root.find('.tab-content, #tab-1').addClass('wl-drawer-visible').css('display', 'block');
        $root.find('.table-responsive-payugateway').css({ height: 'auto', maxHeight: 'none' });

        $root.find('select.form-control, .for-select2, #Retailerid1').each(function () {
            var $sel = $(this);
            if ($sel.hasClass('select2-hidden-accessible')) {
