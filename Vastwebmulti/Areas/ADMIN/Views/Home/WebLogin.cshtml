        $('#modeldeiv').html('<div class="wl-drawer-loading"><i class="fa fa-circle-o-notch fa-spin"></i> Loading...</div>');
        wlShowDrawerModal();
        $.ajax($.extend({}, ajaxOpts, {
            success: function (response) {
                $('#modeldeiv').html(response);
                wlNormalizeDrawerContent($('#modeldeiv'));
                if (typeof ajaxOpts.success === 'function') {
                    ajaxOpts.success(response);
                }
            },
            error: function (request, error) {
                $('#modeldeiv').html('<div class="wl-drawer-loading" style="color:#dc2626;"><i class="fas fa-exclamation-circle"></i> Failed to load. Please try again.</div>');
                if (typeof ajaxOpts.error === 'function') {
