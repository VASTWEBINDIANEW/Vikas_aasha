@model IEnumerable<Vastwebmulti.Models.ShowBankRequest_Result>
@using System.Linq
@using System.Web
@{
    ViewBag.Title = "Retailer Bank";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var rows = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.ShowBankRequest_Result>();
    var msg = Convert.ToString(TempData["msgbox"]);
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-settings-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-support-pages-modern.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-settings-page saas-admin-report-page saas-support-page saas-bank-page">
    <div class="container-fluid">
        <div class="saas-acc-toolbar saas-pan-toolbar-unified">
            <ol class="saas-acc-breadcrumb">
                <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                <li><a href="javascript:void(0);">User A/C Q</a></li>
                <li>Retailer Bank</li>
            </ol>
            <div class="saas-acc-toolbar-right">
                <div class="saas-report-toolbar-actions">
                    <a href="@Url.Action("Delete_Approve_Bank_list")" class="saas-acc-btn saas-acc-btn--secondary" style="text-decoration:none;">
                        <i class="fas fa-list" aria-hidden="true"></i> Delete Bank Approve List
                    </a>
                </div>
            </div>
        </div>

        <div class="saas-acc-table-card">
            <div class="saas-acc-table-card-head">
                <h3>Pending &amp; approved bank requests</h3>
                <span class="saas-acc-row-count"><i class="fas fa-university" aria-hidden="true"></i> @rows.Count entries</span>
            </div>
            <div id="RetailerBankTableHost" class="saas-acc-table-scroll">
                @Html.Partial("_RetailerBankList", rows)
            </div>
        </div>
    </div>
</section>

<script src="~/MainFrontDesign/js/admin-retailer-bank.js"></script>
<script>
    window.retailerBankOtpUrl = '@Url.Action("bankApproveOTP", "Home")';
    (function () {
        var msg = @Html.Raw(string.IsNullOrEmpty(msg) ? "null" : "\"" + HttpUtility.JavaScriptStringEncode(msg) + "\"");
        if (msg && typeof swal === "function") {
            swal("Notice", msg, "info");
        } else if (msg) {
            alert(msg);
        }
        var successMsg = '@ViewData["successorder"]';
        var failMsg = '@ViewData["failedorder"]';
        if (successMsg) { swal("Good job!", successMsg, "success"); }
        if (failMsg) { swal("Oops!", failMsg, "error"); }
        var showData = '@ViewData["show"]';
        if (showData) { swal("Oops...", showData, "error"); }
    })();
</script>
