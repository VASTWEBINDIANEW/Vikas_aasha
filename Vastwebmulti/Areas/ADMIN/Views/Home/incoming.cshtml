@using System.Linq
@using Vastwebmulti.Models
@{
    ViewBag.Title = "Incoming";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    var dateMode = (ViewBag.chk as string) == "post" ? "post" : "get";
    var msgSearch = (Request["txtmsg"] ?? "").Trim();
    var incomingRows = ViewBag.IncomingRows as IEnumerable<SRS_show_incomg_msg_Result> ?? Enumerable.Empty<SRS_show_incomg_msg_Result>();
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=7" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=31" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=2" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-incoming-report-modern.css?v=8" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-incoming-report-page">
    <div class="container-fluid vm-opr-page-shell">

        @using (Html.BeginForm("incoming", "Home", FormMethod.Post, new { id = "incomingReportForm", data_date_mode = dateMode, data_frm_date = frmDate, data_to_date = toDate, data_scroll_url = Url.Action("InfiniteScroll_incoming", "Home") }))
        {
            <div class="saas-acc-toolbar saas-pan-toolbar-unified saas-acc-toolbar--stacked vm-opr-toolbar-unified">
                <div class="saas-acc-toolbar-top vm-opr-toolbar-head">
                    <ol class="saas-acc-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Incoming Messages</li>
                    </ol>
                    <div class="vm-opr-page-nav">
                        @Html.Partial("menuoperatorreport")
                    </div>
                </div>
                <div class="vm-rpt-filters-panel">
                <div class="saas-acc-filter-bar vm-opr-filter-row vm-inc-filter-row vm-rpt-filters-panel__bar">

                    <div class="vm-inc-filter-left">
                        <div class="vm-opr-field vm-opr-field--port">
                            @Html.DropDownList("lapuno11", ViewBag.Lapuno as SelectList, "Port No", new { id = "lapuno11", @class = "vm-opr-select form-control", @title = "Port" })
                        </div>
                        <div class="vm-opr-field vm-inc-field--msg">
                            @Html.TextBox("txtmsg", msgSearch, new { @class = "form-control vm-inc-msg-input", @placeholder = "Message�", autocomplete = "off", id = "txtmsg", title = "Search message" })
                        </div>
                    </div>

                    <div class="vm-inc-filter-right">
                        <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field">
                            <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                            @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                        </div>
                        <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field">
                            <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                            @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                        </div>
                        <button id="btntype_OLD" name="btntype" type="submit" value="SEARCH" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search" title="Search">
                            <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                        </button>
                    </div>
                </div>
                </div>
            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel" id="showreport">
                <div class="vm-opr-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-inbox" aria-hidden="true"></i>
                        <span>Incoming message log</span>
                    </div>
                    <span class="vm-opr-table-panel__hint">Scroll horizontally on mobile</span>
                </div>
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="example" class="table table-bordered table-striped table-hover vm-opr-data-table vm-inc-data-table">
                            <thead>
                                <tr>
                                    <th>Port Number</th>
                                    <th>Lapu Number</th>
                                    <th>Incoming Message Details</th>
                                    <th>Date &amp; Time</th>
                                </tr>
                            </thead>
                            <tbody id="trow">
                                @if (incomingRows.Any())
                                {
                                    @Html.Partial("_incoming", incomingRows)
                                }
                                else
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="4" class="vm-opr-table-empty">
                                            <i class="fas fa-inbox" aria-hidden="true"></i>
                                            <span>No incoming messages for selected filters.</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <div id="loadingdiv" class="vm-opr-table-loading" style="display:none;">
                            <div class="vm-inc-loader">Loading�</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script src="~/MainFrontDesign/js/admin-operator-report-nav.js"></script>
<script src="~/MainFrontDesign/js/admin-incoming-report.js?v=5"></script>
