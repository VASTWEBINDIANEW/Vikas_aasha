@model IEnumerable<Vastwebmulti.Models.loanpermission>
@using Vastwebmulti.Models
@using System.Linq
@{
    ViewBag.Title = "Loan Retailer Status";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    VastwebmultiEntities db = new VastwebmultiEntities();
    var rows = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.loanpermission>();
    var onCount = rows.Count(r => r.status == true);
    var offCount = rows.Count - onCount;
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-settings-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-settings-page">
    <div class="container-fluid">

        

        <div class="saas-acc-toolbar">
            <ol class="saas-acc-breadcrumb">
                <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                <li><a href="@Url.Action("More_Option", "Home")">More Options</a></li>
                <li>Loan Retailer Status</li>
            </ol>
        </div>

        @using (Html.BeginForm("LoancommRemsts", "Home", FormMethod.Post))
        {
            <div class="saas-set-filter-bar">
                <label class="saas-mo-label" for="allretailer" style="margin:0;width:100%;">Filter retailer</label>
                <div style="flex:1;min-width:200px;">
                    @Html.DropDownList("allretailer", ViewBag.retailer as SelectList, "All Retailer", new { id = "allretailer", @class = "form-control" })
                </div>
                <button name="btntype" type="submit" class="saas-set-btn-primary">
                    <i class="fa fa-search" aria-hidden="true"></i> Search
                </button>
            </div>
        }

        <div class="saas-acc-table-card">
            <div class="saas-acc-table-card-head">
                <h3>Retailer loan permission</h3>
                <span class="saas-acc-row-count"><i class="fas fa-list" aria-hidden="true"></i> @rows.Count records</span>
            </div>
            <div class="saas-acc-table-wrap table-responsive">
                <table class="table saas-acc-table table-bordered">
                    <thead>
                        <tr>
                            <th>Sr.</th>
                            <th>Retailer</th>
                            <th>Dealer</th>
                            <th>Master</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var sr = 1; }
                        @{ var rowIndex = 0; }
                        @foreach (var i in rows)
                        {
                            var frmname = db.Retailer_Details.FirstOrDefault(s => s.RetailerId == i.userid);
                            var dealerName = "�";
                            var masterName = "�";
                            var retailerName = "�";

                            if (frmname != null)
                            {
                                retailerName = frmname.Frm_Name;
                                var dlmfrmname = db.Dealer_Details.FirstOrDefault(s => s.DealerId == frmname.DealerId);
                                if (dlmfrmname != null)
                                {
                                    dealerName = dlmfrmname.FarmName;
                                    var ssfrmname = db.Superstokist_details.FirstOrDefault(s => s.SSId == dlmfrmname.SSId);
                                    if (ssfrmname != null)
                                    {
                                        masterName = ssfrmname.FarmName;
                                    }
                                }
                            }

                            <tr>
                                <td data-label="Sr.">@sr</td>
                                <td data-label="Retailer">@retailerName</td>
                                <td data-label="Dealer">@dealerName</td>
                                <td data-label="Master">@masterName</td>
                                <td data-label="Status" class="idchanges" data-row-index="@rowIndex">
                                    @if (i.status == true)
                                    {
                                        <button type="button" class="btn saas-set-pill saas-set-pill--on" onclick="stsupd('@i.userid', @rowIndex, false)">ON</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn saas-set-pill saas-set-pill--off" onclick="stsupd('@i.userid', @rowIndex, true)">OFF</button>
                                    }
                                </td>
                            </tr>
                            sr++;
                            rowIndex++;
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</section>

<script src="~/MainFrontDesign/select2/dist/js/select2.full.min.js"></script>
<script>
    $(function () {
        if ($.fn.select2) {
            $('#allretailer').select2({ width: '100%' });
        }
    });

    function stsupd(u, rowIndex, s) {
        $.ajax({
            url: '@Url.Action("LoancommRemstsupdate", "Home")',
            type: 'POST',
            data: { userid: u, sts: s },
            cache: false,
            success: function (response) {
                if (response !== 'OK') {
                    if (typeof moSaveError === 'function') {
                        moSaveError('Could not update status.');
                    }
                    return;
                }
                var cell = document.querySelector('.idchanges[data-row-index="' + rowIndex + '"]');
                if (!cell) return;
                if (s === true) {
                    cell.innerHTML = '<button type="button" class="btn saas-set-pill saas-set-pill--on" onclick="stsupd(\'' + u + '\', ' + rowIndex + ', false)">ON</button>';
                } else {
                    cell.innerHTML = '<button type="button" class="btn saas-set-pill saas-set-pill--off" onclick="stsupd(\'' + u + '\', ' + rowIndex + ', true)">OFF</button>';
                }
                if (typeof swal === 'function') {
                    swal('Updated', 'Retailer loan status saved.', 'success');
                }
            },
            error: function () {
                if (typeof swal === 'function') {
                    swal('Error', 'Could not update retailer status.', 'error');
                }
            }
        });
    }
</script>
