                            @Html.TextBox("txtpointmobilenumber", "", new { @id = "txtpointmobilenumber", @class = "form-control vm-dmt-modal-input", placeholder = "Enter point contact number", @type = "number" })
                            <span class="vm-radiant-ref-field-error" aria-hidden="true"></span>
                        </div>
                        <div class="vm-dmt-modal-field">
