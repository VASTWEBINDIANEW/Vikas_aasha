                        </div>
                        <div class="vm-dmt-modal-field">
                            <label for="txtlong">Longitude</label>
                            @Html.TextBox("txtlong", "", new { @id = "txtlong", @class = "form-control vm-dmt-modal-input", placeholder = "Enter longitude", type = "number", step = "any", onblur = "validateLongitude()" })
                            <span class="vm-radiant-ref-field-error text-danger" id="longError"></span>
