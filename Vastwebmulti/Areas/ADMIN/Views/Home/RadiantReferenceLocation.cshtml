@model IEnumerable<Vastwebmulti.Models.Loilistreport_Result>
@using System.Linq
@{
    ViewBag.Title = "Reference Location";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var items = Model ?? Enumerable.Empty<Vastwebmulti.Models.Loilistreport_Result>();
    var rowCount = items.Count();
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=30" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=18" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-radiant-ref-location-page">

    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">
            <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-radiant-ref-toolbar-one-line">

                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>Trans. Reports</li>
                    <li>Reference Location</li>
                </ol>

                <div class="vm-radiant-ref-toolbar-actions">
                    <button type="button"
                            class="saas-acc-btn saas-acc-btn--search vm-radiant-ref-add-btn"
                            data-toggle="modal"
                            data-target="#addLoiModal"
                            title="Add new reference location">
                        <i class="fas fa-plus" aria-hidden="true"></i><span>Add New</span>
                    </button>
                </div>

            </div>
        </div>

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                        <span>Radiant reference location list</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong>@rowCount</strong>
                        </span>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="radiantRefLocationReport" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Details</th>
                                    <th>Referred&nbsp;By</th>
                                    <th>Ref&nbsp;Number</th>
                                    <th>State&nbsp;Name</th>
                                    <th>District&nbsp;Name</th>
                                    <th>City&nbsp;Name</th>
                                    <th>Client&nbsp;Name</th>
                                    <th>DC&nbsp;Code</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (items.Any())
                                {
                                    foreach (var item in items)
                                    {
                                        var statusTone = "pending";
                                        var statusFa = "fa-clock-o";
                                        var statusLabel = item.Status ?? "";

                                        if (!string.IsNullOrEmpty(item.Status) && item.Status.Equals("Failed", StringComparison.OrdinalIgnoreCase))
                                        {
                                            statusTone = "failed";
                                            statusFa = "fa-times";
                                        }
                                        else if (!string.IsNullOrEmpty(item.Status) && item.Status.Equals("Success", StringComparison.OrdinalIgnoreCase))
                                        {
                                            statusTone = "success";
                                            statusFa = "fa-check";
                                        }
                                        else if (!string.IsNullOrEmpty(item.Status) && item.Status.Equals("Pending", StringComparison.OrdinalIgnoreCase))
                                        {
                                            statusTone = "pending";
                                            statusFa = "fa-clock-o";
                                        }

                                        <tr class="vm-dmt-row vm-dmt-row--@statusTone" data-status="@statusLabel">
                                            <td class="vm-dmt-action-cell">
                                                <button type="button"
                                                        class="vm-dmt-act-btn vm-dmt-act-btn--view vm-radiant-ref-detail-btn"
                                                        data-toggle="modal"
                                                        data-target="#detailsModal"
                                                        data-rceid="@item.RetailerName"
                                                        data-clientname="@item.ClientName"
                                                        data-cashlimit="@item.Cashlimit"
                                                        data-status="@item.Status"
                                                        data-dccode="@item.DCCode"
                                                        data-pointname="@item.PointName"
                                                        data-pointmobile="@item.PointMobile"
                                                        data-pickupaddress="@item.pickupaddress"
                                                        data-subdescrtion="@item.SubDescrtion"
                                                        data-workmode="@item.WorkMode"
                                                        data-statename="@item.State_name"
                                                        data-districtname="@item.Dist_Desc"
                                                        data-cityname="@item.CityName"
                                                        data-pincode="@item.Pincode"
                                                        data-additionalrequirement="@item.AdditionalRequirement"
                                                        data-latitude="@item.Latitude"
                                                        data-longitude="@item.Longitude"
                                                        data-depositionmode="@item.Depositionmode"
                                                        onclick="showRadiantRefDetails(this)"
                                                        title="View full details">
                                                    <i class="fa fa-eye" aria-hidden="true"></i>
                                                </button>
                                            </td>
                                            <td class="vm-radiant-firm-cell">@item.RetailerName</td>
                                            <td class="vm-radiant-request-cell">@item.Refnumber</td>
                                            <td>@item.State_name</td>
                                            <td>@item.Dist_Desc</td>
                                            <td>@item.CityName</td>
                                            <td>@item.ClientName</td>
                                            <td>@item.DCCode</td>
                                            <td class="vm-radiant-status-cell vm-ticket-status-cell">
                                                <span class="vm-dmt-status vm-dmt-status--@statusTone" title="@statusLabel">
                                                    <i class="fa @statusFa" aria-hidden="true"></i>
                                                </span>
                                                <span class="vm-radiant-status-text">@statusLabel</span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="9" class="vm-opr-table-empty vm-dmt-table-empty">
                                            <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                                            <span>Reference location records not found.</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

