<script src="~/MainFrontDesign/select2/dist/js/select2.full.min.js"></script>
<script src="~/Swalalert/sweetalert-dev.js"></script>

<script>
    window.radiantRefDistrictUrl = '@Url.Action("District_Bind", "Home", new { area = "ADMIN" })';

    function showRadiantRefDetails(btn) {
        var fields = [
            'rceid', 'clientname', 'cashlimit', 'status', 'dccode', 'pointname', 'pointmobile',
            'pickupaddress', 'subdescrtion', 'workmode', 'statename', 'districtname', 'cityname',
            'pincode', 'additionalrequirement', 'latitude', 'longitude', 'depositionmode'
        ];

        fields.forEach(function (id) {
            var el = document.getElementById(id);
            if (!el) {
                return;
            }
            var value = btn.getAttribute('data-' + id) || btn.dataset[id] || '';
            el.textContent = String(value).trim() !== '' ? String(value) : '�';
        });
    }

    function radiantRefDistrictBind(el) {
        var id = $(el).val();

        $('#district1').empty().append('<option value="">Select District</option>');

        if (!id) {
            $('#district1').trigger('change.select2');
            return;
        }

        $.get(window.radiantRefDistrictUrl, { state_id: id }, function (data) {
            var options = '<option value="">Select District</option>';
            $.each(data, function (i, v1) {
                options += '<option value="' + v1.value + '">' + v1.text + '</option>';
            });
            $('#district1').html(options).trigger('change.select2');
        });
    }

    function validateLatitude() {
        var lat = parseFloat(document.getElementById('txtlat').value);
        var error = document.getElementById('latError');

        if (isNaN(lat)) {
            error.innerText = 'Latitude is required';
            return false;
        }

        if (lat < -90 || lat > 90) {
            error.innerText = 'Latitude must be between -90 and 90';
            return false;
        }

        error.innerText = '';
        return true;
    }

    function validateLongitude() {
        var lng = parseFloat(document.getElementById('txtlong').value);
        var error = document.getElementById('longError');

        if (isNaN(lng)) {
            error.innerText = 'Longitude is required';
            return false;
        }

        if (lng < -180 || lng > 180) {
            error.innerText = 'Longitude must be between -180 and 180';
            return false;
        }

        error.innerText = '';
        return true;
    }

    function validateLatLongOnSubmit() {
        return validateLatitude() && validateLongitude();
    }

    function initRadiantRefModalSelect2(modalId) {
        var $modal = $(modalId);
        $modal.find('.select2-inside-modal').each(function () {
            var $el = $(this);
            if ($el.hasClass('select2-hidden-accessible')) {
                $el.select2('destroy');
            }
            $el.select2({
                width: '100%',
                dropdownParent: $modal,
                minimumResultsForSearch: 6
            });
        });
    }

    $(document).ready(function () {
        $('#addLoiModal').on('shown.bs.modal', function () {
            initRadiantRefModalSelect2('#addLoiModal');
