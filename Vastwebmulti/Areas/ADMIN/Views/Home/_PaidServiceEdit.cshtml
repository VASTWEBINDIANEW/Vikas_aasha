@model Vastwebmulti.Areas.ADMIN.Models.Token_PaidService_VM

<table class="table table-bordered rc-inner-table">
        <thead>
            <tr>
                <th>Service</th>
                <th>Type</th>
                <th>Mode</th>
                <th>Price</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.PaidServicesChargeList.OrderByDescending(x => x.ServiceName == "ALL").ThenByDescending(x => x.ServiceName))
            {
                <tr>
                    <td>
                        @if (item.ServiceName == "VM30")       { <text>M-ATM (VM30)</text> }
                        else if (item.ServiceName == "MPOSH")  { <text>mPosh (ME30S)</text> }
                        else if (item.ServiceName == "DMT")    { <text>Money Pay</text> }
                        else if (item.ServiceName == "PANCARD"){ <text>Pan Card</text> }
                        else if (item.ServiceName == "INDONEPAL") { <text>Indo Nepal</text> }
                        else if (item.ServiceName == "SchoolFee") { <text>School Fee</text> }
                        else if (item.ServiceName == "FLIGHT") { <text>Flight</text> }
                        else if (item.ServiceName == "BUS")    { <text>Bus Booking</text> }
                        else if (item.ServiceName == "HOTEL")  { <text>Hotel</text> }
                        else if (item.ServiceName == "ECOMM")  { <text>eCommerce</text> }
                        else if (item.ServiceName == "GIFTCARD"){ <text>Gift Card</text> }
                        else { @item.ServiceName }
                    </td>

                    @if (item.Idno == Model.PaidServicesChargeByID.Idno)
                    {
                        @Html.Hidden("Idno", Model.PaidServicesChargeByID.Idno)
                        var selectm = Model.PaidServicesChargeByID.PaymentType == "Monthly"  ? "selected" : string.Empty;
                        var selecty = Model.PaidServicesChargeByID.PaymentType == "Yearly"   ? "selected" : string.Empty;
                        var selectl = Model.PaidServicesChargeByID.PaymentType == "LifeTime" ? "selected" : string.Empty;
                        var isfree  = Model.PaidServicesChargeByID.IsFree == true  ? "selected" : string.Empty;
                        var ispaid  = Model.PaidServicesChargeByID.IsFree == false ? "selected" : string.Empty;

                        <!-- Highlighted edit row -->
                        <td style="background:#fffbeb !important;">
                            <select id="ddlServiceName" name="ddlServiceName" class="form-control" style="height:30px!important;font-size:.76rem!important;border-radius:6px!important;min-width:70px;">
                                <option @isfree  value="true">Free</option>
                                <option @ispaid  value="false">Paid</option>
                            </select>
                        </td>
                        <td style="background:#fffbeb !important;">
                            <select id="ddlChargeType" name="ddlChargeType" class="form-control" style="height:30px!important;font-size:.76rem!important;border-radius:6px!important;min-width:80px;">
                                <option value="Monthly"  @selectm>Monthly</option>
                                <option value="Yearly"   @selecty>Yearly</option>
                                <option value="LifeTime" @selectl>LifeTime</option>
                            </select>
                        </td>
                        <td style="background:#fffbeb !important;">
                            @Html.TextBox("Price", Model.PaidServicesChargeByID.Price,
                                new { @class = "form-control", style = "height:30px!important;font-size:.76rem!important;border-radius:6px!important;min-width:70px;" })
                        </td>
                        <td style="background:#fffbeb !important;">
                            <button type="button" id="btnSavedata" onclick="btnSavedata(@item.Idno)" class="rc-ps-save-btn">
                                <i class="fas fa-save"></i> Save
                            </button>
                        </td>
                    }
                    else
                    {
                        var xx = item.IsFree ? "Free" : "Paid";
                        <td>
                            <span class="rc-type-badge @(item.IsFree ? "rc-type-badge--free" : "rc-type-badge--paid")">@xx</span>
                        </td>
                        <td>@item.PaymentType</td>
                        <td style="font-weight:600;color:#0891b2;">@item.Price</td>
                        <td>
                            <button type="button" onclick="Editmode('@item.Idno')" class="rc-ps-edit-btn">
                                <i class="fas fa-edit"></i> Edit
                            </button>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>

<script>
    function btnSavedata(idno) {
        $.ajax({
            url: '@Url.Action("UpdatePaidService","Home")',
            type: 'POST',
            data: {
                idno: idno,
                ddlChargeType: $('#ddlChargeType').val(),
                ddlServiceName: $('#ddlServiceName').val(),
                Price: $('#Price').val()
            },
            success: function (data) {
                setTimeout(function () { $('#paidservicetbl').html(data); }, 300);
            }
        });
    }
</script>
