<!--Delete Nillcom-->

<script type="text/javascript">
    function deletests(e) {
        //alert(e)

    $.ajax({
        type: "POST", url: "Delete_Statusmaster", data: { 'idno': e }, dataType: 'json', cache: false, success: function (result) {
            if (result == "Success") {
                //swal("Deleted!", "Deleted Successfully.", "success");
                var url = '@Url.Action("Status_master", "Home")';
                window.location.href = url;
            }
            else {
                swal("Failed!", "Something went wrong.", "error");
                var url = '@Url.Action("Status_master", "Home")';
                window.location.href = url;
            }
        }
    });

    }

</script>
<script>
    function isNumber(evt) {
        evt = (evt) ? evt : window.event;
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }
        return true;
    }
</script>

<script>
    function vmHardwareUpdateStatusTableInfo() {
        var $rows = $('#hardwareStatusTable tbody tr:not(.vm-hardware-table-empty)');
        var $visible = $rows.filter(':visible');
        var total = $rows.length;
        var vis = $visible.length;
        var $info = $('#vmHardwareStatusTableInfo');

        if (total === 0) {
            $info.text('Showing 0 to 0 of 0 entries');
        } else if (vis === 0) {
            $info.text('Showing 0 to 0 of ' + total + ' entries');
        } else {
            $info.text('Showing 1 to ' + vis + ' of ' + total + ' entries');
        }
    }

    $(document).ready(function () {
        $('#vmHardwareStatusSearch').on('input', function () {
            var q = $.trim($(this).val()).toLowerCase();
            $('#hardwareStatusTable tbody tr:not(.vm-hardware-table-empty)').each(function () {
                var match = !q || $(this).text().toLowerCase().indexOf(q) !== -1;
                $(this).toggle(match);
            });
            vmHardwareUpdateStatusTableInfo();
        });

        vmHardwareUpdateStatusTableInfo();
    });

    $('.click-to-sure').click(function () {
        $(this).hide();
        $(this).next('.vm-hardware-sure-btn').show();
    });
</script>


