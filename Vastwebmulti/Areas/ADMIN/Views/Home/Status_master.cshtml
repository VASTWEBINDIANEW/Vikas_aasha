                                <label for="Insertamtpost">Amount Post</label>
                                @Html.TextBox("Insertamtpost", "", new { @class = "form-control vm-status-field-input", id = "Insertamtpost", placeholder = "Enter Amount Post", onkeypress = "return isNumber(event)" })
                            </div>
                            <div class="vm-sm-modal-field vm-sm-modal-field--full">
                                <label for="Inserttranpre">Transaction Pre</label>
                                @Html.TextBox("Inserttranpre", "", new { @class = "form-control vm-status-field-input", id = "Inserttranpre", placeholder = "Enter Transaction Pre" })
                            </div>
                            <div class="vm-sm-modal-field vm-sm-modal-field--full">
