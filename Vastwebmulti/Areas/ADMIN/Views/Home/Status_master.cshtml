                                <label for="Insertlapupost">Lapu Post</label>
                                @Html.TextBox("Insertlapupost", "", new { @class = "form-control vm-status-field-input", id = "Insertlapupost", placeholder = "Enter Lapu Post" })
                            </div>
                            <div class="vm-sm-modal-field vm-sm-modal-field--full">
