<script>
    function initStatusModalSelect2($modal) {
        if (!$modal.length || !$.fn.select2) return;
        $modal.find('select.vm-status-field-input').each(function () {
            var $el = $(this);
            if ($el.hasClass('select2-hidden-accessible')) {
                $el.select2('destroy');
            }
            $el.select2({
                width: '100%',
                dropdownParent: $modal
            });
        });
    }

    $(document).ready(function () {
        initStatusModalSelect2($('#defaultModal'));
        initStatusModalSelect2($('#defaultModal1'));

        $('#defaultModal, #defaultModal1').on('shown.bs.modal', function () {
            initStatusModalSelect2($(this));
        });
    });
</script>
<script type="text/javascript">
    var val1 = "";
    function animation(txtid, txtoptnm, txtkey, txtmobpre, txtmobpost, txtamtpre, txtamtpost, txttranpre, txttranpost, txtlapupre, txtlapupost, txtreason, txtsmsfrm, txtsts) {
        $("#txtid").val(txtid);
        $("#txtoptnm").val(txtoptnm);
        $("#txtkey").val(txtkey);
        $("#txtmobpre").val(txtmobpre);
        $("#txtmobpost").val(txtmobpost);
        $("#txtamtpre").val(txtamtpre);
        $("#txtamtpost").val(txtamtpost);
        $("#txttranpre").val(txttranpre);
        $("#txttranpost").val(txttranpost);
        $("#txtlapupre").val(txtlapupre);
        $("#txtlapupost").val(txtlapupost);
        $("#txtreason").val(txtreason);
        $("#txtsmsfrm").val(txtsmsfrm);
        $("#txtsts").val(txtsts);
    }

</script>
