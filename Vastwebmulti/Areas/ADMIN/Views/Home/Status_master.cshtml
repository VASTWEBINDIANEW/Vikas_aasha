@model IEnumerable<Vastwebmulti.Models.show_status_master_Result>
@{
    ViewBag.Title = "Status_master";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var statusRows = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.show_status_master_Result>();
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-settings-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css?v=13" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-payment-gateway-slab-modern.css?v=10" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-prepaid-slab-modern.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-prepaid-slab-modals.css?v=2" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-prepaid-slab-mobile.css?v=6" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-hardware-modern.css?v=17" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-hardware-mobile.css?v=17" rel="stylesheet" />
<link href="~/select2/dist/css/select2.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-settings-page saas-pg-slab-page saas-prepaid-slab-page saas-hardware-page second-design">
    <div class="container-fluid">

        <div class="saas-acc-toolbar vm-hardware-toolbar-line vm-hardware-toolbar-line--status">
            <ol class="saas-acc-breadcrumb">
                <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                <li><a href="@Url.Action("Dashboard", "Home")#setting">Basic Setting</a></li>
                <li>Status Manager</li>
            </ol>
            <div class="vm-hardware-top-actions vm-hardware-top-actions--status">
                <div class="vm-hardware-status-filter">
                    @using (Html.BeginForm("Status_master", "Home", FormMethod.Post, new { @class = "vm-hardware-status-filter-form" }))
                    {
                        <div class="vm-hardware-status-filter__group">
                            @Html.DropDownList("ddl_status", new List<SelectListItem>
                            {
                                new SelectListItem{ Text="STATUS", Value="ALL" },
                                new SelectListItem{ Text="BALANCE", Value="B" },
                                new SelectListItem{ Text="SUCCESS", Value="S" },
                                new SelectListItem{ Text="FAILED", Value="F" },
                                new SelectListItem{ Text="Purchase", Value="P" }
                            }, new { @class = "vm-hardware-status-filter__select", id = "ddl_status" })
                            @Html.DropDownList("Operator", ViewBag.Operator as SelectList, "ALL OPERATORS", new { id = "Operator", @class = "vm-hardware-status-filter__select", required = "required" })
                            <button type="submit" class="vm-hardware-status-filter__submit">
                                <i class="fas fa-search" aria-hidden="true"></i>
                                <span>Search</span>
                            </button>
                        </div>
                    }
                </div>
                <button type="button" class="vm-hardware-btn-new vm-hardware-btn-new--primary vm-hardware-status-add-toggle" data-toggle="modal" data-target="#defaultModal">
                    <span class="vm-hardware-btn-new__icon" aria-hidden="true"><i class="fas fa-plus"></i></span>
                    <span class="vm-hardware-btn-new__label">New Status</span>
                </button>
                <label class="saas-acc-search vm-hardware-port-search vm-hardware-status-table-search" for="vmHardwareStatusSearch">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    <input type="text" id="vmHardwareStatusSearch" placeholder="Search status..." autocomplete="off" />
                </label>
            </div>
        </div>

        <div class="vm-prepaid-slab-shell">
            @Html.Partial("_menuport")

            <div class="vm-prepaid-slab-main">
                <div class="vm-pg-slab-card">
                    <div class="vm-pg-slab-card__head">
                        <h3 class="vm-pg-slab-card__title"><i class="fas fa-list-alt" aria-hidden="true"></i> Status Manager</h3>
                    </div>
                    <div class="vm-pg-slab-body">
                        <div class="vm-hardware-table-shell">
                            <div class="vm-pg-slab-table-scroll vm-prepaid-slab-table-wrap vm-hardware-table-wrap">
                                <table id="hardwareStatusTable" class="table table-bordered table-striped table-hover vm-pg-slab-table vm-hardware-status-table">
                            <thead>
                                            <tr>
                                                <th>OPT&nbsp;Name</th>
                                                <th>Keyword</th>
                                                <th colspan="2">Mobile&nbsp;Number </th>
                                                <th colspan="2"> Recharge&nbsp;Amount</th>
                                                <th colspan="2">Trans&nbsp;ID </th>
                                                <th colspan="2">Lapu&nbsp;Bal</th>
                                                <th>Reason</th>
                                                <th>Status</th>
                                                <th>Edit</th>
                                                <th>DEL</th>

                                            </tr>
                                            <tr>
                                                <th></th>
                                                <th></th>
                                                <th>Pre</th>
                                                <th>Post</th>
                                                <th>Pre</th>
                                                <th>Post</th>
                                                <th>Pre</th>
                                                <th>Post</th>
                                                <th>Pre</th>
                                                <th>Post</th>
                                                <th></th>
                                                <th></th>
                                                <th></th>
                                                <th></th>

                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (statusRows.Any())
                                            {
                                            foreach (var item in statusRows)
                                            {
                                                <tr>
                                                    <td>@Html.DisplayFor(modelItem => item.operator_name)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.Keyword)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.Mobilepre)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.Mobilepost)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.Amountpre)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.Amountpost) </td>
                                                    <td>@Html.DisplayFor(modelItem => item.Transpre)  </td>
                                                    <td>@Html.DisplayFor(modelItem => item.Transpost)  </td>
                                                    <td>@Html.DisplayFor(modelItem => item.Lapubalpre)  </td>
                                                    <td>@Html.DisplayFor(modelItem => item.Lapubalpost)   </td>
                                                    <td>@Html.DisplayFor(modelItem => item.Reason)  </td>
                                                    <td>@Html.DisplayFor(modelItem => item.Status)</td>
                                                    <td>
                                                        <button type="button" class="vm-hardware-view-btn" onclick="animation('@item.idno','@item.operator_name','@item.Keyword','@item.Mobilepre','@item.Mobilepost','@item.Amountpre','@item.Amountpost','@item.Transpre','@item.Transpost','@item.Lapubalpre','@item.Lapubalpost','@item.Reason','@item.SMSFrom','@item.Status')" data-toggle="modal" data-target="#defaultModal1">
                                                            View
                                                        </button>
                                                    </td>
                                                    <td>
                                                        <button type="button" class="vm-hardware-del-btn click-to-sure" aria-label="Delete">
                                                            <img src="~/MainFrontDesign/images/delete.svg" alt="" />
                                                        </button>
                                                        <button type="button" class="vm-hardware-sure-btn" onclick="deletests('@item.idno')">
                                                            Sure?
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                            }
                                            else
                                            {
                                                <tr class="vm-hardware-table-empty">
                                                    <td colspan="14">No data available in table</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                            </div>
                            <div id="vmHardwareStatusTableFooter" class="vm-hardware-table-footer">
                                <span id="vmHardwareStatusTableInfo">Showing 0 to 0 of 0 entries</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!--Add  modal-->
