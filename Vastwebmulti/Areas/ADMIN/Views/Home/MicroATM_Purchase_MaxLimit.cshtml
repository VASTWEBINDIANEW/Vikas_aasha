@model Vastwebmulti.Areas.ADMIN.Models.MicroATMPurchase_Max_Purchase_Limit
@using Vastwebmulti.Areas.ADMIN.Models
@using System.Linq
@{
    ViewBag.Title = "Micro ATM Purchase Max Limit";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var chargeList = Model != null && Model.microchargelist != null ? Model.microchargelist : new List<RetailerMicroATMPurchaseamountlist>();
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-settings-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-settings-page saas-admin-report-page saas-micro-maxlimit-page">
    <div class="container-fluid">

        <div id="mictiatmsave-loader" class="saas-micro-loader" style="display:none;" aria-hidden="true">
            <div class="saas-micro-loader-inner"><i class="fas fa-spinner fa-spin fa-2x"></i></div>
        </div>

        @using (Html.BeginForm("MicroATM_Purchase_MaxLimit", "Home", FormMethod.Post, new { id = "microMaxLimitSearchForm", style = "display:none;" }))
        {
            <input type="hidden" id="hdRetailer_ID" name="hdRetailer_ID" value="" />
            <input type="submit" id="btnsubmitsearch" name="btnsubmitsearch" />
        }

        @using (Ajax.BeginForm("Update_MicroATM_Limit", "Home", new AjaxOptions { HttpMethod = "POST", OnSuccess = "microMaxLimitSaveSuccess", OnFailure = "microMaxLimitSaveFailed", UpdateTargetId = "remcash" }))
        {
            <div class="saas-acc-toolbar saas-pan-toolbar-unified saas-micro-toolbar-unified" style=" margin: 0 0 20px !important;">
                <ol class="saas-acc-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li><a href="@Url.Action("Micro_Atm_Unhold_Report", "Home")">Micro ATM Unhold</a></li>
                    <li>Max purchase limit</li>
                </ol>
                <div class="saas-acc-toolbar-right saas-pan-toolbar-dates">
                    <div class="saas-acc-report-date-controls saas-pan-date-controls saas-micro-toolbar-actions">
                        <div class="saas-micro-maxlimit-select">
                            @Html.DropDownListFor(m => m.Retailer_ID, Model.retailer_lists, "Select retailer", new { @class = "for-select2 form-control", id = "Retailer_ID" })
                        </div>
                        <button type="button" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn" id="btnsearch">
                            <i class="fas fa-search" aria-hidden="true"></i> Search
                        </button>
                        <button type="button" class="saas-acc-btn saas-acc-btn--pdf saas-pan-export-btn" id="btnedit">
                            <i class="fas fa-edit" aria-hidden="true"></i> Edit
                        </button>
                        <button type="submit" class="saas-acc-btn saas-acc-btn--excel saas-pan-export-btn btnsaveshowclass" id="btnsave" style="display:none;">
                            <i class="fas fa-save" aria-hidden="true"></i> Save
                        </button>
                    </div>
                </div>
            </div>

            <div class="saas-acc-table-card" id="remcash">
                <div class="saas-acc-table-card-head">
                    <h3>Max amount limits</h3>
                    <span class="saas-acc-row-count"><i class="fas fa-list" aria-hidden="true"></i> @chargeList.Count card types</span>
                </div>
                <div class="saas-acc-table-wrap table-responsive">
                    <table class="table saas-acc-table table-bordered">
                        <thead>
                            <tr>
                                <th>User</th>
                                <th>Card type</th>
                                <th class="text-right">Max amount limit</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyshowretailer">
                            @if (chargeList.Count == 0)
                            {
                                <tr>
                                    <td colspan="3" class="saas-pan-empty-cell">Select a retailer and search.</td>
                                </tr>
                            }
                            else
                            {
                                foreach (var item in chargeList)
                                {
                                    <tr>
                                        <td data-label="User">@item.userid</td>
                                        <td data-label="Card">@item.Card_type</td>
                                        <td data-label="Limit" class="text-right saas-pan-amount">@item.maxamount</td>
                                    </tr>
                                }
                            }
                        </tbody>
                        @if (chargeList.Count > 0)
                        {
                            <tbody id="tbodyeditretailer" style="display:none;">
                                @for (int i = 0; i < chargeList.Count; i++)
                                {
                                    <tr>
                                        @Html.HiddenFor(a => a.microchargelist[i].idno)
                                        @Html.HiddenFor(a => a.microchargelist[i].userinfo)
                                        @Html.HiddenFor(a => a.microchargelist[i].Card_type)
                                        <td data-label="User">@Html.DisplayFor(a => a.microchargelist[i].userid)</td>
                                        <td data-label="Card">@Html.DisplayFor(a => a.microchargelist[i].Card_type)</td>
                                        <td data-label="Limit">
                                            @Html.EditorFor(a => a.microchargelist[i].maxamount, new { htmlAttributes = new { @class = "form-control saas-micro-limit-input" } })
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        }
                    </table>
                </div>
            </div>
        }
    </div>
</section>

<script>
    $(function () {
        if (window.bootAdminSelect2) { window.bootAdminSelect2(); }
    });

    $('#btnsearch').on('click', function () {
        $('#hdRetailer_ID').val($('#Retailer_ID').val() || '');
        $('#btnsubmitsearch').click();
    });

    $('#btnedit').on('click', function () {
        $('#tbodyeditretailer').show();
        $('#tbodyshowretailer').hide();
        $('#btnsave').show();
        $('#btnedit').hide();
    });

    $('#btnsave').on('click', function () {
        $('#mictiatmsave-loader').show();
    });

    function microMaxLimitSaveSuccess(data) {
        $('#mictiatmsave-loader').hide();
        $('#btnsave').hide();
        $('#btnedit').show();
        if (typeof swal === 'function') {
            swal('Saved', 'Limits updated successfully.', 'success');
        }
        window.location.reload();
    }

    function microMaxLimitSaveFailed() {
        $('#mictiatmsave-loader').hide();
        if (typeof swal === 'function') {
            swal('Error', 'Could not save limits.', 'error');
        }
    }
</script>
