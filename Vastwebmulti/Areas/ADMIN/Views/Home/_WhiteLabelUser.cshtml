<script>
    function Approved(val) {
        var WhiteLabelID = $('#WhiteLabelID').val();
        $.ajax({ url: '@Url.Action("ApprovedWhiteLabelsts","Home")', type: 'POST', data: { val: val, WhiteLabelID: WhiteLabelID }, cache: false,
            success: function (response) {
                if (response === 'pan') { $('#panapproved').hide(); }
                else if (response === 'aadhar') { $('#aadharapproved').hide(); }
                else if (response === 'gst') { $('#gstapproved').hide(); }
                else if (response === 'Aggrement') { $('#frmagrapproved').hide(); }
                if ($('#panapproved').css('display') == 'none' && $('#aadharapproved').css('display') == 'none') {
                    $('#frmagrEdit').val('Aggrement Status Pending'); $('#frmagrapproved').hide();
                }
            }
        });
    }
    function Rejected(val) {
        var WhiteLabelID = $('#WhiteLabelID').val();
        $.ajax({ url: '@Url.Action("RejectedWhiteLabelsts","Home")', type: 'POST', data: { val: val, WhiteLabelID: WhiteLabelID }, cache: false,
            success: function (response) {
                if (response === 'pan') { $("#pandocnotshow").show(); $("#pandocshow").hide(); $('#frmagrdocshow').hide(); $("#frmagrdocnotshow").show(); $('#frmagrEdit').val('KYC Due'); $('#alinks').empty(); }
                else if (response === 'aadhar') { $("#aadhardocnotshow").show(); $("#aadhardocshow").hide(); $('#frmagrdocshow').hide(); $("#frmagrdocnotshow").show(); $('#frmagrEdit').val('KYC Due'); $('#alinks').empty(); }
                else if (response === 'gst') { $("#gstdocnotshow").show(); $("#gstdocshow").hide(); }
                else if (response === 'Aggrement') { $("#frmagrdocnotshow").show(); $('#frmagrdocshow').hide(); $('#frmagrEdit').val('KYC Due'); $('#alinks').empty(); }
            }
        });
    }
</script>
<script>
    function mdActionBtn(WhiteLabelID) {
        $.ajax({ url: '@Url.Action("WhiteLabelUserIdSearch","Home")', type: "POST", data: { WhiteLabelID: WhiteLabelID }, cache: false,
            success: function (data2) {
                var CCNValue = data2.list[0].aadharnumber;
                CCNValue = CCNValue.substring(0, 8).replace(/\d/g, "X") + CCNValue.substring(8);
                var date = new Date(parseInt((data2.list[0].JoinDate).match(/\d+/)[0]));
                var createddate = converttoDate(date);
                $('#error').text("");
                $("#WhiteLabelID").val(data2.list[0].WhiteLabelID);
                $("#WhiteLabelIDdelete").val(data2.list[0].WhiteLabelID);
                $("#WhiteLabelIDshow").val(data2.list[0].WhiteLabelID);
                // Populate display name/firm/date in profile strip
                $("#Names").text(data2.list[0].Name);
                $("#NameEdit").val(data2.list[0].Name);
                $("#FirmName").text(data2.list[0].FrmName);
                $("#FirmEdit").val(data2.list[0].FrmName);
                $("#RegisteredDate").text(createddate);
                // View field values (modern info cards)
                $("#view_Email").text(data2.list[0].EmailId || '—');
                $("#view_Pan").text(data2.list[0].PanCardnumber || '—');
                $("#view_Aadhar").text(CCNValue || '—');
                $("#view_Pin").text(data2.list[0].Pincode || '—');
                $("#view_GST").text(data2.list[0].GstNumber || '—');
                $("#view_State").text(data2.list[0].State_name || '—');
                $("#view_District").text(data2.list[0].Dist_Desc || '—');
                $("#view_Address").text(data2.list[0].Address || '—');
                // Hidden fields for form submission compatibility
                $("#Email11").val(data2.list[0].EmailId);
                $("#Pancard11").val(data2.list[0].PanCardnumber);
                $("#Aadhar11").val(CCNValue);
                $("#GSTRegistrationNo11").val(data2.list[0].GstNumber);
                $("#pincode11").val(data2.list[0].Pincode);
                $("#State11").val(data2.list[0].State_name);
                $("#District11").val(data2.list[0].Dist_Desc);
                $("#address11").val(data2.list[0].Address);
                // Edit form fields
                $("#pancardEdit").val(data2.list[0].PanCardnumber);
                $("#AadhaarEdit").val(data2.list[0].aadharnumber);
                $("#gstEdit").val(data2.list[0].GstNumber);
                $("#PinEdit").val(data2.list[0].Pincode);
                $("#offmargineEdit").val(data2.list[0].marginecomm);
                // Balance + margin display
                $("#offmargine").text(data2.list[0].marginecomm || '—');
                $("#Whitelabelremain").html(data2.list[0].remainbal);
                $("#AddressEdit").val(data2.list[0].Address);
                $("#StateEdit").val(data2.list[0].state);
                var pancarddoc = data2.list[0].pancardPath;
                var aadhardoc = data2.list[0].aadharcardPath;
                var gstdoc = data2.list[0].frimregistrationPath;
                var frmagmnt = data2.list[0].Agreementpath;
                if (pancarddoc == null) { $("#pandocnotshow").show(); $("#pandocshow").hide(); }
                else { $("#pandocnotshow").hide(); $("#pandocshow").show(); $('#panimageshow').attr('src', "../.." + pancarddoc); }
                if (aadhardoc == null) { $("#aadhardocnotshow").show(); $("#aadhardocshow").hide(); }
                else { $("#aadhardocnotshow").hide(); $("#aadhardocshow").show(); $('#aadharimageshow').attr('src', "../.." + aadhardoc); }
                if (gstdoc == null) { $("#gstdocnotshow").show(); $("#gstdocshow").hide(); }
                else { $("#gstdocnotshow").hide(); $("#gstdocshow").show(); $('#gstimageshow').attr('src', "../.." + gstdoc); }
                $('#panapproved').toggle(data2.list[0].PSAStatus !== "Y");
                $('#aadharapproved').toggle(data2.list[0].AadhaarStatus !== "Y");
                $('#gstapproved').toggle(data2.list[0].gststatus !== "Y");
                if (data2.list[0].PSAStatus == "Y" && data2.list[0].AadhaarStatus == "Y") {
                    if (frmagmnt == null) { $('#frmagrEdit').val('Agreement Status Pending'); $("#frmagrdocnotshow").show(); $('#frmagrdocshow').hide(); $('#frmagrapproved').hide(); }
                    else {
                        $('#frmagrEdit').val('Agreement Status Pending'); $('#frmagrapproved').show(); $("#frmagrdocnotshow").hide(); $("#frmagrdocshow").show(); $('#frmagrimageshow').attr('src', "../.." + frmagmnt);
                        if (data2.list[0].IsAgreement === true) {
                            $("#frmagrdocnotshow").hide(); $('#frmagrapproved').hide();
                            var link = $("<a>").attr("href", "#").text("Certificate").addClass("link");
                            $('#alinks').html(link); $('#frmagrimageshow').attr('src', "../.." + frmagmnt);
                            $('#frmagrEdit').val('Agreement Approved - Check Certificate.');
                        }
                    }
                } else { $('#frmagrdocshow').hide(); $('#frmagrapproved').hide(); $('#frmagrEdit').val('KYC Due'); }
                ravi('#StateEdit').html('');
                var options = '<option value="">Select</option>';
                for (var i = 0; i < data2.state.length; i++) {
                    options += '<option' + (data2.state[i].Selected ? ' selected' : '') + ' value="' + data2.state[i].Value + '">' + data2.state[i].Text + '</option>';
                }
                ravi('#StateEdit').append(options);
                GetDistrict11(data2.list[0].state);
                var objSelect11 = document.getElementById("DistrictEdit");
                binddistmdAction(data2.list[0].state, data2.list[0].district, objSelect11);
                // Always open in view mode
                $(".mastetr222Modal .first-form").show();
                $(".mastetr222Modal .second-form").hide();
                // Re-init modal every time so Bootstrap cache doesn't break re-open
                var $m = $('#defaultModal222');
                $m.removeData('bs.modal');
                $m.modal({ backdrop: 'static', keyboard: true });
                $m.modal('show');
            }
        });
    }
    function converttoDate(str) {
        var date = new Date(str), mnth = ("0" + (date.getMonth() + 1)).slice(-2), day = ("0" + date.getDate()).slice(-2);
        return [day, mnth, date.getFullYear()].join("-") + " " + date.getHours() + ":" + date.getMinutes() + ":" + date.getSeconds();
    }
    function binddistmdAction(staid, dist, objSelect11) {
        $.ajax({ url: '@Url.Action("DistrictList","Home")', data: { Id: staid }, cache: false, type: "POST",
            success: function (data1) {
                var markup = "<option value='0'>Select District</option>";
                for (var x = 0; x < data1.length; x++) { markup += "<option value=" + data1[x].Value + ">" + data1[x].Text + "</option>"; }
                $("#DistrictEdit").html(markup).show();
                setSelectedValue(objSelect11, dist);
            }
        });
    }
    function setSelectedValue(selectObj, valueToSet) {
        for (var i = 0; i < selectObj.options.length; i++) { if (selectObj.options[i].value == valueToSet) { selectObj.options[i].selected = true; return; } }
    }
</script>
