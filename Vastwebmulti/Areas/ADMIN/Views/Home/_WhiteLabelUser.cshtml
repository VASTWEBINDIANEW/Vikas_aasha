<style>
/* ==============================
   WHITE LABEL — Table Styles
   ============================== */
.wl-badge { display:inline-flex; align-items:center; justify-content:center; min-width:54px; padding:3px 8px; border-radius:6px; font-size:.63rem; font-weight:700; white-space:nowrap; }
.wl-badge--done { background:linear-gradient(135deg,#bbf7d0,#86efac); color:#14532d; border:1px solid #86efac; }
.wl-badge--due  { background:linear-gradient(135deg,#fef3c7,#fde68a); color:#78350f; border:1px solid #fde68a; }
.wl-on-btn  { height:26px; padding:0 10px; border-radius:6px; font-size:.63rem; font-weight:700; border:none; cursor:pointer; background:linear-gradient(135deg,#16a34a,#22c55e); color:#fff; box-shadow:0 2px 5px rgba(22,163,74,.25); }
.wl-off-btn { height:26px; padding:0 10px; border-radius:6px; font-size:.63rem; font-weight:700; border:none; cursor:pointer; background:linear-gradient(135deg,#e2e8f0,#f1f5f9); color:#64748b; }
.wl-detail-btn { width:26px; height:26px; border-radius:7px; border:1.5px solid #bfdbfe; background:#eff6ff; color:#2563eb; cursor:pointer; display:inline-flex; align-items:center; justify-content:center; font-size:.7rem; transition:all .14s; margin-left:4px; }
.wl-detail-btn:hover { background:#dbeafe; }

/* ==============================
   WHITE LABEL — Main Modal
   ============================== */
.wl-modal .modal-dialog { max-width:700px; margin:30px auto; }
@@media(max-width:767px){ .wl-modal .modal-dialog { margin:8px; } }
.wl-modal .modal-content { border:none; border-radius:16px; overflow:hidden; box-shadow:0 24px 64px rgba(15,23,42,.22); }

/* Header */
.wl-modal-header {
    background:linear-gradient(135deg,#1e3a8a 0%,#2563eb 100%);
    padding:14px 20px; display:flex; align-items:center; justify-content:space-between;
}
.wl-modal-header__left { display:flex; align-items:center; gap:12px; }
.wl-modal-header__icon { width:38px; height:38px; background:rgba(255,255,255,.18); border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:1rem; color:#fff; }
.wl-modal-header__label { font-size:.65rem; font-weight:600; color:#93c5fd; letter-spacing:.04em; text-transform:uppercase; }
.wl-modal-header__balance { font-size:.95rem; font-weight:800; color:#fff; margin-top:1px; }
.wl-modal-close { width:32px; height:32px; border-radius:9px; background:rgba(255,255,255,.15); border:none; color:#fff; cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:.85rem; transition:.14s; flex-shrink:0; }
.wl-modal-close:hover { background:rgba(255,255,255,.28); }

/* Profile strip */
.wl-modal-profile {
    display:flex; align-items:center; gap:14px; padding:14px 20px;
    background:linear-gradient(180deg,#f0f7ff,#f8fafc); border-bottom:1.5px solid #e2e8f0;
}
.wl-modal-avatar { width:50px; height:50px; border-radius:12px; object-fit:cover; border:2px solid #dbeafe; }
.wl-modal-profile__info { flex:1; }
.wl-modal-profile__name { font-size:.88rem; font-weight:700; color:#0f172a; margin-bottom:1px; }
.wl-modal-profile__firm { font-size:.74rem; color:#475569; }
.wl-modal-profile__date { font-size:.65rem; color:#94a3b8; margin-top:2px; }
.wl-modal-profile__error { font-size:.73rem; color:#dc2626; font-weight:600; }

/* Body */
.wl-modal-body { padding:16px 20px 8px; max-height:62vh; overflow-y:auto; }
.wl-modal-body::-webkit-scrollbar { width:5px; }
.wl-modal-body::-webkit-scrollbar-thumb { background:#e2e8f0; border-radius:99px; }

/* Form fields inside modal */
.wl-modal-body .form-group { margin-bottom:8px; }
.wl-modal-body .form-group label { font-size:.72rem; font-weight:600; color:#475569; margin-bottom:3px; display:block; }
.wl-modal-body .form-control { height:34px !important; border-radius:8px !important; border:1.5px solid #e2e8f0 !important; font-size:.78rem !important; background:#f8fafc !important; color:#1e293b; transition:border-color .15s,box-shadow .15s; }
.wl-modal-body .form-control:focus { border-color:#2563eb !important; box-shadow:0 0 0 3px rgba(37,99,235,.1) !important; background:#fff !important; outline:none; }
.wl-modal-body textarea.form-control { height:auto !important; min-height:58px !important; }
.wl-modal-body select.form-control { padding-right:28px; }

/* Section divider inside body */
.wl-modal-section-label { font-size:.68rem; font-weight:700; color:#2563eb; text-transform:uppercase; letter-spacing:.06em; margin:12px 0 8px; padding-bottom:4px; border-bottom:1.5px solid #dbeafe; }

/* Document cards grid */
.wl-doc-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:8px; margin-top:4px; }
@@media(max-width:576px){ .wl-doc-grid { grid-template-columns:1fr; } }
.wl-doc-card { background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:10px; padding:10px 12px; display:flex; flex-direction:column; gap:6px; transition:border-color .15s,background .15s; }
.wl-doc-card:hover { border-color:#bfdbfe; background:#eff6ff; }
.wl-doc-card__head { display:flex; align-items:center; gap:8px; }
.wl-doc-card__icon { width:28px; height:28px; border-radius:8px; display:inline-flex; align-items:center; justify-content:center; font-size:.75rem; flex-shrink:0; }
.wl-doc-card__icon--pan    { background:#dbeafe; color:#1d4ed8; }
.wl-doc-card__icon--aadhar { background:#dcfce7; color:#166534; }
.wl-doc-card__icon--gst    { background:#ede9fe; color:#6d28d9; }
.wl-doc-card__icon--agr    { background:#fff7ed; color:#c2410c; }
.wl-doc-card__title { font-size:.74rem; font-weight:700; color:#1e293b; }
.wl-doc-card .form-control { margin-top:2px; }
.wl-doc-card__actions { display:flex; flex-wrap:wrap; gap:4px; align-items:center; }
.wl-doc-card__actions > div { display:contents; }
.wl-doc-btn { height:27px; padding:0 9px; border-radius:7px; font-size:.65rem; font-weight:600; border:none; cursor:pointer; display:inline-flex; align-items:center; gap:3px; transition:opacity .13s,transform .12s; white-space:nowrap; }
.wl-doc-btn:active { transform:scale(.97); }
.wl-doc-btn--view    { background:linear-gradient(135deg,#2563eb,#3b82f6); color:#fff; box-shadow:0 2px 5px rgba(59,130,246,.28); }
.wl-doc-btn--delete  { background:linear-gradient(135deg,#dc2626,#ef4444); color:#fff; box-shadow:0 2px 5px rgba(220,38,38,.22); }
.wl-doc-btn--approve { background:linear-gradient(135deg,#16a34a,#22c55e); color:#fff; box-shadow:0 2px 5px rgba(22,163,74,.25); }
.wl-notfound-badge { display:inline-flex; align-items:center; gap:5px; font-size:.65rem; color:#92400e; background:#fef9c3; border:1px solid #fde68a; padding:2px 8px; border-radius:5px; font-weight:600; }

/* Edit form — icon+input 2-column grid */
.wl-edit-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:8px; }
@@media(max-width:480px){ .wl-edit-grid { grid-template-columns:1fr; } }
.wl-edit-field { display:flex; align-items:flex-start; gap:8px; background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:10px; padding:8px 10px; transition:border-color .15s; }
.wl-edit-field:hover { border-color:#bfdbfe; background:#f0f7ff; }
.wl-edit-field--full { grid-column:1/-1; }
.wl-edit-field__icon { width:30px; height:30px; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:.75rem; flex-shrink:0; margin-top:18px; }
.wl-icon--blue   { background:#dbeafe; color:#1d4ed8; }
.wl-icon--purple { background:#ede9fe; color:#6d28d9; }
.wl-icon--green  { background:#dcfce7; color:#166534; }
.wl-icon--orange { background:#fff7ed; color:#c2410c; }
.wl-icon--teal   { background:#cffafe; color:#0e7490; }
.wl-icon--red    { background:#fee2e2; color:#b91c1c; }
.wl-icon--slate  { background:#f1f5f9; color:#475569; }
.wl-edit-field__body { flex:1; min-width:0; }
.wl-edit-field__body label { font-size:.68rem; font-weight:700; color:#475569; margin-bottom:3px; display:block; text-transform:uppercase; letter-spacing:.03em; }
.wl-edit-field__body .form-control { height:32px !important; border-radius:7px !important; border:1.5px solid #e2e8f0 !important; font-size:.77rem !important; background:#fff !important; padding:3px 9px !important; }
.wl-edit-field__body textarea.form-control { height:auto !important; min-height:50px !important; }
.wl-edit-field__body .form-control:focus { border-color:#2563eb !important; box-shadow:0 0 0 3px rgba(37,99,235,.1) !important; outline:none; }
.wl-edit-field__body select.form-control { padding-right:24px !important; }

/* Modal footer */
.wl-modal-footer { padding:10px 20px 14px; display:flex; align-items:center; gap:8px; border-top:1.5px solid #f1f5f9; background:#f8fafc; flex-wrap:wrap; }
.wl-modal-footer ul { list-style:none; display:flex; flex-wrap:wrap; gap:7px; padding:0; margin:0; }
.wl-mf-btn { height:34px; padding:0 14px; border-radius:8px; font-size:.74rem; font-weight:700; border:none; cursor:pointer; display:inline-flex; align-items:center; gap:6px; transition:opacity .13s,transform .12s; white-space:nowrap; }
.wl-mf-btn:hover { opacity:.88; }
.wl-mf-btn:active { transform:scale(.97); }
.wl-mf-btn--edit   { background:linear-gradient(135deg,#1d4ed8,#3b82f6); color:#fff; box-shadow:0 2px 8px rgba(37,99,235,.28); }
.wl-mf-btn--save   { background:linear-gradient(135deg,#15803d,#22c55e); color:#fff; box-shadow:0 2px 8px rgba(22,163,74,.28); }
.wl-mf-btn--verify { background:linear-gradient(135deg,#0e7490,#0891b2); color:#fff; box-shadow:0 2px 8px rgba(8,145,178,.22); }
.wl-mf-btn--delete { background:linear-gradient(135deg,#b91c1c,#ef4444); color:#fff; box-shadow:0 2px 8px rgba(220,38,38,.22); }
.wl-mf-btn--back   { background:#f1f5f9; color:#475569; border:1.5px solid #e2e8f0; }

/* View form info rows */
.wl-view-row { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
@@media(max-width:480px){ .wl-view-row { grid-template-columns:1fr; } }
.wl-view-field { background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:8px; padding:7px 11px; }
.wl-view-field__label { font-size:.62rem; font-weight:700; color:#64748b; text-transform:uppercase; letter-spacing:.04em; margin-bottom:2px; }
.wl-view-field__val { font-size:.8rem; font-weight:600; color:#0f172a; word-break:break-word; }
</style>

<!-- ===== Table (same design as DistibutorList) ===== -->
<div class="table-responsive vm-ml-table-scroll saas-acc-table-wrap">
<table class="table table-bordered saas-acc-table vm-ml-data-table third-design-table" id="mdList">
    <thead>
        <tr>
            <th>Sr</th>
            <th>White&nbsp;Label&nbsp;Firm</th>
            <th>Name</th>
            <th>Mobile</th>
            <th>PAN&nbsp;No</th>
            <th>KYC</th>
            <th>Email&nbsp;V/F</th>
            <th>Robotic&nbsp;API</th>
        </tr>
    </thead>
    <tbody id="body">
        @if (Model.White_labelUser != null)
        {
            int i = 0;
            int id = 1;
            foreach (var item in Model.White_labelUser)
            {
                <tr class="tr">
                    <td>@id</td>
                    <td><strong>@item.FrmName</strong></td>
                    <td>@item.Name</td>
                    <td style="font-weight:600;">@item.Mobile</td>
                    <td>@item.PanCardnumber</td>
                    <td>
                        @if (item.PSAStatus == "Y" && item.AadhaarStatus == "Y")
                        {
                            <span class="wl-badge wl-badge--done"><i class="fas fa-check-circle" style="margin-right:3px;"></i>Done</span>
                        }
                        else
                        {
                            <span class="wl-badge wl-badge--due"><i class="fas fa-clock" style="margin-right:3px;"></i>Due</span>
                        }
                    </td>
                    <td>
                        @if (item.EmailConfirmed == true)
                        {
                            <span class="wl-badge wl-badge--done"><i class="fas fa-envelope-open" style="margin-right:3px;"></i>Done</span>
                        }
                        else
                        {
                            <span class="wl-badge wl-badge--due"><i class="fas fa-envelope" style="margin-right:3px;"></i>Due</span>
                        }
                    </td>
                    <td>
                        <span id="@item.WhiteLabelID" style="display:inline-flex;align-items:center;gap:4px;">
                            @if (item.Allow_RoboticsApi == "Y")
                            {
                                <button class="wl-on-btn costom-on" onclick="ON_OFF('@item.WhiteLabelID')"><i class="fas fa-toggle-on"></i> ON</button>
                            }
                            else
                            {
                                <button class="wl-off-btn custom-off" onclick="ON_OFF('@item.WhiteLabelID')"><i class="fas fa-toggle-off"></i> OFF</button>
                            }
                            <button class="wl-detail-btn js-wl-open-modal" data-wlid="@item.WhiteLabelID" title="View Details">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </span>
                    </td>
                </tr>
                i++;
                id++;
            }
        }
    </tbody>
</table>
</div>

<!-- ===== Main Detail Modal ===== -->
<div class="modal fade wl-modal mastetr222Modal" id="defaultModal222" tabindex="-1" role="dialog" aria-labelledby="wlModalTitle">
    <div class="modal-dialog" role="document">
        <div class="modal-content">

            <!-- -- Header -- -->
            <div class="wl-modal-header">
                <div class="wl-modal-header__left">
                    <div class="wl-modal-header__icon"><i class="fas fa-user-tag"></i></div>
                    <div>
                        <div class="wl-modal-header__label">White Label User</div>
                        <div class="wl-modal-header__balance" id="wlModalTitle">
                            <i class="fas fa-wallet" style="font-size:.75rem;margin-right:5px;opacity:.8;"></i>Balance:&nbsp;<span id="Whitelabelremain">—</span>
                        </div>
                    </div>
                </div>
                <button type="button" class="wl-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times"></i></button>
            </div>

            <!-- -- Profile strip -- -->
            <div class="wl-modal-profile">
                <img src="~/AdminDesign/images/user.png" class="wl-modal-avatar" alt="User" />
                <div class="wl-modal-profile__info">
                    <div class="wl-modal-profile__name"><span id="Names"></span></div>
                    <div class="wl-modal-profile__firm"><i class="fas fa-building" style="margin-right:4px;color:#94a3b8;"></i><span id="FirmName"></span></div>
                    <div class="wl-modal-profile__date"><i class="far fa-clock" style="margin-right:4px;"></i><span id="RegisteredDate"></span></div>
                </div>
                <span id="error" class="wl-modal-profile__error"></span>
            </div>

            <!-- -- Body -- -->
            <div class="wl-modal-body">

                <!-- VIEW form (read-only) -->
                <form class="first-form">
                    @Html.Hidden("WhiteLabelIDshow")

                    <!-- Info grid -->
                    <div class="wl-view-row">
                        <div class="wl-view-field">
                            <div class="wl-view-field__label"><i class="fas fa-envelope" style="margin-right:3px;"></i>Email</div>
                            <div class="wl-view-field__val" id="view_Email">—</div>
                            @Html.Hidden("Email11")
                        </div>
                        <div class="wl-view-field">
                            <div class="wl-view-field__label"><i class="fas fa-id-card" style="margin-right:3px;"></i>PAN Card</div>
                            <div class="wl-view-field__val" id="view_Pan">—</div>
                            @Html.Hidden("Pancard11")
                        </div>
                        <div class="wl-view-field">
                            <div class="wl-view-field__label"><i class="fas fa-fingerprint" style="margin-right:3px;"></i>Aadhaar</div>
                            <div class="wl-view-field__val" id="view_Aadhar">—</div>
                            @Html.Hidden("Aadhar11")
                        </div>
                        <div class="wl-view-field">
                            <div class="wl-view-field__label"><i class="fas fa-map-pin" style="margin-right:3px;"></i>Pin Code</div>
                            <div class="wl-view-field__val" id="view_Pin">—</div>
                            @Html.Hidden("pincode11")
                        </div>
                        <div class="wl-view-field">
                            <div class="wl-view-field__label"><i class="fas fa-percent" style="margin-right:3px;"></i>Margin (Offline)</div>
                            <div class="wl-view-field__val" id="offmargine">—</div>
                        </div>
                        <div class="wl-view-field">
                            <div class="wl-view-field__label"><i class="fas fa-file-invoice" style="margin-right:3px;"></i>GST No</div>
                            <div class="wl-view-field__val" id="view_GST">—</div>
                            @Html.Hidden("GSTRegistrationNo11")
                        </div>
                        <div class="wl-view-field">
                            <div class="wl-view-field__label"><i class="fas fa-map" style="margin-right:3px;"></i>State</div>
                            <div class="wl-view-field__val" id="view_State">—</div>
                            @Html.Hidden("State11")
                        </div>
                        <div class="wl-view-field">
                            <div class="wl-view-field__label"><i class="fas fa-city" style="margin-right:3px;"></i>District</div>
                            <div class="wl-view-field__val" id="view_District">—</div>
                            @Html.Hidden("District11")
                        </div>
                    </div>
                    <div class="wl-view-field" style="margin-top:6px;">
                        <div class="wl-view-field__label"><i class="fas fa-location-arrow" style="margin-right:3px;"></i>Address</div>
                        <div class="wl-view-field__val" id="view_Address">—</div>
                        @Html.Hidden("address11")
                    </div>

                    <!-- View mode footer -->
                    <div class="wl-modal-footer">
                        <ul>
                            <li class="one">
                                <button type="button" value="Edit" class="wl-mf-btn wl-mf-btn--edit"><i class="fas fa-edit"></i> Edit</button>
                            </li>
                            <li class="One2" style="display:none;">
                                <button type="button" value="SaveChange" class="wl-mf-btn wl-mf-btn--save special-iii btnssl2233" data-loading-text="<i class='fa fa-spinner fa-spin'></i>"><i class="fas fa-save"></i> Save</button>
                            </li>
                            <li class="three">
                                <button type="button" value="Email_Verify" class="wl-mf-btn wl-mf-btn--verify" onclick="EmailVerify()"><i class="fas fa-envelope-open-text"></i> Verify Email</button>
                            </li>
                            <li class="four">
                                <button type="button" value="Delet" class="wl-mf-btn wl-mf-btn--delete" onclick="Deleteuser()"><i class="fas fa-trash-alt"></i> Delete</button>
                            </li>
                        </ul>
                    </div>
                </form>

                <!-- EDIT form -->
                <div class="second-form" style="display:none;">
                    @using (Ajax.BeginForm("Edit_WhiteLabel_List", "Home", new AjaxOptions { InsertionMode = InsertionMode.Replace, HttpMethod = "POST", UpdateTargetId = "whitelabelusertable", OnSuccess = "OnSuccess", OnBegin = "chkvalidation" }))
                    {
                        @Html.Hidden("WhiteLabelID")

                        <div class="wl-modal-section-label"><i class="fas fa-user-edit" style="margin-right:5px;"></i>Basic Details</div>
                        <!-- 2-column icon+input grid -->
                        <div class="wl-edit-grid">
                            <div class="wl-edit-field">
                                <div class="wl-edit-field__icon wl-icon--blue"><i class="fas fa-user"></i></div>
                                <div class="wl-edit-field__body">
                                    <label>Name</label>
                                    @Html.TextBox("NameEdit", "", new { @class = "form-control", placeholder = "Enter Name", required = "required" })
                                </div>
                            </div>
                            <div class="wl-edit-field">
                                <div class="wl-edit-field__icon wl-icon--purple"><i class="fas fa-building"></i></div>
                                <div class="wl-edit-field__body">
                                    <label>Firm Name</label>
                                    @Html.TextBox("FirmEdit", "", new { @class = "form-control", placeholder = "Enter Firm Name", required = "required" })
                                </div>
                            </div>
                            <div class="wl-edit-field">
                                <div class="wl-edit-field__icon wl-icon--green"><i class="fas fa-map"></i></div>
                                <div class="wl-edit-field__body">
                                    <label>State</label>
                                    <select id="StateEdit" onchange="Editstatechange()" name="StateEdit" class="form-control"><option>Select State</option></select>
                                </div>
                            </div>
                            <div class="wl-edit-field">
                                <div class="wl-edit-field__icon wl-icon--orange"><i class="fas fa-city"></i></div>
                                <div class="wl-edit-field__body">
                                    <label>District</label>
                                    @Html.DropDownList("DistrictEdit", new SelectList(Enumerable.Empty<SelectListItem>(), "Dist_id", "Dist_Desc"), "Select district", new { @class = "form-control" })
                                </div>
                            </div>
                            <div class="wl-edit-field">
                                <div class="wl-edit-field__icon wl-icon--teal"><i class="fas fa-map-pin"></i></div>
                                <div class="wl-edit-field__body">
                                    <label>Pin Code</label>
                                    @Html.TextBox("PinEdit", "", new { @class = "form-control", placeholder = "Enter Pin Code", required = "required" })
                                </div>
                            </div>
                            <div class="wl-edit-field">
                                <div class="wl-edit-field__icon wl-icon--red"><i class="fas fa-percent"></i></div>
                                <div class="wl-edit-field__body">
                                    <label>Margin (Offline)</label>
                                    @Html.TextBox("offmargineEdit", "", new { @class = "form-control", placeholder = "Enter Margin", required = "required", @onkeypress = "javascript:return isNumber(event)" })
                                </div>
                            </div>
                        </div>
                        <!-- Address full-width -->
                        <div class="wl-edit-field wl-edit-field--full" style="margin-top:6px;">
                            <div class="wl-edit-field__icon wl-icon--slate"><i class="fas fa-location-arrow"></i></div>
                            <div class="wl-edit-field__body">
                                <label>Address</label>
                                @Html.TextArea("AddressEdit", "", new { @class = "form-control", placeholder = "Enter Address", required = "required", rows = "2" })
                            </div>
                        </div>

                        <div class="wl-modal-section-label"><i class="fas fa-file-shield" style="margin-right:5px;"></i>KYC Documents</div>
                        <div class="wl-doc-grid">
                            <!-- PAN -->
                            <div class="wl-doc-card">
                                <div class="wl-doc-card__head">
                                    <span class="wl-doc-card__icon wl-doc-card__icon--pan"><i class="fas fa-id-card"></i></span>
                                    <span class="wl-doc-card__title">PAN Card</span>
                                </div>
                                @Html.TextBox("pancardEdit", "", new { @class = "form-control", placeholder = "PAN No", @style = "text-transform:uppercase", maxlength = 10 })
