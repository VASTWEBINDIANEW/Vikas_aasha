@model IEnumerable<Vastwebmulti.Models.srsshowport_Result>
@{
    ViewBag.Title = "PortReport";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var portRows = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.srsshowport_Result>();
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-settings-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css?v=12" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-payment-gateway-slab-modern.css?v=10" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-prepaid-slab-modern.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-prepaid-slab-modals.css?v=2" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-prepaid-slab-mobile.css?v=6" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-hardware-modern.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-hardware-mobile.css?v=8" rel="stylesheet" />

<div id="div_Loader">
    <div class="loader_innner">
        <img src="~/offerimg/moneyload.gif" class="img-responsive" alt="Loading" />
    </div>
</div>

<section class="content saas-admin-account-page saas-admin-settings-page saas-pg-slab-page saas-prepaid-slab-page saas-hardware-page second-design">
    <div class="container-fluid">

        <div class="saas-acc-toolbar vm-hardware-toolbar-line">
            <ol class="saas-acc-breadcrumb">
                <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                <li><a href="@Url.Action("Dashboard", "Home")#setting">Basic Setting</a></li>
                <li>Port Setting</li>
            </ol>
            <div class="vm-hardware-top-actions">
                <div class="vm-hardware-port-panel" id="vmHardwarePortPanel">
                    <button type="button" class="vm-hardware-btn-new vm-hardware-btn-new--primary vm-hardware-port-add-toggle">
                        <span class="vm-hardware-btn-new__icon" aria-hidden="true"><i class="fas fa-plus"></i></span>
                        <span class="vm-hardware-btn-new__label">New Port</span>
                    </button>
                    <div class="vm-hardware-port-form">
                        <input type="text" id="txtInlinePort" class="vm-hardware-port-form__input" placeholder="Enter Port Number" autocomplete="off" />
                        <button type="button" class="vm-hardware-port-save-btn">
                            <i class="fas fa-save" aria-hidden="true"></i> Save
                        </button>
                        <button type="button" class="vm-hardware-port-cancel-btn">
                            <i class="fas fa-times" aria-hidden="true"></i> Cancel
                        </button>
                    </div>
                </div>
                <label class="saas-acc-search vm-hardware-port-search" for="vmHardwarePortSearch">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    <input type="text" id="vmHardwarePortSearch" placeholder="Search ports..." autocomplete="off" />
                </label>
            </div>
        </div>

        <div class="vm-prepaid-slab-shell">
            @Html.Partial("_menuport")

            <div class="vm-prepaid-slab-main">
                <div class="vm-pg-slab-card">
                    <div class="vm-pg-slab-card__head">
                        <h3 class="vm-pg-slab-card__title"><i class="fas fa-plug" aria-hidden="true"></i> Port Setting</h3>
                    </div>
                    <div class="vm-pg-slab-body">
                        <div class="vm-hardware-table-shell">
                            <div class="vm-pg-slab-table-scroll vm-prepaid-slab-table-wrap vm-hardware-table-wrap">
                                <table id="hardwarePortTable" class="table table-bordered table-striped table-hover vm-pg-slab-table vm-hardware-port-table">
                            <thead>
                                            <tr>
                                                <th>Port</th>
                                                <th>Port&nbsp;/&nbsp;Lapu&nbsp;Info</th>
                                                <th>Operator</th>
                                                <th>Service</th>
                                                <th class="vm-hardware-th-toggle">Outbox</th>
                                                <th class="vm-hardware-th-icon">
                                                    <span class="vm-hardware-th-icon__badge"><img src="~/AdminDesign/images/count.svg" alt="Count" /></span>
                                                    <span class="vm-hardware-th-icon__label">Count</span>
                                                </th>
                                                <th class="vm-hardware-th-toggle">Server</th>
                                                <th class="vm-hardware-th-toggle">Topup</th>
                                                <th class="vm-hardware-th-icon">
                                                    <span class="vm-hardware-th-icon__badge"><img src="~/AdminDesign/images/no-network.svg" alt="Signal" /></span>
                                                    <span class="vm-hardware-th-icon__label">Signal</span>
                                                </th>
                                                <th>Edit</th>
                                                <th>DEL</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (portRows.Any())
                                            {
                                            foreach (var item in portRows)
                                            {
                                                var signal = item.Signal;
                                                if (signal != null)
                                                {
                                                    signal = signal.Replace("+CSQ:", "");
                                                    signal = signal.Replace("\r\n\r\n\r\n^SYSSTART", "");
                                                    signal = signal.Replace(",0", "");
                                                    signal = signal.Replace(",99", "");
                                                }
                                                <tr>
                                                    <td>@item.PortNo</td>
                                                    <td><input type="text" value="@item.PortNm" readonly /></td>
                                                    <td>@item.Operator</td>
                                                    <td><input type="text" value="@item.Sname" readonly /></td>
                                                    <td>
                                                        <div class="onoffswitch">
                                                            @if (item.WritePort == "False")
                                                            {

                                                                <center>
                                                                    <a href="@Url.Action("portedit",new {port = item.PortNo, type = "write", sts = item.WritePort})" style="text-decoration:none;">
                                                                        <span class="custom-off">off</span>
                                                                    </a>
                                                                </center>


                                                            }
                                                            else
                                                            {
                                                                <center>
                                                                    <a href="@Url.Action("portedit",new {port = item.PortNo, type = "write", sts = item.WritePort})" style="text-decoration:none;">
                                                                        <span class="costom-on">on</span>
                                                                    </a>
                                                                </center>


                                                            }
                                                        </div>
                                                    </td>
                                                    <td> @item.count1 </td>
                                                    @*<td style="padding:2px;">
                                                        @Html.DisplayFor(modelItem => item.Phone)
                                                    </td>*@
                                                    <td>
                                                        <div class="onoffswitch">
                                                            @if (item.ReadPort == "False")
                                                            {
                                                                <center>
                                                                    <a href="@Url.Action("portedit",new { port = item.PortNo,type="read",sts=item.ReadPort })" style="text-decoration:none;">
                                                                        <span class="custom-off">off</span>
                                                                    </a>
                                                                </center>
                                                            }
                                                            else
                                                            {
                                                                <center>
                                                                    <a href="@Url.Action("portedit",new { port = item.PortNo,type="read",sts=item.ReadPort })" style="text-decoration:none;">
                                                                        <span class="costom-on">on</span>
                                                                    </a>
                                                                </center>


                                                            }
                                                        </div>
                                                    </td>







                                                    <td>
                                                        <div class="onoffswitch">
                                                            @if (item.Active == "False")
                                                            {
                                                                <center>
                                                                    <a href="@Url.Action("portedit",new {port = item.PortNo, type = "active", sts = item.Active })" style="text-decoration:none;">
                                                                        <span class="custom-off">off</span>
                                                                    </a>
                                                                </center>


                                                            }
                                                            else
                                                            {
                                                                <center>
                                                                    <a href="@Url.Action("portedit",new {port = item.PortNo, type = "active", sts = item.Active })" style="text-decoration:none;">
                                                                        <span class="costom-on">on</span>
                                                                    </a>
                                                                </center>


                                                            }
                                                        </div>
                                                    </td>


                                                    <td>
                                                        <center>
                                                            @if (item.Sname.Contains("DOCOMO") || item.Sname.Contains("BSNL") || item.Sname.Contains("TNOR") || item.Sname.Contains("IDEA"))
                                                            {
                                                                <button style="background-color:transparent; color:transparent; border-color:transparent;" onclick="login('@item.PortNo')">  <i class="icofont icofont-login" style="color:green;font-size:22px;"></i>  </button>
                                                            }
                                                            else if (item.PortNo.Contains("COM"))
                                                            {
                                                                if (item.Signal == "" || item.Signal == null)
                                                                {
                                                                    <a href="@Url.Action("checksignal", new { port = item.PortNo, type = "Signal" })"><i class="fa fa-signal fa-2x" style="color:red; "></i></a>
                                                                }
                                                                else
                                                                {
                                                                    int sig = Convert.ToInt32(signal);
                                                                    if (sig <= 10)
                                                                    {
                                                                        <a href="@Url.Action("checksignal", new { port = item.PortNo, type = "Signal" })"><img src="~/AdminDesign/images/no-network.svg" style="width:22px;"></a>
                                                                    }
                                                                    else if (10 < sig && sig <= 15)
                                                                    {
                                                                        <a href="@Url.Action("checksignal", new { port = item.PortNo, type = "Signal" })"><img src="~/AdminDesign/images/poor-network.svg" style="width:22px;"></a>
                                                                    }
                                                                    else if (15 < sig && sig <= 20)
                                                                    {
                                                                        <a href="@Url.Action("checksignal", new { port = item.PortNo, type = "Signal" })"><img src="~/AdminDesign/images/weak-network.svg" style="width:22px;"></a>
                                                                    }
                                                                    else if (20 < sig && sig <= 25)
                                                                    {
                                                                        <a href="@Url.Action("checksignal", new { port = item.PortNo, type = "Signal" })"><img src="~/AdminDesign/images/avg-network.svg" style="width:22px;"></a>
                                                                    }
                                                                    else if (25 < sig && sig <= 31)
                                                                    {
                                                                        <a href="@Url.Action("checksignal", new { port = item.PortNo, type = "Signal" })"><img src="~/AdminDesign/images/strong-network.svg" style="width:22px;"></a>
                                                                    }
                                                                }
                                                            }
                                                        </center>
                                                    </td>

                                                    <td>
                                                        <button type="button" class="hardware-right-edit vm-hardware-edit-btn"
                                                                onclick="animation('@item.PortNo','@item.PortNm','@item.Phone','@item.minsms','@item.Sname','@item.machinename','@item.lapuno','@item.idno')">
                                                            Edit
                                                        </button>
                                                        <button type="button" class="hardware-right-save vm-hardware-edit-btn">
                                                            Save
                                                        </button>
                                                    </td>
                                                    <td>
                                                        <button type="button" class="vm-hardware-del-btn click-to-sure" aria-label="Delete">
                                                            <img src="~/MainFrontDesign/images/delete.svg" alt="" />
                                                        </button>
                                                        <button type="button" class="vm-hardware-sure-btn" onclick="Deleteport('@item.PortNo')">
                                                            Sure?
                                                        </button>
                                                    </td>
                                                </tr>
                                            }
                                            }
                                            else
                                            {
                                                <tr class="vm-hardware-table-empty">
                                                    <td colspan="11">No data available in table</td>
                                                </tr>
                                            }

                                        </tbody>
                                    </table>
                            </div>
                            <div id="vmHardwareTableFooter" class="vm-hardware-table-footer">
                                <span id="vmHardwareTableInfo">Showing 0 to 0 of 0 entries</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
