<script>
    (function () {
        var $panel = $('#vmHardwarePortPanel');

        $panel.find('.vm-hardware-port-add-toggle').on('click', function () {
            $panel.addClass('is-editing');
            $('#txtInlinePort').val('').focus();
        });

        $panel.find('.vm-hardware-port-cancel-btn').on('click', function () {
            $panel.removeClass('is-editing');
            $('#txtInlinePort').val('');
        });

        $panel.find('.vm-hardware-port-save-btn').on('click', function () {
            var portNo = $.trim($('#txtInlinePort').val());
            if (!portNo) {
                if (typeof swal === 'function') {
                    swal('Oops...', 'Please enter port number.', 'error');
                } else {
                    alert('Please enter port number.');
                }
                return;
            }
            $('#txtportno').val(portNo);
            $('#frmAddPort').submit();
        });

        $('#txtInlinePort').on('keydown', function (e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                $panel.find('.vm-hardware-port-save-btn').trigger('click');
            }
            if (e.key === 'Escape') {
                $panel.find('.vm-hardware-port-cancel-btn').trigger('click');
            }
        });
    })();
</script>


