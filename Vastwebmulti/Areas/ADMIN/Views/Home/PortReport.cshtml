<script>
    function vmHardwareUpdatePortTableInfo() {
        var $rows = $('#hardwarePortTable tbody tr:not(.vm-hardware-table-empty)');
        var $visible = $rows.filter(':visible');
        var total = $rows.length;
        var vis = $visible.length;
        var $info = $('#vmHardwareTableInfo');

        if (total === 0) {
            $info.text('Showing 0 to 0 of 0 entries');
        } else if (vis === 0) {
            $info.text('Showing 0 to 0 of ' + total + ' entries');
        } else {
            $info.text('Showing 1 to ' + vis + ' of ' + total + ' entries');
        }
    }

    $(document).ready(function () {
        $('#vmHardwarePortSearch').on('input', function () {
            var q = $.trim($(this).val()).toLowerCase();
            $('#hardwarePortTable tbody tr:not(.vm-hardware-table-empty)').each(function () {
                var match = !q || $(this).text().toLowerCase().indexOf(q) !== -1;
                $(this).toggle(match);
            });
            vmHardwareUpdatePortTableInfo();
        });

        vmHardwareUpdatePortTableInfo();
    });
</script>