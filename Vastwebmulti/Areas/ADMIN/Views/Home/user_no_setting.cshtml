@using Vastwebmulti.Models
@model IEnumerable<Vastwebmulti.Models.User_number_status>
@using System.Linq
@using System.Collections.Generic
@{
    VastwebmultiEntities db = new VastwebmultiEntities();
    ViewBag.Title = "User Mobile No. Status";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var rows = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.User_number_status>();
    var retailers = db.Retailer_Details.ToDictionary(r => r.RetailerId, r => r.Frm_Name ?? "—");
    var retailerList = db.Retailer_Details.OrderBy(r => r.Frm_Name).ToList();
    var onCount = rows.Count(r => r.NumberStatus == true);
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-settings-page-modern.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-settings-page" id="user-no-setting-page"
         data-otp-url="@Url.Action("otpsentforsts11", "Home")"
         data-save-url="@Url.Action("usernumbersts", "Home")">
    <div class="container-fluid">

        
        <div class="saas-acc-toolbar">
            <ol class="saas-acc-breadcrumb">
                <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                <li><a href="@Url.Action("More_Option", "Home")">More Options</a></li>
                <li>User Mobile No. Status</li>
            </ol>
        </div>

        @using (Html.BeginForm("user_no_setting", "Home", FormMethod.Post))
        {
            <div class="saas-set-filter-bar">
                <label class="saas-mo-label" for="filterRetailer" style="margin:0;">Filter retailer</label>
                <select name="ids" id="filterRetailer" class="form-control">
                    <option value="">All retailers</option>
                    @foreach (var r in retailerList)
                    {
                        <option value="@r.RetailerId">@r.Frm_Name</option>
                    }
                </select>
                <button type="submit" class="saas-set-btn-primary"><i class="fa fa-search" aria-hidden="true"></i> Search</button>
            </div>
        }

        <div class="saas-acc-table-card">
            <div class="saas-acc-table-card-head">
                <h3>Mobile number visibility</h3>
                <span class="saas-acc-row-count"><i class="fas fa-list" aria-hidden="true"></i> @rows.Count records</span>
            </div>
            <div class="saas-acc-table-wrap table-responsive">
                <table class="table saas-acc-table table-bordered">
                    <thead>
                        <tr>
                            <th>Retailer</th>
                            <th>Number Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var rowIndex = 0; }
                        @foreach (var i in rows)
                        {
                            var name = retailers.ContainsKey(i.Userid) ? retailers[i.Userid] : "—";
                            <tr>
                                <td data-label="Retailer">@name</td>
                                <td class="num-status-cell" data-row-index="@rowIndex">
                                    @if (i.NumberStatus == true)
                                    {
                                        <button type="button" class="saas-set-pill saas-set-pill--on user-no-toggle" data-userid="@i.Userid" data-row-index="@rowIndex" data-sts="false">ON</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="saas-set-pill saas-set-pill--off user-no-toggle" data-userid="@i.Userid" data-row-index="@rowIndex" data-sts="true">OFF</button>
                                    }
                                </td>
                            </tr>
                            rowIndex++;
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</section>

<div class="modal saas-set-otp-modal saas-admin-modal saas-settings-otp-modal" id="userNoOtpModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Enter OTP</h5>
                <button type="button" class="close saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="saas-set-otp-msg" id="tstsmessage">OTP sent successfully.</div>
            <div class="modal-body">
                <input type="text" id="tops" placeholder="Enter OTP (3–4 digits)" maxlength="4" inputmode="numeric" autocomplete="one-time-code" />
            </div>
            <div class="modal-footer" id="chkdss">
                <button type="button" class="saas-set-btn-primary" id="userNoSaveBtn">Save changes</button>
            </div>
        </div>
    </div>
</div>
