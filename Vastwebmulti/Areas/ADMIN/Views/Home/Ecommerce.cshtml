<script>
    $(document).ready(function () {
        $('#txtsearch').on('keyup', function () {
            var val = $(this).val().toLowerCase();
            $('.vm-ecom-table-wrap .vm-ecom-table > tbody > tr').each(function () {
                var rowText = $(this).text().toLowerCase();
                $(this).toggle(rowText.indexOf(val) > -1);
            });
        });
    });

    function toggleEcomModalStatus(el) {
        var $el = $(el);
        if ($el.hasClass('costom-on')) {
            $el.removeClass('costom-on').addClass('custom-off').text('Off');
        } else {
            $el.removeClass('custom-off').addClass('costom-on').text('On');
        }
    }

    $(document).on('keydown', '#ecomModalStatusToggle', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            toggleEcomModalStatus(this);
        }
    });

    // Reset the demo toggle back to "On" each time the modal is reopened.
    $('#defaultModal1').on('show.bs.modal', function () {
        $('#ecomModalStatusToggle').removeClass('custom-off').addClass('costom-on').text('On');
    });
</script>
