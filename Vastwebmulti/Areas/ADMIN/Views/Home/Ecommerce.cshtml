<style>
    /* Inline safety net for the seller/product detail modal — kept in
       the view itself (never edge/browser-cached like a static .css
       file) with #id specificity so this always wins even if
       admin-ecommerce-modern.css is ever served stale. */
    #defaultModal1 .modal-dialog {
        max-width: 640px;
    }
    #defaultModal1 .modal-body {
        max-height: 78vh !important;
        overflow-y: auto !important;
        padding: 0 !important;
        background: #fff !important;
    }
    #defaultModal1 .vm-ecom-modal-avatar-row {
        background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 52%, #4f46e5 100%) !important;
        padding: 22px 20px !important;
        display: flex !important;
        align-items: center !important;
        gap: 16px !important;
    }
    #defaultModal1 .thisLeft {
        float: none !important;
        display: inline-block !important;
    }
    #defaultModal1 .thisLeft img {
        border: 3px solid rgba(255, 255, 255, 0.6) !important;
        box-shadow: 0 6px 16px rgba(15, 23, 42, 0.25) !important;
    }
    #defaultModal1 .vm-ecom-modal-avatar-meta {
        display: flex !important;
        flex-direction: column !important;
        gap: 6px !important;
    }
    #defaultModal1 .vm-ecom-modal-avatar-meta__label {
        color: rgba(255, 255, 255, 0.75) !important;
        font-size: 0.7rem !important;
        font-weight: 700 !important;
        text-transform: uppercase !important;
        letter-spacing: 0.04em !important;
    }
    #defaultModal1 .vm-ecom-onoff.onoffswitch {
        width: auto !important;
        border: none !important;
        overflow: visible !important;
    }
    #defaultModal1 .costom-on,
    #defaultModal1 .custom-off {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        float: none !important;
        min-width: 56px !important;
        min-height: 26px !important;
        padding: 0 14px !important;
        border-radius: 999px !important;
        font-size: 0.7rem !important;
        font-weight: 800 !important;
        text-transform: uppercase !important;
        letter-spacing: 0.03em !important;
        cursor: pointer !important;
        user-select: none !important;
        transition: filter 0.15s ease, transform 0.15s ease !important;
    }
    #defaultModal1 .costom-on {
        background: linear-gradient(135deg, #4ade80, #22c55e) !important;
        color: #06301a !important;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18) !important;
    }
    #defaultModal1 .custom-off {
        background: linear-gradient(135deg, #f87171, #dc2626) !important;
        color: #2d0808 !important;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.18) !important;
    }
    #defaultModal1 .costom-on:hover,
    #defaultModal1 .custom-off:hover {
        filter: brightness(1.08) !important;
        transform: translateY(-1px) !important;
    }
    #defaultModal1 .costom-on:focus,
    #defaultModal1 .custom-off:focus {
        outline: 2px solid rgba(255, 255, 255, 0.85) !important;
        outline-offset: 2px !important;
    }
    #defaultModal1 .vm-ecom-modal-form {
        padding: 18px 20px 4px !important;
        display: block !important;
    }
    #defaultModal1 .vm-ecom-modal-row {
        display: flex !important;
        flex-wrap: wrap !important;
        gap: 12px !important;
        width: 100% !important;
        margin: 0 !important;
    }
    #defaultModal1 .vm-ecom-modal-row > .vm-ecom-modal-col {
        flex: 1 1 calc(50% - 6px) !important;
        max-width: calc(50% - 6px) !important;
        min-width: 0 !important;
        width: auto !important;
        float: none !important;
        padding: 0 !important;
    }
    #defaultModal1 .vm-ecom-modal-tile {
        background: #f8fafc !important;
        border: 1px solid #eef2f6 !important;
        border-radius: 10px !important;
        padding: 10px 12px !important;
        margin-bottom: 12px !important;
    }
    #defaultModal1 .form-group label {
        display: flex !important;
        align-items: center !important;
        gap: 6px !important;
        font-size: 0.68rem !important;
        font-weight: 700 !important;
        text-transform: uppercase !important;
        letter-spacing: 0.02em !important;
        color: #64748b !important;
        margin-bottom: 4px !important;
    }
    #defaultModal1 .form-group label i {
        color: #94a3b8 !important;
        font-size: 0.72rem !important;
    }
    #defaultModal1 .form-control {
        height: auto !important;
        padding: 0 !important;
        border: none !important;
        border-radius: 0 !important;
        background: transparent !important;
        color: #1e293b !important;
        font-weight: 700 !important;
        font-size: 0.92rem !important;
        box-shadow: none !important;
    }
    #defaultModal1 .vm-ecom-modal-section-title {
        display: flex !important;
        align-items: center !important;
        gap: 8px !important;
        margin: 4px 0 12px !important;
        font-size: 0.78rem !important;
        font-weight: 800 !important;
        color: #1e3a8a !important;
        text-transform: uppercase !important;
        letter-spacing: 0.02em !important;
        padding-top: 14px !important;
        border-top: 1px dashed #e2e8f0 !important;
    }
    #defaultModal1 .vm-ecom-modal-section-title i {
        color: #2563eb !important;
    }
    #defaultModal1 .modal-footer {
        padding: 14px 20px 18px !important;
        margin: 0 !important;
        border-top: none !important;
    }
    /* Product table header — inline safety net (same reasoning as the
       modal rules above): .table-bordered draws a border around every
       header cell, giving a boxy vertical-grid-line look, so those
       side borders are stripped here with #id specificity to guarantee
       they're gone regardless of the external stylesheet's cache state. */
    #ecomProductTable > thead > tr > th {
        background: linear-gradient(180deg, #f8fafc 0%, #eef2f7 100%) !important;
        color: #1e3a8a !important;
        font-weight: 800 !important;
        font-size: 0.72rem !important;
        text-transform: uppercase !important;
        letter-spacing: 0.04em !important;
        border-top: 0 !important;
        border-left: 0 !important;
        border-right: 0 !important;
        border-bottom: 2px solid #dbe3ee !important;
        position: sticky !important;
        top: 0 !important;
        z-index: 2 !important;
        white-space: nowrap !important;
        padding: 11px 14px !important;
    }
    #ecomProductTable > thead > tr > th:first-child {
        border-top-left-radius: 10px !important;
    }
    #ecomProductTable > thead > tr > th:last-child {
        border-top-right-radius: 10px !important;
    }
    @@media (max-width: 480px) {
        #defaultModal1 .modal-dialog {
            max-width: calc(100% - 20px);
            margin: 10px auto;
        }
        #defaultModal1 .vm-ecom-modal-avatar-row {
            flex-direction: column !important;
            text-align: center !important;
        }
        #defaultModal1 .vm-ecom-modal-avatar-meta {
            align-items: center !important;
        }
        #defaultModal1 .vm-ecom-modal-row > .vm-ecom-modal-col {
            flex: 1 1 100% !important;
            max-width: 100% !important;
        }
        #defaultModal1 .vm-ecom-modal-row > .vm-ecom-modal-col:empty {
            display: none !important;
        }
    }
</style>

