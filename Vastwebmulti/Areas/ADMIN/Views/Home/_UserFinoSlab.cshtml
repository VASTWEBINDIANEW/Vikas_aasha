<!-- The Modal -->
<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">

        <div class="modal-content commision-model">
            <div class="modal-header">
                <h5  class="modal-title" id="exampleModalLabel"><span id="txtvalheader"></span></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>1. All The Commision is Handal using Master And Distrubor. </p>
                <p>2. Retailer And Distritutor not Allow by Admin. </p>
            </div>
            <div class="modal-footer">
                @using (Ajax.BeginForm("_UserFinoSlab_master", "Home", new AjaxOptions { HttpMethod = "POST", OnSuccess = "OnSuccess1M", OnFailure = "onfailed1M", UpdateTargetId = "divEditFormComm", LoadingElementId = "div_Loader", InsertionMode = InsertionMode.Replace }))
                {
                    @Html.Hidden("txtmaster")
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-primary fullbodydycolorbg">Save changes</button>
                }
                </div>
        </div>
    </div>
</div>

<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<script src="~/MainFrontDesign/select2/dist/js/select2.full.min.js"></script>
<script>
    checkcomm = (e) => {
        var userid = $('#ddlUserId').val();
        if (userid != "") {
            $('#txtvalheader').text("Status " + e);
            $('#txtmaster').val(userid)
            $('#exampleModal').modal()
        }
    }
</script>
<script>
        function OnSuccess1(data) {
            $('#btnsubmituser, #btnsubmitusercommon, #btnsubmitusercommondlmrem').hide().removeClass('is-visible');
            $('#btnEdit').show().removeClass('is-hidden');
            if (typeof resetSlabViewMode === 'function') {
                resetSlabViewMode();
            }
            var chk = '@Model.role';
            if (chk === "Retailer") {
                if (typeof showRetailerDrop === 'function') {
                    showRetailerDrop();
                } else {
                    $('#retailerdrop').show();
                    $('#allshow').hide();
                }
            } else {
                if (typeof showAllUsersDrop === 'function') {
                    showAllUsersDrop();
                } else {
                    $('#retailerdrop').hide();
                    $('#allshow').show();
                }
            }
        }
        function onfailed(error) {
            alert(error.responseText);
        }
</script>
<script>
        function OnSuccess1M(data) {
            $('#btnsubmituser, #btnsubmitusercommon, #btnsubmitusercommondlmrem').hide().removeClass('is-visible');
            $('#btnEdit').show().removeClass('is-hidden');
            $('.modal-backdrop.in').hide();
            if (typeof resetSlabViewMode === 'function') {
                resetSlabViewMode();
            }
            var chk = '@Model.role';
            if (chk === "Retailer") {
                if (typeof showRetailerDrop === 'function') {
                    showRetailerDrop();
                } else {
                    $('#retailerdrop').show();
                    $('#allshow').hide();
                }
            } else {
                if (typeof showAllUsersDrop === 'function') {
                    showAllUsersDrop();
                } else {
                    $('#retailerdrop').hide();
                    $('#allshow').show();
                }
            }
        }
</script>