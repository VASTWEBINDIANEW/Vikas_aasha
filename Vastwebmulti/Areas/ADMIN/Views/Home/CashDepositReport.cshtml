<div class="modal fade saas-admin-modal vm-dmt-modal vm-cashdeposit-refund-modal" id="cashDepositRefundModal" tabindex="-1" role="dialog">

    <div class="modal-dialog" role="document">

        <div class="modal-content">

            <div class="modal-header saas-admin-modal-header accent-danger">

                <div class="saas-admin-modal-head-main">

                    <div class="saas-admin-modal-icon"><i class="fas fa-times-circle" aria-hidden="true"></i></div>

                    <div>

                        <h4 class="modal-title saas-admin-modal-title">Confirm failed / refund</h4>

                        <p class="saas-admin-modal-sub">Pending cash deposit transaction</p>

                    </div>

                </div>

                <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>

            </div>

            <div class="modal-body vm-dmt-modal-body">

                @Html.TextBox("txtrefidno", "", new { style = "display:none;" })

                <div class="vm-cashdeposit-refund-meta">

                    <span>Status: <strong id="StatusTitle"></strong></span>

                    <span><strong id="BenTitle"></strong></span>

                    <span><strong id="NetAmtTitle"></strong></span>

                </div>

                <div class="vm-dmt-modal-grid vm-dmt-modal-grid--2">

                    <div class="vm-dmt-modal-field">

                        <label for="ddl_refund">Failed reason</label>

                        @Html.DropDownList("ddl_refund", new List<SelectListItem>

                        {

                            new SelectListItem{ Text="Manual Failed", Value="Manual FAILED"},

                            new SelectListItem{ Text="Bank Server Down", Value="Bank Server Down"},

                            new SelectListItem{ Text="Failed Due To Invalid Choice", Value="Failed Due To Invalid Choice"},

                            new SelectListItem{ Text="Network Down", Value="Network Down"},

                            new SelectListItem{ Text="Unsupported Network", Value="Unsupported Network"},

                            new SelectListItem{ Text="Network issue", Value="Network issue"},

                            new SelectListItem{ Text="Insufficient Fund", Value="Insufficient Fund"}

                        }, new { @class = "form-control vm-dmt-modal-select" })

                    </div>

                    <div class="vm-dmt-modal-field">

                        <label for="securitypass">Security password</label>

                        <input type="password" autocomplete="off" id="securitypass" name="securitypass" class="form-control vm-dmt-modal-input" />

                    </div>

                </div>

            </div>

            <div class="modal-footer saas-admin-modal-footer">

                <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal"><i class="fas fa-times" aria-hidden="true"></i> Close</button>

                <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--danger" onclick="cashDepositFailed()"><i class="fas fa-times" aria-hidden="true"></i> Confirm &amp; Refund</button>

            </div>

        </div>

    </div>

</div>



<div class="modal fade saas-admin-modal vm-dmt-modal vm-cashdeposit-success-modal" id="cashDepositSuccessModal" tabindex="-1" role="dialog">

    <div class="modal-dialog" role="document">

        <div class="modal-content">

            <div class="modal-header saas-admin-modal-header accent-emerald">

                <div class="saas-admin-modal-head-main">

                    <div class="saas-admin-modal-icon"><i class="fas fa-check-circle" aria-hidden="true"></i></div>

                    <div>

                        <h4 class="modal-title saas-admin-modal-title">Mark transaction success</h4>

                        <p class="saas-admin-modal-sub">Pending cash deposit confirmation</p>

                    </div>

                </div>

                <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>

            </div>

            <div class="modal-body vm-dmt-modal-body">

                <input type="hidden" id="hdCashDepositId" name="hdCashDepositId" />

                <div class="vm-dmt-modal-grid vm-dmt-modal-grid--2">

                    <div class="vm-dmt-modal-field">

                        <label for="txtCashDepositBnkRrn">Bank RRN</label>

                        <input type="text" id="txtCashDepositBnkRrn" name="txtCashDepositBnkRrn" class="form-control vm-dmt-modal-input" autocomplete="off" />

                    </div>

                    <div class="vm-dmt-modal-field">

                        <label>&nbsp;</label>

                        <p class="vm-dmt-modal-hint" style="margin:8px 0 0;font-size:0.8rem;color:#64748b;">Enter bank RRN to confirm manual success.</p>

                    </div>

                </div>

            </div>

            <div class="modal-footer saas-admin-modal-footer">

                <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal"><i class="fas fa-times" aria-hidden="true"></i> Close</button>

                <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--success" onclick="cashDepositConfirmSuccess()"><i class="fas fa-check" aria-hidden="true"></i> Confirm</button>

            </div>

        </div>

    </div>

</div>



<script src="~/MainFrontDesign/select2/dist/js/select2.full.min.js"></script>

<script src="~/Swalalert/sweetalert-dev.js"></script>

<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />



<script>

    window.cashDepositTotalsUrl = '@Url.Action("FindcashdepositTotal", "Home")';



    function cashDepositSuccessShow(idno) {

        $('#hdCashDepositId').val(idno);

        $('#txtCashDepositBnkRrn').val('');

        $('#cashDepositSuccessModal').modal('show');

    }



    function cashDepositConfirmSuccess() {

        var idno = $('#hdCashDepositId').val();

        var bnkrrn = ($('#txtCashDepositBnkRrn').val() || '').trim();

        if (!idno || !bnkrrn) {

            alert('Please enter Bank RRN');

            return;

        }

        $.ajax({

            url: '@Url.Action("successcashdeposit", "Home")',

            type: 'POST',

            dataType: 'html',

            data: { idno: idno, bnkrrn: bnkrrn },

            success: function () {

                $('#cashDepositSuccessModal').modal('hide');

                window.location.reload();

            }

        });

    }



    function cashDepositRefundShow(idno) {

        $('#txtrefidno').val(idno);

        $('#securitypass').val('');

        cashDepositRefundTitle(idno);

        $('#cashDepositRefundModal').modal('show');

    }



    function cashDepositRefundTitle(idno) {

        $.ajax({

            url: '@Url.Action("cashdeposit_view", "Home")',

            type: 'POST',

            data: { Idno: idno },

            cache: false,

            success: function (response) {

                if (response && response.length) {

                    $('#StatusTitle').text(response[0].status);

                    $('#BenTitle').text('A/C ' + response[0].accountno);

                    $('#NetAmtTitle').text('Rs ' + response[0].amount);

                }

            }

        });

    }



    function cashDepositFailed() {

        var secuirtypass = $('#securitypass').val();

        var id = $('#txtrefidno').val();

        var ddlval = $('#ddl_refund').val();

        if (!secuirtypass) {

            return;

        }

        $.ajax({

            url: '@Url.Action("Failedcashdeposit", "Home")',

            type: 'POST',

            dataType: 'html',

            data: { txtrefidno: id, ddl_refund: ddlval, secuirtypass: secuirtypass },

            success: function (data) {

                var response = JSON.parse(data);

                if (response.Status) {

                    window.location.reload();

                } else {

                    alert(response.Message);

                }

            },

            complete: function () {

                $('#cashDepositRefundModal').modal('hide');

            }

        });

    }



    function cashDepositDetail(idno) {

        $('#cashDepositDetailModal').modal('show');

        $('#loadredmodel').show();

        $.ajax({

            url: '@Url.Action("cashdeposit_view", "Home")',

            type: 'POST',

            data: { Idno: idno },

            cache: false,

            success: function (response) {

                if (response && response.length) {

                    $('#Idno').val(response[0].idno);

                    $('#ReqID').val(response[0].reqid);

                    $('#lblCashDepositReqId').text(response[0].reqid || '');

                    $('#masterremainpre').val(response[0].md_pre);

                    $('#mastercomm').val(response[0].md_comm);

                    $('#mastergst').val(response[0].md_gst);

                    $('#mastertds').val(response[0].md_tds);

                    $('#MasterPost').val(response[0].md_post);

                    $('#DealerPre').val(response[0].dlm_pre);

                    $('#Dealercomm').val(response[0].dlm_comm);

                    $('#Dealergst').val(response[0].dlm_gst);

                    $('#Dealertds').val(response[0].dlm_tds);

                    $('#DealerPost').val(response[0].dlm_post);

                }

            },

            complete: function () {

                $('#loadredmodel').hide();

            }

        });

    }



    function buildCashDepositExportQuery() {

        return 'txt_frm_date=' + encodeURIComponent($('#txt_frm_date').val())

            + '&txt_to_date=' + encodeURIComponent($('#txt_to_date').val())

            + '&ddlusers=' + encodeURIComponent($('#ddlusers').val() || '')

            + '&ddl_status=' + encodeURIComponent($('#ddl_status').val() || '')

            + '&allmaster1=' + encodeURIComponent($('#allmaster1').val() || '')

            + '&alldealer=' + encodeURIComponent($('#alldealer').val() || '')

            + '&allretailer=' + encodeURIComponent($('#allretailer').val() || '');

    }



    $('#btnExport').click(function () {

        location.href = '@Url.Action("ExcelCashReport", "Home")?' + buildCashDepositExportQuery();

    });



    $('#btnPDF').click(function () {

        window.open('@Url.Action("PDFCashDepositReport", "Home")?' + buildCashDepositExportQuery(), '_blank');

    });



    $(document).ready(function () {

        $('#txt_frm_date, #txt_to_date').datepicker({

            format: 'yyyy-mm-dd',

            todayHighlight: true,

            autoclose: true,

            orientation: 'bottom auto'

        });

        var val = '@ViewBag.chk';

        if (val != 'post') {

            $('#txt_frm_date').datepicker('setDate', new Date());

            $('#txt_to_date').datepicker('setDate', new Date());

        }

    });

</script>

