<script src="~/MainFrontDesign/js/admin-cashdeposit-report.js?v=1"></script>



<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-cashdeposit-report-page">

    <div class="container-fluid vm-opr-page-shell">



        @using (Html.BeginForm("CashDepositReport", "Home", FormMethod.Post, new { id = "cashDepositReportForm", @class = "vm-rpt-filters-panel__form" }))

        {

            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb">

                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>

                        <li>Financial Services</li>

                        <li>Cash Deposit Report</li>

                    </ol>

                    <div class="vm-dmt-fin-nav-row">

                        @Html.Partial("_finicalmenureport")

                    </div>

                </div>



                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="cashDepositTotalsPanel" style="display:none;" aria-hidden="true">

