                            @Html.TextBox("mastercomm", "", new { @class = "form-control vm-dmt-modal-input", @readonly = "readonly" })

                        </div>

                        <div class="vm-dmt-modal-field">

                            <label for="mastergst">Master GST</label>

                            @Html.TextBox("mastergst", "", new { @class = "form-control vm-dmt-modal-input", @readonly = "readonly" })

                        </div>

                        <div class="vm-dmt-modal-field">

                            <label for="mastertds">Master TDS</label>

                            @Html.TextBox("mastertds", "", new { @class = "form-control vm-dmt-modal-input", @readonly = "readonly" })

                        </div>

                        <div class="vm-dmt-modal-field">

                            <label for="MasterPost">Master post</label>

                            @Html.TextBox("MasterPost", "", new { @class = "form-control vm-dmt-modal-input", @readonly = "readonly" })

                        </div>

                        <div class="vm-dmt-modal-field">

                            <label for="DealerPre">Distributor pre</label>

                            @Html.TextBox("DealerPre", "", new { @class = "form-control vm-dmt-modal-input", @readonly = "readonly" })

                        </div>

                        <div class="vm-dmt-modal-field">

                            <label for="Dealercomm">Distributor comm</label>

                            @Html.TextBox("Dealercomm", "", new { @class = "form-control vm-dmt-modal-input", @readonly = "readonly" })

                        </div>

                        <div class="vm-dmt-modal-field">

                            <label for="Dealergst">Distributor GST</label>

                            @Html.TextBox("Dealergst", "", new { @class = "form-control vm-dmt-modal-input", @readonly = "readonly" })

                        </div>

                        <div class="vm-dmt-modal-field">

                            <label for="Dealertds">Distributor TDS</label>

                            @Html.TextBox("Dealertds", "", new { @class = "form-control vm-dmt-modal-input", @readonly = "readonly" })

                        </div>

