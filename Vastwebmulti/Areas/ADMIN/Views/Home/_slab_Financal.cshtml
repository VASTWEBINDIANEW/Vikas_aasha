<script>
    $(document).ready(function () {
        var current = (location.pathname || '').toLowerCase().replace(/\/+$/, '');
        var $best = null;
        var bestLen = -1;
        $('#vmFinSlabNav li a').each(function () {
            var $this = $(this);
            $this.removeClass('is-active activee');
            var href = ($this.attr('href') || '').toLowerCase().split('?')[0].replace(/\/+$/, '');
            if (!href) { return; }
            // Match full action path; prefer longest match so AepsSlab != AepsSlabUPI
            if (current === href || current.indexOf(href) !== -1) {
                if (href.length > bestLen) {
                    bestLen = href.length;
                    $best = $this;
                }
            }
        });
        if ($best) {
            $best.addClass('is-active activee');
        }
    });
</script>
