@model Vastwebmulti.Areas.ADMIN.Models.Purchase_Account
<table class="table vm-ml-data-table">
        <thead>
            <tr>
                <th>API Name</th>
                <th>Payee Name</th>
                <th>Bank Name</th>
                <th>Account Number</th>
                <th>IFSC Code</th>
                <th>Comment</th>
                <th>Status</th>
                <th>Del</th>
            </tr>
        </thead>
        <tbody>
            @{ var hasBankRows = false; }
            @if (Model.infoaccount != null)
            {
                foreach (var item in Model.infoaccount)
                {
                    hasBankRows = true;
                    <tr>
                        <td>@item.APINAME</td>
                        <td>@item.Payeename</td>
                        <td>@item.bankname</td>
                        <td>@item.AccountNo</td>
                        <td>@item.Ifsccode</td>
                        <td>@item.Comment</td>
                        <td class="ap-col-action">
                            @if (item.Status == "Y")
                            {
                                <button type="button" class="ap-io-switch ap-io-switch--on" data-action="bank-status" data-apinm="@item.APINAME" title="Active — click to deactivate" aria-label="Deactivate bank account">
                                    <span class="ap-io-switch__track"><span class="ap-io-switch__thumb"></span></span>
                                    <span class="ap-io-switch__text">On</span>
                                </button>
                            }
                            else
                            {
                                <button type="button" class="ap-io-switch ap-io-switch--off" data-action="bank-status" data-apinm="@item.APINAME" title="Inactive — click to activate" aria-label="Activate bank account">
                                    <span class="ap-io-switch__track"><span class="ap-io-switch__thumb"></span></span>
                                    <span class="ap-io-switch__text">Off</span>
                                </button>
                            }
                        </td>
                        <td class="ap-col-action">
                            <button type="button" class="ap-icon-del" data-action="bank-delete" data-apinm="@item.APINAME" title="Delete bank account" aria-label="Delete bank account">
                                <i class="fas fa-trash-alt" aria-hidden="true"></i>
                            </button>
                        </td>
                    </tr>
                }
            }
            @if (!hasBankRows)
            {
                <tr class="ap-empty-row">
                    <td colspan="8">No bank accounts added yet.</td>
                </tr>
            }
        </tbody>
    </table>

<script>
    function statusupdate(apinm) {
        $.ajax({
            url: '@Url.Action("UpdateBankSts", "Home")',
            type: "POST",
            data: { Apinm: apinm },
            cache: false,
            success: function (data2) {
                $('#apBankTableHost').html(data2);
            }
        });
    }
    function del(apinm) {
        $.ajax({
            url: '@Url.Action("delbankinfo", "Home")',
            type: "POST",
            data: { Apinm: apinm },
            cache: false,
            success: function (data2) {
                $('#apBankTableHost').html(data2);
            }
        });
    }
</script>

<script>
    function success() {
        var name = '@Model.msg';

        if (name == "OtpMissMatch") {
            $('#addmsgshow').text("OTP MissMatch");
        }
        else if (name == "notAllow") {
            $('#msgidno').text("Same Party Bank Already ADD");
            $('#post1').show();
            $('#post2').hide();
            $('#b_Banknm').val("");
            $('#b_payeenm').val("");
            $('#b_accountnm').val("");
            $('#b_ifsccode').val("");
            $('#b_comment').val("");
        }
        else if (name == "") {
            $('#post1').hide();
            $('#post2').hide();
            if (typeof show1 === 'function') { show1('sell'); }
            $('.for-list-button').first().trigger('click');
        }
    }
    function fail() {
        alert("err");
    }
</script>
