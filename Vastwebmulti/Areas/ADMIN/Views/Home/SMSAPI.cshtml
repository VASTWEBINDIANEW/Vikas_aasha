<script type="text/javascript">
    function saShowMainPanel() {
        $('.SMSAPI_Page').removeClass('sa-template-view');
        $('#saMainRightCol').css('display', 'flex');
        $('#saTemplateRightCol').css('display', 'none');
        $('#searchSms').attr('placeholder', 'Search SMS priority...').val('');
    }

    function saShowTemplatePanel() {
        $('.SMSAPI_Page').addClass('sa-template-view');
        $('#saMainRightCol').css('display', 'none');
        $('#saTemplateRightCol').css('display', 'flex');
        $('#searchSms').attr('placeholder', 'Search template...').val('');
    }

    function saApplyToolbarSearch(value) {
        var query = (value || '').toLowerCase();

        if ($('.SMSAPI_Page').hasClass('sa-template-view')) {
            $('#tbldata tbody tr').each(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(query) > -1);
            });
            return;
        }

        $('#gridtbl tbody tr').each(function () {
            $(this).toggle($(this).text().toLowerCase().indexOf(query) > -1);
        });

        var $activeRightTable = $('.SMSAPI_Page .sa-right-tab-body > .tab-content.sa-tab-active .sa-table-host table:visible').first();
        if ($activeRightTable.length) {
            $activeRightTable.find('tbody tr').each(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(query) > -1);
            });
        }
    }

    function saValidateTemplateUpload() {
        var fileInput = document.getElementById('FileUpload');
        if (!fileInput || !fileInput.files || !fileInput.files.length) {
            if (typeof toastr !== 'undefined') {
                toastr.warning('Please select an Excel file to upload.');
            } else {
                alert('Please select an Excel file to upload.');
            }
            return false;
        }

        var fileName = fileInput.files[0].name.toLowerCase();
        if (fileName.indexOf('.xls') === -1 && fileName.indexOf('.xlsx') === -1) {
            if (typeof toastr !== 'undefined') {
                toastr.error('Only .xls or .xlsx files are allowed.');
            } else {
                alert('Only .xls or .xlsx files are allowed.');
            }
            return false;
        }
        return true;
    }

    function saResetTemplateDeleteButtons() {
        $('.sa-template-delete-btn').removeClass('is-confirm');
        $('.sa-template-delete-btn .before-delete').show();
        $('.sa-template-delete-btn .after-delete').hide();
    }

    function saOnTemplateSaved() {
        if (typeof toastr !== 'undefined') {
            toastr.success('Template saved successfully.');
        }
        saResetTemplateDeleteButtons();
    }

    function saOnTemplateMergeSuccess() {
        if (typeof toastr !== 'undefined') {
            toastr.success('Templates merged successfully.');
        }
        saResetTemplateDeleteButtons();
    }

    function saOnTemplateDeleted() {
        if (typeof toastr !== 'undefined') {
            toastr.success('Template deleted successfully.');
        }
        saResetTemplateDeleteButtons();
    }

    function saSwitchRightTab(tabId) {
        $('.SMSAPI_Page .smsapi-second .sa-sms-right-tabs > li.tab-link').removeClass('current');
        $('.SMSAPI_Page .smsapi-second .tab-content').removeClass('current sa-tab-active');
        $('.SMSAPI_Page .smsapi-second .sa-sms-right-tabs > li.tab-link[data-tab="' + tabId + '"]').addClass('current');

        var $panel = (tabId === 'tab-4')
            ? $('#ApiSettings > #tab-4')
            : $('.SMSAPI_Page .smsapi-second .sa-right-tab-body > #' + tabId);

        $panel.addClass('current sa-tab-active');

        if (tabId === 'tab-4') {
            $('.SMSAPI_Page .sa-right-toolbar__action').addClass('is-visible');
        } else {
            $('.SMSAPI_Page .sa-right-toolbar__action').removeClass('is-visible');
        }

        saApplyToolbarSearch($('#searchSms').val());
    }

    function saSwitchLeftTab(tabId) {
        $('.head-sms .sa-sms-left-tabs li.tab-link2').removeClass('current2');
        $('.smsapi-first .sams-next > .tab-content2').removeClass('current2');
        $('.head-sms .sa-sms-left-tabs li.tab-link2[data-tab="' + tabId + '"]').addClass('current2');
        $('.smsapi-first .sams-next > #' + tabId).addClass('current2');

        if (tabId === 'tab-7') {
            saShowTemplatePanel();
        } else {
            saShowMainPanel();
        }
        saApplyToolbarSearch($('#searchSms').val());
    }

    function saReloadApiSettings(response) {
        $('#ApiSettings').html(response);
        saShowMainPanel();
        saSwitchRightTab('tab-4');
    }

    $(document).ready(function () {
        saShowMainPanel();
        saSwitchRightTab('tab-1');

        $('#FileUpload').on('change', function () {
            var fileName = (this.files && this.files[0]) ? this.files[0].name : 'Browse file';
            $(this).closest('.sa-template-upload-label').find('.sa-template-upload-btn').text(fileName);
        });

        $(document).on('click', '.sa-template-delete-btn .before-delete', function (e) {
            e.preventDefault();
            e.stopPropagation();
            saResetTemplateDeleteButtons();
            var $btn = $(this).closest('.sa-template-delete-btn');
            $btn.addClass('is-confirm');
            $(this).hide();
            $btn.find('.after-delete').show();
        });

        $(document).on('click', '.sa-template-delete-btn .sa-delete-confirm', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var $btn = $(this).closest('.sa-template-delete-btn');
            var idno = $btn.data('id');
            $.ajax({
                url: '@Url.Action("DeleteTemplatebyid", "Home", new { area = "ADMIN" })',
                data: { id: idno },
                type: 'POST',
                success: function (result) {
                    $('#tblshowMasterD').html(result);
                    saOnTemplateDeleted();
                },
                error: function () {
                    if (typeof toastr !== 'undefined') {
                        toastr.error('Unable to delete template. Please try again.');
                    }
                    saResetTemplateDeleteButtons();
                }
            });
        });

        @if (TempData["saSmsUploadMsg"] != null)
        {
            @:if (typeof toastr !== 'undefined') { toastr.success(@Html.Raw(Json.Encode(TempData["saSmsUploadMsg"]))); }
            @:saSwitchLeftTab('tab-7');
        }
        @if (TempData["saSmsUploadError"] != null)
        {
            @:if (typeof toastr !== 'undefined') { toastr.error(@Html.Raw(Json.Encode(TempData["saSmsUploadError"]))); }
            @:saSwitchLeftTab('tab-7');
        }
    })
</script>
