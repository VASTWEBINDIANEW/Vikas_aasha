                                                            <span class="sa-priority-badge sa-priority-view">@item.smsapi</span>
                                                            <select class="sa-form-control sa-priority-input sa-priority-api-input sa-priority-field-edit">
                                                                @for (var p = 1; p <= saPriorityCount; p++)
                                                                {
                                                                    <option value="@p" @(item.smsapi == p ? "selected" : "")>@p</option>
                                                                }
                                                            </select>
                                                        </td>
                                                        <td>
                                                            <span class="sa-priority-badge sa-priority-view">@item.sim</span>
                                                            <select class="sa-form-control sa-priority-input sa-priority-sim-input sa-priority-field-edit">
                                                                @for (var p = 1; p <= saPriorityCount; p++)
                                                                {
                                                                    <option value="@p" @(item.sim == p ? "selected" : "")>@p</option>
                                                                }
                                                            </select>
                                                        </td>
