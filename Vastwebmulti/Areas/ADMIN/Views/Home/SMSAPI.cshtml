                                        </div>

                                        <div class="sa-form-field sa-form-field--full">
                                            <label for="txtMsgBody"><i class="fas fa-comment-dots"></i> Message</label>
                                            <div class="sa-form-control-wrap">
                                                @Html.TextArea("txtMsgBody", "", new { @class = "sa-form-control sa-form-textarea", @placeholder = "Enter Message Here", rows = 4 })
                                            </div>
                                        </div>

