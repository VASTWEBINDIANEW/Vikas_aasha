<script>
    function saSmsCountTableRows(table) {
        if (!table) {
            return 0;
        }
        var rows = table.querySelectorAll('tbody tr');
        var count = 0;
        var i;
        for (i = 0; i < rows.length; i++) {
            if (rows[i].querySelector('.no-data-found-img, img[src*="NoDatall"]')) {
                continue;
            }
            if (rows[i].classList.contains('vm-opr-table-empty-row')) {
                continue;
            }
            count++;
        }
        return count;
    }

    function exportSmsTemplateExcel() {
        var table = document.getElementById('tbldata');
        if (!table || typeof window.openAdminModernReportExcel !== 'function') {
            return;
        }
        window.openAdminModernReportExcel({
            table: table,
            title: 'SMS Template History',
            subtitle: 'SMS template merge, upload and export report',
            fromDate: '—',
            toDate: '—',
            recordCount: saSmsCountTableRows(table),
            filePrefix: 'SMS_Template_History',
            sheetName: 'SMS Templates'
        });
    }

    function exportApiSmsHistoryExcel() {
        var table = document.getElementById('APISMSHISTORY');
        if (!table || typeof window.openAdminModernReportExcel !== 'function') {
            return;
        }
        window.openAdminModernReportExcel({
            table: table,
            title: 'API SMS History',
            subtitle: 'SMS API gateway send history report',
            fromDate: $('#tab-1 .txt_frm_date').first().val() || '—',
            toDate: $('#tab-1 .txt_to_date').first().val() || '—',
            recordCount: saSmsCountTableRows(table),
            filePrefix: 'API_SMS_History',
            sheetName: 'API SMS History'
        });
    }

    function exportSimSmsHistoryExcel() {
        var table = document.getElementById('SIMSMSHISTORY');
        if (!table || typeof window.openAdminModernReportExcel !== 'function') {
            return;
        }
        window.openAdminModernReportExcel({
            table: table,
            title: 'SIM SMS History',
            subtitle: 'SIM port SMS send history report',
            fromDate: $('#tab-2 .txt_frm_date').first().val() || '—',
            toDate: $('#tab-2 .txt_to_date').first().val() || '—',
            recordCount: saSmsCountTableRows(table),
            filePrefix: 'SIM_SMS_History',
            sheetName: 'SIM SMS History'
        });
    }

    function exportApiSmsHistoryPdf() {
        var table = document.getElementById('APISMSHISTORY');
        if (!table || typeof window.openAdminModernReportPdf !== 'function') {
            return;
        }
        var rowCount = saSmsCountTableRows(table);
        window.openAdminModernReportPdf({
            table: table,
            title: 'API SMS History',
            subtitle: 'SMS API gateway send history report',
            fromDate: $('#tab-1 .txt_frm_date').first().val() || '—',
            toDate: $('#tab-1 .txt_to_date').first().val() || '—',
            orientation: 'landscape',
            recordCount: rowCount,
            recordLabel: rowCount + ' record' + (rowCount === 1 ? '' : 's')
        });
    }

    function exportSimSmsHistoryPdf() {
        var table = document.getElementById('SIMSMSHISTORY');
        if (!table || typeof window.openAdminModernReportPdf !== 'function') {
            return;
        }
        var rowCount = saSmsCountTableRows(table);
        window.openAdminModernReportPdf({
            table: table,
            title: 'SIM SMS History',
            subtitle: 'SIM port SMS send history report',
            fromDate: $('#tab-2 .txt_frm_date').first().val() || '—',
            toDate: $('#tab-2 .txt_to_date').first().val() || '—',
            orientation: 'landscape',
            recordCount: rowCount,
            recordLabel: rowCount + ' record' + (rowCount === 1 ? '' : 's')
        });
    }

    $("#btnExport1").on('click', exportSmsTemplateExcel);
    $("#btnExport2").on('click', exportApiSmsHistoryExcel);
    $("#btnExport3").on('click', exportSimSmsHistoryExcel);
    $("#btnPDF2").on('click', exportApiSmsHistoryPdf);
    $("#btnPDF3").on('click', exportSimSmsHistoryPdf);
</script>

