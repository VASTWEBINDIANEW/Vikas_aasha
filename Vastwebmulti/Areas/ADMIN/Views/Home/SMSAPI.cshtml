                                    <form class="sa-send-sms-form">
                                        <div class="sa-send-mode-toggle" role="radiogroup" aria-label="Send mode">
                                            <input type="radio" value="value1" name="group1" id="byapi1" checked>
                                            <label for="byapi1"><i class="fas fa-cloud"></i> BY API</label>
                                            <input type="radio" value="value2" name="group1" id="bysim1">
                                            <label for="bysim1"><i class="fas fa-sim-card"></i> BY SIM</label>
                                        </div>

