                                                                <button type="button" class="sa-priority-save-btn sa-priority-action-edit"><i class="fas fa-check"></i><span>Save</span></button>
                                                                <button type="button" class="sa-priority-cancel-btn sa-priority-action-edit"><i class="fas fa-times"></i><span>Cancel</span></button>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
