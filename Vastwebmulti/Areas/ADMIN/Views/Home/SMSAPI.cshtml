    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var saPriorityCount = (Model.SMS_PriorityList != null && Model.SMS_PriorityList.Any())
        ? Model.SMS_PriorityList.Count
        : 10;
}
