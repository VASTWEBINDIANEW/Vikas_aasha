<!--  ==  SMS Priority  ==-->
<script type="text/javascript">
    var saPriorityCount = @saPriorityCount;

    function saPriorityOptions(selected) {
        var html = '';
        for (var p = 1; p <= saPriorityCount; p++) {
            html += '<option value="' + p + '"' + (String(selected) === String(p) ? ' selected' : '') + '>' + p + '</option>';
        }
        return html;
    }

    function saCancelPriorityEdit($row) {
        if (!$row || !$row.length) {
            return;
        }
        $row.removeClass('is-editing');
        $row.find('.sa-priority-api-input').val($row.data('api'));
        $row.find('.sa-priority-sim-input').val($row.data('sim'));
    }

    function saEnterPriorityEdit($row) {
        $('.sa-priority-row.is-editing').each(function () {
            saCancelPriorityEdit($(this));
        });
        $row.addClass('is-editing');
    }

    function saRebuildPriorityTable(list) {
        var tblHtml = '';
        $.each(list, function (a, b) {
            tblHtml += '<tr class="sa-priority-row" data-id="' + b.idno + '" data-api="' + b.smsapi + '" data-sim="' + b.sim + '">';
            tblHtml += '<td><span class="sa-priority-label">' + b.sms + '</span></td>';
            tblHtml += '<td><span class="sa-priority-badge sa-priority-view">' + b.smsapi + '</span>';
            tblHtml += '<select class="sa-form-control sa-priority-input sa-priority-api-input sa-priority-field-edit">' + saPriorityOptions(b.smsapi) + '</select></td>';
            tblHtml += '<td><span class="sa-priority-badge sa-priority-view">' + b.sim + '</span>';
            tblHtml += '<select class="sa-form-control sa-priority-input sa-priority-sim-input sa-priority-field-edit">' + saPriorityOptions(b.sim) + '</select></td>';
            tblHtml += '<td class="sa-priority-actions"><div class="sa-priority-action-group">';
            tblHtml += '<button type="button" class="sa-priority-edit-btn sa-priority-action-view"><i class="fas fa-pen"></i><span>Edit</span></button>';
            tblHtml += '<button type="button" class="sa-priority-save-btn sa-priority-action-edit"><i class="fas fa-check"></i><span>Save</span></button>';
            tblHtml += '<button type="button" class="sa-priority-cancel-btn sa-priority-action-edit"><i class="fas fa-times"></i><span>Cancel</span></button>';
            tblHtml += '</div></td></tr>';
        });
        $('#gridtbl > tbody').html(tblHtml);
    }

    function saSavePriorityRow($row) {
        var smsapi = $row.find('.sa-priority-api-input').val();
        var sim = $row.find('.sa-priority-sim-input').val();
        if (String(smsapi) === String(sim)) {
            if (typeof swal === 'function') {
                swal('Opps!', 'Not Two Priority Are Same', 'error');
            } else if (typeof toastr !== 'undefined') {
                toastr.error('API SMS and SIM SMS priority cannot be the same.');
            } else {
                alert('Not Two Priority Are Same');
            }
            return;
        }

        var $saveBtn = $row.find('.sa-priority-save-btn');
        $saveBtn.prop('disabled', true);

        $.ajax({
            type: 'POST',
            url: '@Url.Action("edit_smspriority", "Home", new { area = "ADMIN" })',
            data: { idno: $row.data('id'), smsapi: smsapi, sim: sim },
            success: function (response) {
                if (response && response.SMS_PriorityList) {
                    saRebuildPriorityTable(response.SMS_PriorityList);
                    if (typeof toastr !== 'undefined') {
                        toastr.success('SMS priority updated successfully.');
                    }
                }
            },
            error: function () {
                if (typeof toastr !== 'undefined') {
                    toastr.error('Unable to save SMS priority.');
                }
                $saveBtn.prop('disabled', false);
            }
        });
    }

    $(document).on('click', '.sa-priority-edit-btn', function (e) {
        e.preventDefault();
        saEnterPriorityEdit($(this).closest('.sa-priority-row'));
    });

    $(document).on('click', '.sa-priority-cancel-btn', function (e) {
        e.preventDefault();
