                                    <div class="sa-table-host sa-priority-table-wrap">
                                        <table class="table sa-priority-table" id="gridtbl">
                                            <thead>
                                                <tr>
                                                    <th>SMS FROM</th>
                                                    <th>API SMS</th>
                                                    <th>SIM SMS</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var item in Model.SMS_PriorityList)
