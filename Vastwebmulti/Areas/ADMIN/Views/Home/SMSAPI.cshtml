<script>
    (function ($) {
        function saInitTemplateSelect2() {
            $('.smsapi-first select.for-select2').each(function () {
                var $el = $(this);
                if ($el.hasClass('select2-hidden-accessible')) {
                    return;
                }
                $el.select2({ width: '100%' });
            });
        }

        function saInitModalApiTypeSelect() {
            var $modal = $('#defaultModal');
            var $type = $('#sms_type');
            if (!$type.length || !$modal.length) {
                return;
            }
            if ($type.hasClass('select2-hidden-accessible')) {
                $type.select2('destroy');
            }
            $type.select2({
                dropdownParent: $modal,
                minimumResultsForSearch: Infinity,
                width: '100%'
            });
        }

        function saDestroyModalApiTypeSelect() {
            var $type = $('#sms_type');
            if ($type.hasClass('select2-hidden-accessible')) {
                $type.select2('destroy');
            }
        }

        window.saInitTemplateSelect2 = saInitTemplateSelect2;
        window.saInitModalApiTypeSelect = saInitModalApiTypeSelect;
        window.saDestroyModalApiTypeSelect = saDestroyModalApiTypeSelect;

        $(document).ready(function () {
            saInitTemplateSelect2();
        });

        $(document).ajaxComplete(function () {
            saInitTemplateSelect2();
        });
    })(jQuery);
</script>

<script>
    jQuery(document).ready(function ($) {
        function saToggleEnableInputs() {
            var apiUrl = $.trim($('#smsapiurl').val() || '');
            var editApi = $.trim($('#apiapisms_smsapi1').val() || '');
            var msg = $.trim($('#txtMsgBody').val() || '');
            var mobile = $.trim($('#txtmobileNo').val() || '');
            var userType = $('#Userform1').val();

            $('#start_SMSAPI').prop('disabled', apiUrl === '');
            $('#start_button2').prop('disabled', editApi === '');
            $('#btnSendSms').prop('disabled', !(msg && (mobile || userType)));
        }

        $(document).on('keyup change', '#smsapiurl, #apiapisms_smsapi1, #txtMsgBody, #txtmobileNo, #Userform1', saToggleEnableInputs);
        saToggleEnableInputs();

        $('#defaultModal').on('shown.bs.modal', function () {
            saInitModalApiTypeSelect();
        });

        $('#defaultModal, #defaultModal1').on('hidden.bs.modal', function () {
            $('body').removeClass('modal-open');
            $('.modal-backdrop').remove();
            $('#smsapiurl, #smsapiCheck').val('');
            saDestroyModalApiTypeSelect();
            $('#sms_type').val('sms');
            saToggleEnableInputs();
        });

        $(document).on('click', '#ApiSettings .before-delete', function () {
            var $btn = $(this).closest('.sa-delete-btn, .delete-fa');
            $(this).hide();
            $btn.addClass('is-confirm');
            $btn.find('.after-delete').show();
        });
    });
</script>

