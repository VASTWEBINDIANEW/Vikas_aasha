@model Vastwebmulti.Areas.ADMIN.ViewModel.MicroatmchargeViewmodel
@{
    Layout = null;
}
@Html.Partial("_MicroatmChargeTableHead")
<tbody>
    @foreach (var item in Model.Showdeviceplanlist)
    {
        <tr>
            <td class="vm-matm-cl-col--plan">@Html.DisplayFor(modelItem => item.planname)</td>
            <td class="vm-matm-cl-col--days">@Html.DisplayFor(modelItem => item.noofdays)</td>
            <td class="vm-matm-cl-col--num">@Html.DisplayFor(modelItem => item.deviceprice)</td>
            <td class="vm-matm-cl-col--num">@Html.DisplayFor(modelItem => item.minquantity)</td>
            <td class="vm-matm-cl-col--num vm-matm-cl-tier-start">@Html.DisplayFor(modelItem => item.upto2)</td>
            <td class="vm-matm-cl-col--num">@Html.DisplayFor(modelItem => item.upto5)</td>
            <td class="vm-matm-cl-col--num">@Html.DisplayFor(modelItem => item.upto8)</td>
            <td class="vm-matm-cl-col--num vm-matm-cl-tier-start">@Html.DisplayFor(modelItem => item.above8)</td>
            <td class="vm-matm-cl-col--num">@Html.DisplayFor(modelItem => item.dlm_upto2)</td>
            <td class="vm-matm-cl-col--num">@Html.DisplayFor(modelItem => item.dlm_upto5)</td>
            <td class="vm-matm-cl-col--num vm-matm-cl-tier-start">@Html.DisplayFor(modelItem => item.dlm_upto8)</td>
            <td class="vm-matm-cl-col--num">@Html.DisplayFor(modelItem => item.dlm_above8)</td>
            <td class="vm-matm-cl-col--num">@Html.DisplayFor(modelItem => item.md_upto2)</td>
            <td class="vm-matm-cl-col--num vm-matm-cl-tier-start">@Html.DisplayFor(modelItem => item.md_upto5)</td>
            <td class="vm-matm-cl-col--num">@Html.DisplayFor(modelItem => item.md_upto8)</td>
            <td class="vm-matm-cl-col--num">@Html.DisplayFor(modelItem => item.md_above8)</td>
            <td class="vm-matm-cl-col--num vm-matm-cl-tier-start">@Html.DisplayFor(modelItem => item.monthly)</td>
            <td class="vm-matm-cl-col--num">@Html.DisplayFor(modelItem => item.monthlydealer)</td>
            <td class="vm-matm-cl-col--num">@Html.DisplayFor(modelItem => item.monthlymaster)</td>
            <td class="vm-matm-cl-col--action">
                <button type="button" class="vm-matm-cl-edit-btn microatmcharge-button" id="editplanoder_@item.idno" onclick="EditPlanorday(@item.idno)">
                    <i class="fas fa-pen" aria-hidden="true"></i> Edit
                </button>
            </td>
        </tr>
    }
</tbody>
