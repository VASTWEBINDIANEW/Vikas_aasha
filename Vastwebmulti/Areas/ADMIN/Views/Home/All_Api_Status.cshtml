@model Vastwebmulti.Areas.ADMIN.Models.Apiactiveinactive
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "API Status";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var activeList = Model != null && Model.active != null
        ? Model.active.ToList()
        : new List<Vastwebmulti.Models.show_all_active_inactive_api_list_Result>();
    var inactiveList = Model != null && Model.inactive != null
        ? Model.inactive.ToList()
        : new List<Vastwebmulti.Models.show_all_active_inactive_api_list_Result>();

    var activeCount = activeList.Count;
    var inactiveCount = inactiveList.Count;
    var totalCount = activeCount + inactiveCount;
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=46" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=35" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-actual-daybook-modern.css?v=10" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-user-status-modern.css?v=3" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-actual-daybook-page saas-user-status-page">

    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">
            <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-adb-toolbar-one-line">

                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb vm-adb-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>Account</li>
                    <li>User's Book</li>
                </ol>

                <div class="vm-adb-nav-row-shell vm-daybook-nav-row">
                    @Html.Partial("~/Areas/ADMIN/Views/Home/_UserStatusNav.cshtml")
                </div>

            </div>

            <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="userStatusTotalsPanel" style="display:none;" aria-hidden="true">
                <div class="vm-dmt-totals-head">
                    <div class="vm-dmt-totals-head__title">
                        <i class="fas fa-chart-pie" aria-hidden="true"></i>
                        <span>API status totals</span>
                    </div>
                    <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideUserStatusTotals()" title="Hide totals" aria-label="Hide totals">
                        <i class="fas fa-chevron-up" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                    <div class="vm-opr-total-card vm-opr-total-card--success">
                        <span class="vm-opr-total-card__label">Active Users</span>
                        <strong class="vm-opr-total-card__value">@activeCount</strong>
                    </div>
                    <div class="vm-opr-total-card vm-opr-total-card--pending">
                        <span class="vm-opr-total-card__label">Inactive Users</span>
                        <strong class="vm-opr-total-card__value">@inactiveCount</strong>
                    </div>
                    <div class="vm-opr-total-card vm-opr-total-card--primary">
                        <span class="vm-opr-total-card__label">Total Users</span>
                        <strong class="vm-opr-total-card__value">@totalCount</strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="vm-ust-info-banner" role="note">
            <i class="fas fa-info-circle" aria-hidden="true"></i>
            <span>A user doing business within the current 15 days is considered an <strong>active user</strong>. No new user appears as active until they start business.</span>
        </div>

        <div class="vm-opr-main-card vm-prepaid-report-main-card" id="tblpdf">
            <div class="vm-opr-table-panel vm-prepaid-report-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head vm-adb-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-plug" aria-hidden="true"></i>
                        <span>API users status</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge vm-ust-badge--active" title="Active users">
                            Active: <strong>@activeCount</strong>
                        </span>
                        <span class="vm-radiant-record-badge vm-ust-badge--inactive" title="Inactive users">
                            Inactive: <strong>@inactiveCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total" title="Total users">
                            Total: <strong>@totalCount</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-ust-totals-btn" onclick="findUserStatusTotals()" title="Show totals" aria-expanded="false" aria-controls="userStatusTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnExportA" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDFA" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-ust-grid">

                    <div class="vm-ust-panel">
                        <div class="vm-opr-table-panel__head vm-dmt-table-panel__head" style="padding: 0 0 10px;">
                            <div class="vm-opr-table-panel__title">
                                <i class="fas fa-user-check" aria-hidden="true"></i>
                                <span>Active users</span>
                            </div>
                        </div>
                        <div class="vm-opr-table-wrap vm-prepaid-table-wrap vm-adb-table-wrap">
                            <div class="table-responsive vm-opr-table-scroll">
                                <table id="apiActiveTable" class="table vm-opr-data-table vm-ust-table" cellspacing="0">
                                    <thead>
                                        <tr>
                                            <th>Sr</th>
                                            <th>Firm Name</th>
                                            <th>Active On</th>
                                            <th>Day's</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (activeCount == 0)
                                        {
                                            <tr class="vm-opr-table-empty-row">
                                                <td colspan="5" class="vm-opr-table-empty vm-dmt-table-empty">
                                                    <i class="fas fa-inbox" aria-hidden="true"></i>
                                                    <span>No data found.</span>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            int ii = 1;
                                            foreach (var item in activeList)
                                            {
                                                <tr>
                                                    <td class="vm-adb-num">@ii</td>
                                                    <td class="vm-adb-text">@Html.DisplayFor(modelItem => item.farmname)</td>
                                                    <td class="vm-adb-num">@String.Format("{0:dd-MM-yyyy}", item.Rch_time)</td>
                                                    <td class="vm-adb-num">@Html.DisplayFor(modelItem => item.todays)</td>
                                                    <td>
                                                        <span class="vm-ust-status-pill vm-ust-status-pill--active">@Html.DisplayFor(modelItem => item.type)</span>
                                                    </td>
                                                </tr>
                                                ii++;
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="vm-ust-panel">
                        <div class="vm-opr-table-panel__head vm-dmt-table-panel__head" style="padding: 0 0 10px;">
                            <div class="vm-opr-table-panel__title">
                                <i class="fas fa-user-slash" aria-hidden="true"></i>
                                <span>Inactive users</span>
                            </div>
                        </div>
                        <div class="vm-opr-table-wrap vm-prepaid-table-wrap vm-adb-table-wrap">
                            <div class="table-responsive vm-opr-table-scroll">
                                <table id="apiInactiveTable" class="table vm-opr-data-table vm-ust-table" cellspacing="0">
                                    <thead>
                                        <tr>
                                            <th>Sr</th>
                                            <th>Firm Name</th>
                                            <th>InActive</th>
                                            <th>Day's</th>
                                            <th>Status</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @if (inactiveCount == 0)
                                        {
                                            <tr class="vm-opr-table-empty-row">
                                                <td colspan="5" class="vm-opr-table-empty vm-dmt-table-empty">
                                                    <i class="fas fa-inbox" aria-hidden="true"></i>
                                                    <span>No data found.</span>
                                                </td>
                                            </tr>
                                        }
                                        else
                                        {
                                            int i = 1;
                                            foreach (var item in inactiveList)
                                            {
                                                <tr>
                                                    <td class="vm-adb-num">@i</td>
                                                    <td class="vm-adb-text">@Html.DisplayFor(modelItem => item.farmname)</td>
                                                    <td class="vm-adb-num">@String.Format("{0:dd-MM-yyyy}", item.Rch_time)</td>
                                                    <td class="vm-adb-num">@Html.DisplayFor(modelItem => item.todays)</td>
                                                    <td>
                                                        <span class="vm-ust-status-pill vm-ust-status-pill--inactive">@Html.DisplayFor(modelItem => item.type)</span>
                                                    </td>
                                                </tr>
                                                i++;
                                            }
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                </div>

                <table id="userStatusExportTable" class="table vm-ust-export-table" aria-hidden="true">
                    <thead>
                        <tr>
                            <th>Sr</th>
                            <th>Firm Name</th>
                            <th>Last Activity</th>
                            <th>Day's</th>
                            <th>Status</th>
                            <th>User Type</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (totalCount == 0)
                        {
                            <tr>
                                <td colspan="6">No data found.</td>
                            </tr>
                        }
                        else
                        {
                            int ex = 1;
                            foreach (var item in activeList)
                            {
                                <tr>
                                    <td>@ex</td>
                                    <td>@item.farmname</td>
                                    <td>@String.Format("{0:dd-MM-yyyy}", item.Rch_time)</td>
                                    <td>@item.todays</td>
                                    <td>@item.type</td>
                                    <td>Active</td>
                                </tr>
                                ex++;
                            }
                            foreach (var item in inactiveList)
                            {
                                <tr>
                                    <td>@ex</td>
                                    <td>@item.farmname</td>
                                    <td>@String.Format("{0:dd-MM-yyyy}", item.Rch_time)</td>
                                    <td>@item.todays</td>
                                    <td>@item.type</td>
                                    <td>Inactive</td>
                                </tr>
                                ex++;
                            }
                        }
                    </tbody>
                </table>

            </div>
        </div>

    </div>
</section>

<script src="~/MainFrontDesign/js/admin-report-pdf-export.js?v=2"></script>
<script src="~/MainFrontDesign/js/admin-report-excel-export.js?v=4"></script>

<script>
    function hideUserStatusTotals() {
        var $panel = $('#userStatusTotalsPanel');
        var $btn = $('.vm-ust-totals-btn');
        $panel.hide().attr('aria-hidden', 'true');
        $btn.attr('aria-expanded', 'false');
    }

    function findUserStatusTotals() {
        var $panel = $('#userStatusTotalsPanel');
        var $btn = $('.vm-ust-totals-btn');
        if ($panel.is(':visible')) {
            hideUserStatusTotals();
            return;
        }
        $panel.show().attr('aria-hidden', 'false');
        $btn.attr('aria-expanded', 'true');
    }

    function exportUserStatusExcel() {
        var table = document.getElementById('userStatusExportTable');
        if (!table || typeof window.openAdminModernReportExcel !== 'function') {
            return;
        }

        window.openAdminModernReportExcel({
            table: table,
            title: 'API Users Status',
            subtitle: 'Active and inactive API users (15-day business rule)',
            recordCount: @totalCount,
            filePrefix: 'API_Status',
            sheetName: 'API Status',
            theme: 'gray'
        });
    }

    function exportUserStatusPdf() {
        var table = document.getElementById('userStatusExportTable');
        if (!table || typeof window.openAdminModernReportPdf !== 'function') {
            return;
        }

        window.openAdminModernReportPdf({
            table: table,
            title: 'API Users Status',
            subtitle: 'Active and inactive API users (15-day business rule)',
            orientation: 'landscape',
            recordCount: @totalCount,
            theme: 'gray'
        });
    }

    $(document).ready(function () {
        $('#btnExportA').on('click', exportUserStatusExcel);
        $('#btnPDFA').on('click', exportUserStatusPdf);
    });
</script>
