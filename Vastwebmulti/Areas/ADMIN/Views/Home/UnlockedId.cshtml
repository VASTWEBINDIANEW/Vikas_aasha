@using System.Linq
@model IEnumerable<Vastwebmulti.Models.User>
@{
    ViewBag.Title = "UnlockedId";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    var dateMode = (ViewBag.chk as string) == "post" ? "post" : "get";
    var rows = Model ?? Enumerable.Empty<Vastwebmulti.Models.User>();
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-app-login-history-modern.css?v=4" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-app-login-history-mobile.css?v=4" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-app-login-report-page">
    <div class="container-fluid vm-opr-page-shell">

        @using (Html.BeginForm("UnlockedId", "Home", FormMethod.Post, new { id = "unlockedIdForm", data_date_mode = dateMode, data_frm_date = frmDate, data_to_date = toDate }))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Login Reports</li>
                        <li>Locked Users</li>
                    </ol>
                    <div class="vm-dmt-fin-nav-row vm-login-report-nav-row">
                        @Html.Partial("_loginReportNav")
                    </div>
                </div>

                <div class="vm-rpt-filters-panel">
                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-app-login-filter-row vm-rpt-filters-panel__bar">
                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-lock" aria-hidden="true"></i>
                        <span>Locked user accounts</span>
                    </div>
                    <span class="vm-opr-table-panel__hint">Click unlock to restore access · export via toolbar</span>
                </div>
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="example" class="table table-bordered table-striped table-hover vm-opr-data-table vm-app-login-data-table vm-unlocked-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>UserId</th>
                                    <th>Register&nbsp;Number</th>
                                    <th>Register&nbsp;Email</th>
                                    <th>Lock&nbsp;Out&nbsp;DateTime</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (rows.Any())
                                {
                                    foreach (var item in rows)
                                    {
                                        <tr>
                                            <td>@item.Email</td>
                                            <td>@item.PhoneNumber</td>
                                            <td>@item.UserName</td>
                                            <td>@item.LockoutEndDateUtc</td>
                                            <td>
                                                <button type="button" class="vm-unlock-user-btn" data-user-id="@item.UserId" title="Click to unlock user">
                                                    <i class="fas fa-unlock-alt" aria-hidden="true"></i>
                                                    <span>Click To Unlock</span>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="5" class="vm-opr-table-empty">
                                            <i class="fas fa-inbox" aria-hidden="true"></i>
                                            <span>No locked users found for selected date range.</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script src="~/MainFrontDesign/js/admin-app-login-history.js?v=2"></script>
<script>
    function RenivalId(userid) {
        if (!confirm('Are you sure you want to unlock this user?')) {
            return false;
        }
        $.ajax({
            type: 'POST',
            url: '@Url.Action("Unlockuserid", "Home")',
            cache: false,
            dataType: 'json',
            data: { userid: userid },
            async: true,
            success: function (data) {
                var sts = data.Status;
                var message = data.Message;
                if (sts === 'Success') {
                    swal({ title: 'UnLock !', text: message, type: 'success' }, function () {
                        location.reload();
                    });
                }
            }
        });
        return true;
    }
</script>
