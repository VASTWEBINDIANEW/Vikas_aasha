@model Vastwebmulti.Areas.ADMIN.Models.RchModelcs
@{
    var actionname = "";
    if (ViewBag.actionname != null)
    {
        actionname = ViewBag.actionname;
    }
    var rchList = (Model != null && Model.RCHList != null) ? Model.RCHList.ToList() : new System.Collections.Generic.List<Vastwebmulti.Models.Select_show_RCH_Result>();
}

<!-- ===== Table ===== -->
<div class="table-responsive vm-ml-table-scroll saas-acc-table-wrap">
<table class="table table-bordered saas-acc-table vm-ml-data-table third-design-table" id="mdList">
    <thead>
        <tr>
            <th>Sr</th>
            <th>User&nbsp;Firm</th>
            <th>User&nbsp;Name</th>
            <th>Mobile&nbsp;No</th>
            <th>Email&nbsp;V/F</th>
        </tr>
    </thead>
    <tbody id="body">
        @if (rchList.Any())
        {
            int id = 1;
            foreach (var item in rchList)
            {
                <tr class="tr">
                    <td>@id</td>
                    <td><strong>@item.FarmName</strong></td>
                    <td>@item.RCHName</td>
                    <td style="font-weight:600;">@item.Mobile</td>
                    <td>
                        <span style="display:inline-flex;align-items:center;gap:4px;">
                            @if (item.EmailConfirmed == true)
                            {
                                <span class="wl-badge wl-badge--done"><i class="fas fa-envelope-open" style="margin-right:3px;"></i>Done</span>
                            }
                            else
                            {
                                <span class="wl-badge wl-badge--due"><i class="fas fa-envelope" style="margin-right:3px;"></i>Due</span>
                            }
                            <button class="wl-detail-btn js-rch-open-modal" data-rchid="@item.RCHId" title="View Details">
                                <i class="fas fa-chevron-right"></i>
                            </button>
                        </span>
                    </td>
                </tr>
                id++;
            }
        }
        else
        {
            <tr>
                <td colspan="5" style="text-align:center;padding:32px;color:#94a3b8;">
                    <i class="fa fa-users" style="font-size:2rem;display:block;margin-bottom:8px;opacity:.4;"></i>
                    No RCH users found
                </td>
            </tr>
        }
    </tbody>
</table>
</div>

<!-- ===== Main Detail Modal ===== -->
<div class="modal fade wl-modal mastetr222Modal" id="defaultModal222" tabindex="-1" role="dialog" aria-labelledby="rchModalTitle">
    <div class="modal-dialog" role="document">
        <div class="modal-content">

            <!-- Header -->
            <div class="wl-modal-header">
                <div class="wl-modal-header__left">
                    <div class="wl-modal-header__icon"><i class="fas fa-users"></i></div>
                    <div>
                        <div class="wl-modal-header__label">RCH User</div>
                        <div class="wl-modal-header__balance" id="rchModalTitle">User Details</div>
                    </div>
                </div>
                <button type="button" class="wl-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times"></i></button>
            </div>

            <!-- Profile strip -->
            <div class="wl-modal-profile">
                <img src="~/AdminDesign/images/user.png" class="wl-modal-avatar" alt="User" />
                <div class="wl-modal-profile__info">
                    <div class="wl-modal-profile__name"><span id="Names"></span></div>
                    <div class="wl-modal-profile__firm"><i class="fas fa-building" style="margin-right:4px;color:#94a3b8;"></i><span id="FirmNamesss"></span></div>
                    <div class="wl-modal-profile__date"><i class="far fa-clock" style="margin-right:4px;"></i><span id="RegisteredDate"></span></div>
                </div>
                <span id="error" class="wl-modal-profile__error"></span>
            </div>

            <!-- Body -->
            <div class="wl-modal-body">

                <!-- Shared hidden field � accessible from both view and edit form -->
                <input type="hidden" id="rch_id_shared" value="" />

                <!-- VIEW form (read-only) -->
                <form class="first-form">
                    <input type="hidden" id="rolesname" name="rolesname" value="" />
                    @Html.Hidden("RCHIdshow")

                    <div class="wl-view-row">
                        <div class="wl-view-field">
                            <div class="wl-view-field__label"><i class="fas fa-envelope" style="margin-right:3px;"></i>Email</div>
                            <div class="wl-view-field__val" id="view_Email">�</div>
                        </div>
                        <div class="wl-view-field">
                            <div class="wl-view-field__label"><i class="fas fa-id-card" style="margin-right:3px;"></i>PAN Card</div>
                            <div class="wl-view-field__val" id="view_Pan">�</div>
                        </div>
                        <div class="wl-view-field">
                            <div class="wl-view-field__label"><i class="fas fa-fingerprint" style="margin-right:3px;"></i>Aadhaar</div>
                            <div class="wl-view-field__val" id="view_Aadhar">�</div>
                        </div>
                        <div class="wl-view-field">
                            <div class="wl-view-field__label"><i class="fas fa-map-pin" style="margin-right:3px;"></i>Pin Code</div>
                            <div class="wl-view-field__val" id="view_Pin">�</div>
                        </div>
                        <div class="wl-view-field">
                            <div class="wl-view-field__label"><i class="fas fa-map" style="margin-right:3px;"></i>State</div>
                            <div class="wl-view-field__val" id="view_State">�</div>
                        </div>
                        <div class="wl-view-field">
                            <div class="wl-view-field__label"><i class="fas fa-city" style="margin-right:3px;"></i>District</div>
                            <div class="wl-view-field__val" id="view_District">�</div>
                        </div>
                    </div>
                    <div class="wl-view-field" style="margin-top:8px;">
                        <div class="wl-view-field__label"><i class="fas fa-location-arrow" style="margin-right:3px;"></i>Address</div>
                        <div class="wl-view-field__val" id="view_Address">�</div>
                    </div>

                    <!-- View mode footer -->
                    <div class="wl-modal-footer">
                        <ul>
                            <li class="one">
                                <button type="button" value="Edit" class="wl-mf-btn wl-mf-btn--edit"><i class="fas fa-edit"></i> Edit</button>
                            </li>
                            <li class="three">
                                <button type="button" value="Email_Verify" class="wl-mf-btn wl-mf-btn--verify" onclick="EmailVerify()"><i class="fas fa-envelope-open-text"></i> Verify Email</button>
                            </li>
                            <li class="four">
                                <button type="button" value="Delet" class="wl-mf-btn wl-mf-btn--delete" onclick="Deleteuser()"><i class="fas fa-trash-alt"></i> Delete</button>
                            </li>
                        </ul>
                    </div>
                </form>

                <!-- EDIT form -->
                <div class="second-form" style="display:none;">
                    @using (Ajax.BeginForm(actionname, "Home", new AjaxOptions { InsertionMode = InsertionMode.Replace, HttpMethod = "POST", UpdateTargetId = "RECTable", OnSuccess = "OnSuccess", OnBegin = "chkvalidation" }))
                    {
                        @Html.Hidden("RCHId")

                        <div class="wl-modal-section-label"><i class="fas fa-user-edit" style="margin-right:5px;"></i>Edit RCH User Details</div>
                        <div class="wl-edit-grid">
                            <div class="wl-edit-field">
                                <div class="wl-edit-field__icon wl-icon--blue"><i class="fas fa-user"></i></div>
                                <div class="wl-edit-field__body">
                                    <label>Name</label>
                                    @Html.TextBox("NameEdit", "", new { @class = "form-control", placeholder = "Enter Name", required = "required" })
                                </div>
                            </div>
                            <div class="wl-edit-field">
                                <div class="wl-edit-field__icon wl-icon--purple"><i class="fas fa-building"></i></div>
                                <div class="wl-edit-field__body">
                                    <label>Firm Name</label>
                                    @Html.TextBox("FirmEdit", "", new { @class = "form-control", placeholder = "Enter Firm Name", required = "required" })
                                </div>
                            </div>
                            <div class="wl-edit-field">
                                <div class="wl-edit-field__icon wl-icon--orange"><i class="fas fa-id-card"></i></div>
                                <div class="wl-edit-field__body">
                                    <label>PAN Card</label>
                                    @Html.TextBox("pancardEdit", "", new { @class = "form-control", placeholder = "PAN Card No", @style = "text-transform:uppercase;" })
                                </div>
                            </div>
                            <div class="wl-edit-field">
                                <div class="wl-edit-field__icon wl-icon--green"><i class="fas fa-fingerprint"></i></div>
                                <div class="wl-edit-field__body">
                                    <label>Aadhaar Card</label>
                                    @Html.TextBox("AadhaarEdit", "", new { @class = "form-control", placeholder = "Aadhaar Number", onkeypress = "return isNumber(event)", maxlength = "12" })
                                </div>
                            </div>
                            <div class="wl-edit-field">
                                <div class="wl-edit-field__icon wl-icon--teal"><i class="fas fa-map"></i></div>
                                <div class="wl-edit-field__body">
                                    <label>State</label>
                                    <select id="StateEdit" onchange="Editstatechange()" name="StateEdit" class="form-control"><option>Select State</option></select>
                                </div>
                            </div>
                            <div class="wl-edit-field">
                                <div class="wl-edit-field__icon wl-icon--slate"><i class="fas fa-city"></i></div>
                                <div class="wl-edit-field__body">
                                    <label>District</label>
                                    @Html.DropDownList("DistrictEdit", new SelectList(Enumerable.Empty<SelectListItem>(), "Dist_id", "Dist_Desc"), "Select district", new { @class = "form-control" })
                                </div>
                            </div>
                            <div class="wl-edit-field">
                                <div class="wl-edit-field__icon wl-icon--red"><i class="fas fa-map-pin"></i></div>
                                <div class="wl-edit-field__body">
                                    <label>Pin Code</label>
                                    @Html.TextBox("PinEdit", "", new { @class = "form-control", placeholder = "Pin Code", required = "required" })
                                </div>
                            </div>
                        </div>
                        <div class="wl-edit-field wl-edit-field--full" style="margin-top:8px;">
                            <div class="wl-edit-field__icon wl-icon--slate"><i class="fas fa-location-arrow"></i></div>
                            <div class="wl-edit-field__body">
                                <label>Address</label>
                                @Html.TextArea("AddressEdit", "", new { @class = "form-control", placeholder = "Enter Address", required = "required", rows = "2" })
                            </div>
                        </div>

                        <div id="rch-edit-errmsg" style="margin:6px 0;"></div>

                        <!-- Edit form footer -->
                        <div class="wl-modal-footer">
                            <ul>
                                <li>
                                    <button type="button" class="wl-mf-btn wl-mf-btn--back js-rch-back"><i class="fas fa-arrow-left"></i> Back</button>
                                </li>
                                <li>
                                    <label id="lblerrordoc" style="font-size:.75rem;color:#dc2626;margin:0;align-self:center;"></label>
                                </li>
                                <li>
                                    <button type="submit" value="SaveChange" class="wl-mf-btn wl-mf-btn--save special-iii btnssl2233" data-loading-text="<i class='fa fa-spinner fa-spin'></i>"><i class="fas fa-save"></i> Save Changes</button>
                                </li>
                            </ul>
                        </div>
                    }
                </div>

            </div><!--/.wl-modal-body-->
        </div>
    </div>
</div>

<!-- OTP Delete modal -->
<div id="otpmodal" class="modal fade" role="dialog">
    <div class="modal-dialog" style="width:420px;float:right;margin:0px;"><div class="modal-content">
        <div class="modal-header"><button type="button" class="close" data-dismiss="modal">&times;</button><h4 class="modal-title"><i class="fas fa-key" style="margin-right:6px;"></i>OTP Verification</h4></div>
        <div class="modal-body">
            @using (Ajax.BeginForm("ConfirmDeleteRCHuserOTP", "Home", new AjaxOptions { HttpMethod = "POST", UpdateTargetId = "RECTable", OnSuccess = "OnSuccessconfirm", OnFailure = "OnFailureotperror" }))
            {
                @Html.Hidden("roledelete")
                @Html.Hidden("RCHIddelete")
                <div class="form-group"><label>Enter OTP</label>@Html.TextBox("Deleteotp", "", new { @class = "form-control", placeholder = "Enter OTP", required = "required" })</div>
                <span id="otpwrong" style="color:#dc2626;font-size:.78rem;"></span>
                <div style="margin-top:10px;text-align:right;">
                    <button type="submit" class="wl-mf-btn wl-mf-btn--delete special-iii btnssl2233" data-loading-text="<i class='fa fa-spinner fa-spin'></i>"><i class="fas fa-trash-alt"></i> Confirm Delete</button>
                </div>
            }
        </div>
    </div></div>
</div>

<!-- JS � namespaced events prevent duplicate binding on AJAX reload -->
<script>
    // Edit button � switch to edit form
    $(document).off('click.rchedit').on('click.rchedit', '.mastetr222Modal button.wl-mf-btn[value="Edit"]', function () {
        $(".mastetr222Modal .first-form").hide();
        $(".mastetr222Modal .second-form").show();
    });
    // Back button � return to view form
    $(document).off('click.rchBack').on('click.rchBack', '.mastetr222Modal .js-rch-back', function () {
        $(".mastetr222Modal .second-form").hide();
        $(".mastetr222Modal .first-form").show();
    });
    // Chevron button � open modal immediately, then load user data
    $(document).off('click.rchOpenModal').on('click.rchOpenModal', '.js-rch-open-modal', function (e) {
        e.stopPropagation();
        var rchid = $(this).data('rchid');
        var $m = $('#defaultModal222');
        if (!$m.parent().is('body')) { $m.appendTo('body'); }
        $m.removeData('bs.modal');
        $m.modal({ backdrop: 'static', keyboard: true });
        $m.modal('show');
        mdActionBtn(rchid);
    });
    // Reset to view form whenever modal opens
    $(document).off('show.bs.modal.rch').on('show.bs.modal.rch', '#defaultModal222', function () {
        if (!$(this).parent().is('body')) { $(this).appendTo('body'); }
        $(".mastetr222Modal .second-form").hide();
        $(".mastetr222Modal .first-form").show();
        $('#rch-edit-errmsg').html('');
        $('#error').text('');
    });
</script>

<script>
    function OnSuccessconfirm(data) {
        $('#RECTable').html(data);
        $('#defaultModal222').modal('hide');
        $('#otpmodal').modal('hide');
        $('body').removeClass('modal-open');
        $(".modal-backdrop").remove();
        ToastrMessage(); toastr.success("Account Deleted Successfully");
    }
    function OnFailureotperror(data) {
        $('#otpmodal').modal('show');
        $('#otpwrong').text("OTP Mismatch � Please enter Correct OTP");
    }
    function OnSuccess() { $(".modal-backdrop").hide(); }
    function OnFailure() { ToastrMessage(); toastr.error("OTP Mismatch"); }
</script>

<script>
    function Editstatechange() { GetDistrict11($('#StateEdit').val()); }
    function GetDistrict11(_stateId) {
        $("#DistrictEdit").html("<option value='0'> Please wait...</option>").show();
        $.ajax({
            url: '@Url.Action("DistrictList","Home")', data: { Id: _stateId }, cache: false, type: "POST",
            success: function (data3) {
                ravi("#DistrictEdit").html("");
                for (var x = 0; x < data3.length; x++) ravi("#DistrictEdit").append($('<option></option>').val(data3[x].Value).html(data3[x].Text));
            }
        });
    }
    function binddistmdAction(staid, dist, objSelect11) {
        $.ajax({
            url: '@Url.Action("DistrictList","Home")', data: { Id: staid }, cache: false, type: "POST",
            success: function (data1) {
                var markup = "<option value='0'>Select District</option>";
                for (var x = 0; x < data1.length; x++) markup += "<option value=" + data1[x].Value + ">" + data1[x].Text + "</option>";
                ravi("#DistrictEdit").html(markup).show();
                setSelectedValue(objSelect11, dist);
            }
        });
    }
    function setSelectedValue(selectObj, valueToSet) {
        for (var i = 0; i < selectObj.options.length; i++) { if (selectObj.options[i].value == valueToSet) { selectObj.options[i].selected = true; return; } }
    }
    function converttoDate(str) {
        var date = new Date(str), mnth = ("0"+(date.getMonth()+1)).slice(-2), day = ("0"+date.getDate()).slice(-2);
        return [day,mnth,date.getFullYear()].join("-")+" "+date.getHours()+":"+date.getMinutes()+":"+date.getSeconds();
    }
    $(document).off('change.rcheditstate').on('change.rcheditstate', '#StateEdit', function () {
        GetDistrict11($(this).val());
    });
</script>

<script>
    function chkvalidation() {
        $('#rch-edit-errmsg').html('');
        var name     = $('#NameEdit').val();
        var FarmName = $('#FirmEdit').val();
        var State    = $('#StateEdit').val();
        var District = $('#DistrictEdit').val();
        var Address  = $('#AddressEdit').val();
        var Pincode  = $('#PinEdit').val();
        var pancard  = $('#pancardEdit').val();
        function showErr(msg) {
            $('#rch-edit-errmsg').html('<div class="alert alert-danger" style="font-size:.82rem;padding:6px 10px;margin-top:6px;border-radius:8px;">' + msg + '</div>');
            return false;
        }
        if (!name)     return showErr('Name is required');
        if (!FarmName) return showErr('Firm Name is required');
        if (pancard.length > 0) {
            var rx = /([A-Z]){5}([0-9]){4}([A-Z]){1}$/;
            if (!rx.test(pancard.toUpperCase())) return showErr('Invalid PAN Card number');
        }
        if (!State)    return showErr('State is required');
        if (!District) return showErr('District is required');
        if (!Address)  return showErr('Address is required');
        if (!Pincode)  return showErr('Pin Code is required');
    }
</script>

<script>
    function Deleteuser() {
        var role  = $('#rolesname').val();
        var RCHId = $('#rch_id_shared').val() || $('#RCHId').val();
        $.ajax({
            url: '@Url.Action("DeleteRCHuserByID", "Home")',
            type: 'POST', data: { RCHId: RCHId, role: role }, cache: false,
            success: function (response) {
                if (response == "success") {
                    var $otp = $('#otpmodal');
                    if (!$otp.parent().is('body')) { $otp.appendTo('body'); }
                    $otp.modal('show');
                } else {
                    $('#error').text(response);
                }
            }
        });
    }
    function EmailVerify() {
        var RCHId = $('#rch_id_shared').val() || $('#RCHId').val();
        $.ajax({
            url: '@Url.Action("emailverifyforRCH","Home")',
            type: "POST", data: { RCHId: RCHId }, cache: false, dataType: "html",
            success: function (data2) {
                $('#RECTable').html(data2);
                $('#defaultModal222').modal('hide');
                $('body').removeClass('modal-open');
                $(".modal-backdrop").remove();
                ToastrMessage(); toastr.success("Email verified successfully");
            }
        });
    }
</script>

<script>
    function mdActionBtn(RCHId) {
        // Show a brief loading hint in the profile name while data loads
        $('#Names').text('Loading...');
        $('#FirmNamesss').text('');
        $('#RegisteredDate').text('');
        $('#error').text('');

        $.ajax({
            url: '@Url.Action("Rch_UserBYIdSearch", "Home")',
            type: "POST", data: { RCHId: RCHId }, cache: false,
            success: function (data2) {
                var d = data2.list[0];
                var CCNValue = d.adharcard;
                if (CCNValue) { CCNValue = CCNValue.substring(0, 8).replace(/\d/g, "X") + CCNValue.substring(8); }
                var createddate = '';
                try {
                    var date = new Date(parseInt((d.JoinDate).match(/\d+/)[0]));
                    createddate = converttoDate(date);
                } catch(ex) { createddate = ''; }

                $('#error').text('');
                $('#rolesname').val('RCH');
                $('#roledelete').val('RCH');
                $('#RCHId').val(d.RCHId);
                $('#RCHIddelete').val(d.RCHId);
                $('#RCHIdshow').val(d.RCHId);
                $('#rch_id_shared').val(d.RCHId);
                $('#Names').text(d.RCHName || '');
                $('#FirmNamesss').text(d.FarmName || '�');
                $('#RegisteredDate').text(createddate);

                // View fields
                $('#view_Email').text(d.Email || '�');
                $('#view_Pan').text(d.pancard || '�');
                $('#view_Aadhar').text(CCNValue || '�');
                $('#view_Pin').text(d.Pincode || '�');
                $('#view_State').text(d.State_name || '�');
                $('#view_District').text(d.Dist_Desc || '�');
                $('#view_Address').text(d.Address || '�');

                // Edit fields
                $('#NameEdit').val(d.RCHName);
                $('#FirmEdit').val(d.FarmName);
                $('#pancardEdit').val(d.pancard);
                $('#AadhaarEdit').val(d.adharcard);
                $('#PinEdit').val(d.Pincode);
                $('#AddressEdit').val(d.Address);

                // State dropdown
                ravi('#StateEdit').html('');
                var opts = '<option value="">Select State</option>';
                for (var i = 0; i < data2.state.length; i++) {
                    var sel = data2.state[i].Selected ? ' selected' : '';
                    opts += '<option value="' + data2.state[i].Value + '"' + sel + '>' + data2.state[i].Text + '</option>';
                }
                ravi('#StateEdit').append(opts);
                binddistmdAction(d.State, d.District, document.getElementById("DistrictEdit"));
            },
            error: function () {
                $('#Names').text('Error loading data');
                $('#error').text('Failed to load user data. Please close and try again.');
            }
        });
    }
    function isNumber(evt) {
        evt = (evt) ? evt : window.event; var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57)) return false; return true;
    }
</script>
