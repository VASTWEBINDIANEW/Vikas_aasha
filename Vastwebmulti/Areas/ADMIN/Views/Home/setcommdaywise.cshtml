@{
    ViewBag.Title = "Extra Day Commission Slab";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-settings-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-payment-gateway-slab-modern.css?v=10" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-prepaid-slab-modern.css?v=11" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-prepaid-slab-mobile.css?v=11" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />

<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script src="~/Scripts/jquery.validate.min.js"></script>
<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

<style>
    #div_Loader {
        background: rgba(0, 0, 0, 0.6) none repeat scroll 0 0;
        height: 100%;
        position: fixed;
        left: 0;
        top: 0;
        width: 100%;
        z-index: 999999;
    }

    .ldio-gs56nt525f > div {
        transform-origin: 100px 100px;
        animation: ldio-gs56nt525f 0.2s infinite linear;
    }

        .ldio-gs56nt525f > div div {
            position: absolute;
            width: 22px;
            height: 152px;
            background: var(--main-bg-lcolor);
            left: 100px;
            top: 100px;
            transform: translate(-50%,-50%);
        }

            .ldio-gs56nt525f > div div:nth-child(1) {
                width: 120px;
                height: 120px;
                border-radius: 50%;
            }

            .ldio-gs56nt525f > div div:nth-child(6) {
                width: 80px;
                height: 80px;
                background: #fff;
                border-radius: 50%;
            }

            .ldio-gs56nt525f > div div:nth-child(3) {
                transform: translate(-50%,-50%) rotate(45deg)
            }

            .ldio-gs56nt525f > div div:nth-child(4) {
                transform: translate(-50%,-50%) rotate(90deg)
            }

            .ldio-gs56nt525f > div div:nth-child(5) {
                transform: translate(-50%,-50%) rotate(135deg)
            }

    .loadingio-spinner-gear-94vo528ab8 {
        width: 200px;
        height: 200px;
        display: inline-block;
        overflow: hidden;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%,-50%);
    }

    .ldio-gs56nt525f {
        width: 100%;
        height: 100%;
        position: relative;
        transform: translateZ(0) scale(1);
        backface-visibility: hidden;
        transform-origin: 0 0;
    }

        .ldio-gs56nt525f div {
            box-sizing: content-box;
        }

    @@keyframes ldio-gs56nt525f {
        0% { transform: rotate(0deg) }
        50% { transform: rotate(22.5deg) }
        100% { transform: rotate(45deg) }
    }

    #divComm113.vm-prepaid-user-filter {
        display: none !important;
        margin: 0 !important;
        padding: 0 !important;
        border: none !important;
        box-shadow: none !important;
    }

    #divComm113.vm-prepaid-user-filter.is-visible {
        display: block !important;
        margin: 12px 16px 0 !important;
        padding: 10px 12px !important;
        border: 1px solid #e2e8f0 !important;
        border-radius: 12px !important;
        background: #fff !important;
        box-shadow: 0 1px 8px rgba(15, 23, 42, 0.04) !important;
    }
</style>

<section class="content saas-admin-account-page saas-admin-settings-page saas-pg-slab-page saas-prepaid-slab-page saas-daywise-slab-page">
    <div id="loadermoney" class="loadermoney" style="display:none;"></div>
    <div class="container-fluid">

        <div class="saas-acc-toolbar">
            <ol class="saas-acc-breadcrumb">
                <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                <li><a href="javascript:void(0);">Basic Setting</a></li>
                <li>Extra Day Commission Slab</li>
            </ol>
        </div>

        <div class="vm-prepaid-slab-shell">
            @Html.Partial("_Slab_Menu")

            <div class="vm-prepaid-slab-main">
                <div class="vm-pg-slab-card">
                    <div class="vm-pg-slab-card__head">
                        <h3 class="vm-pg-slab-card__title">
                            <i class="fas fa-calendar-day" aria-hidden="true"></i>
                            Extra Day Commission Slab
                        </h3>
                        <div class="vm-pg-slab-card__actions">
                            <div class="vm-pg-slab-tab-bar">
                                <div class="vm-pg-slab-tabs all-slab-header all-slab-header-second slab-btn-second">
                                    <a href="@Url.Action("setcommdaywise", "Home")" id="Comm" class="vm-pg-slab-tab vm-pg-slab-tab--active" aria-selected="true">
                                        <span class="vm-pg-slab-tab__icon" aria-hidden="true"><i class="fas fa-layer-group"></i></span>
                                        <span class="vm-pg-slab-tab__copy">Common Slab<span class="vm-pg-slab-tab__sub">For New Users</span></span>
                                    </a>
                                    <button type="button" id="Mdbtn" class="vm-pg-slab-tab vm-pg-slab-tab--inactive" aria-selected="false" onclick="editUserWise('Master')">
                                        <span class="vm-pg-slab-tab__icon" aria-hidden="true"><i class="fas fa-user-shield"></i></span>
                                        <span class="vm-pg-slab-tab__copy">MD Slab<span class="vm-pg-slab-tab__sub">Existing Users</span></span>
                                    </button>
                                    <button type="button" id="Dlmbtn" class="vm-pg-slab-tab vm-pg-slab-tab--inactive" aria-selected="false" onclick="editUserWise('Dealer')">
                                        <span class="vm-pg-slab-tab__icon" aria-hidden="true"><i class="fas fa-store"></i></span>
                                        <span class="vm-pg-slab-tab__copy">Distributor Slab<span class="vm-pg-slab-tab__sub">Existing Users</span></span>
                                    </button>
                                    <button type="button" id="Rembtn" class="vm-pg-slab-tab vm-pg-slab-tab--inactive" aria-selected="false" onclick="editUserWise('RDealer')">
                                        <span class="vm-pg-slab-tab__icon" aria-hidden="true"><i class="fas fa-user-tag"></i></span>
                                        <span class="vm-pg-slab-tab__copy">Retailer Slab<span class="vm-pg-slab-tab__sub">Existing Users</span></span>
                                    </button>
                                </div>
                            </div>
                            <div class="vm-prepaid-slab-actions">
                                <button id="btnEdit" type="button" class="vm-pg-slab-btn-edit" onclick="editcommon()">
                                    <img src="~/AdminDesign/images/edit.svg" alt="" />
                                    <span>Edit Slab</span>
                                </button>
                                <button id="btnEdit11" type="button" class="vm-pg-slab-btn-edit" style="display:none;" onclick="editcomm1()">
                                    <img src="~/AdminDesign/images/edit.svg" alt="" />
                                    <span>Edit Slab</span>
                                </button>
                                <button id="btnEdit112" type="button" class="vm-pg-slab-save-btn" style="display:none;" onclick="Savecreaditcomm()">
                                    <span>Save</span>
                                </button>
                                <button id="btnEdit1112" type="button" class="vm-pg-slab-save-btn" style="display:none;" onclick="Savecreaditcommdata()">
                                    <span>Save</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="vm-pg-slab-body">
                        <input type="hidden" value="" id="rolescccomm" />
                        <input type="hidden" value="" id="useridcccomm" />

                        <div id="divComm113" class="slab-master-block vm-prepaid-user-filter vm-prepaid-user-filter--inline"></div>

                        <div class="vm-pg-slab-table-scroll saas-acc-table-wrap vm-prepaid-slab-table-wrap">
                            <table id="daywiseSlabTable" class="table table-bordered vm-pg-slab-table slab-table third-design-table">
                                <thead>
                                    <tr>
                                        <th>Role</th>
                                        <th>2000 to 5000</th>
                                        <th>5001 to 10000</th>
                                        <th>10001 and Above</th>
                                    </tr>
                                </thead>
                                <tbody id="creditcommon" class="vm-pg-slab-tbody--view"></tbody>
                                <tbody id="creditcommon1" class="vm-pg-slab-tbody--hidden"></tbody>
                            </table>
                        </div>

                        <div style="display:none">
                            <input type="hidden" value="" id="usseersss" />
                            <input type="hidden" value="" id="rolenames" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div id="div_Loader" style="display:none;">
    <div class="loadingio-spinner-gear-94vo528ab8">
        <div class="ldio-gs56nt525f">
            <div><div></div><div></div><div></div><div></div><div></div><div></div></div>
        </div>
    </div>
</div>

<script>
    var slabTabByRole = {
        'Common': '#Comm',
        'Master': '#Mdbtn',
        'Dealer': '#Dlmbtn',
        'RDealer': '#Rembtn'
    };

    function setSlabTabActive(selector) {
        $('.vm-pg-slab-tab')
            .removeClass('vm-pg-slab-tab--active')
            .addClass('vm-pg-slab-tab--inactive')
            .attr('aria-selected', 'false');

        $(selector)
            .removeClass('vm-pg-slab-tab--inactive')
            .addClass('vm-pg-slab-tab--active')
            .attr('aria-selected', 'true');
    }

    function setSlabTabByRole(userRole) {
        var selector = slabTabByRole[userRole] || '#Comm';
        setSlabTabActive(selector);
    }

    function resetDaywiseButtonsCommon() {
        $('#btnEdit').show();
        $('#btnEdit11, #btnEdit112, #btnEdit1112').hide();
    }

    function resetDaywiseButtonsUser() {
        $('#btnEdit11').show();
        $('#btnEdit, #btnEdit112, #btnEdit1112').hide();
    }

    function resetDaywiseViewMode() {
        $('#creditcommon')
            .removeClass('vm-pg-slab-tbody--hidden vm-pg-slab-tbody--edit')
            .addClass('vm-pg-slab-tbody--view')
            .show();
        $('#creditcommon1')
            .addClass('vm-pg-slab-tbody--hidden')
            .removeClass('vm-pg-slab-tbody--edit')
            .hide();
    }

    function showCommonEditMode() {
        $('#btnEdit, #btnEdit11, #btnEdit1112').hide();
        $('#btnEdit112').show();
        $('#creditcommon')
            .addClass('vm-pg-slab-tbody--hidden')
            .removeClass('vm-pg-slab-tbody--view')
            .hide();
        $('#creditcommon1')
            .removeClass('vm-pg-slab-tbody--hidden')
            .addClass('vm-pg-slab-tbody--edit')
            .show();
    }

    function showUserEditMode() {
        $('#btnEdit, #btnEdit11, #btnEdit112').hide();
        $('#btnEdit1112').show();
        $('#creditcommon')
            .addClass('vm-pg-slab-tbody--hidden')
            .removeClass('vm-pg-slab-tbody--view')
            .hide();
        $('#creditcommon1')
            .removeClass('vm-pg-slab-tbody--hidden')
            .addClass('vm-pg-slab-tbody--edit')
            .show();
    }

    function createCommissionInput(value, cssClass) {
        var inp = document.createElement('input');
        inp.setAttribute('type', 'number');
        inp.setAttribute('value', value);
        inp.setAttribute('class', cssClass + ' vm-pg-slab-cell-input form-control');
        return inp;
    }

    function getDaywiseValues(data) {
        return {
            comm1: data.Comm_2000_5000,
            comm2: data.Comm_5001_10000,
            comm3: data.Comm_10001_max
        };
    }

    function buildDaywiseRows(viewBody, editBody, label, data, editData) {
        var values = getDaywiseValues(data);
        var inputValues = editData ? getDaywiseValues(editData) : values;

        var tr = document.createElement('tr');
        var tr1 = document.createElement('tr');

        var td = document.createElement('td');
        var td1 = document.createElement('td');
        var td2 = document.createElement('td');
        var td3 = document.createElement('td');

        td.textContent = label;
        td1.textContent = values.comm1;
        td2.textContent = values.comm2;
        td3.textContent = values.comm3;

        var td4 = document.createElement('td');
        td4.setAttribute('class', 'clsrole');
        td4.textContent = label;

        var td5 = document.createElement('td');
        var td6 = document.createElement('td');
        var td7 = document.createElement('td');

        td5.appendChild(createCommissionInput(inputValues.comm1, 'cls100'));
        td6.appendChild(createCommissionInput(inputValues.comm2, 'cls5000'));
        td7.appendChild(createCommissionInput(inputValues.comm3, 'cls10000'));

        tr.appendChild(td);
        tr.appendChild(td1);
        tr.appendChild(td2);
        tr.appendChild(td3);

        tr1.appendChild(td4);
        tr1.appendChild(td5);
        tr1.appendChild(td6);
        tr1.appendChild(td7);

        viewBody.appendChild(tr);
        editBody.appendChild(tr1);
    }

    function clearDaywiseTable() {
        document.getElementById('creditcommon').innerHTML = '';
        document.getElementById('creditcommon1').innerHTML = '';
    }

    function setUserInfoFields(name, mobile, email) {
        if (document.getElementById('ccname')) {
            document.getElementById('ccname').value = name || '';
        }
        if (document.getElementById('ccmobile')) {
            document.getElementById('ccmobile').value = mobile || '';
        }
        if (document.getElementById('ccemail')) {
            document.getElementById('ccemail').value = email || '';
        }
    }

    function initPgSlabPartialUi() {
        if ($.fn.select2) {
            $('.saas-prepaid-slab-page .for-select2').each(function () {
                var $el = $(this);
                try {
                    if ($el.hasClass('select2-hidden-accessible')) {
                        $el.select2('destroy');
                    }
                } catch (e) { }
                $el.select2({
                    width: '100%',
                    dropdownParent: $(document.body)
                });
            });
        }
    }

    function bindPgSlabTableHover() {
        $(document).off('mouseenter.pgslab mouseleave.pgslab', '.saas-prepaid-slab-page .third-design-table tbody td');
        $(document).on('mouseenter.pgslab', '.saas-prepaid-slab-page .third-design-table tbody td', function () {
            var colIndex = $(this).parent().children().index($(this)) + 1;
            var rowIndex = $(this).parent().parent().children().index($(this).parent()) + 1;
            $('.saas-prepaid-slab-page .third-design-table td:nth-child(' + colIndex + ')').css({ background: 'var(--main-bg-rcolor, #2563eb)', color: '#fff' });
            $('.saas-prepaid-slab-page .third-design-table tbody tr:nth-child(' + rowIndex + ')').css('background', 'var(--main-bg-rcolor, #2563eb)');
        });
        $(document).on('mouseleave.pgslab', '.saas-prepaid-slab-page .third-design-table tbody td', function () {
            var colIndex = $(this).parent().children().index($(this)) + 1;
            var rowIndex = $(this).parent().parent().children().index($(this).parent()) + 1;
            $('.saas-prepaid-slab-page .third-design-table td:nth-child(' + colIndex + ')').css({ background: '', color: '' });
            $('.saas-prepaid-slab-page .third-design-table tbody tr:nth-child(' + rowIndex + ')').css('background', '');
        });
    }

    function hideDaywiseUserFilter() {
        var filter = document.getElementById('divComm113');
        filter.innerHTML = '';
        filter.classList.remove('is-visible');
    }

    function showDaywiseUserFilter() {
        document.getElementById('divComm113').classList.add('is-visible');
    }

    function createFilterItem(extraClass) {
        var item = document.createElement('div');
        item.className = 'vm-prepaid-user-filter__item' + (extraClass ? ' ' + extraClass : '');
        return item;
    }

    function wrapPgSlabField(control, iconClass) {
        var item = createFilterItem();
        var field = document.createElement('div');
        field.className = 'vm-pg-slab-field';
        var icon = document.createElement('span');
        icon.className = 'vm-pg-slab-field__icon';
        icon.setAttribute('aria-hidden', 'true');
        var i = document.createElement('i');
        i.className = iconClass;
        icon.appendChild(i);
        field.appendChild(icon);
        field.appendChild(control);
        item.appendChild(field);
        return item;
    }

    function createUserFilterRow() {
        var row = document.createElement('div');
        row.className = 'vm-prepaid-user-filter__row';
        return row;
    }

    function appendUserInfoFields(row) {
        var nameInput = document.createElement('input');
        nameInput.setAttribute('type', 'text');
        nameInput.setAttribute('id', 'ccname');
        nameInput.setAttribute('placeholder', 'User Name');
        nameInput.setAttribute('readonly', 'true');
        nameInput.setAttribute('class', 'form-control');
        row.appendChild(wrapPgSlabField(nameInput, 'fas fa-user'));

        var mobileInput = document.createElement('input');
        mobileInput.setAttribute('type', 'text');
        mobileInput.setAttribute('id', 'ccmobile');
        mobileInput.setAttribute('placeholder', 'User Registered Number');
        mobileInput.setAttribute('readonly', 'true');
        mobileInput.setAttribute('class', 'form-control');
        row.appendChild(wrapPgSlabField(mobileInput, 'fas fa-phone-alt'));

        var emailInput = document.createElement('input');
        emailInput.setAttribute('type', 'text');
        emailInput.setAttribute('id', 'ccemail');
        emailInput.setAttribute('placeholder', 'User Registered Mail');
        emailInput.setAttribute('readonly', 'true');
        emailInput.setAttribute('class', 'form-control');
        row.appendChild(wrapPgSlabField(emailInput, 'fas fa-envelope'));
    }

    function buildDaywiseUserFilter(selectElement, retailerSelect) {
        var filter = document.getElementById('divComm113');
        filter.innerHTML = '';

        var row = createUserFilterRow();

        if (retailerSelect) {
            var retailerWrap = document.createElement('div');
            retailerWrap.id = 'retailerdrop';
            retailerWrap.className = 'vm-prepaid-user-filter__retailer show-retailer';

            var dealerItem = createFilterItem();
            var dealerField = document.createElement('div');
            dealerField.className = 'vm-pg-slab-field';
            var dealerIcon = document.createElement('span');
            dealerIcon.className = 'vm-pg-slab-field__icon';
            dealerIcon.setAttribute('aria-hidden', 'true');
            dealerIcon.innerHTML = '<i class="fas fa-user-tie"></i>';
            dealerField.appendChild(dealerIcon);
            dealerField.appendChild(selectElement);
            dealerItem.appendChild(dealerField);
            retailerWrap.appendChild(dealerItem);

            var retailerItem = createFilterItem();
            var retailerField = document.createElement('div');
            retailerField.className = 'vm-pg-slab-field';
            var retailerIcon = document.createElement('span');
            retailerIcon.className = 'vm-pg-slab-field__icon';
            retailerIcon.setAttribute('aria-hidden', 'true');
            retailerIcon.innerHTML = '<i class="fas fa-store"></i>';
            retailerField.appendChild(retailerIcon);
            retailerField.appendChild(retailerSelect);
            retailerItem.appendChild(retailerField);
            retailerWrap.appendChild(retailerItem);

            row.appendChild(retailerWrap);
        } else {
            var userItem = createFilterItem('vm-prepaid-user-filter__item--select');
            var userField = document.createElement('div');
            userField.className = 'vm-pg-slab-field';
            var userIcon = document.createElement('span');
            userIcon.className = 'vm-pg-slab-field__icon';
            userIcon.setAttribute('aria-hidden', 'true');
            userIcon.innerHTML = '<i class="fas fa-users"></i>';
            userField.appendChild(userIcon);
            userField.appendChild(selectElement);
            userItem.appendChild(userField);
            row.appendChild(userItem);
        }

        appendUserInfoFields(row);
        filter.appendChild(row);
        showDaywiseUserFilter();
    }

    function buildDefaultAllRow() {
        var ss = document.getElementById('creditcommon');
        var ss1 = document.getElementById('creditcommon1');
        buildDaywiseRows(ss, ss1, 'ALL', {
            Comm_2000_5000: 0,
            Comm_5001_10000: 0,
            Comm_10001_max: 0
        });
        setUserInfoFields('ALL', 'ALL', 'ALL');
    }

    function editUserWise11(role) {
        var userid = document.getElementById('selectter').value;
        if (userid != '') {
            $.ajax({
                type: 'POST',
                url: '@Url.Action("dayswiseuser", "Home")',
                data: { role: role, userid: userid },
                success: function (result) {
                    var select = document.getElementById('Remcreaditid');
                    select.innerHTML = '';

                    var option = document.createElement('option');
                    option.text = 'ALL Retailer';
                    option.value = '';
                    select.appendChild(option);

                    for (var i = 0; i < result.retailerid.length; i++) {
                        var option1 = document.createElement('option');
                        option1.text = result.frmname[i];
                        option1.value = result.retailerid[i];
                        select.appendChild(option1);
                    }

                    var ss = document.getElementById('creditcommon');
                    var ss1 = document.getElementById('creditcommon1');
                    clearDaywiseTable();

                    buildDaywiseRows(ss, ss1, result.frm, result.data);

                    setUserInfoFields(result.frm, result.Mobile, result.Email);
                    resetDaywiseButtonsUser();
                    resetDaywiseViewMode();

                    document.getElementById('useridcccomm').value = result.data.userid;
                    document.getElementById('rolescccomm').value = 'RDealer';
                    initPgSlabPartialUi();
                }
            });
        }
    }

    function editUserWise(role) {
        document.getElementById('useridcccomm').value = role;
        setSlabTabByRole(role);

        $.ajax({
            type: 'POST',
            url: '@Url.Action("dayswiseuser", "Home")',
            data: { role: role, userid: '' },
            success: function (result) {
                clearDaywiseTable();

                var select = document.createElement('select');
                select.setAttribute('id', 'selectter');
                select.setAttribute('class', 'for-select2 form-control');

                var option = document.createElement('option');
                var retailerSelect = null;

                if (role == 'Master') {
                    select.setAttribute('onchange', 'calldata("Master")');
                    option.text = 'ALL Master';
                    option.value = '';
                    select.appendChild(option);

                    for (var i = 0; i < result.length; i++) {
                        var option1 = document.createElement('option');
                        option1.text = result[i].FarmName;
                        option1.value = result[i].SSId;
                        select.appendChild(option1);
                    }
                } else if (role == 'Dealer') {
                    select.setAttribute('onchange', 'calldata("Dealer")');
                    option.text = 'ALL Dealer';
                    option.value = '';
                    select.appendChild(option);

                    for (var j = 0; j < result.length; j++) {
                        var option2 = document.createElement('option');
                        option2.text = result[j].FarmName;
                        option2.value = result[j].DealerId;
                        select.appendChild(option2);
                    }
                } else if (role == 'RDealer') {
                    select.setAttribute('onchange', 'editUserWise11("Retailer")');
                    option.text = 'ALL Dealer';
                    option.value = '';
                    select.appendChild(option);

                    for (var k = 0; k < result.length; k++) {
                        var option3 = document.createElement('option');
                        option3.text = result[k].FarmName;
                        option3.value = result[k].DealerId;
                        select.appendChild(option3);
                    }

                    retailerSelect = document.createElement('select');
                    retailerSelect.setAttribute('id', 'Remcreaditid');
                    retailerSelect.setAttribute('onchange', 'calldata("Retailer")');
                    retailerSelect.setAttribute('class', 'for-select2 form-control');

                    var optionR = document.createElement('option');
                    optionR.text = 'ALL Retailer';
                    optionR.value = '';
                    retailerSelect.appendChild(optionR);
                }

                buildDaywiseUserFilter(select, retailerSelect);
                buildDefaultAllRow();
                initPgSlabPartialUi();
                resetDaywiseButtonsUser();
                resetDaywiseViewMode();
            }
        });
    }

    function editcommon() {
        var cj = document.getElementById('creditcommon').innerHTML;
        if (cj != '') {
            showCommonEditMode();
        }
    }

    function editcomm1() {
        var cj = document.getElementById('creditcommon').innerHTML;
        if (cj != '') {
            showUserEditMode();
        }
    }

    function calldata(role) {
        var val = document.getElementById('selectter').value;
        if (role == 'Retailer') {
            val = document.getElementById('Remcreaditid').value;
        }

        $.ajax({
            type: 'POST',
            url: '@Url.Action("Daywisewiseusercomm", "Home")',
            data: { role: role, userid: val },
            success: function (result) {
                var ss = document.getElementById('creditcommon');
                var ss1 = document.getElementById('creditcommon1');
                clearDaywiseTable();

                buildDaywiseRows(ss, ss1, result.frm, result.data);

                setUserInfoFields(result.frm, result.mobile, result.Email);
                resetDaywiseButtonsUser();
                resetDaywiseViewMode();

                document.getElementById('useridcccomm').value = result.data.userid;
                document.getElementById('rolescccomm').value = role;
            }
        });
    }

    function loadCommonDaywiseSlab() {
        hideDaywiseUserFilter();
        $.ajax({
            type: 'POST',
            url: '@Url.Action("setcommdaywisecommon", "Home")',
            success: function (result) {
                var ss = document.getElementById('creditcommon');
                var ss1 = document.getElementById('creditcommon1');
                clearDaywiseTable();

                for (var i = 0; i < result.length; i++) {
                    buildDaywiseRows(ss, ss1, result[i].Role, result[i]);
                }

                resetDaywiseButtonsCommon();
                resetDaywiseViewMode();
            }
        });
    }

    function Savecreaditcomm() {
        var role = document.getElementsByClassName('clsrole');
        var comm1 = document.getElementsByClassName('cls100');
        var comm2 = document.getElementsByClassName('cls5000');
        var comm3 = document.getElementsByClassName('cls10000');
        var roles = [];
        var comms1 = [];
        var comms2 = [];
        var comms3 = [];

        for (var i = 0; i < role.length; i++) {
            roles[i] = role[i].innerHTML;
            comms1[i] = comm1[i].value;
            comms2[i] = comm2[i].value;
            comms3[i] = comm3[i].value;
        }

        $.ajax({
            type: 'POST',
            url: '@Url.Action("SavecommonDayWise", "Home")',
            data: { roles: roles, comm1: comms1, comm2: comms2, comm3: comms3 },
            success: function (result) {
                var ss = document.getElementById('creditcommon');
                var ss1 = document.getElementById('creditcommon1');
                clearDaywiseTable();

                for (var j = 0; j < result.length; j++) {
                    buildDaywiseRows(ss, ss1, result[j].Role, result[j]);
                }

                resetDaywiseButtonsCommon();
                resetDaywiseViewMode();
            }
        });
    }

    function Savecreaditcommdata() {
        var role = document.getElementById('rolescccomm').value;
        var userid = document.getElementById('useridcccomm').value;
        var comm1 = document.getElementsByClassName('cls100');
        var comm2 = document.getElementsByClassName('cls5000');
        var comm3 = document.getElementsByClassName('cls10000');
        var comms1 = [comm1[0].value];
        var comms2 = [comm2[0].value];
        var comms3 = [comm3[0].value];

        $.ajax({
            type: 'POST',
            url: '@Url.Action("Savedaywisecomm", "Home")',
            data: { roles: role, userid: userid, comm1: comms1, comm2: comms2, comm3: comms3 },
            success: function (result) {
                var ss = document.getElementById('creditcommon');
                var ss1 = document.getElementById('creditcommon1');
                clearDaywiseTable();

                buildDaywiseRows(ss, ss1, result.frm, result.data[0]);

                resetDaywiseButtonsUser();
                resetDaywiseViewMode();
            }
        });
    }

    $(document).ready(function () {
        bindPgSlabTableHover();
        hideDaywiseUserFilter();
        setSlabTabActive('#Comm');
        resetDaywiseButtonsCommon();
        resetDaywiseViewMode();
        loadCommonDaywiseSlab();
    });
</script>
