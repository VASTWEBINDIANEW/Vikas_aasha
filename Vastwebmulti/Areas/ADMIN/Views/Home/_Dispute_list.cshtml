@model List<Vastwebmulti.Models.all_dispute_list_Result>

@{

    Layout = null;

    var rows = Model ?? new List<Vastwebmulti.Models.all_dispute_list_Result>();

}



@if (rows.Count == 0)

{

    <tr class="saas-dispute-empty-row">

        <td colspan="11" class="saas-pan-empty-cell">No dispute records for selected dates/status. Widen the date range and click <strong>Search</strong>.</td>

    </tr>

}

@foreach (var item in rows)

{

    var sts = (item.sts ?? "").Trim();

    var pending = sts.IndexOf("Pending", StringComparison.OrdinalIgnoreCase) >= 0;

    var rejected = sts.IndexOf("Rejected", StringComparison.OrdinalIgnoreCase) >= 0;

    var approved = sts.IndexOf("Approved", StringComparison.OrdinalIgnoreCase) >= 0;

    var rowClass = pending ? "saas-dispute-row--pending" : rejected ? "saas-dispute-row--rejected" : approved ? "saas-dispute-row--approved" : "saas-dispute-row--neutral";

    var statusLabel = !string.IsNullOrWhiteSpace(sts) ? sts : "Unknown";

    <tr class="saas-dispute-data-row @rowClass">

        <td class="saas-dispute-col-user" data-label="User's Information">

            <div class="saas-dispute-user-card">

                @if (pending)

                {

                    <span class="saas-dispute-status-pill saas-dispute-status-pill--pending">

                        <i class="fas fa-clock" aria-hidden="true"></i><span>Pending</span>

                    </span>

                }

                else if (approved)

                {

                    <span class="saas-dispute-status-pill saas-dispute-status-pill--approved">

                        <i class="fas fa-check-circle" aria-hidden="true"></i><span>Approved</span>

                    </span>

                }

                else if (rejected)

                {

                    <span class="saas-dispute-status-pill saas-dispute-status-pill--rejected">

                        <i class="fas fa-times-circle" aria-hidden="true"></i><span>Rejected</span>

                    </span>

                }

                else

                {

                    <span class="saas-dispute-status-pill saas-dispute-status-pill--neutral">

                        <i class="fas fa-info-circle" aria-hidden="true"></i><span>@statusLabel</span>

                    </span>

                }

                <div class="saas-dispute-user-meta">

                    <span class="saas-dispute-user-role">@(string.IsNullOrWhiteSpace(item.Roles) ? "—" : item.Roles)</span>

                    <i class="fas fa-long-arrow-alt-right saas-dispute-user-sep" aria-hidden="true"></i>

                    <span class="saas-dispute-user-firm">@(string.IsNullOrWhiteSpace(item.Frm_Name) ? "—" : item.Frm_Name)</span>

                </div>

            </div>

        </td>

        <td data-label="Consumer No."><span class="saas-dispute-cell-text">@item.rch_number</span></td>

        <td data-label="Amount"><span class="saas-dispute-amount">@item.rch_amount</span></td>

        <td data-label="Operator"><span class="saas-dispute-cell-text">@item.opt</span></td>

        <td data-label="Port/API"><span class="saas-dispute-cell-text">@item.portno</span></td>

        <td data-label="Dispute Time"><span class="saas-dispute-cell-text saas-dispute-datetime">@(item.dis_time.HasValue ? item.dis_time.Value.ToString("dd-MM-yyyy HH:mm:ss") : "—")</span></td>

        <td data-label="Dispute Description" class="col-details"><span class="saas-dispute-cell-text">@item.dispute_region</span></td>

        <td data-label="Transition ID"><span class="saas-dispute-txn-id">@item.opt_id</span></td>

        <td data-label="Response" class="col-details"><span class="saas-dispute-cell-text">@item.comment</span></td>

        <td data-label="Rch Time"><span class="saas-dispute-cell-text saas-dispute-datetime">@(item.rch_time.HasValue ? item.rch_time.Value.ToString("dd-MM-yyyy HH:mm:ss") : "—")</span></td>

        <td data-label="Action" class="saas-dispute-col-action text-center">

            @if (pending)

            {

                <a href="@Url.Action("ShowAll", "Home", new { idno = item.rch_id, disput = item.dispute_region })"

                   class="saas-dispute-action-btn" title="View dispute">

                    <i class="fas fa-external-link-alt" aria-hidden="true"></i><span>View</span>

                </a>

            }

            else

            {

                <span class="saas-dispute-action-muted">—</span>

            }

        </td>

    </tr>

}

