            </div>
            <div class="modal-footer saas-admin-modal-footer">
                <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal"><i class="fas fa-times" aria-hidden="true"></i> Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    function myFunction() {
        var value = document.getElementById('myInput').value.toLowerCase();
        $('#body tr').filter(function () {
            $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
        });
    }

    function refreshMatmRentalRecordCount() {
        var count = document.querySelectorAll('#matmRentalTable tbody tr:not(.vm-opr-table-empty-row)').length;
        $('#matmRRRecordCount').text(count);
    }

    function exportMatmRentalTable(type) {
        var table = document.getElementById('matmRentalTable');
        if (!table) {
            return;
        }

        var stamp = new Date().toISOString().slice(0, 10);
        var title = 'M-ATM Rental Report';
        var clone = table.cloneNode(true);
        var emptyRow = clone.querySelector('.vm-opr-table-empty-row');
        if (emptyRow) {
            alert('No data available to export.');
            return;
        }

        if (type === 'excel') {
            var excelHtml = '<html><head><meta charset="utf-8"></head><body>' + clone.outerHTML + '</body></html>';
            var blob = new Blob(['\ufeff', excelHtml], { type: 'application/vnd.ms-excel' });
            var link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'MicroAtmRentalReport_' + stamp + '.xls';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            return;
        }

        var printWin = window.open('', '_blank');
        if (!printWin) {
            alert('Please allow pop-ups to export PDF.');
            return;
        }
        printWin.document.write(
            '<html><head><title>' + title + '</title>'
            + '<style>body{font-family:Arial,sans-serif;padding:16px}h3{margin:0 0 12px}table{border-collapse:collapse;width:100%;font-size:9px}th,td{border:1px solid #ccc;padding:3px;text-align:left}th{background:#f3f4f6}</style>'
            + '</head><body><h3>' + title + '</h3>' + clone.outerHTML + '</body></html>'
        );
        printWin.document.close();
        printWin.focus();
        printWin.print();
    }

    function initMatmRentalDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initMatmRentalDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm('#matmRentalReportForm');
        }
    }

    $(document).ready(function () {
        initMatmRentalDatepickers();
        refreshMatmRentalRecordCount();

        $('#btnExportRR').on('click', function () {
            exportMatmRentalTable('excel');
        });

        $('#btnPDFRR').on('click', function () {
            exportMatmRentalTable('pdf');
        });
    });
</script>
