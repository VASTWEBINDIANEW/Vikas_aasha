@model IEnumerable<Vastwebmulti.Models.microatm_rental_report_Result>
@using System.Linq
@{
    ViewBag.Title = "Admin_Microatm_rental_report";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
    var reports = Model ?? Enumerable.Empty<Vastwebmulti.Models.microatm_rental_report_Result>();
    var rowCount = reports.Count();
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-microatm-rental-report-modern.css?v=2" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-microatm-rental-report-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var matmRentalFormAttrs = new Dictionary<string, object>
            {
                { "id", "matmRentalReportForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("Admin_Microatm_rental_report", "Home", FormMethod.Post, matmRentalFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li><a href="@Url.Action("Dashboard", "Home")#setting">Basic Setting</a></li>
                        <li><a href="@Url.Action("MicroAtm_Device_info", "Home")#setting">M-ATM Device's</a></li>
                        <li>Rental Report</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line">

                        <div class="vm-dmt-filter-search-group">
                            <div class="vm-opr-field vm-dmt-field vm-dmt-field--search">
                                <input id="myInput" type="text" name="myInput" class="form-control vm-dmt-search-input" placeholder="Search table..." onkeyup="myFunction()" autocomplete="off" />
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-sim-card" aria-hidden="true"></i>
                        <span>M-ATM rental report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-matm-rr-record-badge" title="Total records">
                            Records: <strong id="matmRRRecordCount">@rowCount</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" id="btnExportRR" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDFRR" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="matmRentalTable" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th class="vm-matm-rr-th--rowspan vm-matm-rr-col--sn" rowspan="2">S.N</th>
                                    <th class="vm-matm-rr-th--rowspan" rowspan="2">Frm&nbsp;Name</th>
                                    <th class="vm-matm-rr-th--rowspan" rowspan="2">DeviceId</th>
                                    <th class="vm-matm-rr-th--rowspan" rowspan="2">Plan&nbsp;Name</th>
                                    <th class="vm-matm-rr-th--rowspan" rowspan="2">Num.of&nbsp;Trans</th>
                                    <th class="vm-matm-rr-th--rowspan" rowspan="2">Trans&nbsp;Date</th>
                                    <th class="vm-matm-rr-th--rowspan" rowspan="2">Curr&nbsp;Date</th>
                                    <th class="vm-matm-rr-th--group vm-matm-rr-th--retailer" colspan="5">Retailer</th>
                                    <th class="vm-matm-rr-th--group vm-matm-rr-th--dealer" colspan="5">Distributor</th>
                                    <th class="vm-matm-rr-th--group vm-matm-rr-th--master" colspan="5">Master</th>
                                </tr>
                                <tr class="vm-matm-rr-head-row--sub">
                                    <th>Pre</th>
                                    <th>Charge</th>
                                    <th>GST</th>
                                    <th>TDS</th>
                                    <th>Post</th>
                                    <th>Pre</th>
                                    <th>Commission</th>
                                    <th>GST</th>
                                    <th>TDS</th>
                                    <th>Post</th>
                                    <th>Pre</th>
                                    <th>Commission</th>
                                    <th>GST</th>
                                    <th>TDS</th>
                                    <th>Post</th>
                                </tr>
                            </thead>
                            <tbody id="body">
                                @{ int i = 1; }
                                @foreach (var item in reports)
                                {
                                    <tr>
                                        <td class="vm-matm-rr-col--sn">@i</td>
                                        <td class="vm-matm-rr-col--firm">@Html.DisplayFor(modelItem => item.Frm_Name)</td>
                                        <td class="vm-matm-rr-col--device">@Html.DisplayFor(modelItem => item.deviceid)</td>
                                        <td class="vm-matm-rr-col--plan">@Html.DisplayFor(modelItem => item.planname)</td>
                                        <td class="vm-matm-rr-col--trans">@Html.DisplayFor(modelItem => item.nooftrans)</td>
                                        <td class="vm-matm-rr-col--date">@Html.DisplayFor(modelItem => item.transdate)</td>
                                        <td class="vm-matm-rr-col--date">@Html.DisplayFor(modelItem => item.currdate)</td>
                                        <td class="vm-matm-rr-amt vm-matm-rr-amt--pre vm-matm-rr-tier-start">@Html.DisplayFor(modelItem => item.rempre)</td>
                                        <td class="vm-matm-rr-amt">@Html.DisplayFor(modelItem => item.remcomm)</td>
                                        <td class="vm-matm-rr-amt">@Html.DisplayFor(modelItem => item.remgst)</td>
                                        <td class="vm-matm-rr-amt">@Html.DisplayFor(modelItem => item.remtds)</td>
                                        <td class="vm-matm-rr-amt vm-matm-rr-amt--post">@Html.DisplayFor(modelItem => item.rempost)</td>
                                        <td class="vm-matm-rr-amt vm-matm-rr-amt--pre vm-matm-rr-tier-start">@Html.DisplayFor(modelItem => item.dlmpre)</td>
                                        <td class="vm-matm-rr-amt">@Html.DisplayFor(modelItem => item.dlmcomm)</td>
                                        <td class="vm-matm-rr-amt">@Html.DisplayFor(modelItem => item.dlmgst)</td>
                                        <td class="vm-matm-rr-amt">@Html.DisplayFor(modelItem => item.dlmtds)</td>
                                        <td class="vm-matm-rr-amt vm-matm-rr-amt--post">@Html.DisplayFor(modelItem => item.dlmpost)</td>
                                        <td class="vm-matm-rr-amt vm-matm-rr-amt--pre vm-matm-rr-tier-start">@Html.DisplayFor(modelItem => item.mdpre)</td>
                                        <td class="vm-matm-rr-amt">@Html.DisplayFor(modelItem => item.mdcomm)</td>
                                        <td class="vm-matm-rr-amt">@Html.DisplayFor(modelItem => item.mdgst)</td>
                                        <td class="vm-matm-rr-amt">@Html.DisplayFor(modelItem => item.mdtds)</td>
                                        <td class="vm-matm-rr-amt vm-matm-rr-amt--post">@Html.DisplayFor(modelItem => item.mdpost)</td>
                                    </tr>
                                    i++;
                                }
                                @if (rowCount == 0)
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="22" class="vm-opr-table-empty">No rental records found for the selected dates.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<!-- Legacy detail modal — trigger currently disabled in the table (see the
