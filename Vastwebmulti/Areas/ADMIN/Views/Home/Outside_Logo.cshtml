<script>
    function vmBrandSetPreviewState(imgSelector, frameSelector, showActions) {
        var $img = $(imgSelector);
        var $frame = $img.closest('.vm-brand-card__preview-frame');
        if (!$frame.length && frameSelector) {
            $frame = $(frameSelector);
        }
        if (showActions) {
            $frame.removeClass('is-empty');
            $img.closest('.vm-brand-card__current').find('.vm-brand-card__actions .vm-logo-action-btn').removeClass('is-hidden');
        } else {
            $img.attr('src', '');
            $frame.addClass('is-empty');
            $img.closest('.vm-brand-card__current').find('.vm-brand-card__actions .vm-logo-action-btn').addClass('is-hidden');
        }
    }

    function vmBrandApplyHeaderBg(color) {
        var $frame = $('.vm-brand-card__preview-frame--header');
        if (color === 'transparent') {
            $frame.attr('data-bg', 'transparent').css('background', 'repeating-conic-gradient(#e2e8f0 0% 25%, #fff 0% 50%) 50% / 12px 12px');
        } else if (color === '#000') {
            $frame.attr('data-bg', 'black').css('background', '#0f172a');
        } else {
            $frame.attr('data-bg', 'white').css('background', '#ffffff');
        }
    }

    $(document).ready(function () {
        var initColor = $("input[name='radio']:checked").val() || '#fff';
        vmBrandApplyHeaderBg(initColor);
    });
</script>

