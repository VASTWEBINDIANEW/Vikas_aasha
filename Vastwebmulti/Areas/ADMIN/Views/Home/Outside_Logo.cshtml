<script>
    $('.for-disable').click(function () {

        $(this).prop('disabled', true);
        $(this).css('cursor', 'no-drop');
    });

    $(document).ready(() => {
        var themebox = document.getElementById('themebox');
        if (themebox) {
            themebox.style.backgroundImage = `linear-gradient(to right, ${$('#clr1').val()}, ${$('#clr2').val()})`;
        }

        // Quick section nav — tab show/hide (one panel at a time)
        var $navLinks = $('.vm-logo-quick-nav__link');
        var $quickNav = $('.vm-logo-quick-nav');
        var $pageRoot = $('.saas-outside-logo-page');
        var $tabSections = $('.vm-logo-page-body > .vm-logo-section');
        var $frontDivider = $('.vm-logo-page-body > .vm-logo-front-divider');

        function vmLogoShowTab(targetSelector, updateHash) {
            if (!targetSelector || targetSelector.indexOf('#') !== 0) return;
            var $target = $(targetSelector);
            if (!$target.length) return;

            $tabSections.removeClass('is-tab-active').attr('aria-hidden', 'true');
            $frontDivider.removeClass('is-tab-active');

            $target.addClass('is-tab-active').attr('aria-hidden', 'false');

            if (targetSelector === '#vmLogoFrontThemes') {
                $frontDivider.addClass('is-tab-active');
            }

            $navLinks.removeClass('is-active').attr('aria-selected', 'false');
            var $activeLink = $navLinks.filter('[href="' + targetSelector + '"]');
            $activeLink.addClass('is-active').attr('aria-selected', 'true');
            vmLogoScrollNavToLink($activeLink);

            if (updateHash !== false && history.replaceState) {
                history.replaceState(null, '', targetSelector);
            }

            var $toolbar = $('.vm-logo-page-toolbar');
            if ($toolbar.length) {
                $('html, body').animate({ scrollTop: $toolbar.offset().top - 90 }, 180);
            }
        }

        function vmLogoScrollNavToLink($link) {
            if (!$link || !$link.length || !$quickNav.length) return;
            var nav = $quickNav[0];
            var link = $link[0];
            var targetLeft = link.offsetLeft - (nav.clientWidth / 2) + (link.offsetWidth / 2);
            nav.scrollTo({
                left: Math.max(0, targetLeft),
                behavior: 'smooth'
            });
        }

        function vmLogoUpdateNavScrollFade() {
            var $wrap = $('.vm-logo-quick-nav-scroll');
            if (!$wrap.length || !$quickNav.length) return;
            var nav = $quickNav[0];
            $wrap.toggleClass('is-scrollable', nav.scrollWidth > nav.clientWidth + 2);
        }

        if ($navLinks.length) {
            $pageRoot.addClass('vm-logo-tabs-ready');

            $navLinks.on('click', function (e) {
                var target = $(this).attr('href');
                if (target && target.indexOf('#') === 0) {
                    e.preventDefault();
                    vmLogoShowTab(target);
                }
            });

            var initialTarget = window.location.hash;
            if (!initialTarget || !$(initialTarget).length) {
                initialTarget = ($navLinks.filter('.is-active').attr('href') || '#vmLogoBrand');
            }
            vmLogoShowTab(initialTarget, false);

            vmLogoScrollNavToLink($navLinks.filter('.is-active').first());
            vmLogoUpdateNavScrollFade();
            $(window).on('resize.vmLogoNav', vmLogoUpdateNavScrollFade);
        }

        // Theme preview popup — mobile/tablet layout fix
        function vmThemeIsCompact() {
            return window.innerWidth <= 991;
        }

        function vmThemeGetMainSelector($thumbBox) {
            var classes = ($thumbBox.attr('class') || '').split(/\s+/);
            for (var i = 0; i < classes.length; i++) {
                if (classes[i].indexOf('zooma-thumbnail') === 0) {
                    return '.' + classes[i].replace('zooma-thumbnail', 'zooma-main');
                }
            }
            return '[class*="zooma-main"]';
        }

        function vmThemePopupFix($popup) {
            if (!$popup || !$popup.length) {
                $popup = $('#vmLogoFrontThemes .popup.show');
            }
            if (!$popup.length) return;

            var isCompact = vmThemeIsCompact();
            $popup.toggleClass('vm-theme-popup--mobile', isCompact);
            if (!isCompact) return;

            $popup.find('.product.wrapper').each(function () {
                var $wrap = $(this);
                var $thumb = $wrap.find('[class*="zooma-thumbnail"]').first();
                var $main = $wrap.find('[class*="zooma-main"]').first();
                if (!$main.length) return;

                if ($thumb.length && !$thumb.children().length) {
                    $main.children('img').clone().appendTo($thumb);
                }

                if (!$main.find('img.is-active').length) {
                    $main.find('img').removeClass('is-active');
                    $main.find('img').first().addClass('is-active');
                }
                if ($thumb.length && !$thumb.find('img.is-active').length) {
                    $thumb.find('img').removeClass('is-active');
                    $thumb.find('img').first().addClass('is-active');
                }

                var mainEl = $main[0];
                mainEl.style.setProperty('width', '100%', 'important');
                mainEl.style.setProperty('height', 'auto', 'important');
                mainEl.style.setProperty('min-height', '52vh', 'important');
                mainEl.style.setProperty('max-width', '100%', 'important');
                mainEl.style.setProperty('max-height', 'none', 'important');
                mainEl.style.setProperty('overflow', 'auto', 'important');
                mainEl.style.setProperty('float', 'none', 'important');
                mainEl.style.setProperty('position', 'relative', 'important');

                $main.find('img').each(function () {
                    var active = $(this).hasClass('is-active');
                    $(this).removeClass('is-zoomed-in').off('mousemove');
                    this.style.setProperty('position', 'static', 'important');
                    this.style.setProperty('width', '100%', 'important');
                    this.style.setProperty('max-width', '100%', 'important');
                    this.style.setProperty('height', 'auto', 'important');
                    this.style.setProperty('left', 'auto', 'important');
                    this.style.setProperty('top', 'auto', 'important');
                    this.style.setProperty('display', active ? 'block' : 'none', 'important');
                    this.style.setProperty('opacity', '1', 'important');
                    this.style.setProperty('pointer-events', 'none', 'important');
                });
            });
        }

        function vmThemeSchedulePopupFix($popup) {
            [0, 80, 200, 450, 800].forEach(function (delay) {
                setTimeout(function () { vmThemePopupFix($popup); }, delay);
            });
        }

        $(document).on('click', '[id^="myButton"]', function () {
            var $popup = $('#' + $(this).attr('id').replace(/^myButton/, 'myPopup'));
            vmThemeSchedulePopupFix($popup);
        });

        $(document).on('click', '#vmLogoFrontThemes [class*="zooma-thumbnail"] img', function () {
            var $img = $(this);
            var $popup = $img.closest('.popup');
            var $thumbBox = $img.parent();
            var idx = $img.index();
            var mainSel = vmThemeGetMainSelector($thumbBox);
            var $main = $popup.find(mainSel).first();

            $thumbBox.find('img').removeClass('is-active');
            $img.addClass('is-active');
            $main.find('img').removeClass('is-active is-zoomed-in').off('mousemove');
            $main.find('img').eq(idx).addClass('is-active');
            vmThemePopupFix($popup);
        });

        $(window).on('resize.vmThemePopup', function () {
            vmThemePopupFix($('#vmLogoFrontThemes .popup.show'));
        });

        if (vmThemeIsCompact()) {
            setTimeout(function () { vmThemePopupFix($()); }, 600);
        }
    })

    $('.clr_color').change(() => {
        var themebox = document.getElementById('themebox');
        if (themebox) {
            themebox.style.backgroundImage = `linear-gradient(to right, ${$('#clr1').val()}, ${$('#clr2').val()})`;
        }
    });
    // document.documentElement.style.setProperty('--main-bg-lcolor', '#099678');
</script>