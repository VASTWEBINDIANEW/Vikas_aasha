@model Vastwebmulti.Areas.ADMIN.Models.Email_ViewModel

<div class="es-history-table-wrap">
    <table class="table es-history-table" cellspacing="0">
        <thead>
            <tr>
                <th>Mail Details</th>
                <th>Message</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Sent_Mail_History.Count == 0)
            {
                <tr class="vm-opr-table-empty-row">
                    <td colspan="2" class="vm-opr-table-empty vm-dmt-table-empty">
                        <i class="fas fa-inbox" aria-hidden="true"></i>
                        <span>No email history found.</span>
                    </td>
                </tr>
            }
            else
            {
                foreach (var item in Model.Sent_Mail_History)
                {
                    var urole = item.UserId == "Master" ? "MD" : item.UserId == "Dealer" ? "Distributor" : item.UserId == "Retailer" ? "Retailer" : item.UserId == "API" ? "API" : item.UserId == "Whitelabel" ? "W/L" : item.UserId == "Admin" ? "Admin" : item.UserId == null ? "I" : string.Empty;

                    <tr>
                        <td class="es-history-mail">
                            <div class="es-history-mail__top">
                                <span class="es-history-mail__email">@item.Mail_Id</span>
                            </div>
                            <div class="es-history-mail__meta">
                                @if (!string.IsNullOrWhiteSpace(urole))
                                {
                                    <span class="es-role-pill">@urole</span>
                                }
                                <span class="es-history-date"><i class="far fa-clock" aria-hidden="true"></i> @item.SentDate</span>
                            </div>
                        </td>
                        <td class="es-history-msg">
                            <p>
                                @try
                                {
                                    if (@TempData["showmassage"] != "yes1")
                                    {
                                        if (item.SentMsg.ToUpper().Contains(".CO") || item.SentMsg.ToUpper().Contains(".NET") || item.SentMsg.ToUpper().Contains(".IN"))
                                        {
                                            var msg = item.SentMsg.ToUpper().Replace("WWW.", "").Replace("HTTPS://", "").Replace("HTTP://", "");
                                            msg = "http://" + msg;
                                            <a href="@msg" target="_blank">@msg</a>
                                        }
                                        else if (item.SentMsg.ToUpper().Contains("YOUR NEW PASSWORD IS"))
                                        {
                                            <span>Your New Password is ******@item.SentMsg[27]@item.SentMsg[28]</span>
                                        }
                                        else if (item.SentMsg.ToUpper().Contains("EMAIL SHOW PASSCODE IS"))
                                        {
                                            <span>Email Show Passcode is **@item.SentMsg[item.SentMsg.Length - 2]@item.SentMsg[item.SentMsg.Length - 1]</span>
                                        }
                                        else if (item.SentMsg.ToUpper().Contains("YOUR TRANSACTION PASSWORD IS"))
                                        {
                                            <span>Your Transaction Password Is ****@item.SentMsg[34]@item.SentMsg[35]</span>
                                        }
                                        else if (item.SentMsg.ToUpper().Contains("YOUR SECURITY PASSWORD IS"))
                                        {
                                            <span>Your Security Password Is ****@item.SentMsg[31]@item.SentMsg[32]</span>
                                        }
                                        else if (item.SentMsg.ToUpper().Contains("YOUR PASSCODE VALID FOR"))
                                        {
                                            <span>Your Passcode ****@item.SentMsg[19]@item.SentMsg[20] Your Passcode valid for @item.SentMsg[item.SentMsg.Length - 21]@item.SentMsg[item.SentMsg.Length - 20]@item.SentMsg[item.SentMsg.Length - 19]@item.SentMsg[item.SentMsg.Length - 18]@item.SentMsg[item.SentMsg.Length - 17]@item.SentMsg[item.SentMsg.Length - 16]@item.SentMsg[item.SentMsg.Length - 15]@item.SentMsg[item.SentMsg.Length - 14]@item.SentMsg[item.SentMsg.Length - 13]@item.SentMsg[item.SentMsg.Length - 12]@item.SentMsg[item.SentMsg.Length - 11]@item.SentMsg[item.SentMsg.Length - 10]@item.SentMsg[item.SentMsg.Length - 9]@item.SentMsg[item.SentMsg.Length - 8]@item.SentMsg[item.SentMsg.Length - 7]@item.SentMsg[item.SentMsg.Length - 6]@item.SentMsg[item.SentMsg.Length - 5]@item.SentMsg[item.SentMsg.Length - 4]@item.SentMsg[item.SentMsg.Length - 3]@item.SentMsg[item.SentMsg.Length - 2]@item.SentMsg[item.SentMsg.Length - 1]</span>
                                        }
                                        else if (item.SentMsg.ToUpper().Contains("YOUR NEW TRANSACTION PASSWORD IS"))
                                        {
                                            <span>Your New Transaction Password Is ****@item.SentMsg[38]@item.SentMsg[39]</span>
                                        }
                                        else if (item.SentMsg.ToUpper().Contains("THE OTP FOR YOUR IP ADDRESS"))
                                        {
                                            <span>****@item.SentMsg[4]@item.SentMsg[5] is the OTP For Your ip Address @item.SentMsg[item.SentMsg.Length - 14]@item.SentMsg[item.SentMsg.Length - 13]@item.SentMsg[item.SentMsg.Length - 12]@item.SentMsg[item.SentMsg.Length - 11]@item.SentMsg[item.SentMsg.Length - 10]@item.SentMsg[item.SentMsg.Length - 9]@item.SentMsg[item.SentMsg.Length - 8]@item.SentMsg[item.SentMsg.Length - 7]@item.SentMsg[item.SentMsg.Length - 6]@item.SentMsg[item.SentMsg.Length - 5]@item.SentMsg[item.SentMsg.Length - 4]@item.SentMsg[item.SentMsg.Length - 3]@item.SentMsg[item.SentMsg.Length - 2]@item.SentMsg[item.SentMsg.Length - 1]</span>
                                        }
                                        else
                                        {
                                            @item.SentMsg
                                        }
                                    }
                                    else
                                    {
                                        var a = Convert.ToString(TempData["showmassage"]);
                                        TempData["1234"] = a;
                                        @item.SentMsg
                                    }
                                }
                                catch
                                {
                                    @item.SentMsg
                                }
                            </p>
                            <div style="word-break:break-all" id="demo-@item.Idno" class="collapse">
                                @item.SentMsg
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
