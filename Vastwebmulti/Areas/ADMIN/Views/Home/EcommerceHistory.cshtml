@model IEnumerable<Vastwebmulti.Models.show_ecomm_report_Result>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Ecommerce History";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
    var reports = Model ?? Enumerable.Empty<Vastwebmulti.Models.show_ecomm_report_Result>();
    var rowCount = reports.Count();

    decimal totalSuccess = ViewData["Totals"] != null ? Convert.ToDecimal(ViewData["Totals"]) : 0m;
    decimal totalPending = ViewData["Totalp"] != null ? Convert.ToDecimal(ViewData["Totalp"]) : 0m;
    decimal totalFailed = ViewData["Totalf"] != null ? Convert.ToDecimal(ViewData["Totalf"]) : 0m;
    decimal totalAmount = totalSuccess + totalPending + totalFailed;
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=37" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=22" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var ecommFormAttrs = new Dictionary<string, object>
            {
                { "id", "ecommerceHistoryForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("EcommerceHistory", "Home", FormMethod.Post, ecommFormAttrs))
        {
            @Html.Hidden("ddl_top", 50)

            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Ecommerce</li>
                        <li>Ecommerce History</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters vm-ecomm-filter-row--one-line">

                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("ddlusers", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "All User", Value = "Admin" },
                                new SelectListItem { Text = "Master D", Value = "Master" },
                                new SelectListItem { Text = "Distributor", Value = "Dealer" },
                                new SelectListItem { Text = "Retailer", Value = "Retailer" },
                                new SelectListItem { Text = "Vendor", Value = "Vendor" }
                            }, new { @id = "ddlusers", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="allvendor" hidden>
                            @Html.DropDownList("allvendor", ViewBag.allvendor as SelectList, "All Vendor", new { @id = "allvendorSelect", @class = "vm-opr-select vm-dmt-select form-control allmasters" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="allmaster" hidden>
                            @Html.DropDownList("allmaster", ViewBag.allmaster as SelectList, "All Master", new { @id = "allmasterSelect", @class = "vm-opr-select vm-dmt-select form-control allmasters" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="dlm" hidden>
                            @Html.DropDownList("alldealer", ViewBag.alldealer as SelectList, "All Distributor", new { id = "alldealer", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="rem" hidden>
                            @Html.DropDownList("allretailer", ViewBag.allretailer as SelectList, "All Retailer", new { id = "allretailer", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("Cateid", ViewBag.category as SelectList, "Select Category", new { id = "Cateid", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("ddl_status", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "All Status", Value = "ALL" },
                                new SelectListItem { Text = "Success", Value = "2" },
                                new SelectListItem { Text = "Pending", Value = "1" },
                                new SelectListItem { Text = "Rejected", Value = "3" }
                            }, new { @id = "ddl_status", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" name="submit" value="Old" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="ecommerceHistoryTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Ecommerce history totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideEcommerceHistoryTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--primary">
                            <span class="vm-opr-total-card__label">Total Amount</span>
                            <strong class="vm-opr-total-card__value" id="ecommTotalAmount">@totalAmount.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Success</span>
                            <strong class="vm-opr-total-card__value" id="successtotal">@totalSuccess.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Rejected</span>
                            <strong class="vm-opr-total-card__value" id="Failedtotal">@totalFailed.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Pending</span>
                            <strong class="vm-opr-total-card__value" id="Pendingtotal">@totalPending.ToString("N2")</strong>
                        </div>
                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-shopping-bag" aria-hidden="true"></i>
                        <span>Ecommerce order history</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong>@rowCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total" title="Total amount for current filter">
                            Total: <strong>? @totalAmount.ToString("N2")</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-ecomm-totals-btn" onclick="findtotalA()" title="Show totals" aria-expanded="false" aria-controls="ecommerceHistoryTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnExportA" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDFA" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="ecommerceHistoryReport" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Sr&nbsp;No.</th>
                                    <th>Live&nbsp;Status</th>
                                    <th>Users&nbsp;Registration&nbsp;Information</th>
                                    <th>Order&nbsp;Date</th>
                                    <th>Product&nbsp;Name</th>
                                    <th>MRP&nbsp;Price</th>
                                    <th>Product&nbsp;Price</th>
                                    <th>Qty</th>
                                    <th>Total&nbsp;Amount</th>
                                    <th><span>User&nbsp;Role</span><span style="padding-left:4px;">?</span><span style="padding-left:8px;">Pre&nbsp;Amt&nbsp;</span><span style="padding-left:2px;">¦</span><span style="padding-left:3px;">Net&nbsp;INC</span><span style="padding-left:2px;">¦</span><span style="padding-left:2px;">Post&nbsp;Amt</span></th>
                                    <th><span>Dealer</span><span style="padding-left:4px;">?</span><span style="padding-left:8px;">Pre&nbsp;Amt&nbsp;</span><span style="padding-left:2px;">¦</span><span style="padding-left:3px;">Net&nbsp;INC</span><span style="padding-left:2px;">¦</span><span style="padding-left:2px;">Post&nbsp;Amt</span></th>
                                    <th><span>Master</span><span style="padding-left:4px;">?</span><span style="padding-left:8px;">Pre&nbsp;Amt&nbsp;</span><span style="padding-left:2px;">¦</span><span style="padding-left:3px;">Net&nbsp;INC</span><span style="padding-left:2px;">¦</span><span style="padding-left:2px;">Post&nbsp;Amt</span></th>
                                    <th><span>Whitelabel</span><span style="padding-left:4px;">?</span><span style="padding-left:8px;">Pre&nbsp;Amt&nbsp;</span><span style="padding-left:2px;">¦</span><span style="padding-left:3px;">Net&nbsp;INC</span><span style="padding-left:2px;">¦</span><span style="padding-left:2px;">Post&nbsp;Amt</span></th>
                                    <th><span>Admin</span><span style="padding-left:4px;">?</span><span style="padding-left:8px;">Pre&nbsp;Amt&nbsp;</span><span style="padding-left:2px;">¦</span><span style="padding-left:3px;">Net&nbsp;INC</span><span style="padding-left:2px;">¦</span><span style="padding-left:2px;">Post&nbsp;Amt</span></th>
                                    <th>Approved&nbsp;Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @Html.Partial("_EcommerceHistoryRows", reports)
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<script src="~/MainFrontDesign/select2/dist/js/select2.full.min.js"></script>

<script>
    function formatEcommAmount(value) {
        var num = parseFloat(value);
        if (isNaN(num)) {
            return '0.00';
        }
        return num.toFixed(2);
    }

    function hideEcommerceHistoryTotals() {
        var $panel = $('#ecommerceHistoryTotalsPanel');
        var $btn = $('.vm-ecomm-totals-btn');
        $panel.hide().attr('aria-hidden', 'true');
        $btn.attr('aria-expanded', 'false');
    }

    function findtotalA() {
        var $panel = $('#ecommerceHistoryTotalsPanel');
        var $btn = $('.vm-ecomm-totals-btn');
        if ($panel.is(':visible')) {
            hideEcommerceHistoryTotals();
            return;
        }
        $panel.show().attr('aria-hidden', 'false');
        $btn.attr('aria-expanded', 'true');
    }

    function exportEcommerceHistoryTable(type) {
        var table = document.getElementById('ecommerceHistoryReport');
        if (!table) {
            return;
        }

        var stamp = new Date().toISOString().slice(0, 10);
        var title = 'Ecommerce History';
        var clone = table.cloneNode(true);
        var emptyRow = clone.querySelector('.vm-opr-table-empty-row');
        if (emptyRow) {
            alert('No data available to export.');
            return;
        }

        if (type === 'excel') {
            var excelHtml = '<html><head><meta charset="utf-8"></head><body>' + clone.outerHTML + '</body></html>';
            var blob = new Blob(['\ufeff', excelHtml], { type: 'application/vnd.ms-excel' });
            var link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'EcommerceHistory_' + stamp + '.xls';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            return;
        }

        var printWin = window.open('', '_blank');
        if (!printWin) {
            alert('Please allow pop-ups to export PDF.');
            return;
        }
        printWin.document.write(
            '<html><head><title>' + title + '</title>'
            + '<style>body{font-family:Arial,sans-serif;padding:16px}h3{margin:0 0 12px}table{border-collapse:collapse;width:100%;font-size:10px}th,td{border:1px solid #ccc;padding:4px;text-align:left}th{background:#f3f4f6}</style>'
            + '</head><body><h3>' + title + '</h3>' + clone.outerHTML + '</body></html>'
        );
        printWin.document.close();
        printWin.focus();
        printWin.print();
    }

    var ecommExtraWrapSelectors = ['#allvendor', '#allmaster', '#dlm', '#rem'];
    var ecommExtraSelectSelectors = ['#allvendorSelect', '#allmasterSelect', '#alldealer', '#allretailer'];

    function destroyEcommSelect2($el) {
        if ($el && $el.length && $el.data('select2')) {
            $el.select2('destroy');
        }
    }

    function applyEcommSelect2($el) {
        if (!$el || !$el.length || !$.fn.select2) {
            return;
        }
        destroyEcommSelect2($el);
        $el.select2({
            width: '100%',
            minimumResultsForSearch: 6
        });
    }

    function hideEcommFilterExtras() {
        $(ecommExtraWrapSelectors.join(', ')).each(function () {
            $(this).removeClass('is-visible').attr('hidden', 'hidden');
        });
        $(ecommExtraSelectSelectors.join(', ')).each(function () {
            destroyEcommSelect2($(this));
        });
    }

    function showEcommFilterExtra(selector) {
        var $wrap = $(selector);
        $wrap.addClass('is-visible').removeAttr('hidden');
        var $select = $wrap.find('select');
        applyEcommSelect2($select);
        if ($select.length && $select.data('select2')) {
            $select.next('.select2-container').css('width', '100%');
        }
    }

    function ecommHistoryAnswers() {
        var answer = $('#ddlusers').val();
        hideEcommFilterExtras();

        if (answer === 'Dealer') {
            showEcommFilterExtra('#dlm');
        } else if (answer === 'Vendor') {
            showEcommFilterExtra('#allvendor');
        } else if (answer === 'Master') {
            showEcommFilterExtra('#allmaster');
        } else if (answer === 'Retailer') {
            showEcommFilterExtra('#rem');
        }
    }

    function initEcommerceHistorySelect2() {
        applyEcommSelect2($('#ddlusers'));
        applyEcommSelect2($('#Cateid'));
        applyEcommSelect2($('#ddl_status'));
        $('#ddlusers').off('change.ecommHistory').on('change.ecommHistory', ecommHistoryAnswers);
    }

    function initEcommerceHistoryDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initEcommerceHistoryDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm('#ecommerceHistoryForm');
        }
    }

    $(document).ready(function () {
        initEcommerceHistorySelect2();
        ecommHistoryAnswers();
        initEcommerceHistoryDatepickers();

        $('#ecommerceHistoryForm .select2-container').css('width', '100%');

        $('#btnExportA').on('click', function () {
            exportEcommerceHistoryTable('excel');
        });
        $('#btnPDFA').on('click', function () {
            exportEcommerceHistoryTable('pdf');
        });
    });
</script>
