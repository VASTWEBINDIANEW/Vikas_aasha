@model IEnumerable<Vastwebmulti.Models.Retailer_to_Dealer>
@{
    ViewBag.Title = "Retailer_to_dealer";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-fund-transfer-modern.css?v=27" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-fund-transfer-mobile.css?v=23" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-master-list-modern.css?v=19" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-api-user-page.css?v=9" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-retailer-to-dealer-page.css?v=14" rel="stylesheet" />

<section class="content Retailer_to_dealer_Page Api_user_Page Masterlist-page saas-admin-account-page saas-admin-report-page saas-fund-transfer-page saas-fund-user-page saas-master-list-page saas-fund-transfer-premium">

    <div class="container-fluid vm-ft-page-shell">

        <div class="vm-ft-page-toolbar vm-ft-page-toolbar--premium rtd-page-toolbar">
            <div class="vm-ft-page-hero">
                <ol class="vm-ft-breadcrumb">
                    <li><a href="@Url.Action("Dashboard","Home")"><i class="fas fa-home"></i> Dashboard</a></li>
                    <li>User's &amp; Account</li>
                    <li>Retailer To Distributor Transfer</li>
                </ol>
            </div>
            <div class="vm-ft-search-wrap rtd-top-search-wrap">
                <div class="rtd-search-wrap">
                    <i class="fas fa-search rtd-search-icon" aria-hidden="true"></i>
                    <input class="form-control rtd-search-input" type="text" id="rtdSearchInput"
                           placeholder="Search role, name, firm, mobile..." onkeyup="rtdSearchTable()" autocomplete="off" />
                </div>
            </div>
        </div>

        <div class="col-md-12 vm-ft-layout-wrap">
            <div class="row clearfix vm-ft-layout vm-ft-layout--full">

                <!-- LEFT: Transfer Form -->
                <div class="col-md-4 col-sm-12 vm-ft-form-col">
                    <div class="fund-trasfer-left fund-user-left vm-ft-form-card">
                        <div class="vm-ft-form-card-header">
                            <div class="vm-ft-form-card-header__icon"><i class="fas fa-exchange-alt"></i></div>
                            <div>
                                <span class="vm-ft-form-card-header__title">Retailer Transfer</span>
                                <span class="vm-ft-form-card-header__sub">Move retailer under master distributor</span>
                            </div>
                        </div>

                        <div class="au-tabs">
                            <button type="button" class="au-tab-btn active" disabled>
                                <i class="fas fa-user-check"></i> Transfer Setup
                            </button>
                        </div>

                        <div class="au-tab-content active rtd-form-body">
                            <form id="newsletter-form" method="post" onsubmit="return false;">
                                <div id="hideretailer" class="form-group">
                                    <label><i class="fas fa-store rtd-label-icon"></i> Retailer Details</label>
                                    @Html.DropDownList("allretailer", ViewBag.retailer as SelectList, "All Retailer", new { id = "allretailer", @class = "form-control rtd-select" })
                                </div>

                                <div id="hidedealer" class="form-group">
                                    <label><i class="fas fa-user-tie rtd-label-icon"></i> Master Distributor Details</label>
                                    @Html.DropDownList("allDetails", ViewBag.superinfo as SelectList, "All Master Distributor", new { id = "allDetails", @class = "form-control rtd-select" })
                                </div>

                                <div id="hideotp" class="form-group" style="display:none;">
                                    <label><i class="fas fa-key rtd-label-icon"></i> OTP</label>
                                    @Html.TextBox("txtotp", "", new { @class = "form-control", @placeholder = "Enter OTP sent to admin email" })
                                    <p class="rtd-otp-note"><i class="fas fa-info-circle"></i> OTP has been sent to admin registered email.</p>
                                </div>

                                <label class="rtd-msg-error" id="lblmsg"></label>

                                <div class="vm-ml-form-actions rtd-form-actions">
                                    <button class="btn vm-ml-btn-reset" type="reset" onclick="rtdResetForm()">Reset</button>
                                    <button type="button" id="btnshowdetails" class="btn vm-ml-btn-submit rtd-btn-primary">
                                        <i class="fas fa-paper-plane" style="margin-right:5px;"></i>Submit
                                    </button>
                                    <button type="button" id="btnshowdetailsotp" class="btn vm-ml-btn-submit rtd-btn-primary rtd-btn-hidden" hidden>
                                        <i class="fas fa-check-circle" style="margin-right:5px;"></i>Verify OTP
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- RIGHT: History Table -->
                <div class="col-md-8 col-sm-12 fund-transfer-main-admin vm-ft-history-col rtd-history-col">
                    <div class="fund-trasfer-right fund-user-right vm-ft-history-panel">
                        <div class="vm-ft-history-body">

                            <div class="vm-ft-history-toolbar vm-ft-history-toolbar--premium vm-ml-list-toolbar">
                                <div class="vm-ml-list-toolbar__row rtd-history-toolbar-row">
                                    <div class="vm-ft-history-toolbar__head vm-ml-list-toolbar__head">
                                        <i class="fas fa-history" aria-hidden="true"></i>
                                        <div class="vm-ml-list-toolbar__text">
                                            <span class="vm-ft-history-toolbar__title">Transfer History</span>
                                            <span class="vm-ft-history-toolbar__sub">Retailer to master distributor transfer records</span>
                                        </div>
                                    </div>

                                    @{
                                        var rtdFormAttrs = new Dictionary<string, object>
                                        {
                                            { "id", "rtdHistoryForm" },
                                            { "class", "vm-rpt-filters-panel__form rtd-filter-form" },
                                            { "data-date-mode", dateMode },
                                            { "data-frm-date", frmDate },
                                            { "data-to-date", toDate },
                                            { "data-report-date-form", "true" }
                                        };
                                    }
                                    <div class="rtd-toolbar-filters-wrap">
                                        <div class="rtd-prepaid-date-shell">
                                            @using (Html.BeginForm("Retailer_to_dealer", "Home", FormMethod.Post, rtdFormAttrs))
                                            {
                                                <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-gift-filter-row--one-line">
                                                    <div class="vm-dmt-filter-search-group">
                                                        <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                                            <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                                            @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                                                        </div>
                                                        <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                                            <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                                            @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                                                        </div>
                                                        <button type="submit" name="btntype" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                                            <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="vm-ml-table-host rtd-table-host">
                                <p class="rtd-table-scroll-hint" aria-hidden="true"><i class="fas fa-arrows-alt-h"></i> Swipe table to see all columns</p>
                                <div class="table-responsive vm-ml-table-scroll saas-acc-table-wrap rtd-table-scroll-wrap">
                                    <table class="table table-bordered saas-acc-table vm-ml-data-table third-design-table" id="rtdList">
                                        <thead>
                                            <tr>
                                                <th>Sr</th>
                                                <th>Role</th>
                                                <th>Name</th>
                                                <th>Firm</th>
                                                <th>Mobile</th>
                                                <th>Balance</th>
                                                <th>Date</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @{
                                                var sr = 1;
                                                foreach (var item in Model)
                                                {
                                                    <tr>
                                                        <td>@sr</td>
                                                        <td><span class="rtd-role-badge">@item.Role</span></td>
                                                        <td><strong>@item.Name</strong></td>
                                                        <td>@item.Firmname</td>
                                                        <td style="font-weight:600;">@item.Mobile</td>
                                                        <td class="rtd-balance">@item.Remainbal</td>
                                                        <td class="rtd-date">@(item.insertdate.HasValue ? item.insertdate.Value.ToString("dd-MM-yyyy HH:mm") : "")</td>
                                                    </tr>
                                                    sr++;
                                                }
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<script src="~/AdminDesign/plugins/jquery/jquery.min.js"></script>
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script src="~/AdminDesign/js/demo.js"></script>
<script src="~/AdminDesign/js/pages/forms/basic-form-elements.js"></script>
<script src="~/AdminDesign/plugins/jquery-slimscroll/jquery.slimscroll.js"></script>
<script src="~/MainFrontDesign/js/admin-report-datepicker.js?v=2"></script>

<script>
    function rtdInitSelect2() {
        if (window.refreshAdminSelect2) {
            window.refreshAdminSelect2($('#allretailer, #allDetails').closest('section'));
        }
    }

    function rtdResetForm() {
        $('#lblmsg').text('');
        $('#hideotp').hide();
        $('#hideretailer, #hidedealer').show();
        $('#btnshowdetails').removeClass('rtd-btn-hidden').prop('hidden', false).show();
        $('#btnshowdetailsotp').addClass('rtd-btn-hidden').prop('hidden', true).hide();
        $('#txtotp').val('');
    }

    function rtdSearchTable() {
        var input = document.getElementById('rtdSearchInput');
        if (!input) return;
        var filter = input.value.toUpperCase();
        var table = document.getElementById('rtdList');
        if (!table) return;
        var tr = table.getElementsByTagName('tr');
        for (var i = 1; i < tr.length; i++) {
            var tds = tr[i].getElementsByTagName('td');
            var found = false;
            for (var j = 0; j < tds.length; j++) {
                if (tds[j].innerHTML.toUpperCase().indexOf(filter) > -1) {
                    found = true;
                    break;
                }
            }
            tr[i].style.display = found ? '' : 'none';
        }
    }

    function rtdInitDatepickers() {
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm('#rtdHistoryForm');
        }
    }

    $(document).ready(function () {
        rtdInitSelect2();
        rtdInitDatepickers();
    });

    $('#btnshowdetails').click(function () {
        var rem = $('#allretailer').val();
        var dlm = $('#allDetails').val();
        $('#lblmsg').text('');
        if (rem !== '' && dlm !== '') {
            $.ajax({
                url: '@Url.Action("Transfer_Retailer_to_dealer", "Home")',
                method: 'GET',
                data: { rem: rem, dlm: dlm },
                success: function (data) {
                    if (data === 'OTP') {
                        $('#hideretailer').hide();
                        $('#hidedealer').hide();
                        $('#hideotp').show();
                        $('#btnshowdetails').addClass('rtd-btn-hidden').prop('hidden', true).hide();
                        $('#btnshowdetailsotp').removeClass('rtd-btn-hidden').prop('hidden', false).show();
                        swal('OTP Sent', 'Please check admin email and enter OTP.', 'info');
                    }
                },
                error: function () {
                    $('#lblmsg').text('Unable to send OTP. Please try again.');
                }
            });
        } else {
            $('#lblmsg').text('Select Retailer and Master Distributor');
        }
    });

    $('#btnshowdetailsotp').click(function () {
        var rem = $('#allretailer').val();
        var dlm = $('#allDetails').val();
        var otp = $('#txtotp').val();
        $('#lblmsg').text('');
        if (rem !== '' && dlm !== '') {
            if (otp !== '') {
                $.ajax({
                    url: '@Url.Action("Transfer_Retailer_to_dealer_Verify_OTP", "Home")',
                    method: 'GET',
                    data: { rem: rem, dlm: dlm, otp: otp },
                    success: function (data) {
                        if (data === 'Register SuccessFully.') {
                            swal('Success', 'Retailer transferred successfully.', 'success', function () {
                                location.reload(true);
                            });
                        } else if (data === 'OTPMissmatch') {
                            $('#lblmsg').text('Invalid OTP. Please try again.');
                        } else {
                            $('#lblmsg').text(data);
                            swal('Failed', data, 'error');
                        }
                    },
                    error: function () {
                        $('#lblmsg').text('Verification failed. Please try again.');
                    }
                });
            } else {
                $('#lblmsg').text('Please enter OTP');
            }
        } else {
            $('#lblmsg').text('Select Retailer and Master Distributor');
        }
    });
</script>
