@model Vastwebmulti.Areas.ADMIN.Models.MasterDistributerModel
@using System.Linq
@{
    Layout = null;
    var rows = Model.Select_Retailer_list;
    var recordCount = rows != null ? rows.Count() : 0;
}

<div class="vm-ml-sub-panel">
    <div class="vm-ml-sub-panel__head">
        <div class="vm-ml-sub-panel__title">
            <i class="fas fa-store" aria-hidden="true"></i>
            <span>Retailers under this Distributor</span>
        </div>
        <span class="vm-ml-sub-panel__count">@recordCount record@(recordCount == 1 ? "" : "s")</span>
    </div>
    <div class="table-responsive vm-ml-sub-table-wrap">
        <table class="table table-bordered vm-ml-sub-table saas-acc-table" style="margin:0;">
            <thead>
                <tr>
                    <th>Retailer&nbsp;Firm</th>
                    <th>Retailer&nbsp;Name</th>
                    <th>Mobile&nbsp;No</th>
                    <th>PAN&nbsp;No</th>
                    <th>KYC</th>
                    <th class="vm-ml-sub-th--money">R-Bal</th>
                </tr>
            </thead>
            <tbody>
                @if (rows != null && recordCount > 0)
                {
                    foreach (var item in rows)
                    {
                        <tr>
                            <td class="vm-ml-sub-firm">@item.Frm_Name</td>
                            <td>@item.RetailerName</td>
                            <td>@item.Mobile</td>
                            <td>@item.PanCard</td>
                            <td class="kyc-button">
                                @if (item.PSAStatus == "Y" && item.AadhaarStatus == "Y")
                                {
                                    <span class="vm-ml-status-badge vm-ml-status-badge--done">Done</span>
                                }
                                else
                                {
                                    <span class="vm-ml-status-badge vm-ml-status-badge--due">Due</span>
                                }
                            </td>
                            <td class="vm-ml-balance-cell">@item.Remainamount</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="vm-ml-sub-empty">No retailers found for this distributor.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
