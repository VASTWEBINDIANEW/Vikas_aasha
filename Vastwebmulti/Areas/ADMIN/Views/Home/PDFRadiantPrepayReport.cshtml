@model List<Vastwebmulti.Areas.ADMIN.Models.RadiantPrepayReportVM>
@{
    Layout = null;
    var rows = Model ?? new List<Vastwebmulti.Areas.ADMIN.Models.RadiantPrepayReportVM>();
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>PDF Radiant Prepay Report</title>
    <style>
        table { border-collapse: collapse; width: 100%; font-size: 10px; }
        table, td, th { border: 1px solid #000; }
        th { background: #f5f5f5; }
    </style>
</head>
<body>
    <h3 style="font-size:12px;margin:0 0 8px;">Radiant Prepay Report</h3>
    <table cellspacing="0">
        <thead>
            <tr>
                <th>Firm Name</th>
                <th>RCEID</th>
                <th>Amount</th>
                <th>Remain Pre</th>
                <th>Remain Post</th>
                <th>Request ID</th>
                <th>Insert Date</th>
                <th>Update Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if (rows.Any())
            {
                foreach (var item in rows)
                {
                    <tr>
                        <td>@item.Firmname</td>
                        <td>@item.CEID</td>
                        <td>@(item.Amount.HasValue ? Math.Round(item.Amount.Value, 2) : 0)</td>
                        <td>@(item.RemainPre.HasValue ? Math.Round(item.RemainPre.Value, 2) : 0)</td>
                        <td>@(item.RemainPost.HasValue ? Math.Round(item.RemainPost.Value, 2) : 0)</td>
                        <td>@item.RequestID</td>
                        <td>@(item.InsertDate.HasValue ? item.InsertDate.Value.ToString("dd-MMM-yyyy HH:mm:ss") : "")</td>
                        <td>@(item.UpdateDate.HasValue ? item.UpdateDate.Value.ToString("dd-MMM-yyyy HH:mm:ss") : "")</td>
                        <td>@item.Status</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9">No records found.</td>
                </tr>
            }
        </tbody>
    </table>
</body>
</html>
