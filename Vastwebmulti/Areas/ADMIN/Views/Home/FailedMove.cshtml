@model IEnumerable<Vastwebmulti.Models.proc_failed_Move_Result>
@using System.Linq
@{
    ViewBag.Title = "FailedMove";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var rows = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.proc_failed_Move_Result>();
    var outputMsg = Convert.ToString(ViewData["output"] ?? "").Trim();
    var flashMsg = Convert.ToString(ViewBag.msg ?? "").Trim();
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=28" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-api-operator-modern.css?v=24" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-api-operator-page saas-failed-move-page">
    <div class="container-fluid vm-opr-page-shell">

        @using (Html.BeginForm("FailedMove", "Home", FormMethod.Post, new { id = "failedMoveAddForm" }))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
                <div class="saas-acc-toolbar-top vm-api-operator-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-api-operator-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li><a href="@Url.Action("Dashboard", "Home")#setting">Basic Setting</a></li>
                        <li>Set BackUp API</li>
                    </ol>
                    <div class="vm-dmt-fin-nav-row vm-api-operator-nav-wrap">
                        @Html.Partial("_menuapinm")
                    </div>
                </div>

                <div class="vm-rpt-filters-panel vm-api-operator-filter-panel">
                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-api-operator-filter-row vm-rpt-filters-panel__bar">
                        <div class="vm-api-operator-filter-group vm-failed-move-filter-group">
                            <div class="vm-opr-field vm-api-operator-field vm-failed-move-field--operator">
                                @Html.DropDownList("Operator", ViewBag.operatorcode as SelectList, "Select Operator", new { id = "failedMoveOperator", @class = "form-control vm-opr-select vm-dmt-select vm-api-operator-select", @required = "required", @title = "Select Operator" })
                            </div>
                            <div class="vm-opr-field vm-api-operator-field vm-failed-move-field--api">
                                @Html.DropDownList("Apinm", ViewBag.Apinm as SelectList, "Select Api", new { id = "failedMoveApinm", @class = "form-control vm-opr-select vm-dmt-select vm-api-operator-select", @required = "required", @title = "Select Api" })
                            </div>
                            <button type="button" id="failedMoveSetBtn" class="saas-acc-btn saas-acc-btn--search vm-api-nm-add-btn vm-failed-move-set-btn" title="Set Operator">
                                <i class="fas fa-plus-circle" aria-hidden="true"></i><span>Set Operator</span>
                            </button>
                            <button type="submit" id="failedMoveConfirmBtn" class="saas-acc-btn saas-acc-btn--search vm-failed-move-confirm-btn" style="display:none;" title="Confirm">
                                <i class="fas fa-check" aria-hidden="true"></i><span>Sure?</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (!string.IsNullOrEmpty(outputMsg))
        {
            <div class="vm-failed-move-alert" role="alert">
                <i class="fas fa-info-circle" aria-hidden="true"></i>
                <span>@outputMsg</span>
            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-random" aria-hidden="true"></i>
                        <span>BackUp API operator mapping</span>
                    </div>
                    <label class="vm-api-operator-table-search" for="failedMoveSearch">
                        <i class="fas fa-search" aria-hidden="true"></i>
                        <input type="text" id="failedMoveSearch" placeholder="Search records..." autocomplete="off" />
                    </label>
                </div>
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="failedMoveTable" class="table vm-opr-data-table vm-failed-move-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Operator Name</th>
                                    <th>Api Name</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in rows)
                                {
                                    <tr data-operator="@(item.operator_Name ?? "")" data-api="@(item.api_name ?? "")">
                                        <td class="vm-failed-move-cell vm-failed-move-cell--operator">
                                            @item.operator_Name
                                            <input type="hidden" class="vm-failed-move-id" value="@item.idno" />
                                            <input type="hidden" class="vm-failed-move-opcode" value="@Html.AttributeEncode(item.operator_code ?? "")" />
                                            <input type="hidden" class="vm-failed-move-apiname" value="@Html.AttributeEncode(item.api_name ?? "")" />
                                        </td>
                                        <td class="vm-failed-move-cell vm-failed-move-cell--api" title="@(item.api_name ?? "")">@item.api_name</td>
                                        <td class="vm-failed-move-cell vm-failed-move-cell--status">
                                            <a href="@Url.Action("Failedstatus", new { id = item.idno })" class="vm-failed-move-status-link" title="@(item.status == "Y" ? "Turn off" : "Turn on")">
                                                @if (item.status == "Y")
                                                {
                                                    <span class="onoffswitch"><span class="costom-on">on</span></span>
                                                }
                                                else
                                                {
                                                    <span class="onoffswitch"><span class="custom-off">off</span></span>
                                                }
                                            </a>
                                        </td>
                                        <td class="vm-api-nm-action-cell">
                                            <div class="vm-api-nm-action-group">
                                                <button type="button"
                                                        class="vm-api-operator-edit-btn vm-failed-move-edit-btn"
                                                        data-toggle="modal"
                                                        data-target="#failedMoveEditModal"
                                                        title="Edit mapping">
                                                    <i class="fas fa-edit" aria-hidden="true"></i> Edit
                                                </button>
                                                <button type="button" class="vm-api-nm-delete-btn vm-failed-move-delete-btn" data-id="@item.idno" title="Delete mapping" aria-label="Delete mapping">
                                                    <i class="fas fa-trash-alt" aria-hidden="true"></i>
                                                </button>
                                                <button type="button" class="vm-api-nm-delete-confirm-btn vm-failed-move-delete-confirm-btn" data-id="@item.idno" title="Confirm delete" aria-label="Confirm delete" style="display:none;">
                                                    <i class="fas fa-exclamation-triangle" aria-hidden="true"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Edit BackUp API Modal -->
<div class="modal fade saas-admin-modal vm-sm-modal vm-api-operator-modal vm-api-nm-modal vm-failed-move-modal" id="failedMoveEditModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered saas-admin-modal-dialog vm-sm-modal-dialog" role="document">
        <div class="modal-content">
            @using (Html.BeginForm("Edit_Failed_Move", "Home", FormMethod.Post, new { id = "failedMoveEditForm" }))
            {
                <div class="modal-header saas-admin-modal-header accent-emerald">
                    <div class="saas-admin-modal-head-main">
                        <div class="saas-admin-modal-icon"><i class="fas fa-edit" aria-hidden="true"></i></div>
                        <div class="saas-admin-modal-title-wrap">
                            <h4 class="modal-title saas-admin-modal-title">Edit BackUp API Mapping</h4>
                            <p class="saas-admin-modal-subtitle">Update operator backup API assignment</p>
                        </div>
                    </div>
                    <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
                </div>

                <div class="modal-body saas-admin-modal-body saas-admin-modal-scroll vm-sm-modal-body">
                    @Html.Hidden("txtidno", "", new { id = "txtidno" })
                    <input type="hidden" id="txtSSID" name="txtSSID" value="" />
                    <div class="vm-sm-modal-panel vm-api-operator-form-grid">
                        <div class="vm-sm-modal-field vm-sm-modal-field--full">
                            <label for="operatorcode1">Operator</label>
                            @Html.DropDownList("operatorcode1", ViewBag.operatorcode1 as SelectList, "Select Operator", new { id = "operatorcode1", @class = "form-control vm-failed-move-edit-select", @required = "required" })
                        </div>
                        <div class="vm-sm-modal-field vm-sm-modal-field--full">
                            <label for="Apinm1">API Name</label>
                            @Html.DropDownList("Apinm1", ViewBag.Apinm1 as SelectList, "Select Api", new { id = "Apinm1", @class = "form-control vm-failed-move-edit-select", @required = "required" })
                        </div>
                    </div>
                </div>

                <div class="modal-footer saas-admin-modal-footer vm-sm-modal-footer">
                    <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal">
                        <i class="fas fa-times" aria-hidden="true"></i> Cancel
                    </button>
                    <button type="submit" class="saas-admin-modal-btn saas-admin-modal-btn--success">
                        <i class="fas fa-save" aria-hidden="true"></i> Save Changes
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<script>
    (function () {
        function initFailedMoveSelect2($, selector) {
            var $el = $(selector);
            if (!$el.length || !$.fn.select2) {
                return;
            }
            $el.each(function () {
                var $s = $(this);
                if ($s.hasClass('select2-hidden-accessible')) {
                    $s.select2('destroy');
                }
                $s.select2({
                    width: '100%',
                    dropdownParent: $(document.body)
                });
            });
        }

        function openFailedMoveEdit($, $btn) {
            var $row = $btn.closest('tr');
            var opCode = $row.find('.vm-failed-move-opcode').val() || '';
            var apiName = $row.find('.vm-failed-move-apiname').val() || '';
            var idno = $row.find('.vm-failed-move-id').val() || '';

            $('#txtidno').val(idno);
            $('#txtSSID').val('');
            $('#operatorcode1').val(opCode).trigger('change');
            $('#operatorcode1').prop('disabled', true);
            $('#Apinm1').val(apiName).trigger('change');
        }

        function resetFailedMoveEditModal($) {
            $('#operatorcode1').prop('disabled', false);
        }

        function applyFailedMoveSearch() {
            var q = ($('#failedMoveSearch').val() || '').trim().toLowerCase();
            $('#failedMoveTable tbody tr').each(function () {
                var text = $(this).text().toLowerCase();
                $(this).toggle(!q || text.indexOf(q) > -1);
            });
        }

        function bootFailedMovePage() {
            var $ = window.jQuery;
            if (!$ || !$.fn || !$.fn.modal) {
                window.setTimeout(bootFailedMovePage, 50);
                return;
            }

            initFailedMoveSelect2($, '#failedMoveOperator, #failedMoveApinm');
            initFailedMoveSelect2($, '#operatorcode1, #Apinm1');

            var flashMsg = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(flashMsg))';
            if (flashMsg && window.swal) {
                if (flashMsg.indexOf('Successfully') >= 0) {
                    swal('Good job!', flashMsg, 'success');
                } else {
                    swal('Notice', flashMsg, 'warning');
                }
            }

            $('#failedMoveSetBtn').off('click.failedMove').on('click.failedMove', function () {
                var op = ($('#failedMoveOperator').val() || '').trim();
                var api = ($('#failedMoveApinm').val() || '').trim();
                if (!op || !api) {
                    if (window.swal) {
                        swal('Required', 'Please select Operator and Api.', 'warning');
                    }
                    return;
                }
                $(this).hide();
                $('#failedMoveConfirmBtn').show();
            });

            $('#failedMoveSearch').off('keyup.failedMove').on('keyup.failedMove', applyFailedMoveSearch);

            $('#failedMoveEditModal').off('show.bs.modal.failedMove').on('show.bs.modal.failedMove', function (e) {
                var $btn = $(e.relatedTarget);
                if ($btn && $btn.hasClass('vm-failed-move-edit-btn')) {
                    openFailedMoveEdit($, $btn);
                }
            });

            $('#failedMoveEditModal').off('hidden.bs.modal.failedMove').on('hidden.bs.modal.failedMove', function () {
                resetFailedMoveEditModal($);
            });

            $(document).off('click.failedMoveEdit', '.vm-failed-move-edit-btn').on('click.failedMoveEdit', '.vm-failed-move-edit-btn', function (e) {
                openFailedMoveEdit($, $(this));
                if (typeof window.showAdminModal === 'function') {
                    e.preventDefault();
                    window.showAdminModal('#failedMoveEditModal');
                }
            });

            $(document).off('click.failedMoveDelete', '.vm-failed-move-delete-btn').on('click.failedMoveDelete', '.vm-failed-move-delete-btn', function () {
                $('.vm-failed-move-delete-btn').show();
                $('.vm-failed-move-delete-confirm-btn').hide().prop('disabled', false);
                var $group = $(this).closest('.vm-api-nm-action-group');
                $group.find('.vm-failed-move-delete-btn').hide();
                $group.find('.vm-failed-move-delete-confirm-btn').show();
            });

            $(document).off('click.failedMoveDeleteConfirm', '.vm-failed-move-delete-confirm-btn').on('click.failedMoveDeleteConfirm', '.vm-failed-move-delete-confirm-btn', function () {
                var id = $(this).data('id');
                var $btn = $(this);
                $btn.prop('disabled', true);

                $.ajax({
                    type: 'GET',
                    url: '@Url.Action("del_Failed_Move", "Home")',
                    data: { idno: id },
                    dataType: 'json',
                    cache: false,
                    success: function () {
                        window.location.href = '@Url.Action("FailedMove", "Home")';
                    },
                    error: function () {
                        $btn.prop('disabled', false);
                        if (window.swal) {
                            swal('Error', 'Unable to delete mapping. Please try again.', 'error');
                        }
                    }
                });
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', bootFailedMovePage);
        } else {
            bootFailedMovePage();
        }
    })();
</script>
