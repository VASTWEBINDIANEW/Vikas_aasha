@model List<Vastwebmulti.Models.Aeps_Report_New_Result>
@{
    Layout = null;
}
@if (Model != null && Model.Count > 0)
{
    var srIndex = ViewBag.SrOffset != null ? Convert.ToInt32(ViewBag.SrOffset) : 0;
    foreach (var item in Model)
    {
        srIndex++;
        var stsUp = (item.Status ?? "").ToUpper();
        var statusTone = "pending";
        var statusFa = "fa-clock-o";
        var type = "";
        if (item.Type == "")
        {
            if (stsUp.Contains("M_"))
            {
                type = "Mini Statement";
            }
            else if (stsUp.Contains("BALANCE"))
            {
                type = "Balance";
            }
            else
            {
                type = "Fund Transfer";
            }
        }
        else
        {
            type = item.Type;
        }
        if (stsUp.Contains("SUCCESS"))
        {
            statusTone = "success";
            statusFa = "fa-check";
        }
        else if (stsUp.Contains("FAILED") || stsUp.Contains("REFUND"))
        {
            statusTone = "failed";
            statusFa = "fa-times";
        }
        else if (stsUp.Contains("PENDING"))
        {
            statusTone = "pending";
            statusFa = "fa-clock-o";
        }
        else if (stsUp.Contains("BALANCE"))
        {
            statusTone = "balance";
            statusFa = "fa-balance-scale";
        }
        else if (stsUp.Contains("SETTLEMENT"))
        {
            statusTone = "refund";
            statusFa = "fa-undo";
        }
        var colorrole = "";
        var font = "";
        if (item.Role == "WhitelabelRetailer")
        {
            colorrole = "#2563eb";
            font = "800";
        }
        decimal usercredit = 0;
        if (item.Role == "Retailer")
        {
            var amount = Convert.ToDecimal(item.Amount);
            var remincome = Convert.ToDecimal(item.RemIncome);
            usercredit = item.Type == "Aadhar Pay" ? (amount - remincome) : (amount + remincome);
        }
        else
        {
            var amount = Convert.ToDecimal(item.Amount);
            var remincome = Convert.ToDecimal(item.WLIncome);
            usercredit = amount + remincome;
        }
        var aadharcard = "";
        if (!string.IsNullOrEmpty(item.AccountHolderAadhaar))
        {
            var input = item.AccountHolderAadhaar;
            aadharcard = new string('X', 5) + input.Substring(input.Length - 4, 4);
        }
        <tr class="vm-dmt-row vm-dmt-row--@statusTone">
            <td class="vm-dmt-sr-cell">
                <span class="vm-dmt-sr-num">@srIndex</span>
                <span class="vm-dmt-status vm-dmt-status--@statusTone" title="@item.Status">
                    <i class="fa @statusFa" aria-hidden="true"></i>
                </span>
            </td>
            <td class="vm-aeps-type-cell"><span class="vm-aeps-type-badge">@type</span></td>
            <td class="vm-dmt-user-cell">
                <span class="vm-aeps-app-badge">@item.ApplicationType</span>
                <span class="vm-dmt-user-name" style="color:@colorrole;font-weight:@font;">@item.Frm_Name</span>
            </td>
            <td>@item.MerchantTxnId</td>
            <td>
                @if (!string.IsNullOrEmpty(item.devicename))
                {
                    @(item.devicename + " " + item.deviceserialno)
                }
            </td>
            <td>@item.BankName</td>
            <td>@item.customerremain</td>
            <td>@aadharcard</td>
            <td>@item.Mobile</td>
            <td>@item.username</td>
            <td>@item.Amount</td>
            <td>@(item.Role == "Retailer" ? item.RemIncome : item.WLIncome)</td>
            <td>@(item.Role == "Retailer" ? item.RemPre : item.WLPre)</td>
            <td>@usercredit</td>
            <td>@(item.Role == "Retailer" ? item.RemPost : item.WLPost)</td>
            <td class="vm-aeps-rrn-cell">
                @if (stsUp == "SUCCESS")
                {
                    @item.BankRRN
                }
                else
                {
                    @item.Remark
                }
            </td>
            <td>@String.Format("{0:dd-MMM HH:mm:ss}", item.Txn_Date)</td>
            <td class="vm-dmt-action-cell">
                @if (item.Status != "Balance")
                {
                    <div class="nrch vm-dmt-action-bar">
                        @if (stsUp.Contains("PENDING"))
                        {
                            <button type="button" class="ss vm-dmt-act-btn vm-dmt-act-btn--success" title="Mark success" data-toggle="modal" data-target="#defaultModal2" onclick="setTxnValue('@item.idno')">
                                <i class="fa fa-check" aria-hidden="true"></i>
                            </button>
                            <button type="button" class="fftr vm-dmt-act-btn vm-dmt-act-btn--danger" title="Refund" data-toggle="modal" data-target="#defaultModal1" onclick="refundshow('@item.MerchantTxnId','@item.Mobile')">
                                <i class="fa fa-times" aria-hidden="true"></i>
                            </button>
                        }
                        @if (stsUp == "FAILED")
                        {
                            <button type="button" class="ss vm-dmt-act-btn vm-dmt-act-btn--success" title="Mark success" data-toggle="modal" data-target="#defaultModal2" onclick="Failedtosuccess('@item.idno')">
                                <i class="fa fa-check" aria-hidden="true"></i>
                            </button>
                        }
                        <button type="button" class="fftt vm-dmt-act-btn vm-dmt-act-btn--detail" title="View details" data-toggle="modal" data-target="#defaultModal222" onclick="mdActionBtn('@item.idno')">
                            <i class="fa fa-angle-double-right" aria-hidden="true"></i>
                        </button>
                    </div>
                }
            </td>
        </tr>
    }
}
else
{
    <tr class="vm-opr-table-empty-row">
        @if (@ViewBag.checkdata != null)
        {
            <td colspan="18" class="vm-opr-table-empty vm-dmt-table-empty">
                <i class="fa fa-search fas fa-search" aria-hidden="true"></i>
                <span>No transactions found for current search.</span>
            </td>
        }
        else
        {
            <td colspan="18" class="vm-opr-table-empty vm-dmt-table-empty">
                <i class="fa fa-fingerprint fas fa-fingerprint" aria-hidden="true"></i>
                <span>AEPS transaction not found.</span>
            </td>
        }
    </tr>
}
