@model Vastwebmulti.Areas.ADMIN.Models.PancardSlabModel
@using (Ajax.BeginForm("_Common_pancard_manual", "Home", new AjaxOptions { HttpMethod = "POST", OnSuccess = "OnSuccess", UpdateTargetId = "divEditFormComm", LoadingElementId = "div_Loader", InsertionMode = InsertionMode.Replace }))
{
    <input id="btnsubmit" type="submit" value="Save Data" class="btn waves-effect vm-pg-slab-save-btn" style="display:none;" />
    <div class="vm-pg-slab-table-scroll saas-acc-table-wrap vm-dmt2-slab-table-scroll vm-prepaid-slab-table-wrap">
        <table id="pancardManualSlabTable" class="table table-bordered vm-pg-slab-table vm-dmt2-slab-table third-design-table slab-table example-second thpadding-second">
            <thead>
                <tr>
                    <th>Retailer&nbsp;Comm&nbsp;(%)</th>
                    <th>Distributor&nbsp;Comm&nbsp;(%)</th>
                    <th>Master&nbsp;Comm&nbsp;(%)</th>
                </tr>
            </thead>
            <tbody id="tbodyshow" class="vm-pg-slab-tbody--view">
                @foreach (var item in Model.commonmanual)
                {
                    <tr>
                        <td>@item.retailer_comm</td>
                        <td>@item.dealer_comm</td>
                        <td>@item.master_comm</td>
                    </tr>
                }
            </tbody>
            <tbody id="tbodyedit" class="vm-pg-slab-tbody--hidden">
                @for (int i = 0; i < Model.commonmanual.Count; i++)
                {
                    <tr>
                        @Html.HiddenFor(a => a.commonmanual[i].idno)
                        <td>
                            @Html.EditorFor(a => a.commonmanual[i].retailer_comm, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input", @style = "width:100%" } })
                            @Html.ValidationMessageFor(a => a.commonmanual[i].retailer_comm)
                        </td>
                        <td>
                            @Html.EditorFor(a => a.commonmanual[i].dealer_comm, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input", @style = "width:100%" } })
                            @Html.ValidationMessageFor(a => a.commonmanual[i].dealer_comm)
                        </td>
                        <td>
                            @Html.EditorFor(a => a.commonmanual[i].master_comm, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input", @style = "width:100%" } })
                            @Html.ValidationMessageFor(a => a.commonmanual[i].master_comm)
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
<script>
    function OnSuccess() {
        if (typeof resetSlabViewMode === 'function') {
            resetSlabViewMode();
        } else {
            $('#btnsubmit').hide();
            $('#btnEdit').show();
        }
        if (typeof initPgSlabPartialUi === 'function') {
            initPgSlabPartialUi();
        }
    }
</script>
