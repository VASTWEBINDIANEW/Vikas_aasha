@model IEnumerable<Vastwebmulti.Models.report_cash_deposit_Result>

@{

    Layout = null;

    var items = Model == null ? new List<Vastwebmulti.Models.report_cash_deposit_Result>() : Model.ToList();

}

@if (items.Count > 0)

{

    var srIndex = ViewBag.SrOffset != null ? Convert.ToInt32(ViewBag.SrOffset) : 0;

    foreach (var item in items)

    {

        srIndex++;

        var statusTone = "pending";

        var statusFa = "fa-clock-o";

        var statusLabel = item.status ?? "Pending";

        var sts = (item.status ?? "").ToUpperInvariant();



        if (sts.Contains("SUCCESS"))

        {

            statusTone = "success";

            statusFa = "fa-check";

            statusLabel = "Success";

        }

        else if (sts.Contains("FAILED"))

        {

            statusTone = "failed";

            statusFa = "fa-times";

            statusLabel = "Failed";

        }

        else if (sts.Contains("PENDING"))

        {

            statusTone = "pending";

            statusFa = "fa-clock-o";

            statusLabel = "Pending";

        }

        else if (sts.Contains("REFUND"))

        {

            statusTone = "refund";

            statusFa = "fa-undo";

            statusLabel = "Refund";

        }



        var userName = !string.IsNullOrWhiteSpace(item.Frm_Name) ? item.Frm_Name : "—";

        <tr class="vm-dmt-row vm-dmt-row--@statusTone">

            <td class="vm-dmt-sr-cell">

                <span class="vm-dmt-sr-num">@srIndex</span>

                <span class="vm-dmt-status vm-dmt-status--@statusTone" title="@statusLabel">

                    <i class="fa @statusFa" aria-hidden="true"></i>

                </span>

            </td>

            <td class="vm-dmt-user-cell">

                <div class="vm-dmt-user-stack">

                    <div class="vm-dmt-user-line">

                        <span class="vm-dmt-user-role">Retailer</span>

                        <span class="vm-dmt-user-sep">&rsaquo;</span>

                        <span class="vm-dmt-user-name">@userName</span>

                    </div>

                </div>

            </td>

            <td class="vm-dmt-amt-cell">@item.amount</td>

            <td class="vm-dmt-time-cell">@item.req_date</td>

            <td class="vm-cashdeposit-rrn-cell">@item.bankrrn</td>

            <td>@item.benname</td>

            <td>@item.bankname</td>

            <td>@item.Rem_pre</td>

            <td class="vm-dmt-amt-cell">@item.rem_comm</td>

            <td>@item.rem_gst</td>

            <td>@item.rem_tds</td>

            <td>@item.rem_post</td>

            <td class="vm-dmt-action-cell">

                <div class="nrch vm-dmt-action-bar">

                    @if (sts == "PENDING")

                    {

                        <button type="button" class="fftt vm-dmt-act-btn vm-dmt-act-btn--success" title="Mark success" onclick="cashDepositSuccessShow('@item.idno')">

                            <i class="fa fa-check" aria-hidden="true"></i>

                        </button>

                        <button type="button" class="fftt vm-dmt-act-btn vm-dmt-act-btn--danger" title="Refund / failed" onclick="cashDepositRefundShow('@item.idno')">

                            <i class="fa fa-times" aria-hidden="true"></i>

                        </button>

                    }

                    <button type="button" class="fftt vm-dmt-act-btn vm-dmt-act-btn--detail" title="View details" onclick="cashDepositDetail('@item.idno')">

                        <i class="fa fa-angle-double-right" aria-hidden="true"></i>

                    </button>

                </div>

            </td>

        </tr>

    }

}

else

{

    <tr class="vm-opr-table-empty-row">

        @if (ViewBag.checkdata != null)

        {

            <td colspan="13" class="vm-opr-table-empty vm-dmt-table-empty">

                <i class="fas fa-search" aria-hidden="true"></i>

                <span>No transactions found for current search.</span>

            </td>

        }

        else

        {

            <td colspan="13" class="vm-opr-table-empty vm-dmt-table-empty">

                <i class="fas fa-money-bill-wave" aria-hidden="true"></i>

                <span>Cash deposit transaction not found.</span>

            </td>

        }

    </tr>

}

