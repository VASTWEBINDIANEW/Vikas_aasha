@model IEnumerable<Vastwebmulti.Models.proc_Recharge_operator_report_newPaging_Result>

@using System.Linq

@using System.Web

@{

    Layout = null;

    string loanmob = "";

}



@functions {

    public static string VmOprStatusBadge(string status, string idno)

    {

        var s = (status ?? "").Trim().ToUpperInvariant();

        var title = "Status";

        var cls = "vm-opr-sb-badge";

        var icon = "fa-question-circle";



        if (s.Contains("REFUND"))

        {

            cls += " vm-opr-sb-badge--refund";

            icon = "fa-undo";

            title = "Refunded";

        }

        else if (s == "RESEND")

        {

            cls += " vm-opr-sb-badge--resend";

            icon = "fa-redo";

            title = "Resend";

        }

        else if (s == "FAILED" || s.Contains("SUCCESS TO FAILED"))

        {

            cls += " vm-opr-sb-badge--failed";

            icon = "fa-times";

            title = "Failed";

        }

        else if (s == "SUCCESS" || s.Contains("FAILED TO SUCCESS"))

        {

            cls += " vm-opr-sb-badge--success";

            icon = "fa-check";

            title = "Success";

        }

        else if (s == "PENDING" || s.Contains("REQUEST"))

        {

            cls += " vm-opr-sb-badge--pending";

            icon = "fa-clock";

            title = "Pending";

        }



        var html = string.Format(

            "<span class=\"{0}\" title=\"{1}\" role=\"img\" aria-label=\"{1}\"><i class=\"fas {2}\" aria-hidden=\"true\"></i></span>",

            cls,

            HttpUtility.HtmlAttributeEncode(title),

            icon);



        if (s == "PENDING" && !string.IsNullOrEmpty(idno))

        {

            html += string.Format(

                "<button type=\"button\" class=\"vm-opr-sb-view\" onclick=\"GotoView('{0}')\" title=\"View Status\"><i class=\"fas fa-eye\" aria-hidden=\"true\"></i></button>",

                HttpUtility.JavaScriptStringEncode(idno));

        }



        return html;

    }

}



@if (Model != null && Model.Any())

{

    foreach (var item in Model)

    {

        var i = item.idno;

        var idno = "subTbl" + i;

        var idno1 = "subTbl1" + i;

        var idshow = "subTblshow" + i;

        var idhide = "subTblhide" + i;

        var idshowEdit = "subTblshowEdit" + i;

        var idhideEdit = "subTblhideEdit" + i;



        var sts = item.rstatus ?? "";

        var pendingColor = "";

        var rolename = "";

        var faicon = "REF";

        var idd = "";



        if (sts.ToUpper().Contains("REFUND"))

        {

            idd = sts.Replace("Refund(", "").Replace(")", "");

        }



        if (sts == "Request Sent" || sts == "Request Send")

        {

            pendingColor = "#fff8d1";

        }



        if (item.rch_type.ToUpper() == "ONLINE") { faicon = "WEB"; }

        if (item.rch_type.ToUpper() == "APPS") { faicon = "APP"; }

        if (item.rch_type.ToUpper() == "OFFLINE") { faicon = "OFF"; }

        if (item.rch_type.ToUpper() == "API") { faicon = "API"; }



        if (item.Roles == "Retailer") { rolename = "Retailer"; }

        if (item.Roles == "Whitelabelretailer") { rolename = "Whitelabel"; }

        if (item.Roles == "API") { rolename = "API USER"; }



        DateTime Rch_time = Convert.ToDateTime(item.Rch_time);

        DateTime resp_time = Convert.ToDateTime(item.resp_time);

        var duedate = item.BillDueDate;

        var billdueinfo = "Due Date " + duedate;

        var Circle = item.Circle;

        var Circleinfo = "Circle " + Circle;



        var amt = item.amount;

        var amtde = item.income;

        decimal? amtdec;

        if (sts.ToUpper().Contains("REFUND"))

        {

            amtdec = amt - amtde;

            amtdec = +amtdec;

        }

        else

        {

            amtdec = amt - amtde;

            amtdec = -amtdec;

        }



        var firmname = item.frm_name;

        if (firmname == null || firmname == "")

        {

            firmname = item.retailername;

        }



        if (item.operator_type == "Loan")

        {

            loanmob = item.mobile + "-" + item.optional1;

        }

        else

        {

            loanmob = item.mobile;

        }



        <tr style="background-color:@pendingColor">

            <td class="vm-opr-sb-cell">

                @if (!item.rstatus.ToUpper().Contains("REFUND") && !item.rstatus.ToUpper().Contains("RESEND"))

                {

                    <button type="button" class="for-new vm-opr-sb-chk-btn">

                        <input type="checkbox" id="for1 @item.idno" name="datavalue" value="@item.idno - @item.rstatus - @rolename&nbsp;&nbsp;@firmname - @item.mobile - @item.Operator_name -@item.amount - @item.Circle" class="filled-in chk-col-pink chhhhh" onchange="functionch('@item.rstatus')" />

                        <label for="for1 @item.idno" class="vm-opr-sb-chk-label"></label>

                    </button>

                }

            </td>

            <td class="vm-opr-user-cell">

                <div class="vm-opr-user-row">

                    <span class="vm-opr-sb-inline">@Html.Raw(VmOprStatusBadge(sts, item.idno.ToString()))</span>

                    <div class="vm-opr-user-stack">

                        <div class="vm-opr-user-line">

                            <strong class="vm-opr-user-role">@rolename</strong>

                            <span class="vm-opr-user-sep" aria-hidden="true"></span>

                            <span class="vm-opr-user-name">@firmname</span>

                        </div>

                        @if (idd != "")

                        {

                            <div class="vm-opr-refund-against">Refund Against (@idd)</div>

                        }

                    </div>

                </div>

            </td>

            <td class="vm-opr-operator-cell">

                <span class="vm-opr-opr-tag">@faicon</span>@item.Operator_name

                @if (!string.IsNullOrWhiteSpace(duedate))

                {

                    <span class="vm-opr-cell-sub">@billdueinfo</span>

                }

            </td>

            <td class="vm-opr-consumer-cell">

                <div class="vm-opr-consumer-no">@loanmob</div>

                @if (!string.IsNullOrWhiteSpace(Circle))

                {

                    <span class="vm-opr-cell-sub">@Circleinfo</span>

                }

            </td>

            <td>@item.amount</td>

            <td>@item.user_remain_pre</td>

            <td>@amtdec</td>

            <td>@item.remain</td>

            <td>@item.portno</td>

            <td>@item.income</td>

            <td>@item.lapubal</td>

            <td class="ppo">

                <p id="@idshowEdit">@item.opt_id</p>

                <span class="pen">

                    <button class="edit" id="@idno" onclick="Edit_OPT(@i)" style="float:right; background:transparent;border:none;" title="Edit">

                        <i class="fa fa-pencil" style="font-size:15px;"></i>

                    </button>

                </span>

                <div style="display:none; font-size:10px;" id="@idhideEdit" class="input-container mmks">

                    <input type="text" id="@idno1" name="optid" class="input-field" required value="@item.opt_id">

                    <input type="hidden" id="lapubal" name="lapubal" value="@item.lapubal">

                    <button class="input-button fullbodydycolorbg" id="btnidno" onclick="UpdateOptId(@item.idno)" value="@item.idno"><span class="fa fa-check" style="color:#c7c2c2;"></span></button>

                </div>

            </td>

            <td>@Rch_time.ToString("d-MMM-yyyy HH:mm:ss")</td>

            @if (item.resp_time != null)

            {

                <td>@resp_time.ToString("d-MMM-yyyy HH:mm:ss")</td>

            }

            else

            {

                <td>@item.resp_time</td>

            }

            <td style="padding:4px;">

                <button data-toggle="modal" data-target="#defaultModal222" onclick="ActionBtn('@item.idno')" style="color:@(sts == "Request Send" ? "#ff9600" : "");background:transparent;border:none;margin-top:0px !important;">

                    <img src="~/ashok-images/rightaeps.svg" style="border: 1px solid var(--border-color);padding: 3px 5px;font-size: 10px;height:18px !important;vertical-align: baseline;" alt="Action">

                </button>

            </td>

        </tr>

    }

}

