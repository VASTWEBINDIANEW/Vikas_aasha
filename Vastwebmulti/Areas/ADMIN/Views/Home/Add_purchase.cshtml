        $(document).on('click', '.for-account-list-hide', function () {

            $('.for-account-list-show').show();

            $('.for-account-list').hide();

        });



        $(document).on('click', '.reset, #resetform', function () {

            $('.all_fields').val('');

        });



        window.refreshAddPurchaseSelect2 = refreshAddPurchaseSelect2;

        window.apFillSellerBankDetailsJq = apFillSellerBankDetails;

        window.apFillSellerBankDetails = apFillSellerBankDetails;

        window.apBindSellerPartyAutoFill = apBindSellerPartyAutoFill;

        window.apSyncSellerDropdownFromBankTable = apSyncSellerDropdownFromBankTable;



    })(window.vmAdminJq || window.jQuery);

</script>



@section PostSelect2Scripts {

    <script>

        (function () {

            'use strict';

            var apSellerInfoUrl = '@Url.Action("Showsellinfo", "Home", new { area = "ADMIN" })';



            function apNormSellerKey(value) {

                return String(value || '').replace(/\s+/g, ' ').trim().toLowerCase();

            }



            function apSetSellerBankFields(accountNo, ifscCode) {

                var accEl = document.getElementById('saccount');

                var ifscEl = document.getElementById('sifsc');

                if (accEl) {

                    accEl.value = accountNo || '';

                }

                if (ifscEl) {

                    ifscEl.value = ifscCode || '';

                }

            }



            function apReadSellerBankFromTable(apiName) {

                var key = apNormSellerKey(apiName);

                if (!key) {

                    return false;

                }

                var rows = document.querySelectorAll('#apBankTableHost table tbody tr');

                for (var i = 0; i < rows.length; i++) {

                    var row = rows[i];

                    if (row.classList.contains('ap-empty-row')) {

                        continue;

                    }

                    var api = row.getAttribute('data-apinm');

                    var accountNo = row.getAttribute('data-account');

                    var ifscCode = row.getAttribute('data-ifsc');

                    if (!api) {

                        var cells = row.querySelectorAll('td');

                        if (cells.length < 5) {

                            continue;

                        }

                        api = (cells[0].textContent || '').trim();

                        accountNo = (cells[3].textContent || '').trim();

                        ifscCode = (cells[4].textContent || '').trim();

                    } else {

                        api = String(api).trim();

                        accountNo = String(accountNo || '').trim();

                        ifscCode = String(ifscCode || '').trim();

                    }

                    if (apNormSellerKey(api) === key) {

                        apSetSellerBankFields(accountNo, ifscCode);

                        return true;

                    }

                }

                return false;

            }



            function apReadSellerBankFromOption(apiName) {

                var sel = document.getElementById('sellerapi');

                if (!sel) {

                    return false;

                }

                var key = apNormSellerKey(apiName);

                for (var i = 0; i < sel.options.length; i++) {

                    var opt = sel.options[i];

                    if (apNormSellerKey(opt.value) === key || apNormSellerKey(opt.text) === key) {

                        var accountNo = String(opt.getAttribute('data-account') || '').trim();

                        var ifscCode = String(opt.getAttribute('data-ifsc') || '').trim();

                        if (accountNo || ifscCode) {

                            apSetSellerBankFields(accountNo, ifscCode);

                            return true;

                        }

                    }

                }

                return false;

            }



            function apSellerCandidatesFromEl(el, val) {

                var list = [];

                function add(v) {

                    v = String(v == null ? '' : v).replace(/\s+/g, ' ').trim();

                    if (!v || /^select\s*\(seller\)/i.test(v)) {

                        return;

                    }

                    if (list.indexOf(v) === -1) {

                        list.push(v);

                    }

                }

                add(val);

                var sel = (el && el.options) ? el : document.getElementById('sellerapi');

                if (sel && sel.selectedIndex >= 0) {

                    add(sel.options[sel.selectedIndex].value);

                    add(sel.options[sel.selectedIndex].text);

                }

                if (val && sel) {

                    var pk = apNormSellerKey(val);

                    for (var o = 0; o < sel.options.length; o++) {

                        var opt = sel.options[o];

                        if (apNormSellerKey(opt.value) === pk || apNormSellerKey(opt.text) === pk) {

                            add(opt.value);

                            add(opt.text);

                        }

                    }

                }

                return list;

            }



            function apAjaxFillSellerBank(apiName) {

                var $ = window.vmAdminJq || window.jQuery;

                if (!$ || !apiName) {

                    return;

                }

                $.ajax({

                    url: apSellerInfoUrl,

                    type: 'POST',

                    data: { Apinm: apiName },

                    dataType: 'json',

                    cache: false,

                    success: function (data) {

                        if (!data) {

                            return;

                        }

                        apSetSellerBankFields(data.AccountNo || data.accountNo || '', data.Ifsccode || data.ifscCode || data.ifsccode || '');

                    }

                });

            }



            window.apOnSellerPartyChange = function (el) {

                var val = '';

                if (el && el.value != null) {

                    val = String(el.value).trim();

                } else if (typeof el === 'string') {

                    val = el.trim();

                }

                if (!val) {

                    apSetSellerBankFields('', '');

                    return;

                }

                var candidates = apSellerCandidatesFromEl(el, val);

                for (var c = 0; c < candidates.length; c++) {

                    if (apReadSellerBankFromTable(candidates[c])) {

                        return;

                    }

                    if (apReadSellerBankFromOption(candidates[c])) {

                        return;

                    }

                }

                apAjaxFillSellerBank(candidates[0] || val);

            };



            window.apFillSellerBankDetails = function (apiName, $select) {

                if (typeof window.apFillSellerBankDetailsJq === 'function') {

                    window.apFillSellerBankDetailsJq(apiName, $select);

                    return;

                }

                var sel = document.getElementById('sellerapi');

                if ($select && $select.length && $select[0]) {

                    sel = $select[0];

                }

                if (sel) {

                    window.apOnSellerPartyChange(sel);

                } else if (apiName) {

                    window.apOnSellerPartyChange({ value: String(apiName).trim() });

                }

            };



            function apSyncSellerDropdownFromTableVanilla() {

                var sel = document.getElementById('sellerapi');

                if (!sel) {

                    return;

                }

                var rows = document.querySelectorAll('#apBankTableHost table tbody tr');

                var list = [];

                var seen = {};

                for (var i = 0; i < rows.length; i++) {

                    var row = rows[i];

                    if (row.classList.contains('ap-empty-row')) {

                        continue;

                    }

                    var api = row.getAttribute('data-apinm');

                    var accountNo = row.getAttribute('data-account') || '';

                    var ifscCode = row.getAttribute('data-ifsc') || '';

                    if (!api) {

                        var cells = row.querySelectorAll('td');

                        if (cells.length < 5) {

                            continue;

                        }

                        api = (cells[0].textContent || '').trim();

                        accountNo = (cells[3].textContent || '').trim();

                        ifscCode = (cells[4].textContent || '').trim();

                    } else {

                        api = String(api).trim();

                    }

                    if (!api) {

                        continue;

                    }

                    var key = apNormSellerKey(api);

                    if (seen[key]) {

                        continue;

                    }

                    seen[key] = true;

                    list.push({ api: api, account: accountNo, ifsc: ifscCode });

                }

                if (!list.length) {

                    return;

                }

                list.sort(function (a, b) { return a.api.localeCompare(b.api); });

                var current = sel.value;

                var currentText = '';

                if (sel.selectedIndex >= 0 && sel.options[sel.selectedIndex]) {

                    currentText = String(sel.options[sel.selectedIndex].text || '').trim();

                }

                var placeholder = sel.querySelector('option[value=""]');

                sel.innerHTML = '';

                if (placeholder) {

                    sel.appendChild(placeholder.cloneNode(true));

                } else {

                    var ph = document.createElement('option');

                    ph.value = '';

                    ph.textContent = 'Select (seller) Party';

                    sel.appendChild(ph);

                }

                for (var j = 0; j < list.length; j++) {

                    var item = list[j];

                    var opt = document.createElement('option');

                    opt.value = item.api;

                    opt.textContent = item.api;

                    opt.setAttribute('data-account', item.account);

                    opt.setAttribute('data-ifsc', item.ifsc);

                    sel.appendChild(opt);

                }

                if (current || currentText) {

                    var normCurrent = apNormSellerKey(current);

                    var normText = apNormSellerKey(currentText);

                    for (var m = 0; m < sel.options.length; m++) {

                        var o = sel.options[m];

                        var ov = apNormSellerKey(o.value);

                        var ot = apNormSellerKey(o.text);

                        if ((normCurrent && (ov === normCurrent || ot === normCurrent)) || (normText && (ov === normText || ot === normText))) {

                            sel.selectedIndex = m;

                            break;

                        }

                    }

                }

                if (sel.value) {

                    window.apOnSellerPartyChange(sel);

                }

            }



            function apBindSellerPartyEvents() {

                var sel = document.getElementById('sellerapi');

                if (!sel) {

                    return;

                }

                if (!sel.getAttribute('onchange')) {

                    sel.setAttribute('onchange', 'if(window.apOnSellerPartyChange){window.apOnSellerPartyChange(this);}');

                }

                var $ = window.vmAdminJq || window.jQuery;

                if ($) {

                    $(document).off('select2:select.apSellerFinal change.apSellerFinal', '#sellerapi');

                    $(document).on('select2:select.apSellerFinal', '#sellerapi', function () {

                        window.apOnSellerPartyChange(this);

                    });

                    $(document).on('change.apSellerFinal', '#sellerapi', function () {

                        window.apOnSellerPartyChange(this);

                    });

                }

            }



            function apBootSellerPartyPage() {

                apSyncSellerDropdownFromTableVanilla();

                if (typeof window.refreshAddPurchaseSelect2 === 'function') {

                    window.refreshAddPurchaseSelect2();

                } else if (typeof window.vmForceAdminSelect2 === 'function') {

                    window.vmForceAdminSelect2();

                }

                apBindSellerPartyEvents();

                var sel = document.getElementById('sellerapi');

                if (sel && sel.value) {

                    window.apOnSellerPartyChange(sel);

                }

            }



            window.apSyncSellerDropdownFromBankTable = apSyncSellerDropdownFromTableVanilla;



            if (document.readyState === 'loading') {

                document.addEventListener('DOMContentLoaded', function () {

                    window.setTimeout(apBootSellerPartyPage, 150);

                });

            } else {

                window.setTimeout(apBootSellerPartyPage, 150);

            }

            window.addEventListener('load', function () {

                window.setTimeout(apBootSellerPartyPage, 400);

                window.setTimeout(apBootSellerPartyPage, 1200);

            });

        })();

    </script>

}

