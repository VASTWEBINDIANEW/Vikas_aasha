@model List<Vastwebmulti.Models.gstreport_monthly_Result>
@using System.Linq
@{
    ViewBag.Title = "GST Report";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var rows = Model ?? new List<Vastwebmulti.Models.gstreport_monthly_Result>();
    var rowCount = rows.Count;

    var defaultDate = DateTime.Now.AddMonths(-1);
    var defaultMonth = defaultDate.ToString("yyyy-MM");
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=28" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-gst-report-modern.css?v=7" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-auto-fund-status-page saas-gst-report-page">

    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
            <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-gst-toolbar-head">
                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>Report's</li>
                    <li>GST Report</li>
                </ol>
                <div class="vm-dmt-fin-nav-row vm-gst-role-nav">
                    <nav class="vm-fin-nav vm-fin-nav--pill vm-fin-nav--single-line" id="gst-role-nav" aria-label="GST report role">
                        <ul class="vm-fin-nav__list" id="gst-role-nav-list">
                            <li>
                                <button type="button" id="retailer" class="vm-fin-nav__link is-active" onclick="ChangeRole('retailer')" title="Retailer GST report">
                                    <i class="fas fa-store vm-fin-nav__ico" aria-hidden="true"></i>
                                    <span>Retailer</span>
                                </button>
                            </li>
                            <li>
                                <button type="button" id="dealer" class="vm-fin-nav__link" onclick="ChangeRole('dealer')" title="Dealer GST report">
                                    <i class="fas fa-sitemap vm-fin-nav__ico" aria-hidden="true"></i>
                                    <span>Dealer</span>
                                </button>
                            </li>
                            <li>
                                <button type="button" id="master" class="vm-fin-nav__link" onclick="ChangeRole('master')" title="Master GST report">
                                    <i class="fas fa-user-tie vm-fin-nav__ico" aria-hidden="true"></i>
                                    <span>Master</span>
                                </button>
                            </li>
                        </ul>
                    </nav>
                </div>
            </div>
        </div>

        <div class="vm-opr-main-card vm-gst-report-main-card">
            <div class="vm-opr-table-panel vm-gst-report-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-file-invoice" aria-hidden="true"></i>
                        <span>GST monthly report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong id="gstRecordCount">@rowCount</strong>
                        </span>
                        <div class="saas-acc-dp-field vm-opr-dp-compact vm-gst-month-field">
                            <span class="saas-acc-dp-icon" role="button" tabindex="0" aria-label="Open month picker"><i class="fa fa-calendar"></i></span>
                            <input type="text" name="_date" id="_date" class="form-control saas-acc-dp-input vm-gst-month-input" value="@defaultMonth" required title="Select month" autocomplete="off" placeholder="yyyy-mm" readonly="readonly" />
                        </div>
                        <input type="hidden" name="role" id="role" value="retailer" />
                        <button type="button" id="search_data" class="saas-acc-btn saas-acc-btn--search vm-gst-search-btn" title="Search">
                            <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                        </button>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" id="btnExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel" onclick="excel()">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF" onclick="PDF()">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap vm-auto-fund-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll" id="gstReportExportWrap">
                        <table id="gstReportTable" class="table vm-gst-report-table" cellspacing="0">
                            <colgroup>
                                <col class="vm-gst-col vm-gst-col--sr" />
                                <col class="vm-gst-col vm-gst-col--firm" />
                                <col class="vm-gst-col vm-gst-col--num" span="20" />
                            </colgroup>
                            <thead class="vm-gst-report-thead">
                                <tr class="vm-gst-head-row vm-gst-head-row--group">
                                    <th rowspan="3" class="vm-gst-th vm-gst-th--sr">S&nbsp;No</th>
                                    <th rowspan="3" class="vm-gst-th vm-gst-th--firm">Firm&nbsp;Name</th>
                                    <th colspan="3" class="vm-gst-th vm-gst-th--group">Recharge&nbsp;&amp;&nbsp;Utility</th>
                                    <th colspan="2" class="vm-gst-th vm-gst-th--group">Imps/Neft/Upi</th>
                                    <th colspan="3" class="vm-gst-th vm-gst-th--group">AEPS</th>
                                    <th colspan="3" class="vm-gst-th vm-gst-th--group">Micro&nbsp;Atm</th>
                                    <th colspan="2" class="vm-gst-th vm-gst-th--group">PAN</th>
                                    <th colspan="2" class="vm-gst-th vm-gst-th--group">Travel&nbsp;Services</th>
                                    <th colspan="2" class="vm-gst-th vm-gst-th--group">Prepaid&nbsp;&amp;&nbsp;Gift&nbsp;Cards</th>
                                    <th colspan="3" class="vm-gst-th vm-gst-th--group">Total</th>
                                </tr>
                                <tr class="vm-gst-head-row vm-gst-head-row--sub">
                                    <th rowspan="2" class="vm-gst-th vm-gst-th--stack">Recharge<br />Gst</th>
                                    <th colspan="2" class="vm-gst-th vm-gst-th--subgroup">Utility</th>
                                    <th rowspan="2" class="vm-gst-th vm-gst-th--stack">To&nbsp;A/C<br />Gst</th>
                                    <th rowspan="2" class="vm-gst-th">Tds</th>
                                    <th rowspan="2" class="vm-gst-th vm-gst-th--stack">Aadhaarpay<br />Gst</th>
                                    <th colspan="2" class="vm-gst-th vm-gst-th--subgroup">Aeps-Mini</th>
                                    <th rowspan="2" class="vm-gst-th vm-gst-th--stack">Pos<br />Gst</th>
                                    <th colspan="2" class="vm-gst-th vm-gst-th--subgroup">MAtm-Cash</th>
                                    <th rowspan="2" class="vm-gst-th">Gst</th>
                                    <th rowspan="2" class="vm-gst-th">Tds</th>
                                    <th rowspan="2" class="vm-gst-th">Gst</th>
                                    <th rowspan="2" class="vm-gst-th">Tds</th>
                                    <th rowspan="2" class="vm-gst-th">Gst</th>
                                    <th rowspan="2" class="vm-gst-th">Tds</th>
                                    <th rowspan="2" class="vm-gst-th vm-gst-th--stack">Purchase<br />Gst</th>
                                    <th rowspan="2" class="vm-gst-th vm-gst-th--stack">Sell<br />Gst</th>
                                    <th rowspan="2" class="vm-gst-th">Tds</th>
                                </tr>
                                <tr class="vm-gst-head-row vm-gst-head-row--leaf">
                                    <th class="vm-gst-th vm-gst-th--leaf">Gst</th>
                                    <th class="vm-gst-th vm-gst-th--leaf">Tds</th>
                                    <th class="vm-gst-th vm-gst-th--leaf">Gst</th>
                                    <th class="vm-gst-th vm-gst-th--leaf">Tds</th>
                                    <th class="vm-gst-th vm-gst-th--leaf">Gst</th>
                                    <th class="vm-gst-th vm-gst-th--leaf">Tds</th>
                                </tr>
                            </thead>
                            <tbody id="gstbody">
                                @Html.Partial("_Gst_Report", rows)
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.22/pdfmake.min.js"></script>
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/0.4.1/html2canvas.min.js"></script>

<script>
    var Role = 'retailer';

    function refreshGstRecordCount() {
        var count = $('#gstbody tr.vm-gst-report-row').length;
        $('#gstRecordCount').text(count);
    }

    function excel() {
        var table = document.getElementById('gstReportTable');
        if (!table) {
            return;
        }
        var html = '<html><head><meta charset="utf-8" /></head><body>' + table.outerHTML + '</body></html>';
        var blob = new Blob(['\ufeff', html], { type: 'application/vnd.ms-excel;charset=utf-8;' });
        var link = document.createElement('a');
        link.href = URL.createObjectURL(blob);
        link.download = 'GST_Report.xls';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }

    function PDF() {
        var el = document.getElementById('gstReportExportWrap');
        if (!el || typeof html2canvas === 'undefined' || typeof pdfMake === 'undefined') {
            return;
        }
        html2canvas(el, {
            onrendered: function (canvas) {
                var data = canvas.toDataURL();
                pdfMake.createPdf({
                    content: [{ image: data, width: 500 }]
                }).download('GST_Report.pdf');
            }
        });
    }

    function searchreport(_date, role) {
        fetch('@Url.Action("_Gst_Report", "Home")?_date=' + encodeURIComponent(_date) + '&role=' + encodeURIComponent(role))
            .then(function (res) { return res.text(); })
            .then(function (data) {
                $('#gstbody').html(data);
                refreshGstRecordCount();
            });
    }

    function ChangeRole(role) {
        document.getElementById(Role).classList.remove('is-active');
        document.getElementById(role).classList.add('is-active');
        Role = role;
        $('#role').val(role);
        searchreport($('#_date').val(), role);
    }

    function initGstMonthPicker() {
        var $input = $('#_date');
        var $field = $('.vm-gst-month-field');
        var $icon = $field.find('.saas-acc-dp-icon');

        if (!$input.length) {
            return;
        }

        function bootGstMonthPicker() {
            if (!window.jQuery || !$.fn.datepicker) {
                window.setTimeout(bootGstMonthPicker, 50);
                return;
            }

            if ($input.data('datepicker')) {
                return;
            }

            var defaultVal = ($input.val() || '').trim();

            $input.prop('readonly', true);
            $input.datepicker({
                format: 'yyyy-mm',
                minViewMode: 1,
                startView: 1,
                autoclose: true,
                todayHighlight: true,
                orientation: 'bottom auto',
                forceParse: false,
                enableOnReadonly: true,
                keyboardNavigation: true,
                container: 'body'
            });

            if (defaultVal) {
                var m = defaultVal.match(/^(\d{4})-(\d{1,2})/);
                if (m) {
                    $input.datepicker('update', new Date(parseInt(m[1], 10), parseInt(m[2], 10) - 1, 1));
                }
            }

            $input.on('show', function () {
                $field.addClass('is-active');
                if (typeof window.repositionAdminDatepickerForMobile === 'function') {
                    window.repositionAdminDatepickerForMobile();
                }
            });

            $input.on('hide changeDate', function () {
                $field.removeClass('is-active');
            });

            function openMonthPicker(e) {
                if (e) {
                    e.preventDefault();
                    e.stopPropagation();
                }
                $input.datepicker('show');
            }

            $icon.off('click.gstMonth').on('click.gstMonth', openMonthPicker);
            $icon.off('keydown.gstMonth').on('keydown.gstMonth', function (e) {
                if (e.key === 'Enter' || e.key === ' ') {
                    openMonthPicker(e);
                }
            });
            $input.off('click.gstMonth').on('click.gstMonth', openMonthPicker);
        }

        bootGstMonthPicker();
    }

    $(document).ready(function () {
        initGstMonthPicker();
        refreshGstRecordCount();

        $('#search_data').on('click', function () {
            searchreport($('#_date').val(), Role);
        });
    });
</script>
