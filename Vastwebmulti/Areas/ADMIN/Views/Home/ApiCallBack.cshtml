@model IEnumerable<Vastwebmulti.Models.RechargeapiInfo>
@using System.Linq
@using Vastwebmulti.Models
@{
    ViewBag.Title = "ApiCallBack";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var rows = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.RechargeapiInfo>();
    var baseUrl = ViewBag.api as string ?? string.Empty;

    if (string.IsNullOrWhiteSpace(baseUrl) || baseUrl.IndexOf("localhost", System.StringComparison.OrdinalIgnoreCase) >= 0 || baseUrl.IndexOf("127.0.0.1", System.StringComparison.OrdinalIgnoreCase) >= 0)
    {
        using (var dbCtx = new VastwebmultiEntities())
        {
            var websiteUrl = dbCtx.Admin_details.Select(a => a.WebsiteUrl).FirstOrDefault();
            if (!string.IsNullOrWhiteSpace(websiteUrl))
            {
                var domain = websiteUrl.Trim().ToLowerInvariant()
                    .Replace("https://www.", string.Empty)
                    .Replace("http://www.", string.Empty)
                    .Replace("https://", string.Empty)
                    .Replace("http://", string.Empty)
                    .TrimEnd('/');

                if (domain.StartsWith("www."))
                {
                    domain = domain.Substring(4);
                }

                if (!string.IsNullOrWhiteSpace(domain)
                    && domain.IndexOf("localhost", System.StringComparison.OrdinalIgnoreCase) < 0
                    && domain.IndexOf("127.0.0.1", System.StringComparison.OrdinalIgnoreCase) < 0)
                {
                    if (!domain.StartsWith("recharge."))
                    {
                        domain = "recharge." + domain;
                    }

                    baseUrl = "https://" + domain;
                }
            }
        }
    }

    baseUrl = (baseUrl ?? string.Empty).TrimEnd('/');
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=28" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-api-operator-modern.css?v=32" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-api-operator-page saas-recharge-api-response-page saas-recharge-api-callback-page">
    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
            <div class="saas-acc-toolbar-top vm-api-operator-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-api-operator-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li><a href="@Url.Action("Dashboard", "Home")#setting">Basic Setting</a></li>
                    <li>Recharge API Call Back Page</li>
                </ol>
                <div class="vm-dmt-fin-nav-row vm-api-operator-nav-wrap">
                    @Html.Partial("_menuapinm")
                </div>
            </div>

            <div class="vm-rpt-filters-panel vm-api-operator-filter-panel">
                <div class="saas-acc-filter-bar vm-opr-filter-row vm-api-operator-filter-row vm-rpt-filters-panel__bar vm-recharge-api-toolbar-one-line vm-recharge-api-toolbar-one-line--tabs-only">
                    <div class="vm-recharge-api-sub-tabs" role="tablist" aria-label="Recharge API">
                        <a href="@Url.Action("RechargeAPIUrl", "Home")" class="vm-recharge-api-sub-tab" role="tab" aria-selected="false">Recharge API URL</a>
                        <a href="@Url.Action("RechargeApiResponse", "Home")" class="vm-recharge-api-sub-tab" role="tab" aria-selected="false">Recharge API Response</a>
                        <a href="@Url.Action("ApiCallBackUrl", "Home")" class="vm-recharge-api-sub-tab" role="tab" aria-selected="false">Recharge API Call Back</a>
                        <a href="@Url.Action("ApiCallBack", "Home")" class="vm-recharge-api-sub-tab is-active" role="tab" aria-selected="true">Recharge API Call Back Page</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-link" aria-hidden="true"></i>
                        <span>Recharge API callback page URLs</span>
                    </div>
                    <label class="vm-api-operator-table-search" for="rechargeApiCallBackPageSearch">
                        <i class="fas fa-search" aria-hidden="true"></i>
                        <input type="text" id="rechargeApiCallBackPageSearch" placeholder="Search records..." autocomplete="off" />
                    </label>
                </div>
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <div id="datashoww">
                            <table id="rechargeApiCallBackPageTable" class="table vm-opr-data-table vm-recharge-api-data-table" cellspacing="0">
                                <thead>
                                    <tr>
                                        <th class="vm-recharge-api-th--name">API Name</th>
                                        <th class="vm-recharge-api-th--url">Call Back Page</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in rows)
                                    {
                                        <tr data-api-name="@(item.apiname ?? "")">
                                            <td class="vm-recharge-api-td--name">@item.apiname</td>
                                            <td class="vm-recharge-api-td--url">
                                                <span class="vm-recharge-api-callback-url-text">@baseUrl/Response/apiresponse/@item.id</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    (function () {
        function applyRechargeApiCallBackPageSearch() {
            var q = ($('#rechargeApiCallBackPageSearch').val() || '').trim().toLowerCase();
            $('#rechargeApiCallBackPageTable tbody tr').each(function () {
                var text = $(this).text().toLowerCase();
                $(this).toggle(!q || text.indexOf(q) > -1);
            });
        }

        function bootRechargeApiCallBackPage() {
            var $ = window.jQuery;
            if (!$) {
                window.setTimeout(bootRechargeApiCallBackPage, 50);
                return;
            }

            $('#rechargeApiCallBackPageSearch').off('keyup.rechargeApiCbPage').on('keyup.rechargeApiCbPage', applyRechargeApiCallBackPageSearch);
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', bootRechargeApiCallBackPage);
        } else {
            bootRechargeApiCallBackPage();
        }
    })();
</script>
