@model Vastwebmulti.Areas.ADMIN.Models.ChattingModel
@using System.Linq
@{
    ViewBag.Title = "Complaint";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var users = Model != null && Model.Chatuser != null ? Model.Chatuser.ToList() : new List<Vastwebmulti.Models.chat_user_Result>();
    var messages = Model != null && Model.Complainreq != null ? Model.Complainreq.ToList() : new List<Vastwebmulti.Models.proc_Complaint_request_Result>();
    var activeUserId = (Request["userid"] ?? "").Trim();
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-support-pages-modern.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-support-page saas-complaint-page">
    <div class="container-fluid">
        <div class="saas-acc-toolbar saas-pan-toolbar-unified" style="margin-bottom:16px;">
            <ol class="saas-acc-breadcrumb">
                <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                <li><a href="javascript:void(0);">Complaint</a></li>
                <li>Chats</li>
            </ol>
        </div>

        <button type="button" class="saas-complaint-mobile-toggle" id="saasComplaintToggleUsers" aria-expanded="true">
            <i class="fas fa-users"></i> Show / hide users
        </button>

        <div class="saas-complaint-layout">
            <div class="saas-complaint-users-card" id="saasComplaintUsersCard">
                <div class="saas-complaint-card-head">
                    <i class="fas fa-user-circle" aria-hidden="true"></i> Users list
                </div>
                <ul class="saas-complaint-users-list">
                    @foreach (var item in users)
                    {
                        var isActive = !string.IsNullOrEmpty(activeUserId) && item.Userid == activeUserId;
                        <li class="saas-complaint-user-item @(isActive ? "is-active" : "")"
                            data-userid="@item.Userid"
                            onclick="complaintSelectUser('@item.Userid')">
                            @if (!string.IsNullOrEmpty(item.Photo))
                            {
                                <img src="@Url.Content("~/" + item.Photo)" class="saas-complaint-user-avatar" alt="" />
                            }
                            else
                            {
                                <img src="~/images/reportimage/chatuserimage.png" class="saas-complaint-user-avatar" alt="" />
                            }
                            <div class="saas-complaint-user-meta">
                                <strong>@item.Email</strong>
                                <span>@item.Name · @item.Role</span>
                            </div>
                            <span class="saas-complaint-badge @(item.count == 0 ? "is-zero" : "")">@item.count</span>
                        </li>
                    }
                </ul>
            </div>

            <div class="saas-complaint-chat-card">
                <div class="saas-complaint-card-head">
                    <i class="fas fa-comments" aria-hidden="true"></i> Chatting details
                </div>
                <div class="saas-complaint-messages">
                    @if (messages.Count == 0)
                    {
                        <p class="text-muted text-center" style="padding:24px;">Select a user from the list to view complaints.</p>
                    }
                    @foreach (var item in messages)
                    {
                        if (item.rdate != null)
                        {
                            <div class="saas-chat-bubble saas-chat-bubble--in clearfix">
                                <div class="saas-chat-bubble-head"><strong>@item.Email</strong> · @item.rdate</div>
                                <div class="saas-chat-bubble-body">@item.complant</div>
                            </div>
                            if (item.resdate == null)
                            {
                                <div class="saas-chat-reply-bar clearfix">
                                    <input type="text" id="@item.idno" class="form-control" placeholder="Type your reply..." autocomplete="off" />
                                    <button type="button" class="saas-chat-reply-btn" onclick="complaintSubmitReply('@item.idno','@item.userid')" title="Send reply">
                                        <i class="fa fa-paper-plane"></i>
                                    </button>
                                </div>
                            }
                        }
                        if (item.resdate != null)
                        {
                            <div class="saas-chat-bubble saas-chat-bubble--out clearfix">
                                <div class="saas-chat-bubble-head"><strong>Admin</strong> · @item.resdate</div>
                                <div class="saas-chat-bubble-body">@item.response</div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<script src="~/MainFrontDesign/js/admin-complaint-chat.js"></script>
<script>
    window.complaintPageUrl = '@Url.Action("Complaint", "Home")';
    window.complaintEditUrl = '@Url.Action("Complaint_edit", "Home")';
</script>
