                                <span class="vm-postpaid-bulk-item__range">50,001 to 100,000 (%)</span>
                            </label>
                            <input id="move4allapi" type="text" placeholder="e.g. 1-100%" class="form-control vm-postpaid-bulk-item__input" />
                        </div>
                        <div class="vm-postpaid-bulk-item">
                            <label class="vm-postpaid-bulk-item__label" for="move5allapi">
                                <span class="vm-postpaid-bulk-item__badge">5</span>
                                <span class="vm-postpaid-bulk-item__range">100,001 &amp; above (%)</span>
                            </label>
                            <input id="move5allapi" type="text" placeholder="e.g. 1-100%" class="form-control vm-postpaid-bulk-item__input" />
                        </div>
                    </div>
                </div>
                <div id="divEditFormEXTRAAPI">
                    @Html.Partial("_ExtraInfoAPI", Model)
                </div>
            </div>
        </div>
    </div>
</div>

<script src="~/MainFrontDesign/js/admin-report-pdf-export.js?v=4"></script>
<script src="~/MainFrontDesign/js/admin-report-excel-export.js?v=5"></script>

<script>
    var FormId = "";
    var roleshow = "";

    var slabTabByRole = {
        'Common': '#Comm',
        'Master': '#Mdbtn',
        'Dealer': '#Dlmbtn',
        'Retailer': '#Rembtn',
        'API': '#Apibtn',
        'Whitelabel': '#Whitebtn'
    };

    function setSlabTabActive(selector) {
        $('.vm-pg-slab-tab')
            .removeClass('vm-pg-slab-tab--active')
            .addClass('vm-pg-slab-tab--inactive')
            .attr('aria-selected', 'false');

        $(selector)
            .removeClass('vm-pg-slab-tab--inactive')
            .addClass('vm-pg-slab-tab--active')
            .attr('aria-selected', 'true');
    }

    function setSlabTabByRole(userRole) {
        var selector = slabTabByRole[userRole] || '#Comm';
        setSlabTabActive(selector);
    }

    function showRetailerDrop() {
        $('#retailerdrop').css('display', 'flex').addClass('show-retailer');
        $('#allshow').hide();
    }

    function showAllUsersDrop() {
        $('#retailerdrop').hide().removeClass('show-retailer');
        $('#allshow').show();
    }

    function resetSlabSaveButtons() {
        $('#btnsubmit, #btnsubmituser, #btnsubmitusercommon, #btnsubmitusercommondlmrem')
            .hide().removeClass('is-visible');
        $('#btnEdit').show().removeClass('is-hidden');
    }

    function resetSlabViewMode() {
        $('#tbodyshow').removeClass('vm-pg-slab-tbody--hidden').addClass('vm-pg-slab-tbody--view');
        $('#tbodyedit, #tbodyeditAll').addClass('vm-pg-slab-tbody--hidden');
        resetSlabSaveButtons();
    }

    function showSlabEditMode() {
        $('#tbodyshow').addClass('vm-pg-slab-tbody--hidden').removeClass('vm-pg-slab-tbody--view');
        $('#tbodyedit, #tbodyeditAll').addClass('vm-pg-slab-tbody--hidden');

        var ddlVal = $('#ddlUserId').val();
        var retailerval = $('#Retailerid').length ? $('#Retailerid').val() : null;
        var useEditAll = false;

        if ($('#tbodyeditAll').length) {
            if (ddlVal === '' || ddlVal === null) {
                useEditAll = true;
            }
            if (retailerval !== null && retailerval === '') {
                useEditAll = true;
            }
            if (retailerval !== null && retailerval !== '') {
                useEditAll = false;
            }
        }

        if (useEditAll) {
            $('#tbodyeditAll').removeClass('vm-pg-slab-tbody--hidden');
        } else if ($('#tbodyedit').length) {
            $('#tbodyedit').removeClass('vm-pg-slab-tbody--hidden');
        }

        $('#btnEdit').hide().addClass('is-hidden');
    }

    function showSlabSaveButtons() {
        $('#btnsubmit, #btnsubmituser, #btnsubmitusercommon, #btnsubmitusercommondlmrem').removeClass('is-visible').hide();

        var val = $('#ddlUserId').val();
        var ddldlm = $('#ddldealer').val();
        var ddlrem = $('#ddlUserIdrem').val();

        if ($('#btnsubmit').length) {
            $('#btnsubmit').show().addClass('is-visible');
        }
        if ($('#btnsubmituser').length) {
            $('#btnsubmituser').show().addClass('is-visible');
        }
        if (val === '' || val === null) {
            if ($('#btnsubmitusercommon').length) {
                $('#btnsubmitusercommon').show().addClass('is-visible');
            }
        }
        if (roleshow === 'Retailer' && ddldlm !== '' && ddlrem === '') {
            if ($('#btnsubmitusercommondlmrem').length) {
                $('#btnsubmitusercommondlmrem').show().addClass('is-visible');
            }
        }
    }

    function initPgSlabPartialUi() {
        if ($.fn.select2) {
            $('.saas-postpaid-utility-slab-page .for-select2').each(function () {
                var $el = $(this);
                try {
                    if ($el.hasClass('select2-hidden-accessible')) {
                        $el.select2('destroy');
                    }
                } catch (e) { }
                $el.select2({
                    width: '100%',
                    dropdownParent: $(document.body)
                });
            });
        }
    }

    function bindPgSlabTableHover() {
        $(document).off('mouseenter.pgslab mouseleave.pgslab', '.saas-postpaid-utility-slab-page .third-design-table tbody td');
        $(document).on('mouseenter.pgslab', '.saas-postpaid-utility-slab-page .third-design-table tbody td', function () {
            var colIndex = $(this).parent().children().index($(this)) + 1;
            var rowIndex = $(this).parent().parent().children().index($(this).parent()) + 1;
            $(".saas-postpaid-utility-slab-page .third-design-table td:nth-child(" + colIndex + ")").css({ background: 'var(--main-bg-rcolor, #2563eb)', color: '#fff' });
            $(".saas-postpaid-utility-slab-page .third-design-table tbody tr:nth-child(" + rowIndex + ")").css('background', 'var(--main-bg-rcolor, #2563eb)');
        });
        $(document).on('mouseleave.pgslab', '.saas-postpaid-utility-slab-page .third-design-table tbody td', function () {
            var colIndex = $(this).parent().children().index($(this)) + 1;
            var rowIndex = $(this).parent().parent().children().index($(this).parent()) + 1;
            $(".saas-postpaid-utility-slab-page .third-design-table td:nth-child(" + colIndex + ")").css({ background: '', color: '' });
            $(".saas-postpaid-utility-slab-page .third-design-table tbody tr:nth-child(" + rowIndex + ")").css('background', '');
        });
    }

    function funcEdit(event, frmId) {
        if (FormId === '') {
            FormId = frmId;
        }
        showSlabEditMode();
        showSlabSaveButtons();
        var $scroll = $('.saas-postpaid-utility-slab-page .vm-pg-slab-table-scroll').first();
        if ($scroll.length) {
            $scroll[0].scrollLeft = 0;
        }
    }

    function funcSave() {
        $("#" + FormId + "").submit();
    }

    function getPostpaidExportTable() {
        return document.getElementById('postpaidUtilitySlabTable');
    }

    function countPostpaidExportRows(table) {
        if (!table) {
            return 0;
        }
        var rows = table.querySelectorAll('tbody#tbodyshow tr, tbody.vm-pg-slab-tbody--view tr');
        return rows.length;
    }

    function getPostpaidExportCellText(cell) {
        if (!cell) {
            return '';
        }
        var select = cell.querySelector('select');
        if (select) {
            var option = select.options[select.selectedIndex];
            return option ? option.text.replace(/\s+/g, ' ').trim() : '';
        }
        var input = cell.querySelector('input, textarea');
        if (input) {
            return (input.value || '').replace(/\s+/g, ' ').trim();
        }
        return (cell.innerText || cell.textContent || '').replace(/\s+/g, ' ').trim();
    }

    function getPostpaidExportHeaderText(th) {
        if (!th) {
            return '';
        }
        if (th.classList.contains('vm-postpaid-optype-head')) {
            var label = th.querySelector('.vm-postpaid-optype-head__label');
            if (label) {
                return label.textContent.replace(/\s+/g, ' ').trim();
            }
            return 'Operator Type';
        }
        return (th.innerText || th.textContent || '').replace(/\s+/g, ' ').trim();
    }

    function getPostpaidExportBodyRows(table) {
        var viewRows = table.querySelectorAll('tbody#tbodyshow tr, tbody.vm-pg-slab-tbody--view tr');
        if (viewRows.length) {
            return viewRows;
        }

        var editRows = table.querySelectorAll('tbody#tbodyedit tr, tbody#tbodyeditAll tr');
        var filtered = [];
        var i;

        for (i = 0; i < editRows.length; i++) {
            if (editRows[i].querySelector('#common1, #common2, #common3, #common4, #common5, .vm-prepaid-reduce-btn')) {
                continue;
            }
            if (editRows[i].querySelectorAll('td').length) {
                filtered.push(editRows[i]);
            }
        }

        return filtered;
    }

    function collectPostpaidSlabExportData(table) {
        var headers = [];
        var rows = [];
        var headerRow = table ? table.querySelector('thead tr:first-child') : null;
        var headerCells = headerRow ? headerRow.querySelectorAll('th') : [];
        var bodyRows = table ? getPostpaidExportBodyRows(table) : [];
        var i;
        var r;
        var cells;
        var rowData;

        for (i = 0; i < headerCells.length; i++) {
            headers.push(getPostpaidExportHeaderText(headerCells[i]));
        }

        for (r = 0; r < bodyRows.length; r++) {
            cells = bodyRows[r].querySelectorAll('td');
            rowData = [];
            for (i = 0; i < cells.length; i++) {
                rowData.push(getPostpaidExportCellText(cells[i]));
            }

            if (!rowData.length) {
                continue;
            }

            if (rowData.join('').length === 0) {
                continue;
            }

            rows.push({ cells: rowData, meta: { isTotal: false } });
        }

        return { headers: headers, rows: rows };
    }

    function getPostpaidExportTitle() {
        var role = roleshow || 'Common';
        return 'Postpaid Utility Slab - ' + role;
    }

    function exportPostpaidExcel() {
        var table = getPostpaidExportTable();
        var exportData = collectPostpaidSlabExportData(table);
        var rowCount = exportData.rows.length;
        if (!table || typeof window.openAdminModernReportExcel !== 'function') {
            return;
        }
        if (rowCount === 0) {
            alert('No data available to export.');
            return;
        }
        window.openAdminModernReportExcel({
            data: exportData,
            title: getPostpaidExportTitle(),
            subtitle: 'Postpaid utility commission slab setting',
            fromDate: 'N/A',
            toDate: 'N/A',
            recordCount: rowCount,
            filePrefix: 'Postpaid_Utility_Slab',
            sheetName: 'Utility Slab'
        });
    }

    function exportPostpaidPdf() {
        var table = getPostpaidExportTable();
        var exportData = collectPostpaidSlabExportData(table);
        var rowCount = exportData.rows.length;
        if (!table || typeof window.openAdminModernReportPdf !== 'function') {
            return;
        }
        if (rowCount === 0) {
            alert('No data available to export.');
            return;
        }
        window.openAdminModernReportPdf({
            data: exportData,
            title: getPostpaidExportTitle(),
            subtitle: 'Postpaid utility commission slab setting',
            fromDate: 'N/A',
            toDate: 'N/A',
            orientation: 'landscape',
            recordCount: rowCount,
            recordLabel: rowCount + ' record' + (rowCount === 1 ? '' : 's')
        });
    }

    function editChargeType() {
        $('#div_Loader').show();
        var url = '@Url.Action("_utility_charge_type", "Home")';
        $.post(url, function (data) {
            $('#div_Loader').hide();
            $('#postpaidUtilityChargeBody').html(data);
            $('#postpaidUtilityChargeModal').modal('show');
        }).fail(function () {
            $('#div_Loader').hide();
            alert('Unable to load utility charge settings.');
        });
    }

    function change(usertype, rchtype) {
        var url = '@Url.Action("_utility_charge_type", "Home")';
        $.post(url, { usertype: usertype, rchtype: rchtype }, function (data) {
            $('#postpaidUtilityChargeBody').html(data);
        }).fail(function () {
            alert('Unable to update utility charge setting.');
        });
    }

    function editUserWise(userRole, frmId) {
        roleshow = userRole;
        setSlabTabByRole(userRole);
        $('#div_Loader').show();
        resetSlabViewMode();

        var url = '@Url.Action("_UserPostpaidUtilitySlab", "Home")';
        $.post(url, { role: userRole }, function (data) {
            $('#div_Loader').hide();
            $("#divEditFormComm").html(data);
            FormId = frmId;
            $("#role").val(userRole);
            initPgSlabPartialUi();
            resetSlabViewMode();
            if (userRole === "Retailer") {
                showRetailerDrop();
            } else {
                showAllUsersDrop();
            }
        }).fail(function (xhr) {
            $('#div_Loader').hide();
            alert("error");
            console.log(xhr.responseText);
        });
    }

    function ddlUserIdChange() {
        var ddlVal = $('#ddlUserId').val();
        var role = $("#role").val();
        var ddlOPttype1 = $('#ddlOPttype1').val();
        resetSlabViewMode();
        var url = '@Url.Action("_UserPostpaidUtilitySlab", "Home")';
        $.post(url, { role: role, userid: ddlVal, ddlVal1: ddlOPttype1 }, function (data) {
            $("#divEditFormComm").html(data);
            initPgSlabPartialUi();
            resetSlabViewMode();
        });
    }

    function ddlUserIdChangerem() {
        var dlmid = $('#ddldealer').val();
        var ddlVal = $('#ddlUserIdrem').val();
        var ddlVal1 = $("#ddlOPttype1").val();
        var role = $("#role").val();
        resetSlabViewMode();
        var url = '@Url.Action("_UserPostpaidUtilitySlab", "Home")';
        $.post(url, { role: role, ddlUserIdrem: ddlVal, dlmid: dlmid, ddlVal1: ddlVal1 }, function (data) {
            $("#divEditFormComm").html(data);
            showRetailerDrop();
            initPgSlabPartialUi();
            resetSlabViewMode();
        });
    }

    function ddlopttypeChange1() {
        var dlmid = $('#ddldealer').val();
        var ddlVal = $('#ddlUserId').val();
        var role = $("#role").val();
        var ddlOPttype1 = $('#ddlOPttype1').val();
        resetSlabViewMode();
        var url = '@Url.Action("_UserPostpaidUtilitySlab", "Home")';
        $.post(url, { role: role, userid: ddlVal, dlmid: dlmid, ddlVal1: ddlOPttype1 }, function (data) {
            $("#divEditFormComm").html(data);
            if (role === "Retailer") {
                showRetailerDrop();
            }
            initPgSlabPartialUi();
            resetSlabViewMode();
        });
    }

    function ddlRetailerIdChange() {
        resetSlabViewMode();
        var ddlVal = $('#Retailerid').val();
        var ddlOPttype1 = $('#ddlOPttype1').val();
        var ddlValdealer = $('#ddlUserId').val();
        var role = $("#role").val();
        var url = '@Url.Action("_UserPostpaidUtilitySlab", "Home")';
        $.post(url, { role: role, Retailerid: ddlVal, ddlVal1: ddlOPttype1 }, function (data) {
            $("#divEditFormComm").html(data);
            $('#ddlUserId').val(ddlValdealer);
            showRetailerDrop();
            initPgSlabPartialUi();
            resetSlabViewMode();
        });
    }

    function ddlretailerid() {
        var dlmid = $('#ddldealer').val();
        var role = $("#role").val();
        var ddlVal1 = $("#ddlOPttype1").val();
        resetSlabViewMode();
        var url = '@Url.Action("_UserPostpaidUtilitySlab", "Home")';
        $.post(url, { role: role, dlmid: dlmid, ddlVal1: ddlVal1 }, function (data) {
            $("#divEditFormComm").html(data);
            showRetailerDrop();
            initPgSlabPartialUi();
            resetSlabViewMode();
        });
    }

    function ddlopttypeChange() {
        var ddlVal = $('#ddlOPttype').val();
        var url = '@Url.Action("_common_utility_comm", "Home")';
        $.ajax({
            type: "POST",
            url: url,
            data: "ddlVal=" + ddlVal,
            success: function (result) {
                $("#divEditFormComm").html(result);
                initPgSlabPartialUi();
                resetSlabViewMode();
            }
        });

        $.ajax({
            type: "POST",
            url: '@Url.Action("_ExtraInfo", "Home")',
            data: "ddlVal=" + ddlVal,
            success: function (result) {
                $("#divEditFormEXTRA").html(result);
            }
        });

        $.ajax({
            type: "POST",
            url: '@Url.Action("_ExtraInfoAPI", "Home")',
            data: "ddlVal=" + ddlVal,
            success: function (result) {
                $("#divEditFormEXTRAAPI").html(result);
            }
        });
    }

    function extraretailer() {
        $('#myModalExtra').modal('show');
    }

    function extraapi() {
        $('#myModalExtraAPI').modal('show');
    }

    function OnSuccessExtra() {
        $('#myModalExtra').modal('hide');
    }

    function OnSuccessExtraAPI() {
        $('#myModalExtraAPI').modal('hide');
    }

    var Replaceall = function () {
        $('.move1').val($('#move1all').val());
        $('.move2').val($('#move2all').val());
        $('.move3').val($('#move3all').val());
        $('.move4').val($('#move4all').val());
        $('.move5').val($('#move5all').val());
        $('#move1all, #move2all, #move3all, #move4all, #move5all').val('');
    };

    var Replaceallapi = function () {
        $('.move1api').val($('#move1allapi').val());
        $('.move2api').val($('#move2allapi').val());
        $('.move3api').val($('#move3allapi').val());
        $('.move4api').val($('#move4allapi').val());
        $('.move5api').val($('#move5allapi').val());
        $('#move1allapi, #move2allapi, #move3allapi, #move4allapi, #move5allapi').val('');
    };

    function commonreplace() { $('.commonmaster').val($('#common1').val()); $('.commondlm').val($('#common2').val()); $('.commonrem').val($('#common3').val()); $('.commonapi').val($('#common4').val()); $('.commonwhite').val($('#common5').val()); }
    function masterreplace() { $('.master1').val($('#master1').val()); }
    function Dealerreplace() { $('.dealer1').val($('#dealer1').val()); }
    function Retailerreplace() { $('.Retailer1').val($('#Retailer1').val()); }
    function dlmremreplace() { $('.dlmrem1').val($('#dlmrem1').val()); }
    function apireplace() { $('.api1').val($('#api1').val()); }
    function whitereplace() { $('.white1').val($('#white1').val()); }
    function masterallreplace() { $('.masterall1').val($('#masterall1').val()); }
    function Dealerallreplace() { $('.dealerall1').val($('#dealerall1').val()); }
    function Retailerallreplace() { $('.Retailerall1').val($('#Retailerall1').val()); }
    function dlmRetailerallreplace() { $('.DLMRetailerall1').val($('#DLMRetailerall1').val()); }
    function apiallreplace() { $('.apiall1').val($('#apiall1').val()); }
    function Whiteallreplace() { $('.whiteall1').val($('#whiteall1').val()); }

    $(document).ready(function () {
        bindPgSlabTableHover();
        initPgSlabPartialUi();
        resetSlabViewMode();
        setSlabTabByRole('Common');
        $('#commper2').val('@ViewBag.unload2');
        $('#commper').val('@ViewBag.unload1');

        $('#btnExportPostpaid').on('click', exportPostpaidExcel);
        $('#btnPDFPostpaid').on('click', exportPostpaidPdf);
    });
</script>
