    <div class="modal-dialog modal-dialog-centered saas-admin-modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header saas-admin-modal-header accent-violet">
                <div class="saas-admin-modal-head-main">
                    <div class="saas-admin-modal-icon"><i class="fas fa-percentage" aria-hidden="true"></i></div>
                    <div class="saas-admin-modal-title-wrap">
                        <h4 class="modal-title saas-admin-modal-title" id="postpaidExtraModalLabel">Reduce Commission by Category</h4>
                        <p class="saas-admin-modal-subtitle">Bulk replace commission reduction values across operators</p>
                    </div>
                </div>
                <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
            </div>
            <div class="modal-body saas-admin-modal-body saas-admin-modal-scroll vm-postpaid-modal-body vm-postpaid-extra-body">
                <div class="vm-postpaid-bulk-panel">
                    <p class="vm-postpaid-bulk-panel__title">Quick bulk replace</p>
                    <p class="vm-postpaid-bulk-panel__hint">Enter a value for each slab range, then click <strong>Replace Table Data</strong>.</p>
                    <div class="vm-postpaid-bulk-grid">
                        <div class="vm-postpaid-bulk-item">
                            <label class="vm-postpaid-bulk-item__label" for="move1all">
                                <span class="vm-postpaid-bulk-item__badge">1</span>
                                <span class="vm-postpaid-bulk-item__range">0 to 1,500 (%)</span>
                            </label>
                            <input id="move1all" type="text" placeholder="e.g. 1-100%" class="form-control vm-postpaid-bulk-item__input" />
                        </div>
                        <div class="vm-postpaid-bulk-item">
                            <label class="vm-postpaid-bulk-item__label" for="move2all">
                                <span class="vm-postpaid-bulk-item__badge">2</span>
                                <span class="vm-postpaid-bulk-item__range">1,501 to 10,000 (%)</span>
                            </label>
                            <input id="move2all" type="text" placeholder="e.g. 1-100%" class="form-control vm-postpaid-bulk-item__input" />
                        </div>
                        <div class="vm-postpaid-bulk-item">
                            <label class="vm-postpaid-bulk-item__label" for="move3all">
                                <span class="vm-postpaid-bulk-item__badge">3</span>
                                <span class="vm-postpaid-bulk-item__range">10,001 to 50,000 (%)</span>
                            </label>
                            <input id="move3all" type="text" placeholder="e.g. 1-100%" class="form-control vm-postpaid-bulk-item__input" />
                        </div>
                        <div class="vm-postpaid-bulk-item">
                            <label class="vm-postpaid-bulk-item__label" for="move4all">
                                <span class="vm-postpaid-bulk-item__badge">4</span>
                                <span class="vm-postpaid-bulk-item__range">50,001 to 100,000 (%)</span>
                            </label>
                            <input id="move4all" type="text" placeholder="e.g. 1-100%" class="form-control vm-postpaid-bulk-item__input" />
                        </div>
                        <div class="vm-postpaid-bulk-item">
                            <label class="vm-postpaid-bulk-item__label" for="move5all">
                                <span class="vm-postpaid-bulk-item__badge">5</span>
                                <span class="vm-postpaid-bulk-item__range">100,001 &amp; above (%)</span>
                            </label>
                            <input id="move5all" type="text" placeholder="e.g. 1-100%" class="form-control vm-postpaid-bulk-item__input" />
                        </div>
                    </div>
                </div>
                <div id="divEditFormEXTRA">
                    @Html.Partial("_ExtraInfo", Model)
                </div>
            </div>
        </div>
    </div>
</div>

<div id="myModalExtraAPI" class="modal fade saas-admin-modal vm-postpaid-modal vm-postpaid-modal--extra" tabindex="-1" role="dialog" aria-labelledby="postpaidExtraApiModalLabel">
