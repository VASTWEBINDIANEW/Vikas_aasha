@model IEnumerable<Vastwebmulti.Models.roffer_retailer_comm_Result>

@using System.Linq

@using Vastwebmulti.Models

@{

    ViewBag.Title = "R-Offer History";

    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();

    var toDate = (Request["txt_to_date"] ?? "").Trim();

    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var dateMode = (ViewBag.chk as string) == "post" ? "post" : "get";

    var operatorName = (Request["OperatorName"] ?? ViewBag.OperatorName as string ?? "ALL").Trim();

    if (string.IsNullOrEmpty(operatorName)) { operatorName = "ALL"; }

    var sharingOn = (ViewBag.chkroffersts as string) == "Y";

    var rofferRows = ViewBag.RofferRows as IEnumerable<roffer_All_history_Result> ?? Enumerable.Empty<roffer_All_history_Result>();

    var operatorOptions = new List<SelectListItem>

    {

        new SelectListItem { Text = "All Operator", Value = "ALL", Selected = operatorName == "ALL" },

        new SelectListItem { Text = "Idea", Value = "Idea", Selected = operatorName == "Idea" },

        new SelectListItem { Text = "Airtel", Value = "Airtel", Selected = operatorName == "Airtel" },

        new SelectListItem { Text = "Vodafone", Value = "Vodafone", Selected = operatorName == "Vodafone" }

    };

}



<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />

<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />

<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />

<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />

<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=7" rel="stylesheet" />

<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=31" rel="stylesheet" />

<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=2" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-roffer-report-modern.css?v=3" rel="stylesheet" />



<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-roffer-report-page">

    <div class="container-fluid vm-opr-page-shell">



        @using (Html.BeginForm("Roffer_history", "Home", FormMethod.Post, new { id = "rofferReportForm", data_date_mode = dateMode, data_frm_date = frmDate, data_to_date = toDate, data_scroll_url = Url.Action("Scroll_Roffer_history", "Home") }))

        {

            <div class="saas-acc-toolbar saas-pan-toolbar-unified saas-acc-toolbar--stacked vm-opr-toolbar-unified">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head">

                    <ol class="saas-acc-breadcrumb">

                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>

                        <li>R-Offer History</li>

                    </ol>

                    <div class="vm-opr-page-nav">

                        @Html.Partial("menuoperatorreport")

                    </div>

                </div>



                <div class="vm-rpt-filters-panel">
                <div class="saas-acc-filter-bar vm-opr-filter-row vm-roffer-filter-row vm-rpt-filters-panel__bar">

                    <div class="vm-opr-field vm-roffer-field--retailer">
                        @Html.DropDownList("allretailer", ViewBag.allretailer as SelectList, "All Retailer", new { id = "allretailer", @class = "vm-opr-select form-control", @title = "Retailer" })
                    </div>

                    <div class="vm-opr-field vm-roffer-field--operator">
                        @Html.DropDownList("OperatorName", operatorOptions, new { id = "OperatorName", @class = "vm-opr-select form-control", @title = "Operator" })
                    </div>

                    <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field">
                        <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                        @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                    </div>

                    <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field">
                        <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                        @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                    </div>

                    <button id="btntype_OLD" name="btntype" type="submit" value="SEARCH" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-roffer-search-btn" title="Search">
                        <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                    </button>

                    <div class="vm-opr-filter-actions saas-acc-export-group saas-pan-export-group vm-roffer-filter-actions">
                        <button type="button" class="saas-acc-btn saas-acc-btn--excel saas-pan-export-btn" id="btnExl" title="Export Excel"><i class="fas fa-file-excel" aria-hidden="true"></i><span>Excel</span></button>
                        <button type="button" class="saas-acc-btn saas-acc-btn--pdf saas-pan-export-btn" id="btnPDF" title="Export PDF"><i class="fas fa-file-pdf" aria-hidden="true"></i><span>PDF</span></button>
                        <button type="button" class="saas-acc-btn saas-acc-btn--ghost vm-roffer-comm-btn" id="btnSetComm" data-toggle="modal" data-target="#rofferCommModal" title="Set commission">
                            <i class="fas fa-cog" aria-hidden="true"></i><span>Set Comm</span>
                        </button>
                        <button type="button" class="vm-roffer-share-btn @(sharingOn ? "is-on" : "is-off")" id="rofferSharingToggle" title="Toggle user sharing">
                            <i class="fas @(sharingOn ? "fa-check-circle" : "fa-times-circle")" aria-hidden="true"></i>
                            <span>User Sharing</span>
                        </button>
                    </div>
                </div>
                </div>

            </div>

        }



        <div class="vm-opr-main-card">

            <div class="vm-opr-table-panel" id="showreport">

                <div class="vm-opr-table-panel__head">

                    <div class="vm-opr-table-panel__title">

                        <i class="fas fa-tags" aria-hidden="true"></i>

                        <span>R-Offer transaction log</span>

                    </div>

                    <span class="vm-opr-table-panel__hint">Scroll horizontally on mobile</span>

                </div>

                <div class="vm-opr-table-wrap">

                    <div class="table-responsive vm-opr-table-scroll">

                        <table id="example" class="table table-bordered table-striped table-hover vm-opr-data-table vm-roffer-data-table">

                            <thead>

                                <tr>

                                    <th>User Details</th>

                                    <th>Customer No</th>

                                    <th>R-Amount</th>

                                    <th>Operator</th>

                                    <th>Roffer</th>

                                    <th>User (%)</th>

                                    <th>User Pre ?</th>

                                    <th>Share</th>

                                    <th>User Post ?</th>

                                    <th>Recharge Time</th>

                                </tr>

                            </thead>

                            <tbody id="trow">

                                @if (rofferRows.Any())

                                {

                                    @Html.Partial("_Roffer_history", rofferRows)

                                }

                                else

                                {

                                    <tr class="vm-opr-table-empty-row">

                                        <td colspan="10" class="vm-opr-table-empty">

                                            <i class="fas fa-tags" aria-hidden="true"></i>

                                            <span>No R-Offer records for selected filters.</span>

                                        </td>

                                    </tr>

                                }

                            </tbody>

                        </table>

                        <div id="loadingdiv" class="vm-opr-table-loading" style="display:none;">

                            <div class="vm-roffer-loader">Loading�</div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>



<div class="modal fade saas-admin-modal vm-roffer-comm-modal" id="rofferCommModal" tabindex="-1" role="dialog" aria-hidden="true">

    <div class="modal-dialog" role="document">

        <div class="modal-content">

            <div class="modal-header saas-admin-modal-header accent-sky">

                <div class="saas-admin-modal-head-main">

                    <div class="saas-admin-modal-icon"><i class="fas fa-percent" aria-hidden="true"></i></div>

                    <div>

                        <h4 class="modal-title saas-admin-modal-title">Roffer Commission Details</h4>

                        <p class="saas-admin-modal-sub">Operator-wise base commission</p>

                    </div>

                </div>

                <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>

            </div>

            <div class="modal-body saas-admin-modal-body" id="tblList">

                @Html.Partial("_Roffer_comm_table", Model ?? Enumerable.Empty<roffer_retailer_comm_Result>())

            </div>

        </div>

    </div>

</div>



<script>
    window.vmRofferUrls = {
        excel: '@Url.Action("Excel_Roffer_history", "Home")',
        pdf: '@Url.Action("PDF_Roffer_history", "Home")',
        offersts: '@Url.Action("offersts", "Home")',
        updateComm: '@Url.Action("Update_Roffer_comm", "Home")'
    };
</script>
<script src="~/MainFrontDesign/js/admin-operator-report-nav.js"></script>
<script src="~/MainFrontDesign/js/admin-roffer-report.js?v=1"></script>

