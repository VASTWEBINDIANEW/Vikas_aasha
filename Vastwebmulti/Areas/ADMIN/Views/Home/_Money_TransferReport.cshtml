@model List<Vastwebmulti.Models.money_transfer_report_paging_Result>
@{
    Layout = null;
}
@if (Model != null && Model.Count > 0)
{
    var srIndex = ViewBag.SrOffset != null ? Convert.ToInt32(ViewBag.SrOffset) : 0;
    foreach (var item in Model)
    {
        srIndex++;
        var i = item.idno;
        var idno = "subTbl";
        idno = idno + i;

        var idno1 = "subTbl1";
        idno1 = idno1 + i;

        var idshow = "subTblshow";
        idshow = idshow + i;

        var idhide = "subTblhide";
        idhide = idhide + i;

        var idshowEdit = "subTblshowEdit";
        idshowEdit = idshowEdit + i;

        var idhideEdit = "subTblhideEdit";
        idhideEdit = idhideEdit + i;


        var color = "";
        var clr = "";
        var fontweight = "";
        var text = "";
        var emailid = "";
        var Retailername = "";
        var framname = "";
        var mobile = "";
        var rolename = "";
        var icon = "";
        var rchtype = "";
        var rchtypeicon = "";
        var sts = "";
        var refundcolor = "";
        var dmtytpe = "";
        var pendingColor = "";

        if (item.Roles == "Retailer")
        {
            emailid = item.email;
            Retailername = item.retailername;
            mobile = item.Mobile;
            framname = item.frm_name;
            rolename = "Retailer";

        }
        if (item.Roles == "Whitelabelretailer")
        {
            emailid = item.email;
            Retailername = item.retailername;
            framname = item.frm_name;
            mobile = item.Mobile;
            rolename = "Whitelabel";

        }
        if (item.Roles == "API")
        {
            emailid = item.email;
            Retailername = item.retailername;
            mobile = item.Mobile;
            framname = item.frm_name;
            rolename = "API USER";

        }

        if (item.status.Contains("Success To Failed"))
        {
            clr = "red";
            sts = "Success To Failed";
            fontweight = "700";
            icon = Url.Content("~/ashok-images/closes.svg");

        }

        if (item.status.Contains("Failed To Success"))
        {
            clr = "green";
            sts = "Failed To Success";
            item.status.Substring(17);
            fontweight = "700";
            icon = Url.Content("~/ashok-images/correct.svg");

        }
        if (item.status.Contains("SUCCESS"))
        {
            clr = "green";
            fontweight = "700";
            sts = item.status;
            icon = Url.Content("~/ashok-images/correct.svg");

        }
        if (item.status.Contains("REFUND AGAINST"))
        {
            clr = "#070a1bde";
            fontweight = "700";
            sts = "REFUND";
            refundcolor = "#070a1bde";
            icon = Url.Content("~/ashok-images/backresnd.svg");
        }
        if (item.status.Contains("Pending"))
        {
            double difftime = DateTime.Now.Subtract(item.trans_time.Value).TotalMinutes;
            if (difftime < 2)
            {
                pendingColor = "#ffbf00";
            }
            else
            {
                pendingColor = "#fff8d1";
            }
            color = "#ff9600";
            fontweight = "700";
            sts = item.status;

        }
        if (item.status.Contains("FAILED"))
        {
            clr = "red";
            fontweight = "700";
            sts = item.status;
            icon = Url.Content("~/ashok-images/closes.svg");
        }
        if (item.status.Contains("Resend"))
        {
            clr = "#2196F3";
            fontweight = "700";
            sts = item.status;
            icon = Url.Content("~/ashok-images/clkk.png");
        }

        var statusTone = "pending";
        var statusFa = "fa-clock-o";
        var stsUp = sts.ToUpper();
        if (stsUp.Contains("SUCCESS TO FAILED") || (stsUp.Contains("FAILED") && !stsUp.Contains("FAILED TO SUCCESS")))
        {
            statusTone = "failed";
            statusFa = "fa-times";
        }
        else if (stsUp.Contains("SUCCESS") || stsUp.Contains("FAILED TO SUCCESS"))
        {
            statusTone = "success";
            statusFa = "fa-check";
        }
        else if (stsUp.Contains("REFUND"))
        {
            statusTone = "refund";
            statusFa = "fa-undo";
        }
        else if (stsUp.Contains("RESEND"))
        {
            statusTone = "resend";
            statusFa = "fa-repeat";
        }
        if (item.trans_from == "ONLINE")
        {
            rchtype = "WEB";
            rchtypeicon = "fa fa-dribbble";
        }
        if (item.trans_from == "API")
        {
            rchtype = "WEB";
            rchtypeicon = "fa fa-dribbble";
        }
        if (item.trans_from.StartsWith("App"))
        {
            rchtype = "APP";
            rchtypeicon = "fa fa-android";
        }
        if (item.DmtType == "DMT1")
        {
            dmtytpe = "?";
        }
        if (item.DmtType == "DMT2")
        {
            dmtytpe = "?";
        }
        <tr class="vm-dmt-row vm-dmt-row--@statusTone" style="background-color:@pendingColor">

            <td class="vm-dmt-sr-cell">
                @if (sts.ToUpper() == "PENDING")
                {
                    if (item.DmtType == "DMT2" && item.status.ToUpper().Contains("PENDING") && (item.Trans_type == "IMPS" || item.Trans_type == "NEFT"))
                    {
                        <button type="button" class="vm-dmt-status-btn vm-dmt-status-btn--pending view" onclick="GotoView('@item.idno')" title="View Status (@srIndex)" data-toggle="tooltip" data-placement="bottom">
                            <span class="vm-dmt-sr-num">@srIndex</span>
                        </button>
                    }
                    else if (item.DmtType == "DMT1" && item.status.ToUpper().Contains("PENDING") && (item.Trans_type == "IMPS" || item.Trans_type == "NEFT"))
                    {
                        <button type="button" class="vm-dmt-status-btn vm-dmt-status-btn--pending view" onclick="GotoViewDMT1('@item.idno')" title="View Status (@srIndex)" data-toggle="tooltip" data-placement="bottom">
                            <span class="vm-dmt-sr-num">@srIndex</span>
                        </button>
                    }
                    else
                    {
                        <span class="vm-dmt-status vm-dmt-status--pending" title="@sts">
                            <span class="vm-dmt-sr-num">@srIndex</span>
                        </span>
                    }
                }
                else
                {
                    <span class="vm-dmt-status vm-dmt-status--@statusTone" title="@sts">
                        <span class="vm-dmt-sr-num">@srIndex</span>
                    </span>
                }
            </td>
            <td class="vm-dmt-user-cell">
                <div class="vm-dmt-user-stack">
                    <span class="vm-dmt-user-role">@rolename</span>
                    <span class="vm-dmt-user-name">@framname</span>
                </div>
            </td>
            <td class="vm-dmt-api-cell"><span class="vm-dmt-api-badge">@item.api_name</span></td>
          
            <td class="vm-dmt-mode-cell">
                <div class="vm-dmt-mode-top">
                    <i class="@rchtypeicon" aria-hidden="true"></i>
                    <span class="vm-dmt-mode-type">@rchtype</span>
                </div>
                <div class="vm-dmt-mode-label">
                    @if (item.Trans_type == "IMPS")
                    {
                        if (item.status == "Pending" || item.status == "FAILED" || item.status == "SUCCESS" || item.response_output == "Manual SUCCESS")
                        {
                            <span>IMPS/</span>
                        }
                    }
                    else if (item.Trans_type == "NEFT")
                    {
                        if (item.status == "Pending" || item.status == "FAILED" || item.status == "SUCCESS" || item.response_output == "Manual SUCCESS")
                        {
                            <span>NEFT/</span>
                        }
                    }
                    else if (item.Trans_type == "WALLET")
                    {
                        if (item.status == "Pending" || item.status == "FAILED" || item.status == "SUCCESS" || item.response_output == "Manual SUCCESS")
                        {
                            <span>WALLET/</span>
                        }
                    }
                    else if (item.Trans_type == "UPI")
                    {
                        if (item.status == "Pending" || item.status == "FAILED" || item.status == "SUCCESS" || item.response_output == "Manual SUCCESS")
                        {
                            <span>UPI</span>
                        }
                    }
                    else if (item.Trans_type == "Credit Card")
                    {
                        if (item.status == "Pending" || item.status == "FAILED" || item.status == "SUCCESS" || item.response_output == "Manual SUCCESS")
                        {
                            <span>Credit Card</span>
                        }
                    }
                    else
                    {
                        if (item.status == "Pending" || item.status == "FAILED" || item.status == "SUCCESS" || item.response_output == "Manual SUCCESS")
                        {
                            <span>Verify/</span>
                        }
                    }
                    @if (item.DmtType == "DMT2" && item.Trans_type == "EKYC CHARGE")
                    {
                        <span>PAYOUT E-KYC</span>
                    }
                    else if (item.DmtType == "DMTN" && item.Trans_type == "EKYC CHARGE")
                    {
                        <span>DMT E-KYC</span>
                    }
                    else if (item.DmtType == "DMT2" && item.Trans_type == "EKYC PPI CHARGE")
                    {
                        <span>PPI E-KYC</span>
                    }
                    else if (item.DmtType == "DMTN")
                    {
                        <span>DMT</span>
                    }
                    else if ((item.DmtType == "DMT2" && (item.Trans_type.ToUpper() == "IMPS" || item.Trans_type.ToUpper() == "NEFT")) || (item.Trans_type == "VASTWEB"))
                    {
                        <span>PAYOUT</span>
                    }
                    else if (item.DmtType == "DMTPPI")
                    {
                        <span>PPI</span>
                    }
                </div>
                <input type="text" class="vm-dmt-req-id" value="@item.trans_id" readonly />
            </td>
                <td>
                    <p>&nbsp;@item.senderno&nbsp;</p>
                </td>
                <td>
                    <p>@item.accountno</p>
                </td>
                <td>
                    <p>@item.amount</p>
                </td>
                @{
                    decimal debit1 = 0;
                    decimal amount1 = 0;
                    decimal usercomm = 0;
                    if (item.Roles == "Retailer")
                    {
                        if (item.Trans_type.Contains("IMPS_VERIFY"))
                        {
                            debit1 = Convert.ToDecimal(item.rem_comm);
                        }
                        else
                        {
                            amount1 = Convert.ToDecimal(item.amount);
                            usercomm = Convert.ToDecimal(item.rem_comm);
                            debit1 = amount1 + usercomm;
                        }
                    }
                    if (item.Roles == "API")
                    {
                        if (item.Trans_type.Contains("IMPS_VERIFY"))
                        {
                            debit1 = Convert.ToDecimal(item.rem_comm);
                        }
                        else
                        {
                            amount1 = Convert.ToDecimal(item.amount);
                            usercomm = Convert.ToDecimal(item.rem_comm);
                            debit1 = amount1 + usercomm;
                        }
                    }
                    if (item.Roles == "Whitelabelretailer")
                    {
                        if (item.Trans_type.Contains("IMPS_VERIFY"))
                        {
                            debit1 = Convert.ToDecimal(item.whitelabel_comm);
                        }
                        else
                        {
                            amount1 = Convert.ToDecimal(item.amount);
                            usercomm = Convert.ToDecimal(item.whitelabel_comm);
                            debit1 = amount1 + usercomm;
                        }
                    }
                }
                <td><p>@item.user_remain_pre</p></td>
                <td> <p>@debit1</p></td>
                <td><p>@item.user_remain</p></td>
                <td><p>@item.Api_remain_post</p></td>
                <td><p>@String.Format("{0:dd-MMM HH:mm:ss}", item.trans_time)&nbsp;&nbsp;<span></span></p></td>
                @{
                    var idncr = "nrch";
                    var chkkkk = idncr + item.idno;
                    var chkkkk1 = "nrchsuccess" + item.idno;
                    var resendBtnId = "rrr" + item.idno;
                    var rowStatus = (item.status ?? "").ToUpper();
                    var isManual = item.uniqueid != null && item.uniqueid.StartsWith("MANUAL");
                    var dmtTypeVal = string.IsNullOrWhiteSpace(item.DmtType) ? "DMT2" : item.DmtType.Trim();
                    var transTypeUpper = (item.Trans_type ?? "").ToUpper().Trim();
                    var canResendPending = rowStatus.Contains("PENDING")
                        && !isManual
                        && transTypeUpper != "IMPS_VERIFY"
                        && !transTypeUpper.Contains("EKYC");
                }
                <td class="vm-dmt-utr-cell">
                    @if (rowStatus.Contains("REFUND AGAINST") == false || rowStatus.Contains("RESEND"))
                    {
                        <p class="vm-dmt-utr-text" id="@idshowEdit">@item.bank_trans_id</p>
                        <span class="pen">
                            <button type="button" class="edit vm-dmt-utr-edit-btn" id="@idno" onclick="Edit_OPT(@i)" title="Edit UTR">
                                <i class="fa fa-pencil" aria-hidden="true"></i>
                            </button>
                        </span>
                        <div class="vm-dmt-utr-edit mmks input-container" id="@idhideEdit" style="display:none;">
                            <input type="text" id="@idno1" name="optid" class="input-field vm-dmt-utr-input" required value="@item.bank_trans_id">
                            <button type="button" class="input-button vm-dmt-utr-save-btn" onclick="UpdateOptId(@item.idno)" title="Save UTR">
                                <i class="fa fa-check" aria-hidden="true"></i>
                            </button>
                        </div>
                    }
                </td>
                <td class="vm-dmt-action-cell">
                    <div class="nrch vm-dmt-action-bar" id="@chkkkk">
                        @if (rowStatus.Contains("PENDING"))
                        {
                            <button type="button" class="ss vm-dmt-act-btn vm-dmt-act-btn--success" title="Mark success" onclick="openSuccessModal('@item.trans_id','@item.bank_trans_id','@item.recivername','@item.status')">
                                <i class="fa fa-check" aria-hidden="true"></i>
                            </button>
                            <button type="button" class="fftr vm-dmt-act-btn vm-dmt-act-btn--danger" title="Refund" data-toggle="modal" data-target="#defaultModal1" onclick="refundshow('@item.idno','@item.trans_id','@item.bank_trans_id','@item.recivername','@item.status')">
                                <i class="fa fa-times" aria-hidden="true"></i>
                            </button>
                            if (canResendPending)
                            {
                                <button type="button" id="@resendBtnId" class="ff vm-dmt-act-btn vm-dmt-act-btn--info" title="Resend" data-resend-id="@item.idno" data-dmt-type="@dmtTypeVal">
                                    <i class="fa fa-repeat" aria-hidden="true"></i>
                                </button>
                            }
                            <button type="button" class="fftt vm-dmt-act-btn vm-dmt-act-btn--detail" title="View details" data-toggle="modal" data-target="#defaultModal222" onclick="mdActionBtn('@item.idno')">
                                <i class="fa fa-angle-double-right" aria-hidden="true"></i>
                            </button>
                        }
                        @if ((rowStatus == "SUCCESS" || rowStatus.Contains("SUCCESS TO FAILED")) && !isManual)
                        {
                            <button type="button" class="ss vm-dmt-act-btn vm-dmt-act-btn--success" disabled title="Success">
                                <i class="fa fa-check" aria-hidden="true"></i>
                            </button>
                            <button type="button" class="fftr vm-dmt-act-btn vm-dmt-act-btn--danger" title="Refund" data-toggle="modal" data-target="#defaultModal1" onclick="refundshow('@item.idno','@item.trans_id','@item.bank_trans_id','@item.recivername','@item.status')">
                                <i class="fa fa-times" aria-hidden="true"></i>
                            </button>
                            <button type="button" class="fftt vm-dmt-act-btn vm-dmt-act-btn--detail" title="View details" data-toggle="modal" data-target="#defaultModal222" onclick="mdActionBtn('@item.idno')">
                                <i class="fa fa-angle-double-right" aria-hidden="true"></i>
                            </button>
                        }
                        @if ((rowStatus == "FAILED" || rowStatus.Contains("FAILED TO SUCCESS")) && !isManual)
                        {
                            <button type="button" class="ss vm-dmt-act-btn vm-dmt-act-btn--success" title="Mark success" onclick="openSuccessModal('@item.trans_id','@item.bank_trans_id','@item.recivername','@item.status')">
                                <i class="fa fa-check" aria-hidden="true"></i>
                            </button>
                            <button type="button" class="fftr vm-dmt-act-btn vm-dmt-act-btn--danger" disabled title="Refund unavailable">
                                <i class="fa fa-times" aria-hidden="true"></i>
                            </button>
                            <button type="button" class="fftt vm-dmt-act-btn vm-dmt-act-btn--detail" title="View details" data-toggle="modal" data-target="#defaultModal222" onclick="mdActionBtn('@item.idno')">
                                <i class="fa fa-angle-double-right" aria-hidden="true"></i>
                            </button>
                        }
                    </div>
                </td>
            </tr>
        }
    }
    else
    {
        <tr class="vm-opr-table-empty-row">
            @if (@ViewBag.checkdata != null)
            {
                <td colspan="14" class="vm-opr-table-empty vm-dmt-table-empty">
                    <i class="fa fa-search fas fa-search" aria-hidden="true"></i>
                    <span>No transactions found for current search.</span>
                </td>
            }
            else
            {
                <td colspan="14" class="vm-opr-table-empty vm-dmt-table-empty">
                    <i class="fa fa-exchange fas fa-exchange-alt" aria-hidden="true"></i>
                    <span>Transaction not found.</span>
                </td>
            }
        </tr>

    }