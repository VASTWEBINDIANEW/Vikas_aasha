@model Vastwebmulti.Areas.ADMIN.Models.CommonstatusMaster_dlm_list
@using System.Linq
@{
    ViewBag.Title = "Commission Hold Status";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var statusRows = Model?.Common_status_master_dlmlist ?? Enumerable.Empty<Vastwebmulti.Areas.ADMIN.Models.Common_status_master_dlm_cls>();
    var reportRows = Model?.Common_status_master_dlm_Transferlist ?? Enumerable.Empty<Vastwebmulti.Areas.ADMIN.Models.Common_status_master_dlm_Transfer_cls>();
    var statusCount = statusRows.Count();
    var reportCount = reportRows.Count();
    var showReportOnLoad = reportCount > 0 && statusCount == 0;
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=44" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=29" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-commission-status-modern.css?v=8" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-prepaid-card-report-page saas-commission-status-page">

    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

            <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line vm-gift-toolbar-one-line">

                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>Basic Setting</li>
                    <li>Commission Hold Status</li>
                </ol>

                <div class="saas-acc-filter-bar vm-commission-filter-bar">

                    <div class="vm-commission-filter-bar__search">
                        <div class="vm-commission-search-field">
                            <i class="fas fa-search" aria-hidden="true"></i>
                            <input class="form-control vm-commission-search-input" type="text" value="" id="myInput" placeholder="Search..." name="myInput" autocomplete="off" />
                        </div>
                    </div>

                    <div class="vm-commission-filter-bar__right">
                        <div class="vm-opr-field vm-dmt-field vm-commission-field--role">
                            <select class="vm-opr-select vm-dmt-select form-control" id="ddlusers" name="ddlusers">
                                <option value="master">Master Distributor</option>
                                <option value="dealer">Distributor</option>
                            </select>
                        </div>

                        <button type="button" class="vm-commission-view-toggle" id="btnshowhidmaster_dlmComm" value="Report">
                            @(showReportOnLoad ? "Show Status" : "Show Report")
                        </button>

                        <div class="vm-commission-filter-bar__actions sa-export-group vm-commission-export-group">
                            <button type="button" id="btnExport" class="sa-export-btn sa-export-btn--excel" title="Export Excel">
                                <i class="fa fa-file-excel-o" aria-hidden="true"></i><span>Excel</span>
                            </button>
                            <button type="button" id="btnPDF" class="sa-export-btn sa-export-btn--pdf" title="Export PDF">
                                <i class="fa fa-file-pdf-o" aria-hidden="true"></i><span>PDF</span>
                            </button>
                        </div>
                    </div>

                </div>

            </div>

        </div>

        <div class="vm-opr-main-card vm-security-report-main-card vm-gift-report-main-card vm-prepaid-report-main-card vm-commission-status-main-card">
            <div class="vm-opr-table-panel vm-security-report-table-panel vm-gift-report-table-panel vm-prepaid-report-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head vm-security-report-table-head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-hand-holding-usd" aria-hidden="true"></i>
                        <span id="commissionPanelTitle">@(showReportOnLoad ? "Commission transfer report" : "Commission hold status")</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-commission-mode-badge" id="commissionModeBadge">
                            <i class="fas fa-layer-group" aria-hidden="true"></i>
                            <span id="commissionModeText">@(showReportOnLoad ? "Report view" : "Status view")</span>
                        </span>
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong id="commissionRecordCount">@(showReportOnLoad ? reportCount : statusCount)</strong>
                        </span>
                    </div>
                </div>

                <div class="vm-opr-table-wrap vm-prepaid-table-wrap vm-commission-table-wrap">
                    <div class="vm-commission-scroll-hint" aria-hidden="true">
                        <i class="fas fa-arrows-alt-h" aria-hidden="true"></i>
                        <span>Swipe left/right to see all columns</span>
                    </div>
                    <div id="commissionStatusLoading" class="vm-commission-table-loading" style="display:none;" aria-hidden="true">
                        <i class="fas fa-spinner fa-spin" aria-hidden="true"></i>
                        <span>Loading...</span>
                    </div>

                    <div id="tblshowMasterD" class="table-responsive vm-opr-table-scroll" style="@(showReportOnLoad ? "display:none;" : "")">
                        <table id="commissionStatusTable" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Role</th>
                                    <th>Name</th>
                                    <th>Firm</th>
                                    <th>Commission Hold</th>
                                    <th>Last Update Time</th>
                                </tr>
                            </thead>
                            <tbody id="body">
                                @if (statusRows.Any())
                                {
                                    foreach (var item in statusRows)
                                    {
                                        <tr class="tr">
                                            <td>@item.Role</td>
                                            <td>@item.Name</td>
                                            <td>@item.Frmname</td>
                                            <td class="vm-commission-hold-cell">
                                                @if (item.Comm_Status == "Y")
                                                {
                                                    <button type="button" class="vm-commission-hold-btn costom-on clscall" id="btnsts_@item.idno" value="ON" onclick="changestats('@item.idno', '@item.Role','N')">ON</button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="vm-commission-hold-btn custom-off clscall" id="btnsts_@item.idno" value="OFF" onclick="changestats('@item.idno', '@item.Role','Y')">OFF</button>
                                                }
                                            </td>
                                            <td>@item.updatetime</td>
                                        </tr>
                                    }
                                }
                                else if (!showReportOnLoad)
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="5" class="vm-opr-table-empty vm-dmt-table-empty">
                                            <i class="fas fa-hand-holding-usd" aria-hidden="true"></i>
                                            <span>No commission hold records found.</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div id="tblshowmaster_dlm_comm_reports" class="table-responsive vm-opr-table-scroll" style="@(showReportOnLoad ? "" : "display:none;")">
                        <table id="commissionReportTable" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Role</th>
                                    <th>Name</th>
                                    <th>Firm</th>
                                    <th>Mobile</th>
                                    <th>Pre Balance</th>
                                    <th>Total Comm. Received</th>
                                    <th>Post Balance</th>
                                    <th>Admin Pre Bal</th>
                                    <th>Admin Post Bal</th>
                                    <th>Hold Comm Date</th>
                                    <th>Hold Comm Transfer Date</th>
                                </tr>
                            </thead>
                            <tbody id="bodyss">
                                @if (reportRows.Any())
                                {
                                    foreach (var item in reportRows)
                                    {
                                        <tr class="tr">
                                            <td>@item.Role</td>
                                            <td>@item.Name</td>
                                            <td>@item.Frmname</td>
                                            <td>@item.mobile</td>
                                            <td>@item.master_remain_pre</td>
                                            <td>@item.totalcomm</td>
                                            <td>@item.master_remain</td>
                                            <td>@item.admin_prebal</td>
                                            <td>@item.admin_postbal</td>
                                            <td>@item.Hold_date</td>
                                            <td>@item.trasnferdate</td>
                                        </tr>
                                    }
                                }
                                else if (showReportOnLoad)
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="11" class="vm-opr-table-empty vm-dmt-table-empty">
                                            <i class="fas fa-file-invoice-dollar" aria-hidden="true"></i>
                                            <span>No commission transfer records found.</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<script src="~/MainFrontDesign/js/admin-report-pdf-export.js?v=3"></script>
<script src="~/MainFrontDesign/js/admin-report-excel-export.js?v=4"></script>

<script>
    var btnshowhidmastertext = '@(showReportOnLoad ? "ShowStatus" : "Report")';

    function showCommissionLoading() {
        $('#commissionStatusLoading').show().attr('aria-hidden', 'false');
    }

    function hideCommissionLoading() {
        $('#commissionStatusLoading').hide().attr('aria-hidden', 'true');
    }

    function getVisibleCommissionRowsSelector() {
        return $('#tblshowMasterD').is(':visible') ? '#body .tr:not(.vm-opr-table-empty-row)' : '#bodyss .tr:not(.vm-opr-table-empty-row)';
    }

    function refreshCommissionSummary() {
        var $rows = $(getVisibleCommissionRowsSelector()).filter(':visible');
        $('#commissionRecordCount').text($rows.length);
    }

    function updateCommissionViewLabels(isReportView) {
        if (isReportView) {
            $('#commissionPanelTitle').text('Commission transfer report');
            $('#commissionModeText').text('Report view');
        } else {
            $('#commissionPanelTitle').text('Commission hold status');
            $('#commissionModeText').text('Status view');
        }
    }

    function filterCommissionRows() {
        var value = ($('#myInput').val() || '').toLowerCase();
        var selector = $('#tblshowMasterD').is(':visible') ? '#body .tr' : '#bodyss .tr';
        $(selector).filter(function () {
            $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
        });
        refreshCommissionSummary();
    }

    function getCommissionExportTable() {
        var isReportView = $('#tblshowmaster_dlm_comm_reports').is(':visible');
        return document.getElementById(isReportView ? 'commissionReportTable' : 'commissionStatusTable');
    }

    function getCommissionExportMeta() {
        var isReportView = $('#tblshowmaster_dlm_comm_reports').is(':visible');
        var role = $('#ddlusers option:selected').text() || '—';

        return {
            isReportView: isReportView,
            title: isReportView ? 'Commission Transfer Report' : 'Commission Hold Status',
            subtitle: isReportView
                ? ('Commission transfer history for ' + role)
                : ('Commission hold ON/OFF status for ' + role),
            filePrefix: isReportView ? 'Commission_Transfer_Report' : 'Commission_Hold_Status',
            sheetName: isReportView ? 'Transfer Report' : 'Hold Status'
        };
    }

    function countCommissionExportRows(table) {
        if (!table) {
            return 0;
        }

        var rows = table.querySelectorAll('tbody tr');
        var count = 0;
        var i;

        for (i = 0; i < rows.length; i++) {
            if (rows[i].classList.contains('vm-opr-table-empty-row')) {
                continue;
            }
            count++;
        }

        return count;
    }

    function exportCommissionExcel() {
        var table = getCommissionExportTable();
        var meta = getCommissionExportMeta();
        var rowCount = countCommissionExportRows(table);

        if (!table || typeof window.openAdminModernReportExcel !== 'function') {
            return;
        }

        if (rowCount === 0) {
            alert('No data available to export.');
            return;
        }

        window.openAdminModernReportExcel({
            table: table,
            title: meta.title,
            subtitle: meta.subtitle,
            fromDate: '—',
            toDate: '—',
            recordCount: rowCount,
            filePrefix: meta.filePrefix,
            sheetName: meta.sheetName
        });
    }

    function exportCommissionPdf() {
        var table = getCommissionExportTable();
        var meta = getCommissionExportMeta();
        var rowCount = countCommissionExportRows(table);

        if (!table || typeof window.openAdminModernReportPdf !== 'function') {
            return;
        }

        if (rowCount === 0) {
            alert('No data available to export.');
            return;
        }

        window.openAdminModernReportPdf({
            table: table,
            title: meta.title,
            subtitle: meta.subtitle,
            fromDate: '—',
            toDate: '—',
            orientation: meta.isReportView ? 'landscape' : 'portrait',
            recordCount: rowCount,
            recordLabel: rowCount + ' record' + (rowCount === 1 ? '' : 's')
        });
    }

    function buildCommissionUrl(role, dataMode) {
        return '@Url.Action("Commsion_Status_master_dlm_userwise", "Home")?userwise=' + encodeURIComponent(role) + '&btntextvalue=' + encodeURIComponent(dataMode);
    }

    function onCommissionRoleChange() {
        var role = $('#ddlusers').val();
        if (!role) {
            return;
        }

        // Purane page jaisa: dropdown change par report table open hoti hai
        reloadCommissionReportTable(buildCommissionUrl(role, 'Report'));
        btnshowhidmastertext = 'ShowStatus';
        $('#btnshowhidmaster_dlmComm').text('Show Status');
    }

    function showCommissionStatusView(role) {
        reloadCommissionStatusTable(buildCommissionUrl(role, 'ShowStatus'));
        btnshowhidmastertext = 'Report';
        $('#btnshowhidmaster_dlmComm').text('Show Report');
    }

    function showCommissionReportView(role) {
        reloadCommissionReportTable(buildCommissionUrl(role, 'Report'));
        btnshowhidmastertext = 'ShowStatus';
        $('#btnshowhidmaster_dlmComm').text('Show Status');
    }

    function reloadCommissionStatusTable(url) {
        showCommissionLoading();
        $('#tblshowmaster_dlm_comm_reports').hide();
        $('#tblshowMasterD').load(url + ' #tblshowMasterD', function (response, status) {
            hideCommissionLoading();
            if (status === 'error') {
                alert('Unable to load commission hold status.');
                return;
            }
            $('#tblshowMasterD').show();
            updateCommissionViewLabels(false);
            $('#myInput').val('');
            filterCommissionRows();
            refreshCommissionSummary();
        });
    }

    function reloadCommissionReportTable(url) {
        showCommissionLoading();
        $('#tblshowMasterD').hide();
        $('#tblshowmaster_dlm_comm_reports').load(url + ' #tblshowmaster_dlm_comm_reports', function (response, status) {
            hideCommissionLoading();
            if (status === 'error') {
                alert('Unable to load commission report.');
                return;
            }
            $('#tblshowmaster_dlm_comm_reports').show();
            updateCommissionViewLabels(true);
            $('#myInput').val('');
            filterCommissionRows();
            refreshCommissionSummary();
        });
    }

    $('#btnshowhidmaster_dlmComm').click(function () {
        var role = $('#ddlusers').val();

        if (btnshowhidmastertext === 'ShowStatus') {
            showCommissionStatusView(role);
        } else {
            showCommissionReportView(role);
        }
    });

    function changestats(idno, role, csts) {
        showCommissionLoading();
        $.ajax({
            url: '@Url.Action("Commsion_Status_master_dlm_change", "Home")',
            type: 'GET',
            data: { idno: idno, userwise: role, sts: csts },
            success: function (result) {
                if (result === 'success') {
                    showCommissionStatusView(role);
                } else {
                    hideCommissionLoading();
                }
            },
            error: function () {
                hideCommissionLoading();
                alert('Unable to update commission hold status.');
            }
        });
    }

    $(document).ready(function () {
        $('#ddlusers').on('change', onCommissionRoleChange);
        refreshCommissionSummary();

        $('#myInput').on('keyup', filterCommissionRows);

        $('#btnExport').on('click', exportCommissionExcel);
        $('#btnPDF').on('click', exportCommissionPdf);
    });
</script>
