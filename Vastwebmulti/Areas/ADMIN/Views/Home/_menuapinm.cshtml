<script>
    (function initApiSettingNav() {
        if (!window.jQuery) {
            setTimeout(initApiSettingNav, 50);
            return;
        }
        jQuery(function ($) {
            var current = (location.pathname || '').toLowerCase();
            $('#api-setting-nav .vm-fin-nav__link').each(function () {
                var href = ($(this).attr('href') || '').toLowerCase();
                if (href && current.indexOf(href.split('?')[0]) !== -1) {
                    $(this).addClass('is-active');
                }
            });
        });
    })();
</script>
