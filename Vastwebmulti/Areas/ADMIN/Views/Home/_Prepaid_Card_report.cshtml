@model IEnumerable<Vastwebmulti.Models.prepaid_card_Transaction>
@using System.Linq
@{
    Layout = null;
    var items = Model ?? Enumerable.Empty<Vastwebmulti.Models.prepaid_card_Transaction>();
}
@if (items.Any())
{
    foreach (var item in items)
    {
        var status = item.Status ?? "";
        var statusLower = status.ToLowerInvariant();
        var rowClass = "";
        var icon = "";
        var iconBg = "";

        if (statusLower.Contains("success"))
        {
            rowClass = "vm-gift-row--success";
            icon = "../../ashok-images/correct.svg";
            iconBg = "green";
        }
        else if (statusLower.Contains("failed"))
        {
            rowClass = "vm-gift-row--failed";
            icon = "../../ashok-images/closes.svg";
            iconBg = "red";
        }
        else if (statusLower.Contains("pending"))
        {
            rowClass = "vm-gift-row--pending";
            icon = "../../ashok-images/clkk.png";
            iconBg = "#FF9800";
        }

        var amount = item.Amount ?? 0m;

        <tr class="@rowClass" data-status="@status" data-amount="@amount.ToString(System.Globalization.CultureInfo.InvariantCulture)">
            <td class="vm-gift-status-cell">
                @if (!string.IsNullOrEmpty(icon))
                {
                    <img src="@icon" alt="" style="background-color:@iconBg" />
                }
                <span>@status</span>
            </td>
            <td><span class="vm-gift-info-line">@item.Name&nbsp;?&nbsp;@item.Email</span></td>
            <td>@(item.Quantity.HasValue ? item.Quantity.Value.ToString() : "—")</td>
            <td>@amount.ToString("N2")</td>
            <td>@(item.Request_time.HasValue ? item.Request_time.Value.ToString("dd-MMM-yy HH:mm:ss") : "—")</td>
            <td>@(item.Response_time.HasValue ? item.Response_time.Value.ToString("dd-MMM-yy HH:mm:ss") : "—")</td>
            <td>@(item.Rem_comm.HasValue ? item.Rem_comm.Value.ToString("N2") : "—")</td>
            <td>@(item.rem_gst.HasValue ? item.rem_gst.Value.ToString("N2") : "—")</td>
            <td>@(item.rem_tds.HasValue ? item.rem_tds.Value.ToString("N2") : "—")</td>
            <td>@(item.Rem_remain_pre.HasValue ? item.Rem_remain_pre.Value.ToString("N2") : "—")</td>
            <td>@(item.dlm_remain_post.HasValue ? item.dlm_remain_post.Value.ToString("N2") : "—")</td>
            <td>@(item.rem_final.HasValue ? item.rem_final.Value.ToString("N2") : "—")</td>
        </tr>
    }
}
else
{
    <tr class="vm-opr-table-empty-row">
        <td colspan="12" class="vm-opr-table-empty vm-dmt-table-empty">
            <i class="fas fa-credit-card" aria-hidden="true"></i>
            <span>Prepaid card report not found.</span>
        </td>
    </tr>
}
