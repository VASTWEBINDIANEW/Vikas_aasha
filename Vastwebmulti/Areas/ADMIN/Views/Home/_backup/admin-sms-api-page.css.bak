/* SMS API modals live outside .SMSAPI_Page section — scope by .sa-api-modal */
body.saas-admin-ui .sa-api-modal.saas-admin-modal .saas-admin-modal-dialog {
    max-width: 480px !important;
    width: calc(100% - 24px) !important;
    margin: 1.75rem auto !important;
}

body.saas-admin-ui #defaultModal.modal {
    overflow-x: hidden !important;
    overflow-y: auto !important;
}

body.saas-admin-ui #defaultModal .modal-content,
body.saas-admin-ui #defaultModal .modal-body {
    overflow: visible !important;
}

body.saas-admin-ui .sa-api-modal .sa-modal-field {
    margin-bottom: 12px !important;
}

body.saas-admin-ui .sa-api-modal .sa-modal-field label {
    display: flex !important;
    align-items: center !important;
    gap: 6px !important;
    margin-bottom: 5px !important;
    font-size: 0.72rem !important;
    font-weight: 700 !important;
    color: #475569 !important;
}

body.saas-admin-ui .sa-api-modal .sa-modal-field label i {
    color: #2563eb !important;
    width: 14px;
    text-align: center;
}

body.saas-admin-ui .sa-api-modal .saas-admin-modal-body .form-control,
body.saas-admin-ui .sa-api-modal .saas-admin-modal-body select {
    height: 38px !important;
    border: 1.5px solid #e2e8f0 !important;
    border-radius: 10px !important;
    font-size: 0.8rem !important;
    background: #fff !important;
    box-shadow: none !important;
}

body.saas-admin-ui .sa-api-modal .saas-admin-modal-btn.enableOnInput:disabled,
body.saas-admin-ui .sa-api-modal #start_SMSAPI:disabled,
body.saas-admin-ui .sa-api-modal #start_button2:disabled {
    background: #e2e8f0 !important;
    color: #94a3b8 !important;
    border-color: #e2e8f0 !important;
    box-shadow: none !important;
    cursor: not-allowed !important;
    opacity: 1 !important;
}

body.saas-admin-ui .sa-api-modal .saas-admin-modal-btn--success:not(:disabled) {
    background: linear-gradient(135deg, #047857, #10b981) !important;
    color: #fff !important;
    border: none !important;
}

body.saas-admin-ui .sa-api-modal .saas-admin-modal-btn--success:not(:disabled):hover {
    background: linear-gradient(135deg, #065f46, #059669) !important;
    color: #fff !important;
}

/* Modal API Type select — select2 inside Bootstrap modal */
body.saas-admin-ui #defaultModal .sa-modal-select,
body.saas-admin-ui #defaultModal select#sms_type {
    height: 38px !important;
    border: 1.5px solid #e2e8f0 !important;
    border-radius: 10px !important;
    font-size: 0.8rem !important;
    background: #fff !important;
    color: #334155 !important;
    padding: 4px 10px !important;
    width: 100% !important;
    cursor: pointer !important;
    appearance: auto !important;
    -webkit-appearance: menulist !important;
}

body.saas-admin-ui #defaultModal .select2-container {
    width: 100% !important;
    z-index: 1060 !important;
}

body.saas-admin-ui #defaultModal .select2-container--default .select2-selection--single {
    height: 38px !important;
    border: 1.5px solid #e2e8f0 !important;
    border-radius: 10px !important;
    background: #fff !important;
    display: flex !important;
    align-items: center !important;
}

body.saas-admin-ui #defaultModal .select2-container--default .select2-selection--single .select2-selection__rendered {
    line-height: 36px !important;
    padding-left: 10px !important;
    color: #334155 !important;
    font-size: 0.8rem !important;
}

body.saas-admin-ui #defaultModal .select2-container--default .select2-selection--single .select2-selection__arrow {
    height: 36px !important;
    right: 8px !important;
}

body.saas-admin-ui #defaultModal .select2-container--default.select2-container--open .select2-selection--single {
    border-color: #2563eb !important;
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15) !important;
}

body.saas-admin-ui #defaultModal .select2-dropdown {
    border: 1.5px solid #e2e8f0 !important;
    border-radius: 10px !important;
    box-shadow: 0 12px 28px rgba(15, 23, 42, 0.14) !important;
    z-index: 10650 !important;
    overflow: hidden !important;
}

body.saas-admin-ui #defaultModal .select2-results__option {
    padding: 8px 12px !important;
    font-size: 0.8rem !important;
}

body.saas-admin-ui #defaultModal .select2-results__option--highlighted[aria-selected] {
    background: #2563eb !important;
    color: #fff !important;
}
