body.saas-admin-ui .SMSAPI_Page .page-header-third.four-noneclass-admin-only {
    display: none !important;
}

body.saas-admin-ui .SMSAPI_Page .loadermoney {
    position: fixed;
    inset: 0;
    z-index: 199999;
    background: rgba(248, 250, 252, 0.88) url('../../img/loder.gif') 50% 50% no-repeat;
}

body.saas-admin-ui .SMSAPI_Page .vm-ft-page-toolbar--premium {
