    padding: 0;
    list-style: none;
    font-size: 0.74rem;
    color: #64748b;
}

body.saas-admin-ui .SMSAPI_Page .vm-ft-breadcrumb a {
    color: #2563eb;
    text-decoration: none;
    font-weight: 600;
}

body.saas-admin-ui .SMSAPI_Page .vm-ft-breadcrumb li:not(:last-child)::after {
    content: "/";
