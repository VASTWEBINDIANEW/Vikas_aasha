/* Loader animation for template save */
@keyframes sa-sms-loader-ripple {
    0% { top: 96px; left: 96px; width: 0; height: 0; opacity: 1; }
    100% { top: 18px; left: 18px; width: 156px; height: 156px; opacity: 0; }
}

body.saas-admin-ui .SMSAPI_Page .ldio-zdyd6mf6t5 div {
    position: absolute;
    border-width: 4px;
    border-style: solid;
    opacity: 1;
    border-radius: 50%;
    animation: sa-sms-loader-ripple 1s cubic-bezier(0, 0.2, 0.8, 1) infinite;
    box-sizing: content-box;
}

body.saas-admin-ui .SMSAPI_Page .ldio-zdyd6mf6t5 div:nth-child(1) { border-color: #e90c59; }
body.saas-admin-ui .SMSAPI_Page .ldio-zdyd6mf6t5 div:nth-child(2) {
    border-color: #46dff0;
    animation-delay: -0.5s;
}

body.saas-admin-ui .SMSAPI_Page .loadingio-spinner-ripple-92ar2pfqk5j {
    width: 200px;
    height: 200px;
    display: inline-block;
    overflow: hidden;
    background: transparent;
}

body.saas-admin-ui .SMSAPI_Page .ldio-zdyd6mf6t5 {
    width: 100%;
    height: 100%;
    position: relative;
    transform: translateZ(0) scale(1);
    backface-visibility: hidden;
    transform-origin: 0 0;
}

