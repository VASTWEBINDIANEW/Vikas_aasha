<script>

    $('#btnSendSms').click(function () {
        var URL = "";
        var res = $('input[name=group1]:checked').val();
        if (res == 'value1') {
         $.ajax({
            url: '@Url.Action("Send_API_SMS")',
            type: 'POST',
            data: { Userform1: $('#Userform1').val(), txtmobileNo: $('#txtmobileNo').val(), txtMsgBody: $('#txtMsgBody').val() },
            success: function (response) {

                $('#tableapismshistory').html(response);
                $('#txtmobileNo').val('');
                $('#txtMsgBody').val('');
                saShowMainPanel();
                saSwitchRightTab('tab-1');
                }
        })

        }
        else if (res == 'value2') {
              $.ajax({
            url: '@Url.Action("sim_sms")',
              type: 'POST',
              data: { Userform3: $('#Userform1').val(), Lapuno: $('#Lapuno').val(), txtmobilesim: $('#txtmobileNo').val(), txtsim: $('#txtMsgBody').val() },
            success: function (response) {

                $('#SIMSMSHISTORYtable').html(response);
                $('#txtmobileNo').val('');
                $('#txtMsgBody').val('');
                saShowMainPanel();
                saSwitchRightTab('tab-2');
                }
        })
        }
    })

    $('#btnaa').click(function () {
        $.ajax({
            url: '@Url.Action("_APISMSHISTORY","Home")',
            type: 'POST',
            data: {
                txtmsg: $('#tab-1 .API_SMS').val(),
                txt_frm_date: $('#tab-1 .txt_frm_date').first().val(),
                txt_to_date: $('#tab-1 .txt_to_date').first().val()
            },
            success: function (response) {
                $('#tableapismshistory').html(response);
            }
        });
    });

    $('#btnsimhistory').click(function () {
        $.ajax({
            url: '@Url.Action("_SIMSMSHISTORY","Home")',
            type: 'POST',
            data: {
                txtmsg: $('#tab-2 .SIM_His').val(),
                txt_frm_date: $('#tab-2 .txt_frm_date').first().val(),
                txt_to_date: $('#tab-2 .txt_to_date').first().val()
            },
            success: function (response) {
                $('#SIMSMSHISTORYtable').html(response);
            }
        });
    });


    function Search_API_His_ByTest() {

        var value = $('.API_SMS').val();


        var patt = new RegExp(value, "i");



        $('#APISMSHISTORY').find('tr').each(function () {

            if (!($(this).find('td').text().search(patt) >= 0)) {

                $(this).not('.first-tr').hide();

            }

            if (($(this).find('td').text().search(patt) >= 0)) {

                $(this).show();

            }

        });

    };
function Search_SIM_His_ByTest() {
        var value = $('.SIM_His').val();


        var patt = new RegExp(value, "i");



        $('#SIMSMSHISTORY').find('tr').each(function () {

            if (!($(this).find('td').text().search(patt) >= 0)) {

                $(this).not('.first-tr').hide();

            }

            if (($(this).find('td').text().search(patt) >= 0)) {

                $(this).show();

            }

        });

    };


 $("input[type='radio']").change(function(){

if($(this).val()=="value2")
{
    $("#prtno").show();
}
else
{
       $("#prtno").hide();
}

});

</script>
