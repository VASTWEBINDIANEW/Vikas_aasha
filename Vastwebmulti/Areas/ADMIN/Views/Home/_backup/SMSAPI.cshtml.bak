<script>
    $(window).on('load', function () {
        if ($.fn.datepicker) {
            $('.txt_frm_date, .txt_to_date').datepicker({
                format: "yyyy-mm-dd",
                todayHighlight: true,
                autoclose: true,
                orientation: "bottom auto"
            });
            var val = '@ViewBag.chk';
            if (val != "post") {
                $(".txt_frm_date").datepicker("setDate", new Date());
                $(".txt_to_date").datepicker("setDate", new Date());
            }
        }
    });
</script>
<script type="text/javascript">
    function saShowMainPanel() {
        $('#right_tab1').removeClass('is-hidden').addClass('is-visible');
        $('#right_tab2').removeClass('is-visible').addClass('is-hidden');
        $('.SMSAPI_Page').removeClass('sa-template-view');
        $('#searchSms').hide();
    }

    function saShowTemplatePanel() {
        $('#right_tab1').removeClass('is-visible').addClass('is-hidden');
        $('#right_tab2').removeClass('is-hidden').addClass('is-visible');
        $('.SMSAPI_Page').addClass('sa-template-view');
        $('#searchSms').show();
    }

    function saSwitchRightTab(tabId) {
        $('.SMSAPI_Page .smsapi-second .sa-sms-right-tabs > li.tab-link').removeClass('current');
        $('.SMSAPI_Page .smsapi-second .sa-right-tab-body > .tab-content').removeClass('current');
        $('.SMSAPI_Page .smsapi-second .sa-sms-right-tabs > li.tab-link[data-tab="' + tabId + '"]').addClass('current');
        var $panel = $('.SMSAPI_Page .smsapi-second .sa-right-tab-body > #' + tabId);
        $panel.addClass('current');
        if (tabId === 'tab-4') {
            $('.SMSAPI_Page .sa-right-toolbar__action').addClass('is-visible');
        } else {
            $('.SMSAPI_Page .sa-right-toolbar__action').removeClass('is-visible');
        }
    }

    function saSwitchLeftTab(tabId) {
        $('.head-sms .sa-sms-left-tabs li.tab-link2').removeClass('current2');
        $('.smsapi-first .sams-next > .tab-content2').removeClass('current2');
        $('.head-sms .sa-sms-left-tabs li.tab-link2[data-tab="' + tabId + '"]').addClass('current2');
        $('.smsapi-first .sams-next > #' + tabId).addClass('current2');

        if (tabId === 'tab-7') {
            saShowTemplatePanel();
        } else {
            saShowMainPanel();
        }
    }

    function saReloadApiSettings(response) {
        var $parsed = $('<div>').html(response);
        var inner = $parsed.find('.sa-api-settings-table-wrap').length
            ? $parsed.html()
            : ($parsed.find('#ApiSettings').length
                ? $parsed.find('#ApiSettings').html()
                : ($parsed.find('#tab-4').length ? $parsed.find('#tab-4').html() : response));
        $('#ApiSettings').html(inner);
        saShowMainPanel();
        saSwitchRightTab('tab-4');
    }

    $(document).ready(function () {
        saShowMainPanel();
        saSwitchRightTab('tab-1');

        $('.head-sms .sa-sms-left-tabs li.tab-link2').on('click', function (e) {
            e.preventDefault();
            e.stopImmediatePropagation();
            saSwitchLeftTab($(this).attr('data-tab'));
        });

        $('.SMSAPI_Page .smsapi-second .sa-sms-right-tabs > li.tab-link').on('click', function (e) {
            e.preventDefault();
            e.stopImmediatePropagation();
            saSwitchRightTab($(this).attr('data-tab'));
        });
    })
</script>
<script>
    $(document).ready(function () {
