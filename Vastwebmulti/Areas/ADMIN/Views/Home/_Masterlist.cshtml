@model Vastwebmulti.Areas.ADMIN.Models.MasterDistributerModel

<style type="text/css">
    .mastetr222Modal .modal-dialog {
        margin: 0px;
    }

    @@keyframes ldio-zdyd6mf6t5 {
        0% {
            top: 96px;
            left: 96px;
            width: 0;
            height: 0;
            opacity: 1;
        }

        100% {
            top: 18px;
            left: 18px;
            width: 156px;
            height: 156px;
            opacity: 0;
        }
    }

    #userinfodiv.vm-ml-validating input:placeholder-shown {
        border-color: #fca5a5 !important;
    }

    .ldio-zdyd6mf6t5 div {
        position: absolute;
        border-width: 4px;
        border-style: solid;
        opacity: 1;
        border-radius: 50%;
        animation: ldio-zdyd6mf6t5 1s cubic-bezier(0,0.2,0.8,1) infinite;
    }

        .ldio-zdyd6mf6t5 div:nth-child(1) {
            border-color: var(--main-bg-lcolor);
        }

        .ldio-zdyd6mf6t5 div:nth-child(2) {
            border-color: #c7c7c7;
            animation-delay: -0.5s;
        }

    .loadingio-spinner-ripple-92ar2pfqk5j {
        width: 200px;
        height: 200px;
        display: inline-block;
        overflow: hidden;
        background: #ffffff;
    }

    .ldio-zdyd6mf6t5 {
        width: 100%;
        height: 100%;
        position: relative;
        transform: translateZ(0) scale(1);
        backface-visibility: hidden;
        transform-origin: 0 0;
    }

        .ldio-zdyd6mf6t5 div {
            box-sizing: content-box;
        }

    .table-bordered tbody tr td, .table-bordered tbody tr th {
        padding: 10px;
    }
</style>



<div class="table-responsive vm-ml-table-scroll saas-acc-table-wrap">
    <table class="table table-bordered saas-acc-table vm-ml-data-table third-design-table" id="mdList">
        <thead>
            <tr>
                <th>Sr</th>
                <th>Master&nbsp;Distributor&nbsp;Firm</th>
                <th>Master&nbsp;Distributor&nbsp;Name</th>
                <th>Mobile&nbsp;No</th>
                <th>PAN&nbsp;No</th>
                <th>M/D&nbsp;Bal</th>
                <th>KYC</th>
                <th style="width:90px;">E-Verify</th>

            </tr>
        </thead>
        <tbody id="body">
            @if (Model._Select_super_total_Result != null)
            {
                int i = 0;
                int id = 1;
                foreach (var item in Model._Select_super_total_Result)
                {
                    var idno = "subTbl";
                    idno = idno + i;

                    var idshow = "subTblshow";
                    idshow = idshow + i;

                    var idhide = "subTblhide";
                    idhide = idhide + i;

                    <tr class="tr vm-ml-parent-row">

                        <td>@id</td>
                        <td>

                            <span id="@idshow" class="vm-ml-expand-toggle" onclick="md_dlm_List('@item.SSId', '@i')">
                                <i class="fa fa-caret-down vm-ml-expand-icon" aria-hidden="true"></i>
                                <span class="vm-ml-firm-name">@item.FarmName</span>
                            </span>

                            <span id="@idhide" class="vm-ml-expand-toggle vm-ml-expand-toggle--open" style="display:none;" onclick="md_dlm_Listhide('@i')">
                                <i class="fa fa-caret-up vm-ml-expand-icon" aria-hidden="true"></i>
                                <span class="vm-ml-firm-name">@item.FarmName</span>
                            </span>

                        </td>
                        <td>@item.SuperstokistName</td>
                        <td>@item.Mobile</td>
                        <td> @item.pancard</td>
                        <td>@item.superremain</td>
                        <td class="kyc-button">
                            @if (item.PSAStatus == "Y" && item.AadhaarStatus == "Y")
                            {
                                <span class="vm-ml-status-badge vm-ml-status-badge--done">Done</span>
                            }
                            else
                            {
                                <span class="vm-ml-status-badge vm-ml-status-badge--due">Due</span>
                            }
                        </td>
                        <td class="vm-ml-ev-cell" onclick="mdActionBtn('@item.SSId',this); return false;">
                            <div class="vm-ml-ev-cell__inner">
                                @if (item.EmailConfirmed == true)
                                {
                                    <span class="vm-ml-status-badge vm-ml-status-badge--done">Done</span>
                                }
                                else
                                {
                                    <span class="vm-ml-status-badge vm-ml-status-badge--due">Due</span>
                                }
                                <i class="fas fa-chevron-right vm-ml-ev-arrow" aria-hidden="true"></i>
                            </div>
                        </td>

                    </tr>

                    <tr id="@i" class="vm-ml-sub-row" style="display:none;">
                        <td colspan="8" class="vm-ml-sub-row-cell">
                            <div id="@idno">
                                @Html.Partial("_SelectDlmID")
                            </div>
                        </td>
                    </tr>

                    i++;
                    id++;
                }

            }
        </tbody>
    </table>
</div>


