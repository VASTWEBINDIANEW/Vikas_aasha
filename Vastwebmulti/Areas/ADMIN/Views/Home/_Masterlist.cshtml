<script>
    function OnSuccess(data) {
        vmMlCloseDetailModal();
    }

    function vmMlGetSelect2Parent() {
        return ravi('#defaultModal222');
    }

    function vmMlDestroyEditSelects() {
        ravi('#defaultModal222 .vm-ml-edit-select').each(function () {
            var $el = ravi(this);
            if ($el.hasClass('select2-hidden-accessible')) {
                $el.select2('destroy');
            }
        });
    }

    function vmMlInitEditSelects() {
        var $parent = vmMlGetSelect2Parent();
        if (!$parent.length) {
            return;
        }
        ravi('#defaultModal222 .vm-ml-edit-select').each(function () {
            var $el = ravi(this);
            if ($el.hasClass('select2-hidden-accessible')) {
                $el.select2('destroy');
            }
            $el.select2({
                width: '100%',
                dropdownParent: $parent,
                minimumResultsForSearch: 0
            });
        });
        ravi('#StateEdit').off('change.vmMlState').on('change.vmMlState', function () {
            vmMlLoadDistricts(ravi(this).val(), null);
        });
    }

    function vmMlSetSelectValue(selector, value) {
        var $el = ravi(selector);
        if (!$el.length) {
            return;
        }
        $el.val(value != null ? String(value) : '');
        if ($el.hasClass('select2-hidden-accessible')) {
            $el.trigger('change.select2');
        } else {
            $el.trigger('change');
        }
    }

    function vmMlLoadDistricts(stateId, selectedDistrict) {
        var $dist = ravi('#DistrictEdit');
        if (!$dist.length) {
            return;
        }
        $dist.html("<option value=''>Please wait...</option>");
        vmMlSetSelectValue('#DistrictEdit', '');
        ravi.ajax({
            url: '@Url.Action("DistrictList","Home")',
            data: { Id: stateId },
            cache: false,
            type: 'POST',
            success: function (data3) {
                $dist.empty();
                $dist.append(ravi('<option></option>').val('').text('Select district'));
                for (var x = 0; x < data3.length; x++) {
                    $dist.append(ravi('<option></option>').val(data3[x].Value).html(data3[x].Text));
                }
                if (selectedDistrict != null && selectedDistrict !== '') {
                    vmMlSetSelectValue('#DistrictEdit', selectedDistrict);
                } else {
                    vmMlSetSelectValue('#DistrictEdit', '');
                }
            }
        });
    }

    $(document).ajaxComplete(function () {
        if (ravi('#defaultModal222').is(':visible')) {
            vmMlInitEditSelects();
        }
    });
</script>
