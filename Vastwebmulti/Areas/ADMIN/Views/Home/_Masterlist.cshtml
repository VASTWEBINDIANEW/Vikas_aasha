<script>
    function mdActionBtn(SSId, values) {
        vmMlResetDetailModalForms();
        $('.mastetr222Modal .vm-ml-modal-alert--error #error').text("");
        $('#alinks').html('');
        $('#loadredmodel').show();
        vmMlEnsureDetailModal().modal({ backdrop: true, keyboard: true, show: true });

        $.ajax({
            url: '@Url.Action("MasterIdSearch","Home")',
            type: "POST",
            data: { ssid: SSId },
            cache: false,
            success: function (data2) {
                if (!data2 || !data2.list || !data2.list.length) {
                    $('#loadredmodel').hide();
                    $('#userinfodiv').css('visibility', 'visible');
                    $('.mastetr222Modal .vm-ml-modal-alert--error #error').text('Record not found.');
                    return;
                }
                var row = data2.list[0];
                $('.mastetr222Modal .vm-ml-modal-alert--error #error').text("");
                var adharRaw = row.adharcard || '';
                var CCNValue = adharRaw;
                if (adharRaw.length >= 8) {
                    CCNValue = adharRaw.substring(0, 8).replace(/\d/g, "X") + adharRaw.substring(8);
                }
                var createddate = '';
                if (row.JoinDate) {
                    var joinDateVal = row.JoinDate;
                    if (typeof joinDateVal === 'string' && joinDateVal.indexOf('/Date(') >= 0) {
                        createddate = converttoDate(new Date(parseInt(joinDateVal.match(/\d+/)[0], 10)));
                    } else {
                        createddate = converttoDate(new Date(joinDateVal));
                    }
                }
                $("#ssid").val(row.SSId);
                $("#ssiddelete").val(row.SSId);
                $("#ssidshow").val(row.SSId);
                $("#Name").text(row.SuperstokistName);
                $("#NameEdit").val(row.SuperstokistName);
                $("#FirmName").text(row.FarmName);
                $("#FirmEdit").val(row.FarmName);
                $("#RegisteredDate").text(createddate);
                $("#Email11").val(row.Email);
                $("#Pancard11").val(row.pancard);
                $("#pancardEdit").val(row.pancard);
                $("#Aadhar11").val(CCNValue);
                $("#AadhaarEdit").val(row.adharcard);
                $("#GSTRegistrationNo11").val(row.gst);
                $("#gstEdit").val(row.gst);
                $('#Edittxtlrole').hide();
                ravi("#DivEditddlrole").show();

               // $('#Editddlrole').val(data2.list[0].RolesType);
                
                $("#pincode11").val(data2.list[0].Pincode);
                $("#PinEdit").val(data2.list[0].Pincode);
                $("#Capping").text(data2.list[0].caption);
                $("#CappingEdit").val(data2.list[0].caption);
                $("#masterremain").html(data2.list[0].superremain);
                $("#dealerremain").val(data2.list[0].dealer_remain);

                $("#offmargine").html(data2.list[0].mastercomminper);
                $("#offmargineEdit").val(data2.list[0].mastercomminper);

                $("#retailerremain").val(data2.list[0].retailer_remain);
                $("#State11").val(data2.list[0].State_name);
                $("#District11").val(data2.list[0].Dist_Desc);
                $("#address11").val(data2.list[0].Address);
                $("#AddressEdit").val(data2.list[0].Address);
                $("#StateEdit").val(data2.list[0].state);
                var pancarddoc = data2.list[0].pancardPath;
                var aadhardoc = data2.list[0].aadharcardpath;
                 var aadhardocback = data2.list[0].BackSideAadharcardphoto;
                var gstdoc = data2.list[0].frimregistrationPath;
                var frmagmnt=data2.list[0].Agreementpath;
                if (pancarddoc == null) {
                    $("#pandocnotshow").show();
                    $("#pandocshow").hide();
                }
                else {
                    $("#pandocnotshow").hide();
                    $("#pandocshow").show();
                    $('#panimageshow').attr('src', "../.." + pancarddoc);
                }
                 if (aadhardoc == null || aadhardocback==null) {
                    $("#aadhardocnotshow").show();
                    $("#aadhardocshow").hide();
                }
                else {
                    $("#aadhardocnotshow").hide();
                    $("#aadhardocshow").show();
                     $('#aadharimageshow').attr('src', "../.." + aadhardoc);
                         $('#aadharimagebackshow').attr('src', "../.." + aadhardocback);
                }
                  if (gstdoc == null) {
                    $("#gstdocnotshow").show();
                    $("#gstdocshow").hide();
                }
                else {
                    $("#gstdocnotshow").hide();
                    $("#gstdocshow").show();
                    $('#gstimageshow').attr('src', "../.." + gstdoc);
                }


                if (data2.list[0].PSAStatus == "Y") {
                    $('#panapproved').hide();

                }
                else {
                     $('#panapproved').show();
                }
                  if (data2.list[0].AadhaarStatus == "Y") {
                        $('#aadharapproved').hide();
                    }
                else {

                    $('#aadharapproved').show();
                }
                if (data2.list[0].gststatus == "Y") {
                    $('#gstapproved').hide();

                }
                else {
                     $('#gstapproved').show();
                }

                if (data2.list[0].PSAStatus == "Y" && data2.list[0].AadhaarStatus == "Y") {
