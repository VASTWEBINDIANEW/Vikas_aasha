@model Vastwebmulti.Areas.ADMIN.Models.MasterDistributerModel

<div class="saas-mo-service-grid">
    @if (Model.Formservice == null || Model.Formservice.Count == 0)
    {
        <p class="saas-mo-empty-msg">No services added yet. Use the form above to add one.</p>
    }
    else
    {
        foreach (var item in Model.Formservice)
        {
            <article class="saas-mo-service-card">
                <div class="saas-mo-service-card-media">
                    <img src="data:image/png;base64,@item.images" alt="@item.servicename" />
                </div>
                <p class="saas-mo-service-card-name">@item.servicename</p>
                <div class="saas-mo-service-card-actions">
                    <button type="button" onclick="formEditmode1('@item.idno')" class="btn saas-mo-service-btn saas-mo-service-btn-edit" title="Edit">
                        <i class="fa fa-pencil" aria-hidden="true"></i> Edit
                    </button>
                    <button type="button" onclick="setItemId('@item.idno')" class="btn saas-mo-service-btn saas-mo-service-btn-add" data-target="#myModal55" title="Add field">
                        <i class="fa fa-plus" aria-hidden="true"></i> Add
                    </button>
                </div>
            </article>
        }
    }
</div>
