@model Vastwebmulti.Areas.ADMIN.ViewModel.SwitchUserModel

@if (Model.ShowSwitch_DealerTOMD != null)
{
    var dealerList = Model.ShowSwitch_DealerTOMD.ToList();
    <div class="table-responsive vm-ml-table-scroll saas-acc-table-wrap">
        <table id="tbldata"
               data-hrefscroll="@Url.Action("InfiniteScrollSwitchuser","Home",new { Utype="dealer"})"
               class="table table-bordered saas-acc-table vm-ml-data-table third-design-table">
            <thead>
                <tr>
                    <th>SR</th>
                    <th>Distributor&nbsp;Firm</th>
                    <th>Name</th>
                    <th>Old&nbsp;M/D</th>
                    <th>Current&nbsp;M/D</th>
                    <th>Switch&nbsp;Date</th>
                </tr>
            </thead>
            <tbody>
                @if (dealerList.Any())
                {
                    int sr = 1;
                    foreach (var item in dealerList)
                    {
                        <tr class="tr">
                            <td>@sr</td>
                            <td>@item.FarmName</td>
                            <td>@item.DealerName</td>
                            <td>@item.old</td>
                            <td>@item.curr</td>
                            <td>@item.SwitchDate</td>
                        </tr>
                        sr++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="text-align:center;padding:36px;color:#94a3b8;">
                            <i class="fas fa-exchange-alt" style="font-size:2rem;display:block;margin-bottom:8px;opacity:.35;"></i>
                            No distributor switch records found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (Model.ShowRetailerDealerSwitch_Result != null)
{
    var retailerList = Model.ShowRetailerDealerSwitch_Result.ToList();
    <div class="table-responsive vm-ml-table-scroll saas-acc-table-wrap">
        <table id="tbldata"
               data-hrefscroll="@Url.Action("InfiniteScrollSwitchuser","Home",new { Utype="Retailer"})"
               class="table table-bordered saas-acc-table vm-ml-data-table third-design-table">
            <thead>
                <tr>
                    <th>SR</th>
                    <th>Retailer&nbsp;Firm</th>
                    <th>Name</th>
                    <th>Old&nbsp;Distributor</th>
                    <th>Current&nbsp;Distributor</th>
                    <th>Switch&nbsp;Date</th>
                </tr>
            </thead>
            <tbody>
                @if (retailerList.Any())
                {
                    int sr = 1;
                    foreach (var item in retailerList)
                    {
                        <tr class="tr">
                            <td>@sr</td>
                            <td>@item.Frm_Name</td>
                            <td>@item.RetailerName</td>
                            <td>@item.old</td>
                            <td>@item.curr</td>
                            <td>@item.SwitchDate</td>
                        </tr>
                        sr++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" style="text-align:center;padding:36px;color:#94a3b8;">
                            <i class="fas fa-exchange-alt" style="font-size:2rem;display:block;margin-bottom:8px;opacity:.35;"></i>
                            No retailer switch records found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
