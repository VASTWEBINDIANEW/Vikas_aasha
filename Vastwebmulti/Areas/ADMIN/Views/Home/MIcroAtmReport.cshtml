<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-microatm-report-page">
    <div class="container-fluid vm-opr-page-shell">

        @using (Html.BeginForm("MIcroAtmReport", "Home", FormMethod.Post, new { id = "microAtmReportForm", @class = "vm-rpt-filters-panel__form" }))
