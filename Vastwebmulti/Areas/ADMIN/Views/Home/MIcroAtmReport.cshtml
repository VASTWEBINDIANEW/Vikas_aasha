<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />

<script>
    window.microAtmTotalsUrl = '@Url.Action("TotalALLCount", "Home")';

    function Pending() {
        var fromdate = $('#txt_frm_date').val();
        var todate = $('#txt_to_date').val();
        $('#searchnoneid').hide();
        $('.loaderpandingflight').show();
        $.ajax({
            url: '@Url.Action("ClearallMTM", "Home")',
            data: { fromdate: fromdate, todate: todate },
            complete: function () {
                $('#searchnoneid').show();
                $('.loaderpandingflight').hide();
            }
        });
    }

    function refundshow(idnn) {
        $('#txtrefidno').val(idnn);
        $('#txtref_rrn_display').val(idnn);
        $('#securitypass').val('');
        $('#defaultModal1').modal('show');
    }

    function Failed() {
        var secuirtypass = $('#securitypass').val();
        var id = $('#txtrefidno').val();
        if (secuirtypass) {
            $.ajax({
                url: '@Url.Action("microatmsuccesstofailed", "Home")',
                type: 'POST',
                dataType: 'html',
                data: { txtrefidno: id, secuirtypass: secuirtypass },
                success: function (data) {
                    var response = JSON.parse(data);
                    if (response.Status) {
                        window.location.reload();
                    } else {
                        alert(response.Message);
                    }
                },
                complete: function () {
                    $('#defaultModal1').modal('hide');
                }
            });
        }
    }

    function successMATM(reqid, amnt, transectiontype) {
        $('#hdtransectionid').val(reqid);
        $('#hdamount').val(amnt);
        $('#txtamountas').val(amnt);
        $('#ddlcardpaymenttype').val('');
        $('#ddlnetworktype').val('');
        $('#ddlcard_usage_type').val('');
        $('#ddltransectiontype').val(transectiontype);
        if (transectiontype === 'microatm' || transectiontype === 'purchase') {
            $('#divcpurchase').show();
        } else {
            $('#divcpurchase').hide();
        }
        $('#defaultModal11122').modal('show');
    }

    $('#ddltransectiontype').change(function () {
        var val = $('#ddltransectiontype').val();
        if (val === 'purchase' || val === 'microatm') {
            $('#divcpurchase').show();
        } else {
            $('#divcpurchase').hide();
        }
    });

    function SuccessMATMsssss() {
        if (!$('#hdtransectionid').val() || !$('#txtbnkrrn').val() || !$('#ddltransectiontype').val() || !$('#securitypass22').val() || !$('#ddlnetworktype').val() || !$('#hdamount').val() || !$('#ddlcard_usage_type').val()) {
            return;
        }
        $.ajax({
            url: '@Url.Action("microatmspendingTosuccess", "Home")',
            type: 'POST',
            dataType: 'html',
            data: {
                filed1: $('#hdtransectionid').val(),
                rrn: $('#txtbnkrrn').val(),
                transaction_type: $('#ddltransectiontype').val(),
                secuirtypass: $('#securitypass22').val(),
                created_at: $('#createddate').val(),
                network: $('#ddlnetworktype').val(),
                amount: $('#hdamount').val(),
                card_payment_type: $('#ddlcardpaymenttype').val(),
                card_usage_type: $('#ddlcard_usage_type').val()
            },
            success: function (data) {
                var response = JSON.parse(data);
                $('#hdtransectionid,#txtbnkrrn,#ddltransectiontype,#securitypass22,#ddlnetworktype,#hdamount,#ddlcardpaymenttype,#ddlcard_usage_type,#txtamountas').val('');
                $('#defaultModal11122').modal('hide');
                if (response.Status) {
                    window.location.reload();
                } else {
                    alert(response.Message);
                }
            }
        });
    }

    function FailedMTM(reqid, amnt) {
        if (confirm('Are you sure?')) {
            $.ajax({
                url: '@Url.Action("microatmspendingToFailed", "Home")',
                type: 'POST',
                data: { filed1: reqid, amount: amnt },
                success: function (data) {
                    var response = JSON.parse(JSON.stringify(data));
                    if (response.Status) {
                        window.location.reload();
                    } else {
                        alert(response.Message);
                    }
                }
            });
        }
    }

    function mdActionBtn(Idno) {
        $('#defaultModal222').modal('show');
        $('#loadredmodel').show();
        $.ajax({
            url: '@Url.Action("Microatm_View", "Home")',
            type: 'POST',
            data: { Idno: Idno },
            cache: false,
            success: function (Response) {
                $('#DealerPre').val(Response[0].dealer_remain_pre);
                $('#Dlm_Comm').val(Response[0].dealer_comm);
                $('#dlmgst').val(Response[0].dealer_gst);
                $('#dlmtds').val(Response[0].dealer_tds);
                $('#DealerPost').val(Response[0].dealer_remain_post);
                $('#MasterPre').val(Response[0].master_remain_pre);
                $('#Md_Comm').val(Response[0].master_comm);
                $('#Mdgst').val(Response[0].master_gst);
                $('#Mdtds').val(Response[0].master_tds);
                $('#MasterPost').val(Response[0].master_remain_post);
                $('#Response').val(Response[0].resp);
                $('#lblresponseid').text(Response[0].network);
            },
            complete: function () {
                $('#loadredmodel').hide();
            }
        });
    }

    function buildMicroAtmExportQuery() {
        return 'txt_frm_date=' + encodeURIComponent($('#txt_frm_date').val())
            + '&txt_to_date=' + encodeURIComponent($('#txt_to_date').val())
            + '&ddlusers=' + encodeURIComponent($('#ddlusers').val() || '')
            + '&ddl_status=' + encodeURIComponent($('#ddl_status').val() || '')
            + '&allmaster2=' + encodeURIComponent($('#allmaster2').val() || '')
            + '&alldealer=' + encodeURIComponent($('#alldealer').val() || '')
            + '&allretailer=' + encodeURIComponent($('#allretailer').val() || '')
            + '&allwhitelabel1=' + encodeURIComponent($('#allwhitelabel1').val() || '');
    }

    $('#btnExport').click(function () {
        location.href = '@Url.Action("MICROATMEXCELLGENERATE", "Home")?' + buildMicroAtmExportQuery();
    });

    $('#btnPDF').click(function () {
        window.open('@Url.Action("PDFMicroAtmReport", "Home")?' + buildMicroAtmExportQuery(), '_blank');
    });

    $(document).ready(function () {
        $('#txt_frm_date, #txt_to_date').datepicker({
            format: 'yyyy-mm-dd',
            todayHighlight: true,
            autoclose: true,
            orientation: 'bottom auto'
        });
        var val = '@ViewBag.chk';
        if (val != 'post') {
            $('#txt_frm_date').datepicker('setDate', new Date());
            $('#txt_to_date').datepicker('setDate', new Date());
        }
    });
</script>
