@model List<Vastwebmulti.Models.proc_BusReport_Result>
@using System.Web
@{
    Layout = null;
    var items = Model ?? new List<Vastwebmulti.Models.proc_BusReport_Result>();
}
@if (items.Count > 0)
{
    foreach (var item in items)
    {
        var statusTone = "pending";
        var statusFa = "fa-clock-o";
        var statusLabel = item.Status ?? "";

        if (item.Status != null && item.Status.ToUpper().Contains("FAILED"))
        {
            statusTone = "failed";
            statusFa = "fa-times";
        }
        else if (item.Status != null && item.Status.Contains("Success"))
        {
            statusTone = "success";
            statusFa = "fa-check";
        }
        else if (item.Status != null && item.Status.Contains("Refund"))
        {
            statusTone = "refund";
            statusFa = "fa-undo";
        }
        else if ((item.Status != null && item.Status.Contains("Pending")) || (item.TicketStatus != null && item.TicketStatus.Contains("Proccessed")))
        {
            statusTone = "pending";
            statusFa = "fa-clock-o";
        }

        <tr class="vm-dmt-row vm-dmt-row--@statusTone">
            <td class="vm-ticket-status-cell">
                <span class="vm-dmt-status vm-dmt-status--@statusTone" title="@statusLabel">
                    <i class="fa @statusFa" aria-hidden="true"></i>
                </span>
                <span class="vm-ticket-status-text">@item.TicketNo</span>
            </td>
            <td>@item.TicketStatus</td>
            <td>@item.Frm_Name</td>
            <td>@item.PassengerName</td>
            <td>@item.sourceStationName</td>
            <td>@item.destinationStationName</td>
            <td>@item.dateOfJourney.ToString("dddd, dd MMMM yyyy")</td>
            <td class="vm-dmt-amt-cell">@item.FareAmount</td>
            <td>@item.RemPre</td>
            <td>@item.RemInc</td>
            <td>@item.RemPost</td>
            <td>Earn</td>
            <td class="vm-ticket-pnr-cell">@item.PNR</td>
            <td class="vm-ticket-time-cell">@item.TicketDate</td>
            <td class="vm-dmt-action-cell">
                @if (item.Status == "Success" || item.Status == "Cancelled")
                {
                    <div class="nrch vm-dmt-action-bar">
                        <button type="button" class="vm-dmt-act-btn vm-dmt-act-btn--info" title="View booking details" onclick="BookingDetails('@item.TraceId')">
                            <i class="fa fa-eye" aria-hidden="true"></i>
                        </button>
                        <a href="@Url.Action("Bus_Print_Pdf", "Bus", new { area = "RETAILER", TraceId = item.TraceId })" target="_blank" class="vm-dmt-act-btn vm-dmt-act-btn--print" title="Print ticket">
                            <i class="fa fa-print" aria-hidden="true"></i>
                        </a>
                        <button type="button" class="vm-dmt-act-btn vm-dmt-act-btn--detail" title="View details"
                                data-req="@HttpUtility.HtmlAttributeEncode(item.RequestJson ?? "")"
                                data-res="@HttpUtility.HtmlAttributeEncode(item.ResponseJson ?? "")"
                                onclick="busActionBtn(this, '@item.RemPre','@item.RemInc','@item.RemPost','@item.DlmInc','@item.DlmPre','@item.DlmPost','@item.MdInc','@item.MdPre','@item.MdPost','@item.WlInc','@item.WlPre','@item.WlPost')">
                            <i class="fa fa-angle-double-right" aria-hidden="true"></i>
                        </button>
                    </div>
                }
            </td>
        </tr>
    }
}
else
{
    <tr class="vm-opr-table-empty-row">
        <td colspan="15" class="vm-opr-table-empty vm-dmt-table-empty">
            <i class="fas fa-bus" aria-hidden="true"></i>
            <span>Bus booking report not found.</span>
        </td>
    </tr>
}
