@model IEnumerable<Vastwebmulti.Models.PanAadharReportViewModel>
@using Vastwebmulti.Models
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "PAN & Aadhar Verification Charge Report";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var rows = Model != null ? Model.ToList() : new List<PanAadharReportViewModel>();
    var totalPan = rows.Sum(r => r.PanCharge);
    var totalAadhar = rows.Sum(r => r.AadharCharge);
    var panCount = rows.Count(r => r.PanCharge > 0);
    var aadharCount = rows.Count(r => r.AadharCharge > 0);
    var frmDate = (ViewBag.frmDate as string) ?? DateTime.Today.ToString("yyyy-MM-dd");
    var toDate = (ViewBag.toDate as string) ?? DateTime.Today.ToString("yyyy-MM-dd");
    var panExcelExportUrl = Url.Action("ExcelPANAadharVerificationReport", "Home");
    var panPdfExportUrl = Url.Action("pdfPANAadharVerificationReport", "Home");
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-settings-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-settings-page saas-admin-report-page saas-pan-report-page">
    <div class="container-fluid">

        
        @using (Html.BeginForm("PANAadharVerificationReport", "Home", FormMethod.Post, new { @class = "saas-pan-report-form saas-pan-toolbar-form", id = "panReportForm", data_date_mode = "set", data_frm_date = frmDate, data_to_date = toDate }))
        {
            <div class="saas-acc-toolbar saas-pan-toolbar-unified">
                <ol class="saas-acc-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>PAN &amp; Aadhar Verification Report</li>
                </ol>

                <div class="saas-acc-toolbar-right saas-pan-toolbar-dates">
                    <div class="saas-acc-report-date-controls saas-pan-date-controls">
                        <div class="saas-report-date-fields">
                            <div class="saas-acc-dp-field">
                                <label class="saas-acc-dp-label" for="txt_frm_date">From date</label>
                                <span class="saas-acc-dp-icon" title="From date"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "yyyy-mm-dd" })
                            </div>
                            <div class="saas-acc-dp-field">
                                <label class="saas-acc-dp-label" for="txt_to_date">To date</label>
                                <span class="saas-acc-dp-icon" title="To date"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "yyyy-mm-dd" })
                            </div>
                        </div>
                        <div class="saas-report-toolbar-actions">
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn">
                                <i class="fas fa-search" aria-hidden="true"></i> Search
                            </button>
                            <div class="saas-acc-export-group saas-pan-export-group">
                                <button type="button" class="saas-acc-btn saas-acc-btn--excel saas-pan-export-btn" id="panBtnExcel" title="Export Excel">
                                    <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                                </button>
                                <button type="button" class="saas-acc-btn saas-acc-btn--pdf saas-pan-export-btn" id="panBtnPdf" title="Export PDF">
                                    <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="saas-acc-table-card">
            <div class="saas-acc-table-card-head">
                <h3>Charge report</h3>
                <span class="saas-acc-row-count">
                    <i class="fas fa-receipt" aria-hidden="true"></i> @rows.Count entries
                    <span class="saas-pan-report-meta"> · @frmDate to @toDate</span>
                </span>
            </div>
            <div class="saas-acc-table-wrap table-responsive">
                <table class="table saas-acc-table table-bordered" id="panAadharReportTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Retailer</th>
                            <th>Firm name</th>
                            <th>Email</th>
                            <th>Mobile</th>
                            <th>Txn ID</th>
                            <th class="text-right">PAN charge</th>
                            <th class="text-right">Aadhar charge</th>
                            <th>Type</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (rows.Count == 0)
                        {
                            <tr>
                                <td colspan="10" class="saas-pan-empty-cell">No records found between @frmDate and @toDate.</td>
                            </tr>
                        }
                        else
                        {
                            var sr = 0;
                            foreach (var item in rows)
                            {
                                sr++;
                                var typeKey = (item.ChargeType ?? "").Trim().ToUpperInvariant();
                                <tr>
                                    <td data-label="#">@sr</td>
                                    <td data-label="Retailer">@(string.IsNullOrWhiteSpace(item.RetailerName) ? "—" : item.RetailerName)</td>
                                    <td data-label="Firm">@(string.IsNullOrWhiteSpace(item.Frm_Name) ? "—" : item.Frm_Name)</td>
                                    <td data-label="Email">@(string.IsNullOrWhiteSpace(item.Email) ? "—" : item.Email)</td>
                                    <td data-label="Mobile">@(string.IsNullOrWhiteSpace(item.Mobile) ? "—" : item.Mobile)</td>
                                    <td data-label="Txn ID" class="saas-pan-txn-id">@(string.IsNullOrWhiteSpace(item.TransactionId) ? "—" : item.TransactionId)</td>
                                    <td data-label="PAN charge" class="text-right saas-pan-amount">₹@item.PanCharge.ToString("N2")</td>
                                    <td data-label="Aadhar charge" class="text-right saas-pan-amount">₹@item.AadharCharge.ToString("N2")</td>
                                    <td data-label="Type">
                                        @if (typeKey.Contains("PAN") && typeKey.Contains("AADHAR"))
                                        {
                                            <span class="saas-set-badge-pending">Both</span>
                                        }
                                        else if (typeKey.Contains("PAN"))
                                        {
                                            <span class="saas-set-badge-done">PAN</span>
                                        }
                                        else if (typeKey.Contains("AADHAR") || typeKey.Contains("ADHAR"))
                                        {
                                            <span class="saas-set-badge-done">Aadhar</span>
                                        }
                                        else
                                        {
                                            <span class="saas-set-badge-pending">@(string.IsNullOrWhiteSpace(item.ChargeType) ? "—" : item.ChargeType)</span>
                                        }
                                    </td>
                                    <td data-label="Date">@(string.IsNullOrWhiteSpace(item.CreatedAt) ? "—" : item.CreatedAt)</td>
                                </tr>
                            }
                        }
                    </tbody>
                    @if (rows.Count > 0)
                    {
                        <tfoot>
                            <tr class="saas-pan-tfoot-row">
                                <td colspan="6" class="text-right"><strong>Total</strong></td>
                                <td class="text-right saas-pan-amount"><strong>₹@totalPan.ToString("N2")</strong></td>
                                <td class="text-right saas-pan-amount"><strong>₹@totalAadhar.ToString("N2")</strong></td>
                                <td colspan="2"></td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>

    </div>
</section>

<script>
    (function initPanReportExport() {
        function run() {
            if (!window.jQuery) {
                window.setTimeout(run, 40);
                return;
            }
            var excelBase = '@panExcelExportUrl';
            var pdfBase = '@panPdfExportUrl';

            function buildUrl(base) {
                var frm = encodeURIComponent(jQuery('#txt_frm_date').val() || '');
                var to = encodeURIComponent(jQuery('#txt_to_date').val() || '');
                return base + '?txt_frm_date=' + frm + '&txt_to_date=' + to;
            }

            jQuery(function ($) {
                $('#panBtnExcel').on('click', function () {
                    window.location.href = buildUrl(excelBase);
                });
                $('#panBtnPdf').on('click', function () {
                    window.open(buildUrl(pdfBase), '_blank');
                });
            });
        }
        run();
    })();
</script>
