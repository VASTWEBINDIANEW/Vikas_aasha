@model Vastwebmulti.Areas.ADMIN.Models.whatsappslab
@using (Ajax.BeginForm("_User_whatsapp_Slab", "Home", new AjaxOptions { HttpMethod = "POST", OnSuccess = "OnSuccess1", OnFailure = "onfailed", UpdateTargetId = "divEditFormComm", LoadingElementId = "div_Loader", InsertionMode = InsertionMode.Replace }))
{
    <input id="btnsubmituser" type="submit" name="Button" value="Update For Existing Users" class="btn waves-effect vm-pg-slab-save-btn" style="display:none;" />
    <input id="btnsubmitusercommon" type="submit" name="Button" value="Update Existing & New Users" class="btn waves-effect vm-pg-slab-save-btn" style="display:none;" />
    <input id="btnsubmitusercommondlmrem" type="submit" name="Button" value="Update Existing & New Users" class="btn waves-effect vm-pg-slab-save-btn" style="display:none;" />

    @Html.HiddenFor(m => m.role, new { id = "role" })
    <div class="row clearfix" style="margin-right:0px;">
        <div class="col-md-12">
            <div class="slab-master-block vm-prepaid-user-filter vm-prepaid-user-filter--inline">
                <div id="slab-master-message" class="slab-master-message slab-master-message-show" style="display: none;">
                    <p>If you edit the slabs of all the API users, you are given a data view of the common slabs.</p>
                </div>
                <div id="slab-master-detail" class="slab-master-detail slab-master-detail-hide vm-prepaid-user-filter__row" style="display: block;">
                    <div id="allshow" class="vm-prepaid-user-filter__item vm-prepaid-user-filter__item--select">
                        <div class="vm-pg-slab-field">
                            <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-users"></i></span>
                            @Html.DropDownList("ddlUserId", Model.UserId, "All Users", new { @class = "form-control for-select2", @onchange = "ddlUserIdChange()" })
                        </div>
                    </div>
                    <div class="vm-prepaid-user-filter__item">
                        <div class="vm-pg-slab-field">
                            <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-user"></i></span>
                            <input class="form-control" type="text" placeholder="User Name" value="@Model.Name" readonly="readonly" />
                        </div>
                    </div>
                    <div class="vm-prepaid-user-filter__item">
                        <div class="vm-pg-slab-field">
                            <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-phone-alt"></i></span>
                            <input class="form-control" type="text" placeholder="User Registered Number" value="@Model.Phone" readonly="readonly" />
                        </div>
                    </div>
                    <div class="vm-prepaid-user-filter__item">
                        <div class="vm-pg-slab-field">
                            <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-envelope"></i></span>
                            <input class="form-control" type="text" placeholder="User Registered Mail" value="@Model.Email" readonly="readonly" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="vm-pg-slab-table-scroll saas-acc-table-wrap vm-prepaid-slab-table-wrap">
        <table id="whatsappUserSlabTable" class="table table-bordered vm-pg-slab-table third-design-table slab-table">
            <thead>
                <tr>
                    <th>User&nbsp;ID</th>
                    <th>@Model.PP1&nbsp;Month</th>
                    <th>@Model.PP2&nbsp;Month</th>
                    <th>@Model.PP3&nbsp;Month</th>
                </tr>
            </thead>
            <tbody id="tbodyshow" class="vm-pg-slab-tbody--view">
                @if (Model.Apiuser != null)
                {
                    for (int i = 0; i < Model.Apiuser.Count; i++)
                    {
                        <tr>
                            <td>@Html.DisplayFor(a => a.Apiuser[i].Email)</td>
                            <td>@Html.DisplayFor(a => a.Apiuser[i].P1)</td>
                            <td>@Html.DisplayFor(a => a.Apiuser[i].P2)</td>
                            <td>@Html.DisplayFor(a => a.Apiuser[i].P3)</td>
                        </tr>
                    }
                }
            </tbody>
            <tbody id="tbodyedit" class="vm-pg-slab-tbody--hidden">
                @if (Model.Apiuser != null)
                {
                    for (int i = 0; i < Model.Apiuser.Count; i++)
                    {
                        <tr>
                            @Html.HiddenFor(a => a.Apiuser[i].RolesName)
                            @Html.HiddenFor(a => a.Apiuser[i].idno)
                            <td>@Html.DisplayFor(a => a.Apiuser[i].Email)</td>
                            <td class="vm-pg-slab-edit-cell">
                                @Html.EditorFor(a => a.Apiuser[i].P1, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input" } })
                                @Html.ValidationMessageFor(a => a.Apiuser[i].P1)
                            </td>
                            <td class="vm-pg-slab-edit-cell">
                                @Html.EditorFor(a => a.Apiuser[i].P2, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input" } })
                                @Html.ValidationMessageFor(a => a.Apiuser[i].P2)
                            </td>
                            <td class="vm-pg-slab-edit-cell">
                                @Html.EditorFor(a => a.Apiuser[i].P3, new { htmlAttributes = new { @class = "vm-pg-slab-cell-input" } })
                                @Html.ValidationMessageFor(a => a.Apiuser[i].P3)
                            </td>
                        </tr>
                    }
                }
            </tbody>
            <tbody id="tbodyeditAll" class="vm-pg-slab-tbody--hidden">
                @if (Model.Apiuser != null)
                {
                    for (int i = 0; i < Model.Update_whatsapp_api.Count; i++)
                    {
                        <tr>
                            @Html.HiddenFor(a => a.Update_whatsapp_api[i].idno)
                            <td><p>All</p></td>
                            <td class="vm-pg-slab-edit-cell">
                                @Html.TextBoxFor(a => a.Update_whatsapp_api[i].P1, new { @class = "vm-pg-slab-cell-input" })
                                @Html.ValidationMessageFor(a => a.Update_whatsapp_api[i].P1)
                            </td>
                            <td class="vm-pg-slab-edit-cell">
                                @Html.TextBoxFor(a => a.Update_whatsapp_api[i].P2, new { @class = "vm-pg-slab-cell-input" })
                                @Html.ValidationMessageFor(a => a.Update_whatsapp_api[i].P2)
                            </td>
                            <td class="vm-pg-slab-edit-cell">
                                @Html.TextBoxFor(a => a.Update_whatsapp_api[i].P3, new { @class = "vm-pg-slab-cell-input" })
                                @Html.ValidationMessageFor(a => a.Update_whatsapp_api[i].P3)
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
}
<script>
    function OnSuccess1(data) {
        $('#btnsubmituser, #btnsubmitusercommon, #btnsubmitusercommondlmrem').hide().removeClass('is-visible');
        $('#btnEdit').show().removeClass('is-hidden');
        if (typeof resetSlabViewMode === 'function') {
            resetSlabViewMode();
        }
    }
    function onfailed(error) {
        alert(error.responseText);
    }
</script>
