<div class="fund-transfer-form ap-schedule-form" id="frmschedule">

    @using (Ajax.BeginForm("_Scheduler_add", "Home", new AjaxOptions { HttpMethod = "POST", OnSuccess = "success2", OnFailure = "fail2", UpdateTargetId = "tab-9", OnBegin = "begin" }))

    {

        <div class="col-md-12 col-sm-12 col-xs-12">

            <label>API Name</label>

            <div>

                @Html.DropDownList("Apinm1", new SelectList(ViewBag.apinm1, "Value", "Text"), "Select Api Name", new { @class = "for-select2 vm-opr-select vm-dmt-select form-control", data_live_search = "true", @required = "required" })

            </div>

        </div>

        <div class="col-md-12 col-sm-12 col-xs-12">

            <label>Schedule Mode</label>

            <div>

                @Html.DropDownList("mode", new List<SelectListItem>

                {

                    new SelectListItem{Text="Timing Basis", Value="TIME"},

                    new SelectListItem{Text="Low Alert Basis", Value="LOWBAL"}

                }, "Select Mode", new { @class = "for-select2 vm-opr-select vm-dmt-select form-control", data_live_search = "true" })

            </div>

        </div>

        <div id="idminhours" class="col-md-12 col-sm-12 col-xs-12" style="display:none;">

            <label>Minimum Hours</label>

            <div>

                @Html.TextBox("minhours", "", new { @type = "number", @class = "form-control", placeholder = "Enter Minimum hours" })

            </div>

        </div>

        <div id="idminfund" class="col-md-12 col-sm-12 col-xs-12" style="display:none;">

            <label>Minimum Fund</label>

            <div>

                @Html.TextBox("minfund", "", new { @type = "number", @class = "form-control", placeholder = "Enter Minimum Fund" })

            </div>

        </div>

        <div id="idtime" class="col-md-12 col-sm-12 col-xs-12" style="display:none;">

            <label>Schedule Time</label>

            <div>

                @Html.TextBox("timerId", "", new { @class = "form-control", placeholder = "Enter Schedule Time" })

            </div>

        </div>

        <div id="idsfree" class="col-md-12 col-sm-12 col-xs-12" style="display:none;">

            <label>Schedule Frequency</label>

            <div>

                @Html.DropDownList("sfrequency", new List<SelectListItem>

                {

                    new SelectListItem{Text="Daily", Value="1"},

                    new SelectListItem{Text="2 Days Gap", Value="3"},

                    new SelectListItem{Text="1 Week", Value="7"},

                    new SelectListItem{Text="1 Month", Value="30"}

                }, "Select Schedule frequency", new { @class = "for-select2 vm-opr-select vm-dmt-select form-control", data_live_search = "true" })

            </div>

        </div>

        <div id="idsdaily" class="col-md-12 col-sm-12 col-xs-12" style="display:none;">

            <label>Daily Frequency</label>

            <div>

                @Html.DropDownList("SDaily", new List<SelectListItem>

                {

                    new SelectListItem{Text="One Time", Value="1"},

                    new SelectListItem{Text="Two Time", Value="2"},

                    new SelectListItem{Text="Three Time", Value="3"},

                    new SelectListItem{Text="Four Time", Value="4"}

                }, "Select frequency", new { @class = "for-select2 vm-opr-select vm-dmt-select form-control", data_live_search = "true" })

            </div>

        </div>

        <div class="col-md-12 col-sm-12 col-xs-12">

            <label>Amount</label>

            <div>

                @Html.TextBox("samount", "", new { @type = "number", @class = "form-control", placeholder = "Enter Amount", @required = true })

            </div>

        </div>

        <div class="col-md-12 col-sm-12 col-xs-12 ne-form-footer">

            <button id="resetallschdu" type="reset" class="ne-btn-reset">

                <i class="fas fa-times"></i> Reset

            </button>

            <button type="submit" class="ne-btn-submit">

                <i class="fas fa-check"></i> Submit

            </button>

        </div>

        <div class="col-md-12 col-sm-12 col-xs-12">

            <label id="schdulelable" class="ap-form-msg"></label>

        </div>

    }

</div>



<script>

    $("#mode").change(function () {

        var modeval = $('#mode').val();

        if (modeval == "TIME") {

            $('#idminhours, #idminfund').hide();

            $('#idtime, #idsfree').show();

            $('#idsdaily').hide();

        }

        else if (modeval == "LOWBAL") {

            $('#idminhours, #idminfund').show();

            $('#idtime, #idsfree, #idsdaily').hide();

        }

        else {

            $('#idminhours, #idminfund, #idtime, #idsfree, #idsdaily').hide();

        }

        if (typeof refreshAddPurchaseSelect2 === 'function') {

            refreshAddPurchaseSelect2();

        }

    });

    $("#sfrequency").change(function () {

        var sfre = $('#sfrequency').val();

        if (sfre == "1") {

            $('#idsdaily').show();

        }

        else {

            $('#idsdaily').hide();

        }

        if (typeof refreshAddPurchaseSelect2 === 'function') {

            refreshAddPurchaseSelect2();

        }

    });

</script>



<script>

    $(function () {

        $('#timerId').timepicker();

    });

</script>



<script>

    function begin() {

        $('#schdulelable').text("");

        var apinm = $('#Apinm1').val();

        var mode = $('#mode').val();

        var samount = $('#samount').val();

        var timerId = $('#timerId').val();

        var sfrequency = $('#sfrequency').val();

        var SDaily = $('#SDaily').val();

        var minhours = $('#minhours').val();

        var minfund = $('#minfund').val();



        if (apinm != "" && mode != "" && samount != "") {

            if (samount > 0) {

                if (mode == "TIME") {

                    if (timerId != "" && sfrequency != "") {

                        if (sfrequency == "1") {

                            if (SDaily != "") {

                                $('#schdulelable').text("");

                                return true;

                            }

                            $('#schdulelable').text("Fill All Required Value");

                            return false;

                        }

                        $('#schdulelable').text("");

                        return true;

                    }

                    $('#schdulelable').text("Fill All Required Value");

                    return false;

                }

                if (minhours != "" && minfund != "") {

                    if (minfund > 0 && minhours > 0) {

                        $('#schdulelable').text("");

                        return true;

                    }

                    $('#schdulelable').text("Fill All Required Value");

                    return false;

                }

                $('#schdulelable').text("Fill All Required Value");

                return false;

            }

            $('#schdulelable').text("Amount Should be Positive");

            return false;

        }

        $('#schdulelable').text("Fill All Required Value");

        return false;

    }

</script>

