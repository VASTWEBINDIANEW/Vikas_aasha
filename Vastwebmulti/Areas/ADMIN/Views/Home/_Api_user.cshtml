                                    <button type="button" class="wl-doc-btn wl-doc-btn--view" data-toggle="modal" data-target="#gstviewdoc"><i class="fas fa-eye"></i> View</button>
                                    <button type="button" class="wl-doc-btn wl-doc-btn--delete" onclick="Rejected('gst')"><i class="fas fa-trash-alt"></i> Reject</button>
                                    <div id="gstapproved"><button type="button" class="wl-doc-btn wl-doc-btn--approve" onclick="Approved('gst')"><i class="fas fa-check-circle"></i> Approve</button></div>
                                </div>
                                <div id="gstdocnotshow" style="display:none;"><span class="wl-notfound-badge"><i class="fas fa-exclamation-circle"></i> Doc Not Found</span></div>
                            </div>
                            <!-- Agreement -->
                            <div class="wl-doc-card">
                                <div class="wl-doc-card__head">
                                    <span class="wl-doc-card__icon wl-doc-card__icon--agr"><i class="fas fa-file-contract"></i></span>
                                    <span class="wl-doc-card__title">Farm Agreement</span>
                                </div>
                                <input type="text" id="frmagrEdit" name="frmagrEdit" readonly class="form-control" placeholder="Agreement Status" />
                                <span id="alinks"></span>
                                <div class="wl-doc-card__actions" id="frmagrdocshow">
                                    <button type="button" class="wl-doc-btn wl-doc-btn--view" data-toggle="modal" data-target="#frmagrviewdoc"><i class="fas fa-eye"></i> View</button>
                                    <button type="button" class="wl-doc-btn wl-doc-btn--delete" onclick="Rejected('Aggrement')"><i class="fas fa-trash-alt"></i> Reject</button>
                                    <div id="frmagrapproved"><button type="button" class="wl-doc-btn wl-doc-btn--approve" onclick="Approved('Aggrement')"><i class="fas fa-check-circle"></i> Approve</button></div>
                                </div>
                                <div id="frmagrdocnotshow" style="display:none;"><span class="wl-notfound-badge"><i class="fas fa-exclamation-circle"></i> Doc Not Found</span></div>
                            </div>
                        </div>

                        <!-- Edit form footer -->
                        <div class="wl-modal-footer">
                            <ul>
                                <li>
                                    <button type="button" class="wl-mf-btn wl-mf-btn--back js-au-back"><i class="fas fa-arrow-left"></i> Back</button>
                                </li>
                                <li>
                                    <label id="lblerrordoc" style="font-size:.75rem;color:#dc2626;margin:0;align-self:center;"></label>
                                </li>
                                <li>
                                    <button type="submit" value="SaveChange" class="wl-mf-btn wl-mf-btn--save special-iii btnssl2233" data-loading-text="<i class='fa fa-spinner fa-spin'></i>"><i class="fas fa-save"></i> Save Changes</button>
                                </li>
                            </ul>
