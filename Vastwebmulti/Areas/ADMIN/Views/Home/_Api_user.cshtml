                                    <span class="wl-doc-card__title">PAN Card</span>
                                </div>
                                @Html.TextBox("pancardEdit", "", new { @class = "form-control", placeholder = "PAN No", @style = "text-transform:uppercase", maxlength = 10 })
                                <div class="wl-doc-card__actions" id="pandocshow">
                                    <button type="button" class="wl-doc-btn wl-doc-btn--view" data-toggle="modal" data-target="#panviewdoc"><i class="fas fa-eye"></i> View</button>
                                    <button type="button" class="wl-doc-btn wl-doc-btn--delete" onclick="Rejected('pan')"><i class="fas fa-trash-alt"></i> Reject</button>
                                    <div id="panapproved"><button type="button" class="wl-doc-btn wl-doc-btn--approve" onclick="Approved('pan')"><i class="fas fa-check-circle"></i> Approve</button></div>
                                </div>
