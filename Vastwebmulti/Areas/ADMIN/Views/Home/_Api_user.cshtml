        $("#PinEdit").parent().next(".alert.alert-success").remove();
        var name = $('#NameEdit').val(); var FarmName = $('#FirmEdit').val();
        var State = $('#StateEdit').val(); var District = $('#DistrictEdit').val();
        var Address = $('#AddressEdit').val(); var Pincode = $('#PinEdit').val();
        var adharcard = $('#AadhaarEdit').val(); var gst = $('#gstEdit').val(); var pancard = $('#pancardEdit').val();
        if (!name) { $("#PinEdit").parent().after("<div class='alert alert-danger'>Name Required</div>"); return false; }
        if (!FarmName) { $("#PinEdit").parent().after("<div class='alert alert-danger'>Firm Name Required</div>"); return false; }
        if (pancard.length > 0) { var regex=/([A-Z]){5}([0-9]){4}([A-Z]){1}$/; if (!regex.test(pancard.toUpperCase())) { $("#PinEdit").parent().after("<div class='alert alert-danger'>Invalid PAN No</div>"); return false; } }
        if (!State) { $("#PinEdit").parent().after("<div class='alert alert-danger'>State Required</div>"); return false; }
        if (!District) { $("#PinEdit").parent().after("<div class='alert alert-danger'>District Required</div>"); return false; }
        if (!Address) { $("#PinEdit").parent().after("<div class='alert alert-danger'>Address Required</div>"); return false; }
        if (!Pincode) { $("#PinEdit").parent().after("<div class='alert alert-danger'>Pincode Required</div>"); return false; }
    }
</script>
<script>
    function Approved(val) {
        $('#lblerrordoc').text('');
        if (val === 'pan' && $('#pancardEdit').val() == '') { $('#lblerrordoc').text('PAN Number Required'); return false; }
        if (val === 'aadhar' && $('#AadhaarEdit').val() == '') { $('#lblerrordoc').text('Aadhaar Number Required'); return false; }
        var apiid = $('#au_apiid_shared').val() || $('#apiid').val();
        $.ajax({
            url: '@Url.Action("Approvedapists","Home")', type: 'POST', data: { val: val, apiid: apiid }, cache: false,
            success: function (response) {
                if (response === 'pan') $('#panapproved').hide();
                else if (response === 'aadhar') $('#aadharapproved').hide();
                else if (response === 'gst') $('#gstapproved').hide();
                else if (response === 'Aggrement') $('#frmagrapproved').hide();
                if ($('#panapproved').css('display') == 'none' && $('#aadharapproved').css('display') == 'none') {
                    $('#frmagrEdit').val('Agreement Status Pending'); $('#frmagrapproved').hide();
                }
            }
        });
    }
    function Rejected(val) {
        var apiid = $('#au_apiid_shared').val() || $('#apiid').val();
        $.ajax({
            url: '@Url.Action("Rejectedapists","Home")', type: 'POST', data: { val: val, apiid: apiid }, cache: false,
            success: function (response) {
                if (response === 'pan') { $("#pandocnotshow").show(); $("#pandocshow").hide(); $('#frmagrdocshow').hide(); $("#frmagrdocnotshow").show(); $('#frmagrEdit').val('KYC Due'); }
                else if (response === 'aadhar') { $("#aadhardocnotshow").show(); $("#aadhardocshow").hide(); $('#frmagrdocshow').hide(); $("#frmagrdocnotshow").show(); $('#frmagrEdit').val('KYC Due'); }
                else if (response === 'gst') { $("#gstdocnotshow").show(); $("#gstdocshow").hide(); }
                else if (response === 'Aggrement') { $("#frmagrdocnotshow").show(); $('#frmagrdocshow').hide(); $('#frmagrapproved').hide(); $('#frmagrEdit').val('Agreement Status Pending'); $('#alinks').empty(); }
            }
        });
    }
</script>
<script>
    function Deleteuser() {
        // Use shared hidden field — accessible from both view and edit form
        var apiid = $('#au_apiid_shared').val() || $('#apiid').val();
        $.ajax({
            url: '@Url.Action("DeleteApiuserByID","Home")', type: 'POST', data: { apiid: apiid }, cache: false,
            success: function (response) {
                if (response == "success") $('#otpmodal').modal('show');
                else $('#error').text(response);
            }
        });
    }
    function EmailVerify() {
        var apiid = $('#au_apiid_shared').val() || $('#apiid').val();
        // Detach modal-hide refresh handler so table refresh via email verify doesn't double-fire
        $(document).off('hide.bs.modal.auModal', '#defaultModal222');
        $.ajax({
            url: '@Url.Action("emailverifyforapi","Home")', type: "POST", data: { apiid: apiid }, cache: false, dataType: "html",
            success: function (data2) {
                $('#apiusertable').html(data2);
                $('#defaultModal222').modal('hide');
                $('body').removeClass('modal-open');
                $(".modal-backdrop").remove();
                // Re-attach
                $(document).off('hide.bs.modal.auModal').on('hide.bs.modal.auModal', '#defaultModal222', function () {
                    $.ajax({ url: '@Url.Action("ApiUserlistPart","Home")', type: 'GET', cache: false, success: function (r) { $('#apiusertable').html(r); } });
                });
            }
        });
    }
</script>
