<!-- OTP Delete modal -->
<div id="otpmodal" class="modal fade" role="dialog">
    <div class="modal-dialog" style="width:420px;float:right;margin:0px;"><div class="modal-content">
        <div class="modal-header"><button type="button" class="close" data-dismiss="modal">&times;</button><h4 class="modal-title"><i class="fas fa-key" style="margin-right:6px;"></i>OTP Verification</h4></div>
        <div class="modal-body">
            @using (Ajax.BeginForm("ConfirmDeleteApiuserOTP", "Home", new AjaxOptions { HttpMethod = "POST", UpdateTargetId = "apiusertable", OnSuccess = "OnSuccessconfirm", OnFailure = "OnFailureotperror" }))
            {
                @Html.Hidden("apiiddelete")
                <div class="form-group"><label>Enter OTP</label>@Html.TextBox("Deleteotp", "", new { @class = "form-control", placeholder = "Enter OTP", required = "required" })</div>
                <span id="otpwrong" style="color:#dc2626;font-size:.78rem;"></span>
                <div style="margin-top:10px;text-align:right;">
                    <button type="submit" class="wl-mf-btn wl-mf-btn--delete special-iii btnssl2233" data-loading-text="<i class='fa fa-spinner fa-spin'></i>"><i class="fas fa-trash-alt"></i> Confirm Delete</button>
                </div>
            }
        </div>
    </div></div>
</div>

<!-- JS — use namespaced events to prevent duplicate registration on AJAX refresh -->
<script>
    // Edit button — switch to edit form
    $(document).off('click.auEdit').on('click.auEdit', '.mastetr222Modal button.wl-mf-btn[value="Edit"]', function () {
        $(".mastetr222Modal .first-form").hide();
        $(".mastetr222Modal .second-form").show();
    });
    // Back button (no value="Edit" so no conflict)
    $(document).off('click.auBack').on('click.auBack', '.mastetr222Modal .js-au-back', function () {
        $(".mastetr222Modal .second-form").hide();
        $(".mastetr222Modal .first-form").show();
    });
    // Delegated click on detail arrow — works after AJAX table refresh
    $(document).off('click.auOpenModal').on('click.auOpenModal', '.js-au-open-modal', function () {
        var apiid = $(this).data('apiid');
        mdActionBtn(apiid);
    });
    // Modal close — refresh table once (namespace prevents double-fire on re-render)
    $(document).off('hide.bs.modal.auModal').on('hide.bs.modal.auModal', '#defaultModal222', function () {
        $.ajax({
            url: '@Url.Action("ApiUserlistPart","Home")', type: 'GET', cache: false,
            success: function (response) { $('#apiusertable').html(response); }
        });
    });
</script>
<script>
    function OnSuccessconfirm(data) {
        // Detach the hide.bs.modal handler temporarily so table refresh doesn't fire twice
        $(document).off('hide.bs.modal.auModal', '#defaultModal222');
        $('#apiusertable').html(data);
        $('#defaultModal222').modal('hide');
        $('#otpmodal').modal('hide');
        $('body').removeClass('modal-open');
        $(".modal-backdrop").remove();
        ToastrMessage();
        toastr.success("Account Deleted Successfully");
        // Re-attach after a tick
        setTimeout(function () {
            $(document).off('hide.bs.modal.auModal').on('hide.bs.modal.auModal', '#defaultModal222', function () {
                $.ajax({ url: '@Url.Action("ApiUserlistPart","Home")', type: 'GET', cache: false, success: function (r) { $('#apiusertable').html(r); } });
            });
        }, 300);
    }
    function OnFailureotperror(data) {
        $('#otpmodal').modal('show');
        $('#otpwrong').text("OTP Mismatch — Please enter Correct OTP");
    }
</script>
<script>
    function OnSuccess() { $(".modal-backdrop").hide(); if (typeof ravi !== 'undefined') ravi("select").select2(); }
    $(document).off('ajaxComplete.auSelect2').on('ajaxComplete.auSelect2', function () { if (typeof ravi !== 'undefined') ravi("select").select2(); });
</script>
<script>
    function Editstatechange() { GetDistrict11($('#StateEdit').val()); }
    function GetDistrict11(_stateId) {
        $("#DistrictEdit").html("<option value='0'> Please wait...</option>").show();
        $.ajax({
            url: '@Url.Action("DistrictList","Home")', data: { Id: _stateId }, cache: false, type: "POST",
            success: function (data3) {
                ravi("#DistrictEdit").html("");
                for (var x = 0; x < data3.length; x++) ravi("#DistrictEdit").append($('<option></option>').val(data3[x].Value).html(data3[x].Text));
            }
        });
    }
    function binddistmdAction(staid, dist, objSelect11) {
        $.ajax({
            url: '@Url.Action("DistrictList","Home")', data: { Id: staid }, cache: false, type: "POST",
            success: function (data1) {
                var markup = "<option value='0'>Select District</option>";
                for (var x = 0; x < data1.length; x++) markup += "<option value=" + data1[x].Value + ">" + data1[x].Text + "</option>";
                ravi("#DistrictEdit").html(markup).show();
                setSelectedValue(objSelect11, dist);
            }
        });
    }
    function setSelectedValue(selectObj, valueToSet) {
        for (var i = 0; i < selectObj.options.length; i++) { if (selectObj.options[i].value == valueToSet) { selectObj.options[i].selected = true; return; } }
    }
    function converttoDate(str) {
        var date = new Date(str), mnth = ("0"+(date.getMonth()+1)).slice(-2), day = ("0"+date.getDate()).slice(-2);
        return [day,mnth,date.getFullYear()].join("-")+" "+date.getHours()+":"+date.getMinutes()+":"+date.getSeconds();
    }
</script>
<script>
