                                <div class="wl-doc-card__head">
                                    <span class="wl-doc-card__icon wl-doc-card__icon--aadhar"><i class="fas fa-fingerprint"></i></span>
                                    <span class="wl-doc-card__title">Aadhaar Card</span>
                                </div>
                                @Html.TextBox("AadhaarEdit", "", new { @class = "form-control", placeholder = "Aadhaar No", onkeypress = "return isNumber(event)", maxlength = "12" })
                                <div class="wl-doc-card__actions" id="aadhardocshow">
                                    <button type="button" class="wl-doc-btn wl-doc-btn--view" data-toggle="modal" data-target="#aadharviewdoc"><i class="fas fa-eye"></i> View</button>
                                    <button type="button" class="wl-doc-btn wl-doc-btn--delete" onclick="Rejected('aadhar')"><i class="fas fa-trash-alt"></i> Reject</button>
