@model IEnumerable<Vastwebmulti.Models.Recharge_sell_by_dealer>
@using System.Linq
@{
    ViewBag.Title = "Recharge Seller Distributors";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var reports = Model ?? Enumerable.Empty<Vastwebmulti.Models.Recharge_sell_by_dealer>();
    var rowCount = reports.Count();
    var selectedDealer = (Request["Dealertdd"] ?? "").Trim();
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=48" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-recharge-seller-modern.css?v=5" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-ecommerce-history-page saas-recharge-seller-page">

    <div class="container-fluid vm-opr-page-shell">

        @using (Html.BeginForm("DistibutorListforseller", "Home", FormMethod.Post, new { id = "rechargeSellerForm", @class = "vm-rpt-filters-panel__form" }))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line vm-gift-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb vm-rseller-breadcrumb">
                        <li class="vm-rseller-breadcrumb__parent vm-rseller-breadcrumb__hide-mobile"><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li class="vm-rseller-breadcrumb__parent"><a href="@Url.Action("DistibutorList", "Home")">Distributor List</a></li>
                        <li class="vm-rseller-breadcrumb__current" aria-current="page">Recharge Seller</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-radiant-inline-filters vm-ecomm-filter-row--one-line vm-gift-filter-row--one-line">

                        <div class="vm-opr-field vm-dmt-field vm-rseller-field--dealer">
                            <select id="Dealertdd" name="Dealertdd" class="vm-opr-select vm-dmt-select form-control">
                                <option value="">All Distributors</option>
                                @if (ViewBag.dealerdetailess != null)
                                {
                                    foreach (var i in ViewBag.dealerdetailess)
                                    {
                                        var dealerId = (string)i.DealerId;
                                        <option value="@dealerId" @(selectedDealer == dealerId ? "selected=\"selected\"" : null)>@i.FarmName</option>
                                    }
                                }
                            </select>
                        </div>

                        <div class="vm-dmt-filter-search-group">
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

            </div>
        }

        <div class="vm-opr-main-card vm-security-report-main-card vm-rseller-main-card">
            <div class="vm-opr-table-panel vm-security-report-table-panel vm-rseller-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head vm-security-report-table-head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-store" aria-hidden="true"></i>
                        <span>Recharge seller distributors</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong id="rsellerRecordCount">@rowCount</strong>
                        </span>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="rechargeSellerTable" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th class="vm-rseller-th vm-rseller-th--master">Master Distributor Firm</th>
                                    <th class="vm-rseller-th vm-rseller-th--dist">Distributor Firm</th>
                                    <th class="vm-rseller-th vm-rseller-th--name">Distributor Name</th>
                                    <th class="vm-rseller-th vm-rseller-th--mobile">Mobile No</th>
                                    <th class="vm-rseller-th vm-rseller-th--email">Email</th>
                                    <th class="vm-rseller-th vm-rseller-th--status">Sell Status</th>
                                </tr>
                            </thead>
                            <tbody id="body">
                                @Html.Partial("_DistibutorListforsellerRows", reports)
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<script src="~/MainFrontDesign/select2/dist/js/select2.min.js"></script>
<script>
    function stschange(userid, status, rowIndex) {
        $.ajax({
            url: '@Url.Action("Stscanhgedlmsell", "Home")',
            data: { userid: userid, status: status },
            type: 'GET',
            cache: false,
            success: function (data) {
                var $cell = $('.vm-rseller-sell-cell[data-row-index="' + rowIndex + '"]');
                var isOff = (data === false || data === 'false');
                if (isOff) {
                    $cell.html('<button type="button" class="vm-rseller-toggle vm-rseller-toggle--off" onclick="stschange(\'' + userid + '\', true, ' + rowIndex + ')" title="Sell recharge is OFF">OFF</button>');
                } else {
                    $cell.html('<button type="button" class="vm-rseller-toggle vm-rseller-toggle--on" onclick="stschange(\'' + userid + '\', false, ' + rowIndex + ')" title="Sell recharge is ON">ON</button>');
                }
            },
            error: function (jqXHR, textStatus, errorThrown) {
                console.error('AJAX request failed: ' + textStatus + ', ' + errorThrown);
            }
        });
    }

    function initRechargeSellerSelect2() {
        var $dealer = $('#Dealertdd');
        if (!$dealer.length || !$.fn.select2) {
            return;
        }
        if ($dealer.data('select2')) {
            $dealer.select2('destroy');
        }
        $dealer.select2({
            width: '100%',
            minimumResultsForSearch: 6,
            placeholder: 'All Distributors',
            dropdownParent: $('#rechargeSellerForm')
        });
        syncRechargeSellerSelect2Width();
    }

    function syncRechargeSellerSelect2Width() {
        var $dealer = $('#Dealertdd');
        if (!$dealer.length || !$dealer.data('select2')) {
            return;
        }
        var isMobile = window.innerWidth <= 991;
        var $container = $dealer.next('.select2-container');
        if (isMobile) {
            $container.css({
                width: '100%',
                minWidth: '100%',
                maxWidth: '100%',
                display: 'block'
            });
        } else {
            $container.css({ width: '', minWidth: '', maxWidth: '', display: '' });
        }
    }

    $(document).ready(function () {
        initRechargeSellerSelect2();
        $(window).on('resize orientationchange', syncRechargeSellerSelect2Width);
    });
</script>
