@model IEnumerable<Vastwebmulti.Models.admin_income_Result>
@using System.Linq
@{
    ViewBag.Title = "Admin_Income";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var reports = Model ?? Enumerable.Empty<Vastwebmulti.Models.admin_income_Result>();
    var rowCount = reports.Count();

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
    var ddlType = (Request["ddl_type"] ?? "All").Trim();
    if (string.IsNullOrEmpty(ddlType)) { ddlType = "All"; }

    var selApinm = (Request["apinm"] ?? "").Trim();
    var selPortno = (Request["portno"] ?? "").Trim();
    var selOptnm = (Request["optnm"] ?? "").Trim();

    var apinmBag = ViewBag.apinm as SelectList;
    var portnoBag = ViewBag.portno as SelectList;
    var optnmBag = ViewBag.optnm as SelectList;

    var apinmList = apinmBag != null
        ? new SelectList(apinmBag.Items, apinmBag.DataValueField, apinmBag.DataTextField, string.IsNullOrEmpty(selApinm) ? null : selApinm)
        : new SelectList(Enumerable.Empty<SelectListItem>());
    var portnoList = portnoBag != null
        ? new SelectList(portnoBag.Items, portnoBag.DataValueField, portnoBag.DataTextField, string.IsNullOrEmpty(selPortno) ? null : selPortno)
        : new SelectList(Enumerable.Empty<SelectListItem>());
    var optnmList = optnmBag != null
        ? new SelectList(optnmBag.Items, optnmBag.DataValueField, optnmBag.DataTextField, string.IsNullOrEmpty(selOptnm) ? null : selOptnm)
        : new SelectList(Enumerable.Empty<SelectListItem>());

    decimal totalPurchase = reports.Sum(a => a.purchase ?? 0m);
    decimal totalAdminIncome = reports.Sum(a => a.admin_income ?? 0m);
    decimal totalSuccess = reports.Sum(a => a.total ?? 0m);
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=46" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=35" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-admin-income-modern.css?v=7" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-security-report-page saas-giftcard-report-page saas-prepaid-card-report-page saas-admin-income-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var incomeFormAttrs = new Dictionary<string, object>
            {
                { "id", "adminIncomeForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("Admin_Income", "Home", FormMethod.Post, incomeFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line vm-gift-toolbar-one-line" style="margin:0 !important;">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Account</li>
                        <li>Business By Port/API</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters vm-ecomm-filter-row--one-line vm-gift-filter-row--one-line">

                        <div class="vm-opr-field vm-dmt-field vm-ai-field--category">
                            <select class="vm-opr-select vm-dmt-select form-control" id="ddl_type" name="ddl_type" title="Category" onchange="adminIncomeSearchOption()">
                                <option value="All" @(ddlType == "All" ? "selected" : null)>All Category</option>
                                <option value="MACHINE" @(ddlType == "MACHINE" ? "selected" : null)>MACHINE</option>
                                <option value="API" @(ddlType == "API" ? "selected" : null)>API</option>
                            </select>
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="apiname">
                            @Html.DropDownList("apinm", apinmList, "Select API", new { id = "apinm", @class = "vm-opr-select vm-dmt-select form-control", title = "API name" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="portnoo">
                            @Html.DropDownList("portno", portnoList, "Port", new { id = "portno", @class = "vm-opr-select vm-dmt-select form-control", title = "Port number" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-ai-field--operator vm-gift-field--operator">
                            @Html.DropDownList("optnm", optnmList, "Operator", new { id = "optnm", @class = "vm-opr-select vm-dmt-select form-control", title = "Operator" })
                        </div>

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="adminIncomeTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Business by Port/API totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideAdminIncomeTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Purchase</span>
                            <strong class="vm-opr-total-card__value" id="adminIncomeTotalPurchase">@totalPurchase.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Admin Income</span>
                            <strong class="vm-opr-total-card__value" id="adminIncomeTotalIncome">@totalAdminIncome.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Total Success</span>
                            <strong class="vm-opr-total-card__value" id="adminIncomeTotalSuccess">@totalSuccess.ToString("N2")</strong>
                        </div>
                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card vm-security-report-main-card vm-gift-report-main-card vm-prepaid-report-main-card">
            <div class="vm-opr-table-panel vm-security-report-table-panel vm-gift-report-table-panel vm-prepaid-report-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head vm-security-report-table-head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-chart-bar" aria-hidden="true"></i>
                        <span>Business by Port/API</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong id="adminIncomeRecordCount">@rowCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total" title="Total purchase for current filter">
                            Total: <strong id="adminIncomeInlineTotal">₹ @totalPurchase.ToString("N2")</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-gift-totals-btn vm-prepaid-totals-btn vm-ai-totals-btn" onclick="findAdminIncomeTotals()" title="Show totals" aria-expanded="false" aria-controls="adminIncomeTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnExportA" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDFA" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap vm-prepaid-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="adminIncomeReportTable" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th rowspan="2">Port/API&nbsp;Info</th>
                                    <th rowspan="2">Users</th>
                                    <th rowspan="2">Operator&nbsp;Name</th>
                                    <th colspan="2">Purchase</th>
                                    <th colspan="2">Retailer's</th>
                                    <th colspan="2">Distributor's</th>
                                    <th colspan="2">M/D&nbsp;User's</th>
                                    <th colspan="2">Api&nbsp;User's</th>
                                    <th colspan="2">Whitelabel's</th>
                                    <th colspan="1">Admin</th>
                                    <th colspan="1">Total&nbsp;Success</th>
                                </tr>
                                <tr>
                                    <th><span class="vm-ai-head-badge vm-ai-head-badge--rate">Rate</span></th>
                                    <th><span class="vm-ai-head-badge vm-ai-head-badge--pct">%</span></th>
                                    <th><span class="vm-ai-head-badge vm-ai-head-badge--comm">Commission</span></th>
                                    <th><span class="vm-ai-head-badge vm-ai-head-badge--pct">%</span></th>
                                    <th><span class="vm-ai-head-badge vm-ai-head-badge--comm">Commission</span></th>
                                    <th><span class="vm-ai-head-badge vm-ai-head-badge--pct">%</span></th>
                                    <th><span class="vm-ai-head-badge vm-ai-head-badge--comm">Commission</span></th>
                                    <th><span class="vm-ai-head-badge vm-ai-head-badge--pct">%</span></th>
                                    <th><span class="vm-ai-head-badge vm-ai-head-badge--comm">Commission</span></th>
                                    <th><span class="vm-ai-head-badge vm-ai-head-badge--pct">%</span></th>
                                    <th><span class="vm-ai-head-badge vm-ai-head-badge--comm">Commission</span></th>
                                    <th><span class="vm-ai-head-badge vm-ai-head-badge--pct">%</span></th>
                                    <th><span class="vm-ai-head-badge vm-ai-head-badge--income">Income</span></th>
                                    <th><span class="vm-ai-head-badge vm-ai-head-badge--success">Success + Pending</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    decimal? totalcountinc = 0;
                                    decimal? retailertotalinc = 0;
                                    decimal? dlmtotalinc = 0;
                                    decimal? mdtotalinc = 0;
                                    decimal? apitotalinc = 0;
                                    decimal? wltotalinc = 0;
                                    decimal? admintotalinc = 0;
                                    decimal? totalpurcahse = 0;
                                }
                                <tr class="vm-ai-row-total">
                                    <td colspan="3" class="vm-ai-text"><strong>Total</strong></td>
                                    <td colspan="2" class="vm-ai-num">@reports.Sum(a => a.purchase)</td>
                                    <td colspan="2" class="vm-ai-num">
                                        @reports.Where(a => a.UserRole == "Retailer" || a.UserRole == "API User").Sum(a => a.remincome)
                                    </td>
                                    <td colspan="2" class="vm-ai-num">
                                        @reports.Where(a => a.UserRole == "Retailer" || a.UserRole == "API User").Sum(a => a.dlmincome)
                                    </td>
                                    <td colspan="2" class="vm-ai-num">@reports.Sum(a => a.masterincome)</td>
                                    <td colspan="2" class="vm-ai-num">@reports.Sum(a => a.apiincome)</td>
                                    <td colspan="2" class="vm-ai-num">@reports.Sum(a => a.whitelabelincome)</td>
                                    <td class="vm-ai-num">@reports.Sum(a => a.admin_income)</td>
                                    <td class="vm-ai-num">@reports.Sum(a => a.total)</td>
                                </tr>
                                @foreach (var item in reports)
                                {
                                    var isNegative = item.admin_income < 0;
                                    var rowClass = isNegative ? "vm-ai-row-negative" : "";

                                    totalpurcahse = Convert.ToDecimal(reports.Sum(a => a.purchase));
                                    if (item.UserRole == "Retailer" || item.UserRole == "API User")
                                    {
                                        retailertotalinc = retailertotalinc + item.remincome;
                                        dlmtotalinc = dlmtotalinc + item.dlmincome;
                                        mdtotalinc = mdtotalinc + item.masterincome;
                                        apitotalinc = apitotalinc + item.apiincome;
                                        wltotalinc = wltotalinc + 0;
                                        totalcountinc = (apitotalinc + wltotalinc + retailertotalinc + dlmtotalinc + mdtotalinc);
                                        admintotalinc = totalpurcahse - totalcountinc;
                                    }
                                    if (item.UserRole == "Whitelabel")
                                    {
                                        retailertotalinc = retailertotalinc + 0;
                                        dlmtotalinc = dlmtotalinc + 0;
                                        mdtotalinc = mdtotalinc + 0;
                                        apitotalinc = apitotalinc + 0;
                                        wltotalinc = wltotalinc + item.whitelabelincome;
                                        totalcountinc = (apitotalinc + wltotalinc + retailertotalinc + dlmtotalinc + mdtotalinc);
                                        admintotalinc = totalpurcahse - totalcountinc;
                                    }
                                    decimal purper = 0; decimal remper = 0; decimal dlmper = 0;
                                    decimal mdper = 0; decimal apiper = 0; decimal whiteper = 0;
                                    if (item.total != 0)
                                    {
                                        decimal pur = Convert.ToDecimal(item.purchase);
                                        decimal rem = Convert.ToDecimal(item.remincome);
                                        decimal dlm = Convert.ToDecimal(item.dlmincome);
                                        decimal md = Convert.ToDecimal(item.masterincome);
                                        decimal api = Convert.ToDecimal(item.apiincome);
                                        decimal white = Convert.ToDecimal(item.whitelabelincome);
                                        decimal to = Convert.ToDecimal(item.total);
                                        decimal dif = Convert.ToDecimal("100");
                                        purper = (pur * dif) / to;
                                        remper = (rem * dif) / to;
                                        dlmper = (dlm * dif) / to;
                                        mdper = (md * dif) / to;
                                        apiper = (api * dif) / to;
                                        whiteper = (white * dif) / to;
                                    }
                                    <tr class="@rowClass">
                                        <td class="vm-ai-text">@item.type</td>
                                        <td class="vm-ai-text">@item.UserRole</td>
                                        <td class="vm-ai-text">@item.optnm</td>
                                        <td class="vm-ai-num">@Html.DisplayFor(modelItem => item.purchase)</td>
                                        <td class="vm-ai-num">@purper.ToString("0.##")</td>
                                        <td class="vm-ai-num">
                                            @if (item.UserRole == "Retailer" || item.UserRole == "API User")
                                            {
                                                @Html.DisplayFor(modelItem => item.remincome)
                                            }
                                            else
                                            {
                                                <text>0.00</text>
                                            }
                                        </td>
                                        <td class="vm-ai-num">@remper.ToString("0.##")</td>
                                        <td class="vm-ai-num">
                                            @if (item.UserRole == "Retailer" || item.UserRole == "API User")
                                            {
                                                @Html.DisplayFor(modelItem => item.dlmincome)
                                            }
                                            else
                                            {
                                                <text>0.00</text>
                                            }
                                        </td>
                                        <td class="vm-ai-num">@dlmper.ToString("0.##")</td>
                                        <td class="vm-ai-num">
                                            @if (item.UserRole == "Retailer" || item.UserRole == "API User")
                                            {
                                                @Html.DisplayFor(modelItem => item.masterincome)
                                            }
                                            else
                                            {
                                                <text>0.00</text>
                                            }
                                        </td>
                                        <td class="vm-ai-num">@mdper.ToString("0.##")</td>
                                        <td class="vm-ai-num">
                                            @if (item.UserRole == "Retailer" || item.UserRole == "API User")
                                            {
                                                @Html.DisplayFor(modelItem => item.apiincome)
                                            }
                                            else
                                            {
                                                <text>0.00</text>
                                            }
                                        </td>
                                        <td class="vm-ai-num">@apiper.ToString("0.##")</td>
                                        <td class="vm-ai-num">@item.whitelabelincome</td>
                                        <td class="vm-ai-num">@whiteper.ToString("0.##")</td>
                                        <td class="vm-ai-num">
                                            @if (item.UserRole == "Retailer" || item.UserRole == "API User")
                                            {
                                                @Html.DisplayFor(modelItem => item.admin_income)
                                            }
                                            else
                                            {
                                                decimal purchas = Convert.ToDecimal(item.purchase);
                                                decimal whitelabelinc = Convert.ToDecimal(item.whitelabelincome);
                                                decimal admininc = purchas - whitelabelinc;
                                                @admininc
                                            }
                                        </td>
                                        <td class="vm-ai-num">@Html.DisplayFor(modelItem => item.total)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<script src="~/MainFrontDesign/select2/dist/js/select2.full.min.js"></script>
<script src="~/MainFrontDesign/js/admin-report-pdf-export.js?v=1"></script>
<script>
    function hideAdminIncomeTotals() {
        var $panel = $('#adminIncomeTotalsPanel');
        var $btn = $('.vm-ai-totals-btn');
        $panel.hide().attr('aria-hidden', 'true');
        $btn.attr('aria-expanded', 'false');
    }

    function findAdminIncomeTotals() {
        var $panel = $('#adminIncomeTotalsPanel');
        var $btn = $('.vm-ai-totals-btn');
        if ($panel.is(':visible')) {
            hideAdminIncomeTotals();
            return;
        }
        $panel.show().attr('aria-hidden', 'false');
        $btn.attr('aria-expanded', 'true');
    }

    function adminIncomeToggleFilters(clearValues) {
        var type = document.getElementById('ddl_type').value;
        var $api = $('#apiname');
        var $port = $('#portnoo');

        $api.removeClass('is-visible');
        $port.removeClass('is-visible');

        if (type === 'MACHINE') {
            $port.addClass('is-visible');
        } else if (type === 'API') {
            $api.addClass('is-visible');
        } else if (clearValues) {
            $('#apinm').val('').trigger('change');
            $('#portno').val('').trigger('change');
        }
    }

    function adminIncomeSearchOption() {
        adminIncomeToggleFilters(true);
    }

    function destroyAdminIncomeSelect2($el) {
        if ($el && $el.length && $el.data('select2')) {
            $el.select2('destroy');
        }
    }

    function applyAdminIncomeSelect2($el) {
        if (!$el || !$el.length || !$.fn.select2) {
            return;
        }
        destroyAdminIncomeSelect2($el);
        $el.select2({
            width: '100%',
            minimumResultsForSearch: 6
        });
    }

    function initAdminIncomeSelect2() {
        applyAdminIncomeSelect2($('#ddl_type'));
        applyAdminIncomeSelect2($('#apinm'));
        applyAdminIncomeSelect2($('#portno'));
        applyAdminIncomeSelect2($('#optnm'));
    }

    function initAdminIncomeDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initAdminIncomeDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm('#adminIncomeForm');
        }
    }

    function exportAdminIncomeTable(type) {
        var table = document.getElementById('adminIncomeReportTable');
        if (!table) {
            return;
        }

        var stamp = new Date().toISOString().slice(0, 10);
        var title = 'Business By Port/API';
        var clone = table.cloneNode(true);

        if (type === 'excel') {
            var excelHtml = '<html><head><meta charset="utf-8"></head><body>' + clone.outerHTML + '</body></html>';
            var blob = new Blob(['\ufeff', excelHtml], { type: 'application/vnd.ms-excel' });
            var link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'AdminIncome_' + stamp + '.xls';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            return;
        }

        if (type === 'pdf') {
            if (typeof window.openAdminModernReportPdf === 'function') {
                window.openAdminModernReportPdf({
                    table: table,
                    title: title,
                    subtitle: 'Business performance by Port / API',
                    fromDate: document.getElementById('txt_frm_date') ? document.getElementById('txt_frm_date').value : '',
                    toDate: document.getElementById('txt_to_date') ? document.getElementById('txt_to_date').value : '',
                    orientation: 'landscape',
                    recordCount: parseInt((document.getElementById('adminIncomeRecordCount') || {}).textContent, 10) || 0
                });
            }
            return;
        }
    }

    $(document).ready(function () {
        initAdminIncomeSelect2();
        initAdminIncomeDatepickers();
        adminIncomeToggleFilters(false);
        $('#adminIncomeForm .select2-container').css('width', '100%');

        $('#btnExportA').on('click', function () {
            exportAdminIncomeTable('excel');
        });

        $('#btnPDFA').on('click', function () {
            exportAdminIncomeTable('pdf');
        });
    });
</script>
