@model IEnumerable<Vastwebmulti.Models.Money_API_URLS>
@using System.Linq
@{
    ViewBag.Title = "MoneyApiUrls";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var apiRows = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.Money_API_URLS>();
    var selectedApinm = (Request["apinm"] ?? "").Trim();
    var apiFilterNames = apiRows
        .Select(a => a.API_Name)
        .Where(n => !string.IsNullOrWhiteSpace(n))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(n => n)
        .ToList();
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=28" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-api-operator-modern.css?v=23" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-api-operator-page saas-money-api-urls-page">
    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
            <div class="saas-acc-toolbar-top vm-api-operator-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-api-operator-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li><a href="@Url.Action("Dashboard", "Home")#setting">Basic Setting</a></li>
                    <li>Vast Bazaar API</li>
                </ol>
                <div class="vm-dmt-fin-nav-row vm-api-operator-nav-wrap">
                    @Html.Partial("_menuapinm")
                </div>
            </div>

            <div class="vm-rpt-filters-panel vm-api-operator-filter-panel">
                <div class="saas-acc-filter-bar vm-opr-filter-row vm-api-operator-filter-row vm-rpt-filters-panel__bar">
                    <div class="vm-api-operator-filter-group vm-money-api-filter-group">
                        <div class="vm-opr-field vm-api-operator-field vm-money-api-field--api">
                            <select id="filterApinm" name="apinm" title="Api Name" class="form-control vm-opr-select vm-dmt-select vm-api-operator-select">
                                <option value="">Api Name</option>
                                @foreach (var name in apiFilterNames)
                                {
                                    if (string.Equals(name, selectedApinm, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <option value="@name" selected="selected">@name</option>
                                    }
                                    else
                                    {
                                        <option value="@name">@name</option>
                                    }
                                }
                            </select>
                        </div>
                        <button type="button" id="moneyApiFilterBtn" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-api-operator-search-btn" title="Search">
                            <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                        </button>
                        <button type="button" class="saas-acc-btn saas-acc-btn--search vm-api-nm-add-btn" data-toggle="modal" data-target="#moneyApiAddModal" title="Add New IMPS API">
                            <i class="fas fa-plus" aria-hidden="true"></i><span>Add New</span>
                        </button>
                        <button type="button" class="saas-acc-btn vm-api-money-token-btn" data-toggle="modal" data-target="#moneyApiTokenModal" title="Token Security">
                            <i class="fas fa-shield-alt" aria-hidden="true"></i><span>Token Security</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-link" aria-hidden="true"></i>
                        <span>IMPS / Vast Bazaar API configuration</span>
                    </div>
                    <label class="vm-api-operator-table-search" for="moneyApiSearch">
                        <i class="fas fa-search" aria-hidden="true"></i>
                        <input type="text" id="moneyApiSearch" placeholder="Search records..." autocomplete="off" />
                    </label>
                </div>
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="moneyApiTable" class="table vm-opr-data-table vm-money-api-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>API Name</th>
                                    <th>API ID</th>
                                    <th>API Token1</th>
                                    <th>API Token2</th>
                                    <th>API Token3</th>
                                    <th>Token Priority</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in apiRows)
                                {
                                    <tr data-api-name="@(item.API_Name ?? "")">
                                        <td class="vm-api-name-cell">
                                            @item.API_Name
                                            <input type="hidden" class="vm-money-api-id" value="@item.Idno" />
                                            <input type="hidden" class="vm-money-api-name" value="@Html.AttributeEncode(item.API_Name ?? "")" />
                                            <input type="hidden" class="vm-money-api-apiid" value="@Html.AttributeEncode(item.API_ID ?? "")" />
                                            <input type="hidden" class="vm-money-api-pwd" value="@Html.AttributeEncode(item.Api_pwd ?? "")" />
                                            <input type="hidden" class="vm-money-api-token1" value="@Html.AttributeEncode(item.Token ?? "")" />
                                            <input type="hidden" class="vm-money-api-token2" value="@Html.AttributeEncode(item.token1 ?? "")" />
                                            <input type="hidden" class="vm-money-api-token3" value="@Html.AttributeEncode(item.token2 ?? "")" />
                                            <input type="hidden" class="vm-money-api-priority" value="@Html.AttributeEncode(item.tokenpriority ?? "")" />
                                        </td>
                                        <td class="vm-api-name-cell--mono vm-money-api-cell--clip" title="@(item.API_ID ?? "")">@item.API_ID</td>
                                        <td class="vm-api-name-cell--mono vm-api-name-cell--ellipsis vm-money-api-cell--clip" title="@(item.Token ?? "")">@item.Token</td>
                                        <td class="vm-api-name-cell--mono vm-api-name-cell--ellipsis vm-money-api-cell--clip" title="@(item.token1 ?? "")">@item.token1</td>
                                        <td class="vm-api-name-cell--mono vm-api-name-cell--ellipsis vm-money-api-cell--clip" title="@(item.token2 ?? "")">@item.token2</td>
                                        <td class="vm-api-name-cell--priority vm-money-api-cell--clip">@item.tokenpriority</td>
                                        <td class="vm-api-nm-action-cell">
                                            <div class="vm-api-nm-action-group">
                                                <button type="button"
                                                        class="vm-api-operator-edit-btn vm-money-api-edit-btn"
                                                        data-toggle="modal"
                                                        data-target="#moneyApiEditModal"
                                                        title="Edit API">
                                                    <i class="fas fa-edit" aria-hidden="true"></i> Edit
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Add IMPS API Modal -->
<div class="modal fade saas-admin-modal vm-sm-modal vm-api-operator-modal vm-api-nm-modal vm-api-money-urls-modal" id="moneyApiAddModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered saas-admin-modal-dialog vm-sm-modal-dialog" role="document">
        <div class="modal-content">
            @using (Html.BeginForm("Add_MoneyApiUrls", "Home", FormMethod.Post, new { id = "moneyApiAddForm" }))
            {
                <div class="modal-header saas-admin-modal-header accent-sky">
                    <div class="saas-admin-modal-head-main">
                        <div class="saas-admin-modal-icon"><i class="fas fa-plus" aria-hidden="true"></i></div>
                        <div class="saas-admin-modal-title-wrap">
                            <h4 class="modal-title saas-admin-modal-title">Add IMPS API Url</h4>
                            <p class="saas-admin-modal-subtitle">Configure Vast Bazaar API credentials</p>
                        </div>
                    </div>
                    <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
                </div>

                <div class="modal-body saas-admin-modal-body saas-admin-modal-scroll vm-sm-modal-body">
                    <div class="vm-sm-modal-panel vm-api-operator-form-grid">
                        <div class="vm-sm-modal-field vm-sm-modal-field--full">
                            <label for="txtapiname">API Name</label>
                            <input type="text" id="txtapiname" name="txtapiname" value="VASTWEB" placeholder="Enter API Name" class="form-control" readonly="readonly" maxlength="8" required="" />
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="apiid">API ID</label>
                            @Html.TextBox("apiid", "", new { id = "apiid", @class = "form-control", @required = "", @placeholder = "Enter API ID" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="pwd">Password</label>
                            @Html.TextBox("pwd", "", new { id = "pwd", @class = "form-control", @placeholder = "Enter Password", @required = "" })
                        </div>
                        <div class="vm-sm-modal-field vm-sm-modal-field--full">
                            <label for="tkn">API Token1</label>
                            @Html.TextBox("tkn", "", new { id = "tkn", @class = "form-control", @placeholder = "Enter API Token1", @required = "" })
                        </div>
                        <div class="vm-sm-modal-field vm-sm-modal-field--full">
                            <label for="tkn1">API Token2</label>
                            @Html.TextBox("tkn1", "", new { id = "tkn1", @class = "form-control", @placeholder = "Enter API Token2", @required = "" })
                        </div>
                        <div class="vm-sm-modal-field vm-sm-modal-field--full">
                            <label for="tkn2">API Token3</label>
                            @Html.TextBox("tkn2", "", new { id = "tkn2", @class = "form-control", @placeholder = "Enter API Token3", @required = "" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="tokenpriority">Token Priority</label>
                            @Html.DropDownList("tokenpriority", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "token1", Value = "token1" },
                                new SelectListItem { Text = "token2", Value = "token2" },
                                new SelectListItem { Text = "token3", Value = "token3" }
                            }, new { id = "tokenpriority", @class = "form-control" })
                        </div>
                    </div>
                </div>

                <div class="modal-footer saas-admin-modal-footer vm-sm-modal-footer">
                    <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal">
                        <i class="fas fa-times" aria-hidden="true"></i> Cancel
                    </button>
                    <button type="submit" class="saas-admin-modal-btn saas-admin-modal-btn--success">
                        <i class="fas fa-save" aria-hidden="true"></i> Save Changes
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Edit IMPS API Modal -->
<div class="modal fade saas-admin-modal vm-sm-modal vm-api-operator-modal vm-api-nm-modal vm-api-money-urls-modal" id="moneyApiEditModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered saas-admin-modal-dialog vm-sm-modal-dialog" role="document">
        <div class="modal-content">
            @using (Html.BeginForm("Edit_MoneyApiUrls", "Home", FormMethod.Post, new { id = "moneyApiEditForm" }))
            {
                <div class="modal-header saas-admin-modal-header accent-emerald">
                    <div class="saas-admin-modal-head-main">
                        <div class="saas-admin-modal-icon"><i class="fas fa-edit" aria-hidden="true"></i></div>
                        <div class="saas-admin-modal-title-wrap">
                            <h4 class="modal-title saas-admin-modal-title">Edit IMPS API Url</h4>
                            <p class="saas-admin-modal-subtitle">Update Vast Bazaar API credentials</p>
                        </div>
                    </div>
                    <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
                </div>

                <div class="modal-body saas-admin-modal-body saas-admin-modal-scroll vm-sm-modal-body">
                    @Html.Hidden("IdnoEdit", "", new { id = "IdnoEdit" })
                    <div class="vm-sm-modal-panel vm-api-operator-form-grid">
                        <div class="vm-sm-modal-field vm-sm-modal-field--full">
                            <label for="txtapinm">API Name</label>
                            @Html.TextBox("txtapinm", "", new { id = "txtapinm", @class = "form-control", @readonly = "readonly" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="txtapiid">API ID</label>
                            @Html.TextBox("txtapiid", "", new { id = "txtapiid", @class = "form-control" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="txtpwd">Password</label>
                            @Html.TextBox("txtpwd", "", new { id = "txtpwd", @class = "form-control" })
                        </div>
                        <div class="vm-sm-modal-field vm-sm-modal-field--full">
                            <label for="txttkn">Token1</label>
                            @Html.TextBox("txttkn", "", new { id = "txttkn", @class = "form-control" })
                        </div>
                        <div class="vm-sm-modal-field vm-sm-modal-field--full">
                            <label for="txttkn1">Token2</label>
                            @Html.TextBox("txttkn1", "", new { id = "txttkn1", @class = "form-control" })
                        </div>
                        <div class="vm-sm-modal-field vm-sm-modal-field--full">
                            <label for="txttkn2">Token3</label>
                            @Html.TextBox("txttkn2", "", new { id = "txttkn2", @class = "form-control" })
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="txttokenpriority">Token Priority</label>
                            @Html.DropDownList("txttokenpriority", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "token1", Value = "token1" },
                                new SelectListItem { Text = "token2", Value = "token2" },
                                new SelectListItem { Text = "token3", Value = "token3" }
                            }, new { id = "txttokenpriority", @class = "form-control" })
                        </div>
                    </div>
                </div>

                <div class="modal-footer saas-admin-modal-footer vm-sm-modal-footer">
                    <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal">
                        <i class="fas fa-times" aria-hidden="true"></i> Cancel
                    </button>
                    <button type="submit" class="saas-admin-modal-btn saas-admin-modal-btn--success">
                        <i class="fas fa-save" aria-hidden="true"></i> Save Changes
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Token Security Modal -->
<div class="modal fade saas-admin-modal vm-sm-modal vm-api-operator-modal vm-api-nm-modal vm-api-money-urls-modal vm-api-money-token-modal" id="moneyApiTokenModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered saas-admin-modal-dialog vm-sm-modal-dialog" role="document">
        <div class="modal-content">
            @using (Html.BeginForm("Tokensecurity", "Home", FormMethod.Post, new { id = "moneyApiTokenForm" }))
            {
                <div class="modal-header saas-admin-modal-header accent-violet">
                    <div class="saas-admin-modal-head-main">
                        <div class="saas-admin-modal-icon"><i class="fas fa-shield-alt" aria-hidden="true"></i></div>
                        <div class="saas-admin-modal-title-wrap">
                            <h4 class="modal-title saas-admin-modal-title">Token Security</h4>
                            <p class="saas-admin-modal-subtitle">Configure offer API token and email</p>
                        </div>
                    </div>
                    <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
                </div>

                <div class="modal-body saas-admin-modal-body saas-admin-modal-scroll vm-sm-modal-body">
                    <div class="vm-sm-modal-panel vm-api-operator-form-grid vm-api-money-token-grid">
                        <div class="vm-sm-modal-field">
                            <label for="tokenno">Token Number <sup>*</sup></label>
                            <input type="text" id="tokenno" name="tokenno" class="form-control" placeholder="Enter Token Number" required="" />
                        </div>
                        <div class="vm-sm-modal-field">
                            <label for="emailid">Email Id <sup>*</sup></label>
                            <input type="text" id="emailid" name="emailid" class="form-control" placeholder="Enter Email Id" required="" />
                        </div>
                    </div>
                </div>

                <div class="modal-footer saas-admin-modal-footer vm-sm-modal-footer">
                    <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal">
                        <i class="fas fa-times" aria-hidden="true"></i> Cancel
                    </button>
                    <button type="submit" id="moneyApiTokenSaveBtn" class="saas-admin-modal-btn saas-admin-modal-btn--success">
                        <i class="fas fa-save" aria-hidden="true"></i> Save Changes
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<script>
    (function () {
        function openMoneyApiEdit($, $btn) {
            var $row = $btn.closest('tr');
            $('#IdnoEdit').val($row.find('.vm-money-api-id').val() || '');
            $('#txtapinm').val($row.find('.vm-money-api-name').val() || '');
            $('#txtapiid').val($row.find('.vm-money-api-apiid').val() || '');
            $('#txtpwd').val($row.find('.vm-money-api-pwd').val() || '');
            $('#txttkn').val($row.find('.vm-money-api-token1').val() || '');
            $('#txttkn1').val($row.find('.vm-money-api-token2').val() || '');
            $('#txttkn2').val($row.find('.vm-money-api-token3').val() || '');
            $('#txttokenpriority').val($row.find('.vm-money-api-priority').val() || '');
        }

        function initMoneyApiFilter($) {
            var $api = $('#filterApinm');
            if (!$api.length) {
                return;
            }
            if ($api.hasClass('select2-hidden-accessible')) {
                $api.select2('destroy');
            }
            if ($.fn.select2) {
                $api.select2({
                    width: '100%',
                    placeholder: 'Api Name',
                    allowClear: true,
                    dropdownParent: $(document.body)
                });
            }
        }

        function applyMoneyApiFilters() {
            var apiVal = ($('#filterApinm').val() || '').trim().toLowerCase();
            var q = ($('#moneyApiSearch').val() || '').trim().toLowerCase();

            $('#moneyApiTable tbody tr').each(function () {
                var $row = $(this);
                var apiName = ($row.attr('data-api-name') || '').toLowerCase();
                var text = $row.text().toLowerCase();
                var matchApi = !apiVal || apiName === apiVal;
                var matchSearch = !q || text.indexOf(q) > -1;
                $row.toggle(matchApi && matchSearch);
            });
        }

        function bootMoneyApiPage() {
            var $ = window.jQuery;
            if (!$ || !$.fn || !$.fn.modal) {
                window.setTimeout(bootMoneyApiPage, 50);
                return;
            }

            initMoneyApiFilter($);

            var successMsg = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Convert.ToString(ViewData["success"])))';
            var errorMsg = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Convert.ToString(ViewData["errormsg"])))';

            if (successMsg && window.swal) {
                swal('Good job!', successMsg, 'success');
            }
            if (errorMsg && window.swal) {
                swal('Oops..!', errorMsg, 'error');
            }

            if (@(!string.IsNullOrEmpty(selectedApinm) ? "true" : "false")) {
                applyMoneyApiFilters();
            }

            $('#moneyApiFilterBtn').off('click.moneyApi').on('click.moneyApi', applyMoneyApiFilters);
            $('#filterApinm').off('change.moneyApi select2:select.moneyApi select2:clear.moneyApi')
                .on('change.moneyApi select2:select.moneyApi select2:clear.moneyApi', applyMoneyApiFilters);
            $('#moneyApiSearch').off('keyup.moneyApi').on('keyup.moneyApi', applyMoneyApiFilters);

            $('#moneyApiEditModal').off('show.bs.modal.moneyApi').on('show.bs.modal.moneyApi', function (e) {
                var $btn = $(e.relatedTarget);
                if ($btn && $btn.hasClass('vm-money-api-edit-btn')) {
                    openMoneyApiEdit($, $btn);
                }
            });

            $(document).off('click.moneyApiEdit', '.vm-money-api-edit-btn').on('click.moneyApiEdit', '.vm-money-api-edit-btn', function (e) {
                openMoneyApiEdit($, $(this));
                if (typeof window.showAdminModal === 'function') {
                    e.preventDefault();
                    window.showAdminModal('#moneyApiEditModal');
                }
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', bootMoneyApiPage);
        } else {
            bootMoneyApiPage();
        }
    })();
</script>
