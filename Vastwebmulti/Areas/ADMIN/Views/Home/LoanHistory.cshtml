@model IEnumerable<Vastwebmulti.Models.loanrequest>
@using Vastwebmulti.Models
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Loan History";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    VastwebmultiEntities db = new VastwebmultiEntities();
    var rows = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.loanrequest>();
    var retailerNames = db.Retailer_Details.ToDictionary(r => r.RetailerId, r => r.Frm_Name ?? "—");
    var pendingCount = rows.Count(r => r.status == "Pending");
    var updateUrl = Url.Action("LoanreqUpdate", "Home");
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-settings-page-modern.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-settings-page">
    <div class="container-fluid">

        
        <div class="saas-acc-toolbar">
            <ol class="saas-acc-breadcrumb">
                <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                <li><a href="@Url.Action("More_Option", "Home")">More Options</a></li>
                <li>Loan History</li>
            </ol>
        </div>

        <div class="saas-acc-table-card">
            <div class="saas-acc-table-card-head">
                <h3>Loan requests</h3>
                <span class="saas-acc-row-count"><i class="fas fa-list" aria-hidden="true"></i> @rows.Count records</span>
            </div>
            <div class="saas-acc-table-wrap table-responsive">
                <table class="table saas-acc-table table-bordered">
                    <thead>
                        <tr>
                            <th>Status</th>
                            <th>User</th>
                            <th>Amount</th>
                            <th>Days</th>
                            <th>Last Date</th>
                            <th>Request Time</th>
                            <th>Response Time</th>
                            <th>Loan ID</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var rowIdx = 0; }
                        @foreach (var i in rows)
                        {
                            var frm = retailerNames.ContainsKey(i.userid) ? retailerNames[i.userid] : "—";
                            var lastDate = i.minserverloandate != null ? Convert.ToDateTime(i.minserverloandate).ToString("dd-MM-yyyy") : "—";
                            <tr>
                                <td data-label="Status">
                                    @if (i.status == "Pending")
                                    {
                                        <span class="saas-set-badge-pending">@i.status</span>
                                    }
                                    else
                                    {
                                        <span class="saas-set-badge-done">@i.status</span>
                                    }
                                </td>
                                <td data-label="User">@frm</td>
                                <td data-label="Amount">@i.amount</td>
                                <td data-label="Days">@i.months</td>
                                <td data-label="Last Date">@lastDate</td>
                                <td data-label="Request Time">@i.requesttime</td>
                                <td data-label="Response Time">@i.responsetime</td>
                                <td data-label="Loan ID">@i.loanid</td>
                                <td data-label="Action">
                                    @if (i.status == "Pending")
                                    {
                                        <div class="saas-set-action-group">
                                            <button type="button" class="saas-set-btn-danger loan-action-btn"
                                                    data-sts="Failed" data-user="@frm" data-amount="@i.amount"
                                                    data-loanid="@i.loanid" data-idno="@i.idno">Failed</button>
                                            <button type="button" class="saas-set-btn-success loan-action-btn"
                                                    data-sts="Success" data-user="@frm" data-amount="@i.amount"
                                                    data-loanid="@i.loanid" data-idno="@i.idno">Success</button>
                                        </div>
                                    }
                                </td>
                            </tr>
                            rowIdx++;
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</section>

<div class="saas-set-confirm-overlay" id="loanConfirmOverlay" aria-hidden="true">
    <div class="saas-set-confirm-card" role="dialog" aria-labelledby="loanConfirmTitle">
        <h3 id="loanConfirmTitle">Confirm loan update</h3>
        <p class="saas-set-confirm-detail">User: <strong id="loanConfirmUser"></strong></p>
        <p class="saas-set-confirm-detail">Amount: <strong id="loanConfirmAmount"></strong></p>
        <p class="saas-set-confirm-detail">Loan ID: <strong id="loanConfirmLoanId"></strong></p>
        <p class="saas-set-confirm-detail">Action: <strong id="loanConfirmAction"></strong></p>
        <div class="saas-set-confirm-actions">
            <a href="#" id="loanConfirmProceed" class="saas-set-btn-primary" style="display:inline-flex;align-items:center;text-decoration:none;">Confirm</a>
            <button type="button" class="saas-set-btn-edit" onclick="loanConfirmClose()">Cancel</button>
        </div>
    </div>
</div>

<script>
    var _loanUpdateBase = '@updateUrl';

    function loanConfirmOpen(sts, userName, amount, loanId, idno) {
        document.getElementById('loanConfirmUser').textContent = userName;
        document.getElementById('loanConfirmAmount').textContent = amount;
        document.getElementById('loanConfirmLoanId').textContent = loanId;
        document.getElementById('loanConfirmAction').textContent = sts;
        var link = _loanUpdateBase
            + '?sts=' + encodeURIComponent(sts)
            + '&idno=' + encodeURIComponent(idno)
            + '&Loanid=' + encodeURIComponent(loanId);
        document.getElementById('loanConfirmProceed').href = link;
        document.getElementById('loanConfirmOverlay').classList.add('is-open');
    }

    function loanConfirmClose() {
        document.getElementById('loanConfirmOverlay').classList.remove('is-open');
    }

    document.getElementById('loanConfirmOverlay').addEventListener('click', function (e) {
        if (e.target === this) loanConfirmClose();
    });

    $(document).on('click', '.loan-action-btn', function () {
        var $b = $(this);
        loanConfirmOpen(
            $b.data('sts'),
            $b.data('user'),
            $b.data('amount'),
            $b.data('loanid'),
            $b.data('idno')
        );
    });
</script>
