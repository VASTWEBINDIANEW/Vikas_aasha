@model IEnumerable<Vastwebmulti.Models.Show_MicroAtM_UnholdHistory_Result>
@using System.Linq
@{
    ViewBag.Title = "Micro ATM Unhold History";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var rows = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.Show_MicroAtM_UnholdHistory_Result>();
    var frmDate = (ViewBag.frmDate as string) ?? DateTime.Today.ToString("yyyy-MM-dd");
    var toDate = (ViewBag.toDate as string) ?? DateTime.Today.ToString("yyyy-MM-dd");
    var totalAmount = rows.Sum(r => r.amount ?? 0);
    var historyExcelUrl = Url.Action("ExcelMicroATMUnholdHistoryReport", "Home");
    var historyPdfUrl = Url.Action("PDFMicroATMUnholdHistoryReport", "Home");
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-settings-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-settings-page saas-admin-report-page saas-micro-history-page">
    <div class="container-fluid">

        @using (Html.BeginForm("MicroATM_Unhold_History", "Home", FormMethod.Post, new { id = "microUnholdHistoryForm", data_date_mode = (ViewBag.chk as string) == "post" ? "post" : "get", data_frm_date = frmDate, data_to_date = toDate, @style = "margin: 0 0 20px;" }))
        {
            <div class="saas-acc-toolbar saas-pan-toolbar-unified saas-micro-toolbar-unified">
                <ol class="saas-acc-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li><a href="@Url.Action("Micro_Atm_Unhold_Report", "Home")">Micro ATM Unhold</a></li>
                    <li>Hold history</li>
                </ol>
                <div class="saas-acc-toolbar-right saas-pan-toolbar-dates">
                    <div class="saas-acc-report-date-controls saas-pan-date-controls">
                        <div class="saas-report-date-fields">
                            <div class="saas-acc-dp-field">
                                <label class="saas-acc-dp-label" for="txt_frm_date">From date</label>
                                <span class="saas-acc-dp-icon" title="From date"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "yyyy-mm-dd" })
                            </div>
                            <div class="saas-acc-dp-field">
                                <label class="saas-acc-dp-label" for="txt_to_date">To date</label>
                                <span class="saas-acc-dp-icon" title="To date"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "yyyy-mm-dd" })
                            </div>
                        </div>
                        <div class="saas-report-toolbar-actions">
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn">
                                <i class="fas fa-search" aria-hidden="true"></i> Search
                            </button>
                            <button type="button" class="saas-acc-btn saas-acc-btn--search saas-report-total-btn" id="btnMicroHistoryTotal" title="Total amount">
                                <i class="fas fa-calculator" aria-hidden="true"></i> Total
                            </button>
                            <div class="saas-acc-export-group saas-pan-export-group">
                                <button type="button" class="saas-acc-btn saas-acc-btn--excel saas-pan-export-btn" id="btnExport" title="Export Excel">
                                    <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                                </button>
                                <button type="button" class="saas-acc-btn saas-acc-btn--pdf saas-pan-export-btn" id="btnMicroHistoryPdf" title="Export PDF">
                                    <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="saas-acc-table-card">
            <div class="saas-acc-table-card-head">
                <h3>Unhold history</h3>
                <span class="saas-acc-row-count">
                    <i class="fas fa-list" aria-hidden="true"></i> @rows.Count records
                    <span class="saas-pan-report-meta"> � @frmDate to @toDate � ?@totalAmount.ToString("N2")</span>
                </span>
            </div>
            <div class="saas-acc-table-wrap table-responsive">
                <table class="table saas-acc-table table-bordered saas-acc-table--ledger" id="microUnholdHistoryTable">
                    <thead>
                        <tr>
                            <th>Firm name</th>
                            <th>Unhold by</th>
                            <th>Bank RRN</th>
                            <th>Txn type</th>
                            <th>Payment</th>
                            <th class="text-right">Amount</th>
                            <th>Card payment</th>
                            <th>Masked PAN</th>
                            <th>Ret. pre</th>
                            <th>Ret. post</th>
                            <th>Network</th>
                            <th>Card usage</th>
                            <th>Unhold time</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (rows.Count == 0)
                        {
                            <tr>
                                <td colspan="13" class="saas-pan-empty-cell">No records for selected dates.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in rows)
                            {
                                <tr>
                                    <td data-label="Firm">@item.frmname</td>
                                    <td data-label="Unhold by">@item.Person_name</td>
                                    <td data-label="RRN">@item.rrn</td>
                                    <td data-label="Type">@item.transaction_type</td>
                                    <td data-label="Payment">@item.payment_method</td>
                                    <td data-label="Amount" class="text-right saas-pan-amount micro-history-amt">@(item.amount.HasValue ? item.amount.Value.ToString("N2") : "0.00")</td>
                                    <td data-label="Card pay">@item.card_payment_type</td>
                                    <td data-label="PAN">@item.masked_pan</td>
                                    <td data-label="Pre">@item.retailer_remain_pre</td>
                                    <td data-label="Post">@item.retailer_remain_post</td>
                                    <td data-label="Network">@item.network</td>
                                    <td data-label="Usage">@item.card_usage_type</td>
                                    <td data-label="Time">@item.unhold_transection_time</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<script>
    $('#btnMicroHistoryTotal').on('click', function () {
        var total = 0;
        $('.micro-history-amt').each(function () {
            total += parseFloat(String($(this).text()).replace(/,/g, '')) || 0;
        });
        if (typeof swal === 'function') {
            swal('Total amount', '? ' + total.toFixed(2), 'info');
        } else {
            alert('Total: ? ' + total.toFixed(2));
        }
    });

    function microHistoryExportUrl(base) {
        var f = $('#txt_frm_date').val() || '';
        var t = $('#txt_to_date').val() || '';
        return base + '?txt_frm_date=' + encodeURIComponent(f) + '&txt_to_date=' + encodeURIComponent(t);
    }

    $('#btnExport').on('click', function () {
        window.location.href = microHistoryExportUrl('@historyExcelUrl');
    });

    $('#btnMicroHistoryPdf').on('click', function () {
        window.open(microHistoryExportUrl('@historyPdfUrl'), '_blank');
    });
</script>
