@model IEnumerable<Vastwebmulti.Areas.ADMIN.Models.RchApiResponse>
@using System.Linq
@{
    var rows = Model != null ? Model.ToList() : new List<Vastwebmulti.Areas.ADMIN.Models.RchApiResponse>();
}

<table id="rechargeApiResponseTable" class="table vm-opr-data-table vm-recharge-api-data-table" cellspacing="0">
    <thead>
        <tr>
            <th class="vm-recharge-api-th--name">API Name</th>
            <th class="vm-recharge-api-th--type">Response Type</th>
            <th class="vm-recharge-api-th--key">Key Requestid</th>
            <th class="vm-recharge-api-th--key">Key Status</th>
            <th class="vm-recharge-api-th--val">Val Status Success</th>
            <th class="vm-recharge-api-th--val">Val Status Failed</th>
            <th class="vm-recharge-api-th--val">Val Status Pending</th>
            <th class="vm-recharge-api-th--key">Key OPTID</th>
            <th class="vm-recharge-api-th--key">Key Message</th>
            <th class="vm-recharge-api-th--key">Key Remain Balance</th>
            <th class="vm-recharge-api-th--key">Split With</th>
            <th class="vm-recharge-api-th--key">Key Error</th>
            <th class="vm-recharge-api-th--key">Key Error Message</th>
            <th class="vm-recharge-api-th--val">Val Error</th>
            <th class="vm-recharge-api-th--val">Val Error Message</th>
            <th class="vm-recharge-api-th--action">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in rows)
        {
            <tr data-idno="@item.idno" data-api-name="@(item.apiname ?? "")">
                <td class="vm-recharge-api-td--name">@item.apiname</td>
                <td class="vm-recharge-api-td--type">@item.Resptype</td>
                <td class="vm-recharge-api-td--key">@item.KeyRequestid</td>
                <td class="vm-recharge-api-td--key">@item.KeyStatus</td>
                <td class="vm-recharge-api-td--val">@item.ValStatusSucess</td>
                <td class="vm-recharge-api-td--val">@item.ValStatusFailed</td>
                <td class="vm-recharge-api-td--val">@item.ValStatusPending</td>
                <td class="vm-recharge-api-td--key">@item.KeyOptID</td>
                <td class="vm-recharge-api-td--key">@item.KeyMsg</td>
                <td class="vm-recharge-api-td--key">@item.KeyRemainBal</td>
                <td class="vm-recharge-api-td--key">@item.sapratewith</td>
                <td class="vm-recharge-api-td--key">@item.Keyerror</td>
                <td class="vm-recharge-api-td--key">@item.KeyerrorMessage</td>
                <td class="vm-recharge-api-td--val">@item.valerror</td>
                <td class="vm-recharge-api-td--val">@item.valerrorMessage</td>
                <td class="vm-recharge-api-td--action vm-api-nm-action-cell">
                    <div class="vm-api-nm-action-group">
                        <button type="button" class="vm-api-operator-edit-btn vm-recharge-api-response-edit-btn" data-idno="@item.idno" title="Edit Response">
                            <i class="fas fa-edit" aria-hidden="true"></i> Edit
                        </button>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
