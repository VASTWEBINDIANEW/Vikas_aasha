@model IEnumerable<Vastwebmulti.Models.passbyapidmt>
@using Vastwebmulti.Models
@{
    VastwebmultiEntities db = new VastwebmultiEntities();
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var reports = Model ?? Enumerable.Empty<Vastwebmulti.Models.passbyapidmt>();
    var rowCount = reports.Count();
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=42" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=27" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-passby-api-dmt-page.css?v=2" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ecommerce-history-page saas-passby-api-page">

    <div class="container-fluid vm-opr-page-shell">

        @using (Html.BeginForm("passbyapidmtsd", "Home", FormMethod.Post, new { id = "passbyApiForm" }))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">
                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line vm-gift-toolbar-one-line">

                    <!-- Breadcrumb -->
                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard","Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>User's &amp; Account</li>
                        <li>Pass By API DMT</li>
                    </ol>

                    <!-- Filter bar � dropdown + search on the right -->
                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--radiant vm-radiant-inline-filters vm-ecomm-filter-row--one-line vm-gift-filter-row--one-line" style="justify-content:flex-end;">

                        <div class="vm-opr-field vm-dmt-field" style="min-width:180px;flex:0 0 200px;">
                            @Html.DropDownList("allretailer", ViewBag.retailer as SelectList, "All Api User",
                                new { id = "allretailer", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div class="vm-dmt-filter-search-group">
                            <button type="submit" name="btntype" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>
            </div>
        }

        <!-- Main table card -->
        <div class="vm-opr-main-card vm-security-report-main-card vm-gift-report-main-card vm-pba-main-card">
            <div class="vm-opr-table-panel vm-security-report-table-panel vm-gift-report-table-panel">

                <!-- Card header -->
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head vm-security-report-table-head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-exchange-alt" aria-hidden="true"></i>
                        <span>Pass By API DMT � User Status</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong>@rowCount</strong>
                        </span>
                    </div>
                </div>

                <!-- Table -->
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table class="table vm-opr-data-table vm-pba-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th style="width:52px;text-align:center;">SR.</th>
                                    <th>API USER</th>
                                    <th style="width:120px;text-align:center;">STATUS</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!reports.Any())
                                {
                                    <tr>
                                        <td colspan="3" style="text-align:center;padding:40px 20px;color:#94a3b8;">
                                            <i class="fas fa-inbox" style="font-size:2rem;display:block;margin-bottom:8px;opacity:.4;"></i>
                                            No records found
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    var idx = 0;
                                    var sr = 1;
                                    foreach (var i in reports)
                                    {
                                        var apiUser = db.api_user_details.Where(s => s.apiid == i.userid).FirstOrDefault();
                                        var frmname = apiUser != null ? apiUser.farmname : i.userid;
                                        <tr>
                                            <td style="text-align:center;font-size:.72rem;font-weight:700;color:#94a3b8;">@sr</td>
                                            <td>
                                                <div class="vm-pba-user-cell">
                                                    <div class="vm-pba-user-avatar"><i class="fas fa-robot"></i></div>
                                                    <span class="vm-pba-user-name">@frmname</span>
                                                </div>
                                            </td>
                                            <td class="idchanges" style="text-align:center;">
                                                @if (i.status == true)
                                                {
                                                    <button type="button" class="vm-pba-sts-btn vm-pba-sts-btn--on"
                                                            onclick="stsupd('@i.userid', @idx, false)">
                                                        <i class="fas fa-toggle-on"></i> ON
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="button" class="vm-pba-sts-btn vm-pba-sts-btn--off"
                                                            onclick="stsupd('@i.userid', @idx, true)">
                                                        <i class="fas fa-toggle-off"></i> OFF
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                        idx++;
                                        sr++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>

    </div>
</section>

<script>
    $(document).ready(function () {
        $('#allretailer').select2({ width: '100%' });
    });

    function stsupd(u, i, s) {
        var $cell = $(document.getElementsByClassName('idchanges')[i]);
        var $btn = $cell.find('button');
        $btn.prop('disabled', true).css('opacity', '.6');

        $.ajax({
            url: '@Url.Action("passbyapiupdate", "Home")',
            type: 'POST',
            data: { userid: u, sts: s },
            cache: false,
            success: function (response) {
                if (response === 'OK') {
                    if (s === true) {
                        $cell.html(
                            '<button type="button" class="vm-pba-sts-btn vm-pba-sts-btn--on" onclick="stsupd(\'' + u + '\',' + i + ',false)">' +
                            '<i class="fas fa-toggle-on"></i> ON</button>'
                        );
                    } else {
                        $cell.html(
                            '<button type="button" class="vm-pba-sts-btn vm-pba-sts-btn--off" onclick="stsupd(\'' + u + '\',' + i + ',true)">' +
                            '<i class="fas fa-toggle-off"></i> OFF</button>'
                        );
                    }
                } else {
                    $btn.prop('disabled', false).css('opacity', '1');
                }
            },
            error: function () {
                $btn.prop('disabled', false).css('opacity', '1');
            }
        });
    }
</script>
