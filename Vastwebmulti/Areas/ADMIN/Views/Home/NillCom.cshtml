<!-- Select2: bootAdminSelect2 from admin layout -->
<script>
    function nillRefreshSelect($sel) {
        var $el = ($sel && $sel.jquery) ? $sel : $($sel);
        if (!$el.length) {
            return;
        }
        $el.next('.select2-container').remove();
        $el.removeClass('select2-hidden-accessible');
        $el.removeAttr('data-select2-id aria-hidden tabindex');
        if (typeof window.applyAdminSelect2 === "function") {
            window.applyAdminSelect2($el, { width: "100%", dropdownParent: $(document.body) }, true);
        } else         if ($.fn && $.fn.select2) {
            try { $el.select2("destroy"); } catch (e) { }
            $el.select2({ width: "100%", dropdownParent: $(document.body) });
        }
    }

    function nillFastSelect2($sel) {
        var $el = ($sel && $sel.jquery) ? $sel : $($sel);
        if (!$el.length || !$.fn || !$.fn.select2) {
            return;
        }
        if ($el.data("nillFastReady") && $el.hasClass("select2-hidden-accessible") && $el.next(".select2-container").length) {
            $el.next(".select2-container").css("width", "100%");
            return;
        }

        var items = $el.data("nillPortItems");
        if (!items) {
            items = [];
            $el.find("option").each(function () {
                var v = (this.value || "").toString();
                var t = ($(this).text() || "").toString();
                if (!v) {
                    return;
                }
                items.push({ id: v, text: t, textL: t.toLowerCase() });
            });
            $el.data("nillPortItems", items);
        }

        var placeholder = ($el.find("option[value='']").first().text() || "Select API/Port").toString();
        $el.empty().append($("<option></option>").attr("value", "").text(placeholder));
        $el.attr("data-admin-select2-custom", "true");

        try { $el.select2("destroy"); } catch (e) { }
        $el.removeClass("select2-hidden-accessible").next(".select2-container").remove();

        $el.select2({
            width: "100%",
            dropdownParent: $(document.body),
            placeholder: placeholder,
            allowClear: false,
            minimumInputLength: 0,
            ajax: {
                delay: 0,
                data: function (params) {
                    return { q: params.term || "", page: params.page || 1 };
                },
                transport: function (params, success, failure) {
                    try {
                        var q = String((params.data && params.data.q) || "").toLowerCase();
                        var page = parseInt((params.data && params.data.page) || 1, 10) || 1;
                        var size = 30;
                        var src = $el.data("nillPortItems") || [];
                        var list = src;
                        if (q) {
                            list = [];
                            for (var i = 0; i < src.length; i++) {
                                if (src[i].textL.indexOf(q) !== -1) {
                                    list.push(src[i]);
                                }
                            }
                        }
                        var start = (page - 1) * size;
                        success({
                            results: list.slice(start, start + size),
                            pagination: { more: (start + size) < list.length }
                        });
                    } catch (err) {
                        if (typeof failure === "function") {
                            failure();
                        }
                    }
                    return { abort: function () { } };
                },
                processResults: function (data) {
                    return data;
                }
            }
        });
        $el.data("nillFastReady", true);
        $el.next(".select2-container").css("width", "100%");
    }

    function nillParseOperatorRows(data) {
        if (!data) {
            return [];
        }
        if (typeof data === "string") {
            try { data = JSON.parse(data); } catch (e) { return []; }
        }
        if (data.d) {
            data = data.d;
        }
        if (data.Data && !$.isArray(data) && $.isArray(data.Data)) {
            data = data.Data;
        }
        if (!$.isArray(data)) {
            return [];
        }
        var rows = [];
        $.each(data, function (i, item) {
            if (item == null || typeof item !== "object") {
                return;
            }
            var val = item.Value != null ? item.Value : item.value;
            var txt = item.Text != null ? item.Text : item.text;
            if (val != null && val !== "" && txt != null && txt !== "") {
                rows.push({ Value: val, Text: txt });
            }
        });
        return rows;
    }

    function nillFillOperatorOptions($sel, data, placeholder, extraHtml) {
        var $el = ($sel && $sel.jquery) ? $sel : $($sel);
        var ph = placeholder || "Select Operator";
        var rows = nillParseOperatorRows(data);
        $el.empty().append($("<option></option>").attr("value", "").text(ph));
        if (extraHtml) {
            $el.append(extraHtml);
        }
        $.each(rows, function (i, item) {
            $el.append($("<option></option>").attr("value", item.Value).text(item.Text));
        });
        nillRefreshSelect($el);
    }

    function nillLoadOperatorsFromService(serviceSel, operatorSel, placeholder) {
        var $svc = $(serviceSel);
        var $op = $(operatorSel);
        var opname = ($svc.val() || "").toString().trim();
        var ph = placeholder || "Select Operator";
        $op.empty().append($("<option></option>").attr("value", "").text("Loading..."));
        nillRefreshSelect($op);
        if (!opname) {
            nillFillOperatorOptions($op, [], ph);
            return;
        }
        $.ajax({
            type: "POST",
            url: "@Url.Action("FillAllOperator", "Home")",
            dataType: "json",
            cache: false,
            data: { opname: opname },
            success: function (data) {
                nillFillOperatorOptions($op, data, ph);
            },
            error: function () {
                nillFillOperatorOptions($op, [], ph);
            }
        });
    }

    window.nillLoadLeftOperators = function () {
        nillLoadOperatorsFromService("#Operatorids", "#opnamelistbyid", "Select Operator");
    };

    window.nillLoadExtraOperators = function () {
        nillLoadOperatorsFromService("#extracommOperatorids", "#extracommopnamelistbyid", "Select Operator");
    };

    window.nillUsersUrl = "@Url.Action("FilluserBasedonTypes", "Home")";
    window.nillStatesUrl = "@Url.Action("FillAllStates", "Home")";

    window.nillLoadUsersFromType = function (typeSel, userSel) {
        var utype = ($(typeSel).val() || "").toString();
        var $op = $(userSel);
        if (!utype) {
            nillFillOperatorOptions($op, [], "Select User");
            return;
        }
        $op.empty().append($("<option></option>").attr("value", "").text("Loading..."));
        nillRefreshSelect($op);
        $.ajax({
            type: "POST",
            url: window.nillUsersUrl,
            dataType: "json",
            cache: false,
            data: { utype: utype },
            success: function (data) {
                nillFillOperatorOptions($op, data, "Select User");
            },
            error: function () {
                nillFillOperatorOptions($op, [], "Select User");
            }
        });
    };

    window.nillOnCircleFilterChange = function () {
        var filtertype = $("#ddlStatetypefilter").val() || "";
        var $dest = $("#ddlStateSwitchTypeSearch");
        if (filtertype === "Statewise") {
            $dest.empty().append($("<option></option>").attr("value", "").text("Loading..."));
            nillRefreshSelect($dest);
            $.ajax({
                type: "POST",
                url: window.nillStatesUrl,
                dataType: "json",
                cache: false,
                data: { utype: filtertype },
                success: function (data) {
                    $dest.empty().append($("<option></option>").attr("value", "").text("Please select States"));
                    $.each(data || [], function (i, item) {
                        var val = item.State_id != null ? item.State_id : (item.Value != null ? item.Value : item.value);
                        var txt = item.State_name != null ? item.State_name : (item.Text != null ? item.Text : item.text);
                        if (val != null && txt != null) {
                            $dest.append($("<option></option>").attr("value", val).text(txt));
                        }
                    });
                    nillRefreshSelect($dest);
                },
                error: function () {
                    nillFillOperatorOptions($dest, [], "Please select States");
                }
            });
        } else if (filtertype === "API" || filtertype === "Retailer") {
            nillLoadUsersFromType("#ddlStatetypefilter", "#ddlStateSwitchTypeSearch");
        } else if (filtertype) {
            nillLoadOperatorsFromService("#ddlStatetypefilter", "#ddlStateSwitchTypeSearch", "Please select Operator");
        } else {
            nillFillOperatorOptions($dest, [], "Please Select Switch");
        }
    };

    window.nillOnAmountFilterChange = function () {
        var filtertype = $("#ddlusertypefilter").val() || "";
        var $dest = $("#ddlSwitchTypeSearch");
        if (filtertype === "GetWaywise") {
            nillFillOperatorOptions($dest, [{ Value: "API", Text: "API" }, { Value: "Machine", Text: "Machine" }], "Switch To");
        } else if (filtertype === "API" || filtertype === "Retailer") {
            nillLoadUsersFromType("#ddlusertypefilter", "#ddlSwitchTypeSearch");
        } else if (filtertype) {
            nillLoadOperatorsFromService("#ddlusertypefilter", "#ddlSwitchTypeSearch", "Please select Operator");
        } else {
            nillFillOperatorOptions($dest, [], "Please Select Switch");
        }
    };

    window.nillOnOpFilterChange = function () {
        var filtertype = $("#ddlopusertypeSearch").val() || "";
        var $dest = $("#ddlopSwitchTypeSearch");
        if (filtertype === "GetWaywise") {
            nillFillOperatorOptions($dest, [{ Value: "API", Text: "API" }, { Value: "Machine", Text: "Machine" }], "Switch To");
        } else if (filtertype === "API" || filtertype === "Retailer") {
            nillLoadUsersFromType("#ddlopusertypeSearch", "#ddlopSwitchTypeSearch");
        } else if (filtertype) {
            nillLoadOperatorsFromService("#ddlopusertypeSearch", "#ddlopSwitchTypeSearch", "Please select Operator");
        } else {
            nillFillOperatorOptions($dest, [], "Please Select Switch");
        }
    };
</script>



