         let minamnts=$(txtminamnt).val()
        let maxamnts=  $(txtmaxamnt).val()
        let txtsscommextraamnt = $(txtcommextraamnt).val()
          $.ajax({
                type: 'POST',
             url: '@Url.Action("UpdateExtraCommisiondata", "Home")',
              data: { idno: idno, minamnts: minamnts, maxamnts: maxamnts, opcode: opcode, comm: txtsscommextraamnt },
             success: function (data) {
                 
                // $(clsshowdata).show()
