@model IEnumerable<Vastwebmulti.Models.closingbalance>
@using System
@using System.Linq
@using System.Collections.Generic
@using Vastwebmulti.Models
@{
    ViewBag.Title = "Show Opening Balance";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    VastwebmultiEntities db = new VastwebmultiEntities();

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var dateMode = Request.HttpMethod.Equals("POST", StringComparison.OrdinalIgnoreCase) ? "post" : "get";
    var selectedRetailer = (Request["allretailer"] ?? "").Trim();
    var reports = Model ?? Enumerable.Empty<closingbalance>();
    var rowCount = reports.Count();
    decimal totalBalance = reports.Sum(i => i.closingbalance1 ?? 0m);

    var retailerItems = (ViewBag.allretailer as SelectList)?.ToList() ?? new List<SelectListItem>();
    if (!string.IsNullOrEmpty(selectedRetailer))
    {
        foreach (var item in retailerItems)
        {
            item.Selected = string.Equals(item.Value, selectedRetailer, StringComparison.OrdinalIgnoreCase);
        }
    }
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=48" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=32" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-security-report-page saas-closing-balance-report-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var closingBalanceFormAttrs = new Dictionary<string, object>
            {
                { "id", "closingBalanceReportForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("Showclosingbalance", "Home", FormMethod.Post, closingBalanceFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line vm-gift-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Report's</li>
                        <li>Show Opening Balance</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters vm-ecomm-filter-row--one-line vm-gift-filter-row--one-line">

                        <div class="vm-opr-field vm-dmt-field vm-closing-balance-field--retailer">
                            @Html.DropDownList("allretailer", retailerItems, "All Retailer", new { id = "allretailer", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar" aria-hidden="true"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar" aria-hidden="true"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" name="btntype" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

            </div>
        }

        <div class="vm-opr-main-card vm-security-report-main-card vm-gift-report-main-card vm-closing-balance-report-main-card">
            <div class="vm-opr-table-panel vm-security-report-table-panel vm-gift-report-table-panel vm-closing-balance-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head vm-security-report-table-head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-balance-scale" aria-hidden="true"></i>
                        <span>Opening balance report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong id="closingBalanceRecordCount">@rowCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total" title="Total opening balance for current filter">
                            Total: <strong id="closingBalanceInlineTotal">? @totalBalance.ToString("N2")</strong>
                        </span>
                    </div>
                </div>

                <div class="vm-opr-table-wrap vm-closing-balance-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="closingBalanceReportTable" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Sr.</th>
                                    <th>User</th>
                                    <th>Dealer</th>
                                    <th>Master</th>
                                    <th>Opening&nbsp;Balance</th>
                                    <th>Date&nbsp;&amp;&nbsp;Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (rowCount == 0)
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="6">No records found for the selected filters.</td>
                                    </tr>
                                }
                                else
                                {
                                    var sr = 1;
                                    foreach (var item in reports)
                                    {
                                        var retailer = !string.IsNullOrWhiteSpace(item.userid)
                                            ? db.Retailer_Details.FirstOrDefault(s => s.RetailerId == item.userid)
                                            : null;
                                        var dealer = retailer != null
                                            ? db.Dealer_Details.FirstOrDefault(s => s.DealerId == retailer.DealerId)
                                            : null;
                                        var master = dealer != null
                                            ? db.Superstokist_details.FirstOrDefault(s => s.SSId == dealer.SSId)
                                            : null;

                                        var userFirm = retailer != null ? retailer.Frm_Name : "-";
                                        var userName = retailer != null ? retailer.RetailerName : "-";
                                        var dealerName = dealer != null ? dealer.FarmName : "-";
                                        var masterName = master != null ? master.FarmName : "-";
                                        var balance = item.closingbalance1 ?? 0m;
                                        var dateText = item.date.HasValue ? item.date.Value.ToString("dd-MM-yyyy HH:mm:ss") : "-";

                                        <tr class="vm-closing-balance-row" data-balance="@balance.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                            <td class="vm-closing-balance-sr">@sr</td>
                                            <td>
                                                <div class="vm-closing-balance-user">
                                                    <strong class="vm-closing-balance-user__firm">@userFirm</strong>
                                                    @if (!string.IsNullOrWhiteSpace(userName) && userName != "-")
                                                    {
                                                        <span class="vm-closing-balance-user__name">@userName</span>
                                                    }
                                                </div>
                                            </td>
                                            <td>@dealerName</td>
                                            <td>@masterName</td>
                                            <td class="vm-closing-balance-amount">? @balance.ToString("N2")</td>
                                            <td class="vm-closing-balance-date">@dateText</td>
                                        </tr>
                                        sr++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<script src="~/MainFrontDesign/select2/dist/js/select2.full.min.js"></script>

<script>
    function formatClosingBalanceAmount(value) {
        var num = parseFloat(value);
        if (isNaN(num)) {
            return '0.00';
        }
        return num.toFixed(2);
    }

    function refreshClosingBalanceSummary() {
        var rows = document.querySelectorAll('#closingBalanceReportTable tbody tr.vm-closing-balance-row');
        var total = 0;

        for (var i = 0; i < rows.length; i++) {
            var amount = parseFloat(rows[i].getAttribute('data-balance') || '0');
            if (!isNaN(amount)) {
                total += amount;
            }
        }

        $('#closingBalanceRecordCount').text(rows.length);
        $('#closingBalanceInlineTotal').text('? ' + formatClosingBalanceAmount(total));
    }

    function destroyClosingBalanceSelect2($el) {
        if ($el && $el.length && $el.data('select2')) {
            $el.select2('destroy');
        }
    }

    function applyClosingBalanceSelect2($el) {
        if (!$el || !$el.length || !$.fn.select2) {
            return;
        }
        destroyClosingBalanceSelect2($el);
        $el.select2({
            width: '100%',
            minimumResultsForSearch: 6
        });
    }

    function syncClosingBalanceSelectWidth() {
        var $field = $('.vm-closing-balance-field--retailer');
        $field.css({ width: '100%', maxWidth: '100%' });
        $('#allretailer').css({ width: '100%', maxWidth: '100%' });
        $('#closingBalanceReportForm .select2-container').css({ width: '100%', maxWidth: '100%' });
    }

    function initClosingBalanceSelect2() {
        applyClosingBalanceSelect2($('#allretailer'));
        window.setTimeout(syncClosingBalanceSelectWidth, 0);
        window.setTimeout(syncClosingBalanceSelectWidth, 120);
    }

    function initClosingBalanceDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initClosingBalanceDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm('#closingBalanceReportForm');
        }
    }

    $(document).ready(function () {
        initClosingBalanceSelect2();
        initClosingBalanceDatepickers();
        refreshClosingBalanceSummary();
        $(window).on('resize orientationchange', syncClosingBalanceSelectWidth);
    });
</script>
