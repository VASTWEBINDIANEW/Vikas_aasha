@model Vastwebmulti.Areas.ADMIN.Models.upiChargeAndgateway
@using System.Linq
@using System.Collections.Generic
@{
    var reports = Model.GATEWAYREPORT?.ToList() ?? new List<Vastwebmulti.Models.gateway_report_Result>();
    var rowCount = reports.Count;
    decimal? totalAmount = 0M;
    decimal? totalNet = 0M;
    decimal? totalPay = 0M;
    foreach (var item in reports)
    {
        totalAmount += item.amount ?? 0M;
        totalNet += item.finalpay ?? 0M;
        totalPay += item.totalpay ?? 0M;
    }
}

<table id="payUGatewayTable" class="table vm-opr-data-table" cellspacing="0">
    <thead>
        <tr>
            <th>S.No</th>
            <th>Role</th>
            <th>User</th>
            <th>Mode</th>
            <th>Mode</th>
            <th>Remain&nbsp;Pre</th>
            <th>Amount</th>
            <th>Charges</th>
            <th>Pay</th>
            <th>Net&nbsp;Received</th>
            <th>Remain&nbsp;Post</th>
            <th>Bank&nbsp;RRN</th>
            <th>PayU&nbsp;ID</th>
            <th>Txn.&nbsp;Time</th>
            <th>Settlement</th>
            <th>Response&nbsp;Time</th>
        </tr>
    </thead>
    <tbody>
        @if (rowCount == 0)
        {
            <tr class="vm-opr-table-empty-row">
                <td colspan="16" class="vm-opr-table-empty vm-dmt-table-empty">
                    <i class="fas fa-credit-card" aria-hidden="true"></i>
                    <span>No payment gateway records found.</span>
                </td>
            </tr>
        }
        else
        {
            var srIndex = 0;
            foreach (var item in reports)
            {
                srIndex++;
                var frmname = string.IsNullOrWhiteSpace(item.Frm_Name) ? item.RetailerName : item.Frm_Name;
                var txnTime = item.f_date.HasValue ? item.f_date.Value.ToString("yyyy-MM-dd HH:mm:ss") : "—";
                var respTime = item.resptime.HasValue ? item.resptime.Value.ToString("yyyy-MM-dd HH:mm:ss") : "—";
                var isPending = string.Equals(item.status, "Pending", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(item.status, "PENDING", StringComparison.OrdinalIgnoreCase);
                var statusBadge = item.status ?? "";
                if (string.Equals(statusBadge, "Rejected", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(statusBadge, "REJECTED", StringComparison.OrdinalIgnoreCase))
                {
                    statusBadge = "Failed";
                }

                var bankRrn = item.bankrrnno;
                if (!string.Equals(statusBadge, "Success", StringComparison.OrdinalIgnoreCase)
                    && !string.Equals(statusBadge, "SUCCESS", StringComparison.OrdinalIgnoreCase))
                {
                    bankRrn = string.IsNullOrWhiteSpace(item.errormsg) ? item.bankrrnno : item.errormsg;
                }

                var rowClass = "vm-pay-gateway-report-row";
                if (string.Equals(statusBadge, "Success", StringComparison.OrdinalIgnoreCase) || string.Equals(statusBadge, "SUCCESS", StringComparison.OrdinalIgnoreCase))
                {
                    rowClass += " vm-pay-gateway-report-row--success";
                }
                else if (isPending)
                {
                    rowClass += " vm-pay-gateway-report-row--pending";
                }
                else if (string.Equals(statusBadge, "Failed", StringComparison.OrdinalIgnoreCase) || string.Equals(statusBadge, "FAILED", StringComparison.OrdinalIgnoreCase))
                {
                    rowClass += " vm-pay-gateway-report-row--failed";
                }

                <tr class="@rowClass">
                    <td class="vm-dmt-sr-cell">@srIndex</td>
                    <td>@item.roles</td>
                    <td class="vm-pg-user-cell-wrap">
                        <div class="vm-pg-user-cell">
                            <strong>@frmname</strong>
                        </div>
                    </td>
                    <td class="vm-pg-mode-cell-wrap">
                        @Html.Partial("_ReportStatusBadge", statusBadge)
                        <span class="vm-pg-mode-name">@item.mode</span>
                    </td>
                    <td>@item.PG_TYPE</td>
                    <td class="vm-pg-num-cell">@item.remainpre</td>
                    <td class="vm-pg-num-cell">@item.amount</td>
                    <td class="vm-pg-num-cell">@item.charge</td>
                    <td class="vm-pg-num-cell">@item.finalpay</td>
                    <td class="vm-pg-num-cell">@item.totalpay</td>
                    <td class="vm-pg-num-cell">@item.remainpost</td>
                    <td>@bankRrn</td>
                    <td>@item.payuMoneyId</td>
                    <td>@txnTime</td>
                    <td class="vm-pg-settlement-cell">
                        @if (item.issettled == true)
                        {
                            <span class="vm-pg-settled-text">Settled</span>
                        }
                        else
                        {
                            <span class="vm-pg-unsettled-text">Not Settled</span>
                        }
                    </td>
                    <td class="vm-pg-action-cell">
                        @if (isPending)
                        {
                            <button type="button" class="vm-pg-status-check-btn" onclick="Statuschk('@item.txnid')" title="Check payment status">
                                <i class="fas fa-sync-alt" aria-hidden="true"></i>
                                <span>Status Check</span>
                            </button>
                        }
                        else
                        {
                            @respTime
                        }
                    </td>
                </tr>
            }

            <tr class="vm-pg-totals-row">
                <td colspan="6">TOTAL</td>
                <td class="vm-pg-num-cell">@totalAmount</td>
                <td></td>
                <td class="vm-pg-num-cell">@totalNet</td>
                <td class="vm-pg-num-cell">@totalPay</td>
                <td colspan="6"></td>
            </tr>
        }
    </tbody>
</table>
