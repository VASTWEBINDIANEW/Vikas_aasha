@model IEnumerable<Vastwebmulti.Areas.ADMIN.Models.RadiantPrepayReportVM>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Radiant Prepay";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var selectedStatus = (Request["Status"] ?? "").Trim();
    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
    var reports = Model ?? Enumerable.Empty<Vastwebmulti.Areas.ADMIN.Models.RadiantPrepayReportVM>();
    var rowCount = reports.Count();

    var totalAmount = ViewBag.total != null ? Convert.ToDecimal(ViewBag.total) : 0m;
    var totalSuccess = ViewBag.totalSuccess != null ? Convert.ToDecimal(ViewBag.totalSuccess) : 0m;
    var totalFailed = ViewBag.totalFailed != null ? Convert.ToDecimal(ViewBag.totalFailed) : 0m;
    var totalPending = ViewBag.totalPending != null ? Convert.ToDecimal(ViewBag.totalPending) : 0m;
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=15" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<script src="~/MainFrontDesign/js/admin-financial-report.js?v=18"></script>

<div id="loadermoney" class="vm-dmt-loader" style="display:none;"></div>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var radiantFormAttrs = new Dictionary<string, object>
            {
                { "id", "radiantPrepayForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("RadiantPrepay", "Home", FormMethod.Post, radiantFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Trans. Reports</li>
                        <li>Radiant Prepay Report</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters">

                        <div class="vm-opr-field vm-dmt-field vm-radiant-field--retailer">
                            @Html.DropDownList("allretailer", ViewBag.allretailer as SelectList, "All Retailer", new { id = "allretailer", @class = "vm-opr-select vm-dmt-select form-control", @title = "Retailer" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-radiant-field--status">
                            @Html.DropDownList("Status", new SelectList(new[]
                            {
                                new SelectListItem { Text = "All Status", Value = "" },
                                new SelectListItem { Text = "Pending", Value = "Pending" },
                                new SelectListItem { Text = "Success", Value = "Success" },
                                new SelectListItem { Text = "Failed", Value = "Failed" }
                            }, "Value", "Text", selectedStatus), new { id = "Status", @class = "vm-opr-select vm-dmt-select form-control", @title = "Status" })
                        </div>

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="radiantPrepayTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Radiant prepay totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideRadiantPrepayTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--primary">
                            <span class="vm-opr-total-card__label">Total Amount</span>
                            <strong class="vm-opr-total-card__value" id="radiantTotalAmount">@totalAmount.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Success</span>
                            <strong class="vm-opr-total-card__value" id="radiantSuccessAmount">@totalSuccess.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Failed</span>
                            <strong class="vm-opr-total-card__value" id="radiantFailedAmount">@totalFailed.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Pending</span>
                            <strong class="vm-opr-total-card__value" id="radiantPendingAmount">@totalPending.ToString("N2")</strong>
                        </div>
                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-wallet" aria-hidden="true"></i>
                        <span>Radiant prepay report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-inline-total" title="Total amount for current filter">
                            Total: <strong>&#8377; @totalAmount.ToString("N2")</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-radiant-totals-btn" onclick="findtotalRadiantPrepay()" title="Show totals" aria-expanded="false" aria-controls="radiantPrepayTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnRadiantExcel" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnRadiantPdf" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="radiantPrepayReport" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Firm&nbsp;Name</th>
                                    <th>RCEID</th>
                                    <th>Amount&nbsp;&#8377;</th>
                                    <th>Remain&nbsp;Pre&nbsp;&#8377;</th>
                                    <th>Remain&nbsp;Post&nbsp;&#8377;</th>
                                    <th>Request&nbsp;ID</th>
                                    <th>Insert&nbsp;Date</th>
                                    <th>Update&nbsp;Date</th>
                                    <th>Status</th>
                                    <th>#</th>
                                </tr>
                            </thead>
                            <tbody id="radiantPrepayReportRows">
                                @Html.Partial("_RadiantPrepayRows", reports)
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<script src="~/MainFrontDesign/select2/dist/js/select2.full.min.js"></script>
<script src="~/Swalalert/sweetalert-dev.js"></script>

<script>
    window.radiantPrepayBaseUrl = '@Url.Action("RadiantPrepay", "Home")';

    function formatRadiantAmount(value) {
        var num = parseFloat(value);
        if (isNaN(num)) {
            return '0.00';
        }
        return num.toFixed(2);
    }

    function buildRadiantPrepayExportQuery() {
        return 'txt_frm_date=' + encodeURIComponent($('#txt_frm_date').val())
            + '&txt_to_date=' + encodeURIComponent($('#txt_to_date').val())
            + '&Status=' + encodeURIComponent($('#Status').val() || '')
            + '&allretailer=' + encodeURIComponent($('#allretailer').val() || '');
    }

    function downloadRadiantPrepayExport(type) {
        var url = window.radiantPrepayBaseUrl + '?export=' + encodeURIComponent(type) + '&' + buildRadiantPrepayExportQuery();
        if (type === 'pdf') {
            window.open(url, '_blank');
            return;
        }
        var frame = document.getElementById('radiantPrepayExportFrame');
        if (!frame) {
            frame = document.createElement('iframe');
            frame.id = 'radiantPrepayExportFrame';
            frame.style.display = 'none';
            document.body.appendChild(frame);
        }
        frame.src = url;
    }

    function applyRadiantTotalsToPanel(data) {
        if (!data) {
            return;
        }
        $('#radiantTotalAmount').text(formatRadiantAmount(data.total));
        $('#radiantSuccessAmount').text(formatRadiantAmount(data.success));
        $('#radiantFailedAmount').text(formatRadiantAmount(data.failed));
        $('#radiantPendingAmount').text(formatRadiantAmount(data.pending));
        $('.vm-radiant-inline-total strong').text('\u20B9 ' + formatRadiantAmount(data.total));
    }

    function findtotalRadiantPrepay() {
        var panel = $('#radiantPrepayTotalsPanel');
        var btn = $('.vm-radiant-totals-btn');
        if (panel.is(':visible')) {
            hideRadiantPrepayTotals();
            return;
        }

        $('#loadermoney').show();
        $.get(window.radiantPrepayBaseUrl + '?export=total&' + buildRadiantPrepayExportQuery())
            .done(function (data) {
                applyRadiantTotalsToPanel(data);
                panel.slideDown(180).attr('aria-hidden', 'false');
                btn.attr('aria-expanded', 'true');
            })
            .fail(function () {
                if (typeof swal === 'function') {
                    swal('Oops!', 'Unable to load Radiant prepay totals.', 'error');
                }
            })
            .always(function () {
                $('#loadermoney').hide();
            });
    }

    function hideRadiantPrepayTotals() {
        $('#radiantPrepayTotalsPanel').slideUp(180).attr('aria-hidden', 'true');
        $('.vm-radiant-totals-btn').attr('aria-expanded', 'false');
    }

    $(document).on('click', '.btn-status', function () {
        var button = $(this);
        var id = button.data('id');
        var status = button.data('status');
        var row = button.closest('tr');

        var confirmFn = function (callback) {
            if (typeof swal === 'function') {
                swal({
                    title: 'Update status?',
                    text: 'Mark this request as ' + status + '?',
                    type: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, update',
                    cancelButtonText: 'Cancel',
                    closeOnConfirm: true
                }, callback);
            } else if (confirm('Are you sure you want to mark this as ' + status + '?')) {
                callback();
            }
        };

        confirmFn(function () {
            $('#loadermoney').show();
            $.ajax({
                url: '@Url.Action("UpdatePrepayStatus", "Home")',
                type: 'POST',
                data: { id: id, status: status },
                success: function (response) {
                    $('#loadermoney').hide();
                    if (response && response.success) {
                        var tone = status === 'Success' ? 'success' : 'failed';
                        var icon = status === 'Success' ? 'fa-check' : 'fa-times';
                        row.removeClass('vm-dmt-row--pending').addClass('vm-dmt-row--' + tone);
                        row.attr('data-status', status);
                        row.find('.vm-radiant-status-cell .vm-dmt-status')
                            .removeClass('vm-dmt-status--pending')
                            .addClass('vm-dmt-status--' + tone)
                            .find('i').attr('class', 'fa ' + icon);
                        row.find('.vm-radiant-status-text').text(status);
                        row.find('.btn-status').prop('disabled', true).addClass('is-disabled');

                        if (typeof swal === 'function') {
                            swal('Updated', 'Status updated successfully.', 'success');
                        }
                    } else {
                        var msg = (response && response.message) ? response.message : 'Unable to update status.';
                        if (typeof swal === 'function') {
                            swal('Oops!', msg, 'error');
                        } else {
                            alert(msg);
                        }
                    }
                },
                error: function () {
                    $('#loadermoney').hide();
                    if (typeof swal === 'function') {
                        swal('Oops!', 'Something went wrong. Please try again.', 'error');
                    } else {
                        alert('Something went wrong. Please try again.');
                    }
                }
            });
        });
    });

    $(document).ready(function () {
        var sts = '@TempData["Status"]';
        var msg = '@TempData["Message"]';
        if (sts && msg && typeof swal === 'function') {
            swal('Oops..', msg, 'error');
        }

        $('#btnRadiantExcel').on('click', function () { downloadRadiantPrepayExport('excel'); });
        $('#btnRadiantPdf').on('click', function () { downloadRadiantPrepayExport('pdf'); });

        $('#allretailer, #Status').select2({
            width: '100%',
            minimumResultsForSearch: 6
        });

        function initRadiantDatepickers() {
            if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
                window.setTimeout(initRadiantDatepickers, 50);
                return;
            }
            if (typeof window.initAdminReportDateForm === 'function') {
                window.initAdminReportDateForm('#radiantPrepayForm');
            }
        }
        initRadiantDatepickers();
    });
</script>
