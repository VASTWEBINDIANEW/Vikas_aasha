@model Vastwebmulti.Areas.ADMIN.Models.CashDepositeAndBank_Info_VM
@if (Model.msg != "DONE")
{
    <div class="cdc-slab-msg cdc-slab-msg--error">@Model.msg</div>
}
<table class="table table-bordered wallet-bank-input cdc-slab-table">
    <thead>
        <tr>
            <th>Min&nbsp;Amt</th>
            <th>Max&nbsp;Amt</th>
            <th>IMPS&nbsp;Fee</th>
            <th>NEFT&nbsp;Fee</th>
            <th class="cdc-col-actions">Del</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.WulChargeList != null && Model.WulChargeList.Count > 0)
        {
            foreach (var item in Model.WulChargeList.OrderBy(x => x.AmtFromTatkal))
            {
                <tr>
                    <td style="display:none;"><input type="text" value="@item.Idno" readonly="readonly" /></td>
                    <td style="display:none;"><input type="text" value="@item.UserRole" readonly="readonly" /></td>
                    <td><input type="text" value="@item.AmtFromTatkal" readonly="readonly" /></td>
                    <td><input type="text" value="@item.AmtToTatkal" readonly="readonly" /></td>
                    <td><input type="text" value="@item.chargeTatkal" readonly="readonly" /></td>
                    <td><input type="text" value="@item.chargeTatkalNEFT" readonly="readonly" /></td>
                    <td class="cdc-table-actions">
                        <div class="cdc-table-actions__group">
                            <button type="button" class="cdc-table-action cdc-table-action--delete deleteCharged1" title="Delete row" aria-label="Delete row">
                                <i class="fas fa-trash-alt" aria-hidden="true"></i>
                            </button>
                            <button type="button" onclick="DeleteChrg('@item.Idno','@item.UserRole')" class="cdc-table-action cdc-table-action--confirm deleteCharge" title="Confirm delete" aria-label="Confirm delete">
                                <i class="fas fa-check" aria-hidden="true"></i><span>Sure?</span>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr class="cdc-empty-row">
                <td colspan="5">No charge slabs found.</td>
            </tr>
        }
    </tbody>
</table>
