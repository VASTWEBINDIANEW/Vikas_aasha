    }

    function checkStaus(txnid) {
        $.ajax({
            url: '@Url.Action("AepsStatus", "Home")',
            type: 'POST',
            dataType: "json",
            data: { txnid: txnid },
            success: function (data) {
                var response = JSON.parse(data);
                ToastrMessage();
                if (response.Status == "Success") {
                    toastr.success(response.Message);
                } else {
                    toastr.error(response.Message + ' !');
                }
            }
        });
    }

    function ToastrMessage() {
        toastr.options = {
            "closeButton": false,
            "positionClass": "toast-top-right1",
            "progressBar": true,
            "timeOut": "5000"
        };
    }

    $(document).ready(function () {
        $('#txt_frm_date, #txt_to_date').datepicker({
            format: "yyyy-mm-dd",
            todayHighlight: true,
            autoclose: true,
            orientation: "bottom auto"
        });
        var val = '@ViewBag.chk';
        if (val != "post") {
            $("#txt_frm_date").datepicker("setDate", new Date());
            $("#txt_to_date").datepicker("setDate", new Date());
        }
        answers();
    });

    $(function () {
        if (window.location.href.indexOf('/ADMIN/Home/AepsReport') !== -1) {
            $('.sidebar .kkli li:nth-child(2) a').addClass('activee');
        }
    });
</script>
