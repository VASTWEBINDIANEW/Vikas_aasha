<script src="~/AdminDesign/plugins/bootstrap-select/js/bootstrap-select.js"></script>
<script src="~/Swalalert/sweetalert-dev.js"></script>
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />

<script>
    function hideAepsTotals() {
        var $panel = $('#aepsTotalsPanel');
        var $btn = $('.vm-aeps-totals-btn');
        $panel.removeClass('is-open').hide().attr('aria-hidden', 'true');
        $btn.removeClass('is-active').attr({ title: 'Show totals', 'aria-expanded': 'false' });
    }

    function findtotalaeps() {
        var $panel = $('#aepsTotalsPanel');
        var $btn = $('.vm-aeps-totals-btn');

        if ($panel.hasClass('is-open')) {
            hideAepsTotals();
            return;
        }

        var ddlusers = $('#ddlusers').val();
        var allmaster = $('#allmaster1').val();
        var alldealer = $('#alldealer').val();
        var allretailer = $('#allretailer').val();
        var allwhitelabel = $('#allwhitelabel1').val();
        var ddl_status = $('#ddl_status').val();
        var api_name = $('#api_name').val() || '';
        var ddl_settletype = $('#ddl_settletype').val();
        var txt_frm_date = $('#txt_frm_date').val();
        var txt_to_date = $('#txt_to_date').val();

        $panel.addClass('is-open').show().attr('aria-hidden', 'false');
        $btn.addClass('is-active').attr({ title: 'Hide totals', 'aria-expanded': 'true' });

        $.post("@Url.Action("AepsReport_Total", "Home")",
            { "ddlusers": ddlusers, "allmaster1": allmaster, "alldealer": alldealer, "allretailer": allretailer, "allwhitelabel1": allwhitelabel, "ddl_status": ddl_status, "api_name": api_name, "ddl_settletype": ddl_settletype, "txt_frm_date": txt_frm_date, "txt_to_date": txt_to_date },
            function (data) {
                $('#successtotal').text("\u20B9 " + data.success);
                $('#Failedtotal').text("\u20B9 " + data.failed);
                $('#Pendingtotal').text("\u20B9 " + data.pending);
            });
    }

    function mdActionBtn(idno) {
        $('#loadredmodel').show();
        $.ajax({
            url: '@Url.Action("AepsReport_View", "Home")',
            type: "POST",
            data: { idno: idno },
            cache: false,
            success: function (Response) {
                $("#Admincomm").val(Response[0].AdminIncome);
                $("#Mdcomm").val(Response[0].MdIncome);
                $("#DlmComm").val(Response[0].DlmIncome);
                $("#AdminPre").val(Response[0].AdminPre);
                $("#AdminPost").val(Response[0].AdminPost);
                $("#MdPre").val(Response[0].MdPre);
                $("#MdPost").val(Response[0].MdPost);
                $("#DlmPre").val(Response[0].DlmPre);
                $("#DlmPost").val(Response[0].DlmPost);
                $("#MerchantTxnId").val(Response[0].MerchantTxnId);
                $("#aepsDetailTxn").text(Response[0].MerchantTxnId || '');
            },
            complete: function () {
                $('#loadredmodel').hide();
            }
        });
    }

    var pageindex = 2;
    var NoMoredata = false;
    var inProgress = false;
    $(window).scroll(function () {
        var ddlusers = $('#ddlusers').val();
        var allmaster = $('#allmaster1').val();
        var alldealer = $('#alldealer').val();
        var allretailer = $('#allretailer').val();
        var allwhitelabel = $('#allwhitelabel1').val();
        var ddl_status = $('#ddl_status').val();
        var api_name = $('#api_name').val() || '';
        var ddl_settletype = $('#ddl_settletype').val();
        var txt_frm_date = $('#txt_frm_date').val();
        var txt_to_date = $('#txt_to_date').val();
        if ($(window).scrollTop() > Number($("#Aeps").height()) / 4 && !NoMoredata && !inProgress) {
            inProgress = true;
            $("#loadingdiv").show();
            $.post("@Url.Action("InfiniteScroll_Aeps", "Home")",
                { "pageindex": pageindex, "ddlusers": ddlusers, "allmaster1": allmaster, "alldealer": alldealer, "allretailer": allretailer, "allwhitelabel1": allwhitelabel, "ddl_status": ddl_status, "api_name": api_name, "ddl_settletype": ddl_settletype, "txt_frm_date": txt_frm_date, "txt_to_date": txt_to_date },
                function (data) {
                    pageindex = pageindex + 1;
                    NoMoredata = data.NoMoredata;
                    $("#trow").append(data.HTMLString);
                    $("#loadingdiv").hide();
                    inProgress = false;
                    if (window.vmAepsRenumberSr) {
                        window.vmAepsRenumberSr();
                    }
                });
        }
    });

