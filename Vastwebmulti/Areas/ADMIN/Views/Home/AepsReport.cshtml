    function success() {
        var bankrrn = $('#BankRRN').val();
        var trans_id = $('#trans_id').val();
        var Remark = $('#Remark').val();
        if (bankrrn == null || bankrrn == '') {
            swal("RRN?", 'Hit check status to update RRN first.', "error");
            return false;
        }
        var answer = confirm('Are you sure ?');
        if (answer) {
            $.ajax({
                url: '@Url.Action("AEPSsucess", "Home")',
                type: 'POST',
                dataType: "html",
                data: { trans_id: trans_id, RRN: bankrrn, terminalID: '', Remark: Remark },
                success: function (data) {
                    var response = JSON.parse(data);
                    if (response.Status) {
                        swal("Good Job", response.Message, "success");
                        window.location.reload();
                    } else {
                        swal("Oops...", response.Message, "error");
                    }
                }
            });
            return true;
        }
        $("#defaultModal2").modal('hide');
        return false;
    }

    function refundshow(trans_id, mobile) {
        $("#txtrefidno").val(trans_id);
        $("#mobile").val(mobile);
    }

    function Failed() {
        var answer = confirm('Are you sure ?');
        if (answer) {
            var secuirtypass = $("#securitypass").val();
            var id = $("#txtrefidno").val();
            var mobile = $("#mobile").val();
            var e = document.getElementById("ddl_refund");
            var ddlval = e.options[e.selectedIndex].value;
            if (secuirtypass != "" && secuirtypass != null) {
                $.ajax({
                    url: '@Url.Action("AepsFailed", "Home")',
                    type: 'POST',
                    dataType: "html",
                    data: { txtrefidno: id, mobile: mobile, ddl_refund: ddlval, secuirtypass: secuirtypass },
                    success: function (data) {
                        var response = JSON.parse(data);
                        if (response.Status) {
                            swal("Good Job!", response.Message, "success");
                            window.location.reload();
                        } else {
                            swal("Oops...", response.Message, "error");
                        }
                    }
                }).done(function () {
                    $("#defaultModal1").modal('hide');
                });
                return true;
            }
            swal("Oops..!", "Please Enter security Password", "error");
            return false;
        }
        $("#defaultModal1").modal('hide');
        return false;
    }

    function answers() {
        var e = document.getElementById("ddlusers");
        var answer = e.options[e.selectedIndex].value;
        var fields = ["allwhitelabel", "allmaster", "dlm", "rem", "apiid"];
        fields.forEach(function (id) {
            document.getElementById(id).style.display = "none";
        });
        if (answer == "Dealer") {
            document.getElementById("dlm").style.display = "block";
        } else if (answer == "Whitelabel") {
            document.getElementById("allwhitelabel").style.display = "block";
        } else if (answer == "Master") {
            document.getElementById("allmaster").style.display = "block";
        } else if (answer == "Retailer") {
            document.getElementById("rem").style.display = "block";
        } else if (answer == "APIID") {
            document.getElementById("apiid").style.display = "block";
        }
    }

    function setTxnValue(idno) {
        $.ajax({
            url: '@Url.Action("AepsReport_View", "Home")',
            type: "POST",
            data: { idno: idno },
            cache: false,
            success: function (Response) {
                $("#BankRRN").val(Response[0].BankRRN);
                $("#trans_id").val(Response[0].MerchantTxnId);
                $("#Remark").val(Response[0].Remark);
            }
        });
    }

    function Failedtosuccess(idno) {
        $.ajax({
            url: '@Url.Action("AepsReport_View", "Home")',
            type: "POST",
            data: { idno: idno },
            cache: false,
            success: function (Response) {
                $("#BankRRN").val(Response[0].BankRRN);
