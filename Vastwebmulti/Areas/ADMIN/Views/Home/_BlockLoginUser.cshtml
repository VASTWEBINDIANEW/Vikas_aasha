@model List<Vastwebmulti.Areas.ADMIN.Models.BlockUserlistmodel>

@if (Model != null)
{
    int i = 0;
    if (ViewBag.role == "Dealer")
    {
        foreach (var item in Model)
        {
            <tr class="tr wl-manage-row">
                <td>@item.Frmname</td>
                <td>@item.MOBILE</td>
                <td class="wl-perm-col">
                    <div class="wl-perm-actions">
                    @if (item.sts == "Y" && item.apploginsts == "Y" && item.NetOFFR == "Y")
                    {
                        <div id="btnhide_@i" class="wl-perm-action">
                            <button type="button" value="BOTH LOGIN ON" class="wl-perm-btn wl-perm-btn--both-on btn has-spinner" onclick="StatusActive(@i,'@item.Userid', '@item.ROLES','OFF','@item.NetOFFR')">
                                <i class="fas fa-check-double"></i> Both Login ON
                            </button>
                        </div>
                        <div id="btnshow_@i" class="wl-perm-action wl-perm-action--loading" style="display:none;">
                            <button type="button" class="wl-perm-btn wl-perm-btn--loading btn has-spinner"><i class="fa fa-circle-o-notch fa-spin"></i></button>
                        </div>
                    }
                    else if (item.sts == "N" && item.apploginsts == "N" && item.NetOFFR == "Y")
                    {
                        <div id="btnhide_@i" class="wl-perm-action">
                            <button type="button" value="LOGIN OFF" class="wl-perm-btn wl-perm-btn--off btn has-spinner" onclick="StatusActive(@i,'@item.Userid', '@item.ROLES','WEB','@item.NetOFFR')">
                                <i class="fas fa-power-off"></i> Self Login OFF
                            </button>
                        </div>
                        <div id="btnshow_@i" class="wl-perm-action wl-perm-action--loading" style="display:none;">
                            <button type="button" class="wl-perm-btn wl-perm-btn--loading btn has-spinner"><i class="fa fa-circle-o-notch fa-spin"></i></button>
                        </div>
                    }
                    else if (item.sts == "Y" && item.NetOFFR == "Y")
                    {
                        <div id="btnhide_@i" class="wl-perm-action">
                            <button type="button" value="ONLY WEB LOGIN" class="wl-perm-btn wl-perm-btn--web btn has-spinner" onclick="StatusActive(@i,'@item.Userid', '@item.ROLES','APP','@item.NetOFFR')">
                                <i class="fas fa-globe"></i> Only Web Login
                            </button>
                        </div>
                        <div id="btnshow_@i" class="wl-perm-action wl-perm-action--loading" style="display:none;">
                            <button type="button" class="wl-perm-btn wl-perm-btn--loading btn has-spinner"><i class="fa fa-circle-o-notch fa-spin"></i></button>
                        </div>
                    }
                    else if (item.apploginsts == "Y" && item.NetOFFR == "Y")
                    {
                        <div id="btnhide_@i" class="wl-perm-action">
                            <button type="button" value="ONLY APP LOGIN" class="wl-perm-btn wl-perm-btn--app btn has-spinner" onclick="StatusActive(@i,'@item.Userid', '@item.ROLES','BOTHOFF','@item.NetOFFR')">
                                <i class="fas fa-mobile-alt"></i> Only App Login
                            </button>
                        </div>
                        <div id="btnshow_@i" class="wl-perm-action wl-perm-action--loading" style="display:none;">
                            <button type="button" class="wl-perm-btn wl-perm-btn--loading btn has-spinner"><i class="fa fa-circle-o-notch fa-spin"></i></button>
                        </div>
                    }
                    else if (item.sts == "N" && item.apploginsts == "N" && item.NetOFFR == "N")
                    {
                        <div id="btnhide_@i" class="wl-perm-action">
                            <button type="button" value="Net OFF" class="wl-perm-btn wl-perm-btn--netoff btn has-spinner" onclick="StatusActive(@i,'@item.Userid', '@item.ROLES','BOTH','@item.NetOFFR')">
                                <i class="fas fa-wifi"></i> All Network OFF
                            </button>
                        </div>
                        <div id="btnshow_@i" class="wl-perm-action wl-perm-action--loading" style="display:none;">
                            <button type="button" class="wl-perm-btn wl-perm-btn--loading btn has-spinner"><i class="fa fa-circle-o-notch fa-spin"></i></button>
                        </div>
                    }

                    @if (item.Block == "Y")
                    {
                        <div id="btnhidecheck_@i" class="wl-perm-action attemptblock-first">
                            <button type="button" class="wl-attempt-btn btn has-spinner" onclick="unblockUser(@i,'@item.Userid', '@item.ROLES')">
                                <i class="fas fa-ban"></i>
                                <span class="wl-attempt-btn__text"><strong>Attempt Blocked</strong><small>Click to activate</small></span>
                            </button>
                        </div>
                        <div id="btnshowclick_@i" class="wl-perm-action wl-perm-action--loading" style="display:none;">
                            <button type="button" class="wl-perm-btn wl-perm-btn--loading btn has-spinner"><i class="fa fa-circle-o-notch fa-spin"></i></button>
                        </div>
                    }
                    </div>
                </td>
                <td class="wl-city-col set-city-up">
                    @if (item.userlocationlistbyid.Count() > 0)
                    {
                        <div class="wl-city-cell">
                            <ul class="wl-city-chips set-city-show">
                                @foreach (var itemasdsad in item.userlocationlistbyid)
                                {
                                    <li><span class="wl-city-chip">@itemasdsad</span></li>
                                }
                                <li>
                                    <button type="button" class="wl-city-edit-btn" title="Edit City"
                                            onclick="EditLocation(this, '@item.ROLES', '@item.Userid'),ViewDetailsByID('@item.Userid', '@item.ROLES')">
                                        <i class="fas fa-pen"></i>
                                    </button>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <button type="button" class="wl-fetch-city-btn"
                                onclick="GetLoginCityName(this, '@item.ROLES', '@item.Userid'),ViewDetailsByID('@item.Userid', '@item.ROLES')">
                            <i class="fas fa-map-marker-alt"></i> Fetch City
                        </button>
                    }
                </td>
            </tr>
            i++;
        }
    }
    else
    {
        foreach (var item in Model)
        {
            <tr class="tr wl-manage-row">
                <td>@item.Frmname</td>
                <td>@item.MOBILE</td>
                <td class="wl-perm-col">
                    <div class="wl-perm-actions">
                    @if (item.sts == "Y" && item.apploginsts == "Y")
                    {
                        <div id="btnhide_@i" class="wl-perm-action">
                            <button type="button" value="BOTH LOGIN ON" class="wl-perm-btn wl-perm-btn--both-on btn has-spinner" onclick="StatusActive(@i,'@item.Userid', '@item.ROLES','OFF')">
                                <i class="fas fa-check-double"></i> Both Login ON
                            </button>
                        </div>
                        <div id="btnshow_@i" class="wl-perm-action wl-perm-action--loading" style="display:none;">
                            <button type="button" class="wl-perm-btn wl-perm-btn--loading btn has-spinner"><i class="fa fa-circle-o-notch fa-spin"></i></button>
                        </div>
                    }
                    else if (item.sts == "N" && item.apploginsts == "N")
                    {
                        <div id="btnhide_@i" class="wl-perm-action">
                            <button type="button" value="LOGIN OFF" class="wl-perm-btn wl-perm-btn--off btn has-spinner" onclick="StatusActive(@i,'@item.Userid', '@item.ROLES','WEB')">
                                <i class="fas fa-power-off"></i> Both Login OFF
                            </button>
                        </div>
                        <div id="btnshow_@i" class="wl-perm-action wl-perm-action--loading" style="display:none;">
                            <button type="button" class="wl-perm-btn wl-perm-btn--loading btn has-spinner"><i class="fa fa-circle-o-notch fa-spin"></i></button>
                        </div>
                    }
                    else if (item.sts == "Y")
                    {
                        <div id="btnhide_@i" class="wl-perm-action">
                            <button type="button" value="ONLY WEB LOGIN" class="wl-perm-btn wl-perm-btn--web btn has-spinner" onclick="StatusActive(@i,'@item.Userid', '@item.ROLES','APP')">
                                <i class="fas fa-globe"></i> Only Web Login
                            </button>
                        </div>
                        <div id="btnshow_@i" class="wl-perm-action wl-perm-action--loading" style="display:none;">
                            <button type="button" class="wl-perm-btn wl-perm-btn--loading btn has-spinner"><i class="fa fa-circle-o-notch fa-spin"></i></button>
                        </div>
                    }
                    else if (item.apploginsts == "Y")
                    {
                        <div id="btnhide_@i" class="wl-perm-action">
                            <button type="button" value="ONLY APP LOGIN" class="wl-perm-btn wl-perm-btn--app btn has-spinner" onclick="StatusActive(@i,'@item.Userid', '@item.ROLES','BOTH')">
                                <i class="fas fa-mobile-alt"></i> Only App Login
                            </button>
                        </div>
                        <div id="btnshow_@i" class="wl-perm-action wl-perm-action--loading" style="display:none;">
                            <button type="button" class="wl-perm-btn wl-perm-btn--loading btn has-spinner"><i class="fa fa-circle-o-notch fa-spin"></i></button>
                        </div>
                    }

                    @if (item.Block == "Y")
                    {
                        <div id="btnhidecheck_@i" class="wl-perm-action attemptblock-first">
                            <button type="button" class="wl-attempt-btn btn has-spinner" onclick="unblockUser(@i,'@item.Userid', '@item.ROLES')">
                                <i class="fas fa-ban"></i>
                                <span class="wl-attempt-btn__text"><strong>Attempt Blocked</strong><small>Click to activate</small></span>
                            </button>
                        </div>
                        <div id="btnshowclick_@i" class="wl-perm-action wl-perm-action--loading" style="display:none;">
                            <button type="button" class="wl-perm-btn wl-perm-btn--loading btn has-spinner"><i class="fa fa-circle-o-notch fa-spin"></i></button>
                        </div>
                    }
                    </div>
                </td>
                <td class="wl-city-col set-city-up">
                    @if (item.userlocationlistbyid.Count() > 0)
                    {
                        <div class="wl-city-cell">
                            <ul class="wl-city-chips set-city-show">
                                @foreach (var itemasdsad in item.userlocationlistbyid)
                                {
                                    <li><span class="wl-city-chip">@itemasdsad</span></li>
                                }
                                <li>
                                    <button type="button" class="wl-city-edit-btn" title="Edit City"
                                            onclick="EditLocation(this, '@item.ROLES', '@item.Userid'),ViewDetailsByID('@item.Userid', '@item.ROLES')">
                                        <i class="fas fa-pen"></i>
                                    </button>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <button type="button" class="wl-fetch-city-btn"
                                onclick="GetLoginCityName(this, '@item.ROLES', '@item.Userid'),ViewDetailsByID('@item.Userid', '@item.ROLES')">
                            <i class="fas fa-map-marker-alt"></i> Fetch City
                        </button>
                    }
                </td>
            </tr>
            i++;
        }
    }
}
