@model IEnumerable<Vastwebmulti.Models.RechargeapiInfo>
@using System.Linq
@{
    ViewBag.Title = "RechargeAPIUrl";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var rows = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.RechargeapiInfo>();
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=28" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-api-operator-modern.css?v=31" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-api-operator-page saas-recharge-api-url-page">
    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
            <div class="saas-acc-toolbar-top vm-api-operator-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-api-operator-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li><a href="@Url.Action("Dashboard", "Home")#setting">Basic Setting</a></li>
                    <li>Recharge API URL</li>
                </ol>
                <div class="vm-dmt-fin-nav-row vm-api-operator-nav-wrap">
                    @Html.Partial("_menuapinm")
                </div>
            </div>

            <div class="vm-rpt-filters-panel vm-api-operator-filter-panel">
                <div class="saas-acc-filter-bar vm-opr-filter-row vm-api-operator-filter-row vm-rpt-filters-panel__bar">
                    <div class="vm-api-operator-filter-group vm-recharge-api-filter-group">
                        <div class="vm-recharge-api-sub-tabs" role="tablist" aria-label="Recharge API">
                            <a href="@Url.Action("RechargeAPIUrl", "Home")" class="vm-recharge-api-sub-tab is-active" role="tab" aria-selected="true">Recharge API URL</a>
                            <a href="@Url.Action("RechargeApiResponse", "Home")" class="vm-recharge-api-sub-tab" role="tab" aria-selected="false">Recharge API Response</a>
                            <a href="@Url.Action("ApiCallBackUrl", "Home")" class="vm-recharge-api-sub-tab" role="tab" aria-selected="false">Recharge API Call Back</a>
                            <a href="@Url.Action("ApiCallBack", "Home")" class="vm-recharge-api-sub-tab" role="tab" aria-selected="false">Call Back Page</a>
                        </div>
                        <button type="button" class="saas-acc-btn saas-acc-btn--search vm-api-nm-add-btn vm-recharge-api-add-btn" title="Add New Recharge API">
                            <i class="fas fa-plus" aria-hidden="true"></i><span>Add New</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-link" aria-hidden="true"></i>
                        <span>Recharge API URL configuration</span>
                    </div>
                    <label class="vm-api-operator-table-search" for="rechargeApiSearch">
                        <i class="fas fa-search" aria-hidden="true"></i>
                        <input type="text" id="rechargeApiSearch" placeholder="Search records..." autocomplete="off" />
                    </label>
                </div>
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="rechargeApiUrlTable" class="table vm-opr-data-table vm-recharge-api-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th class="vm-recharge-api-th--name">API Name</th>
                                    <th class="vm-recharge-api-th--url">API URL</th>
                                    <th class="vm-recharge-api-th--type">API Type</th>
                                    <th class="vm-recharge-api-th--req">Request Type</th>
                                    <th class="vm-recharge-api-th--key">Key Userid</th>
                                    <th class="vm-recharge-api-th--val">Val Userid</th>
                                    <th class="vm-recharge-api-th--key">Key Password</th>
                                    <th class="vm-recharge-api-th--val">Value Password</th>
                                    <th class="vm-recharge-api-th--key">Key Recharge No</th>
                                    <th class="vm-recharge-api-th--key">Key OptCode</th>
                                    <th class="vm-recharge-api-th--key">Key Amount</th>
                                    <th class="vm-recharge-api-th--key">Key RequestID</th>
                                    <th class="vm-recharge-api-th--type">is STV</th>
                                    <th class="vm-recharge-api-th--key">Key State Code</th>
                                    <th class="vm-recharge-api-th--key">Key No Romaing</th>
                                    <th class="vm-recharge-api-th--toggle">Status</th>
                                    <th class="vm-recharge-api-th--toggle vm-recharge-api-th--s2f">Success To Failed</th>
                                    <th class="vm-recharge-api-th--toggle vm-recharge-api-th--f2s">Failed To Success</th>
                                    <th class="vm-recharge-api-th--action">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in rows)
                                {
                                    <tr data-id="@item.id" data-api-name="@(item.apiname ?? "")">
                                        <td class="vm-recharge-api-td--name">@item.apiname</td>
                                        <td class="vm-recharge-api-td--url">@item.apiendpoint</td>
                                        <td class="vm-recharge-api-td--type">@item.apitype</td>
                                        <td class="vm-recharge-api-td--req">@item.Requesttype</td>
                                        <td class="vm-recharge-api-td--key">@item.Keyuserid</td>
                                        <td class="vm-recharge-api-td--val">@item.valuserid</td>
                                        <td class="vm-recharge-api-td--key">@item.Keypasscode</td>
                                        <td class="vm-recharge-api-td--val">@item.valpasscode</td>
                                        <td class="vm-recharge-api-td--key">@item.Keyrechargeno</td>
                                        <td class="vm-recharge-api-td--key">@item.Keyoptcode</td>
                                        <td class="vm-recharge-api-td--key">@item.KeyAmount</td>
                                        <td class="vm-recharge-api-td--key">@item.KeyReqid</td>
                                        <td class="vm-recharge-api-td--type">@item.isstv</td>
                                        <td class="vm-recharge-api-td--key">@item.keystatecode</td>
                                        <td class="vm-recharge-api-td--key">@item.keynoromaing</td>
                                        <td class="vm-recharge-api-td--toggle">
                                            @if (item.Sts == true)
                                            {
                                                <button type="button" class="vm-money-api-stats-toggle vm-money-api-stats-toggle--on vm-recharge-api-status-toggle" data-id="@item.id" title="Turn off">
                                                    <span class="onoffswitch"><span class="costom-on">on</span></span>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="vm-money-api-stats-toggle vm-money-api-stats-toggle--off vm-recharge-api-status-toggle" data-id="@item.id" title="Turn on">
                                                    <span class="onoffswitch"><span class="custom-off">off</span></span>
                                                </button>
                                            }
                                        </td>
                                        <td class="vm-recharge-api-td--toggle vm-recharge-api-td--s2f">
                                            @if (item.success_to_failed == true)
                                            {
                                                <button type="button" class="vm-money-api-stats-toggle vm-money-api-stats-toggle--on vm-recharge-api-flag-toggle" data-id="@item.id" data-type="success_to_failed" title="Turn off">
                                                    <span class="onoffswitch"><span class="costom-on">on</span></span>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="vm-money-api-stats-toggle vm-money-api-stats-toggle--off vm-recharge-api-flag-toggle" data-id="@item.id" data-type="success_to_failed" title="Turn on">
                                                    <span class="onoffswitch"><span class="custom-off">off</span></span>
                                                </button>
                                            }
                                        </td>
                                        <td class="vm-recharge-api-td--toggle vm-recharge-api-td--f2s">
                                            @if (item.failed_to_success == true)
                                            {
                                                <button type="button" class="vm-money-api-stats-toggle vm-money-api-stats-toggle--on vm-recharge-api-flag-toggle" data-id="@item.id" data-type="failed_to_success" title="Turn off">
                                                    <span class="onoffswitch"><span class="costom-on">on</span></span>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="button" class="vm-money-api-stats-toggle vm-money-api-stats-toggle--off vm-recharge-api-flag-toggle" data-id="@item.id" data-type="failed_to_success" title="Turn on">
                                                    <span class="onoffswitch"><span class="custom-off">off</span></span>
                                                </button>
                                            }
                                        </td>
                                        <td class="vm-recharge-api-td--action vm-api-nm-action-cell">
                                            <div class="vm-api-nm-action-group">
                                                <button type="button" class="vm-api-operator-edit-btn vm-recharge-api-edit-btn" data-id="@item.id" title="Edit API">
                                                    <i class="fas fa-edit" aria-hidden="true"></i> Edit
                                                </button>
                                                <button type="button" class="vm-api-nm-delete-btn vm-recharge-api-delete-btn" data-id="@item.id" title="Delete API">
                                                    <i class="fas fa-trash-alt" aria-hidden="true"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

