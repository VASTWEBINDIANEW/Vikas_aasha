<script>
    (function () {
        function applyRechargeApiSearch() {
            var q = ($('#rechargeApiSearch').val() || '').trim().toLowerCase();
            $('#rechargeApiUrlTable tbody tr').each(function () {
                var text = $(this).text().toLowerCase();
                $(this).toggle(!q || text.indexOf(q) > -1);
            });
        }

        function postJson(url, payload) {
            return fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            }).then(function (response) {
                return response.json();
            });
        }

        function openRechargeApiModal(selector) {
            if (typeof window.showAdminModal === 'function') {
                window.showAdminModal(selector);
            } else if (window.jQuery) {
                window.jQuery(selector).modal('show');
            }
        }

        function closeRechargeApiModal(selector) {
            var target = selector;
            if (selector && selector.jquery) {
                target = '#' + selector.attr('id');
            }
            if (typeof window.hideAdminModal === 'function') {
                window.hideAdminModal(target);
            } else if (window.jQuery) {
                window.jQuery(target).modal('hide');
            }
        }

        function openRechargeApiEditModal(id) {
            postJson('@Url.Action("EditRechargeAPIURLS", "Home")', { idno: id })
                .then(function (res) {
                    if (!res || !res.length) {
                        if (window.swal) {
                            swal('Error', 'Unable to load API details.', 'error');
                        }
                        return;
                    }

                    var row = res[0];
                    $('#editid').val(row.id);
                    $('#editApinm').val(row.apiname || '');
                    $('#editApiUrl').val(row.apiendpoint || '');
                    $('#editapitype').val(row.apitype || '').trigger('change');
                    $('#editapireqtype').val(row.Requesttype || '').trigger('change');
                    $('#Editkeyuserid').val(row.Keyuserid || '');
                    $('#Editvalueuserid').val(row.valuserid || '');
                    $('#editkeypasscode').val(row.Keypasscode || '');
                    $('#editvalpasscode').val(row.valpasscode || '');
                    $('#editrchnumber').val(row.Keyrechargeno || '');
                    $('#editkeyoptcode').val(row.Keyoptcode || '');
                    $('#editekyamount').val(row.KeyAmount || '');
                    $('#editrequestID').val(row.KeyReqid || '');
                    $('#editisstv').val(row.isstv || '');
                    $('#editstatecode').val(row.keystatecode || '');
                    $('#editkeynoromaing').val(row.keynoromaing || '');
                    openRechargeApiModal('#rechargeApiEditModal');
                })
                .catch(function () {
                    if (window.swal) {
                        swal('Error', 'Unable to load API details.', 'error');
                    }
                });
        }

        function deleteRechargeApi(id) {
            var doDelete = function () {
                fetch('@Url.Action("Delete_Recharge_Api", "Home")?id=' + encodeURIComponent(id))
                    .then(function (res) { return res.json(); })
                    .then(function (data) {
                        if (data && data.status) {
                            location.reload();
                        } else if (window.swal) {
                            swal('Error', (data && data.message) ? data.message : 'Unable to delete API.', 'error');
                        }
                    })
                    .catch(function () {
                        if (window.swal) {
                            swal('Error', 'Unable to delete API.', 'error');
                        }
                    });
            };

            if (window.swal) {
                swal({
                    title: 'Are you sure?',
                    text: 'This recharge API will be deleted permanently.',
                    type: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#dc2626',
                    confirmButtonText: 'Yes, delete',
                    cancelButtonText: 'Cancel'
                }, function (confirmed) {
                    if (confirmed) {
                        doDelete();
                    }
                });
            } else if (window.confirm('Are you sure?')) {
                doDelete();
            }
        }

        function bootRechargeApiPage() {
            var $ = window.jQuery;
            if (!$ || !$.fn || !$.fn.modal) {
                window.setTimeout(bootRechargeApiPage, 50);
                return;
            }

            $('#rechargeApiSearch').off('keyup.rechargeApi').on('keyup.rechargeApi', applyRechargeApiSearch);

            $(document).off('click.rechargeApiStatus', '.vm-recharge-api-status-toggle').on('click.rechargeApiStatus', '.vm-recharge-api-status-toggle', function () {
                var id = $(this).data('id');
                var $btn = $(this);
                $btn.prop('disabled', true);

                postJson('@Url.Action("UpdateApiUrlSts", "Home")', { idno: id })
                    .then(function () {
                        location.reload();
                    })
                    .catch(function () {
                        $btn.prop('disabled', false);
                        if (window.swal) {
                            swal('Error', 'Unable to update status.', 'error');
                        }
                    });
            });

            $(document).off('click.rechargeApiFlag', '.vm-recharge-api-flag-toggle').on('click.rechargeApiFlag', '.vm-recharge-api-flag-toggle', function () {
                var id = $(this).data('id');
                var type = $(this).data('type');
                var $btn = $(this);
                $btn.prop('disabled', true);

                postJson('@Url.Action("success_failed_change", "Home")', { idno: id, type: type })
                    .then(function () {
                        location.reload();
                    })
                    .catch(function () {
                        $btn.prop('disabled', false);
                        if (window.swal) {
                            swal('Error', 'Unable to update setting.', 'error');
                        }
                    });
            });

            $(document).off('click.rechargeApiEdit', '.vm-recharge-api-edit-btn').on('click.rechargeApiEdit', '.vm-recharge-api-edit-btn', function () {
                openRechargeApiEditModal($(this).data('id'));
            });

            $(document).off('click.rechargeApiDelete', '.vm-recharge-api-delete-btn').on('click.rechargeApiDelete', '.vm-recharge-api-delete-btn', function () {
                deleteRechargeApi($(this).data('id'));
            });

            $(document).off('click.rechargeApiAdd', '.vm-recharge-api-add-btn').on('click.rechargeApiAdd', '.vm-recharge-api-add-btn', function (e) {
                e.preventDefault();
                openRechargeApiModal('#rechargeApiAddModal');
            });

            $('#rechargeApiAddModal, #rechargeApiEditModal').off('click.rechargeApiClose', '[data-dismiss="modal"]').on('click.rechargeApiClose', '[data-dismiss="modal"]', function (e) {
                e.preventDefault();
                closeRechargeApiModal($(this).closest('.modal'));
            });

            $('#rechargeApiAddModal').off('hidden.bs.modal.rechargeApi').on('hidden.bs.modal.rechargeApi', function () {
                var form = document.getElementById('rechargeApiAddForm');
                if (form) {
                    form.reset();
                }
            });
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', bootRechargeApiPage);
        } else {
            bootRechargeApiPage();
        }
    })();
</script>
