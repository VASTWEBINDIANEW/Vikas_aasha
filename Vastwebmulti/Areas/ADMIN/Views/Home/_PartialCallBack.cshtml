@model IEnumerable<Vastwebmulti.Areas.ADMIN.Models.ApiCallBack>
@using System.Linq
@{
    var rows = Model != null ? Model.ToList() : new List<Vastwebmulti.Areas.ADMIN.Models.ApiCallBack>();
}

<table id="rechargeApiCallbackTable" class="table vm-opr-data-table vm-recharge-api-data-table" cellspacing="0">
    <thead>
        <tr>
            <th class="vm-recharge-api-th--name">API Name</th>
            <th class="vm-recharge-api-th--type">Request Type</th>
            <th class="vm-recharge-api-th--req">Body Type</th>
            <th class="vm-recharge-api-th--key">Key Status</th>
            <th class="vm-recharge-api-th--val">Val Status Success</th>
            <th class="vm-recharge-api-th--val">Val Status Failed</th>
            <th class="vm-recharge-api-th--key">Key Rch ID</th>
            <th class="vm-recharge-api-th--key">Key Message</th>
            <th class="vm-recharge-api-th--key">Key Operator ID</th>
            <th class="vm-recharge-api-th--key">Key Balance</th>
            <th class="vm-recharge-api-th--action">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in rows)
        {
            <tr data-idno="@item.idno" data-api-name="@(item.apiname ?? "")">
                <td class="vm-recharge-api-td--name">@item.apiname</td>
                <td class="vm-recharge-api-td--type">@item.Requesttype</td>
                <td class="vm-recharge-api-td--req">@item.bodytype</td>
                <td class="vm-recharge-api-td--key">@item.keystatus</td>
                <td class="vm-recharge-api-td--val">@item.valstatussuccess</td>
                <td class="vm-recharge-api-td--val">@item.valstatusfailed</td>
                <td class="vm-recharge-api-td--key">@item.keyrchid</td>
                <td class="vm-recharge-api-td--key">@item.keymsg</td>
                <td class="vm-recharge-api-td--key">@item.keyoperatorid</td>
                <td class="vm-recharge-api-td--key">@item.keybalance</td>
                <td class="vm-recharge-api-td--action vm-api-nm-action-cell">
                    <div class="vm-api-nm-action-group">
                        <button type="button" class="vm-api-operator-edit-btn vm-recharge-api-callback-edit-btn" data-idno="@item.idno" title="Edit Call Back">
                            <i class="fas fa-edit" aria-hidden="true"></i> Edit
                        </button>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
