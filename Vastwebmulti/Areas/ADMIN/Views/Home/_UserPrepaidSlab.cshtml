    <div class="modal-dialog modal-dialog-centered saas-admin-modal-dialog" role="document">
        <div class="modal-content commision-model">
            <div class="modal-header saas-admin-modal-header accent-amber">
                <div class="saas-admin-modal-head-main">
                    <div class="saas-admin-modal-icon"><i class="fas fa-user-shield" aria-hidden="true"></i></div>
                    <div class="saas-admin-modal-title-wrap">
                        <h5 class="modal-title saas-admin-modal-title" id="exampleModalLabel"><span id="txtvalheader"></span></h5>
                        <p class="saas-admin-modal-subtitle">Master distributor slab control setting</p>
                    </div>
                </div>
                <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
            </div>
            <div class="modal-body saas-admin-modal-body">
                <div class="vm-prepaid-md-modal-note">
                    <p><i class="fas fa-info-circle" aria-hidden="true"></i> All commission is handled using Master and Distributor hierarchy.</p>
                    <p><i class="fas fa-shield-alt" aria-hidden="true"></i> Retailer and Distributor slab changes may be restricted by admin policy.</p>
                </div>
            </div>
            <div class="modal-footer saas-admin-modal-footer">
                @using (Ajax.BeginForm("_UserPrepaidSlab_master", "Home", new AjaxOptions { HttpMethod = "POST", OnSuccess = "OnSuccess1M", OnFailure = "onfailed1M", UpdateTargetId = "divEditFormComm", LoadingElementId = "div_Loader", InsertionMode = InsertionMode.Replace }))
                {
                    @Html.Hidden("txtmaster")
