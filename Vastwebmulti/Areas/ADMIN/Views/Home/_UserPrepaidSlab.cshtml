@model Vastwebmulti.Areas.ADMIN.Models.PrepaidSlab
@using (Ajax.BeginForm("_UserPrepaidSlab", "Home", new AjaxOptions { HttpMethod = "POST", OnSuccess = "OnSuccess1", OnFailure = "onfailed", UpdateTargetId = "divEditFormComm", LoadingElementId = "div_Loader", InsertionMode = InsertionMode.Replace }))
{

    <input id="btnsubmituser" type="submit" name="Button" value="Update For Existing Users" class="btn waves-effect vm-pg-slab-save-btn" style="display:none;" />
    <input id="btnsubmitusercommon" type="submit" name="Button" value="Update Existing & New Users" class="btn waves-effect vm-pg-slab-save-btn" style="display:none;" />
    <input id="btnsubmitusercommondlmrem" type="submit" name="Button" value="Update Existing & New Users" class="btn waves-effect vm-pg-slab-save-btn" style="display:none;" />

    @Html.HiddenFor(m => m.role)
    <div class="row clearfix" style="margin-right:0px;">
        <div class="col-md-12">
            @*<div class="col-md-2">
                    <label for="email_address_2" style="padding-top:14px;padding-left:137px;"><i class="fa fa-users" style="font-size:25px; color:#607d8b ;"></i></label>
                </div>*@
            <div class="slab-master-block vm-prepaid-user-filter vm-prepaid-user-filter--inline">
                <div id="slab-master-message" class="slab-master-message slab-master-message-show" style="display: none;">
                    <p>If you edit the slabs of all the master distributors, you are given a data view of the common slabs.</p>
                </div>
                <div id="slab-master-detail" class="slab-master-detail slab-master-detail-hide vm-prepaid-user-filter__row" style="display: block;">
                    <div id="allshow" class="vm-prepaid-user-filter__item vm-prepaid-user-filter__item--select">
                        <div class="vm-pg-slab-field">
                            <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-users"></i></span>
                            @Html.DropDownList("ddlUserId", Model.UserId, "All Users", new { @class = "for-select2 form-control", @onchange = "ddlUserIdChange()" })
                        </div>
                    </div>
                    <div id="retailerdrop" class="vm-prepaid-user-filter__retailer" style="display:none;">
                        <div class="vm-prepaid-user-filter__item">
                            <div class="vm-pg-slab-field">
                                <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-user-tie"></i></span>
                                @Html.DropDownList("ddldealer", Model.UserId, "All Distributor", new { @class = "for-select2 form-control", @onchange = "ddlretailerid()" })
                            </div>
                        </div>
                        <div class="vm-prepaid-user-filter__item">
                            <div class="vm-pg-slab-field">
                                <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-store"></i></span>
                                @Html.DropDownList("ddlUserIdrem", Model.RetailerId, "All Retailer", new { @class = "for-select2 form-control", @onchange = "ddlUserIdChangerem()" })
                            </div>
                        </div>
                    </div>
                    <div class="vm-prepaid-user-filter__item">
                        <div class="vm-pg-slab-field">
                            <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-user"></i></span>
                            <input class="form-control" type="text" placeholder="User Name" value="@Model.Name" readonly="readonly" />
                        </div>
                    </div>
                    <div class="vm-prepaid-user-filter__item">
                        <div class="vm-pg-slab-field">
                            <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-phone-alt"></i></span>
                            <input class="form-control" type="text" placeholder="User Registered Number" value="@Model.Phone" readonly="readonly" />
                        </div>
                    </div>
                    <div class="vm-prepaid-user-filter__item">
                        <div class="vm-pg-slab-field">
                            <span class="vm-pg-slab-field__icon" aria-hidden="true"><i class="fas fa-envelope"></i></span>
                            <input class="form-control" type="text" placeholder="User Registered Mail" value="@Model.Email" readonly="readonly" />
                        </div>
                    </div>
                    @if (Model.Materuser != null)
                    {
                        <div class="vm-prepaid-user-filter__item vm-prepaid-user-filter__item--control">
                            @if (Model.allow == false)
                            {
                                <div class="vm-prepaid-md-control is-admin aoow-commision">
                                    <span id="adminoff" onclick="checkcomm('off')" class="vm-prepaid-md-control__dot vm-prepaid-md-control__dot--off" role="button" tabindex="0"></span>
                                    <span class="vm-prepaid-md-control__text"><strong>Default Slab Setting</strong>Slab Control By Admin Only</span>
                                </div>
                            }
                            else
                            {
                                <div class="vm-prepaid-md-control is-md aoow-commision">
                                    <span id="adminon" onclick="checkcomm('on')" class="vm-prepaid-md-control__dot vm-prepaid-md-control__dot--on" role="button" tabindex="0"></span>
                                    <span class="vm-prepaid-md-control__text"><strong>Slab Setting By MD</strong>Slab Control By Master Distributor</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
