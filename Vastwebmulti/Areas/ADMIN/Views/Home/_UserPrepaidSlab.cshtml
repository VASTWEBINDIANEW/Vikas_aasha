                        <i class="fas fa-save" aria-hidden="true"></i> Save Changes
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<script>
    checkcomm = (e) => {
        var userid = $('#ddlUserId').val();
        if (userid != "") {
            $('#txtvalheader').text("Status " + e);
            $('#txtmaster').val(userid)
            $('#exampleModal').modal()
        }
    }
</script>
<script>
        function OnSuccess1(data) {
            if (typeof resetSlabViewMode === 'function') {
                resetSlabViewMode();
            } else {
                $('#btnsubmituser').hide();
                $('#btnsubmitusercommon').hide();
                $('#btnEdit').show();
            }
            var chk = '@Model.role';
            if (chk == "Retailer") {
                $('#retailerdrop').show();
                $('#allshow').hide();
            }
            else {
                $('#retailerdrop').hide();
                $('#allshow').show();
            }
        }
        function onfailed(error) {
            alert(error.responseText);
        }
</script>
<script>
        function OnSuccess1M(data) {
            if (typeof resetSlabViewMode === 'function') {
                resetSlabViewMode();
            } else {
                $('#btnsubmituser').hide();
                $('#btnsubmitusercommon').hide();
                $('#btnEdit').show();
            }
            $('.modal-backdrop.in').hide();
           // $('#exampleModal').modal('hide');
            var chk = '@Model.role';
            if (chk == "Retailer") {
                $('#retailerdrop').show();
                $('#allshow').hide();
            }
            else {
                $('#retailerdrop').hide();
                $('#allshow').show();
            }
        }
</script>
