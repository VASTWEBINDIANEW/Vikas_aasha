@model IEnumerable<Vastwebmulti.Models.loanlimit>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Loan Setting";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var rows = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.loanlimit>();
    var row = rows.FirstOrDefault();
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-settings-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-settings-page">
    <div class="container-fluid">

        
        <div class="saas-acc-toolbar">
            <ol class="saas-acc-breadcrumb">
                <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                <li><a href="@Url.Action("More_Option", "Home")">More Options</a></li>
                <li>Loan Setting</li>
            </ol>
        </div>

        <div class="saas-acc-table-card">
            <div class="saas-acc-table-card-head">
                <h3>Loan limit configuration</h3>
            </div>
            <div class="saas-acc-table-wrap table-responsive">
                <table class="table saas-acc-table table-bordered">
                    <thead>
                        <tr>
                            <th>Min Days</th>
                            <th>Charge (%)</th>
                            <th>Payment Type</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var rowIdx = 0; }
                        @foreach (var i in rows)
                        {
                            <tr id="loan-row-show-@rowIdx">
                                <td data-label="Min Days">@i.min_days</td>
                                <td data-label="Charge">@i.charge</td>
                                <td data-label="Payment Type">
                                    @if (i.fullorpartialpayment == true)
                                    {
                                        <a href="@Url.Action("Loanpaysts", "Home", new { sts = false })" class="saas-set-pill saas-set-pill--partial">Partial Payment</a>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("Loanpaysts", "Home", new { sts = true })" class="saas-set-pill saas-set-pill--full">Full Payment</a>
                                    }
                                </td>
                                <td data-label="Status">
                                    @if (i.status == true)
                                    {
                                        <a href="@Url.Action("Loansts", "Home", new { sts = false })" class="saas-set-pill saas-set-pill--on">ON</a>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("Loansts", "Home", new { sts = true })" class="saas-set-pill saas-set-pill--off">OFF</a>
                                    }
                                </td>
                                <td data-label="Action">
                                    <button type="button" class="saas-set-btn-edit" onclick="loanShowEdit(@rowIdx)">Edit</button>
                                </td>
                            </tr>
                            <tr id="loan-row-edit-@rowIdx" class="saas-set-edit-row" style="display:none;">
                                @using (Html.BeginForm("Loanlimitset", "Home", FormMethod.Post))
                                {
                                    <td>
                                        <input type="number" min="1" step="1" onkeypress="return event.charCode >= 48 && event.charCode <= 57" title="Numbers only" value="@i.min_days" name="mindays" class="form-control" />
                                    </td>
                                    <td>
                                        <input type="number" required name="charge" min="0" value="@i.charge" step="any" class="form-control" />
                                    </td>
                                    <td colspan="2"></td>
                                    <td>
                                        <input type="submit" name="submit" value="Save" class="saas-set-btn-primary" />
                                        <button type="button" class="saas-set-btn-edit" onclick="loanHideEdit(@rowIdx)" style="margin-left:6px;">Cancel</button>
                                    </td>
                                }
                            </tr>
                            rowIdx++;
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</section>

<script>
    function loanShowEdit(idx) {
        var show = document.getElementById('loan-row-show-' + idx);
        var edit = document.getElementById('loan-row-edit-' + idx);
        if (show) show.style.display = 'none';
        if (edit) edit.style.display = 'table-row';
    }
    function loanHideEdit(idx) {
        var show = document.getElementById('loan-row-show-' + idx);
        var edit = document.getElementById('loan-row-edit-' + idx);
        if (show) show.style.display = 'table-row';
        if (edit) edit.style.display = 'none';
    }
</script>
