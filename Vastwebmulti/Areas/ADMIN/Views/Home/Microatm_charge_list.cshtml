@model Vastwebmulti.Areas.ADMIN.ViewModel.MicroatmchargeViewmodel
@using System.Linq
@{
    ViewBag.Title = "Microatm_charge_list";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var plans = Model != null && Model.Showdeviceplanlist != null ? Model.Showdeviceplanlist : Enumerable.Empty<Vastwebmulti.Models.Micro_atm_device_plan>();
    var rowCount = plans.Count();
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-microatm-charge-list-modern.css?v=2" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-microatm-charge-list-page">

    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
            <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-matm-cl-toolbar-row">

                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li><a href="@Url.Action("Dashboard", "Home")#setting">Basic Setting</a></li>
                    <li><a href="@Url.Action("MicroAtm_Device_info", "Home")#setting">M-ATM Device's</a></li>
                    <li>Microatm Charge List</li>
                </ol>

                <div class="vm-matm-cl-toolbar-search">
                    <input id="myInput" type="text" class="form-control vm-dmt-search-input" placeholder="Search plans..." onkeyup="myFunction()" autocomplete="off" />
                </div>

            </div>
        </div>

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-list-alt" aria-hidden="true"></i>
                        <span>M-ATM charge list</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-matm-cl-record-badge" title="Total plans">
                            Plans: <strong id="matmClRecordCount">@rowCount</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" id="btnExportCL" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDFCL" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="matmreport" class="table vm-opr-data-table" cellspacing="0">
                            @Html.Partial("_MicroatmChargeTableHead")
                            @Html.Partial("_microatmEdit", Model)
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<script>
    function myFunction() {
        var value = document.getElementById('myInput').value.toLowerCase();
        $('#matmreport tbody tr').filter(function () {
            $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
        });
    }

    function refreshMatmClRecordCount() {
        var count = document.querySelectorAll('#matmreport tbody tr:not(.vm-opr-table-empty-row)').length;
        $('#matmClRecordCount').text(count);
    }

    function exportMatmClTable(type) {
        var table = document.getElementById('matmreport');
        if (!table) {
            return;
        }

        var stamp = new Date().toISOString().slice(0, 10);
        var title = 'M-ATM Charge List';
        var clone = table.cloneNode(true);
        var emptyRow = clone.querySelector('.vm-opr-table-empty-row');
        if (emptyRow) {
            alert('No data available to export.');
            return;
        }

        if (type === 'excel') {
            var excelHtml = '<html><head><meta charset="utf-8"></head><body>' + clone.outerHTML + '</body></html>';
            var blob = new Blob(['\ufeff', excelHtml], { type: 'application/vnd.ms-excel' });
            var link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'MicroAtmChargeList_' + stamp + '.xls';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            return;
        }

        var printWin = window.open('', '_blank');
        if (!printWin) {
            alert('Please allow pop-ups to export PDF.');
            return;
        }
        printWin.document.write(
            '<html><head><title>' + title + '</title>'
            + '<style>body{font-family:Arial,sans-serif;padding:16px}h3{margin:0 0 12px}table{border-collapse:collapse;width:100%;font-size:8px}th,td{border:1px solid #ccc;padding:3px;text-align:left}th{background:#f3f4f6}</style>'
            + '</head><body><h3>' + title + '</h3>' + clone.outerHTML + '</body></html>'
        );
        printWin.document.close();
        printWin.focus();
        printWin.print();
    }

    function EditPlanorday(id) {
        var $btn = $('#editplanoder_' + id);
        $btn.addClass('microatmcharge-button-spin');
        $btn.css('font-size', '0');
        $.ajax({
            type: 'POST',
            url: '@Url.Action("GetChargelistById", "Home")',
            data: { idno: id },
            success: function (data) {
                $('#matmreport').replaceWith(data);
                refreshMatmClRecordCount();
            },
            complete: function () {
                $btn.removeClass('microatmcharge-button-spin');
                $btn.css('font-size', '');
            }
        });
    }

    function SaveAmountData(id) {
        $.ajax({
            type: 'POST',
            url: '@Url.Action("Editrentalchargelist", "Home")',
            data: {
                idno: id,
                deviceprice: $('#deviceprice').val(),
                minquantity: $('#minquantity').val(),
                upto2: $('#upto2').val(),
                upto5: $('#upto5').val(),
                upto8: $('#upto8').val(),
                above8: $('#above8').val(),
                dlm_upto2: $('#dlm_upto2').val(),
                dlm_upto5: $('#dlm_upto5').val(),
                dlm_upto8: $('#dlm_upto8').val(),
                dlm_above8: $('#dlm_above8').val(),
                md_upto2: $('#md_upto2').val(),
                md_upto5: $('#md_upto5').val(),
                md_upto8: $('#md_upto8').val(),
                md_above8: $('#md_above8').val(),
                md_monthly: $('#md_monthly').val(),
                md_monthly_dealer: $('#md_monthly_dealer').val(),
                md_monthly_master: $('#md_monthly_master').val()
            },
            success: function (data) {
                $('#matmreport').html(data);
                refreshMatmClRecordCount();
            }
        });
    }

    $(document).ready(function () {
        refreshMatmClRecordCount();

        $('#btnExportCL').on('click', function () {
            exportMatmClTable('excel');
        });

        $('#btnPDFCL').on('click', function () {
            exportMatmClTable('pdf');
        });
    });
</script>
