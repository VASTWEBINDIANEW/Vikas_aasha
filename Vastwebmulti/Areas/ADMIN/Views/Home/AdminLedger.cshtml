@model List<Vastwebmulti.Models.Retailer_Cr_Dr_Report_Result>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Ledger Book";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var ledgerRows = Model ?? new List<Vastwebmulti.Models.Retailer_Cr_Dr_Report_Result>();
    var rowCount = ledgerRows.Count;

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
    var selectedLedgerType = Request["ddlusers"] ?? "Admin";
    var selectedPrevDays = Request["prev_numberOfDays"] ?? "0";
    var selectedMaster = Request["allmaster"] ?? "";
    var selectedDealer = Request["alldealer"] ?? "";
    var selectedRetailer = Request["allretailer"] ?? "";
    var selectedWhitelabel = Request["allwhitelabel"] ?? "";
    var selectedApiUser = Request["allapiuser"] ?? "";

    decimal totalCredit = 0m;
    decimal totalDebit = 0m;
    int mismatchCount = 0;

    for (int i = 0; i < rowCount; i++)
    {
        totalCredit += ledgerRows[i].credit ?? 0m;
        totalDebit += ledgerRows[i].debit ?? 0m;

        decimal? nextvalue = 0m;
        if (i != rowCount - 1)
        {
            nextvalue = ledgerRows[i + 1].Balance - ledgerRows[i + 1].credit + ledgerRows[i + 1].debit;
        }
        else
        {
            nextvalue = ledgerRows[i].Balance;
        }

        if ((ledgerRows[i].Balance - nextvalue) != 0)
        {
            mismatchCount++;
        }
    }

}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=44" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=29" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ledger-modern.css?v=4" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-prepaid-card-report-page saas-admin-ledger-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var ledgerFormAttrs = new Dictionary<string, object>
            {
                { "id", "adminLedgerForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("AdminLedger", "Home", FormMethod.Post, ledgerFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line vm-gift-toolbar-one-line vm-ledger-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Account</li>
                        <li>Ledger Book</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters vm-ecomm-filter-row--one-line vm-gift-filter-row--one-line vm-ledger-filter-row--one-line">

                        <div class="vm-ledger-quick-links">
                            <a href="@Url.Action("CMSLedger", "Home")" class="vm-ledger-quick-link">
                                <i class="fas fa-file-invoice" aria-hidden="true"></i> CMS Ledger
                            </a>
                            <a href="@Url.Action("AdminPOSLedgershow", "Home")" class="vm-ledger-quick-link">
                                <i class="fas fa-cash-register" aria-hidden="true"></i> POS Ledger
                            </a>
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-ledger-field--type">
                        @Html.DropDownList("ddlusers", new SelectList(new List<SelectListItem>
                        {
                            new SelectListItem { Text = "Admin Ledger", Value = "Admin" },
                            new SelectListItem { Text = "Master Distributor Ledger", Value = "Master" },
                            new SelectListItem { Text = "Distributor Ledger", Value = "Dealer" },
                            new SelectListItem { Text = "Retailer Ledger", Value = "Retailer" },
                            new SelectListItem { Text = "API User Ledger", Value = "API" },
                            new SelectListItem { Text = "White Label Ledger", Value = "Whitelabel" }
                        }, "Value", "Text", selectedLedgerType), new { @id = "ddlusers", @class = "vm-opr-select vm-dmt-select form-control", onchange = "answers()" })
                    </div>

                    <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra vm-ledger-field--user" id="allwh" hidden>
                        @Html.DropDownList("allwhitelabel", new SelectList(ViewBag.allwhitelabel as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>(), "Value", "Text", selectedWhitelabel), "Select Whitelabel", new { id = "allwhitelabel", @class = "vm-opr-select vm-dmt-select form-control" })
                    </div>

                    <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra vm-ledger-field--user" id="allms" hidden>
                        @Html.DropDownList("allmaster", new SelectList(ViewBag.allmaster as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>(), "Value", "Text", selectedMaster), "Select Master Distributor", new { id = "allmaster", @class = "vm-opr-select vm-dmt-select form-control" })
                    </div>

                    <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra vm-ledger-field--user" id="dlm" hidden>
                        @Html.DropDownList("alldealer", new SelectList(ViewBag.alldealer as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>(), "Value", "Text", selectedDealer), "Select Distributor", new { id = "alldealer", @class = "vm-opr-select vm-dmt-select form-control" })
                    </div>

                    <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra vm-ledger-field--user" id="rem" hidden>
                        @Html.DropDownList("allretailer", new SelectList(ViewBag.allretailer as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>(), "Value", "Text", selectedRetailer), "Select Retailer", new { id = "allretailer", @class = "vm-opr-select vm-dmt-select form-control" })
                    </div>

                    <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra vm-ledger-field--user" id="apiid" hidden>
                        @Html.DropDownList("allapiuser", new SelectList(ViewBag.apiid as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>(), "Value", "Text", selectedApiUser), "Select API", new { id = "allapiuser", @class = "vm-opr-select vm-dmt-select form-control" })
                    </div>

                    <div class="vm-opr-field vm-dmt-field vm-ledger-field--prev">
                        @Html.DropDownList("prev_numberOfDays", new SelectList(new List<SelectListItem>
                        {
                            new SelectListItem { Text = "Selected Day", Value = "0" },
                            new SelectListItem { Text = "Prev Days 1", Value = "1" },
                            new SelectListItem { Text = "Prev Days 3", Value = "3" },
                            new SelectListItem { Text = "Prev Days 5", Value = "5" },
                            new SelectListItem { Text = "Prev Days 7", Value = "7" }
                        }, "Value", "Text", selectedPrevDays), new { @class = "vm-opr-select vm-dmt-select form-control" })
                    </div>

                    <div class="vm-dmt-filter-search-group">
                        <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                            <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                            @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                        </div>
                        <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                            <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                            @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                        </div>
                        <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                            <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                        </button>
                    </div>

                </div>

                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="adminLedgerTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Ledger totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideAdminLedgerTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--primary">
                            <span class="vm-opr-total-card__label">Total Credit</span>
                            <strong class="vm-opr-total-card__value" id="ledgerTotalCredit">@totalCredit.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Total Debit</span>
                            <strong class="vm-opr-total-card__value" id="ledgerTotalDebit">@totalDebit.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Records</span>
                            <strong class="vm-opr-total-card__value" id="ledgerTotalRecords">@rowCount</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Mismatch Rows</span>
                            <strong class="vm-opr-total-card__value" id="ledgerMismatchCount">@mismatchCount</strong>
                        </div>
                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card vm-ledger-report-main-card vm-prepaid-report-main-card">
            <div class="vm-opr-table-panel vm-prepaid-report-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-book" aria-hidden="true"></i>
                        <span>Individual user wise ledger</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong id="ledgerRecordCount">@rowCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total" title="Mismatch rows in current result">
                            Mismatch: <strong id="ledgerInlineMismatch">@mismatchCount</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-ledger-totals-btn" onclick="findtotalA()" title="Show totals" aria-expanded="false" aria-controls="adminLedgerTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap vm-ledger-table-wrap vm-prepaid-table-wrap">
                    <div id="adminLedgerTableScroll" class="table-responsive vm-opr-table-scroll vm-ledger-table-scroll">
                        <table id="adminLedgerTable" class="table vm-opr-data-table saas-acc-table saas-acc-table--ledger" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Sr.&nbsp;No</th>
                                    <th>Request&nbsp;Id</th>
                                    <th>Particular&nbsp;Details</th>
                                    <th>?&nbsp;Amount</th>
                                    <th>Credit</th>
                                    <th>Debit</th>
                                    <th id="whitelabelpre">Balance</th>
                                    <th id="whitelabelbalance" style="display:none;">Balance</th>
                                    <th>Date&nbsp;&amp;&nbsp;Time</th>
                                    <th>Diff</th>
                                </tr>
                            </thead>
                            <tbody id="mytable">
                                @{
                                    int t = 1;
                                    int total = ledgerRows.Count;
                                }
                                @for (int i = 0; i < total; i++)
                                {
                                    decimal? nextvalue = 0m;
                                    decimal? diff = 0m;
                                    var mismatchClass = "";

                                    if (i != total - 1)
                                    {
                                        nextvalue = ledgerRows[i + 1].Balance - ledgerRows[i + 1].credit + ledgerRows[i + 1].debit;
                                    }
                                    else
                                    {
                                        nextvalue = ledgerRows[i].Balance;
                                    }

                                    diff = ledgerRows[i].Balance - nextvalue;
                                    if (diff != 0)
                                    {
                                        mismatchClass = "saas-acc-row-mismatch";
                                    }

                                    <tr class="@mismatchClass">
                                        <td>@t</td>
                                        <td>@ledgerRows[i].RequestId</td>
                                        <td class="col-particulars">@ledgerRows[i].Particulars</td>
                                        <td class="col-amount">@ledgerRows[i].Amount</td>
                                        <td>@ledgerRows[i].credit</td>
                                        <td>@ledgerRows[i].debit</td>
                                        @if (ledgerRows[i].Role == "Whitelabel")
                                        {
                                            <td class="col-balance">@ledgerRows[i].Balance</td>
                                            <td class="col-balance">@ledgerRows[i].UserActualRemainAmount</td>
                                        }
                                        else
                                        {
                                            <td class="col-balance">@ledgerRows[i].Balance</td>
                                            <td style="display:none;"></td>
                                        }
                                        <td>@ledgerRows[i].Date</td>
                                        <td class="col-diff">@diff</td>
                                    </tr>
                                    t++;
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<script src="~/MainFrontDesign/select2/dist/js/select2.full.min.js"></script>

<script>
    (function ($) {
        var ledgerExtraWrapSelectors = ['#allwh', '#allms', '#dlm', '#rem', '#apiid'];
        var ledgerSelectSelectors = ['#allwhitelabel', '#allmaster', '#alldealer', '#allretailer', '#allapiuser'];

        function hideAdminLedgerTotals() {
            $('#adminLedgerTotalsPanel').hide().attr('aria-hidden', 'true');
            $('.vm-ledger-totals-btn').attr('aria-expanded', 'false');
        }

        window.findtotalA = function () {
            var $panel = $('#adminLedgerTotalsPanel');
            if ($panel.is(':visible')) {
                hideAdminLedgerTotals();
                return;
            }
            $panel.show().attr('aria-hidden', 'false');
            $('.vm-ledger-totals-btn').attr('aria-expanded', 'true');
        };

        window.hideAdminLedgerTotals = hideAdminLedgerTotals;

        function destroyLedgerSelect2($el) {
            if ($el && $el.length && $el.data('select2')) {
                $el.select2('destroy');
            }
        }

        function applyLedgerSelect2($el) {
            if (!$el || !$el.length || !$.fn.select2) {
                return;
            }
            destroyLedgerSelect2($el);
            $el.select2({
                width: '100%',
                minimumResultsForSearch: 6
            });
        }

        function hideLedgerFilterExtras() {
            $(ledgerExtraWrapSelectors.join(', ')).each(function () {
                $(this).removeClass('is-visible').attr('hidden', 'hidden');
            });
            $(ledgerSelectSelectors.join(', ')).each(function () {
                destroyLedgerSelect2($(this));
            });
        }

        function showLedgerFilterExtra(selector) {
            var $wrap = $(selector);
            $wrap.addClass('is-visible').removeAttr('hidden');
            applyLedgerSelect2($wrap.find('select'));
        }

        function setWhitelabelColumns(isWhitelabel) {
            var $pre = $('#whitelabelpre');
            var $post = $('#whitelabelbalance');

            if (isWhitelabel) {
                $pre.text('WhitelabelPre');
                $post.text('WhitelabelPost').show();
                $('#adminLedgerTable thead th#whitelabelbalance, #adminLedgerTable tbody td:nth-child(8)').show();
            } else {
                $pre.text('Balance');
                $post.text('Balance').hide();
                $('#adminLedgerTable thead th#whitelabelbalance').hide();
                $('#adminLedgerTable tbody tr').each(function () {
                    $(this).find('td').eq(7).hide();
                });
            }
        }

        function toggleLedgerTable(showTable) {
            if (showTable) {
                $('#mytable').show();
            } else {
                $('#mytable').hide();
            }
        }

        window.answers = function (text) {
            var answer = $('#ddlusers').val();
            hideLedgerFilterExtras();
            toggleLedgerTable(false);

            if (answer === 'Dealer') {
                showLedgerFilterExtra('#dlm');
                setWhitelabelColumns(false);
                if (text === 'pp') { toggleLedgerTable(true); }
            } else if (answer === 'Whitelabel') {
                showLedgerFilterExtra('#allwh');
                setWhitelabelColumns(true);
                if (text === 'pp') { toggleLedgerTable(true); }
            } else if (answer === 'Master') {
                showLedgerFilterExtra('#allms');
                setWhitelabelColumns(false);
                if (text === 'pp') { toggleLedgerTable(true); }
            } else if (answer === 'Admin') {
                setWhitelabelColumns(false);
                if (text === 'pp') { toggleLedgerTable(true); }
            } else if (answer === 'Retailer') {
                showLedgerFilterExtra('#rem');
                setWhitelabelColumns(false);
                if (text === 'pp') { toggleLedgerTable(true); }
            } else if (answer === 'API') {
                showLedgerFilterExtra('#apiid');
                setWhitelabelColumns(false);
                if (text === 'pp') { toggleLedgerTable(true); }
            }
        };

        function buildAdminLedgerExportUrl(actionName) {
            return actionName
                + '?txt_frm_date=' + encodeURIComponent($('#txt_frm_date').val())
                + '&ddlusers=' + encodeURIComponent($('#ddlusers').val())
                + '&allmaster=' + encodeURIComponent($('#allmaster').val())
                + '&alldealer=' + encodeURIComponent($('#alldealer').val())
                + '&allretailer=' + encodeURIComponent($('#allretailer').val())
                + '&allwhitelabel=' + encodeURIComponent($('#allwhitelabel').val())
                + '&allapiuser=' + encodeURIComponent($('#allapiuser').val());
        }

        function initAdminLedgerDatepickers() {
            if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
                window.setTimeout(initAdminLedgerDatepickers, 50);
                return;
            }
            if (typeof window.initAdminReportDateForm === 'function') {
                window.initAdminReportDateForm('#adminLedgerForm');
            }
        }

        function initAdminLedgerSelect2() {
            applyLedgerSelect2($('#ddlusers'));
            applyLedgerSelect2($('#prev_numberOfDays'));
        }

        $(document).ready(function () {
            initAdminLedgerSelect2();
            initAdminLedgerDatepickers();
            $('#adminLedgerForm .select2-container').css('width', '100%');
            answers('pp');

            $('#btnExport').on('click', function () {
                window.location.href = buildAdminLedgerExportUrl('@Url.Action("ExcellGenerateForAdminLedger", "Home")');
            });

            $('#btnPDF').on('click', function () {
                window.open(buildAdminLedgerExportUrl('@Url.Action("PrintAdminLedgerPartialViewToPdf", "Home")'), '_blank');
            });
        });
    })(jQuery);
</script>
