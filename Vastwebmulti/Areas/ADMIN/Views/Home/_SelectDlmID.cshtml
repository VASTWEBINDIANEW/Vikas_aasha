@model Vastwebmulti.Areas.ADMIN.Models.MasterDistributerModel

@{

    Layout = null;

    var dealerCount = Model.Select_dealer_list != null ? Model.Select_dealer_list.Count() : 0;

}

<div class="vm-ml-sub-panel">

    <div class="vm-ml-sub-panel__head">

        <div class="vm-ml-sub-panel__title">

            <i class="fas fa-sitemap" aria-hidden="true"></i>

            <span>Distributors under this M/D</span>

        </div>

        <span class="vm-ml-sub-panel__count">@dealerCount record@(dealerCount == 1 ? "" : "s")</span>

    </div>

    <div class="table-responsive vm-ml-sub-table-wrap">

        <table class="table table-bordered vm-ml-sub-table saas-acc-table" style="margin:0;">

            <thead>

                <tr>

                    <th>Distributor&nbsp;Firm</th>

                    <th>Distributor&nbsp;Name</th>

                    <th>Mobile&nbsp;No</th>

                    <th>PAN&nbsp;No</th>

                    <th>KYC</th>

                    <th class="vm-ml-sub-th--money">D-Bal</th>

                    <th class="vm-ml-sub-th--money">R-Bal</th>

                </tr>

            </thead>

            <tbody>

                @if (Model.Select_dealer_list != null && dealerCount > 0)

                {

                    foreach (var item in Model.Select_dealer_list)

                    {

                        <tr>

                            <td class="vm-ml-sub-firm">@item.FarmName</td>

                            <td>@item.DealerName</td>

                            <td>@item.Mobile</td>

                            <td>@item.pancard</td>

                            <td class="kyc-button">

                                @if (item.PSAStatus == "Y" && item.AadhaarStatus == "Y")

                                {

                                    <span class="vm-ml-status-badge vm-ml-status-badge--done">Done</span>

                                }

                                else

                                {

                                    <span class="vm-ml-status-badge vm-ml-status-badge--due">Due</span>

                                }

                            </td>

                            <td class="vm-ml-balance-cell">@item.remaindlm</td>

                            <td class="vm-ml-balance-cell">@item.remainrem</td>

                        </tr>

                    }

                }

                else

                {

                    <tr>

                        <td colspan="7" class="vm-ml-sub-empty">No distributors found for this master.</td>

                    </tr>

                }

            </tbody>

        </table>

    </div>

</div>

