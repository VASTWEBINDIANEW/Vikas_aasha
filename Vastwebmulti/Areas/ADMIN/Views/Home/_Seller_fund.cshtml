@model Vastwebmulti.Areas.ADMIN.Models.AutoFund_Report
<table class="table vm-ml-data-table">
        <thead>
            <tr>
                <th>API Name</th>
                <th>Mode</th>
                <th>Bank Name</th>
                <th>Payee Name</th>
                <th>Account Number</th>
                <th>IFSC Code</th>
                <th>Amount</th>
                <th>Request Time</th>
                <th>Response Time</th>
                <th>Bank RRN</th>
                <th>Status</th>
                <th>Api Request</th>
                <th>Api Response</th>
            </tr>
        </thead>
        <tbody>
            @{ var hasFundRows = false; }
            @if (Model.info_auto_fund != null)
            {
                foreach (var item in Model.info_auto_fund)
                {
                    hasFundRows = true;
                    <tr>
                        <td>@item.apiname</td>
                        <td>@item.Mode</td>
                        <td>@item.bankName</td>
                        <td>@item.PayeeName</td>
                        <td>@item.accountno</td>
                        <td>@item.ifsccode</td>
                        <td>@item.txnamt</td>
                        <td>@item.txndate</td>
                        <td>@item.updatedate</td>
                        <td>@item.bankrrn</td>
                        <td>@item.status</td>
                        <td>@item.apirequest</td>
                        <td>@item.apiresponse</td>
                    </tr>
                }
            }
            @if (!hasFundRows)
            {
                <tr class="ap-empty-row">
                    <td colspan="13">No seller fund records for selected filters.</td>
                </tr>
            }
        </tbody>
    </table>

<script>
    function success1() {
        var msg = '@Model.msg';

        if (msg == "Wrong") {
            $('#msgpurchasemanual').text("Wrong Password");
        }
        else {
            $('#divaccountlist').hide();
            $('#divaccountlistadd').show();
            $('#resetform').click();
        }
        if (typeof apOpenRightTab === 'function') {
            apOpenRightTab('tab-10');
        } else {
            $('#tab10').click();
        }
    }
    function fail1() {
        alert("error");
    }
</script>
