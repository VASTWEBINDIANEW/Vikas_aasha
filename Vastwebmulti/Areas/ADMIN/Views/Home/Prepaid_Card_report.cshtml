@model IEnumerable<Vastwebmulti.Models.prepaid_card_Transaction>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Prepaid Card Report";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
    var reports = Model ?? Enumerable.Empty<Vastwebmulti.Models.prepaid_card_Transaction>();
    var rowCount = reports.Count();

    decimal totalAmount = reports.Sum(i => i.Amount ?? 0m);
    decimal totalSuccess = reports.Where(i => string.Equals(i.Status, "SUCCESS", StringComparison.OrdinalIgnoreCase)).Sum(i => i.Amount ?? 0m);
    decimal totalFailed = reports.Where(i => string.Equals(i.Status, "FAILED", StringComparison.OrdinalIgnoreCase)).Sum(i => i.Amount ?? 0m);
    decimal totalPending = reports.Where(i => string.Equals(i.Status, "PENDING", StringComparison.OrdinalIgnoreCase)).Sum(i => i.Amount ?? 0m);
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=44" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=29" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-security-report-page saas-giftcard-report-page saas-prepaid-card-report-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var prepaidFormAttrs = new Dictionary<string, object>
            {
                { "id", "prepaidCardReportForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Ajax.BeginForm("Prepaid_Card_report", "Home", null, new AjaxOptions
        {
            HttpMethod = "POST",
            OnSuccess = "onPrepaidCardReportSuccess",
            OnFailure = "onPrepaidCardReportFail",
            UpdateTargetId = "resultTarget",
            LoadingElementId = "prepaidCardLoading"
        }, prepaidFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line vm-gift-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Report's</li>
                        <li>Prepaid Card Report</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters vm-ecomm-filter-row--one-line vm-gift-filter-row--one-line">

                        <div class="vm-opr-field vm-dmt-field vm-prepaid-field--retailer">
                            @Html.DropDownList("allretailer", ViewBag.retailer as SelectList, "All Retailer", new { id = "allretailer", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" name="btntype" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="prepaidCardTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Prepaid card report totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hidePrepaidCardTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Success</span>
                            <strong class="vm-opr-total-card__value" id="prepaidTotalSuccess">@totalSuccess.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Failed</span>
                            <strong class="vm-opr-total-card__value" id="prepaidTotalFailed">@totalFailed.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Pending</span>
                            <strong class="vm-opr-total-card__value" id="prepaidTotalPending">@totalPending.ToString("N2")</strong>
                        </div>
                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card vm-security-report-main-card vm-gift-report-main-card vm-prepaid-report-main-card">
            <div class="vm-opr-table-panel vm-security-report-table-panel vm-gift-report-table-panel vm-prepaid-report-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head vm-security-report-table-head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-credit-card" aria-hidden="true"></i>
                        <span>Prepaid card report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong id="prepaidRecordCount">@rowCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total" title="Total amount for current filter">
                            Total: <strong id="prepaidInlineTotal">₹ @totalAmount.ToString("N2")</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-gift-totals-btn vm-prepaid-totals-btn" onclick="findtotalA()" title="Show totals" aria-expanded="false" aria-controls="prepaidCardTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnExportA" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDFA" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap vm-prepaid-table-wrap">
                    <div id="prepaidCardLoading" class="vm-prepaid-table-loading" style="display:none;" aria-hidden="true">
                        <i class="fas fa-spinner fa-spin" aria-hidden="true"></i>
                        <span>Loading report...</span>
                    </div>
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="prepaidCardReportTable" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Status</th>
                                    <th>User</th>
                                    <th>Quantity</th>
                                    <th>Amount</th>
                                    <th>Request&nbsp;Time</th>
                                    <th>Response&nbsp;Time</th>
                                    <th>Comm</th>
                                    <th>GST</th>
                                    <th>TDS</th>
                                    <th>Retailer&nbsp;Pre</th>
                                    <th>Retailer&nbsp;Post</th>
                                    <th>Final</th>
                                </tr>
                            </thead>
                            <tbody id="resultTarget">
                                @Html.Partial("_Prepaid_Card_report", reports)
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<script src="~/MainFrontDesign/select2/dist/js/select2.full.min.js"></script>

<script>
    function hidePrepaidCardTotals() {
        var $panel = $('#prepaidCardTotalsPanel');
        var $btn = $('.vm-prepaid-totals-btn');
        $panel.hide().attr('aria-hidden', 'true');
        $btn.attr('aria-expanded', 'false');
    }

    function findtotalA() {
        var $panel = $('#prepaidCardTotalsPanel');
        var $btn = $('.vm-prepaid-totals-btn');
        if ($panel.is(':visible')) {
            hidePrepaidCardTotals();
            return;
        }
        $panel.show().attr('aria-hidden', 'false');
        $btn.attr('aria-expanded', 'true');
    }

    function formatPrepaidAmount(value) {
        var num = parseFloat(value);
        if (isNaN(num)) {
            return '0.00';
        }
        return num.toFixed(2);
    }

    function refreshPrepaidCardSummary() {
        var rows = document.querySelectorAll('#prepaidCardReportTable tbody tr:not(.vm-opr-table-empty-row)');
        var count = rows.length;
        var total = 0;
        var success = 0;
        var failed = 0;
        var pending = 0;

        for (var i = 0; i < rows.length; i++) {
            var row = rows[i];
            var amount = parseFloat(row.getAttribute('data-amount') || '0');
            var status = (row.getAttribute('data-status') || '').toUpperCase();
            if (isNaN(amount)) {
                amount = 0;
            }
            total += amount;
            if (status === 'SUCCESS') {
                success += amount;
            } else if (status === 'FAILED') {
                failed += amount;
            } else if (status === 'PENDING') {
                pending += amount;
            }
        }

        $('#prepaidRecordCount').text(count);
        $('#prepaidInlineTotal').text('₹ ' + formatPrepaidAmount(total));
        $('#prepaidTotalSuccess').text(formatPrepaidAmount(success));
        $('#prepaidTotalFailed').text(formatPrepaidAmount(failed));
        $('#prepaidTotalPending').text(formatPrepaidAmount(pending));
    }

    function exportPrepaidCardTable(type) {
        var table = document.getElementById('prepaidCardReportTable');
        if (!table) {
            return;
        }

        var stamp = new Date().toISOString().slice(0, 10);
        var title = 'Prepaid Card Report';
        var clone = table.cloneNode(true);
        var emptyRow = clone.querySelector('.vm-opr-table-empty-row');
        if (emptyRow) {
            alert('No data available to export.');
            return;
        }

        if (type === 'excel') {
            var excelHtml = '<html><head><meta charset="utf-8"></head><body>' + clone.outerHTML + '</body></html>';
            var blob = new Blob(['\ufeff', excelHtml], { type: 'application/vnd.ms-excel' });
            var link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'PrepaidCardReport_' + stamp + '.xls';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            return;
        }

        var printWin = window.open('', '_blank');
        if (!printWin) {
            alert('Please allow pop-ups to export PDF.');
            return;
        }
        printWin.document.write(
            '<html><head><title>' + title + '</title>'
            + '<style>body{font-family:Arial,sans-serif;padding:16px}h3{margin:0 0 12px}table{border-collapse:collapse;width:100%;font-size:10px}th,td{border:1px solid #ccc;padding:4px;text-align:left}th{background:#f3f4f6}</style>'
            + '</head><body><h3>' + title + '</h3>' + clone.outerHTML + '</body></html>'
        );
        printWin.document.close();
        printWin.focus();
        printWin.print();
    }

    function onPrepaidCardReportSuccess() {
        refreshPrepaidCardSummary();
    }

    function onPrepaidCardReportFail() {
        alert('Unable to load prepaid card report. Please try again.');
    }

    function destroyPrepaidSelect2($el) {
        if ($el && $el.length && $el.data('select2')) {
            $el.select2('destroy');
        }
    }

    function applyPrepaidSelect2($el) {
        if (!$el || !$el.length || !$.fn.select2) {
            return;
        }
        destroyPrepaidSelect2($el);
        $el.select2({
            width: '100%',
            minimumResultsForSearch: 6
        });
    }

    function initPrepaidCardSelect2() {
        applyPrepaidSelect2($('#allretailer'));
    }

    function initPrepaidCardDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initPrepaidCardDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm('#prepaidCardReportForm');
        }
    }

    $(document).ready(function () {
        initPrepaidCardSelect2();
        initPrepaidCardDatepickers();
        refreshPrepaidCardSummary();
        $('#prepaidCardReportForm .select2-container').css('width', '100%');

        $('#btnExportA').on('click', function () {
            exportPrepaidCardTable('excel');
        });

        $('#btnPDFA').on('click', function () {
            exportPrepaidCardTable('pdf');
        });
    });
</script>
