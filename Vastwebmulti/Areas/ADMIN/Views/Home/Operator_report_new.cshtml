@model Vastwebmulti.Areas.ADMIN.Models.Multiview
@{
    ViewBag.Title = "Operator_report_new";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    var dateMode = (ViewBag.chk as string) == "post" ? "post" : "get";
    var statusFilter = (Request["ddl_status"] ?? ViewBag.ddl_status as string ?? "").Trim();
    var hasPortStats = (Model.srspending != null && Model.srspending.Any())
        || (Model.srspending_old != null && Model.srspending_old.Any());
    var reportRows = ViewBag.ReportRows as IEnumerable<Vastwebmulti.Models.proc_Recharge_operator_report_newPaging_Result>
        ?? Enumerable.Empty<Vastwebmulti.Models.proc_Recharge_operator_report_newPaging_Result>();
}

<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=2" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-page.css?v=16" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-settings-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-settings-page saas-admin-report-page saas-operator-report-page">
    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-pan-toolbar-unified saas-acc-toolbar--stacked vm-opr-toolbar-unified">
            <div class="saas-acc-toolbar-top vm-opr-toolbar-head">
                <ol class="saas-acc-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>Prepaid &amp; Utility Report</li>
                </ol>

                <div class="vm-opr-toolbar-lookup">
                    @using (Html.BeginForm("Operator_report_new", "Home", FormMethod.Post, new { @class = "vm-opr-quick-search vm-opr-quick-search--toolbar vm-opr-consumer-search-form find find-addclass", data_search_url = Url.Action("_showRechargeReport", "Home") }))
                    {
                        <div class="vm-opr-quick-search__brand">
                            <span class="vm-opr-quick-search__icon" aria-hidden="true"><i class="fas fa-mobile-alt"></i></span>
                            <span class="vm-opr-quick-search__meta">
                                <label class="vm-opr-quick-search__title" for="txtmob">Consumer lookup</label>
                                <span class="vm-opr-quick-search__sub">Search last 30 days</span>
                            </span>
                        </div>
                        <div class="vm-opr-quick-search__field">
                            <i class="fas fa-phone vm-opr-quick-search__field-icon" aria-hidden="true"></i>
                            @Html.TextBox("txtmob", "", new { @class = "form-control vm-opr-quick-search__input", @placeholder = "Enter mobile number", autocomplete = "off", id = "txtmob" })
                        </div>
                        <button type="submit" class="vm-opr-quick-search__btn" title="Search consumer">
                            <i class="fas fa-search" aria-hidden="true"></i>
                            <span>Search</span>
                        </button>
                    }
                </div>

                <div class="vm-opr-page-nav">
                    @Html.Partial("menuoperatorreport")
                </div>
            </div>

                @if (hasPortStats)
                {
                <div class="vm-opr-utility-strip">
                        <div id="all" class="vm-opr-port-chips">
                            @{
                                var oprPortIdx = 0;
                            }
                            @if (Model.srspending != null)
                            {
                                var oprCounts = Model.srspending1 != null ? Model.srspending1.ToList() : new List<Vastwebmulti.Models.SRS_pending_count_ALL_Result>();
                                foreach (var item in Model.srspending)
                                {
                                    var cntVal = oprCounts.Count > oprPortIdx ? oprCounts[oprPortIdx].cnt : null;
                                    <button type="button" class="vm-opr-port-chip @(item.portname == null ? "vm-opr-port-chip--nil" : "")" name="prtname" value="@(item.portname ?? "pen")" onclick="getval(this)">
                                        <span class="vm-opr-port-chip__name">@(item.portname ?? "NILL COM")</span>
                                        <span class="vm-opr-port-chip__count">@(cntVal.HasValue ? cntVal.Value : 0)</span>
                                    </button>
                                    oprPortIdx++;
                                }
                            }
                            else if (Model.srspending_old != null)
                            {
                                var oprCountsOld = Model.srspending1_old != null ? Model.srspending1_old.ToList() : new List<Vastwebmulti.Models.SRS_pending_count_ALL_old_Result>();
                                foreach (var item in Model.srspending_old)
                                {
                                    var cntVal = oprCountsOld.Count > oprPortIdx ? oprCountsOld[oprPortIdx].cnt : null;
                                    <button type="button" class="vm-opr-port-chip @(item.portname == null ? "vm-opr-port-chip--nil" : "")" name="prtname" value="@(item.portname ?? "pen")" onclick="getval(this)">
                                        <span class="vm-opr-port-chip__name">@(item.portname ?? "NILL COM")</span>
                                        <span class="vm-opr-port-chip__count">@(cntVal.HasValue ? cntVal.Value : 0)</span>
                                    </button>
                                    oprPortIdx++;
                                }
                            }
                        </div>
                </div>
                }

            <div class="vm-rpt-filters-panel">
            @using (Html.BeginForm("Operator_report_new", "Home", FormMethod.Post, new { id = "operatorReportForm", @class = "vm-opr-inline-form vm-rpt-filters-panel__form", data_date_mode = dateMode, data_frm_date = frmDate, data_to_date = toDate, data_ddlusers = ViewBag.ddlusers, data_user = ViewBag.user, data_search_url = Url.Action("_showRechargeReport", "Home") }))
            {

                <div class="saas-acc-filter-bar vm-opr-filter-row vm-rpt-filters-panel__bar">

                    <div class="vm-opr-field vm-opr-field--user">
                        @Html.DropDownList("ddlusers", new List<SelectListItem>
                    {
                    new SelectListItem{ Text="All User",Value="Admin"},
                    new SelectListItem{Text="Master",Value="Master"},
                     new SelectListItem{Text="Distributor",Value="Dealer"},
                    new SelectListItem{Text="Retailer",Value="Retailer"},
                      new SelectListItem{Text="Api User",Value="API"},
                      new SelectListItem{Text="Whitelabel",Value="WAdmin"},
                     }, new { @class = "vm-opr-select form-control", @title = "User type" })
                    </div>

                    <div class="vm-opr-field vm-opr-filter-extra" id="allmaster" style="display:none;">
                        @Html.DropDownList("allmaster1", ViewBag.allmaster as SelectList, "All User", new { @class = "vm-opr-select form-control", @title = "Master" })
                    </div>

                    <div class="vm-opr-field vm-opr-filter-extra" id="dlm" style="display:none;">
                        @Html.DropDownList("alldealer", ViewBag.alldealer as SelectList, "All User", new { id = "alldealer", @class = "vm-opr-select form-control", @title = "Distributor" })
                    </div>

                    <div class="vm-opr-field vm-opr-filter-extra" id="rem" style="display:none;">
                        @Html.DropDownList("allretailer", ViewBag.allretailer as SelectList, "All Retailer", new { id = "allretailer", @class = "vm-opr-select form-control", @title = "Retailer" })
                    </div>

                    <div class="vm-opr-field vm-opr-filter-extra" id="apiid" style="display:none;">
                        @Html.DropDownList("API", ViewBag.API as SelectList, "Select API", new { id = "API", @class = "vm-opr-select form-control", @title = "API user" })
                    </div>

                    <div class="vm-opr-field vm-opr-filter-extra" id="whitelabelid" style="display:none;">
                        @Html.DropDownList("Whitelabel", ViewBag.whitelabel as SelectList, "Select Whitelabel", new { id = "Whitelabel", @class = "vm-opr-select form-control", @title = "Whitelabel" })
                    </div>

                    <div class="vm-opr-field vm-opr-field--status">
                        @Html.DropDownList("ddl_status", new List<SelectListItem>
                                 {
                                 new SelectListItem{ Text="ALL STATUS", Value="", Selected = string.IsNullOrEmpty(statusFilter)},
                                 new SelectListItem{ Text="Pending", Value="req", Selected = statusFilter == "req"},
                                 new SelectListItem{ Text="Success", Value="SUCCESS", Selected = string.Equals(statusFilter, "SUCCESS", StringComparison.OrdinalIgnoreCase)},
                                 new SelectListItem{ Text="Failed", Value="FAILED", Selected = string.Equals(statusFilter, "FAILED", StringComparison.OrdinalIgnoreCase)}
                                  }, new { id = "ddl_status", @class = "vm-opr-select form-control", @title = "Status" })
                    </div>

                    <div class="vm-opr-field vm-opr-field--port">
                        @Html.DropDownList("lapuno11", ViewBag.Lapuno as SelectList, "Select Port", new { id = "lapuno11", @class = "vm-opr-select form-control", @title = "Port" })
                    </div>

                    <div class="vm-opr-field vm-opr-field--code" style="display:none;">
                        <select id="txtcode" name="txtcode" class="vm-opr-select form-control" multiple="multiple" onchange="Check(this)" title="Operator codes"></select>
                    </div>

                    <div class="vm-opr-field vm-opr-field--operator">
                        @Html.TextArea("txtdemo", "", new { @style = "display:none;" })
                        @Html.DropDownList("Operator", ViewBag.Operatornew as IEnumerable<SelectListItem>, "All Operators", new { id = "Operator", @class = "vm-opr-select form-control", @title = "Operator" })
                    </div>

                    <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field">
                        <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                        @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                    </div>
                    <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field">
                        <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                        @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                    </div>

                    <button id="btntype_OLD" name="btntype" type="submit" value="Search" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search" title="Search"><i class="fas fa-search" aria-hidden="true"></i><span>Search</span></button>

                    <div class="vm-opr-filter-actions saas-acc-export-group saas-pan-export-group">
                        <button type="button" class="saas-acc-btn saas-acc-btn--excel saas-pan-export-btn" id="btnExport" title="Excel"><i class="fas fa-file-excel" aria-hidden="true"></i> Excel</button>
                        <button type="button" class="saas-acc-btn saas-acc-btn--pdf saas-pan-export-btn" id="btnPDF" title="PDF"><i class="fas fa-file-pdf" aria-hidden="true"></i> PDF</button>
                        <button type="button" class="vm-opr-icon-btn vm-opr-icon-btn--plus vm-opr-totals-btn" onclick="findtotal()" title="Totals"><i class="fas fa-chart-pie" aria-hidden="true"></i></button>
                        <div class="vm-opr-field vm-opr-field--chkbal" id="chkbk" style="display:none">
                            <button type="button" class="vm-opr-chkbal-btn" onclick="page11(this); return false;">CHK BAL</button>
                        </div>
                    </div>

                </div>

            }
            </div>

        </div>

        <div class="vm-opr-totals-panel" style="display:none;">
            <div class="vm-opr-totals-grid">
                <div class="vm-opr-total-card vm-opr-total-card--pending">
                    <span class="vm-opr-total-card__label">Pending</span>
                    <strong class="vm-opr-total-card__value" id="Pendingtotal">�</strong>
                </div>
                <div class="vm-opr-total-card vm-opr-total-card--failed">
                    <span class="vm-opr-total-card__label">Failed</span>
                    <strong class="vm-opr-total-card__value" id="Failedtotal">�</strong>
                </div>
                <div class="vm-opr-total-card vm-opr-total-card--success">
                    <span class="vm-opr-total-card__label">Success</span>
                    <strong class="vm-opr-total-card__value" id="successtotal">�</strong>
                </div>
            </div>
        </div>

        <div class="vm-opr-main-card">

            <div class="vm-opr-table-panel" id="showreport">
                <div class="vm-opr-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-list-alt" aria-hidden="true"></i>
                        <span>Transaction report</span>
                    </div>
                    <span class="vm-opr-table-panel__hint">Scroll horizontally for all columns</span>
                </div>
                <div class="showreport-class vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="example" class="table table-bordered table-striped table-hover third-design-table vm-opr-data-table">
                            <thead>
                                <tr>
                                    <th>S.N</th>
                                    <th>S/B</th>
                                    <th>#&nbsp;User&nbsp;Information</th>
                                    <th>Operator&nbsp;Name</th>
                                    <th>Consumer&nbsp;/&nbsp;Circle</th>
                                    <th>Net&nbsp;?</th>
                                    <th>Opening&nbsp;?</th>
                                    <th>Dr/Cr&nbsp;?</th>
                                    <th>Closing&nbsp;?</th>
                                    <th>Port/API</th>
                                    <th>Charge/Comm</th>
                                    <th>Api-R&nbsp;?</th>
                                    <th>Operator&nbsp;ID</th>
                                    <th>Request&nbsp;Time</th>
                                    <th>Response&nbsp;Time</th>
                                    <th>##</th>
                                </tr>
                            </thead>
                            <tbody id="trow" class="alin chnj">
                                @if (reportRows.Any())
                                {
                                    @Html.Partial("_showRechargeReport", reportRows)
                                }
                                else
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="16" class="vm-opr-table-empty">
                                            <i class="fas fa-inbox" aria-hidden="true"></i>
                                            <span>No transactions for selected filters. Adjust dates or search to load data.</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>



                        </table>


                        <div id="loadingdiv" class="vm-opr-table-loading" style="display:none;">
                            <div class="loadertablecssnew">Loading...</div>
                        </div>
                    </div>
                </div>
            </div>
        </div><!-- vm-opr-main-card -->
    </div>

    <!-- Transaction detail modal (inside page scope for grid CSS) -->
    <div class="modal fade mastetr222Modal saas-admin-modal vm-opr-detail-modal" id="defaultModal222" tabindex="-1" role="dialog" aria-hidden="true" style="display:none;">
        <div class="modal-dialog modal-lg vm-opr-detail-dialog" role="document">
            <div id="loadredmodel" class="vm-opr-detail-loader loadingio-spinner-ripple-92ar2pfqk5j" style="display:none;">
                <div class="ldio-zdyd6mf6t5"><div></div><div></div></div>
            </div>
            <div id="userinfodiv" class="modal-content vm-opr-detail-content">
                <div class="modal-header saas-admin-modal-header vm-opr-detail-header accent-sky">
                    <div class="saas-admin-modal-head-main">
                        <div class="saas-admin-modal-icon vm-opr-detail-header__icon"><i class="fas fa-receipt" aria-hidden="true"></i></div>
                        <div class="vm-opr-detail-header__text">
                            <h4 class="modal-title saas-admin-modal-title">Transaction details</h4>
                            <p class="saas-admin-modal-sub">Wallet split, device info and API request logs</p>
                            <span class="vm-opr-detail-txn-id" id="vmOprDetailTxnId"></span>
                        </div>
                    </div>
                    <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
                </div>
                <div class="modal-body vm-opr-detail-body">
                    @Html.Hidden("Idno")
                    @Html.Hidden("ReceiverName")

                    <div class="vm-opr-detail-panel vm-opr-detail-panel--overview">
                        <div class="vm-opr-detail-panel__head">
                            <i class="fas fa-circle-info" aria-hidden="true"></i>
                            <span>Overview</span>
                        </div>
                        <div class="vm-opr-detail-panel__body vm-opr-detail-grid vm-opr-detail-grid--2">
                            <div class="vm-opr-detail-field vm-opr-detail-field--status" id="vmOprDetailStatusField">
                                <label><i class="fas fa-signal" aria-hidden="true"></i> Status</label>
                                @Html.TextBox("Status", "", new { @class = "form-control vm-opr-detail-input vm-opr-detail-input--status", @readonly = "readonly" })
                            </div>
                            <div class="vm-opr-detail-field">
                                <label><i class="fas fa-mobile-alt" aria-hidden="true"></i> Consumer number</label>
                                @Html.TextBox("ConsumerNo", "", new { @class = "form-control vm-opr-detail-input vm-opr-detail-input--mono", @readonly = "readonly" })
                            </div>
                            <div class="vm-opr-detail-field">
                                <label><i class="fas fa-clock" aria-hidden="true"></i> Request time</label>
                                @Html.TextBox("ReqTime", "", new { @class = "form-control vm-opr-detail-input", @readonly = "readonly" })
                            </div>
                            <div class="vm-opr-detail-field">
                                <label><i class="fas fa-clock-rotate-left" aria-hidden="true"></i> Response time</label>
                                @Html.TextBox("ResTime", "", new { @class = "form-control vm-opr-detail-input", @readonly = "readonly" })
                            </div>
                        </div>
                    </div>

                    <div class="vm-opr-detail-panel vm-opr-detail-panel--wallet">
                        <div class="vm-opr-detail-panel__head">
                            <i class="fas fa-wallet" aria-hidden="true"></i>
                            <span>Wallet &amp; commission</span>
                        </div>
                        <div class="vm-opr-detail-panel__body vm-opr-detail-grid vm-opr-detail-grid--2">
                            <div class="vm-opr-detail-field vm-opr-detail-field--money">
                                <label>Distributor remain ?</label>
                                @Html.TextBox("dlmpost", "", new { @class = "form-control vm-opr-detail-input vm-opr-detail-input--money", @readonly = "readonly" })
                            </div>
                            <div class="vm-opr-detail-field vm-opr-detail-field--money">
                                <label>Master remain ?</label>
                                @Html.TextBox("masterpost", "", new { @class = "form-control vm-opr-detail-input vm-opr-detail-input--money", @readonly = "readonly" })
                            </div>
                            <div class="vm-opr-detail-field vm-opr-detail-field--money">
                                <label>User commission ?</label>
                                @Html.TextBox("UserComm", "", new { @class = "form-control vm-opr-detail-input vm-opr-detail-input--money", @readonly = "readonly" })
                            </div>
                            <div class="vm-opr-detail-field vm-opr-detail-field--money">
                                <label>Distributor ?</label>
                                @Html.TextBox("dlmComm", "", new { @class = "form-control vm-opr-detail-input vm-opr-detail-input--money", @readonly = "readonly" })
                            </div>
                            <div class="vm-opr-detail-field vm-opr-detail-field--money">
                                <label>Master ?</label>
                                @Html.TextBox("mdComm", "", new { @class = "form-control vm-opr-detail-input vm-opr-detail-input--money", @readonly = "readonly" })
                            </div>
                            <div class="vm-opr-detail-field vm-opr-detail-field--money vm-opr-detail-field--highlight">
                                <label>My income ?</label>
                                @Html.TextBox("AdminIncome", "", new { @class = "form-control vm-opr-detail-input vm-opr-detail-input--money vm-opr-detail-input--highlight", @readonly = "readonly" })
                            </div>
                        </div>
                    </div>

                    <div class="vm-opr-detail-panel">
                        <div class="vm-opr-detail-panel__head">
                            <i class="fas fa-shield-halved" aria-hidden="true"></i>
                            <span>Device &amp; source</span>
                        </div>
                        <div class="vm-opr-detail-panel__body vm-opr-detail-grid vm-opr-detail-grid--2">
                            <div class="vm-opr-detail-field">
                                <label>IP address</label>
                                @Html.TextBox("IP", "", new { @class = "form-control vm-opr-detail-input", @readonly = "readonly" })
                            </div>
                            <div class="vm-opr-detail-field">
                                <label>MAC address</label>
                                @Html.TextBox("MAC", "", new { @class = "form-control vm-opr-detail-input", @readonly = "readonly" })
                            </div>
                            <div class="vm-opr-detail-field">
                                <label>Request by</label>
                                @Html.TextBox("ReqType", "", new { @class = "form-control vm-opr-detail-input", @readonly = "readonly" })
                            </div>
                        </div>
                    </div>

                    <div class="vm-opr-detail-cta" id="status_check">
                        <div class="vm-opr-detail-cta__text">
                            <strong>Pending transaction?</strong>
                            <span>Refresh live status from operator port</span>
                        </div>
                        <button type="button" id="status_button" onclick="status_check(this)" class="saas-admin-modal-btn saas-admin-modal-btn--success vm-opr-status-check-btn">
                            <i class="fas fa-arrows-rotate" aria-hidden="true"></i> Check live status
                        </button>
                    </div>

                    <div class="vm-opr-detail-panel vm-opr-detail-panel--logs">
                        <div class="vm-opr-detail-panel__head vm-opr-detail-panel__head--dark">
                            <i class="fas fa-terminal" aria-hidden="true"></i>
                            <span>API logs</span>
                        </div>
                        <div class="vm-opr-detail-panel__body vm-opr-detail-logs vm-opr-detail-grid vm-opr-detail-grid--2">
                            <div class="vm-opr-detail-log">
                                <label>Request URL</label>
                                @Html.TextArea("RequestUrl", "", new { @class = "form-control vm-opr-detail-textarea", @readonly = "readonly", rows = "3" })
                            </div>
                            <div class="vm-opr-detail-log">
                                <label>Recharge response</label>
                                @Html.TextArea("Response", "", new { @class = "form-control vm-opr-detail-textarea", @readonly = "readonly", rows = "3" })
                            </div>
                            <div class="vm-opr-detail-log">
                                <label>CallBack</label>
                                @Html.TextArea("CallBack", "", new { @class = "form-control vm-opr-detail-textarea", @readonly = "readonly", rows = "3" })
                            </div>
                            <div class="vm-opr-detail-log">
                                <label>API request</label>
                                @Html.TextArea("APIRequest", "", new { @class = "form-control vm-opr-detail-textarea", @readonly = "readonly", rows = "3" })
                            </div>
                            <div class="vm-opr-detail-log">
                                <label>API response</label>
                                @Html.TextArea("APIResponse", "", new { @class = "form-control vm-opr-detail-textarea", @readonly = "readonly", rows = "3" })
                            </div>
                            <div class="vm-opr-detail-log">
                                <label>API callback</label>
                                @Html.TextArea("APICallBack", "", new { @class = "form-control vm-opr-detail-textarea", @readonly = "readonly", rows = "3" })
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer saas-admin-modal-footer vm-opr-detail-footer">
