<script>
        (function dedupeOprEmptyRows() {
            var $rows = $('#trow .vm-opr-table-empty-row');
            if ($rows.length > 1) {
                $rows.slice(1).remove();
            }
        })();

        var pageindex = 2;
        var NoMoredata = $('#trow .vm-opr-table-empty-row').length > 0;
        var inProgress = false;

        window.vmOprOnSearchComplete = function (resp) {
            pageindex = 2;
            NoMoredata = $('#trow .vm-opr-table-empty-row').length > 0 || !!(resp && resp.NoMoredata);
            inProgress = false;
            $('#loadingdiv').hide();
        };
    $(window).off('scroll.vmOprReport').on('scroll.vmOprReport', function () {
        if ($(window).scrollTop() > Number($("#example").height()) / 4 && !NoMoredata && !inProgress) {
                inProgress = true;
                $("#loadingdiv").show();
                var scrollPayload = typeof window.vmOprGetFilterPayload === 'function'
                    ? window.vmOprGetFilterPayload()
                    : {};
                scrollPayload.pageindex = pageindex;
                scrollPayload.txtdemo = $('#txtdemo').val() || scrollPayload.txtdemo || '';

                $.ajax({
                    url: "@Url.Action("InfiniteScroll","Home")",
                    type: "POST",
                    dataType: "json",
                    data: scrollPayload
                }).done(function (data) {
                        pageindex = pageindex + 1;
                        if (data) {
                            if (data.NoMoredata !== undefined) {
                                NoMoredata = data.NoMoredata;
                            } else if (data.noMoredata !== undefined) {
                                NoMoredata = data.noMoredata;
                            }
                        }
                        var html = data && (data.HTMLString || data.htmlString) ? String(data.HTMLString || data.htmlString) : '';
                        if (html && html.indexOf('vm-opr-table-empty-row') === -1) {
                            $('#trow .vm-opr-table-empty-row').remove();
                            $("#trow").append(html);
                        }
                        $("#loadingdiv").hide();
