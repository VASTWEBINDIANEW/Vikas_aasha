<script>
    function converttoDate(str) {
        var date = new Date(str),
            mnth = ("0" + (date.getMonth() + 1)).slice(-2),
            day = ("0" + date.getDate()).slice(-2),
            Hrs = (date.getHours()),
            mnts = (date.getMinutes()),
            sec = (date.getSeconds());
        return dd = [day, mnth, date.getFullYear()].join("-") + " " + [Hrs + ":" + mnts + ":" + sec];
    }

    function ActionBtn(Idno) {
        $.ajax({
            url: '@Url.Action("Recharge_report_View", "Home")',
            type: 'POST',
            data: { Idno: Idno },
            cache: false,
            success: function (ResponseRch) {

                $('#Idno').val(ResponseRch[0].idno)
                $('#vmOprDetailTxnId').text('Transaction #' + ResponseRch[0].idno)
                var $statusField = $('#vmOprDetailStatusField');
                $statusField.removeClass('is-pending is-success is-failed is-refund');
                var st = (ResponseRch[0].rstatus || '').toUpperCase();
                if (st.indexOf('REQUEST') >= 0 || st === 'PENDING') {
                    $statusField.addClass('is-pending');
                } else if (st.indexOf('SUCCESS') >= 0) {
                    $statusField.addClass('is-success');
                } else if (st.indexOf('FAILED') >= 0) {
                    $statusField.addClass('is-failed');
                } else if (st.indexOf('REFUND') >= 0 || st === 'RESEND') {
                    $statusField.addClass('is-refund');
                }
                if (ResponseRch[0].rstatus == "Request Send") {
                    $('#status_check').show();
                }
                else {
                    $('#status_check').hide();
                }

                $('#ConsumerNo').val(ResponseRch[0].mobile)
                $('#Status').val(ResponseRch[0].rstatus)
                $('#ReceiverName').val(ResponseRch[0].recivername)
                $('#ReqTime').val(converttoDate(eval(("new " + ResponseRch[0].Rch_time).replace(/\//g, ""))))

                if (ResponseRch[0].resp_time !=null) {
                    $('#ResTime').val(converttoDate(eval(("new " + ResponseRch[0].resp_time).replace(/\//g, ""))))
                }
                else {
                    $('#ResTime').val('')
                }

                document.querySelector('#status_check button').setAttribute("userid", Idno);

                $('#UserComm').val(ResponseRch[0].income)
                $('#dlmComm').val(ResponseRch[0].dealerincome)
                $('#mdComm').val(ResponseRch[0].masterincome)
                $('#dlmpost').val(ResponseRch[0].dealerremain)
                $('#masterpost').val(ResponseRch[0].masterremain)
                $('#AdminIncome').val(ResponseRch[0].adminincome)
                $('#ReqType').val(ResponseRch[0].rch_type)
                $('#IP').val(ResponseRch[0].ipaddress)
                $('#MAC').val(ResponseRch[0].macaddress)
                $('#RequestUrl').val(ResponseRch[0].recharge_request)
                $('#Response').val(ResponseRch[0].recharge_response)
                $('#CallBack').val(ResponseRch[0].responseoutput)
                $('#APIRequest').val(ResponseRch[0].api_request)
                $('#APIResponse').val(ResponseRch[0].api_response)
                $('#APICallBack').val(ResponseRch[0].api_response_output)
            }
        });
    }

    function status_check(e) {
        var idno = e.getAttribute('userid');

        if (idno) {
            fetch('@Url.Action("getStatusCheck")?idno=' + idno)
                .then(res => res.json())
                .then(data => {
                    console.log(data);
                    swal(data.status, "Mobile: " + data.mobile + ", Amount: " + data.amount + ", OperatorId: " + data.operatorid, "success", {
                        button: "Aww yiss!",
                    });
                    if (["success", "failed"].includes(data.status)) {
                        setTimeout(() => window.location.reload(), 2000);
                    }
                })
                .catch(err => console.error(err));
        }
    }

</script>


