@model Vastwebmulti.Areas.ADMIN.ViewModel.EmployeePermissionViewmodel
@{
    ViewBag.Title = "ShowEmployeeWithPermission";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=42" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=27" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-api-user-page.css?v=10" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-emp-permission-page">

    @* -- The form wraps the entire page so checkboxes + hidden field are all submitted together -- *@
    @using (Html.BeginForm("AddpermisionForServices", "Home", FormMethod.Post, new { id = "permissionSaveForm" }))
    {
        @* Hidden field updated by JS when employee is selected *@
        <input type="hidden" id="EmployeeIDforpart" name="EmployeeIDforpart" value="" />

        <div class="container-fluid vm-opr-page-shell">

            <!-- -- Toolbar: Breadcrumb + Employee Selector + Save Button -- -->
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">
                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line vm-gift-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard","Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>User's &amp; Account</li>
                        <li>Employee Permission</li>
                    </ol>

                    <div class="vm-emp-toolbar-right">
                        <div class="vm-emp-select-wrap">
                            @Html.DropDownListFor(m => m.EmployeenameID, Model.Employeenames, "Select Employee",
                                new { @class = "form-control vm-opr-select vm-dmt-select vm-emp-select-input", id = "EmployeenameID" })
                        </div>
                        <button type="submit" id="btnsubmit" class="vm-ep-save-btn">
                            <i class="fas fa-save"></i> Save Permission
                        </button>
                    </div>

                </div>
            </div>

            <!-- -- Permission Cards Area -- -->
            <div class="vm-opr-main-card vm-security-report-main-card vm-emp-permission-main-card">
                <div class="vm-opr-table-panel vm-security-report-table-panel vm-emp-permission-panel">
                    <div class="vm-opr-table-panel__head vm-dmt-table-panel__head vm-security-report-table-head">
                        <div class="vm-opr-table-panel__title">
                            <i class="fas fa-user-shield" aria-hidden="true"></i>
                            <span>Employee Service Permissions</span>
                        </div>
                        <div class="vm-dmt-table-panel__right">
                            <span class="vm-radiant-record-badge" id="emp-perm-name-badge" style="display:none;">
                                <i class="fas fa-user" style="margin-right:4px;"></i>
                                <strong id="emp-selected-name"></strong>
                            </span>
                        </div>
                    </div>

                    <!-- AJAX target: permission cards rendered here (inside the form) -->
                    <div id="tblpermission" class="vm-emp-perm-body">
                        <div class="vm-emp-perm-empty">
                            <i class="fas fa-user-shield"></i>
                            <p>Select an employee above to manage their service permissions.</p>
                        </div>
                    </div>

                </div>
            </div>

        </div>
    }

</section>

<!-- Loading overlay -->
<div id="div_Loader" style="display:none;position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:9999;align-items:center;justify-content:center;">
    <div style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);">
        <div class="loadingio-spinner-ripple-92ar2pfqk5j" style="background:transparent;">
            <div class="ldio-zdyd6mf6t5"><div></div><div></div></div>
        </div>
    </div>
</div>

<style>
    @@keyframes ldio-zdyd6mf6t5 {
        0%   { top:96px;left:96px;width:0;height:0;opacity:1; }
        100% { top:18px;left:18px;width:156px;height:156px;opacity:0; }
    }
    .ldio-zdyd6mf6t5 div { position:absolute;border-width:4px;border-style:solid;opacity:1;border-radius:50%;animation:ldio-zdyd6mf6t5 1s cubic-bezier(0,.2,.8,1) infinite;box-sizing:content-box; }
    .ldio-zdyd6mf6t5 div:nth-child(1) { border-color:var(--main-bg-lcolor); }
    .ldio-zdyd6mf6t5 div:nth-child(2) { border-color:#c7c7c7;animation-delay:-.5s; }
    .loadingio-spinner-ripple-92ar2pfqk5j { width:200px;height:200px;display:inline-block;overflow:hidden; }
    .ldio-zdyd6mf6t5 { width:100%;height:100%;position:relative;transform:translateZ(0) scale(1);backface-visibility:hidden;transform-origin:0 0; }

    /* Empty state */
    .vm-emp-perm-empty { display:flex;flex-direction:column;align-items:center;justify-content:center;padding:48px 24px;color:#94a3b8;text-align:center; }
    .vm-emp-perm-empty i { font-size:2.8rem;margin-bottom:12px;opacity:.35; }
    .vm-emp-perm-empty p { font-size:.85rem;font-weight:500; }
    .vm-emp-perm-body { padding:16px 20px; }

    /* Toolbar right � employee selector + save button side by side */
    .vm-emp-toolbar-right {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-left: auto;
        flex-shrink: 0;
    }
    @@media (max-width: 767px) {
        .saas-emp-permission-page .vm-opr-toolbar-head { flex-direction: column !important; gap: 8px !important; align-items: flex-start !important; }
        .vm-emp-toolbar-right { margin-left: 0 !important; width: 100%; flex-wrap: wrap; }
        .vm-emp-select-wrap { flex: 1; min-width: 0; }
        .vm-ep-save-btn { width: 100%; justify-content: center; }
    }
</style>

<script>
    function loadEmployeePermissions(val, empName) {
        if (!val) return;
        /* update the hidden field so Save Permission knows which employee */
        $('#EmployeeIDforpart').val(val);
        $('#emp-selected-name').text(empName);
        $('#emp-perm-name-badge').show();
        $('#div_Loader').css('display', 'flex');
        $.ajax({
            url: '@Url.Action("ShowAllServicesforpermission", "Home")',
            data: { EId: val },
            cache: false,
            type: 'GET',
            success: function (data) {
                $('#tblpermission').html(data);
                $('#div_Loader').hide();
            },
            error: function () {
                $('#tblpermission').html('<div class="vm-emp-perm-empty"><i class="fas fa-exclamation-circle"></i><p>Failed to load permissions. Please try again.</p></div>');
                $('#div_Loader').hide();
            }
        });
    }

    $(document).ready(function () {
        if (window.bootAdminSelect2) { window.bootAdminSelect2(); }
        $('#EmployeenameID').on('select2:select', function (e) {
            loadEmployeePermissions(e.params.data.id, e.params.data.text);
        });
        /* select2:unselect / clearing placeholder */
        $('#EmployeenameID').on('select2:unselect', function () {
            $('#EmployeeIDforpart').val('');
            $('#emp-perm-name-badge').hide();
        });
        /* native change — fires when select2 is NOT loaded */
        $('#EmployeenameID').on('change', function () {
            if ($.fn.select2) return;
            var val = $(this).val();
            var empName = $(this).find('option:selected').text();
            loadEmployeePermissions(val, empName);
        });
    });
</script>
