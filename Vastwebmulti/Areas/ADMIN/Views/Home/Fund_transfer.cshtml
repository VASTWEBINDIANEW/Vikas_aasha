<script>


    function bootFundTransferPageSelect2() {
        if (!window.jQuery || !$.fn.select2) {
            return;
        }
        refreshFundTransferSelect2();
        refreshFundTransferHistorySelect2();
    }

    window.bootFundTransferPageSelect2 = bootFundTransferPageSelect2;

    $(document).ready(function () {
        var hashTab = window.location.hash ? window.location.hash.substring(1) : '';
        if (hashTab && $('#' + hashTab).length) {
            $('#tabs a[href="#' + hashTab + '"]').trigger('click');
        } else {
            activateLeftFundTab('home');
            setFundTransferHistoryFilterVisibility('home');
            runFundTransferHistorySearch();
        }

        $(document).on('click', '#btnchangetabbutton', function (e) {
            e.preventDefault();
            runFundTransferHistorySearch();
        });

        $(document).on('change', '#select-search', function () {
            runFundTransferHistorySearch();
        });

        $(document).on('click', '#tblshowMasterD tr[data-target]', function (e) {
            var target = $(this).attr('data-target');
            if (!target) {
                return;
            }
            e.preventDefault();
            e.stopPropagation();
            window.setTimeout(function () {
                if (window.showAdminModal) {
                    window.showAdminModal(target);
                } else {
                    $(target).modal('show');
                }
            }, 0);
        });

        $('#tabs').attr('role', 'tablist');
        $('#tabs li a').attr('role', 'tab');

        $('#tabs li a').on('keydown', function (e) {
            if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft' && e.key !== 'Home' && e.key !== 'End') {
                return;
            }
            e.preventDefault();
            var $items = $('#tabs li a');
            var idx = $items.index(this);
            if (e.key === 'ArrowRight') {
                idx = (idx + 1) % $items.length;
            } else if (e.key === 'ArrowLeft') {
                idx = (idx - 1 + $items.length) % $items.length;
            } else if (e.key === 'Home') {
                idx = 0;
            } else if (e.key === 'End') {
                idx = $items.length - 1;
            }
            $items.eq(idx).focus().trigger('click');
        });

        $("#txtsearch").on("input", function () {
            runFundTransferHistorySearch();
        });
    });

    $(window).on('load', function () {
        window.setTimeout(function () {
            bootFundTransferPageSelect2();
        }, 100);
    });
</script>

<script>
    function fillFundTransferLinkedField(selectEl) {
        var map = {
            bankid: 'txtsupraccno',
            ddlsuprwalletname: 'txtsuprwalletno',
            DISTRIbankid: 'txtDISTACCOUNTNO',
            ddlDISTwalletname: 'txtDISTWALLETNO',
            RETRIbankid: 'txtRETACCOUNTNO',
            ddlRETwalletname: 'txtRETWALLETNO',
            APIRIbankid: 'txtAPIACCOUNTNO',
            ddlAPIwalletname: 'txtAPIWALLETNO',
            WLRIbankid: 'txtWLACCOUNTNO',
            ddlWLwalletname: 'txtWLWALLETNO'
        };
        if (!selectEl || !selectEl.id || !map[selectEl.id]) {
            return;
        }
        var input = document.getElementById(map[selectEl.id]);
        if (!input) {
            return;
        }
        var val = (selectEl.value || '').trim();
        if (!val || val === '0' || val.toLowerCase().indexOf('select') >= 0) {
            input.value = '';
            return;
        }
        input.value = val;
        if (window.jQuery) {
            window.jQuery(input).trigger('input').trigger('change');
        }
    }

    window.fillFundTransferLinkedField = fillFundTransferLinkedField;

    function bindFundTransferBankAutoFill() {
        var $ = window.jQuery;
        if (!$ || !$.fn) {
            window.setTimeout(bindFundTransferBankAutoFill, 50);
            return;
        }
        var selector = '#bankid, #ddlsuprwalletname, #DISTRIbankid, #ddlDISTwalletname, #RETRIbankid, #ddlRETwalletname, #APIRIbankid, #ddlAPIwalletname, #WLRIbankid, #ddlWLwalletname';
        $(document)
            .off('change.ftBankFill select2:select.ftBankFill', selector)
            .on('change.ftBankFill select2:select.ftBankFill', selector, function () {
                fillFundTransferLinkedField(this);
            });
    }

    window.bindFundTransferBankAutoFill = bindFundTransferBankAutoFill;

    function destroyFundTransferSelect2($el) {
        if (!$el || !$el.length) {
            return;
        }
        if ($el.hasClass('select2-hidden-accessible')) {
            try {
                $el.select2('destroy');
            } catch (e) { /* ignore stale instances */ }
        }
        $el.next('.select2-container').remove();
    }

    function isFundTransferSelectVisible($el) {
        var $historyWrap = $el.closest('#masterdrop, #dealerdrop, #retailerdrop, #apidrop, #whitedrop');
        if ($historyWrap.length) {
            return $historyWrap.is(':visible');
        }
        var $tabPane = $el.closest('.tab-pane');
        if ($tabPane.length) {
            return $tabPane.hasClass('active') && $tabPane.is(':visible');
        }
        return $el.is(':visible');
    }

    function refreshFundTransferSelect2($scope) {
        if (!window.jQuery || !$.fn.select2) {
            return;
        }

        var $targets;
        if ($scope && $scope.length) {
            $targets = $scope.is('select') ? $scope : $scope.find('select.for-select2, select.form-control');
        } else {
            $targets = $('.saas-fund-transfer-page .tab-pane.active select.for-select2, .saas-fund-transfer-page .vm-ft-history-toolbar select.for-select2');
        }

        $targets.each(function () {
            var $el = $(this);
            if (!$el.hasClass('for-select2') && !$el.closest('.vm-ft-history-toolbar, .fund-transfer-form').length) {
                return;
            }
            destroyFundTransferSelect2($el);

            if (!isFundTransferSelectVisible($el)) {
                return;
            }

            $el.select2(window.getAdminSelect2Options ? window.getAdminSelect2Options($el) : {
                width: '100%',
                dropdownAutoWidth: false,
                dropdownParent: $(document.body),
                minimumResultsForSearch: 0,
                allowClear: false,
                language: {
                    noResults: function () { return 'No match found'; },
                    searching: function () { return 'Searching...'; },
                    inputTooShort: function () { return 'Type to search...'; }
                }
            });
            fillFundTransferLinkedField(this);
        });
    }

    window.refreshFundTransferSelect2 = refreshFundTransferSelect2;

    function refreshFundTransferHistorySelect2() {
        var tabtype = typeof getActiveFundTransferTabType === 'function' ? getActiveFundTransferTabType() : 'home';
        var filterMap = {
            home: '#masterdrop',
            menu1: '#dealerdrop',
            menu2: '#retailerdrop',
            menu3: '#apidrop',
            menu4: '#whitedrop'
        };
        var $wrap = $(filterMap[tabtype] || filterMap.home);
        refreshFundTransferSelect2($wrap);
        refreshFundTransferSelect2($('#select-search'));
    }

    window.refreshFundTransferHistorySelect2 = refreshFundTransferHistorySelect2;

    function setFundTransferHistoryFilterVisibility(tabID) {
        var filterMap = {
            home: '#masterdrop',
            menu1: '#dealerdrop',
            menu2: '#retailerdrop',
            menu3: '#apidrop',
            menu4: '#whitedrop'
        };
        $('#masterdrop, #dealerdrop, #retailerdrop, #apidrop, #whitedrop').hide();
        $(filterMap[tabID] || filterMap.home).show();
        window.setTimeout(function () {
            refreshFundTransferHistorySelect2();
        }, 0);
    }

    function applyFundTransferClientFilters(tabtype) {
        if (tabtype !== 'menu3' && tabtype !== 'menu4') {
            return;
        }
        var paymode = (getFundTransferSelectValue('select-search') || '').toLowerCase();
        var txtsearch = $.trim($('#txtsearch').val() || '').toLowerCase();
        if (!paymode && !txtsearch) {
            return;
        }
        $('#tblshowMasterD tbody tr').each(function () {
            var $tr = $(this);
            if ($tr.find('td[colspan]').length) {
                return;
            }
            var rowText = $tr.text().toLowerCase();
            var match = true;
            if (paymode) {
                match = rowText.indexOf(paymode) >= 0;
            }
            if (match && txtsearch) {
                match = rowText.indexOf(txtsearch) >= 0;
            }
            $tr.toggle(match);
        });
    }

    function getActiveFundTransferTabType() {
        var tabtype = $('#tabs li.tab-link.active').attr('data-tabname');
        if (!tabtype) {
            tabtype = $('.tabcurrent-seconddesign .tab-pane.active').attr('id');
        }
        if (!tabtype && window.location.hash) {
            tabtype = window.location.hash.substring(1);
        }
        return tabtype || 'home';
    }

    function getFundTransferSelectValue(id) {
        var $el = $('#' + id);
        if (!$el.length) {
            return '';
        }
        var val = $el.val();
        return (val === null || val === undefined) ? '' : val;
    }

    function getFundTransferHistoryUser(tabtype) {
        var fieldMap = {
            home: 'SuperstokistID1',
            menu1: 'ddlDistributor1',
            menu2: 'RLMID1',
            menu3: 'APIUSER1',
            menu4: 'WLUSER1'
        };
        return getFundTransferSelectValue(fieldMap[tabtype] || fieldMap.home);
    }

    function getFundTransferDateValue(id) {
        var $el = $('#' + id);
        if (!$el.length) {
            return '';
        }
        var val = $.trim($el.val() || '');
        if (val) {
            return val;
        }
        if ($el.data('datepicker')) {
            var d = $el.datepicker('getDate');
            if (d) {
                var month = ('0' + (d.getMonth() + 1)).slice(-2);
                var day = ('0' + d.getDate()).slice(-2);
                return d.getFullYear() + '-' + month + '-' + day;
            }
        }
        return '';
    }

    function runFundTransferHistorySearch() {
        var tabtype = getActiveFundTransferTabType();
        var usernm = getFundTransferHistoryUser(tabtype);
        var paymode = getFundTransferSelectValue('select-search');
        var txt_frm_date = getFundTransferDateValue('txt_frm_date');
        var txt_to_date = getFundTransferDateValue('txt_to_date');
        var txtsearch = $.trim($('#txtsearch').val() || '');

        $.ajax({
            url: "@Url.Action("TABCHANGEFORFUNDTRANSFER","Home")",
            type: 'GET',
            cache: false,
            data: {
                nameoftab: tabtype,
                usernm: usernm,
                txt_frm_date: txt_frm_date,
                txt_to_date: txt_to_date,
                paymode: paymode,
                txtsearch: txtsearch
            },
            success: function (data) {
                $('#tblshowMasterD').html(data);
                applyFundTransferClientFilters(tabtype);
            }
        });
    }

    function cahangeTab(name) {
        setFundTransferHistoryFilterVisibility(name);
        runFundTransferHistorySearch();
    }

    function wrapFundTransferModeHandlers() {
        ['changemode', 'changemoded', 'changemoder', 'changemodea', 'changemodew'].forEach(function (fnName) {
            var original = window[fnName];
            if (typeof original !== 'function' || original.__ftWrapped) {
                return;
            }
            var wrapped = function () {
                var result = original.apply(this, arguments);
                var $pane = $(this).closest('.tab-pane');
                window.setTimeout(function () {
                    refreshFundTransferSelect2($pane.length ? $pane : null);
                    if (typeof window.bindFundTransferBankAutoFill === 'function') {
                        window.bindFundTransferBankAutoFill();
                    }
                }, 0);
                return result;
            };
            wrapped.__ftWrapped = true;
            window[fnName] = wrapped;
        });
    }

    $(function () {
        wrapFundTransferModeHandlers();
        if (typeof window.bindFundTransferBankAutoFill === 'function') {
            window.bindFundTransferBankAutoFill();
        }
    });
</script>
