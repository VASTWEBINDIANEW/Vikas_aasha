@using Vastwebmulti.Models;
@model Vastwebmulti.Areas.ADMIN.Models.Fundtransferviewmodel
@{
    ViewBag.Title = "Fund_transfer";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";
}
@{
    VastwebmultiEntities DB = new VastwebmultiEntities();
    string hspass = "OK";
    var chksec = DB.admin_new_pass.SingleOrDefault();
    DateTime currenttime = DateTime.Now;
    DateTime lastchangedpassdss = Convert.ToDateTime(chksec.lastupdatetrans);
    lastchangedpassdss = lastchangedpassdss.AddDays(Convert.ToInt32(chksec.transexpdays));
    if (chksec.transpass == "lOW3n9XMM8fCuXPLyaQkkQ==" || (lastchangedpassdss <= currenttime))
    {
        hspass = "NOTOK";
    }
}

@helper FundTransferUserDetails(string boxId, string title, string prefix, string iconClass, string nameFieldId = null)
{
    var nameId = string.IsNullOrEmpty(nameFieldId) ? ("lbl" + prefix + "name") : nameFieldId;
    <div id="@boxId" class="vm-ft-user-details col-md-12 col-sm-12 col-xs-12" style="display:none;">
        <div class="vm-ft-user-details__card">
            <div class="vm-ft-user-details__head">
                <span class="vm-ft-user-details__icon"><i class="fas @iconClass" aria-hidden="true"></i></span>
                <span class="vm-ft-user-details__title">@title</span>
            </div>
            <div class="vm-ft-user-details__grid">
                <div class="vm-ft-user-details__item">
                    <span class="vm-ft-user-details__label"><i class="fas fa-building" aria-hidden="true"></i> Firm Name</span>
                    <strong class="vm-ft-user-details__value" id="@("lbl" + prefix + "frmname")">N/A</strong>
                </div>
                <div class="vm-ft-user-details__item">
                    <span class="vm-ft-user-details__label"><i class="fas fa-user" aria-hidden="true"></i> Name</span>
                    <strong class="vm-ft-user-details__value" id="@nameId">N/A</strong>
                </div>
                <div class="vm-ft-user-details__item">
                    <span class="vm-ft-user-details__label"><i class="fas fa-mobile-alt" aria-hidden="true"></i> Mobile</span>
                    <strong class="vm-ft-user-details__value" id="@("lbl" + prefix + "mobile")">N/A</strong>
                </div>
                <div class="vm-ft-user-details__item">
                    <span class="vm-ft-user-details__label"><i class="fas fa-envelope" aria-hidden="true"></i> Email ID</span>
                    <strong class="vm-ft-user-details__value" id="@("lbl" + prefix + "email")">N/A</strong>
                </div>
                <div class="vm-ft-user-details__item vm-ft-user-details__item--full">
                    <span class="vm-ft-user-details__label"><i class="fas fa-map-marker-alt" aria-hidden="true"></i> Address</span>
                    <strong class="vm-ft-user-details__value" id="@("lbl" + prefix + "address")">N/A</strong>
                </div>
            </div>
        </div>
    </div>
}

