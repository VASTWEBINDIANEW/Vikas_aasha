            container: 'body'
        };

        var $frm = $("#txt_frm_date");
        var $to = $("#txt_to_date");

        $frm.datepicker(dateOpts);
        $to.datepicker(dateOpts);

        $frm.on('focus', function () {
            $(this).datepicker('show');
        });
        $to.on('focus', function () {
            $(this).datepicker('show');
        });

        $('.saas-fund-transfer-page .saas-acc-dp-icon').on('click', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var $input = $(this).closest('.saas-acc-dp-field').find('.saas-acc-dp-input');
            if ($input.length && $input.data('datepicker')) {
                $input.datepicker('show');
            }
        });

        $frm.on('show', function () {
            $(this).closest('.saas-acc-dp-field').addClass('is-active');
        }).on('hide changeDate', function () {
            $(this).closest('.saas-acc-dp-field').removeClass('is-active');
        });

        $to.on('show', function () {
            $(this).closest('.saas-acc-dp-field').addClass('is-active');
        }).on('hide changeDate', function () {
            $(this).closest('.saas-acc-dp-field').removeClass('is-active');
        });

        $('.input-daterange').datepicker(dateOpts);

        var val = '@ViewBag.chk';
        if (val != "post") {
            $frm.datepicker("setDate", new Date());
            $to.datepicker("setDate", new Date());
        }
    })



</script>
<script>
    (function () {
        function startFundTransferBankAutoFill() {
            if (typeof window.bindFundTransferBankAutoFill === 'function') {
                window.bindFundTransferBankAutoFill();
            }
        }
        startFundTransferBankAutoFill();
        window.addEventListener('load', function () {
            startFundTransferBankAutoFill();
            window.setTimeout(startFundTransferBankAutoFill, 200);
            window.setTimeout(startFundTransferBankAutoFill, 700);
        });
        document.addEventListener('change', function (e) {
            var t = e.target;
            if (!t || !t.id) {
                return;
            }
            if (typeof window.fillFundTransferLinkedField === 'function') {
                window.fillFundTransferLinkedField(t);
            }
        }, true);
    })();
</script>






