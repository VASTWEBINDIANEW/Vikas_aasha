<script>



    function parseFundTransferSelectLabel(text) {
        var label = $.trim(text || '');
        if (!label) {
            return null;
        }
        var lower = label.toLowerCase();
        if (lower.indexOf('select') >= 0 || lower.indexOf('please') >= 0 || label === '--Select--') {
            return null;
        }
        var dashIdx = label.lastIndexOf(' - ');
        if (dashIdx > 0) {
            return {
                firm: label.substring(0, dashIdx).trim(),
                mobile: label.substring(dashIdx + 3).trim(),
                name: label.substring(0, dashIdx).trim()
            };
        }
        return { firm: label, mobile: '', name: label };
    }

    function hideFundTransferUserDetails(prefix) {
        $('#' + prefix + '_details').hide();
    }

    function hideAllFundTransferUserDetails() {
        $('.vm-ft-user-details').hide();
    }

    function setUserDetailField(selector, value, hideIfEmpty) {
        var $el = $(selector);
        if (!$el.length) {
            return;
        }
        var $item = $el.closest('.vm-ft-user-details__item');
        var text = $.trim(value || '');
        if (!text || text === 'N/A') {
            if (hideIfEmpty) {
                $item.hide();
                $el.text('');
            } else {
                $item.show();
                $el.text('N/A');
            }
            return;
        }
        $item.show();
        $el.text(text);
    }

    function fillFundTransferUserDetailsFromSelect(prefix, $select) {
        var $box = $('#' + prefix + '_details');
        if (!$select || !$select.length || !$.trim($select.val() || '')) {
            $box.hide();
            return;
        }
        var parsed = parseFundTransferSelectLabel($select.find('option:selected').text());
        if (!parsed || !parsed.firm) {
            $box.hide();
            return;
        }
        $box.show();
        setUserDetailField('#lbl' + prefix + 'frmname', parsed.firm, false);
        if ($('#lbl' + prefix + 'name').length) {
            setUserDetailField('#lbl' + prefix + 'name', parsed.name || parsed.firm, false);
        }
        setUserDetailField('#lbl' + prefix + 'mobile', parsed.mobile, true);
        setUserDetailField('#lbl' + prefix + 'email', '', true);
        setUserDetailField('#lbl' + prefix + 'address', '', true);
    }

    function fillRetailerUserDetailsFromApi(data) {
        var $box = $('#retailer_details');
        var retailerId = $.trim($('#RLMID').val() || '');
        if (!retailerId || !data || !data.reinfo) {
            $box.hide();
            return;
        }
        var r = data.reinfo;
        $box.show();
        setUserDetailField('#lblretailerfrmname', r.Frm_Name, false);
        setUserDetailField('#lblre4tailername', r.RetailerName, false);
        setUserDetailField('#lblretailermobile', r.Mobile, true);
        setUserDetailField('#lblretaileremail', r.Email, true);
        setUserDetailField('#lblretaileraddress', r.Address, true);
    }

