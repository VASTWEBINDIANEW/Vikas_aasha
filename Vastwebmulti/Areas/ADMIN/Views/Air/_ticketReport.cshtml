@model List<Vastwebmulti.Models.proc_FlightReport_Result>

@{

    Layout = null;

    var items = Model == null ? new List<Vastwebmulti.Models.proc_FlightReport_Result>() : Model;

}

@if (items.Count > 0)

{

    foreach (var item in items)

    {

        var statusTone = "pending";

        var statusFa = "fa-clock-o";

        var sts = ((Vastwebmulti.Areas.RETAILER.Enums.TicketStatus)Convert.ToInt32(item.TicketStatusCode)).ToString();



        if (item.TicketStatus.Contains("FAILED"))

        {

            statusTone = "failed";

            statusFa = "fa-times";

        }

        else if (item.TicketStatus.Contains("Success"))

        {

            statusTone = "success";

            statusFa = "fa-check";

        }

        else if (item.TicketStatus.ToUpper().Contains("REFUND"))

        {

            statusTone = "refund";

            statusFa = "fa-undo";

        }

        else if (item.TicketStatus.ToUpper().Contains("PENDING"))

        {

            statusTone = "pending";

            statusFa = "fa-clock-o";

        }



        <tr class="vm-dmt-row vm-dmt-row--@statusTone">

            <td class="vm-ticket-status-cell">

                <span class="vm-dmt-status vm-dmt-status--@statusTone" title="@item.TicketStatus">

                    <i class="fa @statusFa" aria-hidden="true"></i>

                </span>

                <span class="vm-ticket-status-text">@item.TicketStatus</span>

            </td>

            <td>@sts</td>

            <td>@item.Frm_Name</td>

            <td>@item.LeadPaxFirstName @item.LeadPaxLastName</td>

            <td>@item.AirlineName</td>

            <td>@item.BookingId</td>

            <td class="vm-ticket-pnr-cell">@item.PNR</td>

            <td class="vm-ticket-time-cell">@String.Format("{0:dd-MMM HH:mm:ss}", item.TicketDate)</td>

            <td class="vm-dmt-amt-cell">@Math.Round(item.FareAmount, 2)</td>

            <td class="vm-ticket-action-cell">

                @if (!item.TicketStatus.Contains("Refund"))

                {

                    <button type="button" class="vm-dmt-act-btn vm-dmt-act-btn--info" title="Current Status" onclick="getTicketStatus('@item.TraceId','@item.BookingId','@item.PNR')">

                        <i class="fa fa-info-circle" aria-hidden="true"></i>

                    </button>

                }

            </td>

            <td class="vm-dmt-action-cell">

                <div class="nrch vm-dmt-action-bar">

                    @if (item.TicketStatusCode == 1 && item.ResponseJson != null && item.ResponseJson.Contains("TicketId"))

                    {

                        <a href="@Url.Action("ViewTicket","Air",new { idno = item.idno, firsName = item.LeadPaxFirstName, lastName = item.LeadPaxLastName})" target="_blank" class="vm-dmt-act-btn vm-dmt-act-btn--print" title="Print ticket">

                            <i class="fa fa-print" aria-hidden="true"></i>

                        </a>

                    }

                    <button type="button" class="vm-dmt-act-btn vm-dmt-act-btn--detail" title="View details" onclick="ticketActionBtn('@item.idno')">

                        <i class="fa fa-angle-double-right" aria-hidden="true"></i>

                    </button>

                </div>

            </td>

        </tr>

    }

}

else

{

    <tr class="vm-opr-table-empty-row">

        <td colspan="11" class="vm-opr-table-empty vm-dmt-table-empty">

            <i class="fas fa-plane" aria-hidden="true"></i>

            <span>Flight ticket report not found.</span>

        </td>

    </tr>

}

