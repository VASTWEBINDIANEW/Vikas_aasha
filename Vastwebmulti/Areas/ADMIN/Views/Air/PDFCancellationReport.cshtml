@model List<Vastwebmulti.Models.proc_FlightCancellationReport_Result>
@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>PDF Cancellation Report</title>
    <style>
        table { border-collapse: collapse; width: 100%; font-size: 11px; }
        table, td, th { border: 1px solid #000; }
        th { background: #f5f5f5; }
    </style>
</head>
<body>
    <table cellspacing="0">
        <thead>
            <tr>
                <th>Live&nbsp;Status</th>
                <th>Email&nbsp;Id</th>
                <th>Retailer&nbsp;Name</th>
                <th>Frim&nbsp;Name</th>
                <th>Request&nbsp;Type</th>
                <th>Cancel&nbsp;Type</th>
                <th>Cancellation&nbsp;Id</th>
                <th>Request&nbsp;Date</th>
                <th>Response&nbsp;Date</th>
                <th>Refunded&nbsp;Amount</th>
                <th>Charge</th>
                <th>Retailer&nbsp;Pre</th>
                <th>Retailer&nbsp;Income</th>
                <th>Retailer&nbsp;Post</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var item in Model)
                {
                    var sts = item.ChangeRequestStatus.HasValue
                        ? ((Vastwebmulti.Areas.RETAILER.Enums.ChangeRequestStatus)Convert.ToInt32(item.ChangeRequestStatus)).ToString()
                        : string.Empty;
                    <tr>
                        <td>@sts</td>
                        <td>@item.Email</td>
                        <td>@item.RetailerName</td>
                        <td>@item.Frm_Name</td>
                        <td>@item.RequestType</td>
                        <td>@item.CancellationType</td>
                        <td>@item.ChangeRequestId</td>
                        <td>@String.Format("{0:dd-MMM HH:mm:ss}", item.CancellationRequestDate)</td>
                        <td>@(item.CancellationResponseDate.HasValue ? String.Format("{0:dd-MMM HH:mm:ss}", item.CancellationResponseDate) : "")</td>
                        <td>@(item.RefundedAmount.HasValue ? Math.Round(item.RefundedAmount.Value, 2) : 0)</td>
                        <td>@(item.CancellationCharge.HasValue ? Math.Round(item.CancellationCharge.Value, 2) : 0)</td>
                        <td>@Math.Round(item.RemPre, 2)</td>
                        <td>@Math.Round(item.RemInc, 2)</td>
                        <td>@Math.Round(item.RemPost, 2)</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</body>
</html>
