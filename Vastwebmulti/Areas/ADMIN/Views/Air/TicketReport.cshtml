<script src="~/MainFrontDesign/select2/dist/js/select2.full.min.js"></script>

<script src="~/MainFrontDesign/js/admin-ticket-report.js?v=5"></script>

<script src="~/Swalalert/sweetalert-dev.js"></script>

<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />



<script>

    window.ticketReportScrollUrl = '@Url.Action("scroll_TicketReport", "Air")';

    window.ticketReportTotalsUrl = '@Url.Action("TotalticketReport", "Air")';



    function buildTicketExportQuery() {

        return 'txt_frm_date=' + encodeURIComponent($('#txt_frm_date').val())

            + '&txt_to_date=' + encodeURIComponent($('#txt_to_date').val())

            + '&ddl_status=' + encodeURIComponent($('#ddl_status').val() || '')

            + '&PNR=' + encodeURIComponent($('#PNR').val() || '')

            + '&ddlusers=' + encodeURIComponent($('#ddlusers').val() || '')

            + '&allmaster=' + encodeURIComponent($('select#allmaster').val() || '')

            + '&alldealer=' + encodeURIComponent($('#alldealer').val() || '')

            + '&allretailer=' + encodeURIComponent($('#allretailer').val() || '')

            + '&allwhitelabel=' + encodeURIComponent($('select#allwhitelabel').val() || '');

    }



    $('#btnExportA').click(function () {

        location.href = '@Url.Action("ExcelTicketReport", "Air")?' + buildTicketExportQuery();

    });



    $('#btnPDFA').click(function () {

        window.open('@Url.Action("PDFTicketReport", "Air")?' + buildTicketExportQuery(), '_blank');

    });



    $('#ticketReportForm').on('submit', function () {

        if (window.resetTicketScroll) {

            resetTicketScroll();

        }

    });



    function getTicketStatus(TraceId, refNo, pnr) {

        var requestObject = { BookingId: refNo, PNR: pnr, TraceId: TraceId };

        $('#loadermoney').show();

        $.ajax({

            url: '@Url.Action("GetFlightStatus", "Air")',

            type: 'POST',

            data: JSON.stringify(requestObject),

            dataType: 'json',

            contentType: 'application/json; charset=utf-8',

            success: function (data) {

                $('#loadermoney').hide();

                var respo = JSON.parse(data);

                if (respo.Status === 'Success') {

                    if (respo.StatusCode === 5) { swal('Wow!!', 'Ticketed successfully', 'success'); }

                    else if (respo.StatusCode === 1) { swal('Wow!!', 'Ticket is on Hold', 'warning'); }

                    else if (respo.StatusCode === 2) { swal('Wow!!', 'Ticket is ready', 'success'); }

                    else if (respo.StatusCode === 3) { swal('Wow!!', 'Ticket is cancelled', 'warning'); }

                    else if (respo.StatusCode === 4) { swal('Wow!!', 'Ticket is in InProgress', 'warning'); }

                    else { swal('Oh!', 'Ticket not confirmed yet', 'warning'); }

                } else {

                    swal('Oops!!', respo.Message, 'error');

                }

            },

            error: function () {

                $('#loadermoney').hide();

                swal('Oops!!', 'Unable to fetch ticket status.', 'error');

            }

        });

    }



    function ticketActionBtn(idno) {

        $('#Idno').val(idno);

        $('#ticketDetailModal').modal('show');

    }



    $(document).ready(function () {

        var sts = '@TempData["Status"]';

        var msg = '@TempData["Message"]';

        if (sts && msg) {

            swal('Oops..', msg, 'error');

        }

        $('#txt_frm_date, #txt_to_date').datepicker({

            format: 'yyyy-mm-dd',

            todayHighlight: true,

            autoclose: true,

            orientation: 'bottom auto'

        });

        var val = '@ViewBag.chk';

        if (val !== 'post') {

            $('#txt_frm_date').datepicker('setDate', new Date());

            $('#txt_to_date').datepicker('setDate', new Date());

        }

    });

</script>

