                    </div>

                </div>



                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="ticketTotalsPanel" style="display:none;" aria-hidden="true">

                    <div class="vm-dmt-totals-head">

                        <div class="vm-dmt-totals-head__title">

                            <i class="fas fa-chart-pie" aria-hidden="true"></i>

