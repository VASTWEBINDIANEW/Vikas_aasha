<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-security-report-page saas-loan-report-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var loanFormAttrs = new Dictionary<string, object>
            {
                { "id", "loanReportForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("Index", "AdminLoan", new { area = "ADMIN" }, FormMethod.Get, loanFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Report's</li>
                        <li>Loan Report</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters vm-ecomm-filter-row--one-line">

                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownListFor(m => m.RetailerId, retailerList, "All Retailers", new { @id = "ddlRetailer", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownListFor(m => m.Status, new SelectList(statuses), "All Status", new { @id = "ddl_status", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownListFor(m => m.LoanTypeId, new SelectList(Model.LoanTypes ?? new List<Vastwebmulti.Areas.RETAILER.Models.LoanTypeVm>(), "Id", "Name"), "All Loan Types", new { @id = "ddlLoanType", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div class="vm-dmt-filter-search-group vm-loan-simple-group">
                            <div class="vm-loan-simple-wrap">
                                <input type="date" id="txt_frm_date" name="FromDate" value="@frmDate" class="vm-loan-simple-date" required="required" autocomplete="off" title="From date" />
                            </div>
                            <div class="vm-loan-simple-wrap">
                                <input type="date" id="txt_to_date" name="ToDate" value="@toDate" class="vm-loan-simple-date" required="required" autocomplete="off" title="To date" />
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                            <a href="@Url.Action("Index", "AdminLoan", new { area = "ADMIN" })" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Reset" style="background:#64748b;border-color:#64748b;text-decoration:none;">
                                <i class="fas fa-undo" aria-hidden="true"></i><span>Reset</span>
                            </a>
                        </div>

                    </div>

                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="loanReportTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Loan report totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideLoanReportTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--primary">
                            <span class="vm-opr-total-card__label">Total Amount</span>
                            <strong class="vm-opr-total-card__value">@totalAmount.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Approved</span>
                            <strong class="vm-opr-total-card__value">@approvedAmount.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Disbursed</span>
                            <strong class="vm-opr-total-card__value">@disbursedAmount.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Pending</span>
                            <strong class="vm-opr-total-card__value">@pendingCount</strong>
                        </div>
                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card vm-security-report-main-card vm-loan-report-main-card">
            <div class="vm-opr-table-panel vm-security-report-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head vm-security-report-table-head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-money-check-alt" aria-hidden="true"></i>
                        <span>Loan report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong>@rowCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total" title="Total amount for current filter">
                            Total: <strong>&#8377; @totalAmount.ToString("N2")</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-loan-totals-btn" onclick="findLoanTotal()" title="Show totals" aria-expanded="false" aria-controls="loanReportTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="loanReportTable" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Status</th>
                                    <th>Application&nbsp;No</th>
                                    <th>Retailer</th>
                                    <th>Loan&nbsp;Type</th>
                                    <th>Applicant</th>
                                    <th>Mobile</th>
                                    <th>Amount&nbsp;&#8377;</th>
                                    <th>Tenure</th>
                                    <th>Applied&nbsp;On</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (results.Any())
                                {
                                    foreach (var item in results)
                                    {
                                        string rName;
                                        var statusUpper = (item.Status ?? "").ToUpper();
                                        var statusCls = "is-hold";
                                        if (statusUpper == "APPROVED") { statusCls = "is-approved"; }
                                        else if (statusUpper == "DISBURSED") { statusCls = "is-disbursed"; }
                                        else if (statusUpper == "REJECTED" || statusUpper == "CANCELLED") { statusCls = "is-rejected"; }
                                        else if (statusUpper == "NEW") { statusCls = "is-new"; }
                                        else if (statusUpper == "UNDER_PROCESS" || statusUpper == "VERIFICATION" || statusUpper == "DOCUMENT_REQUIRED" || statusUpper == "ON_HOLD") { statusCls = "is-process"; }
                                        var statusText = (item.Status ?? "-").Replace("_", " ");
                                        <tr>
                                            <td>
                                                <span class="vm-loan-status @statusCls"><span class="vm-loan-dot"></span>@statusText</span>
                                            </td>
                                            <td>@item.ApplicationNo</td>
                                            <td>@(retailerNames.TryGetValue(item.RetailerId ?? "", out rName) ? rName : "-")</td>
                                            <td>@item.LoanTypeName</td>
                                            <td>@item.FullName</td>
                                            <td>@item.Mobile</td>
                                            <td>@item.LoanAmount.ToString("N2")</td>
                                            <td>@(item.TenureMonths.HasValue ? item.TenureMonths + " mo" : "-")</td>
                                            <td>@item.CreatedDate.ToString("dd MMM yyyy")</td>
                                            <td>
                                                <a href="@Url.Action("Details", "AdminLoan", new { area = "ADMIN", id = item.Id })" title="View Details" style="color:#ffc107;background:transparent;border:none;">
                                                    <img src="~/ashok-images/rightaeps.svg" style="border: 1px solid var(--border-color);padding: 3px 3px;font-size: 10px;height:20px !important;" />
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="10" class="vm-opr-table-empty vm-dmt-table-empty">
                                            <i class="fas fa-money-check-alt" aria-hidden="true"></i>
                                            <span>Loan applications not found.</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<script src="~/Swalalert/sweetalert-dev.js"></script>

<script>
    function hideLoanReportTotals() {
        var $panel = $('#loanReportTotalsPanel');
        var $btn = $('.vm-loan-totals-btn');
        $panel.hide().attr('aria-hidden', 'true');
        $btn.attr('aria-expanded', 'false');
    }

    function findLoanTotal() {
        var $panel = $('#loanReportTotalsPanel');
        var $btn = $('.vm-loan-totals-btn');
        if ($panel.is(':visible')) {
            hideLoanReportTotals();
            return;
        }
        $panel.show().attr('aria-hidden', 'false');
        $btn.attr('aria-expanded', 'true');
    }

    function destroyLoanSelect2($el) {
        if ($el && $el.length && $el.data('select2')) {
            $el.select2('destroy');
        }
    }

    function applyLoanSelect2($el) {
        if (!$el || !$el.length || !$.fn.select2) {
            return;
        }
        destroyLoanSelect2($el);
        $el.select2({
            width: '100%',
            minimumResultsForSearch: 6
        });
    }

    function initLoanReportSelect2() {
        applyLoanSelect2($('#ddlRetailer'));
        applyLoanSelect2($('#ddl_status'));
        applyLoanSelect2($('#ddlLoanType'));
    }

    /* Loan date - sirf native input type=date, bootstrap datepicker/select style bilkul nahi */
    function initLoanSimpleDates() {
        try {
            var frm = document.querySelector('#loanReportForm #txt_frm_date');
            var to = document.querySelector('#loanReportForm #txt_to_date');
            if (!frm || !to) { return; }
            var jq = window.jQuery;
            if (jq && jq.fn && jq.fn.datepicker) {
                jq([frm, to]).each(function () {
                    var $el = jq(this);
                    if ($el.data('datepicker')) {
                        try { $el.datepicker('destroy'); } catch (e) {}
                    }
                    $el.prop('readonly', false).removeClass('form-control saas-acc-dp-input');
                });
            }
            var openNative = function () { try { if (this.showPicker) { this.showPicker(); } } catch (e) {} };
            if (!frm.getAttribute('data-vm-loan-date')) {
                frm.setAttribute('data-vm-loan-date', '1');
                frm.addEventListener('click', openNative);
            }
            if (!to.getAttribute('data-vm-loan-date')) {
                to.setAttribute('data-vm-loan-date', '1');
                to.addEventListener('click', openNative);
            }
            var enforce = function () { if (frm.value && to.value && to.value < frm.value) { to.value = frm.value; } };
            frm.onchange = enforce;
            to.onchange = enforce;
        } catch (e) {}
    }

    function loanReportBoot() {
        try { initLoanReportSelect2(); } catch (e) {}
        try { initLoanSimpleDates(); } catch (e) {}
        try {
            var jq = window.jQuery;
            if (jq) { jq('#loanReportForm .select2-container').css('width', '100%'); }
        } catch (e) {}
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', loanReportBoot);
    } else {
        loanReportBoot();
    }
    if (window.addEventListener) {
        window.addEventListener('load', function () { try { loanReportBoot(); } catch (e) {} try { initLoanSimpleDates(); } catch (e2) {} });
    }
</script>
