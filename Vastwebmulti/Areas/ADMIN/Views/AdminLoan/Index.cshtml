@model Vastwebmulti.Areas.ADMIN.Models.AdminLoanReportFilterVM
@{
    ViewBag.Title = "Loan Report";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var statuses = new[]
    {
        "NEW", "UNDER_PROCESS", "DOCUMENT_REQUIRED", "VERIFICATION",
        "ON_HOLD", "APPROVED", "REJECTED", "DISBURSED", "CANCELLED"
    };
    var retailerList = Model.Retailers ?? new List<SelectListItem>();
    var retailerNames = retailerList.Where(x => x != null && x.Value != null).ToDictionary(x => x.Value, x => x.Text);
    var results = Model.Results ?? new List<Vastwebmulti.Areas.RETAILER.Models.LoanApplicationVm>();
    var rowCount = results.Count;

    decimal totalAmount = results.Any() ? results.Sum(i => i.LoanAmount) : 0m;
    decimal approvedAmount = results.Where(i => string.Equals(i.Status, "APPROVED", StringComparison.OrdinalIgnoreCase)).Sum(i => i.LoanAmount);
    decimal disbursedAmount = results.Where(i => string.Equals(i.Status, "DISBURSED", StringComparison.OrdinalIgnoreCase)).Sum(i => i.LoanAmount);
    int pendingCount = results.Count(i => !string.Equals(i.Status, "APPROVED", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(i.Status, "DISBURSED", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(i.Status, "REJECTED", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(i.Status, "CANCELLED", StringComparison.OrdinalIgnoreCase));

    var frmDate = (Model.FromDate ?? "").Trim();
    var toDate = (Model.ToDate ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); Model.FromDate = frmDate; }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); Model.ToDate = toDate; }
    var dateMode = "get";
}

