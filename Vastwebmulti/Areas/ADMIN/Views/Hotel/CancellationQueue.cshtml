@model List<Vastwebmulti.Models.proc_HotelCancellationReport_Result>
@{
    ViewBag.Title = "Hotel Cancellation Queue";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var selectedUsers = (Request["ddlusers"] ?? "Admin").Trim();
    var selectedStatus = (Request["ddl_status"] ?? "").Trim();
    var bookingIdValue = (Request["BookingId"] ?? "").Trim();
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=11" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-cancellation-report-modern.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<script src="~/MainFrontDesign/js/admin-financial-report.js?v=16"></script>

<div id="loadermoney" class="vm-dmt-loader" style="display:none;"></div>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-cancellation-report-page saas-hotel-cancellation-queue-page">

    <div class="container-fluid vm-opr-page-shell">

        @using (Html.BeginForm("CancellationQueue", "Hotel", FormMethod.Post, new { id = "hotelCancellationQueueForm", @class = "vm-rpt-filters-panel__form" }))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Travel &amp; Hotels</li>
                        <li>Hotel Cancellation Queue</li>
                    </ol>

                    <div class="vm-dmt-fin-nav-row vm-ticket-travel-nav-row">
                        @Html.Partial("~/Areas/ADMIN/Views/Air/_ticketTravelNav.cshtml")
                    </div>
                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="hotelCancellationTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Hotel cancellation totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideHotelCancellationTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Success</span>
                            <strong class="vm-opr-total-card__value" id="successtotal">�</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Failed</span>
                            <strong class="vm-opr-total-card__value" id="Failedtotal">�</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Pending</span>
                            <strong class="vm-opr-total-card__value" id="Pendingtotal">�</strong>
                        </div>
                    </div>
                </div>

                <div class="vm-rpt-filters-panel">
                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--cancel vm-rpt-filters-panel__bar">

                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("ddlusers", new SelectList(new[]
                            {
                                new SelectListItem{ Text="All User", Value="Admin"},
                                new SelectListItem{ Text="Master", Value="Master"},
                                new SelectListItem{ Text="Distributor", Value="Dealer"},
                                new SelectListItem{ Text="Retailer", Value="Retailer"},
                                new SelectListItem{ Text="Whitelabel", Value="Whitelabel"}
                            }, "Value", "Text", selectedUsers), new { id = "ddlusers", @class = "vm-opr-select vm-dmt-select form-control", @title = "User type", @onchange = "answers()" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="cancel-wrap-whitelabel" style="display:none;" hidden>
                            @Html.DropDownList("allwhitelabel", ViewBag.allwhitelabel as SelectList, "All Whitelabel", new { id = "allwhitelabel", @class = "vm-opr-select vm-dmt-select form-control", @title = "Whitelabel" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="cancel-wrap-master" style="display:none;" hidden>
                            @Html.DropDownList("allmaster", ViewBag.allmaster as SelectList, "All Master", new { id = "allmaster", @class = "vm-opr-select vm-dmt-select form-control", @title = "Master" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="dlm" style="display:none;" hidden>
                            @Html.DropDownList("alldealer", ViewBag.alldealer as SelectList, "All Distributor", new { id = "alldealer", @class = "vm-opr-select vm-dmt-select form-control", @title = "Distributor" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="rem" style="display:none;" hidden>
                            @Html.DropDownList("allretailer", ViewBag.allretailer as SelectList, "All Retailer", new { id = "allretailer", @class = "vm-opr-select vm-dmt-select form-control", @title = "Retailer" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field" id="sts">
                            @Html.DropDownList("ddl_status", new SelectList(new[]
                            {
                                new SelectListItem{ Text="All Status", Value=""},
                                new SelectListItem{ Text="Success", Value="Confirmed"},
                                new SelectListItem{ Text="Pending", Value="Proccessed"},
                                new SelectListItem{ Text="Failed", Value="Failed"}
                            }, "Value", "Text", selectedStatus), new { id = "ddl_status", @class = "vm-opr-select vm-dmt-select form-control", @title = "Status" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-dmt-field--pnr">
                            <input type="text" name="BookingId" id="BookingId" class="form-control vm-dmt-search-input vm-cancel-pnr-input" placeholder="TXN/REF NO" autocomplete="off" title="Booking Id" value="@bookingIdValue" />
                        </div>

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-ban" aria-hidden="true"></i>
                        <span>Hotel cancellation report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-hotel-cancel-totals-btn" onclick="findtotalHotelCancellation()" title="Show totals" aria-expanded="false" aria-controls="hotelCancellationTotalsPanel"><i class="fas fa-chart-pie" aria-hidden="true"></i></button>
                            <button type="button" id="btnExportCancel" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel"><i class="fas fa-file-excel" aria-hidden="true"></i> Excel</button>
                            <button type="button" id="btnPDFCancel" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF"><i class="fas fa-file-pdf" aria-hidden="true"></i> PDF</button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="hotelCancellationQueue" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Status</th>
                                    <th>Email&nbsp;Id</th>
                                    <th>Retailer&nbsp;Name</th>
                                    <th>Frim&nbsp;Name</th>
                                    <th>Cancellation&nbsp;Id</th>
                                    <th>Booking&nbsp;Id</th>
                                    <th>Cancallation&nbsp;Charge</th>
                                    <th>Refund&nbsp;Amount</th>
                                    <th>Request&nbsp;Date</th>
                                    <th>Response&nbsp;Date</th>
                                    <th>#</th>
                                </tr>
                            </thead>
                            <tbody>
                                @Html.Partial("_HotelCancellationQueueRows", Model)
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<script src="~/MainFrontDesign/select2/dist/js/select2.full.min.js"></script>
<script src="~/MainFrontDesign/js/admin-cancellation-report.js?v=4"></script>
<script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
<script src="~/Swalalert/sweetalert-dev.js"></script>
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />

<script>
    window.hotelCancellationQueueBaseUrl = '@Url.Action("CancellationQueue", "Hotel")';

    function buildHotelCancellationExportQuery() {
        return 'txt_frm_date=' + encodeURIComponent($('#txt_frm_date').val())
            + '&txt_to_date=' + encodeURIComponent($('#txt_to_date').val())
            + '&ddl_status=' + encodeURIComponent($('#ddl_status').val() || '')
            + '&BookingId=' + encodeURIComponent($('#BookingId').val() || '')
            + '&ddlusers=' + encodeURIComponent($('#ddlusers').val() || '')
            + '&allmaster=' + encodeURIComponent($('select#allmaster').val() || '')
            + '&alldealer=' + encodeURIComponent($('#alldealer').val() || '')
            + '&allretailer=' + encodeURIComponent($('#allretailer').val() || '')
            + '&allwhitelabel=' + encodeURIComponent($('select#allwhitelabel').val() || '');
    }

    function downloadHotelCancellationExport(type) {
        var url = window.hotelCancellationQueueBaseUrl + '?export=' + encodeURIComponent(type) + '&' + buildHotelCancellationExportQuery();
        var frame = document.getElementById('hotelCancelExportFrame');
        if (!frame) {
            frame = document.createElement('iframe');
            frame.id = 'hotelCancelExportFrame';
            frame.style.display = 'none';
            document.body.appendChild(frame);
        }
        frame.src = url;
    }

    $('#btnExportCancel').click(function () { downloadHotelCancellationExport('excel'); });
    $('#btnPDFCancel').click(function () { downloadHotelCancellationExport('pdf'); });

    function OnHotelCancellationStatusSuccess(data) {
        var respo = JSON.parse(data);
        if (respo.Status === 'Pending') {
            swal('Keep calm!', respo.Message, 'warning');
        } else if (respo.Status === 'Success') {
            swal('Wow!', respo.Message, 'success');
        } else {
            swal('Oops!', respo.Message, 'error');
        }
    }

    function OnHotelCancellationStatusFailure() {
        swal('Oops!', 'Unable to fetch data', 'error');
    }

    function reloadHotelCancellationPage() {
        window.setTimeout(function () {
            location.reload();
        }, 3000);
    }

    $(document).ready(function () {
        var sts = '@TempData["Status"]';
        var msg = '@TempData["Message"]';
        if (sts && msg) {
            swal('Oops..', msg, 'error');
        }

        $('#txt_frm_date, #txt_to_date').datepicker({
            format: 'yyyy-mm-dd',
            todayHighlight: true,
            autoclose: true,
            orientation: 'bottom auto'
        });
        var val = '@ViewBag.chk';
        if (val !== 'post') {
            $('#txt_frm_date').datepicker('setDate', new Date());
            $('#txt_to_date').datepicker('setDate', new Date());
        }
    });
</script>
