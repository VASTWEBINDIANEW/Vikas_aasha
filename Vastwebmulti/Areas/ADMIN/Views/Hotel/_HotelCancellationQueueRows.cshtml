@model List<Vastwebmulti.Models.proc_HotelCancellationReport_Result>
@using System.Web.Mvc.Ajax
@{
    Layout = null;
    var items = Model ?? new List<Vastwebmulti.Models.proc_HotelCancellationReport_Result>();
}
@if (items.Count > 0)
{
    foreach (var item in items)
    {
        var statusTone = "pending";
        var sts = "Pending";

        if (!string.IsNullOrEmpty(item.ChangeRequestStatus))
        {
            if (item.ChangeRequestStatus.Contains("4"))
            {
                statusTone = "failed";
                sts = "Failed";
            }
            else if (item.ChangeRequestStatus.Contains("3"))
            {
                statusTone = "success";
                sts = "Processed";
            }
            else if (item.ChangeRequestStatus.Contains("1") || item.ChangeRequestStatus.Contains("2"))
            {
                statusTone = "pending";
                sts = "Pending";
            }
        }

        <tr class="vm-dmt-row vm-dmt-row--@statusTone">
            <td class="vm-cancel-status-cell">
                <span class="vm-dmt-status vm-dmt-status--@statusTone" title="@sts">@sts</span>
            </td>
            <td>@item.Email</td>
            <td>@item.RetailerName</td>
            <td>@item.Frm_Name</td>
            <td class="vm-cancel-id-cell">@item.ChangeRequestId</td>
            <td>@item.BookingId</td>
            <td class="vm-dmt-amt-cell">@(item.CancellationCharge.HasValue ? Math.Round(item.CancellationCharge.Value, 2).ToString() : "—")</td>
            <td class="vm-dmt-amt-cell">@(item.RefundedAmount.HasValue ? Math.Round(item.RefundedAmount.Value, 2).ToString() : "—")</td>
            <td class="vm-cancel-time-cell">@String.Format("{0:dd-MMM HH:mm:ss}", item.CancellationRequestDate)</td>
            <td class="vm-cancel-time-cell">@(item.CancellationResponseDate.HasValue ? String.Format("{0:dd-MMM HH:mm:ss}", item.CancellationResponseDate) : "—")</td>
            <td class="vm-dmt-action-cell">
                @if (item.ChangeRequestId.HasValue)
                {
                    @Ajax.ActionLink("STATUS", "CancellationStatus", "Hotel",
                        new { ChangeReqId = item.ChangeRequestId.Value.ToString(), idno = item.idno },
                        new AjaxOptions { HttpMethod = "Post", OnSuccess = "OnHotelCancellationStatusSuccess", OnFailure = "OnHotelCancellationStatusFailure", OnComplete = "reloadHotelCancellationPage", LoadingElementId = "loadermoney" },
                        new { @class = "vm-dmt-act-btn vm-dmt-act-btn--status", title = "Check cancellation status" })
                }
            </td>
        </tr>
    }
}
else
{
    <tr class="vm-opr-table-empty-row">
        <td colspan="11" class="vm-opr-table-empty vm-dmt-table-empty">
            <i class="fas fa-ban" aria-hidden="true"></i>
            <span>Hotel cancellation report not found.</span>
        </td>
    </tr>
}
