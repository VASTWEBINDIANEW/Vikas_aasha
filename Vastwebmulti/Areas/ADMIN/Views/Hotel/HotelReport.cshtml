@model List<Vastwebmulti.Models.proc_HotelReport_new_Result>
@{
    ViewBag.Title = "Hotel Report";
    Layout = "~/Areas/ADMIN/Views/Shared/_Layout.cshtml";

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var selectedUsers = (Request["ddlusers"] ?? "Admin").Trim();
    var selectedStatus = (Request["ddl_status"] ?? "").Trim();
    var selectedTicketStatus = (Request["ddl_status_ticket"] ?? "").Trim();
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=11" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=2" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<script src="~/MainFrontDesign/js/admin-financial-report.js?v=15"></script>

<div id="loadermoney" class="vm-dmt-loader" style="display:none;"></div>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-hotel-report-page">

    <div class="container-fluid vm-opr-page-shell">

        @using (Html.BeginForm("HotelReport", "Hotel", FormMethod.Post, new { id = "hotelReportForm", @class = "vm-rpt-filters-panel__form" }))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Travel &amp; Hotels</li>
                        <li>Hotel Report</li>
                    </ol>

                    <div class="vm-dmt-fin-nav-row vm-ticket-travel-nav-row">
                        @Html.Partial("~/Areas/ADMIN/Views/Air/_ticketTravelNav.cshtml")
                    </div>
                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="hotelTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Hotel booking totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideHotelTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Success</span>
                            <strong class="vm-opr-total-card__value" id="successtotal">�</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Failed</span>
                            <strong class="vm-opr-total-card__value" id="Failedtotal">�</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Pending</span>
                            <strong class="vm-opr-total-card__value" id="Pendingtotal">�</strong>
                        </div>
                    </div>
                </div>

                <div class="vm-rpt-filters-panel">
                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--hotel vm-rpt-filters-panel__bar">

                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("ddlusers", new SelectList(new[]
                            {
                                new SelectListItem{ Text="All User", Value="Admin"},
                                new SelectListItem{ Text="Master", Value="Master"},
                                new SelectListItem{ Text="Distributor", Value="Dealer"},
                                new SelectListItem{ Text="Retailer", Value="Retailer"},
                                new SelectListItem{ Text="Whitelabel", Value="Whitelabel"}
                            }, "Value", "Text", selectedUsers), new { id = "ddlusers", @class = "vm-opr-select vm-dmt-select form-control", @title = "User type", @onchange = "answers()" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="ticket-wrap-whitelabel" style="display:none;" hidden>
                            @Html.DropDownList("allwhitelabel", ViewBag.allwhitelabel as SelectList, "All Whitelabel", new { id = "allwhitelabel", @class = "vm-opr-select vm-dmt-select form-control", @title = "Whitelabel" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="ticket-wrap-master" style="display:none;" hidden>
                            @Html.DropDownList("allmaster", ViewBag.allmaster as SelectList, "All Master", new { id = "allmaster", @class = "vm-opr-select vm-dmt-select form-control", @title = "Master" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="dlm" style="display:none;" hidden>
                            @Html.DropDownList("alldealer", ViewBag.alldealer as SelectList, "All Distributor", new { id = "alldealer", @class = "vm-opr-select vm-dmt-select form-control", @title = "Distributor" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-filter-extra" id="rem" style="display:none;" hidden>
                            @Html.DropDownList("allretailer", ViewBag.allretailer as SelectList, "All Retailer", new { id = "allretailer", @class = "vm-opr-select vm-dmt-select form-control", @title = "Retailer" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("ddl_status", new SelectList(new[]
                            {
                                new SelectListItem{ Text="All Status", Value=""},
                                new SelectListItem{ Text="SUCCESS", Value="Confirmed"},
                                new SelectListItem{ Text="PENDING", Value="PROCCESSED"},
                                new SelectListItem{ Text="FAILED", Value="Failed"}
                            }, "Value", "Text", selectedStatus), new { id = "ddl_status", @class = "vm-opr-select vm-dmt-select form-control", @title = "Status" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("ddl_status_ticket", new SelectList(new[]
                            {
                                new SelectListItem{ Text="Ticket Status", Value=""},
                                new SelectListItem{ Text="SUCCESS", Value="Success"},
                                new SelectListItem{ Text="PENDING", Value="PROCCESSED"},
                                new SelectListItem{ Text="FAILED", Value="Failed"}
                            }, "Value", "Text", selectedTicketStatus), new { id = "ddl_status_ticket", @class = "vm-opr-select vm-dmt-select form-control", @title = "Ticket status" })
                        </div>

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-hotel" aria-hidden="true"></i>
                        <span>Hotel booking report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-hotel-totals-btn" onclick="findtotalHotel()" title="Show totals" aria-expanded="false" aria-controls="hotelTotalsPanel"><i class="fas fa-chart-pie" aria-hidden="true"></i></button>
                            <button type="button" id="btnExportA" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel"><i class="fas fa-file-excel" aria-hidden="true"></i> Excel</button>
                            <button type="button" id="btnPDFA" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF"><i class="fas fa-file-pdf" aria-hidden="true"></i> PDF</button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="hotelBookingReport" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Live&nbsp;Status</th>
                                    <th>Hotel&nbsp;Information</th>
                                    <th>Rooms</th>
                                    <th>Customer&nbsp;Information</th>
                                    <th>Booking&nbsp;Date</th>
                                    <th>Chek&nbsp;In&nbsp;Date</th>
                                    <th>Publish&nbsp;Fare</th>
                                    <th>Price</th>
                                    <th>Pre&nbsp;?</th>
                                    <th>Debit&nbsp;?</th>
                                    <th>Post&nbsp;?</th>
                                    <th>Total Debit</th>
                                    <th>Booking&nbsp;Id</th>
                                    <th>#</th>
                                    <th>#</th>
                                    <th>#</th>
                                    <th>#</th>
                                </tr>
                            </thead>
                            <tbody id="hotelReportRows">
                                @Html.Partial("_HotelReportRows", Model)
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<div class="modal fade saas-admin-modal vm-dmt-modal vm-ticket-detail-modal" id="hotelDetailModal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header saas-admin-modal-header accent-sky">
                <div class="saas-admin-modal-head-main">
                    <div class="saas-admin-modal-icon"><i class="fas fa-hotel" aria-hidden="true"></i></div>
                    <div>
                        <h4 class="modal-title saas-admin-modal-title">Hotel booking details</h4>
                        <p class="saas-admin-modal-sub" id="hotelDetailFirm">�</p>
                    </div>
                </div>
                <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
            </div>
            <div class="modal-body vm-dmt-modal-body">
                <div class="vm-dmt-modal-grid vm-dmt-modal-grid--2">
                    <div class="vm-dmt-modal-field"><label>User Markup</label><input type="text" id="hotelRemMarkup" class="form-control vm-dmt-modal-input" readonly="readonly" /></div>
                    <div class="vm-dmt-modal-field"><label>Distributor Inc</label><input type="text" id="hotelDlmInc" class="form-control vm-dmt-modal-input" readonly="readonly" /></div>
                    <div class="vm-dmt-modal-field"><label>Distributor Pre</label><input type="text" id="hotelDlmPre" class="form-control vm-dmt-modal-input" readonly="readonly" /></div>
                    <div class="vm-dmt-modal-field"><label>Distributor Post</label><input type="text" id="hotelDlmPost" class="form-control vm-dmt-modal-input" readonly="readonly" /></div>
                    <div class="vm-dmt-modal-field"><label>Master Inc</label><input type="text" id="hotelMdInc" class="form-control vm-dmt-modal-input" readonly="readonly" /></div>
                    <div class="vm-dmt-modal-field"><label>Master Pre</label><input type="text" id="hotelMdPre" class="form-control vm-dmt-modal-input" readonly="readonly" /></div>
                    <div class="vm-dmt-modal-field"><label>Master Post</label><input type="text" id="hotelMdPost" class="form-control vm-dmt-modal-input" readonly="readonly" /></div>
                    <div class="vm-dmt-modal-field"><label>Whitelabel Inc</label><input type="text" id="hotelWlInc" class="form-control vm-dmt-modal-input" readonly="readonly" /></div>
                    <div class="vm-dmt-modal-field"><label>Whitelabel Pre</label><input type="text" id="hotelWlPre" class="form-control vm-dmt-modal-input" readonly="readonly" /></div>
                    <div class="vm-dmt-modal-field"><label>Whitelabel Post</label><input type="text" id="hotelWlPost" class="form-control vm-dmt-modal-input" readonly="readonly" /></div>
                </div>
                <div class="vm-dmt-modal-field" style="margin-top:12px;">
                    <label>Request</label>
                    <textarea id="hotelRequestJson" class="form-control vm-dmt-modal-input" rows="3" readonly="readonly"></textarea>
                </div>
                <div class="vm-dmt-modal-field">
                    <label>Response</label>
                    <textarea id="hotelResponseJson" class="form-control vm-dmt-modal-input" rows="4" readonly="readonly"></textarea>
                </div>
            </div>
            <div class="modal-footer saas-admin-modal-footer">
                <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal"><i class="fas fa-times" aria-hidden="true"></i> Close</button>
            </div>
        </div>
    </div>
</div>

<div id="guestDetailsModal" class="modal fade saas-admin-modal vm-dmt-modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header saas-admin-modal-header accent-sky">
                <h4 class="modal-title saas-admin-modal-title">Guest details</h4>
                <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
            </div>
            <div class="modal-body vm-dmt-modal-body" id="guestDescription"></div>
            <div class="modal-footer saas-admin-modal-footer">
                <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<div id="guestPriceModal" class="modal fade saas-admin-modal vm-dmt-modal" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header saas-admin-modal-header accent-sky">
                <h4 class="modal-title saas-admin-modal-title">Hotel price details</h4>
                <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
            </div>
            <div class="modal-body vm-dmt-modal-body" id="priceDescription"></div>
            <div class="modal-footer saas-admin-modal-footer">
                <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
<script src="~/MainFrontDesign/js/admin-ticket-report.js?v=8"></script>
<script src="~/Swalalert/sweetalert-dev.js"></script>
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />

<script>
    window.hotelReportBaseUrl = '@Url.Action("HotelReport", "Hotel")';

    function buildHotelExportQuery() {
        return 'txt_frm_date=' + encodeURIComponent($('#txt_frm_date').val())
            + '&txt_to_date=' + encodeURIComponent($('#txt_to_date').val())
            + '&ddl_status=' + encodeURIComponent($('#ddl_status').val() || '')
            + '&ddl_status_ticket=' + encodeURIComponent($('#ddl_status_ticket').val() || '')
            + '&ddlusers=' + encodeURIComponent($('#ddlusers').val() || '')
            + '&allmaster=' + encodeURIComponent($('select#allmaster').val() || '')
            + '&alldealer=' + encodeURIComponent($('#alldealer').val() || '')
            + '&allretailer=' + encodeURIComponent($('#allretailer').val() || '')
            + '&allwhitelabel=' + encodeURIComponent($('select#allwhitelabel').val() || '');
    }

    function downloadHotelExport(type) {
        var url = window.hotelReportBaseUrl + '?export=' + encodeURIComponent(type) + '&' + buildHotelExportQuery();
        var frame = document.getElementById('hotelExportFrame');
        if (!frame) {
            frame = document.createElement('iframe');
            frame.id = 'hotelExportFrame';
            frame.style.display = 'none';
            document.body.appendChild(frame);
        }
        frame.src = url;
    }

    $('#btnExportA').click(function () { downloadHotelExport('excel'); });
    $('#btnPDFA').click(function () { downloadHotelExport('pdf'); });

    function hotelActionBtn(el, remmarkup, dlminc, dlmpre, dlmpost, mdinc, mdpre, mdpost, wlinc, wlpre, wlpost, firmName) {
        $('#hotelDetailFirm').text(firmName || '�');
        $('#hotelRemMarkup').val(remmarkup);
        $('#hotelDlmInc').val(dlminc);
        $('#hotelDlmPre').val(dlmpre);
        $('#hotelDlmPost').val(dlmpost);
        $('#hotelMdInc').val(mdinc);
        $('#hotelMdPre').val(mdpre);
        $('#hotelMdPost').val(mdpost);
        $('#hotelWlInc').val(wlinc);
        $('#hotelWlPre').val(wlpre);
        $('#hotelWlPost').val(wlpost);
        $('#hotelRequestJson').val($(el).data('req') || '');
        $('#hotelResponseJson').val($(el).data('res') || '');
        $('#hotelDetailModal').modal('show');
    }

    function OnSuccess(data) {
        $('#guestDescription').html(data);
        $('#guestDetailsModal').modal('show');
    }
    function OnFailed() { swal('Oops!', 'Failed to fetch guest data.', 'error'); }
    function OnSuccessPrice(data) {
        $('#priceDescription').html(data);
        $('#guestPriceModal').modal('show');
    }
    function OnFailedPrice() { swal('Oops!', 'Failed to fetch price data.', 'error'); }
    function OnSuccessStatus(data) {
        var respo = JSON.parse(data);
        if (respo.Status === 'Success') { swal('Wow!', respo.Message, 'success'); }
        else { swal('Oops!', respo.Message, 'error'); }
    }
    function OnFailedStatus() { swal('Oops!', 'Failed to fetch status.', 'error'); }

    $(document).ready(function () {
        var sts = '@TempData["Status"]';
        var msg = '@TempData["Message"]';
        if (sts && msg) { swal('Oops..', msg, 'error'); }

        $('#txt_frm_date, #txt_to_date').datepicker({
            format: 'yyyy-mm-dd',
            todayHighlight: true,
            autoclose: true,
            orientation: 'bottom auto'
        });
        var val = '@ViewBag.chk';
        if (val !== 'post') {
            $('#txt_frm_date').datepicker('setDate', new Date());
            $('#txt_to_date').datepicker('setDate', new Date());
        }
    });
</script>
