@{
    ViewBag.Title = "DMTDOC";
    Layout = "~/Areas/API/Views/Shared/_Layout.cshtml";
}
<style>
    section.content {
        background-color: white;
        margin: 67px 0px 0 164px;
        -moz-transition: 0.5s;
        -o-transition: 0.5s;
        -webkit-transition: 0.5s;
        transition: 0.5s;
    }

    .fullapidocclass p, .fullapidocclass div {
        border-color: #b3b3b3 !important;
    }

    .dealer-four-design.master-four-design .badge a {
        background: var(--fullbodybg-four) !important;
    }

    .dealer-four-design section.content {
        padding-top: 0px;
    }

    @@media screen and (max-width:1169px) {
        .ls-closed section.content {
            margin-left: 0;
        }
    }

    @@media screen and (max-width:766px) {
        .table-responsive {
            border: 0 !important;
        }

        .fullapidocclass {
            padding: 0;
        }
    }
</style>
<section class="content" style="background: #eae9e9;">
    <div class="container-fluid">
        <div class="row clearfix">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12 fullapidocclass">
                <div class="card" style="background:transparent;">
                    <div class="body" style="padding-top:0px;">
                        <div class="row">
                            <div class="col-md-12">
                                <div class="" style="width:100%;float:left;border-bottom:1px solid #f4f4f4;padding-bottom: 5px;margin-bottom: 10px;padding-top:10px;">
                                    <p style="margin:0px;float:left;margin-top:7px;">
                                        <span style="font-size:18px;">DMT/PAYOUT API Documents:-</span>&nbsp;&nbsp;
                                    </p>

                                    <p class="badge" style="background-color:transparent;float:right;padding:0px;margin:0px;" title="Click to Downlaod Account Transfer API Document">
                                        <a href="~/images/reportimage/DMT API Documents.pdf" style="cursor:pointer;text-decoration:none;background: var(--main-bg-lcolor);color: #fff;padding: 10px 16px;border-radius: 0;float:left;" download="~/images/reportimage/DMT API Documents.pdf">
                                            <i class="fa fa-download" style="font-size:15px;padding-top:1px;padding-bottom:1px;color:#fff;"></i>&nbsp;<span style="padding-left:3px;color:#fff;position:relative;top:-2px;">Download</span>
                                        </a>
                                    </p>
                                </div>
                            </div>


                            <!-- ============================================================ -->
                            <!-- API 1 : Remitter Details                                     -->
                            <!-- ============================================================ -->
                            <div class="col-md-12">
                                <div class="table-responsive" style="margin-bottom:10px;width:100%;float:left;">
                                    <p style="color:blue"><span style="color:black; font-size:16px;"><b>Remitter Details URL:-</b></span>&nbsp;&nbsp; WebsiteURL/DMT/Remitter_details </p>
                                </div>
                            </div>

                            <div class="col-md-12" style="margin-top:-16px;">
                                <p style="border-bottom:1px solid #f4f4f4;padding-bottom:10px;">
                                    <span style="font-size:17px;">Remitter Details Format:-</span>&nbsp;&nbsp;
                                </p>
                                <div class="table-responsive" style="margin-bottom:10px;">
                                    <p style="color:blue;"><span style="color:black; font-size:14px;">RequestType&nbsp;&nbsp;=&nbsp;</span>&nbsp;&nbsp;POST</p>
                                    <p style="color:blue;"><span style="color:black; font-size:14px;">Header&nbsp;&nbsp;=&nbsp;</span>&nbsp;&nbsp;content-type : application/json</p>
                                    <p style="color:blue;"><span style="color:black; font-size:14px;">Body&nbsp;&nbsp;=&nbsp;</span>&nbsp;&nbsp;{"Senderno":"Sender Mobile No","Tokenid":"Your Token ID","Userid":"Registered Email"}</p>
                                </div>
                            </div>

                            <div class="col-md-12" style="margin-top:-16px;">
                                <p style="border-bottom:1px solid #f4f4f4;padding-bottom:10px;">
                                    <span style="font-size:17px;">Remitter Details Response (If Remitter Exists) :-</span>&nbsp;&nbsp;
                                </p>
                                <div class="table-responsive" style="margin-bottom:10px;">
                                    <p style="color:blue;">
                                        <span style="color:black; font-size:14px;"></span>&nbsp;&nbsp;
                                        {
                                        "status": "Success",
                                        "response": {
                                        "statuscode": "TXN",
                                        "status": "Success",
                                        "data": {
                                        "remitter": {
                                        "id": "",
                                        "name": "Sender Name",
                                        "mobile": "Sender No"
                                        },
                                        "beneficiary": [
                                        {
                                        "id": "BEID8c6AGsRGsSq",
                                        "name": "Beneficiary Name",
                                        "mobile": "",
                                        "account": "1234567890",
                                        "bank": "STATE BANK OF INDIA",
                                        "ifsc": "SBIN0001234",
                                        "status": "1",
                                        "imps": "1",
                                        "last_success_date": "",
                                        "last_success_name": "",
                                        "last_success_imps": ""
                                        }
                                        ]
                                        }
                                        }
                                        }
                                    </p>
                                    <p style="color:red; font-size:15px;padding-top:7px;">
                                        NOTE : statuscode="TXN" means User Exists — No Registration Required. Save remitter "id" for further use.
                                    </p>
                                </div>
                            </div>

                            <div class="col-md-12" style="margin-top:-16px;">
                                <p style="border-bottom:1px solid #f4f4f4;padding-bottom:10px;">
                                    <span style="font-size:17px;">Another Response (If Remitter NOT Found) :-</span>&nbsp;&nbsp;
                                </p>
                                <div class="table-responsive" style="margin-bottom:10px;border-bottom:1px solid #f4f4f4;">
                                    <p style="color:blue;">
                                        <span style="color:black; font-size:14px;"></span>&nbsp;&nbsp;
                                        {
                                        "status": "Success",
                                        "response": {
                                        "statuscode": "NUMBEROTP",
                                        "status": "User does not exists",
                                        "data": []
                                        }
                                        }
                                    </p>
                                    <p style="color:red; font-size:15px;padding-top:7px;">
                                        NOTE : If statuscode="NUMBEROTP" &amp; user not found → Call Remitter Registration Service (API 2).
                                    </p>
                                </div>
                            </div>


                            <!-- ============================================================ -->
                            <!-- API 2 : Remitter Registration                                -->
                            <!-- ============================================================ -->
                            <div class="col-md-12">
                                <div class="table-responsive" style="margin-bottom:10px;">
                                    <p style="color:blue"><span style="color:black; font-size:16px;"><b>Remitter Register URL:-</b></span>&nbsp;&nbsp;WebSiteURL/DMT/Remitter_Registration </p>
                                </div>
                            </div>

                            <div class="col-md-12" style="margin-top:-16px;">
                                <p style="border-bottom:1px solid #f4f4f4;padding-bottom:10px;">
                                    <span style="font-size:17px;">Remitter Register Format:-</span>&nbsp;&nbsp;
                                </p>
                                <div class="table-responsive" style="margin-bottom:10px;">
                                    <p style="color:blue;"><span style="color:black; font-size:14px;">RequestType&nbsp;&nbsp;=&nbsp;</span>&nbsp;&nbsp;POST</p>
                                    <p style="color:blue;"><span style="color:black; font-size:14px;">Header&nbsp;&nbsp;=&nbsp;</span>&nbsp;&nbsp;content-type : application/json</p>
                                    <p style="color:blue;"><span style="color:black; font-size:14px;">Body&nbsp;&nbsp;=&nbsp;</span>&nbsp;&nbsp;{"Senderno":"Sender Mobile No","Tokenid":"Your Token ID","Userid":"Registered Email","SenderName":"Full Name of Sender"}</p>
                                </div>
                            </div>

                            <div class="col-md-12" style="margin-top:-16px;">
                                <p style="border-bottom:1px solid #f4f4f4;padding-bottom:10px;">
                                    <span style="font-size:17px;">Remitter Register Response :-</span>&nbsp;&nbsp;
                                </p>
                                <div class="table-responsive" style="margin-bottom:10px;">
                                    <p style="color:blue;">
                                        <span style="color:black; font-size:14px;"></span>&nbsp;&nbsp;
                                        {
                                        "status": "Success",
                                        "response": {
                                        "statuscode": "TXN",
                                        "status": "User does not exists",
                                        "data": { "beneficiary": [] }
                                        }
                                        }
                                    </p>
                                    <p style="color:red; font-size:15px;padding-top:7px;">
                                        NOTE : OTP is sent to sender's mobile after registration. Use API 3 to verify.
                                    </p>
                                </div>
                            </div>


                            <!-- ============================================================ -->
                            <!-- API 3 : Remitter OTP Verify                                  -->
                            <!-- ============================================================ -->
                            <div class="col-md-12">
                                <div class="table-responsive" style="margin-bottom:10px;">
                                    <p style="color:blue"><span style="color:black; font-size:16px;"><b>Remitter Verify OTP URL:-</b></span>&nbsp;&nbsp;WebSiteURL/DMT/Remitter_Otp_Verify </p>
                                </div>
                            </div>

                            <div class="col-md-12" style="margin-top:-16px;">
                                <p style="border-bottom:1px solid #f4f4f4;padding-bottom:10px;">
                                    <span style="font-size:17px;">Remitter Verify OTP Format:-</span>&nbsp;&nbsp;
                                </p>
                                <div class="table-responsive" style="margin-bottom:10px;">
                                    <p style="color:blue;"><span style="color:black; font-size:14px;">RequestType&nbsp;&nbsp;=&nbsp;</span>&nbsp;&nbsp;POST</p>
                                    <p style="color:blue;"><span style="color:black; font-size:14px;">Header&nbsp;&nbsp;=&nbsp;</span>&nbsp;&nbsp;content-type : application/json</p>
                                    <p style="color:blue;"><span style="color:black; font-size:14px;">Body&nbsp;&nbsp;=&nbsp;</span>&nbsp;&nbsp;{"Senderno":"Sender Mobile No","Tokenid":"Your Token ID","Userid":"Registered Email","Senderno":"Sender Mobile No","otp":"4-digit OTP","benid":"ID from API 2 response"}</p>
                                    <p style="color:red; font-size:15px;padding-top:7px;">
                                        NOTE : OTP is 4-digit. "benid" is the "id" received from API 2 (Remitter Registration) response.
                                    </p>
                                </div>
                            </div>

                            <div class="col-md-12" style="margin-top:-16px;">
                                <p style="border-bottom:1px solid #f4f4f4;padding-bottom:10px;">
                                    <span style="font-size:17px;">Remitter Verify OTP Response :-</span>&nbsp;&nbsp;
                                </p>
                                <div class="table-responsive" style="margin-bottom:10px;">
                                    <p style="color:blue;">
                                        <span style="color:black; font-size:14px;"></span>&nbsp;&nbsp;
                                        {
                                        "status": "Success",
                                        "response": {
                                        "statuscode": "TXN",
                                        "status": "OTP Verified",
                                        "data": { "beneficiary": [] }
                                        }
                                        }
                                    </p>
                                    <p style="color:red; font-size:15px;padding-top:7px;">
                                        NOTE : 'benid' must be taken from API 2 response. OTP expires quickly — resend if timeout occurs.
                                    </p>
                                </div>
                            </div>


                            <!-- ============================================================ -->
                            <!-- API 4 : Bank List                                            -->
                            <!-- ============================================================ -->
                            <div class="col-md-12">
                                <div class="table-responsive" style="margin-bottom:10px;">
                                    <p style="color:blue"><span style="color:black; font-size:16px;"><b>Bank List URL:-</b></span>&nbsp;&nbsp;WebSiteURL/DMT/Bank_name </p>
                                </div>
                            </div>

                            <div class="col-md-12" style="margin-top:-16px;">
                                <p style="border-bottom:1px solid #f4f4f4;padding-bottom:10px;">
                                    <span style="font-size:17px;">Bank List Format:-</span>&nbsp;&nbsp;
                                </p>
                                <div class="table-responsive" style="margin-bottom:10px;">
                                    <p style="color:blue;"><span style="color:black; font-size:14px;">RequestType&nbsp;&nbsp;=&nbsp;</span>&nbsp;&nbsp;POST</p>
                                    <p style="color:blue;"><span style="color:black; font-size:14px;">Header&nbsp;&nbsp;=&nbsp;</span>&nbsp;&nbsp;content-type : application/json</p>
                                    <p style="color:blue;"><span style="color:black; font-size:14px;">Body&nbsp;&nbsp;=&nbsp;</span>&nbsp;&nbsp;{"Tokenid":"Your Token ID","Userid":"Registered Email"}</p>
                                </div>
                            </div>

                            <div class="col-md-12" style="margin-top:-16px;">
                                <p style="border-bottom:1px solid #f4f4f4;padding-bottom:10px;">
                                    <span style="font-size:17px;">Bank List Response :-</span>&nbsp;&nbsp;
                                </p>
                                <div class="table-responsive" style="margin-bottom:10px;">
                                    <p style="color:blue;">
                                        <span style="color:black; font-size:14px;"></span>&nbsp;&nbsp;
                                        {
                                        "id" : 1405,
                                        "bank_name" : "STATE BANK OF INDIA",
                                        "imps_enabled" : "1",
                                        "aeps_enabled" : "1",
                                        "branch_ifsc" : "SBIN0000001",
                                        "is_down" : "0"
                                        }
                                    </p>
                                    <p style="color:red; font-size:15px;padding-top:7px;">
                                        NOTE : Use 'branch_ifsc' as 'originalifsccode' in API 5 &amp; API 7. Use exact 'bank_name' value in Fund Transfer API 8 as 'BankName'. 'is_down':'1' means bank unavailable — skip it.
                                    </p>
                                </div>
                            </div>


                            <!-- ============================================================ -->
                            <!-- API 5 : Beneficiary Registration                             -->
                            <!-- ============================================================ -->
                            <div class="col-md-12">
                                <div class="table-responsive" style="margin-bottom:10px;">
                                    <p style="color:blue"><span style="color:black; font-size:16px;"><b>Beneficiary Register URL:-</b></span>&nbsp;&nbsp;WebSiteURL/DMT/Beneficiary_Registration </p>
                                </div>
                            </div>

                            <div class="col-md-12" style="margin-top:-16px;">
                                <p style="border-bottom:1px solid #f4f4f4;padding-bottom:10px;">
                                    <span style="font-size:17px;">Beneficiary Register Format:-</span>&nbsp;&nbsp;
                                </p>
                                <div class="table-responsive" style="margin-bottom:10px;">
                                    <p style="color:blue;"><span style="color:black; font-size:14px;">RequestType&nbsp;&nbsp;=&nbsp;</span>&nbsp;&nbsp;POST</p>
                                    <p style="color:blue;"><span style="color:black; font-size:14px;">Header&nbsp;&nbsp;=&nbsp;</span>&nbsp;&nbsp;content-type : application/json</p>
                                    <p style="color:blue;"><span style="color:black; font-size:14px;">Body&nbsp;&nbsp;=&nbsp;</span>&nbsp;&nbsp;{"benname":"Beneficiary Name","Tokenid":"Your Token ID","Userid":"Registered Email","Senderno":"Remitter Mobile No","ifsccode":"Branch IFSC","accountno":"Account Number","originalifsccode":"Root IFSC from API 4"}</p>
                                </div>
                            </div>

                            <div class="col-md-12" style="margin-top:-16px;">
                                <p style="border-bottom:1px solid #f4f4f4;padding-bottom:10px;">
                                    <span style="font-size:17px;">Beneficiary Register Response :-</span>&nbsp;&nbsp;
                                </p>
                                <div class="table-responsive" style="margin-bottom:10px;">
                                    <p style="color:blue;">
                                        <span style="color:black; font-size:14px;"></span>&nbsp;&nbsp;
                                        {
                                        "status": "Success",
                                        "response": {
                                        "statuscode": "TXN",
                                        "status": "Transaction Successful",
                                        "data": {
                                        "remitter" : { "id": "5551b186-...-5fe0a6db66d8" },
                                        "beneficiary" : { "status":"0",
                                        "id":"5551b186-...-5fe0a6db66d8" }
                                        }
                                        }
                                        }
                                    </p>
                                    <p style="color:red; font-size:15px;padding-top:7px;">
                                        NOTE : SAVE remitter "id" — use as "Remiterid" in API 8 (Fund Transfer). SAVE beneficiary "id" — use as "benid" in API 6 (Delete). 'originalifsccode' = 'branch_ifsc' from API 4 Bank List.
                                    </p>
                                </div>
                            </div>


                            <!-- ============================================================ -->
                            <!-- API 6 : Beneficiary Delete                                   -->
                            <!-- ============================================================ -->
                            <div class="col-md-12">
                                <div class="table-responsive" style="margin-bottom:10px;">
                                    <p style="color:blue"><span style="color:black; font-size:16px;"><b>Beneficiary Delete URL:-</b></span>&nbsp;&nbsp;WebSiteURL/DMT/Beneficiary_delete </p>
                                </div>
                            </div>

                            <div class="col-md-12" style="margin-top:-16px;">
                                <p style="border-bottom:1px solid #f4f4f4;padding-bottom:10px;">
                                    <span style="font-size:17px;">Beneficiary Delete Format:-</span>&nbsp;&nbsp;
                                </p>
                                <div class="table-responsive" style="margin-bottom:10px;">
                                    <p style="color:blue;"><span style="color:black; font-size:14px;">RequestType&nbsp;&nbsp;=&nbsp;</span>&nbsp;&nbsp;POST</p>
                                    <p style="color:blue;"><span style="color:black; font-size:14px;">Header&nbsp;&nbsp;=&nbsp;</span>&nbsp;&nbsp;content-type : application/json</p>
                                    <p style="color:blue;"><span style="color:black; font-size:14px;">Body&nbsp;&nbsp;=&nbsp;</span>&nbsp;&nbsp;{"benid":"Beneficiary ID (API 5)","Tokenid":"Your Token ID","Userid":"Registered Email","Remiterid":"Remitter ID (API 5)","Senderno":"Remitter Mobile No"}</p>
                                </div>
                            </div>

                            <div class="col-md-12" style="margin-top:-16px;">
                                <p style="border-bottom:1px solid #f4f4f4;padding-bottom:10px;">
                                    <span style="font-size:17px;">Beneficiary Delete Response :-</span>&nbsp;&nbsp;
                                </p>
                                <div class="table-responsive" style="margin-bottom:10px;">
                                    <p style="color:blue;">
                                        <span style="color:black; font-size:14px;"></span>&nbsp;&nbsp;
                                        {
                                        "status": "Success",
                                        "response": {
                                        "statuscode": "TXN",
                                        "status": "Beneficiary Delete Successfully",
                                        "data": {
                                        "otp": "0"
                                        }
                                        }
                                        }
                                    </p>
                                    <p style="color:red; font-size:15px;padding-top:7px;">
                                        NOTE : "benid" = beneficiary id from API 5 response. "Remiterid" = remitter id from API 5 response.
                                    </p>
                                </div>
                            </div>


                            <!-- ============================================================ -->
                            <!-- API 7 : Account Verification                                 -->
                            <!-- ============================================================ -->
                            <div class="col-md-12">
                                <div class="table-responsive" style="margin-bottom:10px;">
                                    <p style="color:blue"><span style="color:black; font-size:16px;"><b>Account Verification URL:-</b></span>&nbsp;&nbsp;WebSiteURL/DMT/Beneficiary_AccountVerification </p>
                                </div>
                            </div>

                            <div class="col-md-12" style="margin-top:-16px;">
                                <p style="border-bottom:1px solid #f4f4f4;padding-bottom:10px;">
                                    <span style="font-size:17px;">Account Verification Format:-</span>&nbsp;&nbsp;
                                </p>
                                <div class="table-responsive" style="margin-bottom:10px;">
                                    <p style="color:blue;"><span style="color:black; font-size:14px;">RequestType&nbsp;&nbsp;=&nbsp;</span>&nbsp;&nbsp;POST</p>
                                    <p style="color:blue;"><span style="color:black; font-size:14px;">Header&nbsp;&nbsp;=&nbsp;</span>&nbsp;&nbsp;content-type : application/json</p>
                                    <p style="color:blue;"><span style="color:black; font-size:14px;">Body&nbsp;&nbsp;=&nbsp;</span>&nbsp;&nbsp;{"accountno":"Account Number","Tokenid":"Your Token ID","Userid":"Registered Email","ifsccode":"Branch IFSC","Senderno":"Remitter Mobile No","Transid":"Unique Transaction ID","BankName":"Exact name from API 4"}</p>
                                </div>
                            </div>

                            <div class="col-md-12" style="margin-top:-16px;">
                                <p style="border-bottom:1px solid #f4f4f4;padding-bottom:10px;">
                                    <span style="font-size:17px;">Account Verification Response :-</span>&nbsp;&nbsp;
                                </p>
                                <div class="table-responsive" style="margin-bottom:10px;">
                                    <p style="color:blue;">
                                        <span style="color:black; font-size:14px;"></span>&nbsp;&nbsp;
                                        {
                                        "statuscode" : "TXN",
                                        "status" : "Transaction Successful",
                                        "data": {
                                        "benename" : "Manoj",
                                        "ipay_id" : "W260327170355ZDYU",
                                        "verification_status" : "VERIFIED",
                                        "charged_amt" : 0.0
                                        }
                                        }
                                    </p>
                                    <p style="color:red; font-size:15px;padding-top:7px;">
                                        NOTE : Proceed to Fund Transfer ONLY if verification_status = "VERIFIED". "benename" is the bank-registered account holder name — confirm identity before transfer. "Transid" must be unique per call — generate UUID or timestamp-based ID.
                                    </p>
                                </div>
                            </div>


                            <!-- ============================================================ -->
                            <!-- API 8 : Fund Transfer                                        -->
                            <!-- ============================================================ -->
                            <div class="col-md-12">
                                <div class="table-responsive" style="margin-bottom:10px;">
                                    <p style="color:blue"><span style="color:black; font-size:16px;"><b>Fund Transfer URL:-</b></span>&nbsp;&nbsp;WebSiteURL/DMT/Fund_transfer </p>
                                </div>
                            </div>

                            <div class="col-md-12" style="margin-top:-16px;">
                                <p style="border-bottom:1px solid #f4f4f4;padding-bottom:10px;">
                                    <span style="font-size:17px;">Fund Transfer Format:-</span>&nbsp;&nbsp;
                                </p>
                                <div class="table-responsive" style="margin-bottom:10px;">
                                    <p style="color:blue;"><span style="color:black; font-size:14px;">RequestType&nbsp;&nbsp;=&nbsp;</span>&nbsp;&nbsp;POST</p>
                                    <p style="color:blue;"><span style="color:black; font-size:14px;">Header&nbsp;&nbsp;=&nbsp;</span>&nbsp;&nbsp;content-type : application/json</p>
                                    <p style="color:blue;"><span style="color:black; font-size:14px;">Body&nbsp;&nbsp;=&nbsp;</span>&nbsp;&nbsp;{"Tokenid":"Your Token ID","Userid":"Registered Email","Senderno":"Remitter Mobile No","amount":"Min 100 (INR)","Mode":"IMPS or NEFT","Transid":"Unique Transaction ID","accountno":"Account Number","ifsccode":"Branch IFSC","BankName":"Exact name from API 4"}</p>
                                    <p style="color:red; font-size:15px;padding-top:7px;">
                                        NOTE :- In This Service Mode are IMPS or NEFT. Minimum amount is Rs. 100. "BankName" must exactly match the value from Bank List API (e.g. "STATE BANK OF INDIA").
                                    </p>
                                </div>
                            </div>

                            <div class="col-md-12" style="margin-top:-16px;">
                                <p style="border-bottom:1px solid #f4f4f4;padding-bottom:10px;">
                                    <span style="font-size:17px;">Fund Transfer Response :-</span>&nbsp;&nbsp;
                                </p>
                                <div class="table-responsive" style="margin-bottom:10px;">
                                    <p style="color:blue;">
                                        <span style="color:black; font-size:14px;"></span>&nbsp;&nbsp;
                                        {
                                        "Status": "Success / Failed / Pending",
                                        "orderId": "654654641222111",
                                        "Amount": "100",
                                        "Message": "Transaction Successful",
                                        "Remainbal": "91.00"
                                        }
                                    </p>
                                    <p style="color:red; font-size:15px;padding-top:7px;">
                                        NOTE : Min amount = Rs. 100. Lower amounts will be rejected. 'Mode' must be uppercase: 'IMPS' (instant) or 'NEFT' (batch). If Status="Pending" then poll status API for final result. Store "orderId" for reconciliation.
                                    </p>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
