    function bootExtraCommReport() {
        var $ = window.jQuery;
        if (!$ || !$.fn || !$.fn.datepicker) {
            window.setTimeout(bootExtraCommReport, 50);
            return;
        }

        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm('#dealerExtracommReportForm');
        } else {
            $('#txt_frm_date, #txt_to_date').datepicker({
                format: 'yyyy-mm-dd',
                todayHighlight: true,
                autoclose: true,
                orientation: 'bottom auto',
                container: 'body'
            });
            if ($('#dealerExtracommReportForm').attr('data-date-mode') !== 'post') {
                $('#txt_frm_date').datepicker('setDate', new Date());
                $('#txt_to_date').datepicker('setDate', new Date());
            }
        }

        function pinExtraDatepicker(e) {
            if (typeof window.repositionAdminDatepickerForMobile === 'function') {
                window.repositionAdminDatepickerForMobile(e && e.target ? e.target : this);
            }
        }
        $(document).off('show.extraDp shown.extraDp').on('show.extraDp shown.extraDp', '#txt_frm_date, #txt_to_date', pinExtraDatepicker);
        $(window).off('resize.extraDp orientationchange.extraDp').on('resize.extraDp orientationchange.extraDp', pinExtraDatepicker);

        $('#btnExport').off('click.extraEx').on('click.extraEx', function () {
            extraDownloadExcel(extraBuildExcelHtml(extraTableRows()));
        });
        $('#btnPDF').off('click.extraPdf').on('click.extraPdf', function () {
            extraOpenPdf(extraBuildPdfHtml(extraTableRows()));
        });
    }

    if (document.readyState === 'complete') {
        bootExtraCommReport();
    } else {
        window.addEventListener('load', bootExtraCommReport);
    }
</script>

