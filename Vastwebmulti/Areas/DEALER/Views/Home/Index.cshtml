<script>
    window.adminDistrictListUrl = '@Url.Action("DistrictList", "Home")';

    function drRemSearch() {
        var $ = window.jQuery;
        var value = ($('#drRemSearchInput').val() || '').toLowerCase();
        $('#dealerRetailerTable tbody tr').filter(function () {
            if ($(this).hasClass('vm-opr-table-empty-row')) {
                return true;
            }
            $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
        });
    }

    function toggleDrRemTotals() {
        var $ = window.jQuery;
        var panel = $('#drRemTotalsPanel');
        if (panel.is(':visible')) {
            hideDrRemTotals();
            return;
        }
        panel.slideDown(180).attr('aria-hidden', 'false');
        $('.vm-dr-rem-totals-btn').attr('aria-expanded', 'true');
    }

    function hideDrRemTotals() {
        var $ = window.jQuery;
        $('#drRemTotalsPanel').slideUp(180).attr('aria-hidden', 'true');
        $('.vm-dr-rem-totals-btn').attr('aria-expanded', 'false');
    }

    function handleCreate_btn(str) {
        if (!str) {
            $('#token_err').removeClass('hidden');
        } else {
            $('#token_err').addClass('hidden');
        }
    }

    $('#btnEditrem').click(function () {
        $('#lblberror').text('');
        var pancard = $('#Pan1').val();
        if (pancard.length > 0) {
            var pancardformate = new RegExp('^([A-Za-z]){5}([0-9]){4}([A-Za-z]){1}$');
            if (!pancardformate.test(pancard)) {
                $('#lblberror').text('Invalid Pan No');
                return false;
            }
        }

        var aadhar = $('#Adhaar1').val();
        var res = validatesss(aadhar);
        if (res == false) {
            $('#lblberror').text('Invalid Aadhar No');
            return false;
        }

        var gst = $('#Gst1').val();
        if (gst.length > 0) {
            var gstinformat = new RegExp('^([0][1-9]|[1-2][0-9]|[3][0-5])([a-zA-Z]{5}[0-9]{4}[a-zA-Z]{1}[1-9a-zA-Z]{1}[zZ]{1}[0-9a-zA-Z]{1})+$');
            if (!gstinformat.test(gst)) {
                $('#lblberror').text('Invalid GST No');
                return false;
            }
        }
    });

    function animation(userid) {
        $("#Retailerid").val(userid);
        var url = '@Url.Action("RetailerSearch", "Home")';
        $.ajax({
            url: url,
            data: { userid: userid },
            cache: false,
            type: "POST",
            success: function (data) {
                $("#Name1").val(data[0].RetailerName);
                $("#Firm1").val(data[0].Frm_Name);
                $("#Address1").val(data[0].Address);
                $("#Pincode1").val(data[0].Pincode);
                $("#Pan1").val(data[0].PanCard);
                $("#Adhaar1").val(data[0].AadharCard);
                $("#Capping1").val(data[0].caption);
                $("#Gst1").val(data[0].gst);
                $("#State1").val(data[0].State);
                if (typeof window.drRemInitModalSelects === 'function') {
                    window.drRemInitModalSelects(document.getElementById('defaultModal1'));
                }
                if (data[0].pancardPath != null && data[0].PSAStatus == "Y") {
                    document.getElementById("Pan1").readOnly = true;
                } else {
                    if (data[0].pancardPath != null) {
                        $("#pancardPathdisplay").hide();
                    } else {
                        $("#pancardPathdisplay").show();
                    }
                }

                if (data[0].aadharcardPath != null && data[0].AadhaarStatus == "Y") {
                    document.getElementById("Adhaar1").readOnly = true;
                }
                if (data[0].aadharcardPath != null && data[0].BackSideAadharcardphoto != null) {
                    $("#aadharcardPathdisplay").hide();
                    $("#aadharcardPathdisplay2").hide();
                } else {
                    $("#aadharcardPathdisplay").show();
                    $("#aadharcardPathdisplay2").show();
                }
                if (data[0].videokycpath == null && data[0].videokycstatus == "N" && data[0].AadhaarStatus == "Y" && data[0].PSAStatus == "Y" && data[0].ShopwithSalfieStatus == "Y") {
                    $("#kycvideodisplay").show();
                } else {
                    $("#kycvideodisplay").hide();
                }
                if (data[0].ShopwithSalfie != null) {
                    $("#Selfiedisplay").hide();
                } else {
                    $("#Selfiedisplay").show();
                }

                if (data[0].pancardPath != null && data[0].PSAStatus == "Y" && data[0].aadharcardPath != null && data[0].AadhaarStatus == "Y") {
                    document.getElementById("Pan1").readOnly = true;
                    document.getElementById("Adhaar1").readOnly = true;
                    document.getElementById("Name1").readOnly = true;
                    document.getElementById("Firm1").readOnly = true;
                    document.getElementById("Address1").readOnly = true;
                    document.getElementById("State1").readOnly = true;
                    document.getElementById("District1").readOnly = true;
                    document.getElementById("Pincode1").readOnly = true;
                }
                var objSelect1 = document.getElementById("District1");
                binddist(data[0].State, data[0].District, objSelect1);
                $('#lblberror').text('');
                $('#defaultModal1').modal('show');
            },
            error: function (req, stmsg, reponse) {
                alert("error : " + reponse + stmsg.st);
            }
        });
    }

    function binddist(staid, dist, objSelect1) {
        if (typeof window.drRemLoadDistrictSelect === 'function') {
            window.drRemLoadDistrictSelect($(objSelect1), staid, dist);
            return;
        }
        alert('District loader is not ready. Please refresh the page.');
    }

    $(document).ready(function () {
        var succ = '@TempData["msgrem"]';
        if (succ != "" && succ != null) {
            swal("Good job!", succ, "success");
        }
        var mobileconfrimation = '@TempData["mobileno"]';
        if (mobileconfrimation != "" && mobileconfrimation != null) {
            swal("Oops...", mobileconfrimation, "error");
        }
        var mailconfrimation = '@TempData["emailconfrim"]';
        if (mailconfrimation != "" && mailconfrimation != null) {
            swal({ html: true, title: 'Oops!', text: mailconfrimation, type: 'error' });
        }
        var editdata = '@TempData["edit"]';
        if (editdata != null && editdata != "") {
            swal("Good job!", editdata, "success");
        }
        var errormessage = '@TempData["Error"]';
        if (errormessage != "" && errormessage != null) {
            swal("Oops...", errormessage, "error");
        }
        var resendmail = '@ViewData["ResendMail"]';
        if (resendmail != null && resendmail != "") {
            swal("Good job!", resendmail, "success");
        }
    });

    function isNumber(evt) {
        var iKeyCode = (evt.which) ? evt.which : evt.keyCode;
        if (iKeyCode != 46 && iKeyCode > 31 && (iKeyCode < 48 || iKeyCode > 57)) {
            return false;
        }
        return true;
    }

    function sendotpRetailer(ID) {
        $.ajax({
            type: 'Post',
            url: "@Url.Action("DeleteRetailerSendOTP", "Home")",
            dataType: 'json',
            cache: false,
            async: false,
            success: function (result) {
                if (result == "Success") {
                    $("#RetailerId").val(ID);
                    $("#OTPModal").modal('show');
                } else {
                    swal({ title: "Failed !", text: "Something went wrong.", type: "error" });
                }
            }
        });
    }

    function DeleteRetailer() {
        var OTP = $("#txtotp").val();
        var retailerid = $("#RetailerId").val();

        if (OTP != "") {
            $("#OTPModal").modal('hide');
            swal({
                text: "<p style='color:#948f8b; font-size:20px;border-bottom:1px solid #dddddd;margin-top:-12px;padding-bottom:12px;'>Delete</p></br><i class='fa fa-trash'style='font-size:72px;color:red;'></i></br><p style=''>Are you sure ?</p>",
                html: true,
                title: "",
                showCancelButton: true,
                confirmButtonColor: "#f9a7a7",
                confirmButtonText: "Yes, delete it!",
                closeOnConfirm: false
            },
            function (isConfirm) {
                if (isConfirm) {
                    $.ajax({
                        type: "POST",
                        url: '@Url.Action("Delete_Retailer", "Home")',
                        data: { 'RetailerId': retailerid, 'OTP': OTP },
                        cache: false,
                        dataType: 'json',
                        async: true,
                        success: function (result) {
                            if (result == "Success") {
                                swal({ title: "Data Removed !", text: "Data Deleted Successfully.", type: "success" },
                                    function () { location.reload(); });
                            } else if (result == "OTPWrong") {
                                swal("Wrong OTP !", "OTP Is Wrong !. Please try again.", "error");
                                $("#OTPModal").modal('show');
                            } else {
                                swal({ title: "Failed !", text: "Something went wrong.", type: "error" },
                                    function () { location.reload(); });
                            }
                        }
                    });
                }
            });
            return true;
        } else {
            swal("Oops !", "Please Enter OTP", "error");
            $("#OTPModal").modal('show');
            return false;
        }
    }

    (function () {
        var inputs = document.getElementById('myform').querySelectorAll('input[type="text"], input[type="password"], textarea, select');
        var mobile_ref = document.getElementById('Mobile');
        var email_ref = document.getElementById('Email');

        disable_inputs();

        if (mobile_ref) {
            mobile_ref.addEventListener('keyup', function (e) {
                if (e.target.value.length == 10) {
                    block_inputs();
                } else {
                    disable_inputs();
                }
            });
        }

        if (email_ref) {
            email_ref.addEventListener('keyup', function (e) {
                if (mobile_ref && mobile_ref.value.length == 10 && e.target.value) {
                    block_inputs();
                } else {
                    disable_inputs();
                }
            });
        }

        function disable_inputs() {
            for (var i = 0; i < inputs.length; i++) {
                if (!['Mobile', 'Email'].includes(inputs[i].getAttribute('id'))) {
                    inputs[i].setAttribute('disabled', true);
                    if (inputs[i].tagName !== 'SELECT') {
                        inputs[i].value = '';
                    }
                }
            }
        }

        function block_inputs() {
            for (var i = 0; i < inputs.length; i++) {
                if (!['Mobile', 'Email'].includes(inputs[i].getAttribute('id'))) {
                    inputs[i].removeAttribute('disabled');
                    if (inputs[i].tagName !== 'SELECT' && inputs[i].getAttribute('id') !== 'District') {
                        inputs[i].value = '';
                    }
                }
            }
        }
    })();
</script>

