                $.ajax({
                    url: url,
                    data: { Id: stateId },
                    type: 'POST',
                    dataType: 'json',
                    cache: false
                }).done(function (data) {
                    $district.empty().append($('<option></option>').val('0').text('Select District'));
                    if ($.isArray(data)) {
                        for (var i = 0; i < data.length; i++) {
                            $district.append($('<option></option>').val(data[i].Value).text(data[i].Text));
                        }
                    }
                    if (selectedValue != null && selectedValue !== '') {
                        $district.val(String(selectedValue));
                    }
                    drRemInitOneSelect2($district);
                }).fail(function () {
                    $district.empty().append($('<option></option>').val('0').text('Select District'));
                    drRemInitOneSelect2($district);
                });
            };

            function drRemBindStateDistrictPair(stateSelector, districtSelector) {
                var $ = drRemJQ();
                var $state = $(stateSelector);
                if (!$ || !$state.length || $state.attr('data-dr-rem-bound') === 'true') {
                    return;
                }
                $state.attr('data-dr-rem-bound', 'true');
                $state.off('change.drRemDistrict select2:select.drRemDistrict');
                $state.on('change.drRemDistrict select2:select.drRemDistrict', function () {
                    drRemBlockModalHide(900);
                    drRemSetIgnoreBackdropClick();
                    window.setTimeout(function () {
                        window.drRemLoadDistrictSelect($(districtSelector), $state.val());
                    }, 40);
                });
            }

            window.drRemInitModalSelects = function (modalEl) {
                var $ = drRemJQ();
                if (!$ || !$.fn.select2 || !modalEl) {
                    return;
                }
                var $modal = $(modalEl);
                $modal.find('select.vm-dr-rem-select').each(function () {
                    drRemInitOneSelect2($(this));
                });
                if ($modal.find('#State').length && $modal.find('#District').length) {
                    drRemBindStateDistrictPair('#State', '#District');
                }
                if ($modal.find('#State1').length && $modal.find('#District1').length) {
                    drRemBindStateDistrictPair('#State1', '#District1');
                }
            };

            function bootDrRemSelects() {
                window.drRemInitModalSelects(document.getElementById('defaultModal'));
                window.drRemInitModalSelects(document.getElementById('defaultModal1'));
            }

            ['defaultModal', 'defaultModal1'].forEach(function (id) {
                var el = document.getElementById(id);
                if (!el) {
                    return;
                }
                drRemProtectModalFromSelect2(el);
                el.addEventListener('shown.bs.modal', function () {
                    window.setTimeout(function () {
                        window.drRemInitModalSelects(el);
                    }, 80);
                });
            });

            var createBtn = document.getElementById('btnCreateRetailer');
            if (createBtn) {
                createBtn.addEventListener('click', function () {
                    window.setTimeout(function () {
                        window.drRemInitModalSelects(document.getElementById('defaultModal'));
                    }, 300);
                });
            }

            drRemJQ()(function () {
                drRemBindSelect2ModalGuards();
                bootDrRemSelects();
            });
            drRemJQ()(window).on('load', function () {
                window.setTimeout(bootDrRemSelects, 300);
                window.setTimeout(bootDrRemSelects, 1000);
            });
        })();
    </script>
}
