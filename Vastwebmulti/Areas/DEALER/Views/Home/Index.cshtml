@using System;
@using System.Linq;
@using Vastwebmulti.Models;
@model Vastwebmulti.Areas.DEALER.Models.RetailerModel
@{
    ViewBag.Title = "User Management";
    Layout = "~/Areas/DEALER/Views/Shared/_Layout.cshtml";

    string token_validate = Model.Dealertoken <= 0 ? "" : "#defaultModal";

    VastwebmultiEntities DB1 = new VastwebmultiEntities();
    var usernname = DB1.Usernicknames.Where(aa => aa.Role == "Retailer").ToList();
    var favimage = "";
    if (usernname.Count() > 0)
    {
        if (usernname.SingleOrDefault().Role == "Retailer")
        {
            favimage = usernname.SingleOrDefault().NickName;
        }
    }

    var retailers = Model.dealer_retailer?.ToList() ?? new System.Collections.Generic.List<Dealer_retailer_Result>();
    var recordCount = retailers.Count;
    var activeCount = retailers.Count(x => string.Equals(x.Status, "Y", StringComparison.OrdinalIgnoreCase));
    var totalBalance = retailers.Sum(x => x.Remainamount);
    var pendingEmailCount = retailers.Count(x => !x.Emailconfirmed);
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=15" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/dealer-dth-booking-report-modern.css?v=39" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<script>document.body.classList.add('saas-sell-rch-dp-page');</script>

<section class="content saas-admin-account-page saas-admin-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-dth-booking-report-page saas-dealer-retailer-index-page saas-ecommerce-report-page">

    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">
            <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-dr-rem-toolbar-top">
                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>Account Active</li>
                    <li>User Management</li>
                </ol>
                <div class="vm-dr-rem-toolbar-actions">
                    <span class="text-danger hidden vm-dr-rem-token-err" id="token_err">Your remain token is low</span>
                    <button type="button" id="btnCreateRetailer" class="saas-acc-btn saas-acc-btn--search vm-dr-rem-create-btn" data-toggle="modal" data-target="@token_validate" onclick="handleCreate_btn('@token_validate')" title="Create @favimage account">
                        <i class="fas fa-user-plus" aria-hidden="true"></i> Create @favimage
                    </button>
                </div>
            </div>

            <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="drRemTotalsPanel" style="display:none;" aria-hidden="true">
                <div class="vm-dmt-totals-head">
                    <div class="vm-dmt-totals-head__title">
                        <i class="fas fa-chart-pie" aria-hidden="true"></i>
                        <span>Retailer totals</span>
                    </div>
                    <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideDrRemTotals()" title="Hide totals" aria-label="Hide totals">
                        <i class="fas fa-chevron-up" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid vm-dr-rem-totals-grid">
                    <div class="vm-opr-total-card vm-opr-total-card--primary">
                        <span class="vm-opr-total-card__label">Total @favimage</span>
                        <strong class="vm-opr-total-card__value">@recordCount</strong>
                    </div>
                    <div class="vm-opr-total-card vm-opr-total-card--success">
                        <span class="vm-opr-total-card__label">Active</span>
                        <strong class="vm-opr-total-card__value">@activeCount</strong>
                    </div>
                    <div class="vm-opr-total-card vm-opr-total-card--pending">
                        <span class="vm-opr-total-card__label">Pending Email</span>
                        <strong class="vm-opr-total-card__value">@pendingEmailCount</strong>
                    </div>
                    <div class="vm-opr-total-card">
                        <span class="vm-opr-total-card__label">Total Balance</span>
                        <strong class="vm-opr-total-card__value">@totalBalance.ToString("N2")</strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-users" aria-hidden="true"></i>
                        <span>All @favimage details</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <div class="vm-ft-search-wrap vm-dr-rem-table-search">
                            <input class="form-control vm-dr-rem-search-input" type="text" id="drRemSearchInput" placeholder="Search retailer..." autocomplete="off" onkeyup="drRemSearch()" />
                        </div>
                        <span class="vm-radiant-inline-total" title="Total live balance">
                            Balance: <strong>&#8377; @totalBalance.ToString("N2")</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-radiant-totals-btn vm-dr-rem-totals-btn" onclick="toggleDrRemTotals()" title="Show totals" aria-expanded="false" aria-controls="drRemTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="dealerRetailerTable" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>SR.NO</th>
                                    <th>Status</th>
                                    <th>Firm&nbsp;Name</th>
                                    <th>Name</th>
                                    <th>Reg&nbsp;Email</th>
                                    <th>Mobile</th>
                                    <th>Remain&nbsp;Bal.</th>
                                    <th>State</th>
                                    <th>District</th>
                                    <th>Address</th>
                                    <th>Join&nbsp;Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (retailers.Any())
                                {
                                    var sr = 1;
                                    foreach (var item in retailers)
                                    {
                                        var isActive = string.Equals(item.Status, "Y", StringComparison.OrdinalIgnoreCase);
                                        var emailClass = item.Emailconfirmed ? "" : " vm-dr-rem-email-pending";
                                        <tr class="vm-dr-rem-row@(isActive ? "" : " vm-dr-rem-row--inactive")@(item.Emailconfirmed ? "" : " vm-dr-rem-row--pending")">
                                            <td class="vm-dmt-sr-cell">@sr</td>
                                            <td class="vm-dr-rem-status-cell">
                                                @if (isActive)
                                                {
                                                    <span class="vm-dr-rem-status vm-dr-rem-status--on">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="vm-dr-rem-status vm-dr-rem-status--off">Inactive</span>
                                                }
                                            </td>
                                            <td class="vm-dr-rem-firm-cell">@(string.IsNullOrWhiteSpace(item.Frm_Name) ? "—" : item.Frm_Name)</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.RetailerName) ? "—" : item.RetailerName)</td>
                                            <td class="vm-dr-rem-email-cell"><span class="vm-dr-rem-email@emailClass">@(string.IsNullOrWhiteSpace(item.Email) ? "—" : item.Email)</span></td>
                                            <td>@(string.IsNullOrWhiteSpace(item.Mobile) ? "—" : item.Mobile)</td>
                                            <td class="vm-dr-rem-num-cell">@item.Remainamount.ToString("N2")</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.State_name) ? "—" : item.State_name)</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.Dist_Desc) ? "—" : item.Dist_Desc)</td>
                                            <td class="vm-dr-rem-address-cell" title="@item.Address">@(string.IsNullOrWhiteSpace(item.Address) ? "—" : item.Address)</td>
                                            <td>@item.JoinDate.ToString("dd-MM-yyyy")</td>
                                            <td class="vm-dmt-action-cell">
                                                <button type="button" class="vm-dr-rem-edit-btn" onclick="animation('@item.RetailerId')" title="Edit information">
                                                    <i class="fas fa-edit" aria-hidden="true"></i> Edit
                                                </button>
                                            </td>
                                        </tr>
                                        sr++;
                                    }
                                }
                                else
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="12" class="vm-opr-table-empty vm-dmt-table-empty">
                                            <i class="fas fa-users" aria-hidden="true"></i>
                                            <span>No @favimage records found.</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            @if (retailers.Any())
                            {
                                <tfoot>
                                    <tr class="vm-dr-rem-table-foot">
                                        <td><strong>Total</strong></td>
                                        <td colspan="5"></td>
                                        <td><strong>@totalBalance.ToString("N2")</strong></td>
                                        <td colspan="5"></td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<!-- Create Retailer Modal -->
<div class="modal fade saas-admin-modal vm-dmt-modal vm-dr-rem-create-modal" id="defaultModal" tabindex="-1" role="dialog" aria-labelledby="drRemCreateTitle" aria-hidden="true" data-backdrop="static" data-keyboard="true">
    <div class="modal-dialog modal-lg vm-dr-rem-modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header saas-admin-modal-header accent-emerald">
                <div class="saas-admin-modal-head-main">
                    <div class="saas-admin-modal-icon"><i class="fas fa-user-plus" aria-hidden="true"></i></div>
                    <div class="saas-admin-modal-title-wrap">
                        <h4 class="modal-title saas-admin-modal-title" id="drRemCreateTitle">Create New @favimage</h4>
                        <span class="saas-admin-modal-subtitle">Add a new retailer account under your dealer panel</span>
                    </div>
                </div>
                <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close">
                    <i class="fas fa-times" aria-hidden="true"></i>
                </button>
            </div>
            @using (Html.BeginForm("InsertRetailer", "Home", FormMethod.Post))
            {
                <div class="modal-body saas-admin-modal-body saas-admin-modal-scroll" id="myform">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="vm-dmt-modal-grid vm-dmt-modal-grid--2">
                        <div class="vm-dmt-modal-field">
                            <label>Mobile <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.Mobile, new { @class = "form-control", required = "required", placeholder = "Enter mobile number", onkeypress = "return isNumber(event)", minlength = "10", maxlength = "10" })
                            @Html.ValidationMessageFor(m => m.Mobile, "", new { @class = "text-danger" })
                        </div>
                        <div class="vm-dmt-modal-field">
                            <label>Email ID</label>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Enter email id" })
                        </div>
                        <div class="vm-dmt-modal-field">
                            <label>Aadhar Card</label>
                            @Html.TextBoxFor(m => m.Adhaar, new { @class = "form-control", placeholder = "Enter aadhar number", onkeypress = "return isNumber(event)", maxlength = "12" })
                        </div>
                        <div class="vm-dmt-modal-field">
                            <label>Pancard</label>
                            @Html.TextBoxFor(m => m.Pan, new { @class = "form-control", placeholder = "Enter pancard number", maxlength = "10", @style = "text-transform:uppercase" })
                        </div>
                        <div class="vm-dmt-modal-field vm-dmt-modal-field--full">
                            <label>Name <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Enter name", required = "required" })
                            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
                        </div>
                        <div class="vm-dmt-modal-field vm-dmt-modal-field--full">
                            <label>Firm Name <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.Firm, new { @class = "form-control", placeholder = "Enter firm name", required = "required" })
                            @Html.ValidationMessageFor(m => m.Firm, "", new { @class = "text-danger" })
                        </div>
                        <div class="vm-dmt-modal-field">
                            <label>GST Number</label>
                            @Html.TextBoxFor(m => m.Gst, new { @class = "form-control", placeholder = "Enter GST number", maxlength = "15", @style = "text-transform:uppercase" })
                        </div>
                        <div class="vm-dmt-modal-field">
                            <label>Capping <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.Capping, new { @class = "form-control", placeholder = "Enter capping", onkeypress = "return isNumber(event)" })
                            @Html.ValidationMessageFor(m => m.Capping, "", new { @class = "text-danger" })
                        </div>
                        <div class="vm-dmt-modal-field">
                            <label>State <span class="text-danger">*</span></label>
                            @Html.DropDownListFor(m => m.State, (IEnumerable<SelectListItem>)ViewBag.state, "Select State", new { @class = "form-control vm-dr-rem-select", required = "required", data_search_placeholder = "Search state..." })
                            @Html.ValidationMessageFor(m => m.State, "", new { @class = "text-danger" })
                        </div>
                        <div class="vm-dmt-modal-field">
                            <label>District <span class="text-danger">*</span></label>
                            <select id="District" name="District" class="form-control vm-dr-rem-select" required="" data-search-placeholder="Search district...">
                                <option value="0">Select District</option>
                            </select>
                            @Html.ValidationMessageFor(m => m.District, "", new { @class = "text-danger" })
                        </div>
                        <div class="vm-dmt-modal-field vm-dmt-modal-field--full">
                            <label>Address <span class="text-danger">*</span></label>
                            @Html.TextAreaFor(m => m.Address, new { @class = "form-control", placeholder = "Enter address", required = "required", rows = 3 })
                            @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger" })
                        </div>
                        <div class="vm-dmt-modal-field vm-dmt-modal-field--full">
                            <label>Pincode <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.Pincode, new { @class = "form-control", placeholder = "Enter pin code", required = "required", onkeypress = "return isNumber(event)", maxlength = "6", minlength = "6" })
                            @Html.ValidationMessageFor(m => m.Pincode, "", new { @class = "text-danger" })
                        </div>
                    </div>
                </div>
                <div class="modal-footer saas-admin-modal-footer">
                    <button type="submit" class="saas-admin-modal-btn saas-admin-modal-btn--primary">
                        <i class="fas fa-user-plus" aria-hidden="true"></i> Create User
                    </button>
                    <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal">
                        <i class="fas fa-times" aria-hidden="true"></i> Close
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Edit Retailer Modal -->
<div class="modal fade saas-admin-modal vm-dmt-modal vm-dr-rem-edit-modal" id="defaultModal1" tabindex="-1" role="dialog" aria-labelledby="drRemEditTitle" aria-hidden="true" data-backdrop="static" data-keyboard="true">
    <div class="modal-dialog modal-lg vm-dr-rem-modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header saas-admin-modal-header accent-violet">
                <div class="saas-admin-modal-head-main">
                    <div class="saas-admin-modal-icon"><i class="fas fa-user-edit" aria-hidden="true"></i></div>
                    <div class="saas-admin-modal-title-wrap">
                        <h4 class="modal-title saas-admin-modal-title" id="drRemEditTitle">Edit @favimage Information</h4>
                        <span class="saas-admin-modal-subtitle">Update retailer profile and KYC details</span>
                    </div>
                </div>
                <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close">
                    <i class="fas fa-times" aria-hidden="true"></i>
                </button>
            </div>
            @using (Html.BeginForm("Editretailer", "Home", FormMethod.Post, new { encType = "multipart/form-data" }))
            {
                @Html.HiddenFor(m => m.Retailerid)
                <div class="modal-body saas-admin-modal-body saas-admin-modal-scroll">
                    <label id="lblberror" class="text-danger vm-dr-rem-edit-error"></label>
                    <div class="vm-dmt-modal-grid vm-dmt-modal-grid--2">
                        <div class="vm-dmt-modal-field vm-dmt-modal-field--full">
                            <label>Name</label>
                            @Html.TextBoxFor(m => m.Name1, new { @class = "form-control", placeholder = "Enter name", required = "required" })
                            @Html.ValidationMessageFor(m => m.Name1, "", new { @class = "text-danger" })
                        </div>
                        <div class="vm-dmt-modal-field vm-dmt-modal-field--full">
                            <label>Firm Name</label>
                            @Html.TextBoxFor(m => m.Firm1, new { @class = "form-control", placeholder = "Enter firm name", required = "required" })
                            @Html.ValidationMessageFor(m => m.Firm1, "", new { @class = "text-danger" })
                        </div>
                        <div class="vm-dmt-modal-field">
                            <label>Pancard</label>
                            @Html.TextBoxFor(m => m.Pan1, new { @class = "form-control", placeholder = "Enter pancard number", maxlength = "10", @style = "text-transform:uppercase", required = "required" })
                        </div>
                        <div class="vm-dmt-modal-field">
                            <label>Aadhar Card</label>
                            @Html.TextBoxFor(m => m.Adhaar1, new { @class = "form-control", placeholder = "Enter aadhar number", onkeypress = "return isNumber(event)", maxlength = "12", required = "required" })
                        </div>
                        <div class="vm-dmt-modal-field" id="aadharcardPathdisplay" style="display:none;">
                            <label>Aadhar Front Image</label>
                            <input type="file" class="form-control" id="aadharcardfrontdoc" name="aadharcardfrontdoc" data-val="true" />
                        </div>
                        <div class="vm-dmt-modal-field" id="aadharcardPathdisplay2" style="display:none;">
                            <label>Aadhar Back Image</label>
                            <input type="file" class="form-control" id="aadharcardbackdoc" name="aadharcardbackdoc" data-val="true" />
                        </div>
                        <div class="vm-dmt-modal-field" id="pancardPathdisplay" style="display:none;">
                            <label>Pancard Document</label>
                            <input type="file" class="form-control" id="pancarddoc" name="pancarddoc" data-val="true" />
                        </div>
                        <div class="vm-dmt-modal-field" id="Selfiedisplay" style="display:none;">
                            <label>Shop With Selfie</label>
                            <input type="file" class="form-control" id="shopwithselfiledoc" name="shopwithselfiledoc" data-val="true" />
                        </div>
                        <div class="vm-dmt-modal-field">
                            <label>State</label>
                            @Html.DropDownListFor(model => model.State1, new SelectList(ViewBag.state, "Value", "Text"), "Select State", new { @class = "form-control vm-dr-rem-select", data_search_placeholder = "Search state..." })
                            @Html.ValidationMessageFor(m => m.State1, "", new { @class = "text-danger" })
                        </div>
                        <div class="vm-dmt-modal-field">
                            <label>District</label>
                            @Html.DropDownListFor(m => m.District1, new SelectList(Enumerable.Empty<SelectListItem>(), "Dist_id", "Dist_Desc"), "Select district", new { @class = "form-control vm-dr-rem-select", data_search_placeholder = "Search district..." })
                            @Html.ValidationMessageFor(m => m.District1, "", new { @class = "text-danger" })
                        </div>
                        <div class="vm-dmt-modal-field vm-dmt-modal-field--full">
                            <label>GST Number</label>
                            @Html.TextBoxFor(m => m.Gst1, new { @class = "form-control", placeholder = "Enter GST number", maxlength = "15", @style = "text-transform:uppercase" })
                        </div>
                        <div class="vm-dmt-modal-field vm-dmt-modal-field--full">
                            <label>Address</label>
                            @Html.TextAreaFor(m => m.Address1, new { @class = "form-control", placeholder = "Enter address", required = "required", rows = 3 })
                            @Html.ValidationMessageFor(m => m.Address1, "", new { @class = "text-danger" })
                        </div>
                        <div class="vm-dmt-modal-field">
                            <label>Pin Code</label>
                            @Html.TextBoxFor(m => m.Pincode1, new { @class = "form-control", placeholder = "Enter pin code", maxlength = 6, onkeypress = "return isNumber(event)", required = "required" })
                            @Html.ValidationMessageFor(m => m.Pincode1, "", new { @class = "text-danger" })
                        </div>
                        <div class="vm-dmt-modal-field">
                            <label>Offline Margin (%) <span class="text-danger">*</span></label>
                            @Html.TextBoxFor(m => m.offmargineEditn, new { @class = "form-control", placeholder = "Set offline margin", onkeypress = "return isNumber(event)", maxlength = "6" })
                        </div>
                        <div class="vm-dmt-modal-field vm-dmt-modal-field--full" id="kycvideodisplay" style="display:none;">
                            <label>KYC Video <span class="text-muted">(Max file size 20 MB)</span></label>
                            <input type="file" accept="video/mp4,video/x-m4v,video/*" class="form-control" id="KYCVIDEOfile" name="KYCVIDEOfile" data-val="true" />
                        </div>
                    </div>
                </div>
                <div class="modal-footer saas-admin-modal-footer">
                    <button type="submit" id="btnEditrem" class="saas-admin-modal-btn saas-admin-modal-btn--primary">
                        <i class="fas fa-save" aria-hidden="true"></i> Save Changes
                    </button>
                    <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal">
                        <i class="fas fa-times" aria-hidden="true"></i> Close
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Delete OTP Modal -->
<div class="modal fade saas-admin-modal vm-dmt-modal vm-dr-rem-otp-modal" id="OTPModal" tabindex="-1" role="dialog" aria-labelledby="drRemOtpTitle" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header saas-admin-modal-header accent-amber">
                <div class="saas-admin-modal-head-main">
                    <div class="saas-admin-modal-icon"><i class="fas fa-shield-alt" aria-hidden="true"></i></div>
                    <div class="saas-admin-modal-title-wrap">
                        <h4 class="modal-title saas-admin-modal-title" id="drRemOtpTitle">User Delete (OTP)</h4>
                        <span class="saas-admin-modal-subtitle">Verify OTP sent to your registered email</span>
                    </div>
                </div>
                <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close">
