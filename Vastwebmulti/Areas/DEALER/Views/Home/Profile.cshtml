                                            <label for="txtaddress">Registered Business Address</label>
                                            @Html.TextBox("txtaddress", "", new { @class = "form-control vm-dealer-edit-input", placeholder = "Enter full address", required = "required" })
                                        </div>
                                        <div class="saas-prof-form-field vm-dealer-edit-field">
                                            <label for="txtcity">Town / City</label>
                                            @Html.TextBox("txtcity", "", new { @class = "form-control vm-dealer-edit-input", placeholder = "Enter town/city", required = "required" })
                                        </div>
