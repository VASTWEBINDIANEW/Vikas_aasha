@using Vastwebmulti.Models;
@using System.Web;
@using System.Text.RegularExpressions;
@model Vastwebmulti.Models.User
@{
    ViewBag.Title = "Profile";
    Layout = "~/Areas/DEALER/Views/Shared/_Layout.cshtml";

    var passcodeset = ViewBag.passcodesetings;
    var offpasscode = passcodeset == "OFF" ? "is-active" : "";
    var perpasscode = passcodeset == "PERDAY" ? "is-active" : "";
    var Weakpasscode = passcodeset == "WEAKS" ? "is-active" : "";
    var monthpasscode = passcodeset == "MONTHS" ? "is-active" : "";

    VastwebmultiEntities DB1 = new VastwebmultiEntities();
    var usernname = DB1.Usernicknames.Where(aa => aa.Role == "Dealer").ToList();
    if (usernname.Count() > 0 && usernname.SingleOrDefault().Role == "Dealer")
    {
        ViewBag.nickname = usernname.SingleOrDefault().NickName;
    }

    var dealer = ViewBag.MD_Details;
    var dealerId = dealer != null ? dealer.DealerId : "";
    var joinDateDisplay = dealer != null && dealer.JoinDate != null ? dealer.JoinDate.ToString() : string.Empty;
    var aadharDisplay = "Data Not Found !";
    if (dealer != null && dealer.adharcard != null && dealer.adharcard != "")
    {
        var aadharRaw = (string)dealer.adharcard;
        if (aadharRaw.Length >= 4)
        {
            aadharDisplay = new string('X', 8) + aadharRaw.Substring(aadharRaw.Length - 4, 4);
        }
    }

    Func<string, string> stripInvisible = text =>
    {
        if (string.IsNullOrEmpty(text)) return text;
        return Regex.Replace(text, @"[\u200B-\u200D\uFEFF]", string.Empty).Trim();
    };

    Func<string, bool> isGarbageText = text =>
    {
        if (string.IsNullOrWhiteSpace(text)) return true;
        var value = stripInvisible(text);
        if (string.IsNullOrWhiteSpace(value)) return true;
        if (value.IndexOf('\u20AC') >= 0) return true;
        if (value.IndexOf('\uFFFD') >= 0) return true;
        if (value.IndexOf("\u00E2\u20AC", StringComparison.Ordinal) >= 0) return true;
        if (Regex.IsMatch(value, @"[\u0080-\u009F]")) return true;
        if (Regex.IsMatch(value, @"\u00C3[\u0080-\u00BF]")) return true;
        if (value.IndexOf('\u00E2') >= 0) return true;
        if (!Regex.IsMatch(value, @"[a-zA-Z0-9]")) return true;
        return false;
    };

    Func<object, string, string> profDisplayText = (value, fallback) =>
    {
        if (value == null) return fallback;
        var text = stripInvisible(Convert.ToString(value));
        return isGarbageText(text) ? fallback : text;
    };

    Func<object, string> profDisplayTextNotFound = value => profDisplayText(value, "Data Not Found !");
    Func<object, string, string> profDisplayClass = (value, fallback) => profDisplayText(value, fallback) == fallback ? " is-empty" : string.Empty;
    Func<object, string> profDisplayClassNotFound = value => profDisplayTextNotFound(value) == "Data Not Found !" ? " is-empty" : string.Empty;

    var firmNameDisplay = profDisplayText(dealer != null ? dealer.FarmName : null, "No company name");
    var addressDisplay = profDisplayText(dealer != null ? dealer.Address : null, "Address not found");
    var cityDisplay = profDisplayText(dealer != null ? dealer.city : null, string.Empty);
    var pincodeDisplay = profDisplayText(dealer != null ? dealer.Pincode : null, string.Empty);
    var stateDisplay = profDisplayText(ViewBag.ddlstate, string.Empty);
    var districtDisplay = profDisplayText(ViewBag.district, string.Empty);
    var dealerNameDisplay = profDisplayTextNotFound(dealer != null ? dealer.DealerName : null);
    var dealerEmailDisplay = profDisplayTextNotFound(dealer != null ? dealer.Email : null);
    var dealerMobileDisplay = profDisplayTextNotFound(dealer != null ? dealer.Mobile : null);
    var dealerPancardDisplay = profDisplayTextNotFound(dealer != null && dealer.pancard != null && dealer.pancard != "" ? dealer.pancard : null);
    var dealerGstDisplay = profDisplayTextNotFound(dealer != null && dealer.gst != null && dealer.gst != "" ? dealer.gst : null);
    var dealerPositionDisplay = profDisplayTextNotFound(dealer != null && dealer.Position != null && dealer.Position != "" ? dealer.Position : null);
    var dealerBusinessDisplay = profDisplayTextNotFound(dealer != null && dealer.BusinessType != null && dealer.BusinessType != "" ? dealer.BusinessType : null);
    var dealerDobDisplay = profDisplayTextNotFound(dealer != null && dealer.DOF != null ? dealer.DOF.ToString() : null);
}

<link href="~/MainFrontDesign/css/admin-profile-modern.css?v=25" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-profile-page saas-prof-page vm-dealer-profile-page"
         data-profile-url="@Url.Action("Profile", "Home")">

    <div class="container-fluid saas-profile-container">

        <div class="saas-acc-toolbar saas-profile-toolbar">
            <ol class="saas-acc-breadcrumb">
                <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                <li>Profile</li>
            </ol>
            <div class="saas-profile-page-head">
                <h1 class="saas-profile-page-title"><i class="fas fa-user-circle" aria-hidden="true"></i> Dealer Profile</h1>
                <p class="saas-profile-page-desc">Manage company details, security, documents and passcode settings</p>
            </div>
        </div>

        <div class="row clearfix saas-prof-layout">
            <div class="col-md-4 col-sm-12 saas-prof-layout__aside">
                <article class="saas-prof-card saas-prof-card--identity">
                    @if (!string.IsNullOrWhiteSpace(ViewBag.nickname as string))
                    {
                        <div class="ribbon"><span>@ViewBag.nickname</span></div>
                    }
                    <div class="saas-prof-identity__hero">
                        <div class="saas-prof-identity__avatar-wrap">
                            @if (dealer != null && dealer.Photo != null)
                            {
                                <div class="image">
                                    <img id="Dealerimage" src="@Url.Content("~/" + dealer.Photo)" class="saas-prof-identity__avatar" alt="User" title="Click to upload profile photo" onclick="uploadimage('@dealerId')" />
                                </div>
                            }
                            else
                            {
                                <div class="image">
                                    <img id="Dealerimage" src="~/AdminDesign/images/user.png" class="saas-prof-identity__avatar" alt="User" title="Click to upload profile photo" onclick="uploadimage('@dealerId')">
                                </div>
                            }
                            <h2 class="saas-prof-identity__name">@(dealer != null ? dealer.DealerName : "")</h2>
                            <p class="saas-prof-identity__role">@(ViewBag.nickname ?? "Dealer")</p>
                        </div>
                    </div>

                    <div class="saas-prof-identity__action" id="otpnoneuploadshow">
                        <h3 class="saas-prof-identity__action-title"><i class="fas fa-shield-alt" aria-hidden="true"></i> OTP Security</h3>
                        <div class="onoffswitch">
                            @if (Model.TwoFactorEnabled)
                            {
                                using (Html.BeginForm("DisableTwoFactorAuthentication", "Manage", new { area = "" }, FormMethod.Post, new { encType = "multipart/form-data" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button id="btnon" type="submit" name="btnon" class="saas-prof-pill saas-prof-pill--success" value="On">OTP ON</button>
                                }
                            }
                            else
                            {
                                using (Html.BeginForm("EnableTwoFactorAuthentication", "Manage", new { area = "" }, FormMethod.Post, new { encType = "multipart/form-data" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <button id="btnoff" type="submit" name="btnoff" class="saas-prof-pill saas-prof-pill--danger" value="off">OTP OFF</button>
                                }
                            }
                        </div>
                    </div>

                    <div class="vm-dealer-profile-upload" id="EditProfileimageModal">
                        @using (Html.BeginForm("UploadProfileimage", "Home", FormMethod.Post, new { encType = "multipart/form-data", @class = "vm-dealer-profile-upload__form" }))
                        {
                            <input type="hidden" id="txtprofileid" name="txtprofileid" />
                            <div class="vm-dealer-profile-upload__head">
                                <strong><i class="fas fa-camera" aria-hidden="true"></i> Update Profile Photo</strong>
                                <span>Upload a clear JPG, PNG or GIF image</span>
                            </div>
                            <div class="vm-dealer-profile-upload__field">
                                <label for="profilePhotoFile">Choose Image</label>
                                <div class="vm-dealer-file-input">
                                    <input type="file" class="vm-dealer-file-input__native" id="profilePhotoFile" name="file" accept="image/*" required="required" />
                                    <span class="vm-dealer-file-input__display" aria-hidden="true">
                                        <i class="fas fa-cloud-upload-alt"></i>
                                        <span class="vm-dealer-file-input__text">Browse file</span>
                                    </span>
                                </div>
                            </div>
                            <div class="saas-prof-edit-toolbar vm-dealer-profile-upload__toolbar">
                                <button type="submit" class="saas-prof-btn saas-prof-btn--primary"><i class="fas fa-check" aria-hidden="true"></i> Save</button>
                                <button type="button" id="uploadnoneotpshow" class="saas-prof-btn saas-prof-btn--muted"><i class="fas fa-times" aria-hidden="true"></i> Close</button>
                            </div>
                        }
                    </div>
                </article>
            </div>

            <div class="col-lg-8 col-md-8 col-sm-12 col-xs-12 saas-prof-layout__main saas-prof-layout__main--overview">
