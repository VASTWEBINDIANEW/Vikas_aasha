<script>
    $('.classwhichraviknown').click(function () {
        var e = $(this).data("value");
        var currenclass = $(this);
        $.ajax({
            url: '@Url.Action("PasscodeSettingByrem", "Home")',
            type: 'POST',
            data: { passcodetype: e },
            success: function (data) {
                if (data == 1) {
                    currenclass.addClass('is-active').siblings().removeClass('is-active');
                    location.reload();
                }
            }
        });
    });
</script>

<script>
    $(document).ready(function () {
        $('.for-select2').select2();
        var msg = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Convert.ToString(ViewData["msg"])))';
        if (msg && typeof swal === 'function') {
            swal("Success", msg, "success");
        }
        var success = '@Html.Raw(HttpUtility.JavaScriptStringEncode(Convert.ToString(TempData["success"])))';
        if (success && typeof swal === 'function') {
            swal("Success", success, "success");
        }

        var url = '@Url.Action("AddressFieldcheck", "Home")';
        $.ajax({
            url: url,
            success: function (data) {
                if (data.pancardPath != null && data.PSAStatus == "Y" && data.aadharcardPath != null && data.AadhaarStatus == "Y") {
                    $('#Editaddresshide').hide();
                }
            }
        });

        $(document).on('change', '.vm-dealer-file-input__native', function () {
            var fileName = (this.files && this.files.length) ? this.files[0].name : 'Browse file';
            $(this).closest('.vm-dealer-file-input').find('.vm-dealer-file-input__text').text(fileName);
            $(this).closest('.vm-dealer-file-input').toggleClass('has-file', this.files && this.files.length > 0);
        });

        sanitizeGarbageProfileFields();
    });
</script>

<script type="text/javascript">
    function isNumber(evt) {
        var iKeyCode = (evt.which) ? evt.which : evt.keyCode;
        if (iKeyCode != 46 && iKeyCode > 31 && (iKeyCode < 48 || iKeyCode > 57))
            return false;
        return true;
    }
</script>

<script>
    function FillDistict() {
        var State_id = $('#State').val();
        $.ajax({
            url: '@Url.Action("FillDistict", "Home")',
            type: "GET",
            dataType: "JSON",
            data: { State: State_id },
            success: function (cities) {
                $("#District").html("");
                $.each(cities, function (i, District) {
                    $("#District").append($('<option></option>').val(District.Dist_id).html(District.Dist_Desc));
                });
            }
        });
    }
</script>

<script>
    function fixProfileDisplayText(value) {
        if (value === null || value === undefined) return '';
        var text = String(value).replace(/[\u200B-\u200D\uFEFF]/g, '').trim();
        if (!text) return '';
        if (/[\u0080-\u009F\u20AC\uFFFD]/.test(text)) return '';
        if (text.indexOf('\u00E2') >= 0) return '';
        if (!/[a-zA-Z0-9]/.test(text)) return '';
        return text;
    }

    function sanitizeGarbageProfileFields() {
        $('#spncity, #spnaddress, #spnstate, #spndistrict, #spnpincode').each(function () {
            var $el = $(this);
            var text = ($el.text() || '').trim();
            if (!text || text.indexOf('\u00E2') >= 0 || /[\u0080-\u009F\u20AC]/.test(text) || !/[a-zA-Z0-9]/.test(text)) {
                $el.text('').addClass('is-empty');
            }
        });
    }

    function editeaddress(dealerid) {
        var url = '@Url.Action("ShowDistributorprofile", "Home")';
        $.ajax({
            url: url,
            data: { dealerid: dealerid },
            cache: false,
            type: "POST",
            success: function (data) {
                $("#txtid1").val(data[0].DealerId);
                $("#txtfrimname").val(fixProfileDisplayText(data[0].FarmName));
                $("#txtcity").val(fixProfileDisplayText(data[0].city));
                $("#txtaddress").val(fixProfileDisplayText(data[0].Address));
                $("#txtzipcode").val(data[0].Pincode);
                $("#State").val(data[0].State).trigger('change');
                $("#District").val(data[0].District).trigger('change');
                $('#EditaddressModal').show();
                $('#saasProfCompanyView').hide();
                $('.saas-prof-overview-col--company .editprofile-second').hide();
            },
            error: function (reponse) {
                alert("error : " + reponse);
            }
        });
    }

    function editemobileandpancard(dealerid) {
        var url = '@Url.Action("Showmobileandpancardprofile", "Home")';
        $.ajax({
            url: url,
            data: { dealerid: dealerid },
            cache: false,
            type: "POST",
            success: function (data) {
                $("#txtid2").val(data[0].DealerId);
                $("#txtname").val(data[0].DealerName);
                $("#txtaadhaarcard").val(data[0].adharcard);
                $("#txtpancard").val(data[0].pancard);
                $("#txtgst").val(data[0].gst);
                $("#ddlPosition").val(data[0].Position).trigger('change');
                $("#ddlBusinessType").val(data[0].BusinessType).trigger('change');
                if (data[0].DOF && typeof moment !== 'undefined') {
                    $("#dateofbirth").val(moment(data[0].DOF).format("YYYY-MM-DD"));
                }
                if (data[0].pancardPath != null && data[0].PSAStatus == "Y") {
                    document.getElementById("txtpancard").readOnly = true;
                }
                if (data[0].aadharcardPath != null && data[0].AadhaarStatus == "Y") {
                    document.getElementById("txtaadhaarcard").readOnly = true;
                }
                if (data[0].pancardPath != null && data[0].PSAStatus == "Y" && data[0].aadharcardPath != null && data[0].AadhaarStatus == "Y") {
                    document.getElementById("txtpancard").readOnly = true;
                    document.getElementById("txtaadhaarcard").readOnly = true;
                    document.getElementById("txtname").readOnly = true;
                    document.getElementById("dateofbirth").readOnly = true;
                }
                $('#EditnameandpancardModal').show();
                $('.saas-prof-details__view').hide();
                $('.save-profile-btn').hide();
            },
            error: function (reponse) {
                alert("error : " + reponse);
            }
        });
    }
</script>

<script>
    function resetVmDealerFileInputs($scope) {
        if (!$scope || !$scope.length) return;
        $scope.find('.vm-dealer-file-input__native').each(function () {
            this.value = '';
            $(this).closest('.vm-dealer-file-input').removeClass('has-file')
                .find('.vm-dealer-file-input__text').text('Browse file');
        });
    }

    function closeDocUploadRow($row) {
        if (!$row || !$row.length) return;
        resetVmDealerFileInputs($row);
        $row.removeClass('is-upload-open');
        $row.find('.vm-dealer-doc-upload').hide();
        $row.find('.saas-prof-doc-actions').show();
    }

    function openDocUpload(panelId, dealerid, hiddenFieldId) {
        $('.saas-prof-doc-row.is-upload-open').each(function () {
            closeDocUploadRow($(this));
        });
        var $panel = $('#' + panelId);
        var $row = $panel.closest('.saas-prof-doc-row');
        $('#' + hiddenFieldId).val(dealerid);
        $panel.show();
        $row.addClass('is-upload-open');
        $row.find('.saas-prof-doc-actions').hide();
    }

    function uploadaadhaarDoc(dealerid) { openDocUpload('EditAadhaardocModal', dealerid, 'txtaadharid'); }
    function uploadpancardDoc(dealerid) { openDocUpload('EditPancarddocModal', dealerid, 'txtpancardid'); }
    function uploadRegistractionCertificateDoc(dealerid) { openDocUpload('EditRegistractiondocModal', dealerid, 'txtRegistractionid'); }
    function uploadserviceDoc(dealerid) { openDocUpload('EditServicedocModal', dealerid, 'txtserviceid'); }
    function uploadAddressProofDoc(dealerid) { openDocUpload('EditAddressProofdocModal', dealerid, 'txtAddressproofid'); }
    function uploadimage(dealerid) {
        $("#txtprofileid").val(dealerid);
        $('.saas-prof-card--identity').addClass('is-profile-upload-open');
        $('#otpnoneuploadshow').hide();
    }
</script>

<script type="text/javascript">
    function deleteDoc(SSID, docname) {
        swal({
            text: "<p style='color:#948f8b; font-size:20px;border-bottom:1px solid #dddddd;margin-top:-12px;padding-bottom:12px;'>Delete " + docname + " !</p></br><i class='fa fa-trash' style='font-size:72px;color:red;'></i></br><p>Are you sure ?</p>",
            html: true,
            title: "",
            showCancelButton: true,
            confirmButtonColor: "#f9a7a7",
            confirmButtonText: "Yes, delete it!",
            closeOnConfirm: false
        }, function () {
            $.ajax({
                type: "POST",
                url: '@Url.Action("DelereprofileDoc", "Home")',
                data: { 'SSID': SSID, 'Docname': docname },
                dataType: 'json',
                cache: false,
                success: function (result) {
                    if (result == "Success") {
                        swal("File Removed!", "Deleted Successfully.", "success");
                        window.location.href = '@Url.Action("Profile", "Home")';
                    } else {
                        swal("Failed!", "Something went wrong.", "error");
                        window.location.href = '@Url.Action("Profile", "Home")';
                    }
                }
            });
        });
    }
</script>

<script>
    $("#form-colseall").click(function () {
        saasProfCancelAddressEdit();
    });
    $("#close-pancardbutton").click(function () {
        saasProfCancelDetailsEdit();
        $('.save-profile-btn').show();
