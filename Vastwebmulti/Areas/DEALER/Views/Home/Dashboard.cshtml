@model Vastwebmulti.Areas.ADMIN.ViewModel.TargetSetviewmodel
@using Vastwebmulti.Models
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Areas/DEALER/Views/Shared/_Layout.cshtml";

    DateTime todaysDate = DateTime.Now.Date;
    var recentTransactions = Model.DashBoard_Report_top != null
        ? Model.DashBoard_Report_top.ToList()
        : new List<DashBoard_Report_top_Result>();

    var newsItems = ViewBag.newsdata as IEnumerable<Message_top> ?? Enumerable.Empty<Message_top>();
    var holidays = ViewBag.showholiday as IEnumerable<show_upcomming_holiday_Result> ?? Enumerable.Empty<show_upcomming_holiday_Result>();

    var companyName = ViewBag.companyname as string ?? "";
}

<link href="~/MainFrontDesign/css/admin-dashboard-modern.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/dealer-dashboard-modern.css?v=28" rel="stylesheet" />

<style>
    body.saas-admin-ui .saas-admin-dashboard.sevent_box,
    body.saas-admin-ui .saas-admin-dashboard .sevent_box0,
    body.saas-admin-ui .saas-admin-dashboard .sevent_box3 {
        background: #fff !important;
    }
    body.saas-admin-ui .saas-dash-modern .tab-content2 {
        background: #fff;
    }
</style>

<section class="content tmw-dashaboard fourdesign-section-admin main-laout saas-admin-dashboard saas-dash-modern">
    <div class="container-fluid">

        <div class="saas-dash-body-row">
            <div class="saas-dash-panel saas-dash-panel-menu second-design-tab sevent_box0">
                <div class="saas-dash-panel-head">
                    <span class="saas-dash-panel-title"><i class="fas fa-th-large" aria-hidden="true"></i> @companyName / Control Center</span>
                </div>

                <ul class="tabs2 width100 float-left nav-tabs" role="tablist">
                    <li class="tab-link current2" data-tab="dealer-tab-account" role="presentation">
                        <a href="#dealer-account"><i class="fas fa-user-check" aria-hidden="true"></i> Account Active</a>
                    </li>
                    <li class="tab-link" data-tab="dealer-tab-profile" role="presentation">
                        <a href="#dealer-profile"><i class="fas fa-user-circle" aria-hidden="true"></i> Manage Profile</a>
                    </li>
                </ul>

                <div id="dealer-tab-account" class="tab-content2 current2" role="tabpanel">
                    <div class="saas-dash-menu-grid">
                        <a href="@Url.Action("Index", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-users"></i></span><span>User Management</span></a>
                        <a href="@Url.Action("usedTokens", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-ticket"></i></span><span>Token's History</span></a>
                        <a href="@Url.Action("Notification", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-bell"></i></span><span>Notification</span></a>
                        <a href="@Url.Action("BlockOPT", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-ban"></i></span><span>Block Service's</span></a>
                        <a href="@Url.Action("All_Operator_Info", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-percent"></i></span><span>Commissions</span></a>
                        <a href="@Url.Action("WebLogin", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-lock"></i></span><span>Login Info</span></a>
                        <a href="@Url.Action("Help", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-circle-question"></i></span><span>Help</span></a>
                        <a href="@Url.Action("ReceiveFund_by_admin", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-cart-shopping"></i></span><span>Purchase</span></a>
                        <a href="@Url.Action("Actual_Dealer_income", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-sack-dollar"></i></span><span>My Earn</span></a>
                        <a href="@Url.Action("Dealer_Daybook_Report", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-book-open"></i></span><span>Day Book</span></a>
                        <a href="@Url.Action("Gst_Invocing_Dealer_report", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-file-invoice"></i></span><span>GST Invoice</span></a>
                        <a href="@Url.Action("TDSReport", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-file-lines"></i></span><span>TDS Report</span></a>
                        <a href="@Url.Action("Bank_Details", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-building-columns"></i></span><span>Bank Info</span></a>
                        <a href="@Url.Action("DealerLedger", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-book"></i></span><span>Ledger</span></a>
                        <a href="@Url.Action("Active_User", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-id-badge"></i></span><span>User's Book</span></a>
                        <a href="@Url.Action("bankinfodealer", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-wallet"></i></span><span>Add A/C &amp; Wallet</span></a>
                        <a href="@Url.Action("DealerSellgst", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-receipt"></i></span><span>Invoice</span></a>
                    </div>
                </div>

                <div id="dealer-tab-profile" class="tab-content2" role="tabpanel">
                    <div class="saas-dealer-profile">
                        <div class="saas-dealer-profile-card">
                            <div class="saas-dealer-profile-avatar-wrap">
                                @if (ViewBag.image != null && ViewBag.image != "")
                                {
                                    <img src="@Url.Content("~/" + ViewBag.image)" class="saas-dealer-profile-avatar" alt="User profile" />
                                }
                                else
                                {
                                    <img src="@Url.Content("~/images/Team_user.png")" class="saas-dealer-profile-avatar" alt="User profile" />
                                }
                                <span class="saas-dealer-profile-badge" aria-hidden="true"><i class="fas fa-user-check"></i></span>
                            </div>
                            <div class="saas-dealer-profile-meta">
                                <span class="saas-dealer-profile-label">Signed in as</span>
                                <p class="saas-dealer-profile-email">@ViewBag.email</p>
                            </div>
                            <div class="saas-dealer-profile-actions">
                                <a href="~/DEALER/Home/Profile" class="saas-dealer-profile-btn saas-dealer-profile-btn-primary">
                                    <span class="saas-dealer-profile-btn-icon"><i class="fas fa-user" aria-hidden="true"></i></span>
                                    <span class="saas-dealer-profile-btn-text">My Profile</span>
                                </a>
                                <a href="~/DEALER/Home/ChangePassword" class="saas-dealer-profile-btn saas-dealer-profile-btn-secondary">
                                    <span class="saas-dealer-profile-btn-icon"><i class="fas fa-key" aria-hidden="true"></i></span>
                                    <span class="saas-dealer-profile-btn-text">Manage Password</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="saas-dash-panel saas-dash-panel-txn second-design-tab-width sevent_box3">
                <div class="saas-dash-panel-head">
                    <span class="saas-dash-panel-title"><i class="fas fa-arrow-right-arrow-left" aria-hidden="true"></i> Activity Center</span>
                </div>

                <ul class="tabs3 width100 float-left saas-dash-txn-tabs" role="tablist">
                    <li class="tab-link current3" role="tab" data-tab="dealer-pane-notify" aria-selected="true">Notification</li>
                    <li class="tab-link" role="tab" data-tab="dealer-pane-offers" aria-selected="false">Offers</li>
                    <li class="tab-link" role="tab" data-tab="dealer-pane-txn" aria-selected="false">Recent Transactions</li>
                    <li class="tab-link" role="tab" data-tab="dealer-pane-gross" aria-selected="false">Gross Business</li>
                    <li class="tab-link" role="tab" data-tab="dealer-pane-holiday" aria-selected="false">Bank Holidays</li>
                </ul>

                <div id="dealer-pane-notify" class="tab-content3 current3" role="tabpanel">
                    <div id="myCarousel" class="carousel slide saas-dealer-notify-carousel" data-ride="carousel">
                        <div class="carousel-inner">
                            <div class="slider-activeclassadd"></div>
                            @if (newsItems.Any())
                            {
                                foreach (var item in newsItems)
                                {
                                    if (string.IsNullOrWhiteSpace(item.name))
                                    {
                                        continue;
                                    }

                                    var iconSrc = "~/ashok-images/email.svg";
                                    if (item.name == "Operator Up" || item.name == "Operator Down")
                                    {
                                        iconSrc = "~/ashok-images/warning.svg";
                                    }
                                    else if (item.name == "New Service")
                                    {
                                        iconSrc = "~/ashok-images/label11.svg";
                                    }

                                    <div class="item saas-dealer-notify-item">
                                        <div class="saas-dealer-notify-visual">
                                            <div class="saas-dealer-notify-icon">
                                                <img src="@Url.Content(iconSrc)" alt="@item.name" />
                                            </div>
                                            <h2>@item.Header</h2>
                                        </div>
                                        <div class="saas-dealer-notify-body">
                                            <p>@item.message</p>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="saas-dt-empty">
                                    <i class="fas fa-inbox" aria-hidden="true"></i>
                                    <p>No notifications found</p>
                                </div>
                            }
                        </div>
                        @if (newsItems.Any())
                        {
                            <a class="saas-dealer-notify-controls left carousel-control" href="#myCarousel" data-slide="prev" aria-label="Previous"><i class="fas fa-chevron-left"></i></a>
                            <a class="saas-dealer-notify-controls right carousel-control" href="#myCarousel" data-slide="next" aria-label="Next"><i class="fas fa-chevron-right"></i></a>
                        }
                    </div>
                </div>

                <div id="dealer-pane-offers" class="tab-content3" role="tabpanel" hidden>
                    <ul class="tabs3 width100 saas-dash-txn-tabs saas-dealer-month-tabs" role="tablist">
                        <li class="tab-link current3" id="CurrentMonthYYY">@todaysDate.ToString("MMMM") Offer</li>
                        <li class="tab-link" id="NextMonthYYY">@todaysDate.AddMonths(1).ToString("MMMM") Offer</li>
                    </ul>
                    @Html.Partial("_DealerTargetOffer")
                </div>

                <div id="dealer-pane-txn" class="tab-content3" role="tabpanel" hidden>
                    <div id="rch">
                        @{ ViewData["TxnTableId"] = "dealerDashTxnTable"; ViewData["TxnShowToolbar"] = true; }
                        @Html.Partial("~/Areas/ADMIN/Views/Home/_DashboardTxnTable.cshtml", recentTransactions)
                    </div>
                </div>

                <div id="dealer-pane-gross" class="tab-content3" role="tabpanel" hidden>
                    <ul class="tabs3 width100 saas-dash-txn-tabs saas-dealer-month-tabs dealer-gross-period" role="tablist">
                        <li class="tab-link current3" data-period="Today" id="Today">Today Business</li>
                        <li class="tab-link" data-period="Yesterday">Yesterday Business</li>
                    </ul>
                    <div class="saas-dash-txn-card">
                        <div class="saas-dash-table-scroll">
                            <table class="saas-dealer-gross-table">
                                <thead>
                                    <tr>
                                        <th></th>
                                        <th>Operators</th>
                                        <th>Total</th>
                                    </tr>
                                </thead>
                                <tbody id="tabletoday">
                                    <tr>
                                        <td colspan="3" class="saas-dealer-gross-loading"><i class="fas fa-spinner fa-spin"></i> Loading business summary...</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div id="donut_chart" class="graph" style="display:none;" aria-hidden="true"></div>
                </div>

                <div id="dealer-pane-holiday" class="tab-content3" role="tabpanel" hidden>
                    @if (holidays.Any())
                    {
                        <div class="saas-dealer-holiday-grid">
                            @foreach (var item in holidays)
                            {
                                <div class="saas-dealer-holiday-card">
                                    <i class="fas fa-calendar-day" aria-hidden="true"></i>
                                    <span class="saas-dealer-holiday-date"><em>@item.Day</em> @item.Month <sup>@item.Year</sup></span>
                                    <span class="saas-dealer-holiday-name">@item.HolidayName</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="saas-dt-empty">
                            <i class="fas fa-calendar-check" aria-hidden="true"></i>
                            <p>No upcoming holidays</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    var dealerGrossLoaded = false;

    function initDealerDashTxnTable($root) {
        var $tables = $root.find('table.saas-dash-txn-table');
        if (!$tables.length || !$.fn.DataTable) return;
        $tables.each(function () {
            var $t = $(this);
            if ($.fn.dataTable.isDataTable(this)) {
                $t.DataTable().destroy();
            }
            if ($t.find('tbody tr.saas-dt-empty-row').length) return;
            $t.DataTable({
                pageLength: 10,
                lengthChange: false,
                ordering: true,
                order: [[4, 'desc']],
                autoWidth: false,
                searching: true,
                info: true,
                paging: true,
                dom: '<"saas-dt-toolbar"f>rt<"saas-dt-footer"ip>',
                language: {
                    search: '',
                    searchPlaceholder: 'Search firm, type, description...',
                    emptyTable: 'No transactions found',
                    zeroRecords: 'No matching transactions',
                    info: 'Showing _START_ to _END_ of _TOTAL_',
                    paginate: { previous: 'Prev', next: 'Next' }
                },
                columnDefs: [
                    { orderable: false, targets: [0, 2] },
                    { className: 'col-desc', targets: 3 },
                    { className: 'col-amount', targets: 5 },
                    { className: 'col-balance', targets: 6 }
                ]
            });
        });
    }

    function switchDealerActivityTab(tabId) {
        var $panel = $('.sevent_box3');
        $panel.find('ul.tabs3 li[data-tab]').removeClass('current3').attr('aria-selected', 'false');
        $panel.find('.tab-content3').removeClass('current3').attr('hidden', 'hidden');

        $panel.find('ul.tabs3 li[data-tab="' + tabId + '"]').addClass('current3').attr('aria-selected', 'true');
        var $pane = $('#' + tabId);
        $pane.addClass('current3').removeAttr('hidden');

        if (tabId === 'dealer-pane-txn') {
            initDealerDashTxnTable($('#dealer-pane-txn'));
        } else if (tabId === 'dealer-pane-gross' && !dealerGrossLoaded) {
            loadDealerGrossBusiness('Today');
        }
    }

    function loadDealerGrossBusiness(period) {
        if (window.showAdminLoader) { showAdminLoader(); } else { $('#admin-global-loader').addClass('is-active').css('display', 'flex').attr('aria-hidden', 'false'); }
        $("#tabletoday").html('<tr><td colspan="3" class="saas-dealer-gross-loading"><i class="fas fa-spinner fa-spin"></i> Loading business summary...</td></tr>');
        $.ajax({
            url: '@Url.Action("Show_All_Recharge", "Home")',
            type: 'POST',
            dataType: 'html',
            data: { yesterday: period },
            success: function (data) {
                var x = JSON.parse(data);
                var newRow =
                    "<tr><td><i class='fa fa-desktop' style='color:#E91E63;font-size:20px;'></i></td><td>Recharge &amp; bill</td><td>" + x.Recharge + "</td></tr>" +
                    "<tr><td><i class='fa fa-university' style='color:#2196F3;font-size:20px;'></i></td><td>Financial Services</td><td>" + x.Moneytransfer + "</td></tr>" +
                    "<tr><td><i class='material-icons' style='color:#FF9800;'>fingerprint</i></td><td>Aeps Services</td><td>" + x.Aeps + "</td></tr>" +
                    "<tr><td><i class='fa fa-id-card' style='font-size:20px;'></i></td><td>Pancard</td><td>" + x.Pancard + "</td></tr>" +
                    "<tr><td><i class='fa fa-plane' style='color:#4CAF50;font-size:20px;'></i></td><td>Travel</td><td>0.00</td></tr>" +
                    "<tr><td><i class='fa fa-gift' style='color:#F44336;font-size:20px;'></i></td><td>Gift Cards</td><td>0.00</td></tr>" +
                    "<tr><td><i class='fa fa-cart-plus' style='color:#555;font-size:20px;'></i></td><td>E-Commerce</td><td>0.00</td></tr>";
                $('#tabletoday').html(newRow);
                dealerGrossLoaded = true;
                if (typeof Morris !== 'undefined' && document.getElementById('donut_chart')) {
                    $("#donut_chart").empty();
                    Morris.Donut({
                        element: 'donut_chart',
                        data: [
                            { label: 'Recharge & bill', value: x.Recharge },
                            { label: 'Financial', value: x.Moneytransfer },
                            { label: 'Aeps', value: x.Aeps },
                            { label: 'Pancard', value: x.Pancard }
                        ],
                        colors: ['#e91e63', '#0080ff', '#ff9800', '#000']
                    });
                }
            },
            error: function () {
                $('#tabletoday').html('<tr><td colspan="3" class="saas-dealer-gross-loading">Unable to load business summary.</td></tr>');
            }
        }).always(function () {
            if (window.hideAdminLoader) { hideAdminLoader(); } else { $('#admin-global-loader').removeClass('is-active').css('display', 'none').attr('aria-hidden', 'true'); }
        });
    }

    $(function () {
        $('.sevent_box0 > ul.tabs2 li').click(function () {
            var tabId = $(this).attr('data-tab');
            $('.sevent_box0 > ul.tabs2 li').removeClass('current2');
            $('.sevent_box0 .tab-content2').removeClass('current2');
            $(this).addClass('current2');
            $('#' + tabId).addClass('current2');
        });

        $('.sevent_box3').on('click', 'ul.tabs3 li[data-tab]', function (e) {
            e.preventDefault();
            var tabId = $(this).attr('data-tab');
            if (tabId) switchDealerActivityTab(tabId);
        });

        $('.saas-dealer-month-tabs li').click(function () {
            $(this).addClass('current3').siblings().removeClass('current3');
        });

        $('.dealer-gross-period li').click(function () {
            loadDealerGrossBusiness($(this).data('period'));
        });

        $('#NextMonthYYY').click(function () {
            $('#myCarouselslide3').show();
            $('#myCarouselslide2').hide();
        });
        $('#CurrentMonthYYY').click(function () {
            $('#myCarouselslide2').show();
            $('#myCarouselslide3').hide();
        });

        var $firstNotify = $('.saas-dealer-notify-carousel .slider-activeclassadd').next('.saas-dealer-notify-item');
        if ($firstNotify.length) {
            $firstNotify.addClass('active');
        }
    });
</script>
