            + '<div class="foot">Generated from Dealer panel - Daybook Report</div></div></body></html>';
    }

    function daybookDownloadExcel(html) {
        var blob = new Blob(['\ufeff', html], { type: 'application/vnd.ms-excel;charset=utf-8;' });
        if (window.navigator && window.navigator.msSaveOrOpenBlob) {
            window.navigator.msSaveOrOpenBlob(blob, 'Dealer_Daybook_Report.xls');
            return;
        }
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'Dealer_Daybook_Report.xls';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(function () { URL.revokeObjectURL(url); }, 800);
    }

    function daybookOpenPdf(html) {
        var w = window.open('', '_blank');
        if (!w) {
            return;
        }
        w.document.open();
        w.document.write(html);
        w.document.close();
    }

    function toggleDaybookTotals() {
        var $ = window.jQuery;
        if (!$) { return; }
        var panel = $('#daybookTotalsPanel');
        if (panel.is(':visible')) {
            hideDaybookTotals();
            return;
        }
        panel.slideDown(180).attr('aria-hidden', 'false');
        $('.vm-daybook-totals-btn').attr('aria-expanded', 'true');
    }

    function hideDaybookTotals() {
        var $ = window.jQuery;
        if (!$) { return; }
        $('#daybookTotalsPanel').slideUp(180).attr('aria-hidden', 'true');
        $('.vm-daybook-totals-btn').attr('aria-expanded', 'false');
    }

    function bootDealerDaybookPage() {
        var $ = window.jQuery;
        if (!$ || !$.fn || !$.fn.datepicker) {
            window.setTimeout(bootDealerDaybookPage, 50);
            return;
        }

        // Single-date bind (Actual_Dealer_income jaisa) — shared helper ko from+to dono chahiye.
        function bindDaybookDate($input) {
            if (!$input.length || $input.data('datepicker')) {
                return $input;
            }
            $input.prop('readonly', true);
            $input.datepicker({
                format: 'yyyy-mm-dd',
                todayHighlight: true,
                autoclose: true,
                orientation: 'bottom auto',
                forceParse: false,
                keyboardNavigation: true,
                enableOnReadonly: true,
                container: 'body'
            });
            $input.on('show shown', function () {
                $input.closest('.saas-acc-dp-field').addClass('is-active');
                pinDaybookDatepicker($input[0]);
            });
            $input.on('hide changeDate', function () {
                $input.closest('.saas-acc-dp-field').removeClass('is-active');
            });
            $input.on('click', function (e) {
                e.preventDefault();
                $input.datepicker('show');
            });
            $input.siblings('.saas-acc-dp-icon').on('click', function (e) {
                e.preventDefault();
                $input.datepicker('show');
            });
            return $input;
        }

        function pinDaybookDatepicker(el) {
            var target = el && el.target ? el.target : el;
            if (typeof window.repositionAdminDatepickerForMobile === 'function') {
                window.repositionAdminDatepickerForMobile(target);
            } else if (typeof window.repositionAdminDatepicker === 'function') {
                window.repositionAdminDatepicker(target);
            }
        }

        var $daybookDate = bindDaybookDate($('#txt_frm_date'));
        var postedDate = ($('#dealerDaybookForm').attr('data-frm-date') || '').trim();
        if (postedDate) {
            $daybookDate.datepicker('update', postedDate);
        } else if ($('#dealerDaybookForm').attr('data-date-mode') !== 'post') {
            $daybookDate.datepicker('setDate', new Date());
        }

        $(document).off('show.daybookDp shown.daybookDp').on('show.daybookDp shown.daybookDp', '#txt_frm_date', pinDaybookDatepicker);
        $(window).off('resize.daybookDp orientationchange.daybookDp').on('resize.daybookDp orientationchange.daybookDp', pinDaybookDatepicker);

        $('#btnExport').off('click.daybookEx').on('click.daybookEx', function () {
            var rows = daybookTableRows();
            if (!rows.length) {
                if (typeof swal === 'function') {
                    swal('No records to export', '', 'warning');
                } else {
                    window.alert('No records to export');
                }
                return;
            }
            daybookDownloadExcel(daybookBuildExcelHtml(rows));
        });

        $('#btnPDF').off('click.daybookPdf').on('click.daybookPdf', function () {
            var rows = daybookTableRows();
            if (!rows.length) {
                if (typeof swal === 'function') {
                    swal('No records to export', '', 'warning');
                } else {
                    window.alert('No records to export');
                }
                return;
            }
            daybookOpenPdf(daybookBuildPdfHtml(rows));
        });
    }

    if (document.readyState === 'complete') {
        bootDealerDaybookPage();
    } else {
        window.addEventListener('load', bootDealerDaybookPage);
    }
</script>

