            + '<td><div class="card card-total"><span class="card-label">Opening Bal</span><span class="card-value">' + m.open + '</span></div></td>'
            + '<td><div class="card card-ok"><span class="card-label">Closing Bal</span><span class="card-value">' + m.close + '</span></div></td>'
            + '<td><div class="card card-wait"><span class="card-label">Purchase</span><span class="card-value">' + m.purchase + '</span></div></td>'
            + '<td><div class="card card-fail"><span class="card-label">Diff</span><span class="card-value">' + m.diff + '</span></div></td>'
            + '</tr></table>'
