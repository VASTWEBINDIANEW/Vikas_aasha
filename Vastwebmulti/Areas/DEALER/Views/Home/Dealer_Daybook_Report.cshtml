@model Vastwebmulti.Areas.DEALER.Models.DayBookdealerreport
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Dealer Daybook Report";
    Layout = "~/Areas/DEALER/Views/Shared/_Layout.cshtml";

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";

    var liveRows = Model != null && Model.DayBookLive != null
        ? Model.DayBookLive.ToList()
        : new List<Vastwebmulti.Models.daybook_dealer_report_Result>();
    var oldRows = Model != null && Model.DayBook_Old != null
        ? Model.DayBook_Old.ToList()
        : new List<Vastwebmulti.Models.daybook_dealer_old_report_Result>();
    var rowCount = liveRows.Count + oldRows.Count;

    Func<decimal?, decimal> nz = v => v ?? 0m;
    var totalRch = liveRows.Sum(x => x.RCH) + oldRows.Sum(x => x.RCH);
    var totalImps = liveRows.Sum(x => x.IMPS) + oldRows.Sum(x => x.IMPS);
    var totalAeps = liveRows.Sum(x => x.AEPS) + oldRows.Sum(x => x.AEPS);
    var totalPan = liveRows.Sum(x => x.PAN) + oldRows.Sum(x => x.PAN);
    var totalPurchase = liveRows.Sum(x => x.PURCHASE) + oldRows.Sum(x => x.PURCHASE);
    var totalOpen = liveRows.Sum(x => nz(x.openbal)) + oldRows.Sum(x => nz(x.openbal));
    var totalClose = liveRows.Sum(x => nz(x.closebal)) + oldRows.Sum(x => nz(x.closebal));
    var totalRefund = liveRows.Sum(x => nz(x.OLDDAYREFUND)) + oldRows.Sum(x => nz(x.OLDDAYREFUND));
    var totalFailed = liveRows.Sum(x => nz(x.OLDDAYFAILED)) + oldRows.Sum(x => nz(x.OLDDAYFAILED));
    var totalDiff = liveRows.Sum(x => nz(x.DIFF)) + oldRows.Sum(x => nz(x.DIFF));
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=15" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/dealer-dth-booking-report-modern.css?v=24" rel="stylesheet" />
<script>document.body.classList.add('saas-sell-rch-dp-page', 'saas-dealer-daybook-page');</script>

<div id="loadermoney" class="vm-dmt-loader" style="display:none;"></div>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-dth-booking-report-page saas-dealer-daybook-page saas-ecommerce-report-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var daybookFormAttrs = new Dictionary<string, object>
            {
                { "id", "dealerDaybookForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate }
            };
        }
        @using (Html.BeginForm("Dealer_Daybook_Report", "Home", FormMethod.Post, daybookFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Account Active</li>
                        <li>Day Book</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters">

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "Select date", title = "Report date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="daybookTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Daybook totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideDaybookTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--primary">
                            <span class="vm-opr-total-card__label">Opening Bal</span>
                            <strong class="vm-opr-total-card__value">@totalOpen.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Closing Bal</span>
                            <strong class="vm-opr-total-card__value">@totalClose.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Purchase</span>
                            <strong class="vm-opr-total-card__value">@totalPurchase.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Diff</span>
                            <strong class="vm-opr-total-card__value">@totalDiff.ToString("N2")</strong>
                        </div>
                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-book-open" aria-hidden="true"></i>
                        <span>Dealer daybook report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <div class="vm-ft-search-wrap vm-daybook-table-search">
                            <input class="form-control vm-daybook-search-input" type="text" id="daybookSearchInput" placeholder="Search report..." autocomplete="off" onkeyup="daybookSearch()" />
                        </div>
                        <span class="vm-radiant-inline-total" title="Closing balance total for current filter">
                            Total: <strong>&#8377; @totalClose.ToString("N2")</strong>
                        </span>
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong id="daybookRecordCount">@rowCount</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-radiant-totals-btn vm-daybook-totals-btn" onclick="toggleDaybookTotals()" title="Show totals" aria-expanded="false" aria-controls="daybookTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="dealerDaybookTable" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Firm&nbsp;Name</th>
                                    <th>Recharge&nbsp;&amp;&nbsp;Bill</th>
                                    <th>IMPS</th>
                                    <th>AEPS</th>
                                    <th>M&nbsp;-&nbsp;POS</th>
                                    <th>Pancard</th>
                                    <th>Travel</th>
                                    <th>Purchase</th>
                                    <th>Opening&nbsp;Bal</th>
                                    <th>Closing&nbsp;Bal</th>
                                    <th>Old&nbsp;Day&nbsp;Refund</th>
                                    <th>Old&nbsp;Day&nbsp;Failed</th>
                                    <th>Diff</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (rowCount == 0)
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="13" class="vm-opr-table-empty">No records found for selected date.</td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var item in liveRows)
                                    {
                                        <tr>
                                            <td>@(string.IsNullOrWhiteSpace(item.FarmName) ? item.DealerName : item.FarmName)</td>
                                            <td>@item.RCH.ToString("N2")</td>
                                            <td>@item.IMPS.ToString("N2")</td>
                                            <td>@item.AEPS.ToString("N2")</td>
                                            <td>0.00</td>
                                            <td>@item.PAN.ToString("N2")</td>
                                            <td>0.00</td>
                                            <td>@item.PURCHASE.ToString("N2")</td>
                                            <td>@((item.openbal ?? 0m).ToString("N2"))</td>
                                            <td>@((item.closebal ?? 0m).ToString("N2"))</td>
                                            <td>@((item.OLDDAYREFUND ?? 0m).ToString("N2"))</td>
                                            <td>@((item.OLDDAYFAILED ?? 0m).ToString("N2"))</td>
                                            <td>@((item.DIFF ?? 0m).ToString("N2"))</td>
                                        </tr>
                                    }
                                    foreach (var item in oldRows)
                                    {
                                        <tr>
                                            <td>@(string.IsNullOrWhiteSpace(item.FarmName) ? item.DealerName : item.FarmName)</td>
                                            <td>@item.RCH.ToString("N2")</td>
                                            <td>@item.IMPS.ToString("N2")</td>
                                            <td>@item.AEPS.ToString("N2")</td>
                                            <td>0.00</td>
                                            <td>@item.PAN.ToString("N2")</td>
                                            <td>0.00</td>
                                            <td>@item.PURCHASE.ToString("N2")</td>
                                            <td>@((item.openbal ?? 0m).ToString("N2"))</td>
                                            <td>@((item.closebal ?? 0m).ToString("N2"))</td>
                                            <td>@((item.OLDDAYREFUND ?? 0m).ToString("N2"))</td>
                                            <td>@((item.OLDDAYFAILED ?? 0m).ToString("N2"))</td>
                                            <td>@((item.DIFF ?? 0m).ToString("N2"))</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                            @if (rowCount > 0)
                            {
                                <tfoot>
                                    <tr class="vm-daybook-table-foot">
                                        <td><strong>Total</strong></td>
                                        <td><strong>@totalRch.ToString("N2")</strong></td>
                                        <td><strong>@totalImps.ToString("N2")</strong></td>
                                        <td><strong>@totalAeps.ToString("N2")</strong></td>
                                        <td><strong>0.00</strong></td>
                                        <td><strong>@totalPan.ToString("N2")</strong></td>
                                        <td><strong>0.00</strong></td>
                                        <td><strong>@totalPurchase.ToString("N2")</strong></td>
                                        <td><strong>@totalOpen.ToString("N2")</strong></td>
                                        <td><strong>@totalClose.ToString("N2")</strong></td>
                                        <td><strong>@totalRefund.ToString("N2")</strong></td>
                                        <td><strong>@totalFailed.ToString("N2")</strong></td>
                                        <td><strong>@totalDiff.ToString("N2")</strong></td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<script src="~/MainFrontDesign/js/admin-report-datepicker.js?v=4"></script>
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    function daybookSearch() {
        var $ = window.jQuery;
        if (!$) { return; }
        var value = ($('#daybookSearchInput').val() || '').toLowerCase();
        var visible = 0;
        $('#dealerDaybookTable tbody tr').each(function () {
            var $tr = $(this);
            if ($tr.hasClass('vm-opr-table-empty-row')) {
                $tr.toggle(!value);
                return;
            }
            var show = $tr.text().toLowerCase().indexOf(value) > -1;
            $tr.toggle(show);
            if (show) { visible++; }
        });
        $('#daybookRecordCount').text(visible);
    }

    function daybookEsc(value) {
        return String(value == null ? '' : value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function daybookNum(value) {
        var n = parseFloat(String(value || '').replace(/,/g, '').replace(/[^\d.-]/g, ''));
        return isNaN(n) ? 0 : n;
    }

    function daybookTableRows() {
        var $ = window.jQuery;
        var rows = [];
        $('#dealerDaybookTable tbody tr').each(function () {
            var $tr = $(this);
            if ($tr.hasClass('vm-opr-table-empty-row') || !$tr.is(':visible')) {
                return;
            }
            var $cells = $tr.children('td');
            if ($cells.length < 13) {
                return;
            }
            rows.push({
                firm: $.trim($cells.eq(0).text()).replace(/\s+/g, ' '),
                rch: $.trim($cells.eq(1).text()).replace(/\s+/g, ' '),
                imps: $.trim($cells.eq(2).text()).replace(/\s+/g, ' '),
                aeps: $.trim($cells.eq(3).text()).replace(/\s+/g, ' '),
                mpos: $.trim($cells.eq(4).text()).replace(/\s+/g, ' '),
                pan: $.trim($cells.eq(5).text()).replace(/\s+/g, ' '),
                travel: $.trim($cells.eq(6).text()).replace(/\s+/g, ' '),
                purchase: $.trim($cells.eq(7).text()).replace(/\s+/g, ' '),
                open: $.trim($cells.eq(8).text()).replace(/\s+/g, ' '),
                close: $.trim($cells.eq(9).text()).replace(/\s+/g, ' '),
                refund: $.trim($cells.eq(10).text()).replace(/\s+/g, ' '),
                failed: $.trim($cells.eq(11).text()).replace(/\s+/g, ' '),
                diff: $.trim($cells.eq(12).text()).replace(/\s+/g, ' ')
            });
        });
        return rows;
    }

    function daybookExportMeta(rows) {
        var t = { rch: 0, imps: 0, aeps: 0, pan: 0, purchase: 0, open: 0, close: 0, refund: 0, failed: 0, diff: 0 };
        for (var i = 0; i < rows.length; i++) {
            t.rch += daybookNum(rows[i].rch);
            t.imps += daybookNum(rows[i].imps);
            t.aeps += daybookNum(rows[i].aeps);
            t.pan += daybookNum(rows[i].pan);
            t.purchase += daybookNum(rows[i].purchase);
            t.open += daybookNum(rows[i].open);
            t.close += daybookNum(rows[i].close);
            t.refund += daybookNum(rows[i].refund);
            t.failed += daybookNum(rows[i].failed);
            t.diff += daybookNum(rows[i].diff);
        }
        for (var k in t) {
            if (t.hasOwnProperty(k)) { t[k] = t[k].toFixed(2); }
        }
        t.reportDate = ($('#txt_frm_date').val() || '').trim() || '-';
        t.records = rows.length;
        return t;
    }

    function daybookHeads() {
        return ['Firm Name', 'Recharge & Bill', 'IMPS', 'AEPS', 'M-POS', 'Pancard', 'Travel', 'Purchase', 'Opening Bal', 'Closing Bal', 'Old Day Refund', 'Old Day Failed', 'Diff'];
    }

    function daybookBuildExcelHtml(rows) {
        var m = daybookExportMeta(rows);
        var colCount = 13;
        var html = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel"><head><meta charset="utf-8" /><title>Dealer Daybook Report</title></head><body>';
        html += '<table border="1" cellspacing="0" cellpadding="6" style="border-collapse:collapse;">';
        html += '<tr><td colspan="' + colCount + '" bgcolor="#2563EB" style="color:#FFFFFF;font-size:16pt;font-weight:bold;">Dealer Daybook Report</td></tr>';
        html += '<tr><td colspan="' + colCount + '" bgcolor="#1D4ED8" style="color:#DBEAFE;font-size:10pt;">Dealer reports - daybook</td></tr>';
        html += '<tr><td bgcolor="#F1F5F9" style="font-weight:bold;">Date</td><td colspan="5" style="font-weight:bold;">' + daybookEsc(m.reportDate) + '</td>';
        html += '<td bgcolor="#F1F5F9" style="font-weight:bold;">Records</td><td colspan="6" style="font-weight:bold;">' + m.records + '</td></tr>';
        html += '<tr>';
        var heads = daybookHeads();
        for (var h = 0; h < heads.length; h++) {
            html += '<th bgcolor="#334155" style="color:#FFFFFF;font-weight:bold;">' + daybookEsc(heads[h]) + '</th>';
        }
        html += '</tr>';
        if (!rows.length) {
            html += '<tr><td colspan="' + colCount + '" bgcolor="#F8FAFC" style="text-align:center;font-weight:bold;color:#64748B;height:48px;">No records found for selected date.</td></tr>';
        } else {
            for (var i = 0; i < rows.length; i++) {
                var r = rows[i];
                var rowBg = (i % 2 === 1) ? '#F8FAFC' : '#FFFFFF';
                html += '<tr>';
                html += '<td bgcolor="' + rowBg + '">' + daybookEsc(r.firm) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + daybookEsc(r.rch) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + daybookEsc(r.imps) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + daybookEsc(r.aeps) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + daybookEsc(r.mpos) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + daybookEsc(r.pan) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + daybookEsc(r.travel) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + daybookEsc(r.purchase) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + daybookEsc(r.open) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + daybookEsc(r.close) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + daybookEsc(r.refund) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + daybookEsc(r.failed) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + daybookEsc(r.diff) + '</td>';
                html += '</tr>';
            }
            html += '<tr>';
            html += '<td bgcolor="#EFF6FF" style="font-weight:bold;">Total</td>';
            html += '<td bgcolor="#EFF6FF" style="font-weight:bold;">' + m.rch + '</td>';
            html += '<td bgcolor="#EFF6FF" style="font-weight:bold;">' + m.imps + '</td>';
            html += '<td bgcolor="#EFF6FF" style="font-weight:bold;">' + m.aeps + '</td>';
            html += '<td bgcolor="#EFF6FF" style="font-weight:bold;">0.00</td>';
            html += '<td bgcolor="#EFF6FF" style="font-weight:bold;">' + m.pan + '</td>';
            html += '<td bgcolor="#EFF6FF" style="font-weight:bold;">0.00</td>';
            html += '<td bgcolor="#EFF6FF" style="font-weight:bold;">' + m.purchase + '</td>';
            html += '<td bgcolor="#EFF6FF" style="font-weight:bold;">' + m.open + '</td>';
            html += '<td bgcolor="#EFF6FF" style="font-weight:bold;">' + m.close + '</td>';
            html += '<td bgcolor="#EFF6FF" style="font-weight:bold;">' + m.refund + '</td>';
            html += '<td bgcolor="#EFF6FF" style="font-weight:bold;">' + m.failed + '</td>';
            html += '<td bgcolor="#EFF6FF" style="font-weight:bold;">' + m.diff + '</td>';
            html += '</tr>';
        }
        html += '</table></body></html>';
        return html;
    }

    function daybookBuildPdfHtml(rows) {
        var m = daybookExportMeta(rows);
        var heads = daybookHeads();
        var headHtml = '';
        for (var h = 0; h < heads.length; h++) {
            headHtml += '<th>' + daybookEsc(heads[h]) + '</th>';
        }
        var body = '';
        if (!rows.length) {
            body = '<tr><td colspan="13" class="empty">No records found for selected date.</td></tr>';
        } else {
            for (var i = 0; i < rows.length; i++) {
                var r = rows[i];
                body += '<tr>';
                body += '<td>' + daybookEsc(r.firm) + '</td>';
                body += '<td>' + daybookEsc(r.rch) + '</td>';
                body += '<td>' + daybookEsc(r.imps) + '</td>';
                body += '<td>' + daybookEsc(r.aeps) + '</td>';
                body += '<td>' + daybookEsc(r.mpos) + '</td>';
                body += '<td>' + daybookEsc(r.pan) + '</td>';
                body += '<td>' + daybookEsc(r.travel) + '</td>';
                body += '<td>' + daybookEsc(r.purchase) + '</td>';
                body += '<td>' + daybookEsc(r.open) + '</td>';
                body += '<td>' + daybookEsc(r.close) + '</td>';
                body += '<td>' + daybookEsc(r.refund) + '</td>';
                body += '<td>' + daybookEsc(r.failed) + '</td>';
                body += '<td>' + daybookEsc(r.diff) + '</td>';
                body += '</tr>';
            }
            body += '<tr class="foot-row">';
            body += '<td><strong>Total</strong></td>';
            body += '<td><strong>' + daybookEsc(m.rch) + '</strong></td>';
            body += '<td><strong>' + daybookEsc(m.imps) + '</strong></td>';
            body += '<td><strong>' + daybookEsc(m.aeps) + '</strong></td>';
            body += '<td><strong>0.00</strong></td>';
            body += '<td><strong>' + daybookEsc(m.pan) + '</strong></td>';
            body += '<td><strong>0.00</strong></td>';
            body += '<td><strong>' + daybookEsc(m.purchase) + '</strong></td>';
            body += '<td><strong>' + daybookEsc(m.open) + '</strong></td>';
            body += '<td><strong>' + daybookEsc(m.close) + '</strong></td>';
            body += '<td><strong>' + daybookEsc(m.refund) + '</strong></td>';
            body += '<td><strong>' + daybookEsc(m.failed) + '</strong></td>';
            body += '<td><strong>' + daybookEsc(m.diff) + '</strong></td>';
            body += '</tr>';
        }
        return '<!DOCTYPE html><html><head><meta charset="utf-8" /><title>Dealer Daybook Report</title><style type="text/css">'
            + '@@page { size: A4 landscape; margin: 10mm 8mm 12mm 8mm; }'
            + '* { box-sizing: border-box; } body { margin:0; padding:16px; font-family:Arial,Helvetica,sans-serif; font-size:10px; color:#0f172a; background:#fff; -webkit-print-color-adjust:exact; print-color-adjust:exact; }'
            + 'table { border-collapse:collapse; } .hero { width:100%; border:1px solid #1d4ed8; } .hero-top { padding:14px 18px; background:#2563eb; color:#fff; }'
            + '.hero-top h1 { margin:0; font-size:20px; } .hero-top p { margin:4px 0 0; font-size:11px; color:#dbeafe; }'
            + '.meta { width:100%; background:#f8fafc; } .meta td { padding:8px 12px; border-right:1px solid #e2e8f0; vertical-align:top; }'
            + '.meta-label { display:block; font-size:9px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:#64748b; margin-bottom:3px; }'
            + '.meta-value { font-size:12px; font-weight:700; } .cards { width:100%; margin:12px 0; } .cards td { width:25%; padding:0 6px 0 0; vertical-align:top; }'
            + '.card { border:1px solid #e2e8f0; padding:10px 12px; } .card-label { display:block; font-size:9px; font-weight:700; text-transform:uppercase; margin-bottom:4px; } .card-value { font-size:15px; font-weight:800; }'
            + '.card-total { background:#eef2ff; } .card-ok { background:#ecfdf5; } .card-fail { background:#fef2f2; } .card-wait { background:#fefce8; }'
            + '.grid { width:100%; border:1px solid #cbd5e1; } .grid th { padding:8px 6px; text-align:left; font-size:9px; font-weight:700; text-transform:uppercase; color:#fff; background:#334155; }'
            + '.grid td { padding:7px 6px; font-size:10px; border-top:1px solid #e2e8f0; vertical-align:top; } .grid tbody tr:nth-child(even):not(.foot-row) td { background:#f8fafc; }'
            + '.grid tbody tr.foot-row td { background:#eff6ff; border-top:2px solid #93c5fd; font-weight:700; }'
            + '.empty { padding:36px 16px; text-align:center; font-size:14px; font-weight:700; color:#64748b; background:#f8fafc; }'
            + '.foot { margin-top:10px; padding-top:8px; border-top:1px dashed #cbd5e1; font-size:10px; color:#94a3b8; text-align:center; }'
            + '</style></head><body><div class="sheet"><div class="hero"><div class="hero-top"><h1>Dealer Daybook Report</h1><p>Dealer reports - daybook</p></div>'
            + '<table class="meta" cellpadding="0" cellspacing="0"><tr>'
            + '<td style="width:40%;"><span class="meta-label">Date</span><span class="meta-value">' + daybookEsc(m.reportDate) + '</span></td>'
            + '<td style="width:40%;"><span class="meta-label">Closing Balance Total</span><span class="meta-value">' + daybookEsc(m.close) + '</span></td>'
            + '<td style="width:20%;"><span class="meta-label">Records</span><span class="meta-value">' + m.records + '</span></td>'
            + '</tr></table></div>'
