<script>
    function loadDealerFundScript(src, done) {
        if (!src) { if (done) done(); return; }
        var existing = document.querySelector('script[src="' + src + '"]');
        if (existing) { if (done) done(); return; }
        var s = document.createElement('script');
        s.src = src;
        s.onload = done;
        s.onerror = done;
        document.body.appendChild(s);
    }

    function fillDealerFundLinkedField(selectEl) {
        if (!selectEl || !selectEl.id) { return; }
        var map = {
            mdbank: 'txtmddistaccount',
            mdwallet: 'txtmddistwalletno',
            dealerbank: 'txtdealeraccountno',
            dealerwallets: 'txtdealerwalletno'
        };
        var inputId = map[selectEl.id];
        if (!inputId) { return; }
        var input = document.getElementById(inputId);
        if (!input) { return; }
        var val = (selectEl.value || '').trim();
        if (!val || val === '0' || val.toLowerCase().indexOf('select') >= 0) {
            input.value = '';
            return;
        }
        input.value = val;
        if (window.jQuery) {
            window.jQuery(input).trigger('input').trigger('change');
        }
    }

    function destroyDealerFtSelect2($el) {
        var $ = window.jQuery;
        if (!$ || !$el || !$el.length || !$.fn.select2) { return; }
        if ($el.hasClass('select2-hidden-accessible')) {
            try { $el.select2('destroy'); } catch (e) { }
        }
        $el.next('.select2-container').remove();
    }

    function getDealerFtSelect2Options($el) {
        var $ = window.jQuery;
        var placeholder = ($el.attr('data-search-placeholder') || $el.attr('data_search_placeholder') || 'Search...').trim();
        return {
            width: '100%',
            dropdownParent: $(document.body),
            allowClear: false,
            minimumResultsForSearch: 0,
            containerCssClass: 'vm-dealer-ft-s2-14 vm-dealer-ft-fs14-container',
            dropdownCssClass: 'vm-dealer-ft-s2-14 vm-dealer-ft-fs14-dropdown vm-dealer-ft-select2-dropdown vm-dealer-ft-searchable-dropdown',
            language: {
                noResults: function () { return 'No match found'; },
                searching: function () { return 'Searching...'; },
                inputTooShort: function () { return 'Type to search...'; }
            },
            _dealerFtSearchPlaceholder: placeholder
        };
    }

    function ensureDealerFtSelect2($el) {
        if (typeof window.initDealerFundTransferPageSelect2 === 'function') {
            window.initDealerFundTransferPageSelect2($el);
            return;
        }
        var $ = window.jQuery;
        if (!$ || !$.fn.select2 || !$el || !$el.length) { return; }
        $el.attr('data-live-search', 'true');
        destroyDealerFtSelect2($el);
        var opts = window.getAdminSelect2Options ? window.getAdminSelect2Options($el) : getDealerFtSelect2Options($el);
        opts.minimumResultsForSearch = 0;
        $el.select2(opts);
    }

    function collectDealerFtSelectTargets($scope) {
        var $ = window.jQuery;
        var selector = [
            '#ddlretailerID',
            '#idst',
            '#ddlsuprtransfertype',
            '#mdbank',
            '#mdwallet',
            '#SuperstokistID1',
            '#ddldealerPaymentMode',
            '#ddlAdmintransfertype',
            '#dealerbank',
            '#dealerwallets',
            'section.saas-dealer-fund-transfer-page select.for-select2'
        ].join(',');

        var $targets = ($scope && $scope.length)
            ? ($scope.is('select') ? $scope : $scope.find('select.for-select2, select.vm-opr-select'))
            : $(selector);

        var seen = {};
        return $targets.filter(function () {
            if (!this.id && !$(this).hasClass('for-select2')) { return false; }
            if (!$(this).closest('section.saas-dealer-fund-transfer-page').length && this.id !== 'SuperstokistID1') {
                return false;
            }
            var key = this.id || $(this).attr('name') || $(this).index();
            if (seen[key]) { return false; }
            seen[key] = true;
            return true;
        });
    }

    function bindDealerFtSelect2Search() {
        var $ = window.jQuery;
        if (!$) { return; }
        $(document).off('select2:open.dealerFtSearch');
