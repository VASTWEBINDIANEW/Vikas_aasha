<script>
    function switchDealerFtLeftTab($li) {
        if (!$li || !$li.length) { return; }

        var $a = $li.find('a.vm-ft-role-tab');
        var target = $a.attr('href');

        $li.closest('#tabs').find('.tab-link').removeClass('active current vm-ft-role-tab-li--active').addClass('vm-ft-role-tab-li--inactive');
        $li.addClass('active current vm-ft-role-tab-li--active').removeClass('vm-ft-role-tab-li--inactive');
        $li.closest('#tabs').find('.vm-ft-role-tab').attr('aria-selected', 'false').attr('aria-expanded', 'false');
        $a.attr('aria-selected', 'true').attr('aria-expanded', 'true');

        $('.tabcurrent-seconddesign').find('#home, #menu1').removeClass('active in');
        if (target === '#home' || target === '#menu1') {
            $(target).addClass('active in');
        }

        $.ajax({
            url: $li.attr('data-href'),
            success: function (data) {
                $('#tblshowMasterD').html(data);
            }
        });

        if ($li.hasClass('retailerrequest')) {
            $('#lblnorequest').text('Please Wait No. Of Request is Loading');
            $.ajax({
                url: $li.attr('data-request'),
                success: function (data) {
                    $('#lblnorequest').text(data);
                }
            });
        }

        window.setTimeout(function () {
            if (typeof window.refreshFundTransferSelect2 === 'function') {
                window.refreshFundTransferSelect2($('.tabcurrent-seconddesign .tab-pane.active.in'));
            }
        }, 120);
    }

    $(document).on('click', '#tabs .tabChangeType, #tabs .tabChangeType > a.vm-ft-role-tab', function (e) {
        e.preventDefault();
        switchDealerFtLeftTab($(this).closest('.tabChangeType'));
    });
</script>

