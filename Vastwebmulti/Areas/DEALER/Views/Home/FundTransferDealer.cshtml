<script>
    $(document).ready(function () {

        var dateOpts = {
            format: "yyyy-mm-dd",
            todayHighlight: true,
            autoclose: true,
            orientation: "bottom auto",
            forceParse: false,
            enableOnReadonly: true,
            container: 'body'
        };
        if ($.fn.datepicker) {
            $("#txt_frm_date, #txt_to_date").datepicker(dateOpts);
            $('.input-daterange').datepicker(dateOpts);
            $('.saas-fund-transfer-page .saas-acc-dp-icon').on('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                var $input = $(this).closest('.saas-acc-dp-field').find('.saas-acc-dp-input');
                if ($input.length && $input.data('datepicker')) {
                    $input.datepicker('show');
                }
            });
        }
        var val = '@ViewBag.chk';
        if (val != "post" && $.fn.datepicker) {
            $("#txt_frm_date").datepicker("setDate", new Date());
            $("#txt_to_date").datepicker("setDate", new Date());
        }
           var message = '@ViewData["successorder"]';
        if (message != "" && message != null) {
            swal("Good job!", message, "success");

        }
        var errormessage = '@ViewData["failedorder"]';
        if (errormessage != "" && errormessage != null) {
            swal("Oops!", errormessage, "error");

        }

    })
</script>

