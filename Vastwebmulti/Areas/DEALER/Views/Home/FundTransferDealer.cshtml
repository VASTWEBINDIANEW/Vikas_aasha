            todayHighlight: true,
            autoclose: true,
            orientation: 'bottom auto',
            forceParse: false,
            enableOnReadonly: true,
            container: 'body'
        };
        var $frm = $('#txt_frm_date');
        var $to = $('#txt_to_date');
        if (!$frm.data('datepicker')) { $frm.datepicker(dateOpts); }
