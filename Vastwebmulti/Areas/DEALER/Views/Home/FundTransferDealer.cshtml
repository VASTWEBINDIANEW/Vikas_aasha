    function chargebackotp() {

        var amnt = $('#mddistamount').val();
        if (amnt >= 500) {
            var retailermobile = $('#select2-ddlretailerID-container').text()
            retailermobile = retailermobile.split('/')[1].trim();
            $.ajax({
                type: 'Post',
                url: "@Url.Action("ChargebackSendOTP", "Home")",
                data: { retailermobile: retailermobile },
                success: function (data) {
                    if (data == 'Success') {
                        $('.fund-OTP').show();
                        $('.chargebackotpsend').hide();
                        $('.funtransferdiv').show();
                    }
                    else {
                        $('.fund-OTP').hide();
                        $('.chargebackotpsend').show();
                        $('.funtransferdiv').hide();

                    }

                }
            });

        }
        else {
            alert('Amount Minimium 500 Rs.');
        }

    }

    function chargedeposit() {

          $.ajax({
                    type: 'Post',
                url: "@Url.Action("cashdepositecharge", "Home")",
                data: { retailerid: $('#ddlretailerID').val(),paytype: $('#idst').val(),AMount: $('#mddistamount').val(),currentcr:$('#hdcurrentcr').val() },
                dataType: 'json',
                cache: false,
                async: false,
                success: function (data) {

                    $('#hdnetamount').val(data.netamount)
                    $('#hdcashdepositcharge').val(data.charge)
                    $('#hdcurrentcr').val(data.currentcr)


                }
            });






    }
</script>



