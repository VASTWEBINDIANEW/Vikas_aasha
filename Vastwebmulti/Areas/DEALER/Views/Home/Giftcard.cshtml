@model IEnumerable<Vastwebmulti.Models.Gift_card_details_report_Result>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Gift Card Report";
    Layout = "~/Areas/DEALER/Views/Shared/_Layout.cshtml";

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var selectedRetailer = (Request["allretailer"] ?? "").Trim();
    var selectedOperator = (Request["Operator"] ?? "").Trim();
    var selectedStatus = (Request["ddl_status"] ?? "").Trim();
    if (string.IsNullOrEmpty(selectedStatus)) { selectedStatus = "ALL"; }
    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
    var reports = Model ?? Enumerable.Empty<Vastwebmulti.Models.Gift_card_details_report_Result>();

    Func<Vastwebmulti.Models.Gift_card_details_report_Result, bool> isSuccess = x =>
        !string.IsNullOrEmpty(x.status) && x.status.IndexOf("SUCCESS", StringComparison.OrdinalIgnoreCase) >= 0;
    Func<Vastwebmulti.Models.Gift_card_details_report_Result, bool> isFailed = x =>
        !string.IsNullOrEmpty(x.status) && x.status.IndexOf("FAILED", StringComparison.OrdinalIgnoreCase) >= 0;
    Func<Vastwebmulti.Models.Gift_card_details_report_Result, bool> isPending = x =>
        !string.IsNullOrEmpty(x.status) && x.status.IndexOf("PENDING", StringComparison.OrdinalIgnoreCase) >= 0;

    var totalAmount = reports.Sum(x => x.amount ?? 0m);
    var totalSuccess = reports.Where(isSuccess).Sum(x => x.amount ?? 0m);
    var totalFailed = reports.Where(isFailed).Sum(x => x.amount ?? 0m);
    var totalPending = reports.Where(isPending).Sum(x => x.amount ?? 0m);
}

