                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="giftcardTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
