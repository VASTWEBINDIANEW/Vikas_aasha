<script src="~/MainFrontDesign/js/admin-report-datepicker.js?v=3"></script>
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    window.giftSelect2Url = '@Url.Content("~/MainFrontDesign/select2/dist/js/select2.full.min.js")';
    window.giftExcelUrl = '@Url.Action("Excel_Giftcard_Report", "Home")';
    window.giftPdfUrl = '@Url.Action("PDF_Giftcard_Report", "Home")';

    function giftQueryData() {
        var $ = window.jQuery;
        return {
            txt_frm_date: $('#txt_frm_date').val() || '',
            txt_to_date: $('#txt_to_date').val() || '',
            ddl_status: $('#ddl_status').val() || 'ALL',
            Operator: $('#Operator').val() || '',
            allretailer: $('#allretailer').val() || '',
            ddl_top: 'All'
        };
    }

    function giftQueryString() {
        var q = giftQueryData();
        return 'txt_frm_date=' + encodeURIComponent(q.txt_frm_date)
            + '&txt_to_date=' + encodeURIComponent(q.txt_to_date)
            + '&ddl_status=' + encodeURIComponent(q.ddl_status)
            + '&Operator=' + encodeURIComponent(q.Operator)
            + '&allretailer=' + encodeURIComponent(q.allretailer)
            + '&ddl_top=' + encodeURIComponent(q.ddl_top);
    }

    function giftEsc(value) {
        return String(value == null ? '' : value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function giftNum(value) {
        var n = parseFloat(String(value || '').replace(/,/g, '').replace(/[^\d.-]/g, ''));
        return isNaN(n) ? 0 : n;
    }

    function giftTableRows() {
        var $ = window.jQuery;
        var rows = [];
        $('#sellRechargeReport tbody tr').each(function () {
            var $tr = $(this);
            if ($tr.hasClass('vm-opr-table-empty-row')) {
                return;
            }
            var $cells = $tr.children('td');
            if ($cells.length < 15) {
                return;
            }
            var status = $.trim($cells.eq(0).find('.vm-radiant-status-text').text() || $cells.eq(0).text()).replace(/\s+/g, ' ');
            rows.push({
                status: status,
                sender: $.trim($cells.eq(1).text()).replace(/\s+/g, ' '),
                receiver: $.trim($cells.eq(2).text()).replace(/\s+/g, ' '),
                requestDate: $.trim($cells.eq(3).text()).replace(/\s+/g, ' '),
                amount: $.trim($cells.eq(4).text()).replace(/\s+/g, ' '),
                service: $.trim($cells.eq(5).text()).replace(/\s+/g, ' '),
                type: $.trim($cells.eq(6).text()).replace(/\s+/g, ' '),
                operatorId: $.trim($cells.eq(7).text()).replace(/\s+/g, ' '),
                userPre: $.trim($cells.eq(8).text()).replace(/\s+/g, ' '),
                userInc: $.trim($cells.eq(9).text()).replace(/\s+/g, ' '),
                userPost: $.trim($cells.eq(10).text()).replace(/\s+/g, ' '),
                dealerPre: $.trim($cells.eq(11).text()).replace(/\s+/g, ' '),
                dealerInc: $.trim($cells.eq(12).text()).replace(/\s+/g, ' '),
                dealerPost: $.trim($cells.eq(13).text()).replace(/\s+/g, ' '),
                responseTime: $.trim($cells.eq(14).text()).replace(/\s+/g, ' ')
            });
        });
        return rows;
    }

    function giftStatusColors(status) {
        var raw = String(status || '').toLowerCase();
        if (raw.indexOf('success') >= 0) {
            return { bg: '#ECFDF5', fg: '#047857', badge: 'badge-ok', label: 'Success' };
        }
        if (raw.indexOf('fail') >= 0) {
            return { bg: '#FEE2E2', fg: '#B91C1C', badge: 'badge-fail', label: 'Failed' };
        }
        if (raw.indexOf('refund') >= 0) {
            return { bg: '#F3E8FF', fg: '#6B21A8', badge: 'badge-wait', label: 'Refund' };
        }
        if (raw.indexOf('pending') >= 0) {
            return { bg: '#FEFCE8', fg: '#854D0E', badge: 'badge-wait', label: 'Pending' };
        }
        return { bg: '#FEFCE8', fg: '#854D0E', badge: 'badge-wait', label: status || '-' };
    }

    function giftExportMeta(rows) {
        var q = giftQueryData();
        var total = 0, success = 0, failed = 0, pending = 0;
        for (var i = 0; i < rows.length; i++) {
            var amt = giftNum(rows[i].amount);
            var raw = String(rows[i].status || '').toLowerCase();
            total += amt;
            if (raw.indexOf('success') >= 0) { success += amt; }
            else if (raw.indexOf('fail') >= 0) { failed += amt; }
            else { pending += amt; }
        }
        return {
            generatedOn: (function () {
                var d = new Date();
                var months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
                var h = d.getHours();
                var ampm = h >= 12 ? 'PM' : 'AM';
                var hr = h % 12; if (!hr) { hr = 12; }
                var min = d.getMinutes();
                return ('0' + d.getDate()).slice(-2) + ' ' + months[d.getMonth()] + ' ' + d.getFullYear() + ', ' + ('0' + hr).slice(-2) + ':' + ('0' + min).slice(-2) + ' ' + ampm;
            })(),
            frmDate: q.txt_frm_date || '-',
            toDate: q.txt_to_date || '-',
            statusFilter: q.ddl_status || 'ALL',
            records: rows.length,
            total: total.toFixed(2),
            success: success.toFixed(2),
            failed: failed.toFixed(2),
            pending: pending.toFixed(2)
        };
    }

    function giftBuildExcelHtml(rows) {
        var m = giftExportMeta(rows);
        var html = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel"><head><meta charset="utf-8" /><title>Gift Card Report</title></head><body>';
        html += '<table border="1" cellspacing="0" cellpadding="6" style="border-collapse:collapse;">';
        html += '<tr><td colspan="15" bgcolor="#2563EB" style="color:#FFFFFF;font-size:16pt;font-weight:bold;">Gift Card Report</td></tr>';
        html += '<tr><td colspan="15" bgcolor="#1D4ED8" style="color:#DBEAFE;font-size:10pt;">Dealer reports - gift card transactions</td></tr>';
        html += '<tr><td bgcolor="#F1F5F9" style="font-weight:bold;">Generated On</td><td colspan="2" style="font-weight:bold;">' + giftEsc(m.generatedOn) + '</td>';
        html += '<td bgcolor="#F1F5F9" style="font-weight:bold;">Date Range</td><td colspan="3" style="font-weight:bold;">' + giftEsc(m.frmDate) + ' to ' + giftEsc(m.toDate) + '</td>';
        html += '<td bgcolor="#F1F5F9" style="font-weight:bold;">Status</td><td style="font-weight:bold;">' + giftEsc(m.statusFilter) + '</td>';
        html += '<td bgcolor="#F1F5F9" style="font-weight:bold;">Records</td><td style="font-weight:bold;">' + m.records + '</td><td colspan="4">&nbsp;</td></tr>';
        html += '<tr><td bgcolor="#EEF2FF" style="font-weight:bold;">Total Amount</td><td bgcolor="#EEF2FF" style="font-weight:bold;">' + m.total + '</td>';
        html += '<td bgcolor="#ECFDF5" style="font-weight:bold;color:#047857;">Success</td><td bgcolor="#ECFDF5" style="font-weight:bold;color:#047857;">' + m.success + '</td>';
        html += '<td bgcolor="#FEF2F2" style="font-weight:bold;color:#B91C1C;">Failed</td><td bgcolor="#FEF2F2" style="font-weight:bold;color:#B91C1C;">' + m.failed + '</td>';
        html += '<td bgcolor="#FEFCE8" style="font-weight:bold;color:#854D0E;">Pending</td><td bgcolor="#FEFCE8" style="font-weight:bold;color:#854D0E;">' + m.pending + '</td><td colspan="7">&nbsp;</td></tr>';
        html += '<tr>';
        var heads = ['Status', 'Sender', 'Receiver', 'Request Date', 'Amount', 'Service', 'Type', 'Operator Id', 'User Pre', 'User INC', 'User Post', 'Dealer Pre', 'Dealer INC', 'Dealer Post', 'Response Time'];
        for (var h = 0; h < heads.length; h++) {
            html += '<th bgcolor="#334155" style="color:#FFFFFF;font-weight:bold;">' + heads[h] + '</th>';
        }
        html += '</tr>';
        if (!rows.length) {
            html += '<tr><td colspan="15" bgcolor="#F8FAFC" style="text-align:center;font-weight:bold;color:#64748B;height:48px;">Gift card report not found.</td></tr>';
        } else {
            for (var i = 0; i < rows.length; i++) {
                var r = rows[i];
                var c = giftStatusColors(r.status);
                var rowBg = (i % 2 === 1) ? '#F8FAFC' : '#FFFFFF';
                html += '<tr>';
                html += '<td bgcolor="' + c.bg + '" style="color:' + c.fg + ';font-weight:bold;">' + giftEsc(c.label) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + giftEsc(r.sender) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + giftEsc(r.receiver) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + giftEsc(r.requestDate) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + giftEsc(r.amount) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + giftEsc(r.service) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + giftEsc(r.type) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + giftEsc(r.operatorId) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + giftEsc(r.userPre) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + giftEsc(r.userInc) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + giftEsc(r.userPost) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + giftEsc(r.dealerPre) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + giftEsc(r.dealerInc) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + giftEsc(r.dealerPost) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + giftEsc(r.responseTime) + '</td>';
                html += '</tr>';
            }
        }
        html += '</table></body></html>';
        return html;
    }

    function giftBuildPdfHtml(rows) {
        var m = giftExportMeta(rows);
        var body = '';
        if (!rows.length) {
            body = '<tr><td colspan="15" class="empty">Gift card report not found.</td></tr>';
        } else {
            for (var i = 0; i < rows.length; i++) {
                var r = rows[i];
                var c = giftStatusColors(r.status);
                body += '<tr>';
                body += '<td><span class="badge ' + c.badge + '">' + giftEsc(c.label) + '</span></td>';
                body += '<td>' + giftEsc(r.sender) + '</td>';
                body += '<td>' + giftEsc(r.receiver) + '</td>';
                body += '<td>' + giftEsc(r.requestDate) + '</td>';
                body += '<td>' + giftEsc(r.amount) + '</td>';
                body += '<td>' + giftEsc(r.service) + '</td>';
                body += '<td>' + giftEsc(r.type) + '</td>';
                body += '<td>' + giftEsc(r.operatorId) + '</td>';
                body += '<td>' + giftEsc(r.userPre) + '</td>';
                body += '<td>' + giftEsc(r.userInc) + '</td>';
                body += '<td>' + giftEsc(r.userPost) + '</td>';
                body += '<td>' + giftEsc(r.dealerPre) + '</td>';
                body += '<td>' + giftEsc(r.dealerInc) + '</td>';
                body += '<td>' + giftEsc(r.dealerPost) + '</td>';
                body += '<td>' + giftEsc(r.responseTime) + '</td>';
                body += '</tr>';
            }
        }
        return '<!DOCTYPE html><html><head><meta charset="utf-8" /><title>Gift Card Report</title><style type="text/css">'
            + '@@page { size: A4 landscape; margin: 10mm 8mm 12mm 8mm; }'
            + '* { box-sizing: border-box; } body { margin:0; padding:16px; font-family:Arial,Helvetica,sans-serif; font-size:11px; color:#0f172a; background:#fff; -webkit-print-color-adjust:exact; print-color-adjust:exact; }'
            + 'table { border-collapse:collapse; } .hero { width:100%; border:1px solid #1d4ed8; } .hero-top { padding:14px 18px; background:#2563eb; color:#fff; }'
            + '.hero-top h1 { margin:0; font-size:20px; } .hero-top p { margin:4px 0 0; font-size:11px; color:#dbeafe; }'
            + '.meta { width:100%; background:#f8fafc; } .meta td { padding:8px 12px; border-right:1px solid #e2e8f0; }'
            + '.meta-label { display:block; font-size:9px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:#64748b; margin-bottom:3px; }'
            + '.meta-value { font-size:12px; font-weight:700; } .cards { width:100%; margin:12px 0; } .cards td { width:25%; padding:0 6px 0 0; }'
            + '.card { border:1px solid #e2e8f0; padding:10px 12px; } .card-label { display:block; font-size:9px; font-weight:700; text-transform:uppercase; margin-bottom:4px; } .card-value { font-size:16px; font-weight:800; }'
            + '.card-total { background:#eef2ff; } .card-ok { background:#ecfdf5; } .card-fail { background:#fef2f2; } .card-wait { background:#fefce8; }'
            + '.grid { width:100%; border:1px solid #cbd5e1; } .grid th { padding:9px 7px; text-align:left; font-size:10px; font-weight:700; text-transform:uppercase; color:#fff; background:#334155; }'
            + '.grid td { padding:8px 7px; font-size:11px; border-top:1px solid #e2e8f0; } .grid tbody tr:nth-child(even) td { background:#f8fafc; }'
            + '.badge { display:inline-block; min-width:58px; padding:3px 8px; font-size:10px; font-weight:700; text-align:center; }'
            + '.badge-ok { background:#ecfdf5; color:#047857; } .badge-fail { background:#fee2e2; color:#b91c1c; } .badge-wait { background:#fef9c3; color:#854d0e; }'
            + '.empty { padding:36px 16px; text-align:center; font-size:14px; font-weight:700; color:#64748b; background:#f8fafc; }'
            + '.foot { margin-top:10px; padding-top:8px; border-top:1px dashed #cbd5e1; font-size:10px; color:#94a3b8; text-align:center; }'
            + '</style></head><body><div class="sheet"><div class="hero"><div class="hero-top"><h1>Gift Card Report</h1><p>Dealer reports - gift card transactions</p></div>'
            + '<table class="meta" cellpadding="0" cellspacing="0"><tr>'
            + '<td style="width:25%;"><span class="meta-label">Generated On</span><span class="meta-value">' + giftEsc(m.generatedOn) + '</span></td>'
            + '<td style="width:30%;"><span class="meta-label">Date Range</span><span class="meta-value">' + giftEsc(m.frmDate) + ' to ' + giftEsc(m.toDate) + '</span></td>'
            + '<td style="width:20%;"><span class="meta-label">Status</span><span class="meta-value">' + giftEsc(m.statusFilter) + '</span></td>'
            + '<td style="width:25%;"><span class="meta-label">Records</span><span class="meta-value">' + m.records + '</span></td>'
            + '</tr></table></div>'
            + '<table class="cards" cellpadding="0" cellspacing="0"><tr>'
            + '<td><div class="card card-total"><span class="card-label">Total Amount</span><span class="card-value">' + m.total + '</span></div></td>'
            + '<td><div class="card card-ok"><span class="card-label">Success</span><span class="card-value">' + m.success + '</span></div></td>'
            + '<td><div class="card card-fail"><span class="card-label">Failed</span><span class="card-value">' + m.failed + '</span></div></td>'
            + '<td><div class="card card-wait"><span class="card-label">Pending</span><span class="card-value">' + m.pending + '</span></div></td>'
            + '</tr></table>'
            + '<table class="grid" cellpadding="0" cellspacing="0"><thead><tr>'
            + '<th>Status</th><th>Sender</th><th>Receiver</th><th>Request Date</th><th>Amount</th><th>Service</th><th>Type</th><th>Operator Id</th>'
            + '<th>User Pre</th><th>User INC</th><th>User Post</th><th>Dealer Pre</th><th>Dealer INC</th><th>Dealer Post</th><th>Response Time</th>'
            + '</tr></thead><tbody>' + body + '</tbody></table>'
            + '<div class="foot">Generated from Dealer panel - Gift Card Report</div></div></body></html>';
