    function giftDownloadExcel(html) {
        var blob = new Blob(['\ufeff', html], { type: 'application/vnd.ms-excel' });
        if (window.navigator && window.navigator.msSaveOrOpenBlob) {
            window.navigator.msSaveOrOpenBlob(blob, 'Giftcard_Report.xls');
            return;
        }
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'Giftcard_Report.xls';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(function () { URL.revokeObjectURL(url); }, 800);
    }

    function giftOpenPdf(html) {
        var w = window.open('', '_blank');
        if (!w) {
            return;
        }
        w.document.open();
        w.document.write(html);
        w.document.close();
    }

    function toggleGiftcardTotals() {
        var $ = window.jQuery;
        var panel = $('#giftcardTotalsPanel');
        var btn = $('.vm-gift-totals-btn');
        if (panel.is(':visible')) {
            hideGiftcardTotals();
            return;
        }
        panel.slideDown(180).attr('aria-hidden', 'false');
        btn.attr('aria-expanded', 'true');
    }

    function hideGiftcardTotals() {
        var $ = window.jQuery;
        $('#giftcardTotalsPanel').slideUp(180).attr('aria-hidden', 'true');
        $('.vm-gift-totals-btn').attr('aria-expanded', 'false');
    }

    function giftDetailText(btn, name) {
        var value = (btn && btn.getAttribute('data-' + name)) || '';
        value = String(value).replace(/\s+/g, ' ').trim();
        return value || '-';
    }

    function giftSetDetail(id, value) {
        var el = document.getElementById(id);
        if (el) {
            el.textContent = value;
        }
    }

    function giftStatusTone(status) {
        var raw = (status || '').toLowerCase();
        if (raw.indexOf('fail') >= 0) {
            return 'failed';
        }
        if (raw.indexOf('success') >= 0) {
            return 'success';
        }
        return 'pending';
    }

    function showGiftModal(selector) {
        if (typeof window.showAdminModal === 'function') {
            window.showAdminModal(selector);
            return;
        }
        var $ = window.jQuery;
        var $modal = $(selector);
        if ($modal.parent().length && !$modal.parent().is('body')) {
            $modal.appendTo(document.body);
        }
        if ($ && $.fn && $.fn.modal) {
            $modal.modal('show');
        }
    }

    function openGiftcardDetail(btn) {
        var sender = giftDetailText(btn, 'sender');
        var status = giftDetailText(btn, 'status');
        var amount = giftDetailText(btn, 'amount');
        giftSetDetail('giftDetSubtitle', sender === '-' ? 'Gift card information' : sender);
        giftSetDetail('giftDetStatus', status);
        giftSetDetail('giftDetSender', sender);
        giftSetDetail('giftDetReceiver', giftDetailText(btn, 'receiver'));
        giftSetDetail('giftDetSenderMob', giftDetailText(btn, 'sendermob'));
        giftSetDetail('giftDetReceiverMob', giftDetailText(btn, 'receivermob'));
        giftSetDetail('giftDetService', giftDetailText(btn, 'service'));
        giftSetDetail('giftDetType', giftDetailText(btn, 'type'));
        giftSetDetail('giftDetOpId', giftDetailText(btn, 'opid'));
        giftSetDetail('giftDetOrderId', giftDetailText(btn, 'orderid'));
        giftSetDetail('giftDetOrder', giftDetailText(btn, 'order'));
        giftSetDetail('giftDetResp', giftDetailText(btn, 'resp'));
        giftSetDetail('giftDetAmount', amount === '-' ? '-' : ('Rs ' + amount));
        giftSetDetail('giftDetUserPre', giftDetailText(btn, 'userpre'));
        giftSetDetail('giftDetUserInc', giftDetailText(btn, 'userinc'));
        giftSetDetail('giftDetUserPost', giftDetailText(btn, 'userpost'));
        giftSetDetail('giftDetDlmPre', giftDetailText(btn, 'dlmpre'));
        giftSetDetail('giftDetDlmInc', giftDetailText(btn, 'dlminc'));
        giftSetDetail('giftDetDlmPost', giftDetailText(btn, 'dlmpost'));
        giftSetDetail('giftDetMessage', giftDetailText(btn, 'message'));
        giftSetDetail('giftDetApiReq', giftDetailText(btn, 'apireq'));
        giftSetDetail('giftDetApiRes', giftDetailText(btn, 'apires'));
        var statusEl = document.getElementById('giftDetStatus');
        if (statusEl) {
            statusEl.className = 'vm-dmt-modal-readonly vm-dth-detail-status vm-dth-detail-status--' + giftStatusTone(status);
        }
        showGiftModal('#giftcardDetailModal');
    }

    function bindGiftcardModals() {
        var $ = window.jQuery;
        if (!$ || !$.fn || !$.fn.modal) {
            window.setTimeout(bindGiftcardModals, 40);
            return;
        }
        $(document).off('click.giftDetail', '.vm-gift-detail-btn').on('click.giftDetail', '.vm-gift-detail-btn', function (e) {
            e.preventDefault();
            e.stopPropagation();
            openGiftcardDetail(this);
        });
    }

    function giftLoadScript(src, done) {
        var s = document.createElement('script');
        s.src = src;
        s.onload = done;
        s.onerror = done;
        document.body.appendChild(s);
    }

    function bootGiftcardReport() {
        var $ = window.jQuery;
        if (!$ || !$.fn || !$.fn.datepicker) {
            window.setTimeout(bootGiftcardReport, 50);
            return;
        }

        function afterPlugins() {
            $('.saas-giftcard-report-page .for-select2').each(function () {
                var $el = $(this);
                if ($.fn.select2 && !$el.hasClass('select2-hidden-accessible')) {
                    $el.select2({
                        width: '100%',
                        dropdownParent: $('body'),
                        containerCssClass: 'vm-ecom-select2',
                        dropdownCssClass: 'vm-ecom-select2-drop',
                        minimumResultsForSearch: 0
                    });
                }
            });

            if (typeof window.initAdminReportDateForm === 'function') {
                window.initAdminReportDateForm('#dealerGiftcardReportForm');
            } else {
                $('#txt_frm_date, #txt_to_date').datepicker({
                    format: 'yyyy-mm-dd',
                    todayHighlight: true,
                    autoclose: true,
                    orientation: 'bottom auto',
                    container: 'body'
                });
                if ($('#dealerGiftcardReportForm').attr('data-date-mode') !== 'post') {
                    $('#txt_frm_date').datepicker('setDate', new Date());
                    $('#txt_to_date').datepicker('setDate', new Date());
                }
            }

            function pinGiftDatepicker(e) {
                if (typeof window.repositionAdminDatepickerForMobile === 'function') {
                    window.repositionAdminDatepickerForMobile(e && e.target ? e.target : this);
                }
            }

            $(document).off('show.giftDp shown.giftDp').on('show.giftDp shown.giftDp', '#txt_frm_date, #txt_to_date', pinGiftDatepicker);
            $(window).off('resize.giftDp orientationchange.giftDp').on('resize.giftDp orientationchange.giftDp', pinGiftDatepicker);

            $('#btnExport').off('click.giftEx').on('click.giftEx', function () {
                var rows = giftTableRows();
                if (rows.length) {
                    giftDownloadExcel(giftBuildExcelHtml(rows));
                    return;
                }
                window.location.href = window.giftExcelUrl + '?' + giftQueryString();
            });
            $('#btnPDF').off('click.giftPdf').on('click.giftPdf', function () {
                var rows = giftTableRows();
                if (rows.length) {
                    giftOpenPdf(giftBuildPdfHtml(rows));
                    return;
                }
                window.open(window.giftPdfUrl + '?' + giftQueryString(), '_blank');
            });
        }

        if ($.fn.select2) {
            afterPlugins();
            return;
        }
        giftLoadScript(window.giftSelect2Url, afterPlugins);
    }

    bindGiftcardModals();
    if (document.readyState === 'complete') {
        bootGiftcardReport();
    } else {
        window.addEventListener('load', bootGiftcardReport);
    }
</script>

