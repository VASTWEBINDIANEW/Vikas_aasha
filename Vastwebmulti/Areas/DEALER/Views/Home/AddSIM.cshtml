@model Vastwebmulti.Models.SimDetail_Info
@using System.Linq
@{
    ViewBag.Title = "Add SIM";
    Layout = "~/Areas/DEALER/Views/Shared/_Layout.cshtml";
    var rowCount = (Model?.data1 ?? Enumerable.Empty<Vastwebmulti.Models.dealer_sim_new>()).Count();
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=15" rel="stylesheet" />
<link href="~/MainFrontDesign/css/dealer-dth-booking-report-modern.css?v=22" rel="stylesheet" />
<link href="~/MainFrontDesign/css/dealer-add-sim-modern.css?v=3" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />

<div id="div_Loader" class="vm-dmt-loader" style="display:none;" aria-hidden="true"></div>

<div class="vm-sim-page-loader" id="lodersd1" style="display:none" aria-hidden="true">
    <div class="loadingio-spinner-ripple-92ar2pfqk5j">
        <div class="ldio-zdyd6mf6t5">
            <div></div><div></div>
        </div>
    </div>
</div>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-dth-booking-report-page saas-dealer-add-sim-page">

    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell vm-add-sim-toolbar">

            <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line">

                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li><a href="@Url.Action("ADDSELLINGOPT", "Home")">Seller Setting</a></li>
                    <li>SIM Card List</li>
                </ol>

                <div class="vm-add-sim-actions">

                    <div class="vm-add-sim-search-wrap">
                        <input class="vm-add-sim-search-input" type="text" id="myInput" name="myInput" placeholder="Search SIM list..." autocomplete="off" onkeyup="addSimSearch()" />
                    </div>

                    <button type="button" class="saas-acc-btn saas-acc-btn--search" data-toggle="modal" data-target="#defaultModal222" id="myBtn14" onclick="dropdownChanged()" title="Add New SIM">
                        <i class="fas fa-plus" aria-hidden="true"></i><span>Add New SIM</span>
                    </button>

                </div>

            </div>

        </div>

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-sim-card" aria-hidden="true"></i>
                        <span>Registered SIM cards</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-sim-count-badge" title="Total SIM records">
                            <i class="fas fa-list" aria-hidden="true"></i> @rowCount record@(rowCount == 1 ? "" : "s")
                        </span>
                    </div>
                </div>

                <div class="vm-opr-table-panel__body">
                    @Html.Partial("_SimINfo", Model)
                </div>
            </div>
        </div>

    </div>

    <!-- Edit SIM modal -->
    <div class="modal fade saas-admin-modal vm-dmt-modal vm-sim-modal" id="defaultModal2212" tabindex="-1" role="dialog" aria-labelledby="editSimModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
            <div class="modal-content">
                <div class="modal-header saas-admin-modal-header accent-blue">
                    <div class="saas-admin-modal-head-main">
                        <div class="saas-admin-modal-icon"><i class="fas fa-edit" aria-hidden="true"></i></div>
                        <div class="saas-admin-modal-title-wrap">
                            <h4 class="modal-title saas-admin-modal-title" id="editSimModalTitle">Edit SIM Information</h4>
                            <span class="saas-admin-modal-subtitle">Update SIM credentials and limits</span>
                        </div>
                    </div>
                    <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close">
                        <i class="fas fa-times" aria-hidden="true"></i>
                    </button>
                </div>

                @using (Ajax.BeginForm("EditSIMINFO1", "Home", new AjaxOptions { HttpMethod = "POST", OnSuccess = "OnSuccess2", OnFailure = "onfailed2", UpdateTargetId = "divEditFormComm", LoadingElementId = "div_Loader", InsertionMode = InsertionMode.Replace }))
                {
                    <div class="modal-body saas-admin-modal-body">
                        <div class="vm-dmt-modal-grid vm-dmt-modal-grid--2">
                            <div id="colw1" class="vm-sim-modal-field">
                                <label class="labledesign">Operator Name</label>
                                <input type="text" class="inputdesign" id="colwi1" name="Operator" value="" readonly />
                            </div>
                            <div id="colw2" class="vm-sim-modal-field"></div>
                            <div id="colw3" class="vm-sim-modal-field">
                                <label class="labledesign">App User ID</label>
                                <input type="text" class="inputdesign" id="colwi3" name="Simnumber" value="" readonly />
                            </div>
                            <div id="colw4" class="vm-sim-modal-field">
                                <label class="labledesign">App Password</label>
                                <input type="text" class="inputdesign" id="colwi4" name="Password" value="" />
                            </div>
                            <div id="colw5" class="vm-sim-modal-field"></div>
                            <div id="colw6" class="vm-sim-modal-field">
                                <label class="labledesign">IMEI Number</label>
                                <input type="text" class="inputdesign" id="colwi6" min="10" max="10" name="Imeino" value="" required />
                            </div>
                            <div id="colw7" class="vm-sim-modal-field">
                                <label class="labledesign">Day Max Limit</label>
                                <input type="text" class="inputdesign" id="colwi7" name="Daylimit" value="" required />
                            </div>
                            <div id="colw8" class="vm-sim-modal-field">
                                <label class="labledesign">ETOP Min Bal</label>
                                <input type="text" class="inputdesign" id="colwi8" name="minbal" value="" required />
                            </div>
                            <div id="colw9" class="vm-sim-modal-field"></div>
                            <div id="colw10" class="vm-sim-modal-field"></div>
                            <div id="colw11" class="vm-sim-modal-field vm-dmt-modal-field--full">
                                <label class="labledesign">Remark</label>
                                <input type="text" class="inputdesign" id="colwi11" name="colwi11" value="" required />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer saas-admin-modal-footer">
                        <button type="submit" class="saas-admin-modal-btn saas-admin-modal-btn--primary">Submit</button>
                        <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal">Close</button>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Add SIM modal -->
    <div class="modal fade saas-admin-modal vm-dmt-modal vm-sim-modal" id="defaultModal222" tabindex="-1" role="dialog" aria-labelledby="addSimModalTitle" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
            <div id="loadredmodel" style="display:none;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);z-index:2;" class="loadingio-spinner-ripple-92ar2pfqk5j" aria-hidden="true">
                <div class="ldio-zdyd6mf6t5"><div></div><div></div></div>
            </div>

            <div class="modal-content">
                <div class="modal-header saas-admin-modal-header accent-emerald">
                    <div class="saas-admin-modal-head-main">
                        <div class="saas-admin-modal-icon"><i class="fas fa-plus-circle" aria-hidden="true"></i></div>
                        <div class="saas-admin-modal-title-wrap">
                            <h4 class="modal-title saas-admin-modal-title" id="addSimModalTitle">Add New SIM</h4>
                            <span class="saas-admin-modal-subtitle">Register a new SIM for recharge operations</span>
                        </div>
                    </div>
                    <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close">
                        <i class="fas fa-times" aria-hidden="true"></i>
                    </button>
                </div>

                @using (Ajax.BeginForm("Add_SIM_Details", "Home", new AjaxOptions { HttpMethod = "POST", OnSuccess = "OnSuccess1", OnFailure = "onfailed", UpdateTargetId = "divEditFormComm", LoadingElementId = "div_Loader", InsertionMode = InsertionMode.Replace }))
                {
                    @Html.AntiForgeryToken()
                    <div class="modal-body saas-admin-modal-body">
                        <div class="vm-dmt-modal-grid vm-dmt-modal-grid--2">
                            <div class="vm-sim-modal-field vm-dmt-modal-field--full" id="dropsd"></div>
                            <div class="vm-sim-modal-field vm-dmt-modal-field--full" id="zone"></div>
                            <div class="vm-sim-modal-field">
                                <label class="labledesign">App User ID</label>
                                <input class="inputdesign" type="text" name="USERID" inputmode="numeric" autocomplete="off" required />
                            </div>
                            <div class="vm-sim-modal-field">
                                <label class="labledesign">App Password</label>
                                <input class="inputdesign" type="text" name="Password" autocomplete="off" required />
                            </div>
                            <div class="vm-sim-modal-field vm-dmt-modal-field--full" id="rchpin"></div>
                            <div class="vm-sim-modal-field vm-dmt-modal-field--full vm-sim-imei-row">
                                <label class="labledesign">IMEI Number</label>
                                <div class="vm-sim-imei-inline">
                                    <input class="inputdesign vm-sim-imei-input" type="text" name="Imeino" id="Imeino" inputmode="numeric" autocomplete="off" required />
                                    <button type="button" class="vm-sim-auto-imei-btn" onclick="imeigenerate()">
                                        <i class="fas fa-random" aria-hidden="true"></i> Auto IMEI
                                    </button>
                                </div>
                            </div>
                            <div class="vm-sim-modal-field">
                                <label class="labledesign">Day Max Limit</label>
                                <input class="inputdesign" type="text" name="Daylimit" inputmode="numeric" autocomplete="off" required />
                            </div>
                            <div class="vm-sim-modal-field">
                                <label class="labledesign">ETOP Min Bal</label>
                                <input class="inputdesign" type="text" name="minbal" inputmode="numeric" autocomplete="off" required />
                            </div>
                            <div class="vm-sim-modal-field vm-dmt-modal-field--full" id="posd"></div>
                            <div class="vm-sim-modal-field vm-dmt-modal-field--full" id="macad"></div>
                            <div class="vm-sim-modal-field vm-dmt-modal-field--full">
                                <label class="labledesign">Remark</label>
                                <input class="inputdesign" type="text" name="Remark" required />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer saas-admin-modal-footer">
                        <button type="submit" class="saas-admin-modal-btn saas-admin-modal-btn--primary">Save</button>
                        <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal">Close</button>
                    </div>
                }
            </div>
        </div>
    </div>

</section>

<script>
    function addSimSearch() {
        var value = ($('#myInput').val() || '').toLowerCase();
        $('#dealerSimTable tbody tr.vm-sim-row').filter(function () {
            $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
        });
    }

    function dropdownChanged() {
        var selectedValue = document.getElementById('dropsd');
        selectedValue.innerHTML = "";

        $.ajax({
            url: '@Url.Action("filteroperatorforsell1", "Home")',
            type: "POST",
            cache: false,
            success: function (data2) {
                if (!data2 || !data2.list || !data2.list.length) {
                    return;
                }

                var selects = document.createElement("select");
                var selectss15 = document.createElement("label");
                selectss15.textContent = "Operator Name";
                selectss15.setAttribute("class", "labledesign");

                var selectss21 = document.createElement("option");
                selectss21.text = "SELECT OPERATOR";
                selectss21.value = "";
                selects.appendChild(selectss21);

                for (var i = 0; i < data2.list.length; i++) {
                    var selectss = document.createElement("option");
                    selectss.text = data2.list[i].operator_1;
                    selectss.value = data2.list[i].operator_1;
                    selects.appendChild(selectss);
                }

                selects.setAttribute("name", "drop2");
                selects.setAttribute("onchange", "selectd()");
                selects.setAttribute("class", "selectdesign");
                selects.setAttribute("id", "sel");
                selectedValue.appendChild(selectss15);
                selectedValue.appendChild(selects);
            }
        });
    }

    function selectd() {
        var sel = document.getElementById('sel');
        if (!sel) { return; }
        var chk11 = sel.value;

        document.getElementById('macad').innerHTML = '';
        document.getElementById('posd').innerHTML = '';
        document.getElementById('zone').innerHTML = '';
        document.getElementById('rchpin').innerHTML = '';

        if (chk11 == 'Jio') {
            var mac = document.getElementById('macad');
            var pos = document.getElementById('posd');

            var input2 = document.createElement('input');
            input2.setAttribute('type', 'text');
            input2.setAttribute('name', 'Macaddress');
            input2.setAttribute("required", "true");
            input2.setAttribute("class", "inputdesign");

            var labelElement = document.createElement("label");
            labelElement.textContent = "Macaddress";
            labelElement.setAttribute("class", "labledesign");
            mac.appendChild(labelElement);
            mac.appendChild(input2);

            var input3 = document.createElement('input');
            input3.setAttribute('type', 'text');
            input3.setAttribute('name', 'posid');
            input3.setAttribute("required", "true");
            input3.setAttribute("class", "inputdesign");

            var labelElement1 = document.createElement("label");
            labelElement1.textContent = "pos id";
            labelElement1.setAttribute("class", "labledesign");
            pos.appendChild(labelElement1);
            pos.appendChild(input3);
        }
        else if (chk11 == 'Airtel Digital TV' || chk11 == 'Dish TV' || chk11 == 'Sun Direct' || chk11 == 'Videocon d2h') {
            return;
        }
        else if (chk11 == 'BSNL Recharge' || chk11 == 'BSNL Topup') {
            var zon = document.getElementById('zone');
            var zoninput = document.createElement("select");
            zoninput.setAttribute('name', 'Zone');
            zoninput.setAttribute('class', 'selectdesign');

            var zoninput1 = document.createElement("Label");
            zoninput1.setAttribute('class', 'labledesign');
            zoninput1.textContent = "Zone";

            ['NORTH', 'WEST', 'EAST', 'SOUTH'].forEach(function (z) {
                var opt = document.createElement('option');
                opt.text = z;
                opt.value = z;
                zoninput.appendChild(opt);
            });

            zon.appendChild(zoninput1);
            zon.appendChild(zoninput);
        }
        else {
            var rch = document.getElementById('rchpin');
            var rchinput = document.createElement('input');
            rchinput.setAttribute('type', 'text');
            rchinput.setAttribute('name', 'RechargePin');
            rchinput.setAttribute("required", "true");
            rchinput.setAttribute("class", "inputdesign");

            var labelElement3 = document.createElement("label");
            labelElement3.textContent = "Recharge Pin";
            labelElement3.setAttribute("class", "labledesign");
            rch.appendChild(labelElement3);
            rch.appendChild(rchinput);
        }
    }

    function imeigenerate() {
        document.getElementById("Imeino").value = Math.floor(Math.random() * 1000000000000000);
    }

    function ONOFFS(s, i) {
        document.getElementById('updatestatusd11').innerHTML = '<input type="hidden" name="switch1" value=\'' + s + '\'>';
        document.getElementById('updatestatusd12').innerHTML = '<input type="hidden" name="idno" value=\'' + i + '\'>';
        document.getElementById('updatestatusd').style.display = "flex";
    }

    function Editcollw(id1) {
        $.ajax({
            url: '@Url.Action("EditSIMINFO", "Home")',
            type: "POST",
            data: { idno: id1 },
            cache: false,
            success: function (data2) {
                if (!data2 || !data2.list || !data2.list.length) { return; }

                document.getElementById('colw5').innerHTML = '';
                document.getElementById('colw9').innerHTML = '';
                document.getElementById('colw10').innerHTML = '';
                document.getElementById('colw2').innerHTML = '';

                if (data2.list[0].opt_code == "BSNL Recharge" || data2.list[0].opt_code == "BSNL Topup") {
                    var zon = document.getElementById('colw2');
                    var zoninput = document.createElement("select");
                    zoninput.setAttribute('name', 'Circlecode');
                    zoninput.setAttribute('class', 'selectdesign');

                    var zoninput1 = document.createElement("Label");
                    zoninput1.setAttribute('class', 'labledesign');
                    zoninput1.textContent = "Zone";

                    var optionzon1 = document.createElement('option');
                    var optionzon2 = document.createElement('option');
                    var optionzon3 = document.createElement('option');
                    var optionzon4 = document.createElement('option');

                    if (data2.list[0].Zone == 'EAST') {
                        optionzon1.text = "EAST"; optionzon1.value = "EAST";
                        optionzon2.text = "NORTH"; optionzon2.value = "NORTH";
                        optionzon3.text = "WEST"; optionzon3.value = "WEST";
                        optionzon4.text = "SOUTH"; optionzon4.value = "SOUTH";
                    } else if (data2.list[0].Zone == 'NORTH') {
                        optionzon1.text = "NORTH"; optionzon1.value = "NORTH";
                        optionzon2.text = "EAST"; optionzon2.value = "EAST";
                        optionzon3.text = "WEST"; optionzon3.value = "WEST";
                        optionzon4.text = "SOUTH"; optionzon4.value = "SOUTH";
                    } else if (data2.list[0].Zone == 'WEST') {
                        optionzon1.text = "WEST"; optionzon1.value = "WEST";
                        optionzon2.text = "EAST"; optionzon2.value = "EAST";
                        optionzon3.text = "NORTH"; optionzon3.value = "NORTH";
                        optionzon4.text = "SOUTH"; optionzon4.value = "SOUTH";
                    } else if (data2.list[0].Zone == 'SOUTH') {
                        optionzon1.text = "SOUTH"; optionzon1.value = "SOUTH";
                        optionzon2.text = "EAST"; optionzon2.value = "EAST";
                        optionzon3.text = "WEST"; optionzon3.value = "WEST";
                        optionzon4.text = "NORTH"; optionzon4.value = "NORTH";
                    }

                    zoninput.appendChild(optionzon1);
                    zoninput.appendChild(optionzon2);
                    zoninput.appendChild(optionzon3);
                    zoninput.appendChild(optionzon4);
                    zon.appendChild(zoninput1);
                    zon.appendChild(zoninput);
                }
                else if (data2.list[0].opt_code == "Jio") {
                    var mac = document.getElementById('colw9');
                    var pos = document.getElementById('colw10');

                    var input2 = document.createElement('input');
                    input2.setAttribute('type', 'text');
                    input2.setAttribute('name', 'Macaddress');
                    input2.setAttribute('value', data2.list[0].Macaddress);
                    input2.setAttribute("required", "true");
                    input2.setAttribute("class", "inputdesign");

                    var labelElement = document.createElement("label");
                    labelElement.textContent = "Macaddress";
                    labelElement.setAttribute("class", "labledesign");
                    mac.appendChild(labelElement);
                    mac.appendChild(input2);

                    var input3 = document.createElement('input');
                    input3.setAttribute('type', 'text');
                    input3.setAttribute('name', 'posid');
                    input3.setAttribute('value', data2.list[0].posid);
                    input3.setAttribute("required", "true");
                    input3.setAttribute("class", "inputdesign");

                    var labelElement1 = document.createElement("label");
                    labelElement1.textContent = "pos id";
                    labelElement1.setAttribute("class", "labledesign");
                    pos.appendChild(labelElement1);
                    pos.appendChild(input3);
                }
                else if (data2.list[0].opt_code == 'Airtel Digital TV' || data2.list[0].opt_code == 'Dish TV' || data2.list[0].opt_code == 'Sun Direct' || data2.list[0].opt_code == 'Videocon d2h') {
                    // no extra fields
                }
                else {
                    var rch = document.getElementById('colw5');
                    var rchinput = document.createElement('input');
                    rchinput.setAttribute('type', 'text');
                    rchinput.setAttribute('name', 'RechargePin');
                    rchinput.setAttribute('value', data2.list2);
                    rchinput.setAttribute("required", "true");
                    rchinput.setAttribute("class", "inputdesign");

                    var labelElement3 = document.createElement("label");
                    labelElement3.textContent = "Recharge Pin";
                    labelElement3.setAttribute("class", "labledesign");
                    rch.appendChild(labelElement3);
                    rch.appendChild(rchinput);
                }

                document.getElementById('colwi1').value = data2.list[0].opt_code;
                document.getElementById('colwi3').value = data2.list[0].USERID;
                document.getElementById('colwi4').value = data2.lst1;
                document.getElementById('colwi6').value = data2.list[0].Imeino;
                document.getElementById('colwi7').value = data2.list[0].DaylimitMax;
                document.getElementById('colwi8').value = data2.list[0].Etopminbal;
                document.getElementById('colwi11').value = data2.list[0].Remark;
            }
        });
    }

    function LoginbbySim(s) {
        document.getElementById('lodersd1').style.display = 'flex';
        $.ajax({
            url: '@Url.Action("Loginbysiminfo", "Home")',
            type: "POST",
            data: { idno: s },
            cache: false,
            success: function (data2) {
                document.getElementById('lodersd1').style.display = 'none';
                document.getElementById('updatestatusd23').style.display = 'flex';
                if (data2.list == "OTP") {
                    document.getElementById('updatestatusd342').style.display = 'flex';
                } else {
                    document.getElementById('LOGINMESSAGE12').innerHTML = data2.list;
                }
            },
            error: function () {
                document.getElementById('lodersd1').style.display = 'none';
            }
        });
    }

    function Checkbal(s) {
        document.getElementById('lodersd1').style.display = 'flex';
        $.ajax({
            url: '@Url.Action("CheckbalSiminfo", "Home")',
            type: "POST",
            data: { idno: s },
            cache: false,
            success: function (data2) {
                document.getElementById('lodersd1').style.display = 'none';
                document.getElementById('updatestatusd23').style.display = 'flex';
                document.getElementById('LOGINMESSAGE12').innerHTML = data2.list;
            },
            error: function () {
                document.getElementById('lodersd1').style.display = 'none';
            }
        });
    }

    function OnSuccess1() {
        $("#defaultModal222").modal("hide");
        editpop();
    }

    function onfailed() { }

    function OnSuccess2() {
        $("#defaultModal2212").modal("hide");
        editpop();
    }

    function onfailed2() { }

    function OnSuccess3() {
        editpop();
    }

    function onfailed3() { }

    function editpop() {
        var banner = document.querySelector('#divEditFormComm .vm-sim-msg-banner');
        if (banner && banner.textContent && typeof swal === 'function') {
            var isError = banner.classList.contains('vm-sim-msg-banner--error');
            swal(banner.textContent.trim(), '', isError ? 'error' : 'success');
        }
        addSimSearch();
    }
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-ajax-unobtrusive/3.2.6/jquery.unobtrusive-ajax.min.js"></script>
