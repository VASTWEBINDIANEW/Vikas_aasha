@model Vastwebmulti.Areas.ADMIN.Models.Operater_Commission
@using System.Linq
@{
    ViewBag.Title = "All_Operator_Info";
    Layout = "~/Areas/DEALER/Views/Shared/_Layout.cshtml";

    var prepaidCount = Model.Prepaid != null ? Model.Prepaid.Count() : 0;
    var utilityCount = Model.Electricity_comm != null ? Model.Electricity_comm.Count() : 0;
    var giftCount = Model.Giftcard != null ? Model.Giftcard.Count() : 0;
    var initialTab = (ViewData["type"] ?? "Prepaid").ToString();
    if (string.Equals(initialTab, "insuranceoperator", StringComparison.OrdinalIgnoreCase))
    {
        initialTab = "Insurance";
    }
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=15" rel="stylesheet" />
<link href="~/MainFrontDesign/css/dealer-dth-booking-report-modern.css?v=22" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-gst-report-modern.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/dealer-block-opt-modern.css?v=6" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-dth-booking-report-page saas-sell-recharge-report-page saas-ecommerce-report-page saas-dealer-block-opt-page saas-dealer-all-operator-info-page">

    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell vm-dealer-opinfo-toolbar">
            <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-dealer-opinfo-toolbar-row">
                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb vm-dealer-opinfo-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>Account Active</li>
                    <li>Commissions</li>
                </ol>
                <div class="vm-dealer-opinfo-tabs-wrap">
                <ul class="nav nav-tabs vm-dealer-opinfo-tabs" role="tablist">
                    <li role="presentation" class="@(initialTab == "Prepaid" ? "active" : "")">
                        <a href="#Prepaid" data-toggle="tab" aria-expanded="@(initialTab == "Prepaid" ? "true" : "false")"><i class="fas fa-mobile-alt" aria-hidden="true"></i><span>Prepaid &amp; Dth</span></a>
                    </li>
                    <li role="presentation" class="@(initialTab == "Utility" ? "active" : "")">
                        <a href="#Utility" data-toggle="tab"><i class="fas fa-bolt" aria-hidden="true"></i><span>Utilities</span></a>
                    </li>
                    <li role="presentation" class="@(initialTab == "Money" ? "active" : "")">
                        <a href="#Money" data-toggle="tab"><i class="fas fa-exchange-alt" aria-hidden="true"></i><span>Money Transfer</span></a>
                    </li>
                    <li role="presentation" class="@(initialTab == "Pancard" ? "active" : "")">
                        <a href="#Pancard" data-toggle="tab"><i class="fas fa-id-card" aria-hidden="true"></i><span>Pancard</span></a>
                    </li>
                    <li role="presentation" class="@(initialTab == "AEPS" ? "active" : "")">
                        <a href="#AEPS" data-toggle="tab"><i class="fas fa-fingerprint" aria-hidden="true"></i><span>AEPS</span></a>
                    </li>
                    <li role="presentation" class="@(initialTab == "MPOS" ? "active" : "")">
                        <a href="#MPOS" data-toggle="tab"><i class="fas fa-credit-card" aria-hidden="true"></i><span>M-POS</span></a>
                    </li>
                    <li role="presentation" class="@(initialTab == "FLIGHT" ? "active" : "")">
                        <a href="#FLIGHT" data-toggle="tab"><i class="fas fa-plane" aria-hidden="true"></i><span>Flight</span></a>
                    </li>
                    <li role="presentation" class="@(initialTab == "BUS" ? "active" : "")">
                        <a href="#BUS" data-toggle="tab"><i class="fas fa-bus" aria-hidden="true"></i><span>Bus</span></a>
                    </li>
                    <li role="presentation" class="@(initialTab == "HOTEL" ? "active" : "")">
                        <a href="#HOTEL" data-toggle="tab"><i class="fas fa-hotel" aria-hidden="true"></i><span>Hotel</span></a>
                    </li>
                    <li role="presentation" class="@(initialTab == "GIFT" ? "active" : "")">
                        <a href="#GIFT" data-toggle="tab"><i class="fas fa-gift" aria-hidden="true"></i><span>Giftcard</span></a>
                    </li>
                    <li role="presentation" class="@(initialTab == "Insurance" ? "active" : "")">
                        <a href="#Insurance" data-toggle="tab"><i class="fas fa-shield-alt" aria-hidden="true"></i><span>Security</span></a>
                    </li>
                </ul>
                </div>
            </div>
        </div>

        <div class="vm-opr-main-card vm-dealer-opinfo-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-percent" aria-hidden="true"></i>
                        <span id="dealerOpInfoPanelTitle">Operator wise commission details</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <div class="vm-ft-search-wrap vm-dealer-opinfo-table-search">
                            <input class="form-control vm-dealer-opinfo-search-input" type="text" id="dealerOpInfoSearch" placeholder="Search current tab..." autocomplete="off" />
                        </div>
                        <span class="vm-dealer-opinfo-record-badge" title="Records in current tab">
                            Records: <strong id="dealerOpInfoRecordCount">@prepaidCount</strong>
                        </span>
                    </div>
                </div>

                <div class="tab-content vm-dealer-opinfo-tab-body" id="dealerOpInfoTabBody">
                        <div id="Prepaid" class="tab-pane vm-dealer-opinfo-pane @(initialTab == "Prepaid" ? "active" : "")" data-opinfo-title="Prepaid &amp; Dth commission">
                            @if (ViewBag.allow == true)
                            {
                                <div class="vm-dealer-opinfo-slab-link">
                                    <a href="@Url.Action("Prepaid_Slab_setting", "Home")" class="btn btn-default"><i class="fas fa-sliders-h" aria-hidden="true"></i> Prepaid Slab Setting</a>
                                </div>
                            }
                            <div class="vm-dealer-opinfo-table-wrap table-responsive">
                            <table class="table table-bordered table-striped table-hover vm-opr-data-table">
                                <thead style="background-color:whitesmoke;">
                                    <tr>
                                        @{
                                            var range1 = Convert.ToInt32(@Model.AmountRange[0].maximum1);
                                            var range2 = Convert.ToInt32(@Model.AmountRange[0].maximum2);
                                            var rangee1 = range1 + 1;
                                            var rangee = range2 + 1;
                                        }
                                        <th style="padding-left:0px; text-align:center">Operator&nbsp;Current&nbsp;Status</th>
                                        <th style="padding-left:0px; text-align:center">Operator&nbsp;Type</th>
                                        <th style="padding-left:0px; text-align:center">Code</th>
                                        
                                        <th style="text-align:center;"><span class="rangeone_123">Range One</span><p>1 To @range1</p></th>
                                        <th style="text-align:center;"><span class="rangeone_123">Range Two</span><p>@rangee1 To @range2</p></th>
                                        <th style="text-align:center;"><span class="rangeone_123">Range Three</span><p>@rangee and Above</p></th>
                                        <th style="padding-left:0px; text-align:center">Blocked&nbsp;Time</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Prepaid)
                                    {

                                        <tr>
                                            <td>
                                                <p class="activeinactive-dealer" style="margin:0;">
                                                    @if (item.Status == "Y")
                                                    {
                                                        <span class="activebuttontable" style="color:#fff;font-size:15px;background:green;">Active</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="inactivebuttontable" style="color:#fff;font-size:15px;background:red;">InActive</span>
                                                    }
                                                    @Html.DisplayFor(modelItem => item.OperatorName)
                                                </p>
                                            </td>
                                            <td>@Html.DisplayFor(modelItem => item.OperatorType)</td>
                                            <td>@Html.DisplayFor(modelItem => item.OperatorCode)</td>


                                            <td>@Html.DisplayFor(modelItem => item.Commission)</td>
                                            <td>@Html.DisplayFor(modelItem => item.Commission1)</td>
                                            <td>@Html.DisplayFor(modelItem => item.Commission2)</td>
                                            <td>@Html.DisplayFor(modelItem => item.BlockTime)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                            </div>
                        </div>

                        <div id="Utility" class="tab-pane vm-dealer-opinfo-pane @(initialTab == "Utility" ? "active" : "")" data-opinfo-title="Utilities commission">
