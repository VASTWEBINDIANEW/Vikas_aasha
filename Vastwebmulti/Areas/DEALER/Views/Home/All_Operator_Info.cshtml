<script>
    (function ($) {
        function dealerOpInfoCountRows($pane) {
            if (!$pane || !$pane.length) {
                return 0;
            }
            return $pane.find('table tbody tr').filter(function () {
                return $.trim($(this).text()).length > 0;
            }).length;
        }

        function dealerOpInfoApplySearch() {
            var query = ($('#dealerOpInfoSearch').val() || '').toLowerCase();
            var $pane = $('#dealerOpInfoTabBody .tab-pane.active');
            $pane.find('table tbody tr').each(function () {
                var text = $(this).text().toLowerCase();
                $(this).toggle(text.indexOf(query) > -1);
            });
            $('#dealerOpInfoRecordCount').text($pane.find('table tbody tr:visible').length);
        }

        function dealerOpInfoOnTabShown($tab) {
            var title = $tab.attr('data-opinfo-title') || 'Operator wise commission details';
            $('#dealerOpInfoPanelTitle').text(title);
            $('#dealerOpInfoSearch').val('');
            $('#dealerOpInfoRecordCount').text(dealerOpInfoCountRows($tab));
            dealerOpInfoApplySearch();
        }

        $(function () {
            var initialTab = '@initialTab';
            if (initialTab) {
                $('.vm-dealer-opinfo-tabs a[href="#' + initialTab + '"]').tab('show');
            }

            dealerOpInfoOnTabShown($('#dealerOpInfoTabBody .tab-pane.active').first());

            $('a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
                var target = $(e.target).attr('href');
                dealerOpInfoOnTabShown($(target));
            });

            $('#dealerOpInfoSearch').on('keyup input', dealerOpInfoApplySearch);
        });
    })(jQuery);
</script>

