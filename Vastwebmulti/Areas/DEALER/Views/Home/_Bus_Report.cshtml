@model List<Vastwebmulti.Models.proc_BusReport_Result>
@using System.Linq
@{
    Layout = null;
    var items = Model ?? Enumerable.Empty<Vastwebmulti.Models.proc_BusReport_Result>();
}
@if (items.Any())
{
    foreach (var item in items)
    {
        var statusRaw = item.Status ?? item.TicketStatus ?? "";
        var ticketRaw = item.TicketStatus ?? statusRaw;
        var statusTone = "pending";
        var statusLabel = ticketRaw;
        var statusFa = "fa-clock-o";
        if (statusRaw.IndexOf("Refund", StringComparison.OrdinalIgnoreCase) >= 0 || ticketRaw.IndexOf("Refund", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "failed";
            statusLabel = "Refund";
            statusFa = "fa-undo";
        }
        else if (statusRaw.IndexOf("Failed", StringComparison.OrdinalIgnoreCase) >= 0 || ticketRaw.IndexOf("FAILED", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "failed";
            statusLabel = "Failed";
            statusFa = "fa-times";
        }
        else if (statusRaw.IndexOf("Success", StringComparison.OrdinalIgnoreCase) >= 0 || ticketRaw.IndexOf("Success", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "success";
            statusLabel = "Success";
            statusFa = "fa-check";
        }
        else if (statusRaw.IndexOf("Pending", StringComparison.OrdinalIgnoreCase) >= 0 || ticketRaw.IndexOf("Pending", StringComparison.OrdinalIgnoreCase) >= 0 || ticketRaw.IndexOf("Proccessed", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "pending";
            statusLabel = "Pending";
            statusFa = "fa-clock-o";
        }

        var firm = !string.IsNullOrWhiteSpace(item.Frm_Name) ? item.Frm_Name : (item.RetailerName ?? "—");
        var pax = ((item.LeadPaxFirstName ?? "") + " " + (item.LeadPaxLastName ?? "")).Trim();
        if (string.IsNullOrEmpty(pax)) { pax = item.PassengerName ?? "—"; }
        <tr class="vm-dmt-row vm-dmt-row--@statusTone" data-status="@statusRaw">
            <td class="vm-radiant-status-cell vm-ticket-status-cell">
                <span class="vm-dmt-status vm-dmt-status--@statusTone" title="@statusLabel">
                    <i class="fa @statusFa" aria-hidden="true"></i>
                </span>
                <span class="vm-radiant-status-text">@firm</span>
            </td>
            <td>
                <span class="vm-dmt-status vm-dmt-status--@statusTone" title="@statusLabel">@statusLabel</span>
            </td>
            <td>@pax</td>
            <td>@(item.TicketNo ?? "—")</td>
            <td>@(item.PNR ?? "—")</td>
            <td>@(item.totalseat.HasValue ? item.totalseat.Value.ToString() : "—")</td>
            <td class="vm-dmt-amt-cell">@item.FareAmount.ToString("N2")</td>
            <td class="vm-dmt-amt-cell">@item.RemInc.ToString("N2")</td>
            <td class="vm-dmt-amt-cell">@item.DlmInc.ToString("N2")</td>
            <td>@item.dateOfJourney.ToString("dddd, dd MMMM yyyy")</td>
            <td>@item.TicketDate.ToString("dd-MMM HH:mm:ss")</td>
        </tr>
    }
}
else
{
    <tr class="vm-opr-table-empty-row">
        <td colspan="11" class="vm-opr-table-empty">
            <i class="fas fa-bus" aria-hidden="true"></i>
            <span>Bus report not found.</span>
        </td>
    </tr>
}
