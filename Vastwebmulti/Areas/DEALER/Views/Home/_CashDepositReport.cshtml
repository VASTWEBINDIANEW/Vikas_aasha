@model IEnumerable<Vastwebmulti.Models.report_cash_deposit_Result>
@using System.Linq
@{
    Layout = null;
    var items = Model ?? Enumerable.Empty<Vastwebmulti.Models.report_cash_deposit_Result>();
}
@if (items.Any())
{
    foreach (var item in items)
    {
        var statusRaw = item.status ?? "";
        var statusTone = "pending";
        var statusLabel = statusRaw;
        var statusFa = "fa-clock-o";
        if (statusRaw.IndexOf("FAILED", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "failed";
            statusLabel = "Failed";
            statusFa = "fa-times";
        }
        else if (statusRaw.IndexOf("SUCCESS", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "success";
            statusLabel = "Success";
            statusFa = "fa-check";
        }
        else if (statusRaw.IndexOf("REFUND", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "pending";
            statusLabel = "Refund";
            statusFa = "fa-undo";
        }
        else if (statusRaw.IndexOf("PENDING", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "pending";
            statusLabel = "Pending";
            statusFa = "fa-clock-o";
        }

        var txnDate = item.req_date.HasValue ? item.req_date.Value.ToString("dd-MMM HH:mm:ss") : "—";
        var amt = item.amount ?? 0;
        <tr class="vm-dmt-row vm-dmt-row--@statusTone" data-status="@statusRaw" data-amount="@amt.ToString(System.Globalization.CultureInfo.InvariantCulture)">
            <td class="vm-radiant-status-cell vm-ticket-status-cell">
                <span class="vm-dmt-status vm-dmt-status--@statusTone" title="@statusLabel">
                    <i class="fa @statusFa" aria-hidden="true"></i>
                </span>
                <span class="vm-radiant-status-text">@statusLabel</span>
            </td>
            <td>@(item.Frm_Name ?? "—")</td>
            <td class="vm-dmt-amt-cell">@(item.amount.HasValue ? item.amount.Value.ToString("N2") : "—")</td>
            <td>@txnDate</td>
            <td>@(item.bankrrn ?? "—")</td>
            <td>@(item.benname ?? "—")</td>
            <td>@(item.bankname ?? "—")</td>
            <td class="vm-dmt-amt-cell">@(item.Rem_pre.HasValue ? item.Rem_pre.Value.ToString("N2") : "—")</td>
            <td class="vm-dmt-amt-cell">@(item.rem_comm.HasValue ? item.rem_comm.Value.ToString("N2") : "—")</td>
            <td class="vm-dmt-amt-cell">@(item.rem_gst.HasValue ? item.rem_gst.Value.ToString("N2") : "—")</td>
            <td class="vm-dmt-amt-cell">@(item.rem_tds.HasValue ? item.rem_tds.Value.ToString("N2") : "—")</td>
            <td class="vm-dmt-amt-cell">@(item.rem_post.HasValue ? item.rem_post.Value.ToString("N2") : "—")</td>
        </tr>
    }
}
else
{
    <tr class="vm-opr-table-empty-row">
        <td colspan="12" class="vm-opr-table-empty">
            <i class="fas fa-university" aria-hidden="true"></i>
            <span>Cash Deposit report not found.</span>
        </td>
    </tr>
}
