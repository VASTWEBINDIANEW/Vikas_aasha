@model Vastwebmulti.Areas.ADMIN.ViewModel.TargetSetviewmodel
@using Vastwebmulti.Models
@{
    DateTime todaysDate = DateTime.Now.Date;
    int month = todaysDate.Month;
    int year = todaysDate.Year;
    int nextMonth = todaysDate.AddMonths(1).Month;
    int nextYear = todaysDate.AddMonths(1).Year;

    var currentOffers = Model.dlmTargetCategory != null
        ? Model.dlmTargetCategory.Where(a => a.Date.HasValue && a.Date.Value.Month == month && a.Date.Value.Year == year).ToList()
        : new List<tblDealerSetTarget>();

    var nextOffers = Model.dlmTargetCategoryNxt != null
        ? Model.dlmTargetCategoryNxt.Where(a => a.Date.HasValue && a.Date.Value.Month == nextMonth && a.Date.Value.Year == nextYear).ToList()
        : new List<tblDealerSetTarget>();
}

@if (currentOffers.Any())
{
    <div id="myCarouselslide2" class="carousel slide saas-dealer-offer-carousel" data-ride="carousel">
        <div class="carousel-inner">
            @for (var i = 0; i < currentOffers.Count; i++)
            {
                var item = currentOffers[i];
                var activeClass = i == 0 ? "active" : "";
                var _60per = ""; var _70per = ""; var _80per = ""; var _90per = ""; var _100per = "";
                var _60prdnm = ""; var _70prdnm = ""; var _80prdnm = ""; var _90prdnm = ""; var _100prdnm = "";
                var categotyLogoPath = "";
                foreach (var image in Model.CategoryImages ?? Enumerable.Empty<string>())
                {
                    if (item.Category == image)
                    {
                        categotyLogoPath = image + ".JPG";
                        break;
                    }
                }

                if (Model.productItems != null)
                {
                    _60per = Model.productItems.Any(a => a.ProductName == item.Achive_60) ? Model.productItems.Where(a => a.ProductName == item.Achive_60).SingleOrDefault().ProductImages : item.Achive_60;
                    _60prdnm = item.OfferType == "Giftitem" ? item.Achive_60 : "Cash Rs.";
                    _70per = Model.productItems.Any(a => a.ProductName == item.Achive_70) ? Model.productItems.Where(a => a.ProductName == item.Achive_70).SingleOrDefault().ProductImages : item.Achive_70;
                    _70prdnm = item.OfferType == "Giftitem" ? item.Achive_70 : "Cash Rs.";
                    _80per = Model.productItems.Any(a => a.ProductName == item.Achive_80) ? Model.productItems.Where(a => a.ProductName == item.Achive_80).SingleOrDefault().ProductImages : item.Achive_80;
                    _80prdnm = item.OfferType == "Giftitem" ? item.Achive_80 : "Cash Rs.";
                    _90per = Model.productItems.Any(a => a.ProductName == item.Achive_90) ? Model.productItems.Where(a => a.ProductName == item.Achive_90).SingleOrDefault().ProductImages : item.Achive_90;
                    _90prdnm = item.OfferType == "Giftitem" ? item.Achive_90 : "Cash Rs.";
                    _100per = Model.productItems.Any(a => a.ProductName == item.Achive_100) ? Model.productItems.Where(a => a.ProductName == item.Achive_100).SingleOrDefault().ProductImages : item.Achive_100;
                    _100prdnm = item.OfferType == "Giftitem" ? item.Achive_100 : "Cash Rs.";
                }

                <div class="item saas-dealer-offer-slide @activeClass">
                    <div class="saas-dealer-offer-hero">
                        <h3><strong>Target Amount INR</strong><span>@item.SetTarget</span></h3>
                        <div class="saas-dealer-offer-round">
                            <img src="/CategoryImages/@categotyLogoPath" alt="@item.Category" />
                        </div>
                        <h2>@item.Category</h2>
                    </div>
                    <div class="saas-dealer-offer-tiers">
                        <div class="saas-dealer-offer-tier">
                            <strong>100% <span>Achievement</span></strong>
                            <div class="saas-dealer-offer-reward"><span>@_100prdnm</span>@Html.Raw(item.OfferType == "Giftitem" ? "<img src=/images/" + _100per + " alt='Reward'>" : "<strong>" + _100per + "</strong>")</div>
                        </div>
                        <div class="saas-dealer-offer-tier">
                            <strong>90% <span>Achievement</span></strong>
                            <div class="saas-dealer-offer-reward"><span>@_90prdnm</span>@Html.Raw(item.OfferType == "Giftitem" ? "<img src=/images/" + _90per + " alt='Reward'>" : "<strong>" + _90per + "</strong>")</div>
                        </div>
                        <div class="saas-dealer-offer-tier">
                            <strong>80% <span>Achievement</span></strong>
                            <div class="saas-dealer-offer-reward"><span>@_80prdnm</span>@Html.Raw(item.OfferType == "Giftitem" ? "<img src=/images/" + _80per + " alt='Reward'>" : "<strong>" + _80per + "</strong>")</div>
                        </div>
                        <div class="saas-dealer-offer-tier">
                            <strong>70% <span>Achievement</span></strong>
                            <div class="saas-dealer-offer-reward"><span>@_70prdnm</span>@Html.Raw(item.OfferType == "Giftitem" ? "<img src=/images/" + _70per + " alt='Reward'>" : "<strong>" + _70per + "</strong>")</div>
                        </div>
                        <div class="saas-dealer-offer-tier">
                            <strong>60% <span>Achievement</span></strong>
                            <div class="saas-dealer-offer-reward"><span>@_60prdnm</span>@Html.Raw(item.OfferType == "Giftitem" ? "<img src=/images/" + _60per + " alt='Reward'>" : "<strong>" + _60per + "</strong>")</div>
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (currentOffers.Count > 1)
        {
            <a class="saas-dealer-offer-controls left carousel-control" href="#myCarouselslide2" data-slide="prev" aria-label="Previous"><i class="fas fa-chevron-left"></i></a>
            <a class="saas-dealer-offer-controls right carousel-control" href="#myCarouselslide2" data-slide="next" aria-label="Next"><i class="fas fa-chevron-right"></i></a>
        }
    </div>
}
else
{
    <div id="myCarouselslide2" class="saas-dealer-offer-empty">
        <div class="saas-dt-empty">
            <i class="fas fa-gift" aria-hidden="true"></i>
            <p>No offers available for this month</p>
        </div>
    </div>
}

