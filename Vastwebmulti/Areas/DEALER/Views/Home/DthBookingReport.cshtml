@model IEnumerable<Vastwebmulti.Models.DTHConnection_Report_New_Result>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "DTH Booking Report";
    Layout = "~/Areas/DEALER/Views/Shared/_Layout.cshtml";

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var selectedStatus = (Request["ddl_status"] ?? ViewBag.ddl_status as string ?? "").Trim();
    if (selectedStatus == "Status" || selectedStatus == "ALL") { selectedStatus = ""; }
    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
    var reports = Model ?? Enumerable.Empty<Vastwebmulti.Models.DTHConnection_Report_New_Result>();

    var totalAmount = ViewBag.total != null ? Convert.ToDecimal(ViewBag.total) : 0m;
    var totalSuccess = ViewData["Totals"] != null ? Convert.ToDecimal(ViewData["Totals"]) : 0m;
    var totalFailed = ViewData["Totalf"] != null ? Convert.ToDecimal(ViewData["Totalf"]) : 0m;
    var totalPending = ViewData["Totalp"] != null ? Convert.ToDecimal(ViewData["Totalp"]) : 0m;
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=15" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/dealer-dth-booking-report-modern.css?v=22" rel="stylesheet" />

<div id="loadermoney" class="vm-dmt-loader" style="display:none;"></div>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-dth-booking-report-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var dthFormAttrs = new Dictionary<string, object>
            {
                { "id", "dthBookingReportForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("DthBookingReport", "Home", FormMethod.Post, dthFormAttrs))
        {
            <input type="hidden" name="ddl_top" value="All" />
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Prepaid &amp; Utilities</li>
                        <li>DTH Booking Report</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters">

                        <div class="vm-opr-field vm-dmt-field vm-radiant-field--status">
                            @Html.DropDownList("ddl_status", new SelectList(new[]
                            {
                                new SelectListItem { Text = "All Status", Value = "" },
                                new SelectListItem { Text = "Pending", Value = "Pending" },
                                new SelectListItem { Text = "Success", Value = "Success" },
                                new SelectListItem { Text = "Failed", Value = "Failed" }
                            }, "Value", "Text", selectedStatus), new { id = "ddl_status", @class = "vm-opr-select vm-dmt-select form-control", @title = "Status", data_live_search = "true" })
                        </div>

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="dthBookingTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>DTH booking totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideDthBookingTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--primary">
                            <span class="vm-opr-total-card__label">Total Amount</span>
                            <strong class="vm-opr-total-card__value" id="dthTotalAmount">@totalAmount.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Success</span>
                            <strong class="vm-opr-total-card__value" id="dthSuccessAmount">@totalSuccess.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Failed</span>
                            <strong class="vm-opr-total-card__value" id="dthFailedAmount">@totalFailed.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Pending</span>
                            <strong class="vm-opr-total-card__value" id="dthPendingAmount">@totalPending.ToString("N2")</strong>
                        </div>
                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-satellite-dish" aria-hidden="true"></i>
                        <span>DTH booking report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-inline-total" title="Total amount for current filter">
                            Total: <strong>&#8377; @totalAmount.ToString("N2")</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-radiant-totals-btn vm-dth-totals-btn" onclick="toggleDthBookingTotals()" title="Show totals" aria-expanded="false" aria-controls="dthBookingTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnDthExcel" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnDthPdf" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="dthBookingReport" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Customer&nbsp;Id</th>
                                    <th>Status</th>
                                    <th>Amount&nbsp;&#8377;</th>
                                    <th>Customer&nbsp;Name</th>
                                    <th>Customer&nbsp;Email</th>
                                    <th>Customer&nbsp;Mobile</th>
                                    <th>Address</th>
                                    <th>DTH&nbsp;Title</th>
                                    <th>DTH&nbsp;Plan</th>
                                    <th>Dealer&nbsp;Pre</th>
                                    <th>Dealer&nbsp;Post</th>
                                    <th>Dealer&nbsp;Comm</th>
                                    <th>#</th>
                                </tr>
                            </thead>
                            <tbody>
                                @Html.Partial("_DthBookingReportRows", reports)
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<div class="modal fade saas-admin-modal vm-dmt-modal vm-dmt-detail-modal vm-dth-detail-modal" id="dthBookingDetailModal" tabindex="-1" role="dialog" aria-labelledby="dthBookingDetailTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header saas-admin-modal-header accent-violet">
                <div class="saas-admin-modal-head-main">
                    <div class="saas-admin-modal-icon"><i class="fas fa-satellite-dish" aria-hidden="true"></i></div>
                    <div class="saas-admin-modal-title-wrap">
                        <h4 class="modal-title saas-admin-modal-title" id="dthBookingDetailTitle">Booking details</h4>
                        <span class="saas-admin-modal-subtitle" id="dthDetSubtitle">DTH booking information</span>
                    </div>
                </div>
                <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close">
                    <i class="fas fa-times" aria-hidden="true"></i>
                </button>
            </div>
            <div class="modal-body saas-admin-modal-body saas-admin-modal-scroll vm-dmt-modal-body">
                <div class="vm-dmt-modal-grid vm-dmt-modal-grid--2 vm-dth-detail-grid">
                    <div class="vm-dmt-modal-field vm-dth-detail-span-2">
                        <label>Firm / Customer Id</label>
                        <div class="vm-dmt-modal-readonly" id="dthDetFirm">—</div>
                    </div>
                    <div class="vm-dmt-modal-field">
                        <label>Retailer Name</label>
                        <div class="vm-dmt-modal-readonly" id="dthDetRetailer">—</div>
                    </div>
                    <div class="vm-dmt-modal-field">
                        <label>Status</label>
                        <div class="vm-dmt-modal-readonly vm-dth-detail-status" id="dthDetStatus">—</div>
                    </div>
                    <div class="vm-dmt-modal-field">
                        <label>Customer Name</label>
                        <div class="vm-dmt-modal-readonly" id="dthDetCustomer">—</div>
                    </div>
                    <div class="vm-dmt-modal-field">
                        <label>Amount</label>
                        <div class="vm-dmt-modal-readonly" id="dthDetAmount">—</div>
                    </div>
                    <div class="vm-dmt-modal-field">
                        <label>Email</label>
                        <div class="vm-dmt-modal-readonly" id="dthDetEmail">—</div>
                    </div>
                    <div class="vm-dmt-modal-field">
                        <label>Mobile</label>
                        <div class="vm-dmt-modal-readonly" id="dthDetMobile">—</div>
                    </div>
                    <div class="vm-dmt-modal-field vm-dth-detail-span-2">
                        <label>Address</label>
                        <div class="vm-dmt-modal-readonly vm-dth-detail-multiline" id="dthDetAddress">—</div>
                    </div>
                    <div class="vm-dmt-modal-field">
                        <label>DTH Title</label>
                        <div class="vm-dmt-modal-readonly" id="dthDetTitle">—</div>
                    </div>
                    <div class="vm-dmt-modal-field">
                        <label>Plan</label>
                        <div class="vm-dmt-modal-readonly" id="dthDetPlan">—</div>
                    </div>
                    <div class="vm-dmt-modal-field">
                        <label>Operator Code</label>
                        <div class="vm-dmt-modal-readonly" id="dthDetOptCode">—</div>
                    </div>
                    <div class="vm-dmt-modal-field">
                        <label>Operator Name</label>
                        <div class="vm-dmt-modal-readonly" id="dthDetOptName">—</div>
                    </div>
                    <div class="vm-dmt-modal-field">
                        <label>Recharge Time</label>
                        <div class="vm-dmt-modal-readonly" id="dthDetRch">—</div>
                    </div>
                    <div class="vm-dmt-modal-field">
                        <label>Response Time</label>
                        <div class="vm-dmt-modal-readonly" id="dthDetResp">—</div>
                    </div>
                    <div class="vm-dmt-modal-field">
                        <label>Box Type</label>
                        <div class="vm-dmt-modal-readonly" id="dthDetBox">—</div>
                    </div>
                    <div class="vm-dmt-modal-field">
                        <label>Box Type Name</label>
                        <div class="vm-dmt-modal-readonly" id="dthDetBoxName">—</div>
                    </div>
                    <div class="vm-dmt-modal-field">
                        <label>Dealer Pre</label>
                        <div class="vm-dmt-modal-readonly" id="dthDetPre">—</div>
                    </div>
                    <div class="vm-dmt-modal-field">
                        <label>Dealer Post</label>
                        <div class="vm-dmt-modal-readonly" id="dthDetPost">—</div>
                    </div>
                    <div class="vm-dmt-modal-field">
                        <label>Dealer Comm</label>
                        <div class="vm-dmt-modal-readonly" id="dthDetComm">—</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer saas-admin-modal-footer">
                <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal">
                    <i class="fas fa-times" aria-hidden="true"></i> Close
                </button>
            </div>
        </div>
    </div>
</div>

<script src="~/MainFrontDesign/js/admin-report-datepicker.js?v=3"></script>
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    window.dthBookingExcelUrl = '@Url.Action("ExcelDthBookingReport", "Home")';
    window.dthBookingPdfUrl = '@Url.Action("PDFDthBookingReport", "Home")';
    window.dthSelect2Url = '@Url.Content("~/MainFrontDesign/select2/dist/js/select2.full.min.js")';

    function dthBookingQuery() {
        var $ = window.jQuery;
        return 'txt_frm_date=' + encodeURIComponent($('#txt_frm_date').val() || '')
            + '&txt_to_date=' + encodeURIComponent($('#txt_to_date').val() || '')
            + '&ddl_status=' + encodeURIComponent($('#ddl_status').val() || '')
            + '&ddl_top=All';
    }

    function toggleDthBookingTotals() {
        var $ = window.jQuery;
        var panel = $('#dthBookingTotalsPanel');
        var btn = $('.vm-dth-totals-btn');
        if (panel.is(':visible')) {
            hideDthBookingTotals();
            return;
        }
        panel.slideDown(180).attr('aria-hidden', 'false');
        btn.attr('aria-expanded', 'true');
    }

    function hideDthBookingTotals() {
        var $ = window.jQuery;
        $('#dthBookingTotalsPanel').slideUp(180).attr('aria-hidden', 'true');
        $('.vm-dth-totals-btn').attr('aria-expanded', 'false');
    }

    function dthLoadScript(src, done) {
        var s = document.createElement('script');
        s.src = src;
        s.onload = done;
        s.onerror = done;
        document.body.appendChild(s);
    }

    function dthDetailText(btn, name) {
        var value = (btn && btn.getAttribute('data-' + name)) || '';
        value = String(value).replace(/\s+/g, ' ').trim();
        return value || '—';
    }

    function dthSetDetail(id, value) {
        var el = document.getElementById(id);
        if (el) {
            el.textContent = value;
        }
    }

    function dthStatusTone(status) {
        var raw = (status || '').toLowerCase();
        if (raw.indexOf('fail') >= 0 || raw.indexOf('refund') >= 0) {
            return 'failed';
        }
        if (raw.indexOf('success') >= 0) {
            return 'success';
        }
        return 'pending';
    }

    function openDthBookingDetail(btn) {
        var firm = dthDetailText(btn, 'firm');
        var status = dthDetailText(btn, 'status');
        var amount = dthDetailText(btn, 'amount');
        dthSetDetail('dthDetSubtitle', firm === '—' ? 'DTH booking information' : firm);
        dthSetDetail('dthDetFirm', firm);
        dthSetDetail('dthDetRetailer', dthDetailText(btn, 'retailer'));
        dthSetDetail('dthDetStatus', status);
        dthSetDetail('dthDetCustomer', dthDetailText(btn, 'customer'));
        dthSetDetail('dthDetAmount', amount === '—' ? '—' : ('₹ ' + amount));
        dthSetDetail('dthDetEmail', dthDetailText(btn, 'email'));
        dthSetDetail('dthDetMobile', dthDetailText(btn, 'mobile'));
        dthSetDetail('dthDetAddress', dthDetailText(btn, 'address'));
        dthSetDetail('dthDetTitle', dthDetailText(btn, 'title'));
        dthSetDetail('dthDetPlan', dthDetailText(btn, 'plan'));
        dthSetDetail('dthDetOptCode', dthDetailText(btn, 'optcode'));
        dthSetDetail('dthDetOptName', dthDetailText(btn, 'optname'));
        dthSetDetail('dthDetRch', dthDetailText(btn, 'rch'));
        dthSetDetail('dthDetResp', dthDetailText(btn, 'resp'));
        dthSetDetail('dthDetBox', dthDetailText(btn, 'box'));
        dthSetDetail('dthDetBoxName', dthDetailText(btn, 'boxname'));
        dthSetDetail('dthDetPre', dthDetailText(btn, 'pre'));
        dthSetDetail('dthDetPost', dthDetailText(btn, 'post'));
        dthSetDetail('dthDetComm', dthDetailText(btn, 'comm'));

        var statusEl = document.getElementById('dthDetStatus');
        if (statusEl) {
            statusEl.className = 'vm-dmt-modal-readonly vm-dth-detail-status vm-dth-detail-status--' + dthStatusTone(status);
        }

        if (typeof window.showAdminModal === 'function') {
            window.showAdminModal('#dthBookingDetailModal');
            return;
        }
        var $ = window.jQuery;
        var $modal = $('#dthBookingDetailModal');
        if ($modal.parent().length && !$modal.parent().is('body')) {
            $modal.appendTo(document.body);
        }
        if ($ && $.fn && $.fn.modal) {
            $modal.modal('show');
        }
    }

    function bindDthDetailModal() {
        var $ = window.jQuery;
        if (!$ || !$.fn || !$.fn.modal) {
            window.setTimeout(bindDthDetailModal, 40);
            return;
        }
        $(document).off('click.dthDetail', '.vm-dth-detail-btn').on('click.dthDetail', '.vm-dth-detail-btn', function (e) {
            e.preventDefault();
            e.stopPropagation();
            openDthBookingDetail(this);
        });
    }
    bindDthDetailModal();

    function bootDthBookingReport() {
        var $ = window.jQuery;
        if (!$ || !$.fn || !$.fn.datepicker) {
            window.setTimeout(bootDthBookingReport, 50);
            return;
        }

        function afterPlugins() {
            if ($.fn.select2 && !$('#ddl_status').hasClass('select2-hidden-accessible')) {
                $('#ddl_status').select2({
                    width: '100%',
                    minimumResultsForSearch: 0
                });
            }

            $('#btnDthExcel').off('click.dthEx').on('click.dthEx', function () {
                window.location.href = window.dthBookingExcelUrl + '?' + dthBookingQuery();
            });
            $('#btnDthPdf').off('click.dthPdf').on('click.dthPdf', function () {
                window.open(window.dthBookingPdfUrl + '?' + dthBookingQuery(), '_blank');
            });

            if (typeof window.initAdminReportDateForm === 'function') {
                window.initAdminReportDateForm('#dthBookingReportForm');
            } else {
                $('#txt_frm_date, #txt_to_date').datepicker({
                    format: 'yyyy-mm-dd',
                    todayHighlight: true,
                    autoclose: true,
                    orientation: 'bottom auto'
                });
                if ($('#dthBookingReportForm').attr('data-date-mode') !== 'post') {
                    $('#txt_frm_date').datepicker('setDate', new Date());
                    $('#txt_to_date').datepicker('setDate', new Date());
                }
            }
        }

        if ($.fn.select2) {
            afterPlugins();
            return;
        }
        dthLoadScript(window.dthSelect2Url, afterPlugins);
    }

    if (document.readyState === 'complete') {
        bootDthBookingReport();
    } else {
        window.addEventListener('load', bootDthBookingReport);
    }
</script>
