@model IEnumerable<Vastwebmulti.Models.Aeps_Report_New_Result>
@using System.Linq
@{
    Layout = null;
    var items = Model ?? Enumerable.Empty<Vastwebmulti.Models.Aeps_Report_New_Result>();
}
@if (items.Any())
{
    foreach (var item in items)
    {
        var statusRaw = item.Status ?? "";
        var statusTone = "pending";
        var statusLabel = statusRaw;
        var statusFa = "fa-clock-o";
        if (statusRaw.IndexOf("REFUND", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "failed";
            statusLabel = "Refund";
            statusFa = "fa-undo";
        }
        else if (statusRaw.IndexOf("FAILED", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "failed";
            statusLabel = "Failed";
            statusFa = "fa-times";
        }
        else if (statusRaw.IndexOf("SUCCESS", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "success";
            statusLabel = "Success";
            statusFa = "fa-check";
        }
        else if (statusRaw.IndexOf("PENDING", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "pending";
            statusLabel = "Pending";
            statusFa = "fa-clock-o";
        }
        else if (statusRaw.IndexOf("BALANCE", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "pending";
            statusLabel = "Balance";
            statusFa = "fa-inr";
        }
        else if (statusRaw.IndexOf("SETTLEMENT", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "pending";
            statusLabel = "Settlement";
            statusFa = "fa-university";
        }

        var firm = !string.IsNullOrWhiteSpace(item.Frm_Name) ? item.Frm_Name : (item.RetailerName ?? "—");
        var appType = item.ApplicationType ?? "";
        var fromLabel = "WEB";
        var fromIcon = "fa-globe";
        if (string.Equals(appType, "app", StringComparison.OrdinalIgnoreCase))
        {
            fromLabel = "APP";
            fromIcon = "fa-android";
        }

        var maskedAadhaar = "—";
        if (!string.IsNullOrEmpty(item.AccountHolderAadhaar) && item.AccountHolderAadhaar.Length >= 4)
        {
            var last = item.AccountHolderAadhaar.Substring(item.AccountHolderAadhaar.Length - 4, 4);
            maskedAadhaar = new string('x', 8) + last;
        }

        decimal userCredit = 0;
        if (string.Equals(item.Role, "Retailer", StringComparison.OrdinalIgnoreCase))
        {
            userCredit = (item.Amount ?? 0) + (item.RemIncome ?? 0);
        }

        var reqDate = item.Txn_Date.HasValue ? item.Txn_Date.Value.ToString("dd-MMM HH:mm:ss") : "—";
        <tr class="vm-dmt-row vm-dmt-row--@statusTone" data-status="@statusRaw">
            <td class="vm-radiant-status-cell vm-ticket-status-cell">
                <span class="vm-dmt-status vm-dmt-status--@statusTone" title="@statusLabel">
                    <i class="fa @statusFa" aria-hidden="true"></i>
                </span>
                <span class="vm-radiant-status-text">@firm</span>
            </td>
            <td>
                <i class="fa @fromIcon" aria-hidden="true" title="@fromLabel"></i>
                <span>@(item.MerchantTxnId ?? "—")</span>
            </td>
            <td>@maskedAadhaar</td>
            <td>@(item.BankName ?? "—")</td>
            <td>@(item.Type ?? "—")</td>
            <td class="vm-dmt-amt-cell">@(item.Amount.HasValue ? item.Amount.Value.ToString("N2") : "—")</td>
            <td class="vm-dmt-amt-cell">@userCredit.ToString("N2")</td>
            <td class="vm-dmt-amt-cell">@(item.DlmPost.HasValue ? item.DlmPost.Value.ToString("N2") : "—")</td>
            <td>@(item.BankRRN ?? "—")</td>
            <td>@reqDate</td>
        </tr>
    }
}
else
{
    <tr class="vm-opr-table-empty-row">
        <td colspan="10" class="vm-opr-table-empty">
            <i class="fas fa-fingerprint" aria-hidden="true"></i>
            <span>AEPS report not found.</span>
        </td>
    </tr>
}
