@model IEnumerable<Vastwebmulti.Models.pancard_transation>
@using System.Collections.Generic
@using System.Linq
@{
    ViewBag.Title = "Pancard Report";
    Layout = "~/Areas/DEALER/Views/Shared/_Layout.cshtml";

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var selectedRetailer = (Request["allretailer"] ?? "").Trim();
    var selectedStatus = (Request["ddl_status"] ?? "").Trim();
    if (string.IsNullOrEmpty(selectedStatus)) { selectedStatus = "ALL"; }
    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
    var items = Model ?? Enumerable.Empty<Vastwebmulti.Models.pancard_transation>();
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=7" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=31" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=2" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-incoming-report-modern.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/dealer-flight-report-modern.css?v=8" rel="stylesheet" />
<script>document.body.classList.add('saas-flight-report-dp-page');</script>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-incoming-report-page saas-dealer-flight-report-page saas-dealer-dmt-report-page saas-dealer-pancard-report-page">
    <div class="container-fluid vm-opr-page-shell">

        @{
            var panFormAttrs = new Dictionary<string, object>
            {
                { "id", "dealerPancardReportForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("Pancard_report_new", "Home", FormMethod.Post, panFormAttrs))
        {
            <div class="saas-acc-toolbar saas-pan-toolbar-unified saas-acc-toolbar--stacked vm-opr-toolbar-unified">
                <div class="saas-acc-toolbar-top vm-opr-toolbar-head">
                    <ol class="saas-acc-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Reports</li>
                        <li>Pancard Report</li>
                    </ol>
                    <div class="vm-opr-page-nav">
                        <nav class="vm-opr-nav--page" aria-label="Banking reports">
                            <a class="vm-opr-nav__link" href="@Url.Action("Money_Transfer_Report", "Home")">DMT</a>
                            <a class="vm-opr-nav__link" href="@Url.Action("AepsReport", "Home")">AEPS</a>
                            <a class="vm-opr-nav__link" href="@Url.Action("m_possreport", "Home")">M-Poss</a>
                            <a class="vm-opr-nav__link is-active" href="@Url.Action("Pancard_report_new", "Home")">Pancard</a>
                            <a class="vm-opr-nav__link" href="@Url.Action("MIcroAtmReport", "Home")">MicroATM</a>
                            <a class="vm-opr-nav__link" href="@Url.Action("CashDepositReport", "Home")">Cash Deposit</a>
                        </nav>
                    </div>
                </div>
                <div class="vm-rpt-filters-panel">
                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-inc-filter-row vm-rpt-filters-panel__bar">

                        <div class="vm-inc-filter-left">
                            <div class="vm-opr-field vm-opr-field--port">
                                @{
                                    var retailerItems = ViewBag.allretailer as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
                                }
                                @Html.DropDownList("allretailer", new SelectList(retailerItems, "Value", "Text", selectedRetailer), "Select User", new { id = "allretailer", @class = "vm-opr-select form-control for-select2", @title = "User" })
                            </div>
                            <div class="vm-opr-field vm-opr-field--port">
                                @Html.DropDownList("ddl_status", new SelectList(new[]
                                {
                                    new SelectListItem { Text = "All Status", Value = "ALL" },
                                    new SelectListItem { Text = "SUCCESS", Value = "SUCCESS" },
                                    new SelectListItem { Text = "PENDING", Value = "PENDING" },
                                    new SelectListItem { Text = "FAILED", Value = "FAILED" }
                                }, "Value", "Text", selectedStatus), new { id = "ddl_status", @class = "vm-opr-select form-control for-select2", @title = "Status" })
                            </div>
                        </div>

                        <div class="vm-inc-filter-right">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel" id="showreport">
                <div class="vm-opr-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-id-card" aria-hidden="true"></i>
                        <span>Pancard report</span>
                    </div>
                    <div class="vm-opr-table-panel__right vm-flight-table-head-right">
                        <nav class="vm-opr-nav--page" aria-label="Pancard version">
                            <a class="vm-opr-nav__link is-active" href="@Url.Action("Pancard_report_new", "Home")">NEW</a>
                            <a class="vm-opr-nav__link" href="@Url.Action("Pancard_report", "Home")">OLD</a>
                        </nav>
                        <div class="vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" id="btnExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="example" class="table table-bordered table-striped table-hover vm-opr-data-table vm-inc-data-table vm-flight-data-table">
                            <thead>
                                <tr>
                                    <th>Live&nbsp;Status</th>
                                    <th>User</th>
                                    <th>Amount</th>
                                    <th>User&nbsp;Pre</th>
                                    <th>TDS</th>
                                    <th>COMM</th>
                                    <th>User&nbsp;Post</th>
                                    <th>User&nbsp;Final</th>
                                    <th>MY&nbsp;Pre</th>
                                    <th>MY&nbsp;COMM</th>
                                    <th>MY&nbsp;TDS</th>
                                    <th>MY&nbsp;Post</th>
                                    <th>MY&nbsp;Final</th>
                                    <th>Time</th>
                                </tr>
                            </thead>
                            <tbody id="trow">
                                @{ Html.RenderPartial("_Pancard_report_new", items); }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script src="~/MainFrontDesign/js/admin-report-datepicker.js?v=3"></script>
<script src="~/MainFrontDesign/js/admin-operator-report-nav.js"></script>
<script>
    window.panExcelUrl = '@Url.Action("ExcelRechargereportPan1", "Home")';
    window.panPdfUrl = '@Url.Action("PDFreport_PAN1", "Home")';
    window.panSelect2Url = '@Url.Content("~/MainFrontDesign/select2/dist/js/select2.full.min.js")';

    function panQueryData() {
        var $ = window.jQuery;
        return {
            txt_frm_date: $('#txt_frm_date').val() || '',
            txt_to_date: $('#txt_to_date').val() || '',
            ddl_status: $('#ddl_status').val() || 'ALL',
            allretailer: $('#allretailer').val() || ''
        };
    }

    function panQueryString() {
        var q = panQueryData();
        return 'txt_frm_date=' + encodeURIComponent(q.txt_frm_date)
            + '&txt_to_date=' + encodeURIComponent(q.txt_to_date)
            + '&ddl_status=' + encodeURIComponent(q.ddl_status)
            + '&allretailer=' + encodeURIComponent(q.allretailer);
    }

    function panLoadScript(src, done) {
        var s = document.createElement('script');
        s.src = src;
        s.onload = done;
        s.onerror = done;
        document.body.appendChild(s);
    }

    function bootDealerPancardReport() {
        var $ = window.jQuery;
        if (!$ || !$.fn || !$.fn.datepicker) {
            window.setTimeout(bootDealerPancardReport, 50);
            return;
        }

        function afterPlugins() {
            document.body.classList.add('saas-flight-report-dp-page');
            $('.saas-dealer-flight-report-page.saas-dealer-pancard-report-page .for-select2').each(function () {
                var $el = $(this);
                if ($.fn.select2 && !$el.hasClass('select2-hidden-accessible')) {
                    $el.select2({
                        width: '100%',
                        dropdownParent: $('body'),
                        containerCssClass: 'vm-flight-select2',
                        dropdownCssClass: 'vm-flight-select2-drop',
                        minimumResultsForSearch: $el.attr('id') === 'ddl_status' ? 8 : 0
                    });
                }
            });

            if (typeof window.initAdminReportDateForm === 'function') {
                window.initAdminReportDateForm('#dealerPancardReportForm');
            } else {
                $('#txt_frm_date, #txt_to_date').datepicker({
                    format: 'yyyy-mm-dd',
                    todayHighlight: true,
                    autoclose: true,
                    orientation: 'bottom auto',
                    container: 'body'
                });
                if ($('#dealerPancardReportForm').attr('data-date-mode') !== 'post') {
                    $('#txt_frm_date').datepicker('setDate', new Date());
                    $('#txt_to_date').datepicker('setDate', new Date());
                }
            }

            function pinPanDatepicker(e) {
                if (typeof window.repositionAdminDatepickerForMobile === 'function') {
                    window.repositionAdminDatepickerForMobile(e && e.target ? e.target : this);
                }
            }

            $(document).off('show.vmPanDp shown.vmPanDp').on('show.vmPanDp shown.vmPanDp', '#txt_frm_date, #txt_to_date', pinPanDatepicker);
            $(window).off('resize.vmPanDp orientationchange.vmPanDp').on('resize.vmPanDp orientationchange.vmPanDp', pinPanDatepicker);

            $('#btnExport').off('click.panEx').on('click.panEx', function () {
                window.location.href = window.panExcelUrl + '?' + panQueryString();
            });
            $('#btnPDF').off('click.panPdf').on('click.panPdf', function () {
                window.open(window.panPdfUrl + '?' + panQueryString(), '_blank');
            });
        }

        if ($.fn.select2) {
            afterPlugins();
            return;
        }
        panLoadScript(window.panSelect2Url, afterPlugins);
    }

    if (document.readyState === 'complete') {
        bootDealerPancardReport();
    } else {
        window.addEventListener('load', bootDealerPancardReport);
    }
</script>

