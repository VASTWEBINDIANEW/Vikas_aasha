        }
        @@media (max-width: 991px) {
            body.saas-admin-ui.saas-flight-report-dp-page .datepicker.dropdown-menu,
            body.saas-admin-ui .datepicker.vm-flight-dp {
                position: fixed !important;
                width: calc(100vw - 32px) !important;
                max-width: 320px !important;
                box-sizing: border-box !important;
                overflow: hidden !important;
                z-index: 12000 !important;
            }
            body.saas-admin-ui.saas-flight-report-dp-page .datepicker table,
            body.saas-admin-ui .datepicker.vm-flight-dp table {
                width: 100% !important;
                max-width: 100% !important;
                table-layout: fixed !important;
            }
            body.saas-admin-ui.saas-flight-report-dp-page .datepicker table tr td,
            body.saas-admin-ui.saas-flight-report-dp-page .datepicker table tr th,
            body.saas-admin-ui .datepicker.vm-flight-dp table tr td,
            body.saas-admin-ui .datepicker.vm-flight-dp table tr th {
