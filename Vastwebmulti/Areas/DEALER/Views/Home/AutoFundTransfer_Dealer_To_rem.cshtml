@using Vastwebmulti.Models;
@model Vastwebmulti.Models.Autofundtransfermodelviewmodel
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Auto Credit Transfer Setting";
    Layout = "~/Areas/DEALER/Views/Shared/_Layout.cshtml";

    var nick = "Retailer";
    VastwebmultiEntities DB1 = new VastwebmultiEntities();
    var usernname = DB1.Usernicknames.Where(aa => aa.Role == "Retailer").ToList();
    if (usernname.Any())
    {
        var row = usernname.SingleOrDefault();
        if (row != null && row.Role == "Retailer" && !string.IsNullOrWhiteSpace(row.NickName))
        {
            nick = row.NickName;
        }
    }
    ViewBag.nickname = nick;

    var rows = Model != null && Model.autofundtransfermodel != null
        ? Model.autofundtransfermodel.ToList()
        : new List<Autofundtransfermodel>();
    var rowCount = rows.Count;
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=30" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=15" rel="stylesheet" />
<link href="~/MainFrontDesign/css/dealer-dth-booking-report-modern.css?v=24" rel="stylesheet" />
<script>document.body.classList.add('saas-sell-rch-dp-page');</script>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-auto-fund-status-page saas-dth-booking-report-page saas-matm-rental-report-page saas-dealer-auto-fund-page">

    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">
            <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line">
                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>Report's</li>
                    <li>Auto Credit Transfer Setting</li>
                </ol>
            </div>
        </div>

        <div class="vm-opr-main-card vm-auto-fund-main-card">
            <div class="vm-opr-table-panel vm-auto-fund-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-sync-alt" aria-hidden="true"></i>
                        <span>Auto fund transfer to @nick status</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong id="autoFundRecordCount">@rowCount</strong>
                        </span>
                        <div class="vm-auto-fund-search-wrap">
                            <i class="fas fa-search" aria-hidden="true"></i>
                            <input class="form-control vm-auto-fund-search-input" type="text" value="" id="myInput" placeholder="Search @nick..." name="myInput" autocomplete="off" />
                        </div>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" id="btnExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel" onclick="dealerAutoFundExcel()">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF" onclick="dealerAutoFundPDF()">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap vm-auto-fund-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll" id="autoFundTransferExportWrap">
                        <table id="autoFundTransferTable" class="table vm-opr-data-table vm-auto-fund-data-table" cellspacing="0">
                            <colgroup>
                                <col class="vm-auto-fund-col-firm" />
                                <col class="vm-auto-fund-col-amt" />
                                <col class="vm-auto-fund-col-amt" />
                                <col class="vm-auto-fund-col-day" />
                                <col class="vm-auto-fund-col-amt" />
                                <col class="vm-auto-fund-col-date" />
                                <col class="vm-auto-fund-col-type" />
                                <col class="vm-auto-fund-col-status" />
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>Firm Details</th>
                                    <th>Min Balance &#8377;</th>
                                    <th>Transfer Amt &#8377;</th>
                                    <th>Day Count</th>
                                    <th>Credit Limit &#8377;</th>
                                    <th>Last Trans Date</th>
                                    <th>Transfer Type</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody id="body">
                                @if (rowCount == 0)
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="8" class="vm-opr-table-empty vm-dmt-table-empty">
                                            <i class="fas fa-sync-alt" aria-hidden="true"></i>
                                            <span>No auto fund transfer records found.</span>
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    foreach (var item in rows)
                                    {
                                        var isCredit = item.types != null && item.types.ToUpper() == "CREDIT";
                                        var lastDate = item.transferdatetime.HasValue
                                            ? item.transferdatetime.Value.ToString("dd-MMM-yyyy hh:mm tt")
                                            : "-";
                                        <tr class="tr vm-auto-fund-row vm-dmt-row">
                                            <td>
                                                <input type="hidden" name="idno" value="@item.idno" />
                                                <input type="hidden" name="transfertype" value="@item.types" />
                                                <input type="hidden" name="Currentsts" value="@item.status" />
                                                <div class="vm-auto-fund-firm">
                                                    <strong>@item.Name</strong>
                                                </div>
                                            </td>
                                            <td class="vm-dmt-amt-cell">
                                                <div class="vm-auto-fund-cell-show tbltdshow">
                                                    <span id="spanminimium_@item.idno">@item.minimiumamount</span>
                                                </div>
                                                <div class="vm-auto-fund-cell-edit tbltdNOTshow" style="display:none;">
                                                    <input type="number" name="minimiumamount" value="0" min="0" oninput="this.value = Math.abs(this.value)" class="vm-auto-fund-edit-input form-control" />
                                                    <span class="vm-auto-fund-field-error" style="display:none;" data-bind="errormsg_@item.idno">Minimum amount must be 500</span>
                                                </div>
                                            </td>
                                            <td class="vm-dmt-amt-cell">
                                                <div class="vm-auto-fund-cell-show tbltdshow">
                                                    <span id="spantransferamnt_@item.idno">@item.transferamount</span>
                                                </div>
                                                <div class="vm-auto-fund-cell-edit tbltdNOTshow" style="display:none;">
                                                    <input type="number" name="transferamount" value="0" min="0" oninput="this.value = Math.abs(this.value)" class="vm-auto-fund-edit-input form-control" />
                                                    <span class="vm-auto-fund-field-error" style="display:none;" data-bind="errormsg1_@item.idno">Minimum amount must be 500</span>
                                                </div>
                                            </td>
                                            <td class="vm-dmt-amt-cell">
                                                <div class="vm-auto-fund-cell-show tbltdshow">
                                                    <span id="spantotaltrans_@item.idno">@item.totaltransfer</span>
                                                </div>
                                                <div class="vm-auto-fund-cell-edit tbltdNOTshow" style="display:none;">
                                                    <input type="number" name="totaltransfer" value="0" min="0" oninput="this.value = Math.abs(this.value)" class="vm-auto-fund-edit-input form-control" />
                                                </div>
                                            </td>
                                            <td class="vm-dmt-amt-cell">
                                                <div class="vm-auto-fund-cell-show tbltdshow">
                                                    <span id="spanmaxcredit_@item.idno">@item.MaxCredit</span>
                                                </div>
                                                <div class="vm-auto-fund-cell-edit tbltdNOTshow" style="display:none;">
                                                    <input type="number" name="MaxCredit" value="0" min="0" oninput="this.value = Math.abs(this.value)" class="vm-auto-fund-edit-input form-control" />
                                                </div>
                                            </td>
                                            <td>@lastDate</td>

                                            <td class="vm-auto-fund-type-cell">
                                                @if (isCredit)
                                                {
                                                    <span class="vm-auto-fund-type-pill vm-auto-fund-type-pill--credit">
                                                        <i class="fas fa-credit-card" aria-hidden="true"></i>
                                                        <button type="button" class="costom-on clscall vm-auto-fund-type-btn" data-bind="btntransfersts_@item.idno" value="Cash" onclick="calltransfertype(this)">BY CREDIT</button>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="vm-auto-fund-type-pill vm-auto-fund-type-pill--cash">
                                                        <i class="fas fa-money-bill-wave" aria-hidden="true"></i>
                                                        <button type="button" class="costom-on clscall vm-auto-fund-type-btn" data-bind="btntransfersts_@item.idno" onclick="calltransfertype(this)" value="Credit">BY CASH</button>
                                                    </span>
                                                }
                                            </td>
                                            <td class="vm-auto-fund-status-cell">
                                                <div class="vm-auto-fund-status-actions">
                                                    @if (item.status == "Y")
                                                    {
                                                        <span class="onoffswitch costom-on-second vm-auto-fund-switch-wrap">
                                                            <button type="button" class="costom-on clscall vm-auto-fund-switch-btn" data-bind="btnsts_@item.idno" value="ON" onclick="callstats(this)">ON</button>
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="onoffswitch costom-off-second vm-auto-fund-switch-wrap">
                                                            <button type="button" class="custom-off clscall vm-auto-fund-switch-btn" data-bind="btnsts_@item.idno" onclick="callstats(this)" value="OFF">OFF</button>
                                                        </span>
                                                    }

                                                    <div class="tbltdshow vm-auto-fund-edit-show" data-bind="editbtnshow_@item.idno">
                                                        <button type="button" value="EDIT" onclick="Edittransferinform(this)" class="btnssl22 vm-auto-fund-edit-btn">Edit</button>
                                                    </div>
                                                    <div class="tbltdNOTshow vm-auto-fund-edit-save" data-bind="savebtnNotshow_@item.idno" style="display:none;">
                                                        <button type="button" value="Save" onclick="Savetransferamnt(this)" class="btnssl22 vm-auto-fund-save-btn">Save</button>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<script>
    window.dealerAutoFundPdfUrl = '@Url.Action("PDF_AutoFundTransfer_Dealer_To_rem", "Home")';

    function dealerAutoFundEsc(value) {
        return String(value == null ? '' : value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function dealerAutoFundNow() {
        var d = new Date();
        var months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        var h = d.getHours();
        var ampm = h >= 12 ? 'PM' : 'AM';
        var hr = h % 12; if (!hr) { hr = 12; }
        var min = d.getMinutes();
        return ('0' + d.getDate()).slice(-2) + ' ' + months[d.getMonth()] + ' ' + d.getFullYear() + ', ' + ('0' + hr).slice(-2) + ':' + ('0' + min).slice(-2) + ' ' + ampm;
    }

    function dealerAutoFundTableRows() {
        var $ = window.jQuery;
        var rows = [];
        var nick = window.dealerAutoFundNick || 'Retailer';
        $('#autoFundTransferTable tbody tr.tr:visible').each(function () {
            var $tr = $(this);
            var $cells = $tr.children('td');
            if ($cells.length < 8) { return; }
            rows.push({
                firm: $.trim($cells.eq(0).text()).replace(/\s+/g, ' '),
                minBal: $.trim($cells.eq(1).find('.vm-auto-fund-cell-show').text()).replace(/\s+/g, ' '),
                transfer: $.trim($cells.eq(2).find('.vm-auto-fund-cell-show').text()).replace(/\s+/g, ' '),
                dayCount: $.trim($cells.eq(3).find('.vm-auto-fund-cell-show').text()).replace(/\s+/g, ' '),
                creditLimit: $.trim($cells.eq(4).find('.vm-auto-fund-cell-show').text()).replace(/\s+/g, ' '),
                lastDate: $.trim($cells.eq(5).text()).replace(/\s+/g, ' '),
                transferType: $.trim($cells.eq(6).text()).replace(/\s+/g, ' '),
                status: $.trim($cells.eq(7).text()).replace(/\s+/g, ' ')
            });
        });
        return rows;
    }

    function dealerAutoFundHeads(nick) {
        return [
            nick + ' Firm Details',
            nick + ' Minimium Balance',
            'Transfer Amount',
            'Day Count',
            'Credit Limit',
            'Last Transection Date',
            'Transfer Type',
            'Current Status'
        ];
    }

    function dealerAutoFundBuildExcelHtml(rows) {
        var nick = window.dealerAutoFundNick || 'Retailer';
        var heads = dealerAutoFundHeads(nick);
        var html = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel"><head><meta charset="utf-8" /><title>Auto Fund Transfer Setting</title></head><body>';
        html += '<table border="1" cellspacing="0" cellpadding="6" style="border-collapse:collapse;">';
        html += '<tr><td colspan="8" bgcolor="#2563EB" style="color:#FFFFFF;font-size:16pt;font-weight:bold;">Auto Credit Transfer Setting</td></tr>';
        html += '<tr><td colspan="8" bgcolor="#1D4ED8" style="color:#DBEAFE;font-size:10pt;">Dealer auto fund transfer to ' + dealerAutoFundEsc(nick) + '</td></tr>';
        html += '<tr><td bgcolor="#F1F5F9" style="font-weight:bold;">Generated On</td><td colspan="3" style="font-weight:bold;">' + dealerAutoFundEsc(dealerAutoFundNow()) + '</td>';
        html += '<td bgcolor="#F1F5F9" style="font-weight:bold;">Records</td><td colspan="3" style="font-weight:bold;">' + rows.length + '</td></tr>';
        html += '<tr>';
        for (var h = 0; h < heads.length; h++) {
            html += '<th bgcolor="#334155" style="color:#FFFFFF;font-weight:bold;">' + dealerAutoFundEsc(heads[h]) + '</th>';
        }
        html += '</tr>';
        if (!rows.length) {
            html += '<tr><td colspan="8" bgcolor="#F8FAFC" style="text-align:center;font-weight:bold;color:#64748B;height:48px;">No auto fund transfer records found.</td></tr>';
        } else {
            for (var i = 0; i < rows.length; i++) {
                var r = rows[i];
                var rowBg = (i % 2 === 1) ? '#F8FAFC' : '#FFFFFF';
                html += '<tr>';
                html += '<td bgcolor="' + rowBg + '">' + dealerAutoFundEsc(r.firm) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + dealerAutoFundEsc(r.minBal) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + dealerAutoFundEsc(r.transfer) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + dealerAutoFundEsc(r.dayCount) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + dealerAutoFundEsc(r.creditLimit) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + dealerAutoFundEsc(r.lastDate) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + dealerAutoFundEsc(r.transferType) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + dealerAutoFundEsc(r.status) + '</td>';
                html += '</tr>';
            }
        }
        html += '</table></body></html>';
        return html;
    }

    function dealerAutoFundDownloadExcel(html) {
        var blob = new Blob(['\ufeff', html], { type: 'application/vnd.ms-excel' });
        if (window.navigator && window.navigator.msSaveOrOpenBlob) {
            window.navigator.msSaveOrOpenBlob(blob, 'Auto_Fund_Transfer_Setting.xls');
            return;
        }
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'Auto_Fund_Transfer_Setting.xls';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(function () { URL.revokeObjectURL(url); }, 800);
    }

    function dealerAutoFundPDF() {
        window.open(window.dealerAutoFundPdfUrl, '_blank');
    }

    window.dealerAutoFundNick = '@Html.Raw((nick ?? "Retailer").Replace("\\", "\\\\").Replace("'", "\\'"))';

    function dealerAutoFundExcel() {
        dealerAutoFundDownloadExcel(dealerAutoFundBuildExcelHtml(dealerAutoFundTableRows()));
    }

    function resetAutoFundRowView($row) {
        $row.find('.vm-auto-fund-cell-show, .tbltdshow').show();
        $row.find('.vm-auto-fund-cell-edit, .tbltdNOTshow').hide();
    }

    function resetAllAutoFundRowsToView() {
        window.jQuery('#body tr.tr').each(function () {
            resetAutoFundRowView(window.jQuery(this));
        });
    }

    function setAutoFundRowEditMode($row) {
        $row.find('.vm-auto-fund-cell-show, .tbltdshow').hide();
        $row.find('.vm-auto-fund-cell-edit, .tbltdNOTshow').show();
    }

    function refreshAutoFundRecordCount() {
        var $ = window.jQuery;
        if (!$) { return; }
        var count = $('#body tr.tr:visible').length;
        $('#autoFundRecordCount').text(count);
    }

    function rowContext(el) {
        return window.jQuery(el).closest('tr');
    }

    function datatblbeGET(el) {
        var $row = rowContext(el);
        return {
            minamount1: $row.find('[name="minimiumamount"]').val(),
            transamnt2: $row.find('[name="transferamount"]').val(),
            countperday3: $row.find('[name="totaltransfer"]').val(),
            uptolimit4: $row.find('[name="MaxCredit"]').val(),
            typessnew: $row.find('[name="transfertype"]').val(),
            Currentstsnew: $row.find('[name="Currentsts"]').val()
        };
    }

    function datatblbeset(el, Transferamount, minamount, count, uplimitt, typess, Currentsts) {
        var $row = rowContext(el);
        $row.find('[name="minimiumamount"]').val(minamount);
        $row.find('[name="transferamount"]').val(Transferamount);
        $row.find('[name="totaltransfer"]').val(count);
        $row.find('[name="MaxCredit"]').val(uplimitt);
        $row.find('[name="transfertype"]').val(typess);
        $row.find('[name="Currentsts"]').val(Currentsts);
    }

    function refreshAutoFundTypeCell(el, typeStr) {
        var $ = window.jQuery;
        var $row = rowContext(el);
        var id = $row.find('[name="idno"]').val();
        var isCredit = (typeStr || '').toUpperCase() === 'CREDIT';
        var $cell = $row.find('.vm-auto-fund-type-cell');
        var html;

        if (isCredit) {
            html = '<span class="vm-auto-fund-type-pill vm-auto-fund-type-pill--credit">' +
                '<i class="fas fa-credit-card" aria-hidden="true"></i>' +
                '<button type="button" class="costom-on clscall vm-auto-fund-type-btn" data-bind="btntransfersts_' + id + '" value="Cash" onclick="calltransfertype(this)">BY CREDIT</button></span>';
        } else {
            html = '<span class="vm-auto-fund-type-pill vm-auto-fund-type-pill--cash">' +
                '<i class="fas fa-money-bill-wave" aria-hidden="true"></i>' +
                '<button type="button" class="costom-on clscall vm-auto-fund-type-btn" data-bind="btntransfersts_' + id + '" value="Credit" onclick="calltransfertype(this)">BY CASH</button></span>';
        }
        $cell.html(html);
    }

    function refreshAutoFundStatusCell(el, statusStr) {
        var $ = window.jQuery;
        var $row = rowContext(el);
        var id = $row.find('[name="idno"]').val();
        var isOn = (statusStr || '').toUpperCase() === 'Y';
        var $actions = $row.find('.vm-auto-fund-status-actions');
        var switchHtml;

        if (isOn) {
            switchHtml = '<span class="onoffswitch costom-on-second vm-auto-fund-switch-wrap">' +
                '<button type="button" class="costom-on clscall vm-auto-fund-switch-btn" data-bind="btnsts_' + id + '" value="ON" onclick="callstats(this)">ON</button></span>';
        } else {
            switchHtml = '<span class="onoffswitch costom-off-second vm-auto-fund-switch-wrap">' +
                '<button type="button" class="custom-off clscall vm-auto-fund-switch-btn" data-bind="btnsts_' + id + '" value="OFF" onclick="callstats(this)">OFF</button></span>';
        }

        $actions.find('.vm-auto-fund-switch-wrap').replaceWith(switchHtml);
    }

    function getdatabyid(el) {
        var $row = rowContext(el);
        var id = $row.find('[name="idno"]').val();
        window.jQuery.ajax({
            url: '@Url.Action("GetAutoTransferAmountDistributorTOrem", "Home")',
            type: 'GET',
            data: { idno: id },
            dataType: 'json',
            success: function (result) {
                datatblbeset(el, result.Transferamount, result.minamount, result.totaltransfer, result.MaxCredit, result.types, result.status);
                refreshAutoFundTypeCell(el, result.types);
                refreshAutoFundStatusCell(el, result.status);
            }
        });
    }

    function calltransfertype(el) {
        var $row = rowContext(el);
        var id = $row.find('[name="idno"]').val();
        var typessnew = $row.find('[name="transfertype"]').val();

        window.jQuery.ajax({
            url: '@Url.Action("ChangeStatusAutoCreditDistributorToremTrnasfer", "Home")',
            type: 'POST',
            data: { idno: id, curntsts: typessnew },
            success: function () {
                getdatabyid(el);
            }
        });
    }

    function callstats(el) {
        var $row = rowContext(el);
        var id = $row.find('[name="idno"]').val();
        var Currentstsnew = $row.find('[name="Currentsts"]').val();
        var crntsts = Currentstsnew == 'N' ? 'Y' : 'N';

        window.jQuery.ajax({
            url: '@Url.Action("ChangeStatusAutoCreditDistributorToremTrnasfer", "Home")',
            type: 'POST',
            data: { idno: id, curntsts: crntsts },
            success: function () {
                getdatabyid(el);
            }
        });
    }

    function Edittransferinform(el) {
        var $row = rowContext(el);
        var $ = window.jQuery;

        resetAllAutoFundRowsToView();

        $row.find('[name="minimiumamount"]').val('');
        $row.find('[name="transferamount"]').val('');
        $row.find('[name="totaltransfer"]').val('');
        $row.find('[name="MaxCredit"]').val('');
        $row.find('[name="transfertype"]').val('');
        $row.find('[name="Currentsts"]').val('');

        var id = $row.find('[name="idno"]').val();

        $.ajax({
            url: '@Url.Action("GetAutoTransferAmountDistributorTOrem", "Home")',
            type: 'GET',
            data: { idno: id },
            dataType: 'json',
            success: function (result) {
                datatblbeset(el, result.Transferamount, result.minamount, result.totaltransfer, result.MaxCredit, result.types, result.status);
                setAutoFundRowEditMode($row);
            }
        });
    }

    function Savetransferamnt(el) {
        var $row = rowContext(el);
        var $ = window.jQuery;
        var data = datatblbeGET(el);
        var id = $row.find('[name="idno"]').val();
        var rowId = id;

        $row.find('[data-bind="errormsg_' + rowId + '"]').hide();
        $row.find('[data-bind="errormsg1_' + rowId + '"]').hide();

        var minVal = parseFloat(data.minamount1) || 0;
        var transVal = parseFloat(data.transamnt2) || 0;
        var valid = true;

        if (transVal < 500) {
            $row.find('[data-bind="errormsg1_' + rowId + '"]').show();
            valid = false;
        }
        if (minVal < 500) {
            $row.find('[data-bind="errormsg_' + rowId + '"]').show();
            valid = false;
        }

        if (!valid) { return; }

        $.ajax({
            url: '@Url.Action("SaveautoTransferDistributorToremamount", "Home")',
            type: 'POST',
            data: {
                idno: id,
                transamnt: data.transamnt2,
                minimiumset: data.minamount1,
                countperday: data.countperday3,
                uptolimit: data.uptolimit4
            },
            dataType: 'json',
            success: function (result) {
                $('#spanminimium_' + rowId).text(result.minimiumbal);
                $('#spantransferamnt_' + rowId).text(result.transferamnt);
                $('#spantotaltrans_' + rowId).text(result.daycount);
                $('#spanmaxcredit_' + rowId).text(result.limit);
                resetAutoFundRowView($row);
            }
        });
    }

    function bootDealerAutoFundPage() {
        var $ = window.jQuery;
        if (!$) {
            window.setTimeout(bootDealerAutoFundPage, 50);
            return;
        }

        refreshAutoFundRecordCount();

        $('#myInput').off('keyup.dealerAutoFund').on('keyup.dealerAutoFund', function () {
            var value = $(this).val().toLowerCase();
            $('#body .tr').filter(function () {
                $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
            });
            refreshAutoFundRecordCount();
        });
    }

    if (document.readyState === 'complete') {
        bootDealerAutoFundPage();
    } else {
        window.addEventListener('load', bootDealerAutoFundPage);
    }
</script>

