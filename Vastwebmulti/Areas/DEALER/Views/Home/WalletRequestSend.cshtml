@using Vastwebmulti.Models;
@model Vastwebmulti.Areas.DEALER.ViewModel.FundRequestViewmodel
@{
    ViewBag.Title = "Send";
    Layout = "~/Areas/DEALER/Views/Shared/_Layout.cshtml";
    VastwebmultiEntities DB1 = new VastwebmultiEntities();
    var usernname = DB1.Usernicknames.Where(aa => aa.Role == "master").ToList();
    if (usernname.Count() > 0)
    {
        if (usernname.SingleOrDefault().Role == "master")
        {
            var favimage = usernname.SingleOrDefault().NickName;
            ViewBag.nickname = favimage;
        }
    }
    var nick = (ViewBag.nickname as string);
    if (string.IsNullOrWhiteSpace(nick)) { nick = "Master"; }
}
