@using Vastwebmulti.Models;
@{
    ViewBag.Title = "Notification";
    Layout = "~/Areas/DEALER/Views/Shared/_Layout.cshtml";
    VastwebmultiEntities DB1 = new VastwebmultiEntities();
    var usernname = DB1.Usernicknames.Where(aa => aa.Role == "Retailer").ToList();
    var favimage = "";
    if (usernname.Count() > 0)
    {
        if (usernname.SingleOrDefault().Role == "Retailer")
        {
            favimage = usernname.SingleOrDefault().NickName;
        }
    }
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=15" rel="stylesheet" />
<link href="~/MainFrontDesign/css/dealer-dth-booking-report-modern.css?v=43" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<script>document.body.classList.add('saas-sell-rch-dp-page', 'saas-dealer-notification-page');</script>

<div id="loadermoney" class="vm-dr-notify-loader" style="display:none;" aria-hidden="true"></div>

<section class="content saas-admin-account-page saas-admin-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-dth-booking-report-page saas-dealer-retailer-index-page saas-dealer-notification-page">

    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">
            <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-dr-rem-toolbar-top">
                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>Account Active</li>
                    <li>Notification</li>
                </ol>
            </div>
        </div>

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-bell" aria-hidden="true"></i>
                        <span>Send notification to @favimage</span>
                    </div>
                </div>

                <div class="vm-dr-notify-form-wrap">
                    @using (Html.BeginForm("Send_Notification", "Home", FormMethod.Post, new { id = "dealerNotifyForm", @class = "vm-dr-notify-form" }))
                    {
                        <div class="vm-dr-notify-form-body">
                            <div class="vm-dr-notify-field vm-dr-notify-field--user">
                                <label class="vm-dr-notify-label" for="retailerid">User level</label>
                                <div class="vm-dr-notify-control">
                                    @Html.DropDownList("retailerid", (List<SelectListItem>)ViewBag.allretailer, "Select User", new { id = "retailerid", @class = "form-control vm-opr-select for-select2", data_live_search = "true" })
                                </div>
                            </div>

                            <div class="vm-dr-notify-field vm-dr-notify-field--message">
                                <label class="vm-dr-notify-label" for="txtMsgBody">Message</label>
                                <div class="vm-dr-notify-message-box">
                                    @Html.TextArea("txtMsgBody", "", new { id = "txtMsgBody", onkeyup = "apna(this); vmDrNotifyCountChars(this);", maxlength = 160, @class = "form-control vm-dr-notify-textarea", @placeholder = "Enter message here (max 160 characters)", @required = "" })
                                </div>
                                <div class="vm-dr-notify-meta">
                                    <p class="vm-dr-notify-hint">Maximum 160 characters per notification.</p>
                                    <span class="vm-dr-notify-counter" id="vmDrNotifyCharCount">0 / 160</span>
                                </div>
                            </div>
                        </div>

                        <div class="vm-dr-notify-actions">
                            <button type="submit" id="start_button" class="saas-acc-btn saas-acc-btn--search vm-dr-notify-send-btn btnssl" onclick="verify()" disabled data-loading-text="<i class='fa fa-circle-o-notch fa-spin'></i> Sending">
                                <i class="fas fa-paper-plane" aria-hidden="true"></i>
                                <span>Send notification</span>
                            </button>
                            <button type="reset" id="btn" class="saas-acc-btn saas-acc-btn--outline vm-dr-notify-reset-btn btnssl" data-loading-text="<i class='fa fa-spinner fa-spin'></i>">
                                <i class="fas fa-undo" aria-hidden="true"></i>
                                <span>Reset</span>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</section>

<script src="~/Swalalert/sweetalert-dev.js"></script>
<script src="~/MainFrontDesign/select2/dist/js/select2.full.min.js"></script>

<script>
    $(document).ready(function () {
        var $retailer = $('#retailerid');
        if ($retailer.length && $.fn.select2) {
            if ($retailer.data('select2')) {
                $retailer.select2('destroy');
            }
            $retailer.select2({
                width: '100%',
                minimumResultsForSearch: 0,
                allowClear: true,
                placeholder: 'Select User'
            });
        }

        document.getElementById('loadermoney').style.display = 'none';
        var succ = '@ViewData["success"]';
        if (succ !== '') {
            swal('Send Notification !', succ, 'success');
        }

        $('#dealerNotifyForm').on('reset', function () {
            var bt = document.getElementById('start_button');
            if (bt) {
                bt.disabled = true;
            }
            if ($retailer.length && $.fn.select2) {
                $retailer.val(null).trigger('change');
            }
        });
    });

    function Saveall() {
        document.getElementById('loadermoney').style.display = 'block';
        return true;
    }

    $('.btnssl').on('click', function () {
        var $this = $(this);
        $this.button('loading');
        setTimeout(function () {
            $this.button('reset');
        }, 500);
    });

    function apna(dienb) {
        var bt = document.getElementById('start_button');
        if (!bt) {
            return;
        }
        bt.disabled = !dienb.value || dienb.value.trim() === '';
    }

    function vmDrNotifyCountChars(el) {
        var counter = document.getElementById('vmDrNotifyCharCount');
        if (!counter || !el) {
            return;
        }
        var len = (el.value || '').length;
        counter.textContent = len + ' / 160';
        counter.classList.toggle('is-limit', len >= 160);
    }

    function verify() {
        var msg = document.getElementById('txtMsgBody');
        if (!msg || !msg.value || msg.value.trim() === '') {
            return false;
        }
        document.getElementById('loadermoney').style.display = 'block';
        return true;
    }
</script>
