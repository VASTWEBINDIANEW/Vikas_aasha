        } else {
            for (var i = 0; i < rows.length; i++) {
                var r = rows[i];
                var c = upiStatusColors(r.status);
                var rowBg = (i % 2 === 1) ? '#F8FAFC' : '#FFFFFF';
                html += '<tr>';
                html += '<td bgcolor="' + rowBg + '">' + upiEsc(r.sno) + '</td>';
                html += '<td bgcolor="' + c.bg + '" style="color:' + c.fg + ';font-weight:bold;">' + upiEsc(c.label) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + upiEsc(r.role) + '</td>';
