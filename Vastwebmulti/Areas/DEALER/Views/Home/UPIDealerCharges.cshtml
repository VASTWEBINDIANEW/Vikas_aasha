    function upiEsc(value) {
        return String(value == null ? '' : value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function upiNum(value) {
        var n = parseFloat(String(value || '').replace(/,/g, '').replace(/[^\d.-]/g, ''));
        return isNaN(n) ? 0 : n;
    }

    function upiTableRows() {
        var rows = [];
        $('#upiChargesReport tbody tr.tr').each(function () {
            var $tr = $(this);
            if ($tr.hasClass('vm-dmt-total-row')) {
                return;
            }
            var $cells = $tr.children('td');
            if ($cells.length < 12) {
                return;
            }
            rows.push({
                sno: $.trim($cells.eq(0).text()),
                status: $.trim($cells.eq(1).find('.vm-radiant-status-text').text() || $cells.eq(1).text()).replace(/\s+/g, ' '),
                role: $.trim($cells.eq(2).text()),
                user: $.trim($cells.eq(3).text()),
                payer: $.trim($cells.eq(4).text()),
                remainPre: $.trim($cells.eq(5).text()),
                amount: $.trim($cells.eq(6).text()),
                charge: $.trim($cells.eq(7).text()),
                netPay: $.trim($cells.eq(8).text()),
                remainPost: $.trim($cells.eq(9).text()),
                bankRrn: $.trim($cells.eq(10).text()),
                txnTime: $.trim($cells.eq(11).text())
            });
        });
        return rows;
    }

    function upiStatusColors(status) {
        var raw = String(status || '').toLowerCase();
        if (raw.indexOf('success') >= 0) {
            return { bg: '#ECFDF5', fg: '#047857', badge: 'badge-ok', label: 'Success' };
        }
        if (raw.indexOf('fail') >= 0) {
            return { bg: '#FEE2E2', fg: '#B91C1C', badge: 'badge-fail', label: 'Failed' };
        }
        return { bg: '#FEFCE8', fg: '#854D0E', badge: 'badge-wait', label: 'Pending' };
    }

    function upiExportMeta(rows) {
        var total = 0, success = 0, failed = 0, pending = 0, charge = 0, net = 0;
        for (var i = 0; i < rows.length; i++) {
            var amt = upiNum(rows[i].amount);
            var ch = upiNum(rows[i].charge);
            var np = upiNum(rows[i].netPay);
            var raw = String(rows[i].status || '').toLowerCase();
            total += amt;
            charge += ch;
            net += np;
            if (raw.indexOf('success') >= 0) { success += amt; }
            else if (raw.indexOf('fail') >= 0) { failed += amt; }
            else { pending += amt; }
        }
        return {
            generatedOn: new Date().toLocaleString(),
            frmDate: $('#txt_frm_date').val() || '-',
            toDate: $('#txt_to_date').val() || '-',
            roleFilter: $('#ddlname').val() || 'ALL',
            statusFilter: $('#ddlstatus').val() || 'ALL',
            records: rows.length,
            total: total.toFixed(2),
            success: success.toFixed(2),
            failed: failed.toFixed(2),
            pending: pending.toFixed(2),
            charge: charge.toFixed(2),
            net: net.toFixed(2)
        };
    }

