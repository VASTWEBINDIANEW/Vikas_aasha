    function upiDownloadExcel(html) {
        var blob = new Blob(['\ufeff', html], { type: 'application/vnd.ms-excel' });
        if (window.navigator && window.navigator.msSaveOrOpenBlob) {
            window.navigator.msSaveOrOpenBlob(blob, 'Self_UPI_Payment_Report.xls');
            return;
        }
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'Self_UPI_Payment_Report.xls';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(function () { URL.revokeObjectURL(url); }, 800);
    }

    function upiOpenPdf(html) {
        var w = window.open('', '_blank');
        if (!w) { return; }
        w.document.open();
        w.document.write(html);
        w.document.close();
        w.focus();
    }

    function upiLoadScript(src, done) {
        var s = document.createElement('script');
        s.src = src;
        s.onload = done;
        s.onerror = done;
        document.body.appendChild(s);
    }

    function bootUpiChargesReport() {
        var $ = window.jQuery;
        if (!$ || !$.fn || !$.fn.datepicker) {
            window.setTimeout(bootUpiChargesReport, 50);
            return;
        }

        function afterPlugins() {
            $('.saas-upi-dealer-charges-page .for-select2').each(function () {
                var $el = $(this);
                if ($.fn.select2 && !$el.hasClass('select2-hidden-accessible')) {
                    $el.select2({
                        width: '100%',
                        dropdownParent: $('#dealerUpiChargesForm'),
                        containerCssClass: 'vm-ecom-select2',
                        dropdownCssClass: 'vm-ecom-select2-drop',
                        minimumResultsForSearch: 0
                    });
                }
            });

            $('#ddlname').off('change.upiRole').on('change.upiRole', ddlnamechange);
            ddlnamechange();

            $('#myModal123').off('shown.bs.modal.upiVpa').on('shown.bs.modal.upiVpa', function () {
                initDealerVpaModalControls();
            });

            if (typeof window.initAdminReportDateForm === 'function') {
                window.initAdminReportDateForm('#dealerUpiChargesForm');
            } else {
                $('#txt_frm_date, #txt_to_date').datepicker({
                    format: 'yyyy-mm-dd',
                    todayHighlight: true,
                    autoclose: true,
                    orientation: 'bottom auto',
                    container: 'body'
                });
                if ($('#dealerUpiChargesForm').attr('data-date-mode') !== 'post') {
                    $('#txt_frm_date').datepicker('setDate', new Date());
                    $('#txt_to_date').datepicker('setDate', new Date());
                }
            }

            $('#btnExport').off('click.upiEx').on('click.upiEx', function () {
                upiDownloadExcel(upiBuildExcelHtml(upiTableRows()));
            });
            $('#btnPDF').off('click.upiPdf').on('click.upiPdf', function () {
                upiOpenPdf(upiBuildPdfHtml(upiTableRows()));
            });
        }

        if ($.fn.select2) {
            afterPlugins();
            return;
        }
        upiLoadScript(window.upiSelect2Url, afterPlugins);
    }

    if (document.readyState === 'complete') {
        bootUpiChargesReport();
    } else {
        window.addEventListener('load', bootUpiChargesReport);
    }

    window.onload = function () {
        var message = '@ViewData["successorder"]';
        if (message !== '' && message != null) {
            swal('Good job!', message, 'success');
        }
        var errormessage = '@ViewData["failedorder"]';
        if (errormessage !== '' && errormessage != null) {
            swal('Oops!', errormessage, 'error');
        }
        var data = '@ViewData["show"]';
        if (data !== '') {
            sweetAlert('Oops...', data, 'error');
        }
        var msg = '@TempData["msgupi"]';
        if (msg !== '') {
            sweetAlert('Oops...', msg, 'error');
        }
        var msgSucc = '@TempData["msgupisucc"]';
        if (msgSucc !== '') {
            swal('Success', 'Pending To Success', 'success');
        }
    };
