        var m = upiExportMeta(rows);
        var html = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel"><head><meta charset="utf-8" /><title>Self UPI Payment Report</title></head><body>';
        html += '<table border="1" cellspacing="0" cellpadding="6" style="border-collapse:collapse;">';
        html += '<tr><td colspan="12" bgcolor="#2563EB" style="color:#FFFFFF;font-size:16pt;font-weight:bold;">Self UPI Payment Report</td></tr>';
        html += '<tr><td bgcolor="#F1F5F9" style="font-weight:bold;">From</td><td style="font-weight:bold;">' + upiEsc(m.frmDate) + '</td>';
        html += '<td bgcolor="#F1F5F9" style="font-weight:bold;">To</td><td style="font-weight:bold;">' + upiEsc(m.toDate) + '</td>';
        html += '<td bgcolor="#F1F5F9" style="font-weight:bold;">Role</td><td style="font-weight:bold;">' + upiEsc(m.roleFilter) + '</td>';
        html += '<td bgcolor="#F1F5F9" style="font-weight:bold;">Status</td><td style="font-weight:bold;">' + upiEsc(m.statusFilter) + '</td>';
        html += '<td bgcolor="#F1F5F9" style="font-weight:bold;">Records</td><td colspan="3" style="font-weight:bold;">' + m.records + '</td></tr>';
        html += '<tr><td bgcolor="#EEF2FF" style="font-weight:bold;">Total</td><td style="font-weight:bold;">' + m.total + '</td>';
        html += '<td bgcolor="#ECFDF5" style="font-weight:bold;color:#047857;">Success</td><td style="font-weight:bold;color:#047857;">' + m.success + '</td>';
        html += '<td bgcolor="#FEF2F2" style="font-weight:bold;color:#B91C1C;">Failed</td><td style="font-weight:bold;color:#B91C1C;">' + m.failed + '</td>';
        html += '<td bgcolor="#FEFCE8" style="font-weight:bold;color:#854D0E;">Pending</td><td style="font-weight:bold;color:#854D0E;">' + m.pending + '</td>';
