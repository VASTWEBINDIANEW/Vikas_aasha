                <input type="hidden" id="hideupiid" />
                <input type="hidden" id="hidemin" />
                <input type="hidden" id="hidemax" />
                <input type="hidden" id="hidddlpaymenttype" />
                <div id="RemTbl222">
                    @Html.Partial("_VPAsetDealer_SelfList")
                </div>
            </div>
            <div class="modal-footer saas-admin-modal-footer">
                <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal">
                    <i class="fas fa-times" aria-hidden="true"></i> Close
                </button>
            </div>
        </div>
    </div>
</div>

<script src="~/MainFrontDesign/js/admin-report-datepicker.js?v=3"></script>
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    window.upiSelect2Url = '@Url.Content("~/MainFrontDesign/select2/dist/js/select2.full.min.js")';

    function initUpiRetailerSelect2() {
        var $ = window.jQuery;
        var $retailer = $('#Retailerid');
        if (!$retailer.length || !$.fn.select2) {
            return;
        }
        if ($retailer.hasClass('select2-hidden-accessible')) {
            $retailer.select2('destroy');
        }
        $retailer.select2({
            width: '100%',
            dropdownParent: $('#dealerUpiChargesForm'),
            containerCssClass: 'vm-ecom-select2',
            dropdownCssClass: 'vm-ecom-select2-drop',
            minimumResultsForSearch: 0,
            placeholder: 'Select Retailer'
        });
    }

    function ddlnamechange() {
        var $ = window.jQuery;
        var selectname = $('#ddlname').val();
        var $retailerWrap = $('#drpretailer');
        if (selectname === 'Retailer') {
            $retailerWrap.removeClass('vm-upi-retailer-field--hidden');
            initUpiRetailerSelect2();
        } else {
            $retailerWrap.addClass('vm-upi-retailer-field--hidden');
            var $retailer = $('#Retailerid');
            if ($retailer.hasClass('select2-hidden-accessible')) {
                $retailer.val('').trigger('change.select2');
                $retailer.select2('destroy');
            } else {
                $retailer.val('');
            }
        }
    }

