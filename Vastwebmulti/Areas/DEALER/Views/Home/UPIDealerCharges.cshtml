                        <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal">
                            <i class="fas fa-times" aria-hidden="true"></i> Close
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade saas-admin-modal vm-dmt-modal vm-upi-vpa-modal" id="myModal123" tabindex="-1" role="dialog" aria-labelledby="upiVpaModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header saas-admin-modal-header accent-violet">
                <div class="saas-admin-modal-head-main">
                    <div class="saas-admin-modal-icon"><i class="fas fa-id-card" aria-hidden="true"></i></div>
                    <div class="saas-admin-modal-title-wrap">
                        <h4 class="modal-title saas-admin-modal-title" id="upiVpaModalTitle">VPA Details</h4>
