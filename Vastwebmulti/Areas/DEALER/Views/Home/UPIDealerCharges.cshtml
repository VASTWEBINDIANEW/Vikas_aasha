@model Vastwebmulti.Areas.ADMIN.Models.upiChargeAndgateway
@using System.Linq
@{
    ViewBag.Title = "Self UPI Payment";
    Layout = "~/Areas/DEALER/Views/Shared/_Layout.cshtml";

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var selectedRole = (ViewBag.ddlname as string) ?? (Request["ddlname"] ?? "ALL");
    var selectedRetailer = (Request["Retailerid"] ?? "").Trim();
    var selectedStatus = (ViewBag.ddlstatus as string) ?? (Request["ddlstatus"] ?? "ALL");
    if (string.IsNullOrEmpty(selectedStatus)) { selectedStatus = "ALL"; }
    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";

    var reports = Model.UPIREPORT ?? Enumerable.Empty<Vastwebmulti.Models.show_upi_txn_details_Result>();

    Func<Vastwebmulti.Models.show_upi_txn_details_Result, bool> isSuccess = x =>
        !string.IsNullOrEmpty(x.status) && x.status.IndexOf("SUCCESS", StringComparison.OrdinalIgnoreCase) >= 0;
    Func<Vastwebmulti.Models.show_upi_txn_details_Result, bool> isFailed = x =>
        !string.IsNullOrEmpty(x.status) && x.status.IndexOf("FAILED", StringComparison.OrdinalIgnoreCase) >= 0;
    Func<Vastwebmulti.Models.show_upi_txn_details_Result, bool> isPending = x =>
        !string.IsNullOrEmpty(x.status) && x.status.IndexOf("PENDING", StringComparison.OrdinalIgnoreCase) >= 0;

    var totalAmount = reports.Sum(x => x.amt ?? 0m);
    var totalNet = reports.Sum(x => x.finalpay ?? 0m);
    var totalCharge = reports.Sum(x => x.charge ?? 0m);
    var totalSuccess = reports.Where(isSuccess).Sum(x => x.amt ?? 0m);
    var totalFailed = reports.Where(isFailed).Sum(x => x.amt ?? 0m);
    var totalPending = reports.Where(isPending).Sum(x => x.amt ?? 0m);
    var rowIndex = 0;
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=15" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/dealer-dth-booking-report-modern.css?v=22" rel="stylesheet" />
<script>document.body.classList.add('saas-sell-rch-dp-page');</script>

<div id="loadermoney" class="vm-dmt-loader" style="display:none;"></div>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-dth-booking-report-page saas-sell-recharge-report-page saas-ecommerce-report-page saas-giftcard-report-page saas-upi-dealer-charges-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var upiFormAttrs = new Dictionary<string, object>
            {
                { "id", "dealerUpiChargesForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("UPIDealerCharges", "Home", FormMethod.Post, upiFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Reports</li>
                        <li>Self UPI Payment</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters">

                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("ddlname", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "All Roles", Value = "ALL", Selected = selectedRole == "ALL" },
                                new SelectListItem { Text = "Retailer", Value = "Retailer", Selected = selectedRole == "Retailer" }
                            }, new { id = "ddlname", @class = "vm-opr-select vm-dmt-select form-control for-select2", @title = "Role", data_live_search = "true", onchange = "ddlnamechange()" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-upi-retailer-field@(selectedRole == "Retailer" ? "" : " vm-upi-retailer-field--hidden")" id="drpretailer">
                            @{
                                var retailerItems = ViewBag.Retailerid as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
                            }
                            @Html.DropDownList("Retailerid", new SelectList(retailerItems, "Value", "Text", selectedRetailer), "Select Retailer", new { id = "Retailerid", @class = "vm-opr-select vm-dmt-select form-control for-select2-retailer", @title = "Retailer", data_live_search = "true" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-radiant-field--status">
                            @Html.DropDownList("ddlstatus", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "All Status", Value = "ALL", Selected = selectedStatus == "ALL" },
                                new SelectListItem { Text = "Pending", Value = "Pending", Selected = selectedStatus == "Pending" },
                                new SelectListItem { Text = "Success", Value = "Success", Selected = selectedStatus == "Success" },
                                new SelectListItem { Text = "Failed", Value = "Failed", Selected = selectedStatus == "Failed" }
                            }, new { id = "ddlstatus", @class = "vm-opr-select vm-dmt-select form-control for-select2", @title = "Status", data_live_search = "true" })
                        </div>

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="upiChargesTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Self UPI totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideUpiChargesTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--primary">
                            <span class="vm-opr-total-card__label">Total Amount</span>
                            <strong class="vm-opr-total-card__value">@totalAmount.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Success</span>
                            <strong class="vm-opr-total-card__value">@totalSuccess.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Failed</span>
                            <strong class="vm-opr-total-card__value">@totalFailed.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Pending</span>
                            <strong class="vm-opr-total-card__value">@totalPending.ToString("N2")</strong>
                        </div>
                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-qrcode" aria-hidden="true"></i>
                        <span>Self UPI payment report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <div class="vm-ft-search-wrap vm-upi-table-search">
                            <input class="form-control" type="text" id="myInput" placeholder="Search report..." autocomplete="off" onkeyup="upiChargesSearch()" />
                        </div>
                        <span class="vm-radiant-inline-total" title="Total amount for current filter">
                            Total: <strong>&#8377; @totalAmount.ToString("N2")</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="saas-acc-btn saas-acc-btn--ghost vm-upi-vpa-btn" data-toggle="modal" data-target="#myModal123" title="Add VPA Details">
                                <i class="fas fa-cog" aria-hidden="true"></i> VPA Details
                            </button>
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-radiant-totals-btn vm-sell-rch-totals-btn vm-ecom-totals-btn vm-upi-totals-btn" onclick="toggleUpiChargesTotals()" title="Show totals" aria-expanded="false" aria-controls="upiChargesTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="upiChargesReport" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>S.No</th>
                                    <th>Status</th>
                                    <th>Role</th>
                                    <th>User</th>
                                    <th>Payer&nbsp;Name</th>
                                    <th>Remain&nbsp;Pre</th>
                                    <th>Amount</th>
                                    <th>Charges</th>
                                    <th>Net&nbsp;Pay</th>
                                    <th>Remain&nbsp;Post</th>
                                    <th>Bank RRN</th>
                                    <th>Transaction&nbsp;Time</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (reports.Any())
                                {
                                    foreach (var item in reports)
                                    {
                                        rowIndex++;
                                        var frmname = string.IsNullOrWhiteSpace(item.Frm_Name) ? item.RetailerName : item.Frm_Name;
                                        var statusRaw = item.status ?? "";
                                        var statusTone = "pending";
                                        var statusFa = "fa-clock-o";
                                        var statusLabel = string.IsNullOrWhiteSpace(statusRaw) ? "-" : statusRaw;
                                        if (statusRaw.IndexOf("SUCCESS", StringComparison.OrdinalIgnoreCase) >= 0)
                                        {
                                            statusTone = "success";
                                            statusFa = "fa-check";
                                            statusLabel = "Success";
                                        }
                                        else if (statusRaw.IndexOf("FAILED", StringComparison.OrdinalIgnoreCase) >= 0)
                                        {
                                            statusTone = "failed";
                                            statusFa = "fa-times";
                                            statusLabel = "Failed";
                                        }
                                        else if (statusRaw.IndexOf("PENDING", StringComparison.OrdinalIgnoreCase) >= 0)
                                        {
                                            statusTone = "pending";
                                            statusFa = "fa-clock-o";
                                            statusLabel = "Pending";
                                        }
                                        var txnDate = item.txndate.HasValue ? item.txndate.Value.ToString("dd-MMM-yyyy HH:mm:ss") : "-";
                                        <tr class="vm-dmt-row vm-dmt-row--@statusTone tr" data-status="@statusRaw">
                                            <td>@rowIndex</td>
                                            <td class="vm-radiant-status-cell vm-ticket-status-cell">
                                                <span class="vm-dmt-status vm-dmt-status--@statusTone" title="@statusLabel">
                                                    <i class="fa @statusFa" aria-hidden="true"></i>
                                                </span>
                                                <span class="vm-radiant-status-text">@statusLabel</span>
                                            </td>
                                            <td>@(item.rolename ?? "-")</td>
                                            <td>@(frmname ?? "-")</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.PayerName) ? "-" : item.PayerName)</td>
                                            <td class="vm-dmt-amt-cell">@(item.remainpre.HasValue ? item.remainpre.Value.ToString("N2") : "-")</td>
                                            <td class="vm-dmt-amt-cell">@(item.amt.HasValue ? item.amt.Value.ToString("N2") : "-")</td>
                                            <td class="vm-dmt-amt-cell">@(item.charge.HasValue ? item.charge.Value.ToString("N2") : "-")</td>
                                            <td class="vm-dmt-amt-cell">@(item.finalpay.HasValue ? item.finalpay.Value.ToString("N2") : "-")</td>
                                            <td class="vm-dmt-amt-cell">@(item.remainpost.HasValue ? item.remainpost.Value.ToString("N2") : "-")</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.BankRRN) ? "-" : item.BankRRN)</td>
                                            <td>@txnDate</td>
                                            <td class="vm-dmt-action-cell">
                                                @if (statusRaw.IndexOf("PENDING", StringComparison.OrdinalIgnoreCase) >= 0)
                                                {
                                                    <button type="button" class="vm-opr-icon-btn vm-upi-action-btn vm-upi-action-btn--ok" data-toggle="modal" data-target="#myModalUPITXN" onclick="UPIRESPONSEsss('APPROVED', '@item.idno','@frmname' ,'@txnDate', '@item.amt')" title="Approve">
                                                        <i class="fa fa-check" aria-hidden="true"></i>
                                                    </button>
                                                    <button type="button" class="vm-opr-icon-btn vm-upi-action-btn vm-upi-action-btn--fail" data-toggle="modal" data-target="#myModalUPITXN" onclick="UPIRESPONSEsss('REJECTED', '@item.idno','@frmname','@txnDate' ,'@item.amt')" title="Reject">
                                                        <i class="fa fa-times" aria-hidden="true"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span>-</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                    <tr class="vm-dmt-total-row tr">
                                        <td colspan="6"><strong>Total</strong></td>
                                        <td class="vm-dmt-amt-cell"><strong>@totalAmount.ToString("N2")</strong></td>
                                        <td class="vm-dmt-amt-cell"><strong>@totalCharge.ToString("N2")</strong></td>
                                        <td class="vm-dmt-amt-cell"><strong>@totalNet.ToString("N2")</strong></td>
                                        <td colspan="4"></td>
                                    </tr>
                                }
                                else
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="13" class="vm-opr-table-empty vm-dmt-table-empty">
                                            <i class="fas fa-qrcode" aria-hidden="true"></i>
                                            <span>Self UPI transaction not found.</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@if (!string.IsNullOrWhiteSpace(Model.msg))
{
    <div class="vm-upi-page-msg">@Model.msg</div>
}

<div class="modal fade saas-admin-modal vm-dmt-modal vm-upi-txn-modal" id="myModalUPITXN" tabindex="-1" role="dialog" aria-labelledby="upiTxnModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header saas-admin-modal-header accent-blue">
                <div class="saas-admin-modal-head-main">
                    <div class="saas-admin-modal-icon"><i class="fas fa-exchange-alt" aria-hidden="true"></i></div>
                    <div class="saas-admin-modal-title-wrap">
                        <h4 class="modal-title saas-admin-modal-title" id="upiTxnModalTitle">Confirm Transaction</h4>
                        <span class="saas-admin-modal-subtitle">Approve or reject pending UPI transaction</span>
                    </div>
                </div>
                <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close">
                    <i class="fas fa-times" aria-hidden="true"></i>
                </button>
            </div>
            <div class="modal-body saas-admin-modal-body">
