                        <span class="vm-radiant-inline-total" title="Total users">
                            Total: <strong id="activeUserTotalCount">—</strong>
                        </span>
                    </div>

                </div>

            </div>

        </div>

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-users" aria-hidden="true"></i>
                        <span>User's book — active / inactive</span>
                    </div>
                </div>

                <div class="vm-opr-table-wrap vm-active-user-wrap">
                    <div class="vm-active-user-grid">
                        <div class="vm-active-user-card vm-active-user-card--active">
                            <div class="vm-active-user-card__top">
                                <span class="vm-active-user-card__icon"><i class="fas fa-user-check" aria-hidden="true"></i></span>
                                <div class="vm-active-user-card__head">
                                    <span class="vm-active-user-card__label">Active Users</span>
                                    <strong class="vm-active-user-card__value" id="active-userid">—</strong>
                                </div>
                                <span class="vm-active-user-card__chip" id="activeUserShare">—</span>
                            </div>
                            <div class="vm-active-user-card__bar"><span id="activeUserBar" style="width:0%"></span></div>
                            <span class="vm-active-user-card__foot">Share of total users</span>
                        </div>
                        <div class="vm-active-user-card vm-active-user-card--inactive">
                            <div class="vm-active-user-card__top">
                                <span class="vm-active-user-card__icon"><i class="fas fa-user-slash" aria-hidden="true"></i></span>
                                <div class="vm-active-user-card__head">
                                    <span class="vm-active-user-card__label">Inactive Users</span>
                                    <strong class="vm-active-user-card__value" id="inactiveuserid">—</strong>
                                </div>
                                <span class="vm-active-user-card__chip" id="inactiveUserShare">—</span>
                            </div>
                            <div class="vm-active-user-card__bar"><span id="inactiveUserBar" style="width:0%"></span></div>
                            <span class="vm-active-user-card__foot">Share of total users</span>
                        </div>
                    </div>
                    <div class="vm-opr-table-empty vm-active-user-error" id="activeUserError" style="display:none;">Could not load user counts. Please refresh the page.</div>
                </div>
            </div>
        </div>

    </div>
</section>

<script>
    function activeinactive() {
        var $ = window.jQuery;
        if (!$) {
            window.setTimeout(activeinactive, 50);
            return;
        }
        //call ajax
        $.ajax({
            url: '@Url.Action("Show_All_ActiveandInactive_user", "Home")',
            type: 'POST',
            dataType: "html",
            success: function (data) {
                var x = JSON.parse(data);
                var active = x.Reatileractive;
                var inactive = x.Retailerinactive;
                $('#active-userid').text(active);
                $('#inactiveuserid').text(inactive);
                var activeNum = parseFloat(active) || 0;
                var inactiveNum = parseFloat(inactive) || 0;
                var total = activeNum + inactiveNum;
                $('#activeUserTotalCount').text(total);
                var activeShare = total > 0 ? Math.round((activeNum / total) * 100) : 0;
                var inactiveShare = total > 0 ? (100 - activeShare) : 0;
                $('#activeUserShare').text(activeShare + '%');
                $('#inactiveUserShare').text(inactiveShare + '%');
                $('#activeUserBar').css('width', activeShare + '%');
                $('#inactiveUserBar').css('width', inactiveShare + '%');
                $('#activeUserError').hide();
            },
            error: function () {
                $('#activeUserError').show();
            }
        });
    }

    if (document.readyState === 'complete') {
        activeinactive();
    } else if (window.addEventListener) {
        window.addEventListener('load', activeinactive);
    } else {
        $(window).on('load', function () {
            activeinactive();
        });
    }
</script>

