@model IEnumerable<Vastwebmulti.Models.Failed_Login_info>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Web Login Failed";
    Layout = "~/Areas/DEALER/Views/Shared/_Layout.cshtml";

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
    var rows = Model ?? Enumerable.Empty<Vastwebmulti.Models.Failed_Login_info>();
    var rowList = rows.ToList();
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=15" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/dealer-dth-booking-report-modern.css?v=47" rel="stylesheet" />
<script>document.body.classList.add('saas-sell-rch-dp-page', 'saas-dealer-weblogin-page', 'saas-dealer-weblogin-failed-page');</script>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-dth-booking-report-page saas-sell-recharge-report-page saas-ecommerce-report-page saas-dealer-weblogin-page saas-dealer-weblogin-failed-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var webLoginFailedFormAttrs = new Dictionary<string, object>
            {
                { "id", "dealerWebLoginFailedForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("WebLoginFailed", "Home", FormMethod.Post, webLoginFailedFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Account Active</li>
                        <li>Web Login Failed</li>
                    </ol>

                    <nav class="vm-dr-weblogin-nav" aria-label="Web login type">
                        <a class="vm-dr-weblogin-nav__link" href="@Url.Action("WebLogin", "Home")">
                            <i class="fas fa-check-circle" aria-hidden="true"></i>
                            <span>Web Success Login</span>
                        </a>
                        <a class="vm-dr-weblogin-nav__link is-active" href="@Url.Action("WebLoginFailed", "Home")">
                            <i class="fas fa-times-circle" aria-hidden="true"></i>
                            <span>Web Failed Login</span>
                        </a>
                    </nav>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters">

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-user-lock" aria-hidden="true"></i>
                        <span>Web failed login</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <div class="vm-ft-search-wrap vm-sell-rch-table-search">
                            <input class="form-control vm-sell-rch-search-input" type="text" id="dealerWebLoginFailedSearch" placeholder="Search failed login records..." autocomplete="off" />
                        </div>
                        <span class="vm-radiant-inline-total" title="Records in current view">
                            Records: <strong id="dealerWebLoginFailedCount">@rowList.Count</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" id="btnExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="dealerWebLoginFailedTable" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Sr.&nbsp;No.</th>
                                    <th>Registered&nbsp;User&nbsp;ID</th>
                                    <th>Password</th>
                                    <th>IP&nbsp;Address</th>
                                    <th>Browser</th>
                                    <th>Login&nbsp;Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!rowList.Any())
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="6">No failed login records found for the selected date range.</td>
                                    </tr>
                                }
                                else
                                {
                                    var i = 1;
                                    foreach (var item in rowList)
                                    {
                                        <tr>
                                            <td>@i</td>
                                            <td>@(item.EmailId ?? "—")</td>
                                            <td>@(item.pwd ?? "—")</td>
                                            <td>@(item.IP_Address ?? "—")</td>
                                            <td>@(item.browser ?? "—")</td>
                                            <td>@(item.LoginTime.HasValue ? item.LoginTime.Value.ToString("dd-MM-yyyy HH:mm:ss") : "—")</td>
                                        </tr>
                                        i++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<script src="~/MainFrontDesign/js/admin-report-datepicker.js?v=3"></script>
<script src="~/MainFrontDesign/js/dealer-weblogin-export.js?v=1"></script>
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    function dealerWebLoginFailedSearch() {
        var $ = window.jQuery;
        if (!$) { return; }
        var value = ($('#dealerWebLoginFailedSearch').val() || '').toLowerCase();
        var visible = 0;
        $('#dealerWebLoginFailedTable tbody tr').each(function () {
            var $tr = $(this);
            if ($tr.hasClass('vm-opr-table-empty-row')) {
                $tr.toggle(!value);
                if (!value) { visible = 0; }
                return;
            }
            var show = $tr.text().toLowerCase().indexOf(value) > -1;
            $tr.toggle(show);
            if (show) { visible++; }
        });
        $('#dealerWebLoginFailedCount').text(visible);
    }

    function dealerWebLoginFailedEsc(value) {
        return String(value == null ? '' : value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function dealerWebLoginFailedTableRows() {
        var $ = window.jQuery;
        var rows = [];
        $('#dealerWebLoginFailedTable tbody tr').each(function () {
            var $tr = $(this);
            if ($tr.hasClass('vm-opr-table-empty-row') || !$tr.is(':visible')) {
                return;
            }
            var $cells = $tr.children('td');
            if ($cells.length < 6) {
                return;
            }
            rows.push({
                sr: $.trim($cells.eq(0).text()),
                emailId: $.trim($cells.eq(1).text()),
                password: $.trim($cells.eq(2).text()),
                ip: $.trim($cells.eq(3).text()),
                browser: $.trim($cells.eq(4).text()),
                loginTime: $.trim($cells.eq(5).text())
            });
        });
        return rows;
    }

    function dealerWebLoginFailedExportHeads() {
        return ['Sr. No.', 'Registered User ID', 'Password', 'IP Address', 'Browser', 'Login Date'];
    }

    function dealerWebLoginFailedBodyRows(rows) {
        var out = [];
        for (var i = 0; i < rows.length; i++) {
            var r = rows[i];
            out.push([r.sr, r.emailId, r.password, r.ip, r.browser, r.loginTime]);
        }
        return out;
    }

    function dealerWebLoginFailedRunExport(kind) {
        var exp = window.vmDealerWebLoginExport;
        if (!exp) {
            return;
        }
        var rows = dealerWebLoginFailedTableRows();
        if (!rows.length) {
            exp.warn('No records to export');
            return;
        }
        var opts = {
            theme: 'failed',
            title: 'Web Failed Login',
            heads: dealerWebLoginFailedExportHeads(),
            bodyRows: dealerWebLoginFailedBodyRows(rows),
            meta: exp.collectMeta('txt_frm_date', 'txt_to_date', 'dealerWebLoginFailedSearch', rows)
        };
        if (kind === 'excel') {
            exp.downloadExcel(exp.buildExcel(opts), 'Web_Failed_Login.xls');
            return;
        }
        exp.openPdf(exp.buildPdf(opts));
    }

    function bootDealerWebLoginFailedPage() {
        var $ = window.jQuery;
        if (!$ || !$.fn || !$.fn.datepicker) {
            window.setTimeout(bootDealerWebLoginFailedPage, 50);
            return;
        }

        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm('#dealerWebLoginFailedForm');
        } else {
            $('#txt_frm_date, #txt_to_date').datepicker({
                format: 'yyyy-mm-dd',
                todayHighlight: true,
                autoclose: true,
                orientation: 'bottom auto',
                container: 'body'
            });
            if ($('#dealerWebLoginFailedForm').attr('data-date-mode') !== 'post') {
                $('#txt_frm_date').datepicker('setDate', new Date());
                $('#txt_to_date').datepicker('setDate', new Date());
            }
        }

        function pinWebLoginFailedDatepicker(e) {
            if (typeof window.repositionAdminDatepickerForMobile === 'function') {
                window.repositionAdminDatepickerForMobile(e && e.target ? e.target : this);
            }
        }

        $(document).off('show.webLoginFailedDp shown.webLoginFailedDp').on('show.webLoginFailedDp shown.webLoginFailedDp', '#txt_frm_date, #txt_to_date', pinWebLoginFailedDatepicker);
        $(window).off('resize.webLoginFailedDp orientationchange.webLoginFailedDp').on('resize.webLoginFailedDp orientationchange.webLoginFailedDp', pinWebLoginFailedDatepicker);

        $('#dealerWebLoginFailedSearch').off('input.webLoginFailed keyup.webLoginFailed').on('input.webLoginFailed keyup.webLoginFailed', dealerWebLoginFailedSearch);

        $('#btnExport').off('click.webLoginFailedEx').on('click.webLoginFailedEx', function () {
            dealerWebLoginFailedRunExport('excel');
        });

        $('#btnPDF').off('click.webLoginFailedPdf').on('click.webLoginFailedPdf', function () {
            dealerWebLoginFailedRunExport('pdf');
        });
    }

    if (document.readyState === 'complete') {
        bootDealerWebLoginFailedPage();
    } else {
        window.addEventListener('load', bootDealerWebLoginFailedPage);
    }
</script>
