<script src="~/MainFrontDesign/js/admin-report-datepicker.js?v=3"></script>
<script src="~/Swalalert/sweetalert-dev.js"></script>
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />

<script>
    window.dealerGatewayExcelUrl = '@Url.Action("Execel_Gateway_TRANSFER", "Home")';
    window.dealerGatewayPdfUrl = '@Url.Action("PDFGatewayTRANSFER", "Home")';

    function gatewayHistorySearch() {
        var value = ($('#myInput').val() || '').toLowerCase();
        $('#tblGatewayHistory tbody tr.tr').filter(function () {
            $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
        });
    }

    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57)) {
            return false;
        }
        return true;
    }

    function proceed() {
        if ($('#txtamt').val() === '') {
            $('#txtmsgerror').text('Amount Not Blank');
            return;
        }
        if ($('#ddl_type').val() === '' || $('#ddl_type').val() === null) {
            $('#txtmsgerror').text('Select Any Type');
            return;
        }

        $('#txtmsgerror').text('');
        $.ajax({
            url: '@Url.Action("calculatecharge_gateway", "Home")',
            type: 'GET',
            dataType: 'json',
            data: { amount: $('#txtamt').val(), type: $('#ddl_type').val() },
            success: function (response) {
                if (response.status) {
                    $('#showdata').show();
                    $('#showdata').find('table').empty();
                    document.getElementById('showdata').querySelector('table').appendChild(
                        tableCreate($('#txtamt').val(), response.cols, response.values, $('#ddl_type').val())
                    );
                    $('#txtamt').prop('readonly', true);
                    $('#ddl_type').prop('disabled', true).trigger('change.select2');
                    $('.vm-gw-proceed-btn').hide();
                    $('.vm-gw-change-btn').show();
                } else {
                    $('#showdata').hide();
                    $('#txtmsgerror').text('Charge Not Set');
                }
            }
        });
    }

    function tableCreate(amount, columns, row, type) {
        type = type || null;
        var tbl = document.createElement('table');
        tbl.style.width = '100%';
        var tr = tbl.insertRow();
        var tr1 = tbl.insertRow();
        var tr2 = tbl.insertRow();

        for (var i = 0; i < columns.length; i++) {
            var td1 = tr.insertCell();
            td1.style.border = '1px solid #e2e8f0';
            td1.style.backgroundColor = '#eff6ff';
            td1.style.textAlign = 'center';
            var col_name = typeof columns[i] === 'string' ? columns[i] : columns[i].text;
            td1.appendChild(document.createTextNode(col_name));

            if (columns[i].cols) {
                if (Array.isArray(columns[i].cols)) {
                    td1.setAttribute('colSpan', columns[i].cols.length.toString());
                    for (var j = 0; j < columns[i].cols.length; j++) {
                        var td = tr1.insertCell();
                        if (typeof columns[i].cols[j] === 'string') {
                            if (!(type === 'DC' && col_name === 'RUPAY')) {
                                if (type !== 'NB') {
                                    tr2.insertCell();
                                }
                            } else {
                                td.setAttribute('rowSpan', 2);
                            }
                            td.appendChild(document.createTextNode(ucFirst(columns[i].cols[j])));
                        } else {
                            var cols3 = columns[i].cols[j].cols;
                            td.setAttribute('colSpan', cols3.length.toString());
                            td1.setAttribute('colSpan', (2 * cols3.length).toString());
                            td.appendChild(document.createTextNode(ucFirst(columns[i].cols[j].text)));
                            for (var k = 0; k < cols3.length; k++) {
                                var td3 = tr2.insertCell();
                                td3.appendChild(document.createTextNode(ucFirst(cols3[k])));
                            }
                        }
                        td.style.border = '1px solid #e2e8f0';
                        td.style.backgroundColor = '#eff6ff';
                        td.style.textAlign = 'center';
                        td.style.fontSize = '11px';
                    }
                }
            }
        }

        var merged_array = [].concat.apply([], [].concat.apply([], row));
        var tr_val = tbl.insertRow();
        for (var m = 0; m < merged_array.length; m++) {
            var tdCell = tr_val.insertCell();
            tdCell.style.border = '1px solid #e2e8f0';
            tdCell.style.textAlign = 'center';
            tdCell.style.fontSize = '11px';
            if (m > 0) {
                tdCell.appendChild(document.createTextNode(parseFloat(merged_array[m]).toFixed(2)));
            } else {
                var img = document.createElement('img');
                img.src = merged_array[m] ? '../../ashok-images/correct.svg' : '../../ashok-images/closes.svg';
                img.style.width = '12px';
                img.style.borderRadius = '99px';
                img.style.backgroundColor = merged_array[m] ? 'green' : 'red';
                var span = document.createElement('small');
                span.textContent = amount;
                span.style.fontSize = '11px';
                span.style.marginLeft = '3px';
                tdCell.appendChild(img);
                tdCell.appendChild(span);
            }
        }
        tbl.style.margin = '12px 0';
        return tbl;
    }

    function ucFirst(string) {
        return string.charAt(0).toUpperCase() + string.slice(1);
    }

    $(document).ready(function () {
        if (typeof window.initDealerFundTransferPageSelect2 === 'function') {
            window.initDealerFundTransferPageSelect2($('#ddl_type'));
        }

        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm('#gatewayHistoryForm');
        } else if ($.fn.datepicker) {
            var dateOpts = {
                format: 'yyyy-mm-dd',
                todayHighlight: true,
                autoclose: true,
                orientation: 'bottom auto',
                forceParse: false,
                enableOnReadonly: true,
                container: 'body'
            };
            $('#txt_frm_date, #txt_to_date').datepicker(dateOpts);
            if ('@dateMode' !== 'post') {
                $('#txt_frm_date').datepicker('setDate', new Date());
                $('#txt_to_date').datepicker('setDate', new Date());
            }
        }

        $('#btnGatewayChange').on('click', function () {
            $(this).hide();
            $('#showdata').hide();
            $('.vm-gw-proceed-btn').show();
            $('#txtamt').prop('readonly', false);
            $('#ddl_type').prop('disabled', false).trigger('change.select2');
            $('#txtmsgerror').text('');
        });

        $('#gatewayPayForm').on('submit', function () {
            $('#ddl_type').prop('disabled', false);
        });

        $('#btnExport').on('click', function (e) {
            e.preventDefault();
            var url = window.dealerGatewayExcelUrl
                + '?txt_frm_date=' + encodeURIComponent($('#txt_frm_date').val() || '')
                + '&txt_to_date=' + encodeURIComponent($('#txt_to_date').val() || '');
            window.location.href = url;
        });

        $('#btnPDF').on('click', function () {
            var url = window.dealerGatewayPdfUrl
                + '?txt_frm_date=' + encodeURIComponent($('#txt_frm_date').val() || '')
                + '&txt_to_date=' + encodeURIComponent($('#txt_to_date').val() || '');
            window.open(url, '_blank');
        });
    });
</script>
