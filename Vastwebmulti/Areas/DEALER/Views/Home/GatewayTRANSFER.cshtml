                                    <tbody id="tblbody">
                                        @if (reports.Any())
                                        {
                                            foreach (var item in reports)
                                            {
                                                var sts = item.status;
                                                var bankrrn = item.errormsg;
                                                var code = "";
                                                var color = "";
                                                var margin = "";
                                                var padding = "";
                                                var width = "20px";
                                                if (sts == "Success")
                                                {
                                                    code = "../../ashok-images/correct.svg";
                                                    bankrrn = item.bankrrnno;
                                                    color = "green";
                                                }
                                                else if (sts == "Failed")
                                                {
                                                    code = "../../ashok-images/closes.svg";
                                                    color = "red";
                                                }
                                                else
                                                {
                                                    code = "../../ashok-images/clock.svg";
                                                    width = "21px";
                                                    margin = "0";
                                                    padding = "0";
                                                }
                                                <tr class="tr">
                                                    <td>
                                                        <span class="vm-gw-mode-cell">
