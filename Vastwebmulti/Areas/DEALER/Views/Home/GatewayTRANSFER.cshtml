                            <div class="vm-ft-table-wrap table-responsive">
                                <table id="tblGatewayHistory" class="table table-bordered table-striped table-hover fundtransfer-tableclass third-design-table vm-ft-table">
                                    <thead>
                                        <tr>
                                            <th>Mode</th>
                                            <th>Mode&nbsp;Type</th>
                                            <th>Amount</th>
                                            <th>Charges</th>
                                            <th>Net&nbsp;Received</th>
                                            <th>Bank RRN</th>
                                            <th>Transaction&nbsp;Time</th>
                                            <th>Response&nbsp;Time</th>
                                        </tr>
