                                                <td><label id="txtwallet_total_pay"></label></td>
                                            </tr>
                                            <tr>
                                                <td>UPI</td>
                                                <td><label id="txtupi"></label> %</td>
                                                <td><label id="txtupi_total"></label></td>
                                                <td><label id="txtupi_total_pay"></label></td>
                                            </tr>
                                        </table>
                                    </div>
                                    <div class="vm-gw-pay-btn-wrap">
                                        <button type="submit" class="fullbodydycolorbg vm-ft-submit-btn">
                                            <span>Proceed To Pay</span>
                                        </button>
