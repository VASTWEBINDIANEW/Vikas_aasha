                                <span class="vm-ft-form-card-header__sub">Purchase wallet balance via payment gateway</span>
                            </div>
                        </div>

                        <div class="vm-ft-left-tab-pane vm-dealer-ft-form-fs14">
                            @using (Html.BeginForm("GatewayTransfer_new", "Home", FormMethod.Post, new { id = "gatewayPayForm" }))
                            {
