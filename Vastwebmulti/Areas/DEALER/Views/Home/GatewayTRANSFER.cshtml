                        </div>
                    </div>
                </div>

                <div class="vm-ft-history-col">
                    <div class="fund-trasfer-right vm-ft-history-panel">
                        <div class="vm-ft-history-body">
                            <div class="vm-ft-history-toolbar vm-ft-history-toolbar--premium">
                                <div class="vm-ft-history-toolbar__head">
                                    <i class="fas fa-history" aria-hidden="true"></i>
                                    <div>
                                        <span class="vm-ft-history-toolbar__title">Gateway History</span>
                                        <span class="vm-ft-history-toolbar__sub">View, filter &amp; export gateway transactions</span>
                                    </div>
                                </div>
                                <div class="vm-ft-history-toolbar__filters vm-ft-history-filters-row">
                                    <div class="vm-ft-search-wrap vm-ft-search-wrap--history">
                                        <input class="form-control vm-dealer-ft-fs14" type="text" value="" id="myInput" name="myInput" placeholder="Search gateway history..." autocomplete="off" onkeyup="gatewayHistorySearch()" />
                                    </div>
                                    @using (Html.BeginForm("GatewayTRANSFER", "Home", FormMethod.Post, new { id = "gatewayHistoryForm", @class = "vm-gw-history-form" }))
                                    {
                                        <div class="vm-dmt-filter-search-group vm-ft-date-search-group">
                                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar" aria-hidden="true"></i></span>
                                                <input type="text" id="txt_frm_date" name="txt_frm_date" class="form-control saas-acc-dp-input vm-dealer-ft-fs14" required="required" autocomplete="off" placeholder="From" title="From date" value="@frmDate" />
                                            </div>
                                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar" aria-hidden="true"></i></span>
                                                <input type="text" id="txt_to_date" name="txt_to_date" class="form-control saas-acc-dp-input vm-dealer-ft-fs14" required="required" autocomplete="off" placeholder="To" title="To date" value="@toDate" />
                                            </div>
                                            <button type="submit" id="btnchangetabbutton" name="btnDsearch" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-ft-search-btn" data-loading-text="<i class='fa fa-spinner fa-spin'></i>">
