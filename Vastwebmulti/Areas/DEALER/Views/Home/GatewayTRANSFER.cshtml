                                                <td><label id="txtrupay_total"></label></td>
                                                <td><label id="txtrupay_total_pay"></label></td>
                                            </tr>
                                            <tr>
                                                <td>Credit Card</td>
                                                <td><label id="txtcc"></label> %</td>
                                                <td><label id="txtcc_total"></label></td>
                                                <td><label id="txtcc_total_pay"></label></td>
                                            </tr>
                                            <tr>
                                                <td>Amex Card</td>
                                                <td><label id="txtamex"></label> %</td>
                                                <td><label id="txtamex_total"></label></td>
                                                <td><label id="txtamex_total_pay"></label></td>
                                            </tr>
                                            <tr>
                                                <td>International Card</td>
                                                <td><label id="txtic"></label> %</td>
                                                <td><label id="txtic_total"></label></td>
                                                <td><label id="txtic_total_pay"></label></td>
