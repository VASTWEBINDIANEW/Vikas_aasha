            padding: 12px 14px 14px !important;
        }
    }

    @@media (max-width: 480px) {
        body.saas-admin-ui section.content.saas-dealer-gateway-transfer-page .vm-gw-summary-grid {
            grid-template-columns: 1fr !important;
        }

        body.saas-admin-ui section.content.saas-dealer-gateway-transfer-page .vm-ft-breadcrumb {
            font-size: 12px !important;
        }

        body.saas-admin-ui section.content.saas-dealer-gateway-transfer-page .vm-ft-form-card-header__title {
            font-size: 14px !important;
        }

        body.saas-admin-ui section.content.saas-dealer-gateway-transfer-page .vm-ft-form-card-header__sub {
            font-size: 12px !important;
        }
    }
</style>

<section class="content saas-admin-account-page saas-admin-report-page saas-fund-transfer-page saas-fund-transfer-premium saas-dealer-fund-transfer-page saas-dealer-gateway-transfer-page">

    <div class="container-fluid vm-ft-page-shell">

        <div class="vm-ft-page-toolbar vm-ft-page-toolbar--premium vm-gw-page-toolbar">
            <div class="vm-ft-page-hero">
                <div>
                    <ol class="vm-ft-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Fund Transfer</li>
                        <li>Add By Gateway</li>
                    </ol>
                </div>
            </div>
            <div class="vm-gw-summary-grid">
                <div class="vm-gw-summary-tile vm-gw-summary-tile--success">
                    <div class="vm-gw-summary-tile__icon" aria-hidden="true"><i class="fas fa-check-circle"></i></div>
                    <div class="vm-gw-summary-tile__body">
                        <span class="vm-gw-summary-tile__label">Total Success</span>
