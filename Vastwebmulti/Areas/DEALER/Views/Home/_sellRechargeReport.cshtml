@model IEnumerable<Vastwebmulti.Models.Selling_Recharge_info>
@using System.Linq
@{
    Layout = null;
    var items = Model ?? Enumerable.Empty<Vastwebmulti.Models.Selling_Recharge_info>();
}
@if (items.Any())
{
    foreach (var item in items)
    {
        var statusRaw = item.Rstaus ?? "";
        var statusTone = "pending";
        var statusFa = "fa-clock-o";
        if (statusRaw.IndexOf("Failed", StringComparison.OrdinalIgnoreCase) >= 0 || statusRaw.IndexOf("Refund", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "failed";
            statusFa = "fa-times";
        }
        else if (statusRaw.IndexOf("Success", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "success";
            statusFa = "fa-check";
        }

        var consumer = !string.IsNullOrWhiteSpace(item.Mobile) ? item.Mobile : "—";
        var rchTime = item.Rch_time.HasValue ? item.Rch_time.Value.ToString("dd-MMM-yyyy HH:mm:ss") : "—";
        var respTime = item.Resp_time.HasValue ? item.Resp_time.Value.ToString("dd-MMM-yyyy HH:mm:ss") : "—";
        var txnId = item.trans_id ?? "";
        <tr class="vm-dmt-row vm-dmt-row--@statusTone" data-status="@statusRaw">
            <td class="vm-radiant-status-cell vm-ticket-status-cell">
                <span class="vm-dmt-status vm-dmt-status--@statusTone" title="@statusRaw">
                    <i class="fa @statusFa" aria-hidden="true"></i>
                </span>
                <span class="vm-radiant-status-text">@(string.IsNullOrWhiteSpace(statusRaw) ? "—" : statusRaw)</span>
            </td>
            <td>@consumer</td>
            <td>@(item.optcode ?? "—")</td>
            <td class="vm-dmt-amt-cell">@(item.amount.HasValue ? item.amount.Value.ToString("N2") : "—")</td>
            <td class="vm-dmt-amt-cell">@(item.income.HasValue ? item.income.Value.ToString("N2") : "—")</td>
            <td class="vm-dmt-amt-cell">@(item.dlmpre.HasValue ? item.dlmpre.Value.ToString("N2") : "—")</td>
            <td class="vm-dmt-amt-cell">@(item.dlmpost.HasValue ? item.dlmpost.Value.ToString("N2") : "—")</td>
            <td>@rchTime</td>
            <td>@respTime</td>
            <td class="vm-dmt-action-cell vm-sell-rch-actions">
                <button type="button"
                        class="vm-opr-icon-btn vm-dth-detail-btn vm-sell-rch-detail-btn"
                        title="View details"
                        data-status="@statusRaw"
                        data-consumer="@consumer"
                        data-operator="@(item.optcode ?? "")"
                        data-amount="@(item.amount.HasValue ? item.amount.Value.ToString("N2") : "")"
                        data-earn="@(item.income.HasValue ? item.income.Value.ToString("N2") : "")"
                        data-pre="@(item.dlmpre.HasValue ? item.dlmpre.Value.ToString("N2") : "")"
                        data-post="@(item.dlmpost.HasValue ? item.dlmpost.Value.ToString("N2") : "")"
                        data-rch="@rchTime"
                        data-resp="@respTime"
                        data-txn="@txnId"
                        data-idno="@item.idno"
                        data-sim="@(item.simno ?? "")"
                        data-ip="@(item.IPAddress ?? "")"
                        data-from="@(item.Rch_from ?? "")">
                    <i class="fas fa-eye" aria-hidden="true"></i>
                </button>
                <button type="button"
                        class="vm-sell-rch-upd-btn vm-sell-rch-upd-btn--success"
                        title="Mark Success"
                        data-idno="@item.idno"
                        data-status="Success"
                        data-txn="@txnId">Success</button>
                <button type="button"
                        class="vm-sell-rch-upd-btn vm-sell-rch-upd-btn--failed"
                        title="Mark Failed"
                        data-idno="@item.idno"
                        data-status="Failed"
                        data-txn="@txnId">Failed</button>
            </td>
        </tr>
    }
}
else
{
    <tr class="vm-opr-table-empty-row">
        <td colspan="10" class="vm-opr-table-empty vm-dmt-table-empty">
            <i class="fas fa-bolt" aria-hidden="true"></i>
            <span>Sell recharge report not found.</span>
        </td>
    </tr>
}
