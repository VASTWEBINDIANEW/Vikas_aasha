@model IEnumerable<Vastwebmulti.Models.show_upi_txn_details_Result>
@using System.Linq
@{
    ViewBag.Title = "UPITRANSFER_Dealer";
    Layout = "~/Areas/DEALER/Views/Shared/_Layout.cshtml";

    var reports = Model ?? Enumerable.Empty<Vastwebmulti.Models.show_upi_txn_details_Result>();
    var totalsuccess = ViewBag.totalsuccess ?? 0m;
    var totalfailamnt = ViewBag.totalfailedamount ?? 0m;
    var penamount = ViewBag.totalpendingamount ?? 0m;
    var totalcharges = ViewBag.totalchargesamount ?? 0m;
    var minCharge = ViewBag.min ?? 0;
    var pctCharge = ViewBag.charge ?? 0;

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-fund-transfer-modern.css?v=27" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-fund-transfer-mobile.css?v=23" rel="stylesheet" />
<link href="~/MainFrontDesign/css/dealer-fund-transfer-fonts.css?v=7" rel="stylesheet" />
<link href="~/MainFrontDesign/css/dealer-fund-transfer-mobile.css?v=1" rel="stylesheet" />
<link href="~/MainFrontDesign/css/dealer-upi-transfer-modern.css?v=2" rel="stylesheet" />
<script>document.body.classList.add('saas-sell-rch-dp-page', 'saas-dealer-fund-transfer-page', 'saas-dealer-upi-transfer-page');</script>

<section class="content saas-admin-account-page saas-admin-report-page saas-fund-transfer-page saas-fund-transfer-premium saas-dealer-fund-transfer-page saas-dealer-upi-transfer-page">

    <div class="container-fluid vm-ft-page-shell">

        <div class="vm-ft-page-toolbar vm-ft-page-toolbar--premium vm-gw-page-toolbar">
            <div class="vm-ft-page-hero">
                <div>
                    <ol class="vm-ft-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Fund Transfer</li>
                        <li>Add By UPI QR</li>
                    </ol>
                </div>
            </div>
            <div class="vm-gw-summary-grid">
                <div class="vm-gw-summary-tile vm-gw-summary-tile--success">
                    <div class="vm-gw-summary-tile__icon" aria-hidden="true"><i class="fas fa-check-circle"></i></div>
                    <div class="vm-gw-summary-tile__body">
                        <span class="vm-gw-summary-tile__label">Total Success</span>
                        <strong class="vm-gw-summary-tile__value">@Convert.ToDecimal(totalsuccess).ToString("N2")</strong>
                    </div>
                </div>
                <div class="vm-gw-summary-tile vm-gw-summary-tile--pending">
                    <div class="vm-gw-summary-tile__icon" aria-hidden="true"><i class="fas fa-clock"></i></div>
                    <div class="vm-gw-summary-tile__body">
                        <span class="vm-gw-summary-tile__label">Total Pending</span>
                        <strong class="vm-gw-summary-tile__value">@Convert.ToDecimal(penamount).ToString("N2")</strong>
                    </div>
                </div>
                <div class="vm-gw-summary-tile vm-gw-summary-tile--failed">
                    <div class="vm-gw-summary-tile__icon" aria-hidden="true"><i class="fas fa-times-circle"></i></div>
                    <div class="vm-gw-summary-tile__body">
                        <span class="vm-gw-summary-tile__label">Total Failed</span>
                        <strong class="vm-gw-summary-tile__value">@Convert.ToDecimal(totalfailamnt).ToString("N2")</strong>
                    </div>
                </div>
                <div class="vm-gw-summary-tile vm-gw-summary-tile--charges">
                    <div class="vm-gw-summary-tile__icon" aria-hidden="true"><i class="fas fa-percentage"></i></div>
                    <div class="vm-gw-summary-tile__body">
                        <span class="vm-gw-summary-tile__label">Total Charges</span>
                        <strong class="vm-gw-summary-tile__value">@Convert.ToDecimal(totalcharges).ToString("N2")</strong>
                    </div>
                </div>
            </div>
        </div>

        <div class="vm-ft-layout-wrap">
            <div class="vm-ft-layout vm-ft-layout--full">
                <div class="vm-ft-form-col">
                    <div class="fund-trasfer-left vm-ft-form-card">
                        <div class="vm-ft-form-card-header">
                            <div class="vm-ft-form-card-header__icon" aria-hidden="true">
                                <i class="fas fa-qrcode"></i>
                            </div>
                            <div>
                                <span class="vm-ft-form-card-header__title">Wallet By UPI QR Code</span>
                                <span class="vm-ft-form-card-header__sub">Scan QR code to add wallet balance via UPI</span>
                            </div>
                        </div>

                        <div class="vm-ft-left-tab-pane vm-dealer-ft-form-fs14">
                            <div class="vm-upi-qr-wrap">
                                <img src="~/ashok-images/qr-code.png" alt="UPI QR Code" />
                            </div>

                            <div class="vm-gw-notes">
                                <ol>
                                    <li>You can update the amount in your wallet by scanning the QR code.</li>
                                    <li>You can print a hard copy of the QR code and update through all the UPI wallets.</li>
                                    <li>Refresh the page after the customer's payment process is complete, you will get the transaction status report on the page, and after deducting the Charges on the success transaction, the balance will be updated in your wallet.</li>
                                </ol>
                            </div>

                            <table class="vm-upi-charges-table">
                                <thead>
                                    <tr>
                                        <th colspan="2">Charges</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>Minimum Fix Charge (In Rupees)</td>
                                        <td>@minCharge &#8377;</td>
                                    </tr>
                                    <tr>
                                        <td>Charges (In Percentage)</td>
                                        <td>@pctCharge %</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="vm-ft-history-col">
                    <div class="fund-trasfer-right vm-ft-history-panel">
                        <div class="vm-ft-history-body">
                            <div class="vm-ft-history-toolbar vm-ft-history-toolbar--premium">
                                <div class="vm-ft-history-toolbar__head">
                                    <i class="fas fa-history" aria-hidden="true"></i>
                                    <div>
                                        <span class="vm-ft-history-toolbar__title">UPI History</span>
                                        <span class="vm-ft-history-toolbar__sub">View, filter &amp; export UPI QR transactions</span>
                                    </div>
                                </div>
                                <div class="vm-ft-history-toolbar__filters vm-ft-history-filters-row">
                                    <div class="vm-ft-search-wrap vm-ft-search-wrap--history">
                                        <input class="form-control vm-dealer-ft-fs14" type="text" value="" id="myInput" name="myInput" placeholder="Search UPI history..." autocomplete="off" onkeyup="upiHistorySearch()" />
                                    </div>
                                    @using (Html.BeginForm("UPITRANSFER_Dealer", "Home", FormMethod.Post, new { id = "upiHistoryForm", @class = "vm-gw-history-form" }))
                                    {
                                        <div class="vm-dmt-filter-search-group vm-ft-date-search-group">
                                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar" aria-hidden="true"></i></span>
                                                <input type="text" id="txt_frm_date" name="txt_frm_date" class="form-control saas-acc-dp-input vm-dealer-ft-fs14" required="required" autocomplete="off" placeholder="From" title="From date" value="@frmDate" />
                                            </div>
                                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar" aria-hidden="true"></i></span>
                                                <input type="text" id="txt_to_date" name="txt_to_date" class="form-control saas-acc-dp-input vm-dealer-ft-fs14" required="required" autocomplete="off" placeholder="To" title="To date" value="@toDate" />
                                            </div>
                                            <button type="submit" id="btnchangetabbutton" name="btnDsearch" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-ft-search-btn" data-loading-text="<i class='fa fa-spinner fa-spin'></i>">
                                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                                            </button>
                                        </div>
                                    }
                                    <div class="vm-ft-export-group">
                                        <button type="button" id="btnExport" class="vm-ft-export-btn vm-ft-export-btn--excel" title="Export Excel"><i class="fas fa-file-excel" aria-hidden="true"></i></button>
                                        <button type="button" id="btnPDF" class="vm-ft-export-btn vm-ft-export-btn--pdf" title="Export PDF"><i class="fas fa-file-pdf" aria-hidden="true"></i></button>
                                    </div>
                                </div>
                            </div>

                            <div class="vm-ft-table-wrap table-responsive">
                                <table id="tblUpiHistory" class="table table-bordered table-striped table-hover fundtransfer-tableclass third-design-table vm-ft-table">
                                    <thead>
                                        <tr>
                                            <th>Payer&nbsp;Name</th>
                                            <th>Amount</th>
                                            <th>Charges</th>
                                            <th>Net&nbsp;Received</th>
                                            <th>Bank RRN</th>
                                            <th>Transaction&nbsp;Time</th>
                                        </tr>
                                    </thead>
                                    <tbody id="tblbody">
                                        @if (reports.Any())
                                        {
                                            foreach (var item in reports)
                                            {
                                                var sts = item.status ?? "";
                                                var code = "../../ashok-images/clock.svg";
                                                var color = "";
                                                var width = "21px";
                                                if (sts.IndexOf("SUCCESS", StringComparison.OrdinalIgnoreCase) >= 0)
                                                {
                                                    code = "../../ashok-images/correct.svg";
                                                    color = "green";
                                                    width = "20px";
                                                }
                                                else if (sts.IndexOf("FAILED", StringComparison.OrdinalIgnoreCase) >= 0)
                                                {
                                                    code = "../../ashok-images/closes.svg";
                                                    color = "red";
                                                    width = "20px";
                                                }
                                                <tr class="tr">
                                                    <td>
                                                        <span class="vm-gw-mode-cell">
                                                            <img src="@code" alt="@sts" style="width:@width;background-color:@color;" />
                                                            <span>@(string.IsNullOrWhiteSpace(item.PayerName) ? "-" : item.PayerName)</span>
                                                        </span>
                                                    </td>
                                                    <td class="vm-dmt-amt-cell">@(item.amt.HasValue ? item.amt.Value.ToString("N2") : "-")</td>
                                                    <td class="vm-dmt-amt-cell">@(item.charge.HasValue ? item.charge.Value.ToString("N2") : "-")</td>
                                                    <td class="vm-dmt-amt-cell">@(item.finalpay.HasValue ? item.finalpay.Value.ToString("N2") : "-")</td>
                                                    <td>@(string.IsNullOrWhiteSpace(item.BankRRN) ? "-" : item.BankRRN)</td>
                                                    <td>@(item.txndate.HasValue ? item.txndate.Value.ToString("dd-MMM-yyyy HH:mm:ss") : "-")</td>
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr class="vm-opr-table-empty-row">
                                                <td colspan="6" class="vm-opr-table-empty vm-dmt-table-empty">
                                                    <i class="fas fa-qrcode" aria-hidden="true"></i>
                                                    <span>UPI transaction not found.</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script src="~/MainFrontDesign/js/admin-report-datepicker.js?v=3"></script>

<script>
    window.dealerUpiExcelUrl = '@Url.Action("Execel_UPI_TRANSFER_Dealer", "Home")';
    window.dealerUpiPdfUrl = '@Url.Action("PDF_UPI_TRANSFER_Dealer", "Home")';

    function upiHistorySearch() {
        var value = ($('#myInput').val() || '').toLowerCase();
        $('#tblUpiHistory tbody tr.tr').filter(function () {
            $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
        });
    }

    $(document).ready(function () {
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm('#upiHistoryForm');
        } else if ($.fn.datepicker) {
            var dateOpts = {
                format: 'yyyy-mm-dd',
                todayHighlight: true,
                autoclose: true,
                orientation: 'bottom auto',
                forceParse: false,
                enableOnReadonly: true,
                container: 'body'
            };
            $('#txt_frm_date, #txt_to_date').datepicker(dateOpts);
            if ('@dateMode' !== 'post') {
                $('#txt_frm_date').datepicker('setDate', new Date());
                $('#txt_to_date').datepicker('setDate', new Date());
            }
        }

        $('#btnExport').on('click', function (e) {
            e.preventDefault();
            var url = window.dealerUpiExcelUrl
                + '?txt_frm_date=' + encodeURIComponent($('#txt_frm_date').val() || '')
                + '&txt_to_date=' + encodeURIComponent($('#txt_to_date').val() || '');
            window.location.href = url;
        });

        $('#btnPDF').on('click', function () {
            var url = window.dealerUpiPdfUrl
                + '?txt_frm_date=' + encodeURIComponent($('#txt_frm_date').val() || '')
                + '&txt_to_date=' + encodeURIComponent($('#txt_to_date').val() || '');
            window.open(url, '_blank');
        });
    });
</script>
