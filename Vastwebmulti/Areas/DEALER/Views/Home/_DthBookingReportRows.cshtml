@model IEnumerable<Vastwebmulti.Models.DTHConnection_Report_New_Result>
@{
    Layout = null;
    var items = Model ?? Enumerable.Empty<Vastwebmulti.Models.DTHConnection_Report_New_Result>();
}
@if (items.Any())
{
    foreach (var item in items)
    {
        var statusRaw = item.Status ?? "";
        var statusTone = "pending";
        var statusFa = "fa-clock-o";
        if (statusRaw.IndexOf("Failed", StringComparison.OrdinalIgnoreCase) >= 0 || statusRaw.IndexOf("Refund", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "failed";
            statusFa = "fa-times";
        }
        else if (statusRaw.IndexOf("Success", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "success";
            statusFa = "fa-check";
        }

        var firm = !string.IsNullOrWhiteSpace(item.Frm_Name) ? item.Frm_Name : (item.Email ?? "—");
        var rchTime = item.Rch_time.HasValue ? item.Rch_time.Value.ToString("dd-MMM-yyyy HH:mm:ss") : "—";
        var respTime = item.Resp_time.HasValue ? item.Resp_time.Value.ToString("dd-MMM-yyyy HH:mm:ss") : "—";
        <tr class="vm-dmt-row vm-dmt-row--@statusTone" data-status="@statusRaw">
            <td class="vm-radiant-firm-cell">@firm</td>
            <td class="vm-radiant-status-cell vm-ticket-status-cell">
                <span class="vm-dmt-status vm-dmt-status--@statusTone" title="@statusRaw">
                    <i class="fa @statusFa" aria-hidden="true"></i>
                </span>
                <span class="vm-radiant-status-text">@statusRaw</span>
            </td>
            <td class="vm-dmt-amt-cell">@(item.Amount.HasValue ? item.Amount.Value.ToString("N2") : "—")</td>
            <td>@(item.CustomerName ?? "—")</td>
            <td>@(item.CustomerEmail ?? "—")</td>
            <td>@(item.CustomerMobile ?? "—")</td>
            <td>@(item.Address ?? "—")</td>
            <td>@(item.DTHTitle ?? "—")</td>
            <td>@(item.Dthplanname ?? "—")</td>
            <td class="vm-dmt-amt-cell">@(item.DealerPre.HasValue ? item.DealerPre.Value.ToString("N2") : "—")</td>
            <td class="vm-dmt-amt-cell">@(item.DealerPost.HasValue ? item.DealerPost.Value.ToString("N2") : "—")</td>
            <td class="vm-dmt-amt-cell">@(item.Dlm_Comm.HasValue ? item.Dlm_Comm.Value.ToString("N2") : "—")</td>
            <td class="vm-dmt-action-cell">
                <button type="button"
                        class="vm-opr-icon-btn vm-dth-detail-btn"
                        title="View details"
                        data-toggle="modal"
                        data-target="#dthBookingDetailModal"
                        data-firm="@firm"
                        data-retailer="@(item.RetailerName ?? "")"
                        data-customer="@(item.CustomerName ?? "")"
                        data-email="@(item.CustomerEmail ?? "")"
                        data-mobile="@(item.CustomerMobile ?? "")"
                        data-address="@(item.Address ?? "")"
                        data-title="@(item.DTHTitle ?? "")"
                        data-plan="@(item.Dthplanname ?? "")"
                        data-optcode="@(item.optcode ?? "")"
                        data-optname="@(item.optname ?? "")"
                        data-rch="@rchTime"
                        data-resp="@respTime"
                        data-box="@(item.DthBoxtype ?? "")"
                        data-boxname="@(item.DthBoxtypename ?? "")"
                        data-amount="@(item.Amount.HasValue ? item.Amount.Value.ToString("N2") : "")"
                        data-pre="@(item.DealerPre.HasValue ? item.DealerPre.Value.ToString("N2") : "")"
                        data-post="@(item.DealerPost.HasValue ? item.DealerPost.Value.ToString("N2") : "")"
                        data-comm="@(item.Dlm_Comm.HasValue ? item.Dlm_Comm.Value.ToString("N2") : "")"
                        data-status="@statusRaw">
                    <i class="fas fa-eye" aria-hidden="true"></i>
                </button>
            </td>
        </tr>
    }
}
else
{
    <tr class="vm-opr-table-empty-row">
        <td colspan="13" class="vm-opr-table-empty vm-dmt-table-empty">
            <i class="fas fa-satellite-dish" aria-hidden="true"></i>
            <span>DTH booking report not found.</span>
        </td>
    </tr>
}
