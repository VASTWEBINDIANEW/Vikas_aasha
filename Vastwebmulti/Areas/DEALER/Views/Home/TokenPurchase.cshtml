@using System.Linq
@using Vastwebmulti.Models
@model IEnumerable<Vastwebmulti.Areas.ADMIN.Models.RetailerCreationTokenVM>
@{
    ViewBag.Title = "Token Purchase";
    Layout = "~/Areas/DEALER/Views/Shared/_Layout.cshtml";

    VastwebmultiEntities DB1 = new VastwebmultiEntities();
    var nickname = "Dealer";
    var usernname = DB1.Usernicknames.Where(aa => aa.Role == "Dealer").ToList();
    if (usernname.Count > 0 && usernname.SingleOrDefault().Role == "Dealer")
    {
        nickname = usernname.SingleOrDefault().NickName;
    }
    ViewBag.nickname = nickname;

    var perTokenValue = ViewBag.dealervalue != null ? Convert.ToString(ViewBag.dealervalue) : "0";

    var reports = (Model ?? Enumerable.Empty<Vastwebmulti.Areas.ADMIN.Models.RetailerCreationTokenVM>())
        .OrderByDescending(x => x.Idno)
        .ToList();

    var recordCount = reports.Count;
    var totalTokens = reports.Sum(x => x.Tokens);
    var totalDebit = reports.Sum(x => x.TotalDebit ?? 0m);
    var latestTokenPost = reports.FirstOrDefault()?.post ?? 0;
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=7" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=31" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=2" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-incoming-report-modern.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/dealer-flight-report-modern.css?v=12" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<script>document.body.classList.add('saas-flight-report-dp-page');</script>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-incoming-report-page saas-dealer-token-purchase-page">
    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-pan-toolbar-unified saas-acc-toolbar--stacked vm-opr-toolbar-unified">
            <div class="saas-acc-toolbar-top vm-opr-toolbar-head">
                <ol class="saas-acc-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>Account Active</li>
                    <li>Token Purchase</li>
                </ol>
                <div class="vm-opr-page-nav">
                    @Html.Partial("TokenSetting")
                </div>
            </div>
        </div>

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel" id="tokenPurchasePanel">
                <div class="vm-opr-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-coins" aria-hidden="true"></i>
                        <span>Token purchase history</span>
                    </div>
                    <div class="vm-opr-table-panel__right vm-flight-table-head-right">
                        <span class="vm-token-purchase-price-badge" title="Per token price set by admin">
                            Per token: <strong>@perTokenValue</strong>
                        </span>
                        <span class="vm-flight-inline-total" id="tpPurchaseTotalsChip" style="display:none;">
                            <span id="tpChipRecords">Records: @recordCount</span>
                            <span id="tpChipTokens">Tokens: @totalTokens</span>
                            <span id="tpChipDebit">Debit: @totalDebit</span>
                        </span>
                        <div class="vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="saas-acc-btn saas-acc-btn--search" id="btnTpAddToken" data-toggle="modal" data-target="#tokenPurchaseModal" title="Add tokens">
                                <i class="fas fa-plus" aria-hidden="true"></i> Add Token's
                            </button>
                            <button type="button" class="saas-acc-btn" id="btnTpPurchaseTotal" title="Show totals">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i> Total
                            </button>
                            <button type="button" id="btnTpPurchaseExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnTpPurchasePDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="tokenPurchaseReport" class="table table-bordered table-striped table-hover vm-opr-data-table vm-inc-data-table vm-flight-data-table">
                            <thead>
                                <tr>
                                    <th>Sr.No</th>
                                    <th>Purchasing&nbsp;By</th>
                                    <th>@nickname</th>
                                    <th>Purchase&nbsp;Tokens</th>
                                    <th>Token&nbsp;Pre</th>
                                    <th>Token&nbsp;Post</th>
                                    <th>@nickname&nbsp;Pre</th>
                                    <th>@nickname&nbsp;Post</th>
                                    <th>Admin&nbsp;Pre</th>
                                    <th>Admin&nbsp;Post</th>
                                    <th>Per&nbsp;Token&nbsp;Value</th>
                                    <th>Total&nbsp;Debit</th>
                                    <th>Purchase&nbsp;Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (reports.Any())
                                {
                                    var sr = 1;
                                    foreach (var item in reports)
                                    {
                                        var purchasedBy = "By Master";
                                        if (item.Role == "Self") { purchasedBy = "By Self"; }
                                        else if (item.Role == "Admin") { purchasedBy = "By Administrator"; }

                                        var dateDisplay = item.CteatedOn.HasValue
                                            ? item.CteatedOn.Value.ToString("dd-MM-yyyy HH:mm")
                                            : "—";

                                        <tr>
                                            <td>@sr</td>
                                            <td>@purchasedBy</td>
                                            <td>@(string.IsNullOrWhiteSpace(item.Email) ? "—" : item.Email)</td>
                                            <td>@item.Tokens</td>
                                            <td>@item.pre</td>
                                            <td>@item.post</td>
                                            <td>@(item.DealerPre.HasValue ? item.DealerPre.Value.ToString("0.####") : "—")</td>
                                            <td>@(item.DealerPost.HasValue ? item.DealerPost.Value.ToString("0.####") : "—")</td>
                                            <td>@(item.AdminPre.HasValue ? item.AdminPre.Value.ToString("0.####") : "—")</td>
                                            <td>@(item.AdminPost.HasValue ? item.AdminPost.Value.ToString("0.####") : "—")</td>
                                            <td>@(item.PerTokenValue.HasValue ? item.PerTokenValue.Value.ToString("0.####") : "—")</td>
                                            <td>@(item.TotalDebit.HasValue ? item.TotalDebit.Value.ToString("0.####") : "—")</td>
                                            <td>@dateDisplay</td>
                                        </tr>
                                        sr++;
                                    }
                                }
                                else
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="13" class="vm-opr-table-empty">No token purchase records found.</td>
                                    </tr>
                                }
                            </tbody>
                            @if (reports.Any())
                            {
                                <tfoot>
                                    <tr class="vm-ut-hist-table-foot">
                                        <td><strong>Total</strong></td>
                                        <td colspan="2"></td>
                                        <td><strong id="tpFootTokens">@totalTokens</strong></td>
                                        <td colspan="6"></td>
                                        <td></td>
                                        <td><strong id="tpFootDebit">@totalDebit.ToString("0.####")</strong></td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="modal fade saas-admin-modal vm-dmt-modal vm-token-purchase-modal" id="tokenPurchaseModal" tabindex="-1" role="dialog" aria-labelledby="tokenPurchaseModalTitle" aria-hidden="true" data-backdrop="static" data-keyboard="true">
    <div class="modal-dialog modal-dialog-centered vm-token-purchase-modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header saas-admin-modal-header">
                <div class="saas-admin-modal-head-main">
                    <div class="saas-admin-modal-icon"><i class="fas fa-ticket-alt" aria-hidden="true"></i></div>
                    <div class="saas-admin-modal-title-wrap">
                        <h4 class="modal-title saas-admin-modal-title" id="tokenPurchaseModalTitle">Add New Sign Up Token (Distributor)</h4>
                        <span class="saas-admin-modal-subtitle">Per token price: @perTokenValue</span>
                    </div>
                </div>
                <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close">
                    <i class="fas fa-times" aria-hidden="true"></i>
                </button>
            </div>
            @using (Html.BeginForm("TokenPurchase", "Home", FormMethod.Post, new { id = "tokenPurchaseForm" }))
            {
                <div class="modal-body saas-admin-modal-body vm-token-purchase-modal-body">
                    <input type="hidden" name="tokenCount" id="tokenCount" value="1" />
                    <div class="vm-token-purchase-counter-card">
                        <label for="showPhysicalCount" class="vm-token-purchase-counter__label">Retailer creation tokens</label>
                        <div class="vm-token-purchase-counter__controls">
                            <button type="button" id="btnChildMinus" class="vm-token-purchase-counter__btn" onclick="onPluseMinus(-1)" disabled="disabled" aria-label="Decrease tokens">
                                <i class="fas fa-minus" aria-hidden="true"></i>
                            </button>
                            <span id="showPhysicalCount" class="vm-token-purchase-counter__value" aria-live="polite">1</span>
                            <button type="button" id="btnChildPlus" class="vm-token-purchase-counter__btn" onclick="onPluseMinus(1)" aria-label="Increase tokens">
                                <i class="fas fa-plus" aria-hidden="true"></i>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="modal-footer saas-admin-modal-footer vm-token-purchase-modal-footer">
                    <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal">
                        <i class="fas fa-times" aria-hidden="true"></i> Close
                    </button>
                    <button type="submit" class="saas-admin-modal-btn saas-admin-modal-btn--primary">
                        <i class="fas fa-save" aria-hidden="true"></i> Save Change
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<script>
    var tpPurchaseNickname = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(nickname))';
    var tpPurchasePerToken = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(perTokenValue))';

    function tpPurchaseEsc(value) {
        return String(value == null ? '' : value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function tpPurchaseNum(value) {
        var n = parseFloat(String(value || '').replace(/[^\d.-]/g, ''));
        return isNaN(n) ? 0 : n;
    }

    function tpPurchaseNow() {
        var d = new Date();
        var months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        var h = d.getHours();
        var ampm = h >= 12 ? 'PM' : 'AM';
        var hr = h % 12; if (!hr) { hr = 12; }
        var min = d.getMinutes();
        return ('0' + d.getDate()).slice(-2) + ' ' + months[d.getMonth()] + ' ' + d.getFullYear() + ', ' + ('0' + hr).slice(-2) + ':' + ('0' + min).slice(-2) + ' ' + ampm;
    }

    function tpPurchaseTableRows() {
        var $ = window.jQuery;
        var rows = [];
        var sr = 0;
        $('#tokenPurchaseReport tbody tr').each(function () {
            var $tr = $(this);
            if ($tr.hasClass('vm-opr-table-empty-row')) { return; }
            var $cells = $tr.children('td');
            if ($cells.length < 13) { return; }
            sr += 1;
            rows.push({
                sr: String(sr),
                purchasedBy: $.trim($cells.eq(1).text()).replace(/\s+/g, ' '),
                email: $.trim($cells.eq(2).text()).replace(/\s+/g, ' '),
                tokens: $.trim($cells.eq(3).text()).replace(/\s+/g, ' '),
                tokenPre: $.trim($cells.eq(4).text()).replace(/\s+/g, ' '),
                tokenPost: $.trim($cells.eq(5).text()).replace(/\s+/g, ' '),
                dealerPre: $.trim($cells.eq(6).text()).replace(/\s+/g, ' '),
                dealerPost: $.trim($cells.eq(7).text()).replace(/\s+/g, ' '),
                adminPre: $.trim($cells.eq(8).text()).replace(/\s+/g, ' '),
                adminPost: $.trim($cells.eq(9).text()).replace(/\s+/g, ' '),
                perToken: $.trim($cells.eq(10).text()).replace(/\s+/g, ' '),
                totalDebit: $.trim($cells.eq(11).text()).replace(/\s+/g, ' '),
                date: $.trim($cells.eq(12).text()).replace(/\s+/g, ' ')
            });
        });
        return rows;
    }

    function tpPurchaseUpdateTotals() {
        var rows = tpPurchaseTableRows();
        var totalTokens = 0;
        var totalDebit = 0;
        for (var i = 0; i < rows.length; i++) {
            totalTokens += tpPurchaseNum(rows[i].tokens);
            totalDebit += tpPurchaseNum(rows[i].totalDebit);
        }
        var records = String(rows.length);
        var tokens = String(totalTokens);
        var debit = totalDebit.toFixed(4).replace(/\.?0+$/, '');

        var map = {
            tpChipRecords: 'Records: ' + records,
            tpChipTokens: 'Tokens: ' + tokens,
            tpChipDebit: 'Debit: ' + debit,
            tpFootTokens: tokens,
            tpFootDebit: debit
        };
        for (var id in map) {
            var el = document.getElementById(id);
            if (el) { el.textContent = map[id]; }
        }
    }

    function tpPurchaseHeads() {
        return [
            'Sr.No', 'Purchasing By', tpPurchaseNickname, 'Purchase Tokens', 'Token Pre', 'Token Post',
            tpPurchaseNickname + ' Pre', tpPurchaseNickname + ' Post', 'Admin Pre', 'Admin Post',
            'Per Token Value', 'Total Debit', 'Purchase Date'
        ];
    }

    function tpPurchaseExportMeta(rows) {
        var totalTokens = 0;
        var totalDebit = 0;
        for (var i = 0; i < rows.length; i++) {
            totalTokens += tpPurchaseNum(rows[i].tokens);
            totalDebit += tpPurchaseNum(rows[i].totalDebit);
        }
        return {
            generatedOn: tpPurchaseNow(),
            records: rows.length,
            tokens: String(totalTokens),
            debit: totalDebit.toFixed(4).replace(/\.?0+$/, ''),
            perToken: tpPurchasePerToken
        };
    }

    function tpPurchaseBuildExcelHtml(rows) {
        var m = tpPurchaseExportMeta(rows);
        var colCount = 13;
        var html = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel"><head><meta charset="utf-8" /><title>Token Purchase Report</title></head><body>';
        html += '<table border="1" cellspacing="0" cellpadding="6" style="border-collapse:collapse;">';
        html += '<tr><td colspan="' + colCount + '" bgcolor="#2563EB" style="color:#FFFFFF;font-size:16pt;font-weight:bold;">Token Purchase Report</td></tr>';
        html += '<tr><td colspan="' + colCount + '" bgcolor="#1D4ED8" style="color:#DBEAFE;font-size:10pt;">Dealer token purchase history</td></tr>';
        html += '<tr><td bgcolor="#F1F5F9" style="font-weight:bold;">Generated On</td><td colspan="4" style="font-weight:bold;">' + tpPurchaseEsc(m.generatedOn) + '</td>';
        html += '<td bgcolor="#F1F5F9" style="font-weight:bold;">Per Token</td><td colspan="2" style="font-weight:bold;">' + tpPurchaseEsc(m.perToken) + '</td>';
        html += '<td bgcolor="#F1F5F9" style="font-weight:bold;">Records</td><td colspan="3" style="font-weight:bold;">' + m.records + '</td></tr>';
        html += '<tr><td bgcolor="#EEF2FF" style="font-weight:bold;">Total Tokens</td><td bgcolor="#EEF2FF" style="font-weight:bold;">' + m.tokens + '</td>';
        html += '<td bgcolor="#ECFDF5" style="font-weight:bold;color:#047857;" colspan="2">Total Debit</td><td bgcolor="#ECFDF5" style="font-weight:bold;color:#047857;" colspan="9">' + tpPurchaseEsc(m.debit) + '</td></tr>';
        html += '<tr>';
        var heads = tpPurchaseHeads();
        for (var h = 0; h < heads.length; h++) {
            html += '<th bgcolor="#334155" style="color:#FFFFFF;font-weight:bold;">' + tpPurchaseEsc(heads[h]) + '</th>';
        }
        html += '</tr>';
        if (!rows.length) {
            html += '<tr><td colspan="' + colCount + '" bgcolor="#F8FAFC" style="text-align:center;font-weight:bold;color:#64748B;height:48px;">No token purchase records found.</td></tr>';
        } else {
            for (var i = 0; i < rows.length; i++) {
                var r = rows[i];
                var rowBg = (i % 2 === 1) ? '#F8FAFC' : '#FFFFFF';
                html += '<tr>';
                html += '<td bgcolor="' + rowBg + '">' + tpPurchaseEsc(r.sr) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + tpPurchaseEsc(r.purchasedBy) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + tpPurchaseEsc(r.email) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + tpPurchaseEsc(r.tokens) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + tpPurchaseEsc(r.tokenPre) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + tpPurchaseEsc(r.tokenPost) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + tpPurchaseEsc(r.dealerPre) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + tpPurchaseEsc(r.dealerPost) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + tpPurchaseEsc(r.adminPre) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + tpPurchaseEsc(r.adminPost) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + tpPurchaseEsc(r.perToken) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + tpPurchaseEsc(r.totalDebit) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + tpPurchaseEsc(r.date) + '</td>';
                html += '</tr>';
            }
            html += '<tr>';
            html += '<td bgcolor="#EFF6FF" style="font-weight:bold;">Total</td>';
            html += '<td bgcolor="#EFF6FF" colspan="2"></td>';
            html += '<td bgcolor="#EFF6FF" style="font-weight:bold;">' + m.tokens + '</td>';
            html += '<td bgcolor="#EFF6FF" colspan="7"></td>';
            html += '<td bgcolor="#EFF6FF" style="font-weight:bold;">' + tpPurchaseEsc(m.debit) + '</td>';
            html += '<td bgcolor="#EFF6FF"></td>';
            html += '</tr>';
        }
        html += '</table></body></html>';
        return html;
    }

    function tpPurchaseBuildPdfHtml(rows) {
        var m = tpPurchaseExportMeta(rows);
        var heads = tpPurchaseHeads();
        var headHtml = '';
        for (var h = 0; h < heads.length; h++) {
            headHtml += '<th>' + tpPurchaseEsc(heads[h]) + '</th>';
        }
        var body = '';
        if (!rows.length) {
            body = '<tr><td colspan="13" class="empty">No token purchase records found.</td></tr>';
        } else {
            for (var i = 0; i < rows.length; i++) {
                var r = rows[i];
                body += '<tr>';
                body += '<td>' + tpPurchaseEsc(r.sr) + '</td>';
                body += '<td>' + tpPurchaseEsc(r.purchasedBy) + '</td>';
                body += '<td>' + tpPurchaseEsc(r.email) + '</td>';
                body += '<td>' + tpPurchaseEsc(r.tokens) + '</td>';
                body += '<td>' + tpPurchaseEsc(r.tokenPre) + '</td>';
                body += '<td>' + tpPurchaseEsc(r.tokenPost) + '</td>';
                body += '<td>' + tpPurchaseEsc(r.dealerPre) + '</td>';
                body += '<td>' + tpPurchaseEsc(r.dealerPost) + '</td>';
                body += '<td>' + tpPurchaseEsc(r.adminPre) + '</td>';
                body += '<td>' + tpPurchaseEsc(r.adminPost) + '</td>';
                body += '<td>' + tpPurchaseEsc(r.perToken) + '</td>';
                body += '<td>' + tpPurchaseEsc(r.totalDebit) + '</td>';
                body += '<td>' + tpPurchaseEsc(r.date) + '</td>';
                body += '</tr>';
            }
            body += '<tr class="foot-row">';
            body += '<td><strong>Total</strong></td>';
            body += '<td colspan="2"></td>';
            body += '<td><strong>' + tpPurchaseEsc(m.tokens) + '</strong></td>';
            body += '<td colspan="7"></td>';
            body += '<td><strong>' + tpPurchaseEsc(m.debit) + '</strong></td>';
            body += '<td></td>';
            body += '</tr>';
        }
        return '<!DOCTYPE html><html><head><meta charset="utf-8" /><title>Token Purchase Report</title><style type="text/css">'
            + '@@page { size: A4 landscape; margin: 8mm; }'
            + '* { box-sizing: border-box; } body { margin:0; padding:12px; font-family:Arial,Helvetica,sans-serif; font-size:10px; color:#0f172a; background:#fff; -webkit-print-color-adjust:exact; print-color-adjust:exact; }'
            + 'table { border-collapse:collapse; } .hero { width:100%; border:1px solid #1d4ed8; } .hero-top { padding:14px 18px; background:#2563eb; color:#fff; }'
            + '.hero-top h1 { margin:0; font-size:20px; } .hero-top p { margin:4px 0 0; font-size:11px; color:#dbeafe; }'
            + '.meta { width:100%; background:#f8fafc; } .meta td { padding:8px 12px; border-right:1px solid #e2e8f0; vertical-align:top; }'
            + '.meta-label { display:block; font-size:9px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:#64748b; margin-bottom:3px; }'
            + '.meta-value { font-size:12px; font-weight:700; } .cards { width:100%; margin:12px 0; } .cards td { width:33%; padding:0 6px 0 0; vertical-align:top; }'
            + '.card { border:1px solid #e2e8f0; padding:10px 12px; } .card-label { display:block; font-size:9px; font-weight:700; text-transform:uppercase; margin-bottom:4px; } .card-value { font-size:16px; font-weight:800; }'
            + '.card-total { background:#eef2ff; } .card-ok { background:#ecfdf5; } .card-wait { background:#fefce8; }'
            + '.grid { width:100%; border:1px solid #cbd5e1; } .grid th { padding:7px 5px; text-align:left; font-size:9px; font-weight:700; text-transform:uppercase; color:#fff; background:#334155; }'
            + '.grid td { padding:6px 5px; font-size:9px; border-top:1px solid #e2e8f0; vertical-align:top; } .grid tbody tr:nth-child(even):not(.foot-row) td { background:#f8fafc; }'
            + '.grid tbody tr.foot-row td { background:#eff6ff; border-top:2px solid #93c5fd; font-weight:700; }'
            + '.empty { padding:36px 16px; text-align:center; font-size:14px; font-weight:700; color:#64748b; background:#f8fafc; }'
            + '.foot { margin-top:10px; padding-top:8px; border-top:1px dashed #cbd5e1; font-size:10px; color:#94a3b8; text-align:center; }'
            + '</style></head><body><div class="sheet"><div class="hero"><div class="hero-top"><h1>Token Purchase Report</h1><p>Dealer token purchase history</p></div>'
            + '<table class="meta" cellpadding="0" cellspacing="0"><tr>'
            + '<td style="width:30%;"><span class="meta-label">Generated On</span><span class="meta-value">' + tpPurchaseEsc(m.generatedOn) + '</span></td>'
            + '<td style="width:25%;"><span class="meta-label">Per Token</span><span class="meta-value">' + tpPurchaseEsc(m.perToken) + '</span></td>'
            + '<td style="width:20%;"><span class="meta-label">Records</span><span class="meta-value">' + m.records + '</span></td>'
            + '<td style="width:25%;"><span class="meta-label">Total Debit</span><span class="meta-value">' + tpPurchaseEsc(m.debit) + '</span></td>'
            + '</tr></table></div>'
            + '<table class="cards" cellpadding="0" cellspacing="0"><tr>'
            + '<td><div class="card card-total"><span class="card-label">Total Tokens</span><span class="card-value">' + m.tokens + '</span></div></td>'
            + '<td><div class="card card-ok"><span class="card-label">Records</span><span class="card-value">' + m.records + '</span></div></td>'
            + '<td><div class="card card-wait"><span class="card-label">Latest Token Post</span><span class="card-value">' + tpPurchaseEsc(rows.length ? rows[0].tokenPost : '0') + '</span></div></td>'
            + '</tr></table>'
            + '<table class="grid" cellpadding="0" cellspacing="0"><thead><tr>' + headHtml + '</tr></thead><tbody>' + body + '</tbody></table>'
            + '<div class="foot">Generated from Dealer panel - Token Purchase</div></div></body></html>';
    }

    function tpPurchaseDownloadExcel(html) {
        var blob = new Blob(['\ufeff', html], { type: 'application/vnd.ms-excel;charset=utf-8;' });
        if (window.navigator && window.navigator.msSaveOrOpenBlob) {
            window.navigator.msSaveOrOpenBlob(blob, 'Token_Purchase_Report.xls');
            return;
        }
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'Token_Purchase_Report.xls';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(function () { URL.revokeObjectURL(url); }, 800);
    }

    function tpPurchaseOpenPdf(html) {
        var w = window.open('', '_blank');
        if (!w) {
            if (typeof swal === 'function') {
                swal('Popup blocked', 'Please allow popups for this site to download PDF.', 'warning');
            }
            return;
        }
        w.document.open();
        w.document.write(html);
        w.document.close();
        w.focus();
        setTimeout(function () {
            try { w.print(); } catch (e) { }
        }, 400);
    }

    function tpPurchaseShowAlerts() {
        var message = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Convert.ToString(TempData["success"])))';
        if (message && typeof swal === 'function') { swal('Good job!', message, 'success'); }
        var error = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(Convert.ToString(TempData["error"])))';
        if (error && typeof swal === 'function') { swal('Oops!', error, 'error'); }
    }

    function tpPurchaseToggleTotals() {
        var $ = window.jQuery;
        if (!$) { return; }
        tpPurchaseUpdateTotals();
        var $chip = $('.saas-dealer-token-purchase-page #tpPurchaseTotalsChip');
        if ($chip.is(':visible')) {
            $chip.hide();
            return;
        }
        $chip.css('display', 'inline-flex').show();
    }

    function onPluseMinus(v) {
        if (window.event) { window.event.stopPropagation(); }
        var digiCount = parseInt(document.getElementById('tokenCount').value, 10) || 0;
        if (v >= 0) {
            digiCount += v;
        } else {
            digiCount -= 1;
        }
        if (digiCount < 0) { digiCount = 0; }
        document.getElementById('tokenCount').value = String(digiCount);
        document.getElementById('showPhysicalCount').textContent = String(digiCount);
        document.getElementById('btnChildMinus').disabled = digiCount <= 0;
    }

    function bootTokenPurchasePage() {
        var $ = window.jQuery;
        if (!$) {
            window.setTimeout(bootTokenPurchasePage, 50);
            return;
        }

        var $page = $('.saas-dealer-token-purchase-page');
        if (!$page.length) {
            return;
        }

        $page.find('#btnTpPurchaseTotal').off('click.tpTot').on('click.tpTot', function () {
            tpPurchaseToggleTotals();
        });

        $page.find('#btnTpPurchaseExport').off('click.tpEx').on('click.tpEx', function () {
            var rows = tpPurchaseTableRows();
            if (!rows.length) {
                if (typeof swal === 'function') { swal('No records to export', '', 'warning'); }
                return;
            }
            tpPurchaseDownloadExcel(tpPurchaseBuildExcelHtml(rows));
        });

        $page.find('#btnTpPurchasePDF').off('click.tpPdf').on('click.tpPdf', function () {
            var rows = tpPurchaseTableRows();
            if (!rows.length) {
                if (typeof swal === 'function') { swal('No records to export', '', 'warning'); }
                return;
            }
            tpPurchaseOpenPdf(tpPurchaseBuildPdfHtml(rows));
        });

        $('#tokenPurchaseModal').on('hidden.bs.modal', function () {
            document.getElementById('tokenCount').value = '1';
            document.getElementById('showPhysicalCount').textContent = '1';
            document.getElementById('btnChildMinus').disabled = true;
        });

        tpPurchaseShowAlerts();
        tpPurchaseUpdateTotals();

        if (typeof window.refreshDealerTokenBadge === 'function') {
            window.refreshDealerTokenBadge();
        }
    }

    if (document.readyState === 'complete') {
        bootTokenPurchasePage();
    } else {
        window.addEventListener('load', bootTokenPurchasePage);
    }
</script>
