@using Vastwebmulti.Models;
@model IEnumerable<Vastwebmulti.Models.show_all_user_income_Result>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Actual Dealer Income";
    Layout = "~/Areas/DEALER/Views/Shared/_Layout.cshtml";

    VastwebmultiEntities DB1 = new VastwebmultiEntities();
    var nick = "Dealer";
    var usernname = DB1.Usernicknames.Where(aa => aa.Role == "Dealer").ToList();
    if (usernname.Any())
    {
        var row = usernname.SingleOrDefault();
        if (row != null && !string.IsNullOrWhiteSpace(row.NickName))
        {
            nick = row.NickName.Trim();
        }
    }

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate))
    {
        frmDate = DateTime.Today.ToString("yyyy-MM-dd");
    }

    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
    var rowList = (Model ?? Enumerable.Empty<show_all_user_income_Result>()).ToList();
    var rowCount = rowList.Count;
    var totalIncome = rowList.Sum(a => a.Amount);
    var totalSuccess = rowList.Sum(a => a.TotalSuccess);
    var totalPending = rowList.Sum(a => a.TotalPending);
    var totalFailed = rowList.Sum(a => a.TotalFailed);
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=15" rel="stylesheet" />
<link href="~/MainFrontDesign/css/dealer-dth-booking-report-modern.css?v=49" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-gst-report-modern.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/dealer-block-opt-modern.css?v=4" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<script>document.body.classList.add('saas-sell-rch-dp-page', 'saas-dealer-block-opt-page', 'saas-dealer-actual-income-page');</script>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-dth-booking-report-page saas-sell-recharge-report-page saas-ecommerce-report-page saas-dealer-block-opt-page saas-dealer-actual-income-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var incomeFormAttrs = new Dictionary<string, object>
            {
                { "id", "dealerActualIncomeForm" },
                { "class", "vm-block-opt-form-shell" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate }
            };
        }
        @using (Html.BeginForm("Actual_Dealer_income", "Home", FormMethod.Post, incomeFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Account Active</li>
                        <li>My Earn</li>
                        <li>@nick Actual Income</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-radiant-inline-filters vm-block-opt-toolbar-filters vm-dealer-income-toolbar-filters">

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date vm-dealer-income-date-field">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "Select date", title = "Report date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="dealerIncomeTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>@nick income summary</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideDealerIncomeTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--primary">
                            <span class="vm-opr-total-card__label">Total Income</span>
                            <strong class="vm-opr-total-card__value">@totalIncome.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Total Success</span>
                            <strong class="vm-opr-total-card__value">@totalSuccess.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Total Pending</span>
                            <strong class="vm-opr-total-card__value">@totalPending.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Total Failed</span>
                            <strong class="vm-opr-total-card__value">@totalFailed.ToString("N2")</strong>
                        </div>
                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-coins" aria-hidden="true"></i>
                        <span>@nick actual income</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <div class="vm-ft-search-wrap vm-block-opt-table-search">
                            <input class="form-control vm-block-opt-search-input" type="text" id="dealerIncomeSearch" placeholder="Search income rows..." autocomplete="off" />
                        </div>
                        <span class="vm-radiant-inline-total" title="Total income for current view">
                            Income: <strong>&#8377; @totalIncome.ToString("N2")</strong>
                        </span>
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong id="dealerIncomeRecordCount">@rowCount</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group vm-dealer-block-opt-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-radiant-totals-btn vm-dealer-income-totals-btn" onclick="toggleDealerIncomeTotals()" title="Show totals" aria-expanded="false" aria-controls="dealerIncomeTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnExport" class="saas-acc-btn saas-acc-btn--excel vm-dealer-block-opt-export-btn vm-dealer-block-opt-export-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDF" class="saas-acc-btn saas-acc-btn--pdf vm-dealer-block-opt-export-btn vm-dealer-block-opt-export-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap" id="dealerIncomeExportWrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="dealerActualIncomeTable" class="table vm-opr-data-table vm-block-opt-table vm-dealer-income-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Sr.&nbsp;No</th>
                                    <th>Type</th>
                                    <th>Total&nbsp;Success</th>
                                    <th>Total&nbsp;Pending</th>
                                    <th>Total&nbsp;Failed</th>
                                    <th>Income</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (!rowList.Any())
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="6" class="vm-opr-table-empty">No income records found for the selected date.</td>
                                    </tr>
                                }
                                else
                                {
                                    var i = 1;
                                    foreach (var item in rowList)
                                    {
                                        <tr>
                                            <td>@i</td>
                                            <td class="vm-dealer-income-type">@(string.IsNullOrWhiteSpace(item.Type) ? "—" : item.Type)</td>
                                            <td>@item.TotalSuccess.ToString("N2")</td>
                                            <td>@item.TotalPending.ToString("N2")</td>
                                            <td>@item.TotalFailed.ToString("N2")</td>
                                            <td class="vm-dealer-income-amount">@item.Amount.ToString("N2")</td>
                                        </tr>
                                        i++;
                                    }
                                }
                            </tbody>
                            @if (rowList.Any())
                            {
                                <tfoot>
                                    <tr class="vm-dealer-income-foot-row">
                                        <td colspan="5"><strong>Total</strong></td>
                                        <td class="vm-dealer-income-amount vm-dealer-income-amount--total"><strong>@totalIncome.ToString("N2")</strong></td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<script src="~/MainFrontDesign/js/admin-report-datepicker.js?v=4"></script>
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    window.dealerIncomeNickName = '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(nick))';

    function dealerIncomeSearch() {
        var $ = window.jQuery;
        if (!$) { return; }
        var value = ($('#dealerIncomeSearch').val() || '').toLowerCase();
        var visible = 0;
        $('#dealerActualIncomeTable tbody tr').each(function () {
            var $tr = $(this);
            if ($tr.hasClass('vm-opr-table-empty-row')) {
                $tr.toggle(!value);
                return;
            }
            var show = $tr.text().toLowerCase().indexOf(value) > -1;
            $tr.toggle(show);
            if (show) { visible++; }
        });
        $('#dealerIncomeRecordCount').text(visible);
    }

    function toggleDealerIncomeTotals() {
        var $ = window.jQuery;
        if (!$) { return; }
        var panel = $('#dealerIncomeTotalsPanel');
        var btn = $('.vm-dealer-income-totals-btn');
        if (panel.is(':visible')) {
            hideDealerIncomeTotals();
            return;
        }
        panel.slideDown(180).attr('aria-hidden', 'false');
        btn.attr('aria-expanded', 'true');
    }

    function hideDealerIncomeTotals() {
        var $ = window.jQuery;
        if (!$) { return; }
        $('#dealerIncomeTotalsPanel').slideUp(180).attr('aria-hidden', 'true');
        $('.vm-dealer-income-totals-btn').attr('aria-expanded', 'false');
    }

    function dealerIncomeEsc(value) {
        return String(value == null ? '' : value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function dealerIncomeTableRows() {
        var $ = window.jQuery;
        var rows = [];
        $('#dealerActualIncomeTable tbody tr').each(function () {
            var $tr = $(this);
            if ($tr.hasClass('vm-opr-table-empty-row') || !$tr.is(':visible')) {
                return;
            }
            var $cells = $tr.children('td');
            if ($cells.length < 6) {
                return;
            }
            rows.push({
                sr: $.trim($cells.eq(0).text()),
                type: $.trim($cells.eq(1).text()),
                success: $.trim($cells.eq(2).text()),
                pending: $.trim($cells.eq(3).text()),
                failed: $.trim($cells.eq(4).text()),
                income: $.trim($cells.eq(5).text())
            });
        });
        return rows;
    }

    function dealerIncomeExportStyles() {
        return 'body{font-family:Segoe UI,Arial,sans-serif;padding:24px;color:#0f172a;background:#fff;}'
            + '.vm-block-export-head{margin:0 0 18px;padding-bottom:14px;border-bottom:2px solid #e2e8f0;}'
            + '.vm-block-export-head h3{margin:0 0 6px;font-size:22px;font-weight:700;color:#1e293b;}'
            + '.vm-block-export-head p{margin:0;font-size:13px;color:#64748b;line-height:1.5;}'
            + '.vm-block-export-summary{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 18px;}'
            + '.vm-block-export-chip{display:inline-block;padding:6px 12px;border-radius:999px;background:#eef2ff;color:#3730a3;font-size:12px;font-weight:700;}'
            + 'table{border-collapse:collapse;width:100%;font-size:12px;}'
            + 'th,td{border:1px solid #dbe4f0;padding:8px 10px;text-align:center;vertical-align:middle;}'
            + 'th{background:linear-gradient(180deg,#f8fafc 0%,#eef2f7 100%);color:#334155;font-weight:700;}'
            + 'tbody tr:nth-child(even){background:#f8fafc;}'
            + 'td.vm-dealer-income-export-type{text-align:left;font-weight:600;}'
            + 'td.vm-dealer-income-export-amt{color:#1d4ed8;font-weight:700;}'
            + 'tfoot td{font-weight:700;background:#eff6ff;border-top:2px solid #93c5fd;}';
    }

    function dealerIncomeBuildExportHtml(rows, title) {
        var reportDate = ($('#txt_frm_date').val() || '').trim();
        var body = '';
        var incomeSum = 0;
        for (var i = 0; i < rows.length; i++) {
            var r = rows[i];
            var amt = parseFloat(String(r.income).replace(/,/g, ''));
            if (!isNaN(amt)) {
                incomeSum += amt;
            }
            body += '<tr>'
                + '<td>' + dealerIncomeEsc(r.sr) + '</td>'
                + '<td class="vm-dealer-income-export-type">' + dealerIncomeEsc(r.type) + '</td>'
                + '<td>' + dealerIncomeEsc(r.success) + '</td>'
                + '<td>' + dealerIncomeEsc(r.pending) + '</td>'
                + '<td>' + dealerIncomeEsc(r.failed) + '</td>'
                + '<td class="vm-dealer-income-export-amt">' + dealerIncomeEsc(r.income) + '</td>'
                + '</tr>';
        }
        var footer = '<tfoot><tr><td colspan="5"><strong>Total</strong></td><td class="vm-dealer-income-export-amt"><strong>'
            + dealerIncomeEsc(incomeSum.toFixed(2)) + '</strong></td></tr></tfoot>';

        return '<html><head><meta charset="utf-8"><title>' + dealerIncomeEsc(title) + '</title>'
            + '<style>' + dealerIncomeExportStyles() + '</style></head><body>'
            + '<div class="vm-block-export-head">'
            + '<h3>' + dealerIncomeEsc(title) + '</h3>'
            + '<p>Date: ' + dealerIncomeEsc(reportDate) + ' | Generated on ' + dealerIncomeEsc(new Date().toLocaleString()) + '</p>'
            + '</div>'
            + '<div class="vm-block-export-summary">'
            + '<span class="vm-block-export-chip">Role: ' + dealerIncomeEsc(window.dealerIncomeNickName || 'Dealer') + '</span>'
            + '<span class="vm-block-export-chip">Records: ' + rows.length + '</span>'
            + '</div>'
            + '<table><thead><tr>'
            + '<th>Sr. No</th><th>Type</th><th>Total Success</th><th>Total Pending</th><th>Total Failed</th><th>Income</th>'
            + '</tr></thead><tbody>' + body + '</tbody>' + (rows.length ? footer : '') + '</table></body></html>';
    }

    function dealerIncomeDownloadExcel(html) {
        var blob = new Blob(['\ufeff', html], { type: 'application/vnd.ms-excel;charset=utf-8;' });
        if (window.navigator && window.navigator.msSaveOrOpenBlob) {
            window.navigator.msSaveOrOpenBlob(blob, 'Actual_Dealer_Income.xls');
            return;
        }
        var url = URL.createObjectURL(blob);
        var link = document.createElement('a');
        link.href = url;
        link.download = 'Actual_Dealer_Income.xls';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        setTimeout(function () { URL.revokeObjectURL(url); }, 800);
    }

    function dealerIncomeOpenPdf(html) {
        var w = window.open('', '_blank');
        if (!w) {
            if (typeof swal === 'function') {
                swal('Popup blocked', 'Please allow popups to export PDF.', 'warning');
            }
            return;
        }
        w.document.open();
        w.document.write(html);
        w.document.close();
        w.focus();
        setTimeout(function () {
            try { w.print(); } catch (e) { }
        }, 400);
    }

    function dealerIncomeWarnNoRecords() {
        if (typeof swal === 'function') {
            swal('No records to export', '', 'warning');
            return;
        }
        window.alert('No records to export');
    }

    function bootDealerActualIncomePage() {
        var $ = window.jQuery;
        if (!$ || !$.fn || !$.fn.datepicker) {
            window.setTimeout(bootDealerActualIncomePage, 50);
            return;
        }

        // NOTE: shared initAdminReportDateForm needs from+to both dates,
        // is page me sirf single date (txt_frm_date) hai isliye ReceiveFund jaisa
        // single-date bind yahi kar rahe hain (readonly + icon click + show).
        function bindDealerIncomeDate($input) {
            if (!$input.length || $input.data('datepicker')) {
                return $input;
            }
            $input.prop('readonly', true);
            $input.datepicker({
                format: 'yyyy-mm-dd',
                todayHighlight: true,
                autoclose: true,
                orientation: 'bottom auto',
                forceParse: false,
                keyboardNavigation: true,
                enableOnReadonly: true,
                container: 'body'
            });
            $input.on('show shown', function () {
                $input.closest('.saas-acc-dp-field').addClass('is-active');
                pinDealerIncomeDatepicker($input[0]);
            });
            $input.on('hide changeDate', function () {
                $input.closest('.saas-acc-dp-field').removeClass('is-active');
            });
            $input.on('click', function (e) {
                e.preventDefault();
                $input.datepicker('show');
            });
            $input.siblings('.saas-acc-dp-icon').on('click', function (e) {
                e.preventDefault();
                $input.datepicker('show');
            });
            return $input;
        }

        function pinDealerIncomeDatepicker(el) {
            var target = el && el.target ? el.target : el;
            if (typeof window.repositionAdminDatepickerForMobile === 'function') {
                window.repositionAdminDatepickerForMobile(target);
            } else if (typeof window.repositionAdminDatepicker === 'function') {
                window.repositionAdminDatepicker(target);
            }
        }

        var $incomeDate = bindDealerIncomeDate($('#txt_frm_date'));
        var postedDate = ($('#dealerActualIncomeForm').attr('data-frm-date') || '').trim();
        if (postedDate) {
            $incomeDate.datepicker('update', postedDate);
        } else if ($('#dealerActualIncomeForm').attr('data-date-mode') !== 'post') {
            $incomeDate.datepicker('setDate', new Date());
        }

        $(document).off('show.dealerIncomeDp shown.dealerIncomeDp').on('show.dealerIncomeDp shown.dealerIncomeDp', '#txt_frm_date', pinDealerIncomeDatepicker);
        $(window).off('resize.dealerIncomeDp orientationchange.dealerIncomeDp').on('resize.dealerIncomeDp orientationchange.dealerIncomeDp', pinDealerIncomeDatepicker);

        $('#dealerIncomeSearch').off('input.dealerIncome keyup.dealerIncome').on('input.dealerIncome keyup.dealerIncome', dealerIncomeSearch);

        $('#btnExport').off('click.dealerIncomeEx').on('click.dealerIncomeEx', function () {
            var rows = dealerIncomeTableRows();
            if (!rows.length) {
                dealerIncomeWarnNoRecords();
                return;
            }
            dealerIncomeDownloadExcel(dealerIncomeBuildExportHtml(rows, (window.dealerIncomeNickName || 'Dealer') + ' Actual Income'));
        });

        $('#btnPDF').off('click.dealerIncomePdf').on('click.dealerIncomePdf', function () {
            var rows = dealerIncomeTableRows();
            if (!rows.length) {
                dealerIncomeWarnNoRecords();
                return;
            }
            dealerIncomeOpenPdf(dealerIncomeBuildExportHtml(rows, (window.dealerIncomeNickName || 'Dealer') + ' Actual Income'));
        });
    }

    if (document.readyState === 'complete') {
        bootDealerActualIncomePage();
    } else {
        window.addEventListener('load', bootDealerActualIncomePage);
    }
</script>

@section LateCss {
    <style>
        body.saas-admin-ui section.content.saas-dealer-actual-income-page,
        body.saas-admin-ui section.content.saas-dealer-actual-income-page .vm-radiant-breadcrumb,
        body.saas-admin-ui section.content.saas-dealer-actual-income-page .vm-radiant-breadcrumb a,
        body.saas-admin-ui section.content.saas-dealer-actual-income-page .vm-opr-table-panel__title,
        body.saas-admin-ui section.content.saas-dealer-actual-income-page .vm-opr-table-panel__title span,
        body.saas-admin-ui section.content.saas-dealer-actual-income-page .vm-radiant-inline-filters .saas-acc-dp-input,
        body.saas-admin-ui section.content.saas-dealer-actual-income-page .vm-radiant-inline-filters .saas-acc-btn--search,
        body.saas-admin-ui section.content.saas-dealer-actual-income-page .vm-radiant-inline-filters .saas-acc-btn--search span,
        body.saas-admin-ui section.content.saas-dealer-actual-income-page .vm-block-opt-table-search input.vm-block-opt-search-input,
        body.saas-admin-ui section.content.saas-dealer-actual-income-page #dealerActualIncomeTable.vm-opr-data-table thead th,
        body.saas-admin-ui section.content.saas-dealer-actual-income-page #dealerActualIncomeTable.vm-opr-data-table tbody td,
        body.saas-admin-ui section.content.saas-dealer-actual-income-page #dealerActualIncomeTable.vm-opr-data-table tfoot td,
        body.saas-admin-ui section.content.saas-dealer-actual-income-page .vm-dealer-block-opt-export-btn,
        body.saas-admin-ui section.content.saas-dealer-actual-income-page .vm-radiant-inline-total,
        body.saas-admin-ui section.content.saas-dealer-actual-income-page .vm-radiant-record-badge,
        body.saas-admin-ui section.content.saas-dealer-actual-income-page .vm-dmt-totals-head__title,
