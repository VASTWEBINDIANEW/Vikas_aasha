@model IEnumerable<Vastwebmulti.Models.proc_Complaint_request_Result>

@using System.Linq

@{

    ViewBag.Title = "Complaint";

    Layout = "~/Areas/DEALER/Views/Shared/_Layout.cshtml";

    var messages = Model ?? Enumerable.Empty<Vastwebmulti.Models.proc_Complaint_request_Result>();

    var openCount = messages.Count(x => x.sts == "Open");

}



<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />

<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />

<link href="~/MainFrontDesign/css/admin-support-pages-modern.css?v=14" rel="stylesheet" />



<section class="content saas-admin-account-page saas-admin-report-page saas-support-page saas-complaint-page saas-dealer-complaint-page">

    <div class="container-fluid">

        <div class="saas-acc-toolbar saas-pan-toolbar-unified" style="margin-bottom:16px;">

            <ol class="saas-acc-breadcrumb">

                <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>

                <li><a href="javascript:void(0);">Support</a></li>

                <li>Chats</li>

            </ol>

        </div>



        <button type="button" class="saas-complaint-mobile-toggle" id="saasDealerComplaintToggleCompose" aria-expanded="true">

            <i class="fas fa-pen-to-square" aria-hidden="true"></i> Show / hide compose

        </button>



        <div class="saas-complaint-layout saas-dealer-complaint-layout">

            <div class="saas-complaint-compose-card" id="saasDealerComplaintComposeCard">

                <div class="saas-complaint-card-head">

                    <i class="fas fa-keyboard" aria-hidden="true"></i> Insert complaint

                </div>

                <div class="saas-dealer-complaint-compose-body">

                    @using (Html.BeginForm("Complaint_insert", "Home", FormMethod.Post, new { id = "dealerComplaintForm", @class = "saas-dealer-complaint-form" }))

                    {

                        @Html.AntiForgeryToken()

                        <div class="saas-dealer-complaint-message-shell">

                            <label class="saas-dealer-complaint-label" for="message">Message</label>

                            <div class="saas-dealer-complaint-textarea-wrap">

                                <textarea id="message" name="message" class="form-control saas-dealer-complaint-textarea" required="" maxlength="2000" placeholder="Type your complaint or message for admin..." autocomplete="off" rows="8"></textarea>

                            </div>

                        </div>

                        <div class="saas-dealer-complaint-actions">

                            <button type="submit" class="saas-dealer-complaint-btn saas-dealer-complaint-btn--primary" id="dealerComplaintSendBtn">

                                <i class="fas fa-paper-plane" aria-hidden="true"></i><span>Send message</span>

                            </button>

                            <div class="saas-dealer-complaint-actions-secondary">

                                <button type="reset" class="saas-dealer-complaint-btn saas-dealer-complaint-btn--secondary">

                                    <i class="fas fa-eraser" aria-hidden="true"></i><span>Reset</span>

                                </button>

                                <a href="@Url.Action("Dashboard", "Home")" class="saas-dealer-complaint-btn saas-dealer-complaint-btn--secondary">

                                    <i class="fas fa-arrow-left" aria-hidden="true"></i><span>Back</span>

                                </a>

                            </div>

                        </div>

                    }

                </div>

            </div>



            <div class="saas-complaint-chat-card">

                <div class="saas-complaint-card-head">

                    <i class="fas fa-comments" aria-hidden="true"></i> Chatting details

                    @if (openCount > 0)

                    {

                        <span class="saas-dealer-complaint-open-badge" id="dealerComplaintOpenBadge">@openCount open</span>

                    }

                    else

                    {

                        <span class="saas-dealer-complaint-open-badge is-zero" id="dealerComplaintOpenBadge" style="display:none;">0 open</span>

                    }

                </div>

                <div class="saas-complaint-messages" id="dealerComplaintMessages">

                    @if (!messages.Any())

                    {

                        <p class="saas-dealer-complaint-empty text-muted text-center">No messages yet. Send your first complaint using the form.</p>

                    }

                    @foreach (var item in messages)

                    {

                        if (item.rdate != null)

                        {

                            <div class="saas-chat-bubble saas-chat-bubble--in clearfix" data-id="@item.idno">

                                <div class="saas-chat-bubble-head"><strong>You</strong> <i class="far fa-clock saas-chat-time-ico" aria-hidden="true"></i> @item.rdate.Value.ToString("dd-MM-yyyy HH:mm")@if (item.sts == "Open") { <span class="saas-dealer-complaint-status-open">Open</span> }</div>

                                <div class="saas-chat-bubble-body">@item.complant</div>

                            </div>

                        }

                        if (item.resdate != null)

                        {

                            <div class="saas-chat-bubble saas-chat-bubble--out clearfix" data-id="@item.idno">

                                <div class="saas-chat-bubble-head"><strong>Admin</strong> <i class="far fa-clock saas-chat-time-ico" aria-hidden="true"></i> @item.resdate.Value.ToString("dd-MM-yyyy HH:mm")</div>

                                <div class="saas-chat-bubble-body">@item.response</div>

                            </div>

                        }

                    }

                </div>

            </div>

        </div>

    </div>

</section>



<script src="~/MainFrontDesign/js/dealer-complaint-chat.js?v=2"></script>

<script>

    window.dealerComplaintMessagesUrl = '@Url.Action("GetDealerComplaintMessages", "Home")';

    window.dealerComplaintInsertUrl = '@Url.Action("Complaint_insert", "Home")';

    window.dealerComplaintPageUrl = '@Url.Action("Complaint", "Home")';

</script>


