@model List<Vastwebmulti.Models.proc_HotelReport_Result>
@using System.Linq
@{
    Layout = null;
    var items = Model ?? Enumerable.Empty<Vastwebmulti.Models.proc_HotelReport_Result>();
}
@if (items.Any())
{
    foreach (var item in items)
    {
        var statusRaw = item.TicketStatus ?? "";
        var statusTone = "pending";
        var statusLabel = statusRaw;
        var statusFa = "fa-clock-o";
        if (statusRaw.IndexOf("Refund", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "failed";
            statusLabel = "Refund";
            statusFa = "fa-undo";
        }
        else if (statusRaw.IndexOf("Failed", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "failed";
            statusLabel = "Failed";
            statusFa = "fa-times";
        }
        else if (statusRaw.IndexOf("Success", StringComparison.OrdinalIgnoreCase) >= 0 || statusRaw.IndexOf("Confirm", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "success";
            statusLabel = "Success";
            statusFa = "fa-check";
        }
        else if (statusRaw.IndexOf("Pending", StringComparison.OrdinalIgnoreCase) >= 0 || statusRaw.IndexOf("Proccessed", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "pending";
            statusLabel = "Pending";
            statusFa = "fa-clock-o";
        }

        var firm = !string.IsNullOrWhiteSpace(item.Frm_Name) ? item.Frm_Name : (item.RetailerName ?? "—");
        var bookingDate = item.ticketdate.HasValue ? item.ticketdate.Value.ToString("ddd, MMM d, yyyy HH:mm:ss") : "—";
        <tr class="vm-dmt-row vm-dmt-row--@statusTone" data-status="@statusRaw">
            <td class="vm-radiant-status-cell vm-ticket-status-cell">
                <span class="vm-dmt-status vm-dmt-status--@statusTone" title="@statusLabel">
                    <i class="fa @statusFa" aria-hidden="true"></i>
                </span>
                <span class="vm-radiant-status-text">@firm</span>
            </td>
            <td>@(item.HotelName ?? "—")</td>
            <td>@(item.NoOfRooms.HasValue ? item.NoOfRooms.Value.ToString() : "—")</td>
            <td class="vm-dmt-amt-cell">@(item.totalOfferedFare.HasValue ? item.totalOfferedFare.Value.ToString("N2") : "—")</td>
            <td>@(item.BookingId ?? "—")</td>
            <td class="vm-dmt-amt-cell">@(item.reminc.HasValue ? item.reminc.Value.ToString("N2") : "—")</td>
            <td class="vm-dmt-amt-cell">@(item.dlmpre.HasValue ? item.dlmpre.Value.ToString("N2") : "—")</td>
            <td class="vm-dmt-amt-cell">@(item.dlminc.HasValue ? item.dlminc.Value.ToString("N2") : "—")</td>
            <td class="vm-dmt-amt-cell">@(item.dlmpost.HasValue ? item.dlmpost.Value.ToString("N2") : "—")</td>
            <td>@bookingDate</td>
        </tr>
    }
}
else
{
    <tr class="vm-opr-table-empty-row">
        <td colspan="10" class="vm-opr-table-empty">
            <i class="fas fa-hotel" aria-hidden="true"></i>
            <span>Hotel report not found.</span>
        </td>
    </tr>
}
