@using Vastwebmulti.Models;
@model Tuple<ChangePasswordViewModel, ChangeTransactionViewModel>
@{
    ViewBag.Title = "ChangePassword";
    Layout = "~/Areas/DEALER/Views/Shared/_Layout.cshtml";
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-fund-transfer-modern.css?v=36" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-fund-transfer-mobile.css?v=36" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-fund-transfer-page saas-fund-transfer-premium saas-upload-apk-page saas-security-password-page saas-dealer-change-password-page">

    <div class="container-fluid vm-ft-page-shell">

        <div class="vm-ft-page-toolbar vm-ft-page-toolbar--premium vm-ft-apk-toolbar vm-csp-toolbar-line">
            <div class="vm-ft-page-hero vm-csp-toolbar-breadcrumb">
                <ol class="vm-ft-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>Manage Password</li>
                </ol>
            </div>
            <div class="vm-csp-toolbar-right">
                <div class="vm-ft-search-wrap vm-ft-apk-page-search vm-csp-toolbar-search">
                    <input class="form-control" type="text" value="" id="txtDlrCpSearch" placeholder="Search..." autocomplete="off" />
                </div>
            </div>
        </div>

        <div class="col-md-12 vm-ft-layout-wrap">
            <label id="error-message-one" class="vm-csp-alert vm-csp-page-alert"></label>

            <div class="vm-ft-layout vm-ft-layout--stacked vm-csp-rows">

                <!-- Row 1: Login Password -->
                <div class="vm-csp-row vm-ft-layout vm-ft-layout--split-equal">
                    <div class="col-md-6 col-sm-12 vm-ft-apk-col">
                        <div class="fund-trasfer-left vm-ft-form-card" data-apk-search="login password important rules">
                            <div class="vm-ft-form-card-header">
                                <div class="vm-ft-form-card-header__icon" aria-hidden="true">
                                    <i class="fas fa-info-circle"></i>
                                </div>
                                <div>
                                    <span class="vm-ft-form-card-header__title">Important</span>
                                    <span class="vm-ft-form-card-header__sub">Password requirements for login credentials</span>
                                </div>
                            </div>
                            <div class="width100 float-left tabcurrent-seconddesign input-border-third vm-csp-card-body">
                                <div class="vm-ft-apk-section vm-csp-rules-panel">
                                    <ul class="vm-csp-rules">
                                        <li><i class="fas fa-check-circle" aria-hidden="true"></i> Password must be Required one Special character</li>
                                        <li><i class="fas fa-check-circle" aria-hidden="true"></i> Password must be Required one Digit Number</li>
                                        <li><i class="fas fa-check-circle" aria-hidden="true"></i> Password must be Required one Lowercase character</li>
                                        <li><i class="fas fa-check-circle" aria-hidden="true"></i> Password must be Required one Uppercase character</li>
                                        <li><i class="fas fa-check-circle" aria-hidden="true"></i> Password must be Required one alphabet character</li>
                                        <li><i class="fas fa-check-circle" aria-hidden="true"></i> Password must be Required Minimum Length Six character</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-12 vm-ft-apk-col">
                        <div class="fund-trasfer-left vm-ft-form-card" data-apk-search="change login password">
                            <div class="vm-ft-form-card-header">
                                <div class="vm-ft-form-card-header__icon vm-ft-form-card-header__icon--wl" aria-hidden="true">
                                    <i class="fas fa-lock"></i>
                                </div>
                                <div>
                                    <span class="vm-ft-form-card-header__title">Change Login Password</span>
                                    <span class="vm-ft-form-card-header__sub">Update your website login credentials</span>
                                </div>
                            </div>
                            <div class="width100 float-left tabcurrent-seconddesign input-border-third vm-csp-card-body">
                                <div class="fund-transfer-form vm-ft-apk-form">
                                    <div class="vm-ft-apk-section">
                                        @using (Html.BeginForm("ChangePassword", "Home", FormMethod.Post, new { @class = "vm-csp-change-form", role = "form", id = "formLoginPass" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                            <div class="vm-csp-field">
                                                <label class="required">Old Password</label>
                                                @Html.PasswordFor(tuple => tuple.Item1.OldPassword, new { @class = "form-control", @required = "" })
                                                @Html.ValidationMessageFor(tuple => tuple.Item1.OldPassword, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="vm-csp-field">
                                                <label class="required">New Password</label>
                                                @Html.PasswordFor(tuple => tuple.Item1.NewPassword, new { @class = "form-control", @required = "" })
                                                @Html.ValidationMessageFor(tuple => tuple.Item1.NewPassword, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="vm-csp-field">
                                                <label class="required">Confirm Password</label>
                                                @Html.PasswordFor(tuple => tuple.Item1.ConfirmPassword, new { @class = "form-control", @required = "" })
                                                @Html.ValidationMessageFor(tuple => tuple.Item1.ConfirmPassword, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="vm-csp-actions">
                                                <button type="reset" class="btn vm-csp-btn-secondary">Reset</button>
                                                <button type="button" class="vm-csp-btn-primary" onclick="return dlrAskChangePassword('formLoginPass', 'change your login password');"><i class="fas fa-key" aria-hidden="true"></i> Change Password</button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Row 2: Transaction Pin -->
                <div class="vm-csp-row vm-ft-layout vm-ft-layout--split-equal">
                    <div class="col-md-6 col-sm-12 vm-ft-apk-col">
                        <div class="fund-trasfer-left vm-ft-form-card" data-apk-search="reset transaction pin email otp">
                            <div class="vm-ft-form-card-header">
                                <div class="vm-ft-form-card-header__icon" aria-hidden="true">
                                    <i class="fas fa-envelope-open-text"></i>
                                </div>
                                <div>
                                    <span class="vm-ft-form-card-header__title">Reset Transaction Pin</span>
                                    <span class="vm-ft-form-card-header__sub">Request a reset via registered email</span>
                                </div>
                            </div>
                            <div class="width100 float-left tabcurrent-seconddesign input-border-third vm-csp-card-body">
                                <div class="fund-transfer-form vm-ft-apk-form">
                                    <div class="vm-ft-apk-section">
                                        @using (Html.BeginForm("Reset_TransPin", "Home", FormMethod.Post, new { id = "resttarnspass" }))
                                        {
                                            <div class="vm-csp-field">
                                                <label class="required">Register Email Id</label>
                                                <input type="text" id="txtemail" name="txtemail" class="form-control" placeholder="Enter Registered Email" required />
                                                <label id="error-message" class="vm-csp-alert vm-csp-alert--err"></label>
                                            </div>
                                            var asd = Convert.ToString(Session["chk1"]);
                                            if (asd != null && asd != "0" && asd != "")
                                            {
                                                <div class="vm-csp-otp-wrap">
                                                    <a href="#" onclick="otpsend1('12'); return false;" class="vm-csp-otp-send"><i class="fas fa-paper-plane" aria-hidden="true"></i> Send OTP</a>
                                                    <div class="hide_otp">
                                                        <div class="vm-csp-otp-field">
                                                            <label class="required">Enter OTP</label>
                                                            <div class="vm-csp-otp-box otp_set2">
                                                                <input class="vm-csp-otp-input tested" type="number" name="oTP" maxlength="1" onkeyup="onKeyUpEvent(1, event)" onfocus="onFocusEvent(1)" required>
                                                                <input class="vm-csp-otp-input tested" type="number" name="oTP1" maxlength="1" onkeyup="onKeyUpEvent(2, event)" onfocus="onFocusEvent(2)" required>
                                                                <input class="vm-csp-otp-input tested" type="number" name="oTP2" maxlength="1" onkeyup="onKeyUpEvent(3, event)" onfocus="onFocusEvent(3)" required>
                                                                <input class="vm-csp-otp-input tested" type="number" name="oTP3" maxlength="1" onkeyup="onKeyUpEvent(4, event)" onfocus="onFocusEvent(4)" required>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            }
                                            <div class="vm-csp-actions">
                                                <button type="button" id="clickemebutton" class="vm-csp-btn-primary" onclick="return confrim();"><i class="fas fa-key" aria-hidden="true"></i> Reset Transaction Pin</button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-12 vm-ft-apk-col">
                        <div class="fund-trasfer-left vm-ft-form-card" data-apk-search="change transaction pin">
                            <div class="vm-ft-form-card-header">
                                <div class="vm-ft-form-card-header__icon vm-ft-form-card-header__icon--wl" aria-hidden="true">
                                    <i class="fas fa-exchange-alt"></i>
                                </div>
                                <div>
                                    <span class="vm-ft-form-card-header__title">Change Transaction Pin</span>
                                    <span class="vm-ft-form-card-header__sub">Update your transaction PIN credentials</span>
                                </div>
                            </div>
                            <div class="width100 float-left tabcurrent-seconddesign input-border-third vm-csp-card-body">
                                <div class="fund-transfer-form vm-ft-apk-form">
                                    <div class="vm-ft-apk-section">
                                        @using (Html.BeginForm("Edit_Reset_TransPin", "Home", FormMethod.Post, new { @class = "vm-csp-change-form", id = "formChangeTransPin" }))
                                        {
                                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                                            <div class="vm-csp-field">
                                                <label class="required">Enter Old Pin</label>
                                                @Html.PasswordFor(tuple => tuple.Item2.Oldtransactionpass, new { @class = "form-control", @required = "" })
                                                @Html.ValidationMessageFor(tuple => tuple.Item2.Oldtransactionpass, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="vm-csp-field">
                                                <label class="required">Enter New Pin</label>
                                                @Html.PasswordFor(tuple => tuple.Item2.Newtransactionpass, new { @class = "form-control", @required = "", @maxlength = "6" })
                                                @Html.ValidationMessageFor(tuple => tuple.Item2.Newtransactionpass, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="vm-csp-field">
                                                <label class="required">Enter Confirm Pin</label>
                                                @Html.PasswordFor(tuple => tuple.Item2.Confirmtransactionpass, new { @class = "form-control", @required = "", @maxlength = "6" })
                                                @Html.ValidationMessageFor(tuple => tuple.Item2.Confirmtransactionpass, "", new { @class = "text-danger" })
                                            </div>
                                            <div class="vm-csp-actions">
                                                <button type="reset" class="btn vm-csp-btn-secondary">Reset</button>
                                                <button type="button" class="vm-csp-btn-primary" onclick="return dlrAskChangePassword('formChangeTransPin', 'change your transaction pin');"><i class="fas fa-key" aria-hidden="true"></i> Change Password</button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</section>

<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    function dlrSwal(title, text, type) {
        if (typeof swal === 'function') {
            swal(title, text, type || 'info');
            return;
        }
        window.setTimeout(function () {
            if (typeof swal === 'function') {
                swal(title, text, type || 'info');
            }
        }, 250);
    }

    // Change (login password / transaction pin) — confirm karke submit
    function dlrAskChangePassword(formId, actionText) {
        var form = document.getElementById(formId);
        if (!form) {
            dlrSwal('Oops!', 'Form not found. Please refresh the page.', 'error');
            return false;
        }
        if (form.checkValidity && !form.checkValidity()) {
            form.reportValidity();
            dlrSwal('Oops!', 'Please fill all required fields correctly.', 'error');
            return false;
        }
        if (typeof swal !== 'function') {
            form.submit();
            return false;
        }
        swal({
            title: 'Are you sure?',
            text: 'Do you want to ' + (actionText || 'change password') + '?',
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#10b981',
            confirmButtonText: 'Yes, change it!',
            cancelButtonText: 'Cancel',
            closeOnConfirm: true,
            closeOnCancel: true
        }, function (isConfirm) {
            if (isConfirm) {
                form.submit();
            }
        });
        return false;
    }

    function dlrIsSuccessMessage(msg) {
        if (!msg) {
            return false;
        }
        var lower = String(msg).toLowerCase();
        return lower.indexOf('success') !== -1 ||
            lower.indexOf('successfully') !== -1 ||
            lower.indexOf('has been changed') !== -1 ||
            lower.indexOf('send successfully') !== -1;
    }

    function dlrShowPageMessages() {
        var succMsg = @Html.Raw(Json.Encode(Convert.ToString(ViewData["success"] ?? "")));
        var errMsg = @Html.Raw(Json.Encode(Convert.ToString(ViewData["error"] ?? "")));
        var wrongMsg = @Html.Raw(Json.Encode(Convert.ToString(TempData["Messagewrong"] ?? "")));
        var displayMsg = succMsg || errMsg || wrongMsg;
        var $ = window.jQuery;
        if (!displayMsg) {
            return;
        }
        if ($) {
            $('#error-message-one')
                .text(displayMsg)
                .toggleClass('vm-csp-alert--ok', !!succMsg)
                .toggleClass('vm-csp-alert--err', !succMsg);
        }
        dlrSwal(
            dlrIsSuccessMessage(displayMsg) ? 'Success' : 'Error!',
            displayMsg,
            dlrIsSuccessMessage(displayMsg) ? 'success' : 'error'
        );
    }

    function bindDlrOtpBoxNavigation(className) {
        var container = document.getElementsByClassName(className)[0];
        if (!container) {
            return;
        }
        container.onkeyup = function (e) {
            var target = e.srcElement || e.target;
            var maxLength = parseInt(target.attributes["maxlength"].value, 10);
            var myLength = target.value.length;
            if (myLength >= maxLength) {
                var next = target;
                while (next = next.nextElementSibling) {
                    if (next == null)
                        break;
                    if (next.tagName.toLowerCase() === "input") {
                        next.focus();
                        break;
                    }
                }
            }
            else if (myLength === 0) {
                var previous = target;
                while (previous = previous.previousElementSibling) {
                    if (previous == null)
                        break;
                    if (previous.tagName.toLowerCase() === "input") {
                        previous.focus();
                        break;
                    }
                }
            }
        };
    }

    // Reset Transaction Pin — email check + confirm karke submit
    function confrim() {
        var emailEl = document.getElementById('txtemail');
        var errEl = document.getElementById('error-message');
        var form = document.getElementById('resttarnspass');
        var btn = document.getElementById('clickemebutton');
        var mail = emailEl ? String(emailEl.value || '').replace(/^\s+|\s+$/g, '') : '';
        if (mail == "") {
            if (errEl) {
                errEl.textContent = 'Please Enter Register Email-Id';
            }
            dlrSwal('Oops!', 'Please Enter Register Email-Id', 'error');
            return false;
        }
        if (errEl) {
            errEl.textContent = '';
        }
        if (typeof swal !== 'function') {
            if (form) {
                HTMLFormElement.prototype.submit.call(form);
            }
            return false;
        }
        swal({
            title: "Are you sure?",
            text: "You want to reset your Transaction Password",
            type: "warning",
            showCancelButton: true,
            confirmButtonColor: "#DD6B55",
            confirmButtonText: "Yes, Reset Transaction Password!",
            closeOnConfirm: false
        },
        function (isConfirm) {
            if (isConfirm) {
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = "<i class='fas fa-spinner fa-spin' aria-hidden='true'></i> Please wait...";
                }
                if (form) {
                    HTMLFormElement.prototype.submit.call(form);
                }
                return true;
            }
            else {
                return false;
            }
        });
        return false;
    }

    // Send OTP (ajax) — dealer Passcode3, param ids
    function otpsend1() {
        var $ = window.jQuery;
        var id = ($('#txtemail').val() || '').toString().trim();
        if (!id) {
            var errEl = document.getElementById('error-message');
            if (errEl) {
                errEl.textContent = 'Please Enter Register Email-Id';
            }
            dlrSwal('Oops!', 'Please Enter Register Email-Id', 'error');
            return false;
        }
        if (!$ || !$.ajax) {
            return false;
        }
        $.ajax({
            url: '@Url.Action("Passcode3", "Home")',
            type: 'GET',
            data: { ids: id },
            dataType: "JSON",
            error: function () {
                dlrSwal('Oops!', 'Unable to send OTP. Please try again.', 'error');
            }
        });
        return false;
    }

    function bootDealerChangePasswordPage() {
        bindDlrOtpBoxNavigation("otp_set2");
        dlrShowPageMessages();
        var $ = window.jQuery;
        if ($ && $('#txtDlrCpSearch').length) {
            $('#txtDlrCpSearch').off('input.dlrCp').on('input.dlrCp', function () {
                var q = $.trim($(this).val()).toLowerCase();
                var $blocks = $('.saas-dealer-change-password-page [data-apk-search]');
                if (!q) {
                    $blocks.removeClass('vm-ft-apk-search-hidden');
                    $('.saas-dealer-change-password-page .vm-ft-apk-col').removeClass('vm-ft-apk-col--empty');
                    return;
                }
                $blocks.each(function () {
                    var text = (($(this).attr('data-apk-search') || '') + ' ' + $(this).text()).toLowerCase();
                    $(this).toggleClass('vm-ft-apk-search-hidden', text.indexOf(q) === -1);
                });
                $('.saas-dealer-change-password-page .vm-ft-apk-col').each(function () {
                    var visible = $(this).find('[data-apk-search]').not('.vm-ft-apk-search-hidden').length > 0;
                    $(this).toggleClass('vm-ft-apk-col--empty', !visible);
                });
            });
        }
    }

    if (document.readyState === 'complete') {
        bootDealerChangePasswordPage();
    } else if (window.addEventListener) {
        window.addEventListener('load', bootDealerChangePasswordPage);
    } else {
        window.setTimeout(bootDealerChangePasswordPage, 200);
    }
</script>

