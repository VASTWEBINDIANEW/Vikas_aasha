@model IEnumerable<Vastwebmulti.Models.show_upi_txn_details_Result>
@using System.Linq
@{
    Layout = null;
    var rows = (Model ?? Enumerable.Empty<Vastwebmulti.Models.show_upi_txn_details_Result>()).ToList();
    var generatedOn = DateTime.Now.ToString("dd MMM yyyy, hh:mm tt");
    var frmDate = (ViewBag.frmDate as string) ?? "-";
    var toDate = (ViewBag.toDate as string) ?? "-";

    Func<Vastwebmulti.Models.show_upi_txn_details_Result, bool> isSuccess = x => !string.IsNullOrEmpty(x.status) && x.status.IndexOf("SUCCESS", StringComparison.OrdinalIgnoreCase) >= 0;
    Func<Vastwebmulti.Models.show_upi_txn_details_Result, bool> isFailed = x => !string.IsNullOrEmpty(x.status) && x.status.IndexOf("FAILED", StringComparison.OrdinalIgnoreCase) >= 0;
    Func<Vastwebmulti.Models.show_upi_txn_details_Result, bool> isPending = x => !string.IsNullOrEmpty(x.status) && x.status.IndexOf("PENDING", StringComparison.OrdinalIgnoreCase) >= 0;

    var totalSuccess = rows.Where(isSuccess).Sum(x => x.amt ?? 0m);
    var totalPending = rows.Where(isPending).Sum(x => x.amt ?? 0m);
    var totalFailed = rows.Where(isFailed).Sum(x => x.amt ?? 0m);
    var totalCharges = rows.Sum(x => x.charge ?? 0m);
    var totalAmount = rows.Sum(x => x.amt ?? 0m);
    var totalNet = rows.Sum(x => x.finalpay ?? 0m);
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>UPI Transfer Report</title>
    <style type="text/css">
        @@page { size: A4 landscape; margin: 10mm 8mm 12mm 8mm; }
        * { box-sizing: border-box; }
        body { margin:0; padding:16px; font-family:Arial,Helvetica,sans-serif; font-size:11px; color:#0f172a; background:#fff; -webkit-print-color-adjust:exact; print-color-adjust:exact; }
        table { page-break-inside:auto; border-collapse:collapse; }
        tr { page-break-inside:avoid; page-break-after:auto; }
        thead { display:table-header-group; }
        .sheet { width:100%; }
        .hero { width:100%; border:1px solid #1d4ed8; overflow:hidden; }
        .hero-top { padding:14px 18px; background:#2563eb; color:#fff; }
        .hero-top h1 { margin:0; font-size:20px; font-weight:700; }
        .hero-top p { margin:4px 0 0; font-size:11px; color:#dbeafe; }
        .meta { width:100%; background:#f8fafc; border-top:1px solid #bfdbfe; }
        .meta td { padding:8px 12px; border-right:1px solid #e2e8f0; vertical-align:top; }
        .meta td:last-child { border-right:none; }
        .meta-label { display:block; font-size:9px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:#64748b; margin-bottom:3px; }
        .meta-value { font-size:12px; font-weight:700; color:#0f172a; }
        .cards { width:100%; margin:12px 0; }
        .cards td { width:25%; padding:0 6px 0 0; }
        .cards td:last-child { padding-right:0; }
        .card { border:1px solid #e2e8f0; padding:10px 12px; }
        .card-label { display:block; font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; margin-bottom:4px; }
        .card-value { font-size:16px; font-weight:800; }
        .card-ok { background:#ecfdf5; border-color:#a7f3d0; }
        .card-ok .card-label, .card-ok .card-value { color:#047857; }
        .card-wait { background:#fefce8; border-color:#fde68a; }
        .card-wait .card-label, .card-wait .card-value { color:#854d0e; }
        .card-fail { background:#fef2f2; border-color:#fecaca; }
        .card-fail .card-label, .card-fail .card-value { color:#b91c1c; }
        .card-charge { background:#eff6ff; border-color:#bfdbfe; }
        .card-charge .card-label, .card-charge .card-value { color:#1d4ed8; }
        .grid { width:100%; border:1px solid #cbd5e1; }
        .grid th { padding:9px 7px; text-align:left; font-size:10px; font-weight:700; text-transform:uppercase; color:#fff; background:#334155; border-right:1px solid #1e293b; white-space:nowrap; }
        .grid td { padding:8px 7px; font-size:11px; color:#1e293b; border-top:1px solid #e2e8f0; border-right:1px solid #e2e8f0; }
        .grid tbody tr:nth-child(even) td { background:#f8fafc; }
        .num { text-align:right; font-variant-numeric:tabular-nums; white-space:nowrap; }
        .badge { display:inline-block; min-width:58px; padding:3px 8px; font-size:10px; font-weight:700; text-align:center; }
        .badge-ok { background:#ecfdf5; color:#047857; }
        .badge-fail { background:#fee2e2; color:#b91c1c; }
        .badge-wait { background:#fef9c3; color:#854d0e; }
        .total-row td { background:#eff6ff !important; font-weight:700; color:#1d4ed8; }
        .empty { padding:36px 16px; text-align:center; font-size:14px; font-weight:700; color:#64748b; background:#f8fafc; }
        .foot { margin-top:10px; padding-top:8px; border-top:1px dashed #cbd5e1; font-size:10px; color:#94a3b8; text-align:center; }
    </style>
</head>
<body>
<div class="sheet">
    <div class="hero">
        <div class="hero-top">
            <h1>UPI Transfer Report</h1>
            <p>Dealer fund transfer - add wallet by UPI QR code</p>
        </div>
        <table class="meta" cellpadding="0" cellspacing="0">
            <tr>
                <td style="width:28%;"><span class="meta-label">Generated On</span><span class="meta-value">@generatedOn</span></td>
                <td style="width:44%;"><span class="meta-label">Date Range</span><span class="meta-value">@frmDate to @toDate</span></td>
                <td style="width:28%;"><span class="meta-label">Records</span><span class="meta-value">@rows.Count</span></td>
            </tr>
        </table>
    </div>

    <table class="cards" cellpadding="0" cellspacing="0">
        <tr>
            <td><div class="card card-ok"><span class="card-label">Total Success</span><span class="card-value">@totalSuccess.ToString("N2")</span></div></td>
            <td><div class="card card-wait"><span class="card-label">Total Pending</span><span class="card-value">@totalPending.ToString("N2")</span></div></td>
            <td><div class="card card-fail"><span class="card-label">Total Failed</span><span class="card-value">@totalFailed.ToString("N2")</span></div></td>
            <td><div class="card card-charge"><span class="card-label">Total Charges</span><span class="card-value">@totalCharges.ToString("N2")</span></div></td>
        </tr>
    </table>

    <table class="grid" cellpadding="0" cellspacing="0">
        <thead>
            <tr>
                <th>Status</th>
                <th>Payer Name</th>
                <th>Amount</th>
                <th>Charges</th>
                <th>Net Received</th>
                <th>Bank RRN</th>
                <th>Transaction Time</th>
            </tr>
        </thead>
        <tbody>
            @if (rows.Any())
            {
                foreach (var item in rows)
                {
                    var statusRaw = item.status ?? "";
                    var badge = "badge-wait";
                    var statusLabel = string.IsNullOrWhiteSpace(statusRaw) ? "-" : statusRaw;
                    if (statusRaw.IndexOf("SUCCESS", StringComparison.OrdinalIgnoreCase) >= 0) { badge = "badge-ok"; statusLabel = "Success"; }
                    else if (statusRaw.IndexOf("FAILED", StringComparison.OrdinalIgnoreCase) >= 0) { badge = "badge-fail"; statusLabel = "Failed"; }
                    else if (statusRaw.IndexOf("PENDING", StringComparison.OrdinalIgnoreCase) >= 0) { badge = "badge-wait"; statusLabel = "Pending"; }

                    <tr>
                        <td><span class="badge @badge">@statusLabel</span></td>
                        <td>@(string.IsNullOrWhiteSpace(item.PayerName) ? "-" : item.PayerName)</td>
                        <td class="num">@((item.amt ?? 0m).ToString("N2"))</td>
                        <td class="num">@((item.charge ?? 0m).ToString("N2"))</td>
                        <td class="num">@((item.finalpay ?? 0m).ToString("N2"))</td>
                        <td>@(string.IsNullOrWhiteSpace(item.BankRRN) ? "-" : item.BankRRN)</td>
                        <td>@(item.txndate.HasValue ? item.txndate.Value.ToString("dd-MMM-yyyy HH:mm:ss") : "-")</td>
                    </tr>
                }
                <tr class="total-row">
                    <td colspan="2">Total</td>
                    <td class="num">@totalAmount.ToString("N2")</td>
                    <td class="num">@totalCharges.ToString("N2")</td>
                    <td class="num">@totalNet.ToString("N2")</td>
                    <td colspan="2">&nbsp;</td>
                </tr>
            }
            else
            {
                <tr>
                    <td colspan="7" class="empty">UPI transaction not found for the selected date range.</td>
                </tr>
            }
        </tbody>
    </table>
    <div class="foot">Generated from Dealer panel - UPI Transfer Report</div>
</div>
</body>
</html>
