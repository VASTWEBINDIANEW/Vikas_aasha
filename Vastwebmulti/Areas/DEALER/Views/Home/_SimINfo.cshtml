@model Vastwebmulti.Models.SimDetail_Info
@using System.Linq

@{
    var rows = Model?.data1 ?? Enumerable.Empty<Vastwebmulti.Models.dealer_sim_new>();
    var rowCount = rows.Count();
    var msg = (Model?.message ?? "").Trim();
    var msgIsError = !string.IsNullOrEmpty(msg) &&
        (msg.IndexOf("wrong", StringComparison.OrdinalIgnoreCase) >= 0 ||
         msg.IndexOf("fail", StringComparison.OrdinalIgnoreCase) >= 0 ||
         msg.IndexOf("error", StringComparison.OrdinalIgnoreCase) >= 0 ||
         msg.IndexOf("contact", StringComparison.OrdinalIgnoreCase) >= 0);
}

<div id="divEditFormComm">
    @if (!string.IsNullOrEmpty(msg))
    {
        <div class="vm-sim-msg-banner@(msgIsError ? " vm-sim-msg-banner--error" : "")" role="status">@msg</div>
    }

    <div class="vm-opr-table-wrap">
        <div class="table-responsive vm-opr-table-scroll">
            <table id="dealerSimTable" class="table vm-opr-data-table" cellspacing="0">
                <thead>
                    <tr>
                        <th>User ID</th>
                        <th>IMEI Number</th>
                        <th>Remark</th>
                        <th>E-TOP &#8377;</th>
                        <th>Operator</th>
                        <th>Day Limit</th>
                        <th>Min Bal</th>
                        <th>Status</th>
                        <th>CHK &#8377;</th>
                        <th>Login</th>
                        <th>Edit</th>
                        <th>Delete</th>
                    </tr>
                </thead>
                <tbody>
                    @if (rowCount > 0)
                    {
                        foreach (var i in rows)
                        {
                            <tr class="vm-sim-row">
                                <td>@i.USERID</td>
                                <td>@i.Imeino</td>
                                <td>@i.Remark</td>
                                <td>@i.remaining</td>
                                <td>@i.opt_code</td>
                                <td>@i.DaylimitMax</td>
                                <td>@i.Etopminbal</td>
                                <td id="updatestatusd1">
                                    @if (i.status == true)
                                    {
                                        <button type="button" class="vm-sim-status-btn vm-sim-status-btn--on" onclick="ONOFFS('OFF',@i.idno)">ON</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="vm-sim-status-btn vm-sim-status-btn--off" onclick="ONOFFS('ON',@i.idno)">OFF</button>
                                    }
                                </td>
                                <td>
                                    <button type="button" class="vm-sim-icon-btn" onclick="Checkbal('@i.idno')" title="Check balance">
                                        <img src="~/ashok-images/icons8-ok-30.png" alt="Check balance" />
                                    </button>
                                </td>
                                <td>
                                    <button type="button" class="vm-sim-icon-btn vm-sim-icon-btn--login" onclick="LoginbbySim(@i.idno)" title="Login">
                                        <img src="~/ashok-images/icons8-login-64.png" alt="Login" />
                                    </button>
                                </td>
                                <td>
                                    <button type="button" class="vm-sim-action-btn" data-toggle="modal" data-target="#defaultModal2212" id="myBtn1" onclick="Editcollw(@i.idno)">Edit</button>
                                </td>
                                <td>
                                    <button type="button" class="vm-sim-action-btn vm-sim-action-btn--delete" onclick="ONOFFS('DELETE',@i.idno)">Delete</button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr class="vm-sim-empty-row">
                            <td colspan="12">No SIM registered yet. Click <strong>Add New SIM</strong> to register.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div style="display:none" id="updatestatusd" class="vm-sim-overlay" aria-hidden="true">
        <div class="vm-sim-overlay-card">
            @using (Ajax.BeginForm("simonoff", "Home", new AjaxOptions { HttpMethod = "POST", OnSuccess = "OnSuccess3", OnFailure = "onfailed3", UpdateTargetId = "divEditFormComm", LoadingElementId = "div_Loader", InsertionMode = InsertionMode.Replace }))
            {
                <h4 class="vm-sim-overlay-title">Are you sure?</h4>
                <div id="updatestatusd11"></div>
                <div id="updatestatusd12"></div>
                <div class="vm-sim-overlay-actions">
                    <input type="submit" class="saas-acc-btn saas-acc-btn--search" value="Confirm" />
                    <button type="button" class="saas-acc-btn saas-acc-btn--ghost" onclick="document.getElementById('updatestatusd').style.display = 'none'">Cancel</button>
                </div>
            }
        </div>
    </div>

    <div style="display:none" id="updatestatusd23" class="vm-sim-overlay" aria-hidden="true">
        <div class="vm-sim-overlay-card">
            <div id="LOGINMESSAGE12" class="vm-sim-overlay-msg"></div>
            <div class="vm-sim-overlay-actions">
                <button type="button" class="saas-acc-btn saas-acc-btn--ghost" onclick="document.getElementById('updatestatusd23').style.display = 'none'">Close</button>
            </div>
        </div>
    </div>

    <div style="display:none" id="updatestatusd342" class="vm-sim-overlay input_set" aria-hidden="true">
        <div class="vm-sim-overlay-card">
            <h4 class="vm-sim-overlay-title">Enter OTP</h4>
            <input type="number" name="name" value="" />
            <div class="vm-sim-overlay-actions">
                <button type="submit" class="saas-acc-btn saas-acc-btn--search">Submit</button>
            </div>
        </div>
    </div>
</div>
