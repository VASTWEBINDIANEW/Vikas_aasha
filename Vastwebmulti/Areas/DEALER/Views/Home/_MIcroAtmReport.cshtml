@model IEnumerable<Vastwebmulti.Models.microatm_report_Result>
@using System.Linq
@{
    Layout = null;
    var items = Model ?? Enumerable.Empty<Vastwebmulti.Models.microatm_report_Result>();
}
@if (items.Any())
{
    foreach (var item in items)
    {
        var statusRaw = item.status ?? "";
        var statusTone = "pending";
        var statusLabel = statusRaw;
        var statusFa = "fa-clock-o";
        if (statusRaw.IndexOf("FAILED", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "failed";
            statusLabel = "Failed";
            statusFa = "fa-times";
        }
        else if (statusRaw.IndexOf("SUCCESS", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "success";
            statusLabel = "Success";
            statusFa = "fa-check";
        }
        else if (statusRaw.IndexOf("PENDING", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "pending";
            statusLabel = "Pending";
            statusFa = "fa-clock-o";
        }

        decimal comm = 0;
        var txnType = item.transaction_type ?? "";
        if (statusRaw.IndexOf("SUCCESS", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            if (string.Equals(txnType, "microatm", StringComparison.OrdinalIgnoreCase))
            {
                comm = (item.Retailer_comm ?? 0) + (item.Retailer_gst ?? 0) + (item.Retailer_tds ?? 0);
            }
            else if (string.Equals(txnType, "purchase", StringComparison.OrdinalIgnoreCase))
            {
                comm = ((item.amount ?? 0) * (item.Retailer_comm ?? 0)) / 100;
            }
        }

        var txnDate = item.transtime.HasValue ? item.transtime.Value.ToString("dd-MMM HH:mm:ss") : "—";
        var amt = item.amount ?? 0;
        <tr class="vm-dmt-row vm-dmt-row--@statusTone" data-status="@statusRaw" data-amount="@amt.ToString(System.Globalization.CultureInfo.InvariantCulture)">
            <td class="vm-radiant-status-cell vm-ticket-status-cell">
                <span class="vm-dmt-status vm-dmt-status--@statusTone" title="@statusLabel">
                    <i class="fa @statusFa" aria-hidden="true"></i>
                </span>
                <span class="vm-radiant-status-text">@statusLabel</span>
            </td>
            <td>@(item.Frm_Name ?? "—")</td>
            <td class="vm-dmt-amt-cell">@(item.amount.HasValue ? item.amount.Value.ToString("N2") : "—")</td>
            <td>@txnDate</td>
            <td>@(item.rrn ?? "—")</td>
            <td>@(string.IsNullOrWhiteSpace(txnType) ? "—" : txnType)</td>
            <td>@(item.card_payment_type ?? "—")</td>
            <td>@(item.masked_pan ?? "—")</td>
            <td>@(item.network ?? "—")</td>
            <td class="vm-dmt-amt-cell">@(item.retailer_remain_pre.HasValue ? item.retailer_remain_pre.Value.ToString("N2") : "—")</td>
            <td class="vm-dmt-amt-cell">@comm.ToString("N2")</td>
            <td class="vm-dmt-amt-cell">@(item.Retailer_gst.HasValue ? item.Retailer_gst.Value.ToString("N2") : "—")</td>
            <td class="vm-dmt-amt-cell">@(item.Retailer_tds.HasValue ? item.Retailer_tds.Value.ToString("N2") : "—")</td>
            <td class="vm-dmt-amt-cell">@(item.retailer_remain_post.HasValue ? item.retailer_remain_post.Value.ToString("N2") : "—")</td>
        </tr>
    }
}
else
{
    <tr class="vm-opr-table-empty-row">
        <td colspan="14" class="vm-opr-table-empty">
            <i class="fas fa-university" aria-hidden="true"></i>
            <span>MicroATM report not found.</span>
        </td>
    </tr>
}
