@model IEnumerable<Vastwebmulti.Models.DTHConnection_Report_New_Result>
@using System.Linq
@{
    Layout = null;
    var rows = (Model ?? Enumerable.Empty<Vastwebmulti.Models.DTHConnection_Report_New_Result>()).ToList();
    var generatedOn = DateTime.Now.ToString("dd MMM yyyy, hh:mm tt");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>DTH Booking Report</title>
    <style type="text/css">
        @@page { size: A4 landscape; margin: 12mm 10mm 14mm 10mm; }
        * { box-sizing: border-box; }
        body { margin:0; padding:0; font-family:Arial,Helvetica,sans-serif; font-size:10px; color:#1e293b; background:#fff; -webkit-print-color-adjust:exact; print-color-adjust:exact; }
        table { page-break-inside:auto; border-collapse:collapse; }
        tr { page-break-inside:avoid; page-break-after:auto; }
        thead { display:table-header-group; }
        .vm-ml-pdf { width:100%; }
        .vm-ml-pdf__header { width:100%; margin-bottom:14px; border:1px solid #dbe2ea; border-radius:10px; overflow:hidden; }
        .vm-ml-pdf__hero { padding:12px 20px; background:#2563eb; background:linear-gradient(135deg,#2563eb 0%,#4f46e5 100%); color:#fff; }
        .vm-ml-pdf__title { margin:0; font-size:16px; font-weight:700; }
        .vm-ml-pdf__subtitle { margin:3px 0 0; font-size:10px; opacity:.9; }
        .vm-ml-pdf__meta { width:100%; border-top:1px solid #e2e8f0; background:#f8fafc; }
        .vm-ml-pdf__meta td { padding:7px 10px; border-right:1px solid #e2e8f0; }
        .vm-ml-pdf__meta td:last-child { border-right:none; }
        .vm-ml-pdf__meta-label { display:block; font-size:8px; font-weight:700; text-transform:uppercase; letter-spacing:.06em; color:#64748b; margin-bottom:2px; }
        .vm-ml-pdf__meta-value { font-size:10px; font-weight:700; color:#0f172a; }
        .vm-ml-pdf__table-wrap { width:100%; border:1px solid #dbe2ea; border-radius:10px; overflow:hidden; }
        .vm-ml-pdf__table { width:100%; border:none; }
        .vm-ml-pdf__table thead th { padding:8px 6px; text-align:left; font-size:8px; font-weight:700; text-transform:uppercase; color:#fff; background:#334155; border-bottom:2px solid #1e293b; white-space:nowrap; }
        .vm-ml-pdf__table tbody td { padding:7px 6px; border-bottom:1px solid #e2e8f0; font-size:9px; color:#334155; }
        .vm-ml-pdf__table tbody tr:nth-child(even) td { background:#f8fafc; }
        .vm-ml-pdf__empty { padding:24px 16px; text-align:center; color:#64748b; font-size:11px; font-weight:600; }
        .vm-ml-pdf__footer { margin-top:10px; padding-top:7px; border-top:1px dashed #dbe2ea; font-size:8.5px; color:#94a3b8; text-align:center; }
        .vm-ml-pdf__badge { display:inline-block; min-width:44px; padding:3px 8px; border-radius:999px; font-size:8px; font-weight:700; }
        .vm-ml-pdf__badge--success { background:#ecfdf5; color:#047857; }
        .vm-ml-pdf__badge--fail { background:#fee2e2; color:#b91c1c; }
        .vm-ml-pdf__badge--pending { background:#fef9c3; color:#854d0e; }
    </style>
</head>
<body>
<div class="vm-ml-pdf">
    <div class="vm-ml-pdf__header">
        <div class="vm-ml-pdf__hero">
            <h1 class="vm-ml-pdf__title">DTH Booking Report</h1>
            <p class="vm-ml-pdf__subtitle">Dealer prepaid &amp; utilities &mdash; DTH connection bookings</p>
        </div>
        <table class="vm-ml-pdf__meta" cellpadding="0" cellspacing="0">
            <tr>
                <td style="width:33%;"><span class="vm-ml-pdf__meta-label">Generated On</span><span class="vm-ml-pdf__meta-value">@generatedOn</span></td>
                <td style="width:33%;"><span class="vm-ml-pdf__meta-label">Total Records</span><span class="vm-ml-pdf__meta-value">@rows.Count</span></td>
                <td style="width:34%;"><span class="vm-ml-pdf__meta-label">Report Type</span><span class="vm-ml-pdf__meta-value">DTH Booking</span></td>
            </tr>
        </table>
    </div>
    <div class="vm-ml-pdf__table-wrap">
        @if (rows.Any())
        {
            <table class="vm-ml-pdf__table" cellpadding="0" cellspacing="0">
                <thead>
                    <tr>
                        <th>Customer Id</th>
                        <th>Status</th>
                        <th>Amount</th>
                        <th>Customer Name</th>
                        <th>Mobile</th>
                        <th>DTH Title</th>
                        <th>Plan</th>
                        <th>Dealer Pre</th>
                        <th>Dealer Post</th>
                        <th>Dealer Comm</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in rows)
                    {
                        var statusRaw = item.Status ?? "";
                        var badge = "vm-ml-pdf__badge--pending";
                        if (statusRaw.IndexOf("Success", StringComparison.OrdinalIgnoreCase) >= 0) { badge = "vm-ml-pdf__badge--success"; }
                        else if (statusRaw.IndexOf("Failed", StringComparison.OrdinalIgnoreCase) >= 0 || statusRaw.IndexOf("Refund", StringComparison.OrdinalIgnoreCase) >= 0) { badge = "vm-ml-pdf__badge--fail"; }
                        var firm = !string.IsNullOrWhiteSpace(item.Frm_Name) ? item.Frm_Name : (item.Email ?? "—");
                        <tr>
                            <td>@firm</td>
                            <td><span class="vm-ml-pdf__badge @badge">@statusRaw</span></td>
                            <td>@(item.Amount.HasValue ? item.Amount.Value.ToString("N2") : "—")</td>
                            <td>@(item.CustomerName ?? "—")</td>
                            <td>@(item.CustomerMobile ?? "—")</td>
                            <td>@(item.DTHTitle ?? "—")</td>
                            <td>@(item.Dthplanname ?? "—")</td>
                            <td>@(item.DealerPre.HasValue ? item.DealerPre.Value.ToString("N2") : "—")</td>
                            <td>@(item.DealerPost.HasValue ? item.DealerPost.Value.ToString("N2") : "—")</td>
                            <td>@(item.Dlm_Comm.HasValue ? item.Dlm_Comm.Value.ToString("N2") : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="vm-ml-pdf__empty">DTH booking report not found.</div>
        }
    </div>
    <div class="vm-ml-pdf__footer">Generated from Dealer panel &mdash; DTH Booking Report</div>
</div>
</body>
</html>
