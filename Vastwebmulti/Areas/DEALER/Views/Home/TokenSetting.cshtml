<nav class="vm-opr-nav--page" aria-label="Token pages">
    <a class="vm-opr-nav__link" href="@Url.Action("usedTokens", "Home")">Used Token</a>
    <a class="vm-opr-nav__link" href="@Url.Action("TokenPurchase", "Home")">Purchase Token</a>
</nav>
<script type="text/javascript">
    $(document).ready(function () {
        var path = (location.pathname || '').toLowerCase();
        $('.vm-opr-nav--page .vm-opr-nav__link').each(function () {
            var href = (this.getAttribute('href') || '').toLowerCase();
            var segment = href.substring(href.lastIndexOf('/'));
            if (segment && path.indexOf(segment) !== -1) {
                $(this).addClass('is-active');
            }
        });
    });
</script>
