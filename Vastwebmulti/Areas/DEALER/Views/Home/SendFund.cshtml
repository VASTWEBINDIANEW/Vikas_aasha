<script type="text/javascript">
    function sendFundSyncTabActive($tabs, $activeLi) {
        if (!$tabs || !$tabs.length || !$activeLi || !$activeLi.length) { return; }
        $tabs.find('li').removeClass('current active');
        $activeLi.addClass('active');
        $tabs.find('li > a').attr('aria-expanded', 'false');
        $activeLi.find('> a').attr('aria-expanded', 'true');
    }

    $(document).ready(function () {
        sendFundSyncTabActive($('#sendFundLeftTabs'), $('#sendFundLeftTabs li.active').first());
        sendFundSyncTabActive($('#sendFundRightTabs'), $('#sendFundRightTabs li.active').first());

        $('#sendFundLeftTabs a[data-toggle="tab"]').on('show.bs.tab', function () {
            $('#sendFundLeftTabs li').removeClass('current');
        });
        $('#sendFundLeftTabs a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
            sendFundSyncTabActive($('#sendFundLeftTabs'), $(e.target).closest('li'));
        });

        $('#sendFundRightTabs a[data-toggle="tab"]').on('show.bs.tab', function () {
            $('#sendFundRightTabs li').removeClass('current');
        });

        $('#sendFundTopLeftTabs').on('click', 'li.tab-link, li.tab-link a', function (e) {
            e.preventDefault();
            var $li = $(this).closest('li.tab-link');
            if (!$li.length) {
                return;
            }
            var tab_id = $li.attr('data-tab');
            $('#sendFundTopLeftTabs li.tab-link').removeClass('current active');
            $('#sendFundTopLeftTabs li.tab-link a').attr('aria-expanded', 'false');
            $li.addClass('current active');
            $li.find('a').attr('aria-expanded', 'true');
            $('.vm-dealer-sendfund-top-body > .tab-content').removeClass('current');
