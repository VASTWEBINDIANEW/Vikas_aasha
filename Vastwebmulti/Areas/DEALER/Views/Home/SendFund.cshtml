<script>
    function sendFundGetRightTabType($li) {
        var href = ($li && $li.attr('data-href')) ? $li.attr('data-href') : '';
        var match = href.match(/tabtype=([^&]+)/);
        return match ? match[1] : '';
    }

    window.sendFundLoadRightGrid = function ($li, fromDate, toDate) {
        if (!$li || !$li.length) { return; }
        var tabtype = sendFundGetRightTabType($li);
        if (!tabtype) { return; }

        if (tabtype === 'FUNDRecived') {
            $.ajax({
                type: 'POST',
                url: "@Url.Action("Filterrecivedrequestfilterdate", "Home")",
                data: { txt_frm_daterecived: fromDate, txt_to_daterecived: toDate },
                success: function (data) {
                    $('#tblRecivedPurchaseReq').html(data);
                    if (typeof window.sendFundUpdateRecordCount === 'function') {
                        window.sendFundUpdateRecordCount();
                    }
                }
            });
            return;
        }

        $.ajax({
            url: "@Url.Action("BindAllFundGrid", "Home")",
            data: { tabtype: tabtype, txt_frm_daterecived: fromDate, txt_to_daterecived: toDate },
            success: function (data) {
                if (tabtype === 'FUNDTORETailer') {
                    $('#tblfundtransfer').html(data);
                } else if (tabtype === 'FUNDTOMD') {
                    $('#tblsendREquest').html(data);
                }
                if (typeof window.sendFundUpdateRecordCount === 'function') {
                    window.sendFundUpdateRecordCount();
                }
            }
        });
    };

    $('.tabChangeType').click(function () {
        window.sendFundLoadRightGrid($(this), $('#txt_frm_daterecived').val(), $('#txt_to_daterecived').val());
    });

    $('#sendFundRightDateSearch').on('click', function () {
        var $active = $('#sendFundRightTabs li.active, #sendFundRightTabs li.current').first();
        window.sendFundLoadRightGrid($active, $('#txt_frm_daterecived').val(), $('#txt_to_daterecived').val());
    });

    function chkfillform(data) {
        $('#myModalaccept').modal('hide');
        $('#tblRecivedPurchaseReq').html(data);
        if (typeof window.sendFundUpdateRecordCount === 'function') {
            window.sendFundUpdateRecordCount();
        }
    }

</script>

