<script>
    window.fillSendFundLinkedField = function (selectEl) {
        if (!selectEl || !selectEl.id) { return; }
        var map = {
            dealermdbank: 'txtmddistaccount',
            mdwallet: 'txtmddistwalletno',
            ddlAdminAccountname: 'txtAdminACCOUNTNO',
            ddlAdminWallettname: 'txtAdminWALLETNO',
            ddMDaccountname: 'txtMDACCOUNTNO',
            ddlMDWalletname: 'txtMDWALLETNO'
        };
        var inputId = map[selectEl.id];
        if (!inputId) { return; }
        var input = document.getElementById(inputId);
        if (!input) { return; }
        var val = (selectEl.value || '').trim();
        if (!val || val === '0' || val.toLowerCase().indexOf('select') >= 0) {
            input.value = '';
            return;
        }
        input.value = val;
        if (window.jQuery) {
            window.jQuery(input).trigger('input').trigger('change');
        }
    };

    function bindSendFundLinkedFields() {
        var $ = window.jQuery;
        if (!$) { return; }
        $(document).off('change.sendFundLinked select2:select.sendFundLinked', '#dealermdbank, #mdwallet, #ddlAdminAccountname, #ddlAdminWallettname, #ddMDaccountname, #ddlMDWalletname');
        $(document).on('change.sendFundLinked select2:select.sendFundLinked', '#dealermdbank, #mdwallet, #ddlAdminAccountname, #ddlAdminWallettname, #ddMDaccountname, #ddlMDWalletname', function () {
            window.fillSendFundLinkedField(this);
        });
    }

    $(document).ready(function () {
        if ($.fn.select2) {
            $('.for-select2').select2({
                dropdownCssClass: 'vm-sendfund-select2-drop'
            });
        }
        bindSendFundLinkedFields();
    });
</script>

<script>
    (function ($) {
        function sendFundGetActiveListTab() {
            return $('#sendFundRightTabs li.active, #sendFundRightTabs li.current').first();
        }

        function sendFundGetActiveTableTitle() {
            var $active = sendFundGetActiveListTab();
            return $active.data('title') || 'Fund Transfer To Retailer';
        }

        function sendFundGetActivePane() {
            var $tab = sendFundGetActiveListTab();
            var tabId = $tab.data('tab') || 'fundtrans';
            return $('#' + tabId);
        }

        function sendFundGetActiveTable() {
            var $pane = sendFundGetActivePane();
            return $pane.find('table').first();
        }

        window.sendFundUpdateRecordCount = function () {
            var $tab = sendFundGetActiveListTab();
            var $pane = sendFundGetActivePane();
            var $rows = $pane.find('table tbody tr').not('.vm-dealer-bankinfo-empty-row');
            var total = $rows.length;
            var visible = $rows.filter(':visible').length;
            $('#sendFundRecordCount').text(visible);
            $('#sendFundTotalCount').text(total);
            $('#sendFundVisibleCount').text(visible);
            var title = sendFundGetActiveTableTitle();
            $('#sendFundActiveSection').text(title);
            $('#sendFundTotalsTitle').text(title + ' — Summary');
            $('#sendFundPanelTitle').text(title);
        };

        function sendFundFilterActiveTable(term) {
            var q = (term || '').toLowerCase().trim();
            var $pane = sendFundGetActivePane();
            $pane.find('table tbody tr').each(function () {
                if ($(this).hasClass('vm-dealer-bankinfo-empty-row')) {
                    return;
                }
                var text = $(this).text().toLowerCase();
                $(this).toggle(q === '' || text.indexOf(q) > -1);
            });
            sendFundUpdateRecordCount();
        }

        function sendFundHideTotals() {
            $('#sendFundTotalsPanel').slideUp(180).attr('aria-hidden', 'true');
            $('#sendFundTotalsBtn').attr('aria-expanded', 'false');
        }

        function sendFundToggleTotals() {
            var $panel = $('#sendFundTotalsPanel');
            if ($panel.is(':visible')) {
                sendFundHideTotals();
                return;
            }
            sendFundUpdateRecordCount();
            $panel.slideDown(180).attr('aria-hidden', 'false');
            $('#sendFundTotalsBtn').attr('aria-expanded', 'true');
        }

        function sendFundEsc(value) {
            return String(value == null ? '' : value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;');
        }

        function sendFundCollectExportRows($table) {
            var headers = [];
            $table.find('thead th').each(function () {
                if ($(this).text().trim().toLowerCase() === 'action') {
                    return;
                }
                headers.push($(this).text().trim());
            });

            var rows = [];
            $table.find('tbody tr:visible').each(function () {
                if ($(this).hasClass('vm-dealer-bankinfo-empty-row')) {
                    return;
                }
                var cells = [];
                $(this).find('td').each(function () {
                    if ($(this).hasClass('vm-dealer-bankinfo-action-col')) {
                        return;
                    }
                    cells.push($(this).text().trim());
                });
                if (cells.length) {
                    rows.push(cells);
                }
            });

            return { headers: headers, rows: rows };
        }

        function sendFundExportStyles() {
            return 'body{font-family:Segoe UI,Arial,sans-serif;padding:24px;color:#0f172a;background:#fff;}'
                + '.vm-block-export-head{margin:0 0 18px;padding-bottom:14px;border-bottom:2px solid #e2e8f0;}'
                + '.vm-block-export-head h3{margin:0 0 6px;font-size:22px;font-weight:700;color:#1e293b;}'
                + '.vm-block-export-head p{margin:0;font-size:13px;color:#64748b;line-height:1.5;}'
                + 'table{border-collapse:collapse;width:100%;font-size:12px;}'
                + 'th,td{border:1px solid #dbe4f0;padding:8px 10px;text-align:center;vertical-align:middle;}'
                + 'th{background:linear-gradient(180deg,#f8fafc 0%,#eef2f7 100%);color:#334155;font-weight:700;}';
        }

        function sendFundBuildExportHtml(title, data) {
            var body = '';
            for (var i = 0; i < data.rows.length; i++) {
                body += '<tr>';
                for (var c = 0; c < data.rows[i].length; c++) {
                    body += '<td>' + sendFundEsc(data.rows[i][c]) + '</td>';
                }
                body += '</tr>';
            }

            var head = '';
            for (var h = 0; h < data.headers.length; h++) {
                head += '<th>' + sendFundEsc(data.headers[h]) + '</th>';
            }

            return '<html><head><meta charset="utf-8"><title>' + sendFundEsc(title) + '</title>'
                + '<style>' + sendFundExportStyles() + '</style></head><body>'
                + '<div class="vm-block-export-head"><h3>' + sendFundEsc(title) + '</h3>'
                + '<p>Generated on ' + sendFundEsc(new Date().toLocaleString()) + '</p></div>'
                + '<table><thead><tr>' + head + '</tr></thead><tbody>' + body + '</tbody></table></body></html>';
        }

        function sendFundWarnNoRecords() {
            if (typeof swal === 'function') {
                swal('No records to export', '', 'warning');
                return;
            }
            window.alert('No records to export');
        }

        function sendFundExportExcel() {
            var $table = sendFundGetActiveTable();
            var data = sendFundCollectExportRows($table);
            if (!data.rows.length) {
                sendFundWarnNoRecords();
                return;
            }
            var title = sendFundGetActiveTableTitle();
            var html = sendFundBuildExportHtml(title, data);
            var blob = new Blob(['\ufeff', html], { type: 'application/vnd.ms-excel;charset=utf-8;' });
            if (window.navigator && window.navigator.msSaveOrOpenBlob) {
                window.navigator.msSaveOrOpenBlob(blob, 'Send_Fund_Report.xls');
                return;
            }
            var url = URL.createObjectURL(blob);
            var link = document.createElement('a');
            link.href = url;
            link.download = 'Send_Fund_Report.xls';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            setTimeout(function () { URL.revokeObjectURL(url); }, 800);
        }

        function sendFundExportPdf() {
            var $table = sendFundGetActiveTable();
            var data = sendFundCollectExportRows($table);
            if (!data.rows.length) {
                sendFundWarnNoRecords();
                return;
            }
            var title = sendFundGetActiveTableTitle();
            var w = window.open('', '_blank');
            if (!w) {
                return;
            }
            w.document.open();
            w.document.write(sendFundBuildExportHtml(title, data));
            w.document.close();
            w.focus();
            setTimeout(function () { w.print(); }, 400);
        }

        $(function () {
            $('#sendFundTableSearch').on('input', function () {
                sendFundFilterActiveTable($(this).val());
            });

            $('#sendFundTotalsBtn').on('click', sendFundToggleTotals);
            $('#sendFundTotalsHideBtn').on('click', sendFundHideTotals);
            $('#sendFundExportExcel').on('click', sendFundExportExcel);
            $('#sendFundExportPdf').on('click', sendFundExportPdf);

            $('#sendFundRightTabs a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
                sendFundSyncTabActive($('#sendFundRightTabs'), $(e.target).closest('li'));
                sendFundHideTotals();
                $('#sendFundTableSearch').val('');
                sendFundFilterActiveTable('');
            });

            sendFundUpdateRecordCount();
        });
    })(jQuery);
</script>