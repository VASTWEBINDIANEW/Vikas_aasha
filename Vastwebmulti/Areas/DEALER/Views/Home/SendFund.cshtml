<script>
    function bootSendFundDatepickers() {
        var $ = window.jQuery;
        if (!$ || !$.fn || !$.fn.datepicker) {
            window.setTimeout(bootSendFundDatepickers, 50);
            return;
        }

        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm('#sendFundHistoryForm1', null, null, true);
            window.initAdminReportDateForm('#sendFundHistoryForm2', '#txt_frm_datee', '#txt_to_datee', true);
            window.initAdminReportDateForm('#sendFundPurchaseDateForm', '#txt_frm_date1', '#txt_to_date1', true);
            window.initAdminReportDateForm('#sendFundRightDateForm', '#txt_frm_daterecived', '#txt_to_daterecived', true);
        }

        function sendFundFixDatepickerLayout() {
            var $dp = $('body > .datepicker.dropdown-menu:visible').last();
            if (!$dp.length) {
                $dp = $('.datepicker.dropdown-menu:visible, .datepicker:visible').last();
            }
            if (!$dp.length) {
                return;
            }

            var el = $dp[0];
            el.classList.add('vm-sendfund-dp');
            el.style.setProperty('min-width', '296px', 'important');
            el.style.setProperty('width', '296px', 'important');
