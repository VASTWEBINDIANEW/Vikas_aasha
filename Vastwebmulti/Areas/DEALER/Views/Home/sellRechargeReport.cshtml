                        <label>Status</label>
                        <div class="vm-dmt-modal-readonly vm-dth-detail-status" id="sellRchDetStatus">—</div>
                    </div>
                    <div class="vm-dmt-modal-field">
                        <label>Consumer</label>
                        <div class="vm-dmt-modal-readonly" id="sellRchDetConsumer">—</div>
                    </div>
                    <div class="vm-dmt-modal-field">
                        <label>Operator</label>
                        <div class="vm-dmt-modal-readonly" id="sellRchDetOperator">—</div>
                    </div>
                    <div class="vm-dmt-modal-field">
                        <label>Net Amount</label>
                        <div class="vm-dmt-modal-readonly" id="sellRchDetAmount">—</div>
                    </div>
                    <div class="vm-dmt-modal-field">
                        <label>Earn</label>
                        <div class="vm-dmt-modal-readonly" id="sellRchDetEarn">—</div>
                    </div>
                    <div class="vm-dmt-modal-field">
                        <label>Remain Pre</label>
                        <div class="vm-dmt-modal-readonly" id="sellRchDetPre">—</div>
                    </div>
                    <div class="vm-dmt-modal-field">
                        <label>Remain Pos</label>
                        <div class="vm-dmt-modal-readonly" id="sellRchDetPost">—</div>
                    </div>
                    <div class="vm-dmt-modal-field">
                        <label>Txn Id</label>
                        <div class="vm-dmt-modal-readonly" id="sellRchDetTxn">—</div>
                    </div>
                    <div class="vm-dmt-modal-field">
                        <label>Request Date</label>
                        <div class="vm-dmt-modal-readonly" id="sellRchDetRch">—</div>
                    </div>
                    <div class="vm-dmt-modal-field">
                        <label>Resp Date</label>
                        <div class="vm-dmt-modal-readonly" id="sellRchDetResp">—</div>
                    </div>
                    <div class="vm-dmt-modal-field">
                        <label>From</label>
                        <div class="vm-dmt-modal-readonly" id="sellRchDetFrom">—</div>
                    </div>
                    <div class="vm-dmt-modal-field">
                        <label>SIM</label>
                        <div class="vm-dmt-modal-readonly" id="sellRchDetSim">—</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer saas-admin-modal-footer">
                <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal">
                    <i class="fas fa-times" aria-hidden="true"></i> Close
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade saas-admin-modal vm-dmt-modal vm-dth-detail-modal" id="sellRechargeConfirmModal" tabindex="-1" role="dialog" aria-labelledby="sellRechargeConfirmTitle" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header saas-admin-modal-header accent-violet">
                <div class="saas-admin-modal-head-main">
                    <div class="saas-admin-modal-icon"><i class="fas fa-question" aria-hidden="true"></i></div>
                    <div class="saas-admin-modal-title-wrap">
                        <h4 class="modal-title saas-admin-modal-title" id="sellRechargeConfirmTitle">Confirm update</h4>
                        <span class="saas-admin-modal-subtitle" id="sellRchConfirmText">Are you sure?</span>
                    </div>
                </div>
                <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close">
                    <i class="fas fa-times" aria-hidden="true"></i>
                </button>
            </div>
            <div class="modal-footer saas-admin-modal-footer">
                <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" data-dismiss="modal">Cancel</button>
                <a id="sellRchConfirmLink" class="saas-admin-modal-btn" href="#">Confirm</a>
            </div>
        </div>
    </div>
</div>

<script src="~/MainFrontDesign/js/admin-report-datepicker.js?v=3"></script>
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    window.sellRchSelect2Url = '@Url.Content("~/MainFrontDesign/select2/dist/js/select2.full.min.js")';
    window.sellRchUpdateUrl = '@Url.Action("Rechargesellupd", "Home")';

    function toggleSellRechargeTotals() {
        var $ = window.jQuery;
        var panel = $('#sellRechargeTotalsPanel');
        var btn = $('.vm-sell-rch-totals-btn');
        if (panel.is(':visible')) {
            hideSellRechargeTotals();
            return;
        }
        panel.slideDown(180).attr('aria-hidden', 'false');
        btn.attr('aria-expanded', 'true');
    }

    function hideSellRechargeTotals() {
        var $ = window.jQuery;
        $('#sellRechargeTotalsPanel').slideUp(180).attr('aria-hidden', 'true');
        $('.vm-sell-rch-totals-btn').attr('aria-expanded', 'false');
    }

    function sellRchDetailText(btn, name) {
        var value = (btn && btn.getAttribute('data-' + name)) || '';
        value = String(value).replace(/\s+/g, ' ').trim();
        return value || '—';
    }

    function sellRchSetDetail(id, value) {
        var el = document.getElementById(id);
        if (el) {
            el.textContent = value;
        }
    }

    function sellRchStatusTone(status) {
        var raw = (status || '').toLowerCase();
        if (raw.indexOf('fail') >= 0 || raw.indexOf('refund') >= 0) {
            return 'failed';
        }
        if (raw.indexOf('success') >= 0) {
            return 'success';
        }
        return 'pending';
    }

    function showSellRchModal(selector) {
        if (typeof window.showAdminModal === 'function') {
            window.showAdminModal(selector);
            return;
        }
        var $ = window.jQuery;
        var $modal = $(selector);
        if ($modal.parent().length && !$modal.parent().is('body')) {
            $modal.appendTo(document.body);
        }
        if ($ && $.fn && $.fn.modal) {
            $modal.modal('show');
        }
    }

    function openSellRechargeDetail(btn) {
        var consumer = sellRchDetailText(btn, 'consumer');
        var status = sellRchDetailText(btn, 'status');
        var amount = sellRchDetailText(btn, 'amount');
        sellRchSetDetail('sellRchDetSubtitle', consumer === '—' ? 'Sell recharge information' : consumer);
        sellRchSetDetail('sellRchDetStatus', status);
        sellRchSetDetail('sellRchDetConsumer', consumer);
        sellRchSetDetail('sellRchDetOperator', sellRchDetailText(btn, 'operator'));
        sellRchSetDetail('sellRchDetAmount', amount === '—' ? '—' : ('₹ ' + amount));
        sellRchSetDetail('sellRchDetEarn', sellRchDetailText(btn, 'earn'));
        sellRchSetDetail('sellRchDetPre', sellRchDetailText(btn, 'pre'));
        sellRchSetDetail('sellRchDetPost', sellRchDetailText(btn, 'post'));
        sellRchSetDetail('sellRchDetTxn', sellRchDetailText(btn, 'txn'));
        sellRchSetDetail('sellRchDetRch', sellRchDetailText(btn, 'rch'));
        sellRchSetDetail('sellRchDetResp', sellRchDetailText(btn, 'resp'));
        sellRchSetDetail('sellRchDetFrom', sellRchDetailText(btn, 'from'));
        sellRchSetDetail('sellRchDetSim', sellRchDetailText(btn, 'sim'));
        var statusEl = document.getElementById('sellRchDetStatus');
        if (statusEl) {
            statusEl.className = 'vm-dmt-modal-readonly vm-dth-detail-status vm-dth-detail-status--' + sellRchStatusTone(status);
        }
        showSellRchModal('#sellRechargeDetailModal');
    }

    function openSellRechargeConfirm(btn) {
        var status = sellRchDetailText(btn, 'status');
        var idno = sellRchDetailText(btn, 'idno');
        var txn = (btn && btn.getAttribute('data-txn')) || '';
        var textEl = document.getElementById('sellRchConfirmText');
        if (textEl) {
            textEl.textContent = 'Mark this recharge as ' + status + '?';
        }
        var link = document.getElementById('sellRchConfirmLink');
        if (link) {
            link.href = window.sellRchUpdateUrl
                + '?id=' + encodeURIComponent(idno === '—' ? '' : idno)
                + '&status=' + encodeURIComponent(status)
                + '&txnid=' + encodeURIComponent(txn);
        }
        showSellRchModal('#sellRechargeConfirmModal');
    }

    function bindSellRechargeModals() {
        var $ = window.jQuery;
        if (!$ || !$.fn || !$.fn.modal) {
            window.setTimeout(bindSellRechargeModals, 40);
            return;
        }
        $(document).off('click.sellRchDetail', '.vm-sell-rch-detail-btn').on('click.sellRchDetail', '.vm-sell-rch-detail-btn', function (e) {
            e.preventDefault();
            e.stopPropagation();
            openSellRechargeDetail(this);
        });
        $(document).off('click.sellRchUpd', '.vm-sell-rch-upd-btn').on('click.sellRchUpd', '.vm-sell-rch-upd-btn', function (e) {
            e.preventDefault();
            e.stopPropagation();
            openSellRechargeConfirm(this);
        });
    }

    function sellRchLoadScript(src, done) {
        var s = document.createElement('script');
        s.src = src;
        s.onload = done;
        s.onerror = done;
        document.body.appendChild(s);
    }

    function bootSellRechargeReport() {
        var $ = window.jQuery;
        if (!$ || !$.fn || !$.fn.datepicker) {
            window.setTimeout(bootSellRechargeReport, 50);
            return;
        }

        function afterPlugins() {
            $('.saas-sell-recharge-report-page .for-select2').each(function () {
                var $el = $(this);
                if ($.fn.select2 && !$el.hasClass('select2-hidden-accessible')) {
                    $el.select2({
                        width: '100%',
                        minimumResultsForSearch: 0
                    });
                }
            });

            if (typeof window.initAdminReportDateForm === 'function') {
                window.initAdminReportDateForm('#dealerSellRechargeReportForm');
            } else {
                $('#txt_frm_date, #txt_to_date').datepicker({
                    format: 'yyyy-mm-dd',
                    todayHighlight: true,
                    autoclose: true,
                    orientation: 'bottom auto',
                    container: 'body'
                });
                if ($('#dealerSellRechargeReportForm').attr('data-date-mode') !== 'post') {
                    $('#txt_frm_date').datepicker('setDate', new Date());
                    $('#txt_to_date').datepicker('setDate', new Date());
                }
            }

            function pinSellRchDatepicker(e) {
                if (typeof window.repositionAdminDatepickerForMobile === 'function') {
                    window.repositionAdminDatepickerForMobile(e && e.target ? e.target : this);
                }
            }

            $(document).off('show.sellRchDp shown.sellRchDp').on('show.sellRchDp shown.sellRchDp', '#txt_frm_date, #txt_to_date', pinSellRchDatepicker);
            $(window).off('resize.sellRchDp orientationchange.sellRchDp').on('resize.sellRchDp orientationchange.sellRchDp', pinSellRchDatepicker);
        }

        if ($.fn.select2) {
            afterPlugins();
            return;
        }
        sellRchLoadScript(window.sellRchSelect2Url, afterPlugins);
    }

    bindSellRechargeModals();
    if (document.readyState === 'complete') {
        bootSellRechargeReport();
    } else {
        window.addEventListener('load', bootSellRechargeReport);
    }
</script>
