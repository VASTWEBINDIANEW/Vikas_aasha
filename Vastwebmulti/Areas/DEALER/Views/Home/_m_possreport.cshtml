@model IEnumerable<Vastwebmulti.Models.Mpos_Report_New_paging_Result>
@using System.Linq
@{
    Layout = null;
    var items = Model ?? Enumerable.Empty<Vastwebmulti.Models.Mpos_Report_New_paging_Result>();
}
@if (items.Any())
{
    foreach (var item in items)
    {
        var statusRaw = item.status ?? "";
        var isSuccess = statusRaw == "00";
        var statusTone = isSuccess ? "success" : "failed";
        var statusLabel = isSuccess ? "Success" : "Failed";
        var statusFa = isSuccess ? "fa-check" : "fa-times";
        var firm = !string.IsNullOrWhiteSpace(item.Frm_Name) ? item.Frm_Name : (item.RetailerName ?? "—");
        var txnDate = item.date.HasValue ? item.date.Value.ToString("dd-MMM HH:mm:ss") : "—";
        <tr class="vm-dmt-row vm-dmt-row--@statusTone" data-status="@statusRaw">
            <td class="vm-radiant-status-cell vm-ticket-status-cell">
                <span class="vm-dmt-status vm-dmt-status--@statusTone" title="@statusLabel">
                    <i class="fa @statusFa" aria-hidden="true"></i>
                </span>
                <span class="vm-radiant-status-text">@firm</span>
            </td>
            <td>@(item.transType ?? "—")</td>
            <td>@(item.cardtype ?? "—")</td>
            <td>@(item.cardbrand ?? "—")</td>
            <td>@(item.mPOSid ?? "—")</td>
            <td class="vm-dmt-amt-cell">@(item.amount.HasValue ? item.amount.Value.ToString("N2") : "—")</td>
            <td class="vm-dmt-amt-cell">@(item.Rem_comm.HasValue ? item.Rem_comm.Value.ToString("N2") : "—")</td>
            <td class="vm-dmt-amt-cell">@(item.Dlm_Comm.HasValue ? item.Dlm_Comm.Value.ToString("N2") : "—")</td>
            <td class="vm-dmt-amt-cell">@(item.totalamount.HasValue ? item.totalamount.Value.ToString("N2") : "—")</td>
            <td>@(item.BankRRN ?? "—")</td>
            <td>@(item.bankterminalID ?? "—")</td>
            <td>@txnDate</td>
        </tr>
    }
}
else
{
    <tr class="vm-opr-table-empty-row">
        <td colspan="12" class="vm-opr-table-empty">
            <i class="fas fa-credit-card" aria-hidden="true"></i>
            <span>M-Poss report not found.</span>
        </td>
    </tr>
}
