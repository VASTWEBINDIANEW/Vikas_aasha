@{
    ViewBag.Title = "Help";
    Layout = "~/Areas/DEALER/Views/Shared/_Layout.cshtml";
    var admin = ViewBag.admin as Vastwebmulti.Models.Admin_details;
    Func<string, string> helpVal = v => string.IsNullOrWhiteSpace(v) ? "No Data Found !" : v.Trim();
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=15" rel="stylesheet" />
<link href="~/MainFrontDesign/css/dealer-dth-booking-report-modern.css?v=48" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<script>document.body.classList.add('saas-sell-rch-dp-page', 'saas-dealer-notification-page', 'saas-dealer-help-page');</script>

<section class="content saas-admin-account-page saas-admin-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-dth-booking-report-page saas-dealer-retailer-index-page saas-dealer-notification-page saas-dealer-help-page">

    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">
            <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-dr-rem-toolbar-top">
                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>Account Active</li>
                    <li>Help</li>
                </ol>
            </div>
        </div>

        <div class="vm-dr-help-grid">

            <div class="vm-opr-main-card vm-dr-help-card">
                <div class="vm-opr-table-panel vm-dr-help-panel">
                    <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                        <div class="vm-opr-table-panel__title">
                            <i class="fas fa-headset" aria-hidden="true"></i>
                            <span>Customer care support time</span>
                        </div>
                    </div>
                    <div class="vm-dr-help-panel__body">
                        <ul class="vm-dr-help-schedule" role="list">
                            <li class="vm-dr-help-schedule__row">
                                <span class="vm-dr-help-schedule__day">Monday</span>
                                <span class="vm-dr-help-schedule__time">9:00 AM to 8:00 PM</span>
                            </li>
                            <li class="vm-dr-help-schedule__row">
                                <span class="vm-dr-help-schedule__day">Tuesday</span>
                                <span class="vm-dr-help-schedule__time">9:00 AM to 8:00 PM</span>
                            </li>
                            <li class="vm-dr-help-schedule__row">
                                <span class="vm-dr-help-schedule__day">Wednesday</span>
                                <span class="vm-dr-help-schedule__time">9:00 AM to 8:00 PM</span>
                            </li>
                            <li class="vm-dr-help-schedule__row">
                                <span class="vm-dr-help-schedule__day">Thursday</span>
                                <span class="vm-dr-help-schedule__time">9:00 AM to 8:00 PM</span>
                            </li>
                            <li class="vm-dr-help-schedule__row">
                                <span class="vm-dr-help-schedule__day">Friday</span>
                                <span class="vm-dr-help-schedule__time">9:00 AM to 8:00 PM</span>
                            </li>
                            <li class="vm-dr-help-schedule__row">
                                <span class="vm-dr-help-schedule__day">Saturday</span>
                                <span class="vm-dr-help-schedule__time">9:00 AM to 8:00 PM</span>
                            </li>
                            <li class="vm-dr-help-schedule__row vm-dr-help-schedule__row--highlight">
                                <span class="vm-dr-help-schedule__day">Sunday</span>
                                <span class="vm-dr-help-schedule__time">9:00 AM to 2:00 PM</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="vm-opr-main-card vm-dr-help-card">
                <div class="vm-opr-table-panel vm-dr-help-panel">
                    <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                        <div class="vm-opr-table-panel__title">
                            <i class="fas fa-address-card" aria-hidden="true"></i>
                            <span>Contact information</span>
                        </div>
                    </div>
                    <div class="vm-dr-help-panel__body">
                        <dl class="vm-dr-help-contact">
                            <div class="vm-dr-help-contact__row">
                                <dt>Company name</dt>
                                <dd>@(admin != null ? helpVal(admin.Companyname) : "No Data Found !")</dd>
                            </div>
                            <div class="vm-dr-help-contact__row">
                                <dt>Name</dt>
                                <dd>@(admin != null ? helpVal(admin.Name) : "No Data Found !")</dd>
                            </div>
                            <div class="vm-dr-help-contact__row">
                                <dt>Email-ID</dt>
                                <dd>@(admin != null ? helpVal(admin.email) : "No Data Found !")</dd>
                            </div>
                            <div class="vm-dr-help-contact__row">
                                <dt>Mobile no</dt>
                                <dd>@(admin != null ? helpVal(admin.mobile) : "No Data Found !")</dd>
                            </div>
                            <div class="vm-dr-help-contact__row">
                                <dt>Customer care</dt>
                                <dd>@(admin != null ? helpVal(admin.CustomerCare_No) : "No Data Found !")</dd>
                            </div>
                            <div class="vm-dr-help-contact__row vm-dr-help-contact__row--full">
                                <dt>Address</dt>
                                <dd>@(admin != null ? helpVal(admin.Address) : "No Data Found !")</dd>
                            </div>
                            @if (admin != null && admin.pincode.HasValue && admin.pincode.Value > 0)
                            {
                                <div class="vm-dr-help-contact__row">
                                    <dt>Pin code</dt>
                                    <dd>@admin.pincode.Value</dd>
                                </div>
                            }
                        </dl>
                    </div>
                </div>
            </div>

        </div>

    </div>
</section>
