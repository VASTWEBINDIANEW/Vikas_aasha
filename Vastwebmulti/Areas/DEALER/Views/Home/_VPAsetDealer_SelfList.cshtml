@using Vastwebmulti.Models;
@model Vastwebmulti.Areas.ADMIN.Models.upiChargeAndgateway
@using Vastwebmulti.Models.Enumdata;
@{
    VastwebmultiEntities DB1 = new VastwebmultiEntities();
    var usernname = DB1.Usernicknames.Where(aa => aa.Role == "Dealer").ToList();
    var favimage = "";
    if (usernname.Count() > 0)
    {
        if (usernname.SingleOrDefault().Role == "Dealer")
        {
            favimage = usernname.SingleOrDefault().NickName;
        }
    }
}

<div class="vm-dealer-vpa-panel">
    <table class="table table-bordered vm-vpa-table wallet-bank-input">
        <thead>
            <tr>
                <th>@favimage VPA ID</th>
                <th>VPA Name</th>
                <th>Prefer (For All)</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Dealer_VPAID != null && Model.Dealer_VPAID.Count() > 0)
            {
                foreach (var item in Model.Dealer_VPAID)
                {
                    int typeidno = Convert.ToInt32(item.DealerVPATYPE);
                    var datas = Enum.GetName(typeof(SelupIEnumlist), typeidno);
                    <tr>
                        <td>@item.DealerVPAID</td>
                        <td><span>@datas</span></td>
                        <td>
                            @if (item.Isdefault == true)
                            {
                                <button type="button" class="vm-vpa-btn vm-vpa-btn--prefer" onclick="Activeset('@item.idno')">Prefer</button>
                            }
                            else
                            {
                                <button type="button" class="vm-vpa-btn" onclick="Activeset('@item.idno')">Not Prefer</button>
                            }
                        </td>
                        <td>
                            <button type="button" class="vm-vpa-btn vm-vpa-btn--danger" onclick="Deletedata('@item.idno')">Delete</button>
                        </td>
                    </tr>
                }
            }

            @if (Model.Dealer_VPAID != null && Model.Dealer_VPAID.Count() == 5)
            {
                <tr>
                    <td colspan="4">You can add Max 5 VPA</td>
                </tr>
            }
            else
            {
                <tr class="tbladdbtnshow">
                    <td colspan="3"></td>
                    <td>
                        <button type="button" class="vm-vpa-btn vm-vpa-btn--primary deleteCharged112">Add UPI</button>
                    </td>
                </tr>
            }

            <tr class="clsupiaddhide vm-vpa-add-row">
                <td class="classshow11">
                    <input type="text" id="txtupiid" name="txtupiid" value="" placeholder="Enter VPA ID" class="form-control vm-vpa-input" autocomplete="off" />
                </td>
                <td class="classshow11">
                    @Html.EnumDropDownListFor(model => model.ddlpaytmtype)
                </td>
                <td class="classshow11"></td>
                <td class="classshow11">
                    <button type="button" class="vm-vpa-btn vm-vpa-btn--primary deleteCharged111">Process Request</button>
                </td>
            </tr>
            <tr class="sendotphide">
                <td colspan="3"></td>
                <td>
                    <button type="button" id="btnsendotp" class="vm-vpa-btn vm-vpa-btn--primary deleteCharge">Send OTP</button>
                </td>
            </tr>
            <tr class="classhide11 vm-vpa-add-row">
                <td colspan="3">
                    <input id="txtotp" name="txtotp" type="text" placeholder="Enter OTP" class="form-control vm-vpa-input" required autocomplete="off" />
                </td>
                <td>
                    <button type="button" id="Saveotp" class="vm-vpa-btn vm-vpa-btn--primary">Save</button>
                </td>
            </tr>
        </tbody>
    </table>

    @if (Model.msg != "DONE" && !string.IsNullOrWhiteSpace(Model.msg))
    {
        <label class="vm-vpa-lblmsg" style="color:red;">@Model.msg</label>
    }
</div>

<script>
    (function () {
        function resetVpaAddPanel() {
            $(".classshow11").show();
            $(".tbladdbtnshow").show();
            $(".classhide11").hide();
            $(".sendotphide").hide();
            $(".clsupiaddhide").hide();
            $("#txtupiid").val('');
            $("#txtotp").val('');
            if ($("#ddlpaytmtype").length) {
                $("#ddlpaytmtype").val('').trigger('change');
            }
        }

        function bindVpaDealerPanel() {
            resetVpaAddPanel();
            if (typeof window.initDealerVpaModalControls === 'function') {
                window.initDealerVpaModalControls();
            }
        }

        $(document).off('click.vpaDealerAdd', '.deleteCharged112').on('click.vpaDealerAdd', '.deleteCharged112', function () {
            $(this).closest('tr').hide();
            $(".clsupiaddhide").show();
            if (typeof window.initDealerVpaModalControls === 'function') {
                window.initDealerVpaModalControls();
            }
        });

        $(document).off('click.vpaDealerProcess', '.deleteCharged111').on('click.vpaDealerProcess', '.deleteCharged111', function () {
            $('#lblmsg').text('');
            if ($("#txtupiid").val() === "" || $("#txtupiid").val() == null) {
                $('#lblmsg').text('Enter UPI');
                return false;
            }
            if ($("#ddlpaytmtype").val() === "" || $("#ddlpaytmtype").val() == null || $("#ddlpaytmtype").val() === "0") {
                $('#lblmsg').text('Select VPA');
                return false;
            }
            $(this).hide();
            $(".classshow11").hide();
            $(".classhide11").hide();
            $(".sendotphide").show();
            $(".tbladdbtnshow").hide();
        });

        $(document).off('click.vpaDealerOtp', '#btnsendotp').on('click.vpaDealerOtp', '#btnsendotp', function () {
            $('#lblmsg').text('');
            if ($("#txtupiid").val() === "" || $("#txtupiid").val() == null) {
                $('#lblmsg').text('Enter UPI');
                return false;
            }
            if ($("#ddlpaytmtype").val() === "" || $("#ddlpaytmtype").val() == null) {
                $('#lblmsg').text('Select VPA');
                return false;
            }
            $("#hideupiid").val($("#txtupiid").val());
            $("#hidddlpaymenttype").val($("#ddlpaytmtype").val());
            $.ajax({
                url: '@Url.Action("DealerSENDOTP","Home")',
                type: 'POST',
                success: function () {
                    $(".classshow11").hide();
                    $(".classhide11").show();
                    $(".sendotphide").hide();
                }
            });
        });

        $(document).off('click.vpaDealerSave', '#Saveotp').on('click.vpaDealerSave', '#Saveotp', function () {
            $('#lblmsg').text('');
            $.ajax({
                url: '@Url.Action("DealerAddVpaID", "Home")',
                type: 'POST',
                data: { upiid: $("#hideupiid").val(), otp: $("#txtotp").val(), paymenttype: $("#hidddlpaymenttype").val() },
                success: function (response) {
                    $('#RemTbl222').html(response);
                }
            });
        });

        window.resetDealerVpaAddPanel = resetVpaAddPanel;
        bindVpaDealerPanel();
    })();
</script>

<script>
    function Deletedata(idno) {
        $('#lblmsg').text('');
        $.ajax({
            url: '@Url.Action("deleteSelefUpiSelf", "Home")',
            type: 'POST',
            data: { upiid: idno },
            success: function (response) {
                $('#RemTbl222').html(response);
            }
        });
    }

    function Activeset(idno) {
        $('#lblmsg').text('');
        $.ajax({
            url: '@Url.Action("DealerActiveUpiSelf", "Home")',
            type: 'POST',
            data: { upiid: idno },
            success: function (response) {
                $('#RemTbl222').html(response);
            }
        });
    }
</script>
