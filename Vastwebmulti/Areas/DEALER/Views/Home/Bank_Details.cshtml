@model IEnumerable<Vastwebmulti.Models.bank_info>
@using System.Linq
@{
    ViewBag.Title = "Bank Details";
    Layout = "~/Areas/DEALER/Views/Shared/_Layout.cshtml";

    var bankList = (Model ?? Enumerable.Empty<Vastwebmulti.Models.bank_info>()).ToList();
    var bankCount = bankList.Count;
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=15" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/dealer-dth-booking-report-modern.css?v=24" rel="stylesheet" />
<script>document.body.classList.add('saas-sell-rch-dp-page', 'saas-dealer-bank-details-page');</script>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-dth-booking-report-page saas-dealer-daybook-page saas-dealer-bank-details-page saas-ecommerce-report-page">

    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

            <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line">

                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>Account Active</li>
                    <li>Bank Details</li>
                </ol>

                <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters">

                    <div class="vm-dmt-filter-search-group">
                        <div class="vm-ft-search-wrap vm-bank-details-table-search">
                            <input class="form-control vm-bank-details-search-input" type="text" id="bankDetailsSearchInput" placeholder="Search banks..." autocomplete="off" />
                        </div>
                        <span class="vm-radiant-record-badge" title="Total banks">
                            Banks: <strong id="bankDetailsRecordCount">@bankCount</strong>
                        </span>
                    </div>

                </div>

            </div>

        </div>

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-building-columns" aria-hidden="true"></i>
                        <span>All bank information</span>
                    </div>
                </div>

                <div class="vm-opr-table-wrap vm-bank-details-wrap">
                    @if (!bankList.Any())
                    {
                        <div class="vm-opr-table-empty vm-bank-details-empty">No bank information found.</div>
                    }
                    else
                    {
                        <div class="vm-bank-details-grid" id="bankDetailsGrid">
                            @foreach (var item in bankList)
                            {
                                var bankName = string.IsNullOrWhiteSpace(item.banknm) ? "—" : item.banknm.Trim();
                                <div class="vm-bank-details-card" data-search="@(bankName + " " + item.branch_nm + " " + item.ifsccode + " " + item.acno + " " + item.actype + " " + item.holdername + " " + item.address)">
                                    <div class="vm-bank-details-card__head">
                                        <span class="vm-bank-details-card__icon"><i class="fas fa-landmark" aria-hidden="true"></i></span>
                                        <div class="vm-bank-details-card__head-text">
                                            <strong class="vm-bank-details-card__name">@bankName</strong>
                                            <span class="vm-bank-details-card__branch">@(string.IsNullOrWhiteSpace(item.branch_nm) ? "—" : item.branch_nm)</span>
                                        </div>
                                    </div>
                                    <div class="vm-bank-details-card__rows">
                                        <div class="vm-bank-details-row">
                                            <span class="vm-bank-details-row__label">IFSC Code</span>
                                            <span class="vm-bank-details-row__value">
                                                @(string.IsNullOrWhiteSpace(item.ifsccode) ? "—" : item.ifsccode)
                                                @if (!string.IsNullOrWhiteSpace(item.ifsccode))
                                                {
                                                    <button type="button" class="vm-bank-details-copy-btn" data-copy="@item.ifsccode.Trim()" title="Copy IFSC">
                                                        <i class="far fa-copy" aria-hidden="true"></i>
                                                    </button>
                                                }
                                            </span>
                                        </div>
                                        <div class="vm-bank-details-row">
                                            <span class="vm-bank-details-row__label">Account Number</span>
                                            <span class="vm-bank-details-row__value">
                                                @(string.IsNullOrWhiteSpace(item.acno) ? "—" : item.acno)
                                                @if (!string.IsNullOrWhiteSpace(item.acno))
                                                {
                                                    <button type="button" class="vm-bank-details-copy-btn" data-copy="@item.acno.Trim()" title="Copy account number">
                                                        <i class="far fa-copy" aria-hidden="true"></i>
                                                    </button>
                                                }
                                            </span>
                                        </div>
                                        <div class="vm-bank-details-row">
                                            <span class="vm-bank-details-row__label">Account Type</span>
                                            <span class="vm-bank-details-row__value">@(string.IsNullOrWhiteSpace(item.actype) ? "—" : item.actype)</span>
                                        </div>
                                        <div class="vm-bank-details-row">
                                            <span class="vm-bank-details-row__label">Account Holder</span>
                                            <span class="vm-bank-details-row__value">@(string.IsNullOrWhiteSpace(item.holdername) ? "—" : item.holdername)</span>
                                        </div>
                                        <div class="vm-bank-details-row vm-bank-details-row--full">
                                            <span class="vm-bank-details-row__label">Branch Address</span>
                                            <span class="vm-bank-details-row__value">@(string.IsNullOrWhiteSpace(item.address) ? "—" : item.address)</span>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="vm-opr-table-empty vm-bank-details-empty" id="bankDetailsNoMatch" style="display:none;">No banks match your search.</div>
                    }
                </div>
            </div>
        </div>

    </div>
</section>

<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    function bankDetailsFilter() {
        var $ = window.jQuery;
        if (!$) { return; }
        var value = ($('#bankDetailsSearchInput').val() || '').toLowerCase().trim();
        var visible = 0;
        $('#bankDetailsGrid .vm-bank-details-card').each(function () {
            var $card = $(this);
            var show = !value || (($card.attr('data-search') || '').toLowerCase().indexOf(value) > -1);
            $card.toggle(show);
            if (show) { visible++; }
        });
        $('#bankDetailsRecordCount').text(visible);
        $('#bankDetailsNoMatch').toggle(visible === 0);
    }

    function bankDetailsCopy(text, btn) {
        function done() {
            if (btn) {
                var $btn = window.jQuery ? window.jQuery(btn) : null;
                if ($btn && $btn.length) {
                    var old = $btn.html();
                    $btn.html('<i class="fas fa-check" aria-hidden="true"></i>');
                    window.setTimeout(function () { $btn.html(old); }, 1200);
                }
            }
            if (typeof swal === 'function') {
                swal('Copied!', text, 'success');
            }
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(done, function () { fallbackCopy(); });
        } else {
            fallbackCopy();
        }
        function fallbackCopy() {
            var ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            try { document.execCommand('copy'); } catch (e) { }
            document.body.removeChild(ta);
            done();
        }
    }

    function bootDealerBankDetailsPage() {
        var $ = window.jQuery;
        if (!$) {
            window.setTimeout(bootDealerBankDetailsPage, 50);
            return;
        }
        $('#bankDetailsSearchInput').off('input.bankDetails keyup.bankDetails').on('input.bankDetails keyup.bankDetails', bankDetailsFilter);
        $(document).off('click.bankDetailsCopy').on('click.bankDetailsCopy', '.vm-bank-details-copy-btn', function (e) {
            e.preventDefault();
            e.stopPropagation();
            bankDetailsCopy($(this).attr('data-copy') || '', this);
        });
    }

    if (document.readyState === 'complete') {
        bootDealerBankDetailsPage();
    } else {
        window.addEventListener('load', bootDealerBankDetailsPage);
    }
</script>

