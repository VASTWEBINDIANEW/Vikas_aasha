<script src="~/MainFrontDesign/js/admin-report-datepicker.js?v=3"></script>
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    window.ecomSelect2Url = '@Url.Content("~/MainFrontDesign/select2/dist/js/select2.full.min.js")';
    window.ecomExcelUrl = '@Url.Action("Excel_Ecommerce_Report", "Home")';
    window.ecomPdfUrl = '@Url.Action("PDF_Ecommerce_Report", "Home")';

    function ecomQueryData() {
        var $ = window.jQuery;
        return {
            txt_frm_date: $('#txt_frm_date').val() || '',
            txt_to_date: $('#txt_to_date').val() || '',
            ddl_status: $('#ddl_status').val() || 'ALL',
            category: $('#category').val() || '',
            allretailer: $('#allretailer').val() || '',
            ddl_top: '50'
        };
    }

    function ecomQueryString() {
        var q = ecomQueryData();
        return 'txt_frm_date=' + encodeURIComponent(q.txt_frm_date)
            + '&txt_to_date=' + encodeURIComponent(q.txt_to_date)
            + '&ddl_status=' + encodeURIComponent(q.ddl_status)
            + '&category=' + encodeURIComponent(q.category)
            + '&allretailer=' + encodeURIComponent(q.allretailer)
            + '&ddl_top=' + encodeURIComponent(q.ddl_top);
    }

    function toggleEcommerceTotals() {
        var $ = window.jQuery;
        var panel = $('#ecommerceTotalsPanel');
        var btn = $('.vm-ecom-totals-btn');
        if (panel.is(':visible')) {
            hideEcommerceTotals();
            return;
        }
        panel.slideDown(180).attr('aria-hidden', 'false');
        btn.attr('aria-expanded', 'true');
    }

    function hideEcommerceTotals() {
        var $ = window.jQuery;
        $('#ecommerceTotalsPanel').slideUp(180).attr('aria-hidden', 'true');
        $('.vm-ecom-totals-btn').attr('aria-expanded', 'false');
    }

    function ecomDetailText(btn, name) {
        var value = (btn && btn.getAttribute('data-' + name)) || '';
        value = String(value).replace(/\s+/g, ' ').trim();
        return value || '-';
    }

    function ecomSetDetail(id, value) {
        var el = document.getElementById(id);
        if (el) {
            el.textContent = value;
        }
    }

    function ecomStatusTone(status) {
        var raw = (status || '').toLowerCase();
        if (raw.indexOf('reject') >= 0 || raw.indexOf('fail') >= 0) {
            return 'failed';
        }
        if (raw.indexOf('success') >= 0) {
            return 'success';
        }
        return 'pending';
    }

    function showEcomModal(selector) {
        if (typeof window.showAdminModal === 'function') {
            window.showAdminModal(selector);
            return;
        }
        var $ = window.jQuery;
        var $modal = $(selector);
        if ($modal.parent().length && !$modal.parent().is('body')) {
            $modal.appendTo(document.body);
        }
        if ($ && $.fn && $.fn.modal) {
            $modal.modal('show');
        }
    }

    function openEcommerceDetail(btn) {
        var user = ecomDetailText(btn, 'user');
        var status = ecomDetailText(btn, 'status');
        var amount = ecomDetailText(btn, 'amount');
        ecomSetDetail('ecomDetSubtitle', user === '-' ? 'Order information' : user);
        ecomSetDetail('ecomDetStatus', status);
        ecomSetDetail('ecomDetUser', user);
        ecomSetDetail('ecomDetEmail', ecomDetailText(btn, 'email'));
        ecomSetDetail('ecomDetRole', ecomDetailText(btn, 'role'));
        ecomSetDetail('ecomDetProduct', ecomDetailText(btn, 'product'));
        ecomSetDetail('ecomDetCategory', ecomDetailText(btn, 'category'));
        ecomSetDetail('ecomDetOrder', ecomDetailText(btn, 'order'));
        ecomSetDetail('ecomDetApproved', ecomDetailText(btn, 'approved'));
        ecomSetDetail('ecomDetMrp', ecomDetailText(btn, 'mrp'));
        ecomSetDetail('ecomDetPrice', ecomDetailText(btn, 'price'));
        ecomSetDetail('ecomDetQty', ecomDetailText(btn, 'qty'));
        ecomSetDetail('ecomDetAmount', amount === '-' ? '-' : ('₹ ' + amount));
        ecomSetDetail('ecomDetUserPre', ecomDetailText(btn, 'userpre'));
        ecomSetDetail('ecomDetUserInc', ecomDetailText(btn, 'userinc'));
        ecomSetDetail('ecomDetUserPost', ecomDetailText(btn, 'userpost'));
        ecomSetDetail('ecomDetDlmPre', ecomDetailText(btn, 'dlmpre'));
        ecomSetDetail('ecomDetDlmInc', ecomDetailText(btn, 'dlminc'));
        ecomSetDetail('ecomDetDlmPost', ecomDetailText(btn, 'dlmpost'));
        var statusEl = document.getElementById('ecomDetStatus');
        if (statusEl) {
            statusEl.className = 'vm-dmt-modal-readonly vm-dth-detail-status vm-dth-detail-status--' + ecomStatusTone(status);
        }
        showEcomModal('#ecommerceDetailModal');
    }

    function bindEcommerceModals() {
        var $ = window.jQuery;
        if (!$ || !$.fn || !$.fn.modal) {
            window.setTimeout(bindEcommerceModals, 40);
            return;
        }
        $(document).off('click.ecomDetail', '.vm-ecom-detail-btn').on('click.ecomDetail', '.vm-ecom-detail-btn', function (e) {
            e.preventDefault();
            e.stopPropagation();
            openEcommerceDetail(this);
        });
    }

    function ecomLoadScript(src, done) {
        var s = document.createElement('script');
        s.src = src;
        s.onload = done;
        s.onerror = done;
        document.body.appendChild(s);
    }

    function bootEcommerceReport() {
        var $ = window.jQuery;
        if (!$ || !$.fn || !$.fn.datepicker) {
            window.setTimeout(bootEcommerceReport, 50);
            return;
        }

        function afterPlugins() {
            $('.saas-ecommerce-report-page .for-select2').each(function () {
                var $el = $(this);
                if ($.fn.select2 && !$el.hasClass('select2-hidden-accessible')) {
                    $el.select2({
                        width: '100%',
                        dropdownParent: $('body'),
                        containerCssClass: 'vm-ecom-select2',
                        dropdownCssClass: 'vm-ecom-select2-drop',
                        minimumResultsForSearch: 0
                    });
                }
            });

            if (typeof window.initAdminReportDateForm === 'function') {
                window.initAdminReportDateForm('#dealerEcommerceReportForm');
            } else {
                $('#txt_frm_date, #txt_to_date').datepicker({
                    format: 'yyyy-mm-dd',
                    todayHighlight: true,
                    autoclose: true,
                    orientation: 'bottom auto',
                    container: 'body'
                });
                if ($('#dealerEcommerceReportForm').attr('data-date-mode') !== 'post') {
                    $('#txt_frm_date').datepicker('setDate', new Date());
                    $('#txt_to_date').datepicker('setDate', new Date());
                }
            }

            function pinEcomDatepicker(e) {
                if (typeof window.repositionAdminDatepickerForMobile === 'function') {
                    window.repositionAdminDatepickerForMobile(e && e.target ? e.target : this);
                }
            }

            $(document).off('show.ecomDp shown.ecomDp').on('show.ecomDp shown.ecomDp', '#txt_frm_date, #txt_to_date', pinEcomDatepicker);
            $(window).off('resize.ecomDp orientationchange.ecomDp').on('resize.ecomDp orientationchange.ecomDp', pinEcomDatepicker);

            $('#btnExport').off('click.ecomEx').on('click.ecomEx', function () {
                window.location.href = window.ecomExcelUrl + '?' + ecomQueryString();
            });
            $('#btnPDF').off('click.ecomPdf').on('click.ecomPdf', function () {
                window.open(window.ecomPdfUrl + '?' + ecomQueryString(), '_blank');
            });
        }

        if ($.fn.select2) {
            afterPlugins();
            return;
        }
        ecomLoadScript(window.ecomSelect2Url, afterPlugins);
    }

    bindEcommerceModals();
    if (document.readyState === 'complete') {
        bootEcommerceReport();
    } else {
        window.addEventListener('load', bootEcommerceReport);
    }
</script>

