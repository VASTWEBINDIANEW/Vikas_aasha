@model List<Vastwebmulti.Models.proc_HotelReport_Result>
@using System.Collections.Generic
@using System.Linq
@{
    ViewBag.Title = "Hotel Report";
    Layout = "~/Areas/DEALER/Views/Shared/_Layout.cshtml";

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var selectedRetailer = (Request["allretailer"] ?? "").Trim();
    var selectedStatus = (Request["ddl_status"] ?? "").Trim();
    var txnId = (Request["TXNID"] ?? "").Trim();
    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=7" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=31" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=2" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-incoming-report-modern.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/dealer-flight-report-modern.css?v=8" rel="stylesheet" />
<script>document.body.classList.add('saas-flight-report-dp-page');</script>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-incoming-report-page saas-dealer-flight-report-page saas-dealer-hotel-report-page">
    <div class="container-fluid vm-opr-page-shell">

        @{
            var hotelFormAttrs = new Dictionary<string, object>
            {
                { "id", "dealerHotelReportForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate },
                { "data-scroll-url", Url.Action("InfiniteScrollHotelReport", "Home") }
            };
        }
        @using (Html.BeginForm("Hotel_Report", "Home", FormMethod.Post, hotelFormAttrs))
        {
            <div class="saas-acc-toolbar saas-pan-toolbar-unified saas-acc-toolbar--stacked vm-opr-toolbar-unified">
                <div class="saas-acc-toolbar-top vm-opr-toolbar-head">
                    <ol class="saas-acc-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Travels</li>
                        <li>Hotel Report</li>
                    </ol>
                    <div class="vm-opr-page-nav">
                        <nav class="vm-opr-nav--page" aria-label="Travel reports">
                            <a class="vm-opr-nav__link" href="@Url.Action("Flight_Report", "Home")">Flight</a>
                            <a class="vm-opr-nav__link" href="@Url.Action("Bus_Report", "Home")">Bus</a>
                            <a class="vm-opr-nav__link is-active" href="@Url.Action("Hotel_Report", "Home")">Hotel</a>
                        </nav>
                    </div>
                </div>
                <div class="vm-rpt-filters-panel">
                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-inc-filter-row vm-rpt-filters-panel__bar">

                        <div class="vm-inc-filter-left">
                            <div class="vm-opr-field vm-opr-field--port">
                                @{
                                    var retailerItems = ViewBag.allretailer as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
                                }
                                @Html.DropDownList("allretailer", new SelectList(retailerItems, "Value", "Text", selectedRetailer), "Select User", new { id = "allretailer", @class = "vm-opr-select form-control for-select2", @title = "User" })
                            </div>
                            <div class="vm-opr-field vm-opr-field--port">
                                @Html.DropDownList("ddl_status", new SelectList(new[]
                                {
                                    new SelectListItem { Text = "All Status", Value = "" },
                                    new SelectListItem { Text = "Success", Value = "Confirmed" },
                                    new SelectListItem { Text = "Pending", Value = "Proccessed" },
                                    new SelectListItem { Text = "Failed", Value = "Failed" }
                                }, "Value", "Text", selectedStatus), new { id = "ddl_status", @class = "vm-opr-select form-control for-select2", @title = "Status" })
                            </div>
                            <div class="vm-opr-field vm-inc-field--msg">
                                @Html.TextBox("TXNID", txnId, new { @class = "form-control vm-inc-msg-input", @placeholder = "TXN/REF NO", autocomplete = "off", id = "TXNID", title = "TXN/REF NO" })
                            </div>
                        </div>

                        <div class="vm-inc-filter-right">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" name="submit" value="Old" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel" id="showreport">
                <div class="vm-opr-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-hotel" aria-hidden="true"></i>
                        <span>Hotel report</span>
                    </div>
                    <div class="vm-opr-table-panel__right vm-flight-table-head-right">
                        <span class="vm-flight-inline-total" id="hotelTotalsChip" style="display:none;">
                            <span id="successtotal">Success: —</span>
                            <span id="Failedtotal">Failed: —</span>
                            <span id="Pendingtotal">Pending: —</span>
                        </span>
                        <div class="vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="saas-acc-btn" id="btnHotelTotal" title="Show totals">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i> Total
                            </button>
                            <button type="button" id="btnExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="example" class="table table-bordered table-striped table-hover vm-opr-data-table vm-inc-data-table vm-flight-data-table">
                            <thead>
                                <tr>
                                    <th>Live&nbsp;Status</th>
                                    <th>Hotel</th>
                                    <th>Rooms</th>
                                    <th>Price</th>
                                    <th>Booking&nbsp;Id</th>
                                    <th>User&nbsp;Income</th>
                                    <th>MY&nbsp;Pre</th>
                                    <th>MY&nbsp;Income</th>
                                    <th>MY&nbsp;Post</th>
                                    <th>Booking&nbsp;Date</th>
                                </tr>
                            </thead>
                            <tbody id="trow">
                                @{
                                    Html.RenderAction("_Hotel_Report", "Home", new
                                    {
                                        txt_frm_date = frmDate,
                                        txt_to_date = toDate,
                                        ddl_status = selectedStatus,
                                        TXNID = txnId,
                                        allretailer = selectedRetailer
                                    });
                                }
                            </tbody>
                        </table>
                        <div id="loadingdiv" class="vm-opr-table-loading" style="display:none;">
                            <div class="vm-inc-loader"><i class="fas fa-spinner fa-spin" aria-hidden="true"></i> Loading...</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script src="~/MainFrontDesign/js/admin-report-datepicker.js?v=3"></script>
<script src="~/MainFrontDesign/js/admin-operator-report-nav.js"></script>
<script>
    window.hotelExcelUrl = '@Url.Action("ExcelHotalReport", "Home")';
    window.hotelPdfUrl = '@Url.Action("PDFHotelReport", "Home")';
    window.hotelTotalUrl = '@Url.Action("Total_HotelReport", "Home")';
    window.hotelSelect2Url = '@Url.Content("~/MainFrontDesign/select2/dist/js/select2.full.min.js")';

    function hotelQueryData() {
        var $ = window.jQuery;
        return {
            txt_frm_date: $('#txt_frm_date').val() || '',
            txt_to_date: $('#txt_to_date').val() || '',
            ddl_status: $('#ddl_status').val() || '',
            TXNID: $('#TXNID').val() || '',
            allretailer: $('#allretailer').val() || ''
        };
    }

    function hotelQueryString() {
        var q = hotelQueryData();
        return 'txt_frm_date=' + encodeURIComponent(q.txt_frm_date)
            + '&txt_to_date=' + encodeURIComponent(q.txt_to_date)
            + '&ddl_status=' + encodeURIComponent(q.ddl_status)
            + '&TXNID=' + encodeURIComponent(q.TXNID)
            + '&allretailer=' + encodeURIComponent(q.allretailer);
    }

    function hotelLoadScript(src, done) {
        var s = document.createElement('script');
        s.src = src;
        s.onload = done;
        s.onerror = done;
        document.body.appendChild(s);
    }

    function bootDealerHotelReport() {
        var $ = window.jQuery;
        if (!$ || !$.fn || !$.fn.datepicker) {
            window.setTimeout(bootDealerHotelReport, 50);
            return;
        }

        function afterPlugins() {
            document.body.classList.add('saas-flight-report-dp-page');
            $('.saas-dealer-hotel-report-page .for-select2').each(function () {
                var $el = $(this);
                if ($.fn.select2 && !$el.hasClass('select2-hidden-accessible')) {
                    $el.select2({
                        width: '100%',
                        dropdownParent: $('body'),
                        containerCssClass: 'vm-flight-select2',
                        dropdownCssClass: 'vm-flight-select2-drop',
                        minimumResultsForSearch: $el.attr('id') === 'ddl_status' ? 8 : 0
                    });
                }
            });

            if (typeof window.initAdminReportDateForm === 'function') {
                window.initAdminReportDateForm('#dealerHotelReportForm');
            } else {
                $('#txt_frm_date, #txt_to_date').datepicker({
                    format: 'yyyy-mm-dd',
                    todayHighlight: true,
                    autoclose: true,
                    orientation: 'bottom auto',
                    container: 'body'
                });
                if ($('#dealerHotelReportForm').attr('data-date-mode') !== 'post') {
                    $('#txt_frm_date').datepicker('setDate', new Date());
                    $('#txt_to_date').datepicker('setDate', new Date());
                }
            }

            function pinHotelDatepicker(e) {
                if (typeof window.repositionAdminDatepickerForMobile === 'function') {
                    window.repositionAdminDatepickerForMobile(e && e.target ? e.target : this);
                }
            }

            $(document).off('show.vmHotelDp shown.vmHotelDp').on('show.vmHotelDp shown.vmHotelDp', '#txt_frm_date, #txt_to_date', pinHotelDatepicker);
            $(window).off('resize.vmHotelDp orientationchange.vmHotelDp').on('resize.vmHotelDp orientationchange.vmHotelDp', pinHotelDatepicker);

            $('#btnExport').off('click.hotelEx').on('click.hotelEx', function () {
                window.location.href = window.hotelExcelUrl + '?' + hotelQueryString();
            });
            $('#btnPDF').off('click.hotelPdf').on('click.hotelPdf', function () {
                window.open(window.hotelPdfUrl + '?' + hotelQueryString(), '_blank');
            });
            $('#btnHotelTotal').off('click.hotelTot').on('click.hotelTot', function () {
                var $chip = $('#hotelTotalsChip');
                if ($chip.is(':visible') && $chip.data('loaded')) {
                    $chip.toggle();
                    return;
                }
                $.post(window.hotelTotalUrl, hotelQueryData(), function (data) {
                    var success = (data && data.success != null) ? data.success : 0;
                    var failed = (data && data.failed != null) ? data.failed : 0;
                    var pending = (data && data.pending != null) ? data.pending : 0;
                    $('#successtotal').text('Success: ₹ ' + success);
                    $('#Failedtotal').text('Failed: ₹ ' + failed);
                    $('#Pendingtotal').text('Pending: ₹ ' + pending);
                    $chip.data('loaded', true).show();
                });
            });

            var pageindex = 2;
            var noMoreData = $('#trow .vm-opr-table-empty-row').length > 0;
            var inProgress = false;
            var scrollUrl = $('#dealerHotelReportForm').attr('data-scroll-url') || '';
            $(window).off('scroll.vmHotel').on('scroll.vmHotel', function () {
                if (!scrollUrl || noMoreData || inProgress) {
                    return;
                }
                if ($(window).scrollTop() + $(window).height() < $(document).height() - 220) {
                    return;
                }
                inProgress = true;
                $('#loadingdiv').show();
                var payload = hotelQueryData();
                payload.pageindex = pageindex;
                $.post(scrollUrl, payload, function (data) {
                    pageindex = pageindex + 1;
                    noMoreData = !!(data && data.NoMoredata);
                    if (data && data.HTMLString) {
                        var html = String(data.HTMLString);
                        if (html.indexOf('vm-opr-table-empty-row') === -1) {
                            $('#trow .vm-opr-table-empty-row').remove();
                            $('#trow').append(html);
                        }
                    }
                    $('#loadingdiv').hide();
                    inProgress = false;
                }).fail(function () {
                    $('#loadingdiv').hide();
                    inProgress = false;
                });
            });
        }

        if ($.fn.select2) {
            afterPlugins();
            return;
        }
        hotelLoadScript(window.hotelSelect2Url, afterPlugins);
    }

    if (document.readyState === 'complete') {
        bootDealerHotelReport();
    } else {
        window.addEventListener('load', bootDealerHotelReport);
    }
</script>

@section LateCss {
    <style>
        body.saas-admin-ui section.content.saas-dealer-flight-report-page .vm-inc-filter-row .form-control,
        body.saas-admin-ui section.content.saas-dealer-flight-report-page .vm-inc-filter-row input.form-control,
        body.saas-admin-ui section.content.saas-dealer-flight-report-page .vm-inc-filter-row select.form-control,
        body.saas-admin-ui section.content.saas-dealer-flight-report-page .vm-inc-filter-row .vm-opr-select,
        body.saas-admin-ui section.content.saas-dealer-flight-report-page .vm-inc-filter-row .vm-inc-msg-input,
        body.saas-admin-ui section.content.saas-dealer-flight-report-page .vm-inc-filter-row .saas-acc-dp-input,
        body.saas-admin-ui section.content.saas-dealer-flight-report-page .vm-inc-filter-row .saas-acc-btn--search,
        body.saas-admin-ui section.content.saas-dealer-flight-report-page .vm-inc-filter-row .saas-acc-btn--search span,
        body.saas-admin-ui section.content.saas-dealer-flight-report-page .vm-inc-filter-row .vm-opr-toolbar-search,
        body.saas-admin-ui section.content.saas-dealer-flight-report-page .vm-inc-filter-row .vm-opr-toolbar-search span,
        body.saas-admin-ui section.content.saas-dealer-flight-report-page span.select2-selection__rendered,
        body.saas-admin-ui section.content.saas-dealer-flight-report-page span.select2-selection__placeholder,
        body.saas-admin-ui section.content.saas-dealer-flight-report-page span:not(.saas-acc-dp-icon).select2-selection__rendered,
        body.saas-admin-ui section.content.saas-dealer-flight-report-page .vm-flight-select2 .select2-selection__rendered,
        body.saas-admin-ui section.content.saas-dealer-flight-report-page .vm-flight-select2 .select2-selection__placeholder {
            font-size: 14px !important;
            font-weight: 600 !important;
        }
        body.saas-admin-ui.saas-flight-report-dp-page .select2-dropdown,
        body.saas-admin-ui.saas-flight-report-dp-page .select2-dropdown .select2-results__option,
        body.saas-admin-ui.saas-flight-report-dp-page .select2-dropdown .select2-search__field,
        body.saas-admin-ui .select2-dropdown.vm-flight-select2-drop,
        body.saas-admin-ui .select2-dropdown.vm-flight-select2-drop .select2-results__option,
        body.saas-admin-ui .select2-dropdown.vm-flight-select2-drop .select2-search__field,
        body.saas-admin-ui .select2-container--open .select2-dropdown.vm-flight-select2-drop .select2-results__option {
            font-size: 14px !important;
            font-weight: 600 !important;
        }
        @@media (max-width: 991px) {
            body.saas-admin-ui.saas-flight-report-dp-page .datepicker.dropdown-menu,
            body.saas-admin-ui .datepicker.vm-flight-dp {
                position: fixed !important;
                width: calc(100vw - 32px) !important;
                max-width: 320px !important;
                box-sizing: border-box !important;
                overflow: hidden !important;
                z-index: 12000 !important;
            }
            body.saas-admin-ui.saas-flight-report-dp-page .datepicker table,
            body.saas-admin-ui .datepicker.vm-flight-dp table {
                width: 100% !important;
                max-width: 100% !important;
                table-layout: fixed !important;
            }
            body.saas-admin-ui.saas-flight-report-dp-page .datepicker table tr td,
            body.saas-admin-ui.saas-flight-report-dp-page .datepicker table tr th,
            body.saas-admin-ui .datepicker.vm-flight-dp table tr td,
            body.saas-admin-ui .datepicker.vm-flight-dp table tr th {
                width: 14.28% !important;
                min-width: 0 !important;
                padding: 4px 0 !important;
            }
        }
    </style>
}
