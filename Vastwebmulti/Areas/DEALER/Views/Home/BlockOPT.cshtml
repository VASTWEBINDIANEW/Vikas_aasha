<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    window.blockOptSelect2Url = '@Url.Content("~/MainFrontDesign/select2/dist/js/select2.full.min.js")';
    window.blockOptNickName = '@Html.Raw(HttpUtility.JavaScriptStringEncode(nick))';

    function blockOptSearch() {
        var $ = window.jQuery;
        var value = ($('#myInput').val() || '').toLowerCase();
        $('#blockOptTable tbody tr').filter(function () {
            if ($(this).hasClass('vm-opr-table-empty-row')) {
                return true;
            }
            $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
        });
    }

    function toggleBlockOptTotals() {
        var $ = window.jQuery;
        var panel = $('#blockOptTotalsPanel');
        if (panel.is(':visible')) {
            hideBlockOptTotals();
            return;
        }
        panel.slideDown(180).attr('aria-hidden', 'false');
        $('.vm-block-opt-totals-btn').attr('aria-expanded', 'true');
    }

    function hideBlockOptTotals() {
        var $ = window.jQuery;
        $('#blockOptTotalsPanel').slideUp(180).attr('aria-hidden', 'true');
        $('.vm-block-opt-totals-btn').attr('aria-expanded', 'false');
    }

    function blockOptEsc(value) {
        return String(value == null ? '' : value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function blockOptTableRows() {
        var $ = window.jQuery;
        var rows = [];
        $('#blockOptTable tbody tr').each(function () {
            var $tr = $(this);
            if ($tr.hasClass('vm-opr-table-empty-row') || !$tr.is(':visible')) {
                return;
            }
            var $cells = $tr.children('td');
            if ($cells.length < 4) {
                return;
            }
            rows.push({
                sr: $.trim($cells.eq(0).text()).replace(/\s+/g, ' '),
                operator: $.trim($cells.eq(1).text()).replace(/\s+/g, ' '),
                type: $.trim($cells.eq(2).text()).replace(/\s+/g, ' '),
                status: $.trim($cells.eq(3).text()).replace(/\s+/g, ' ')
            });
        });
        return rows;
    }

    function blockOptExportStyles() {
        return 'body{font-family:Segoe UI,Arial,sans-serif;padding:24px;color:#0f172a;background:#fff;}'
            + '.vm-block-export-head{margin:0 0 18px;padding-bottom:14px;border-bottom:2px solid #e2e8f0;}'
            + '.vm-block-export-head h3{margin:0 0 6px;font-size:22px;font-weight:700;color:#1e293b;}'
            + '.vm-block-export-head p{margin:0;font-size:13px;color:#64748b;line-height:1.5;}'
            + '.vm-block-export-summary{display:flex;flex-wrap:wrap;gap:10px;margin:0 0 18px;}'
            + '.vm-block-export-chip{display:inline-block;padding:6px 12px;border-radius:999px;background:#eef2ff;color:#3730a3;font-size:12px;font-weight:700;}'
            + 'table{border-collapse:collapse;width:100%;font-size:12px;}'
            + 'th,td{border:1px solid #dbe4f0;padding:8px 10px;text-align:center;vertical-align:middle;}'
            + 'th{background:linear-gradient(180deg,#f8fafc 0%,#eef2f7 100%);color:#334155;font-weight:700;}'
            + 'tbody tr:nth-child(even){background:#f8fafc;}'
            + 'td.vm-block-export-name{text-align:left;font-weight:600;}'
            + 'td.vm-block-export-on{color:#047857;font-weight:700;}'
            + 'td.vm-block-export-off{color:#b91c1c;font-weight:700;}';
    }

    function blockOptBuildExportHtml(rows, title) {
        var userLabel = window.blockOptNickName || 'User';
        var selectedUser = '';
        var $ = window.jQuery;
        if ($ && $('#rem').length) {
            selectedUser = $.trim($('#rem option:selected').text() || '');
        }
        var body = '';
        for (var i = 0; i < rows.length; i++) {
            var r = rows[i];
            var statusClass = (r.status || '').toUpperCase().indexOf('ON') >= 0 ? 'vm-block-export-on' : 'vm-block-export-off';
            body += '<tr>'
                + '<td>' + blockOptEsc(r.sr) + '</td>'
                + '<td class="vm-block-export-name">' + blockOptEsc(r.operator) + '</td>'
                + '<td>' + blockOptEsc(r.type) + '</td>'
                + '<td class="' + statusClass + '">' + blockOptEsc(r.status) + '</td>'
                + '</tr>';
        }

        return '<html><head><meta charset="utf-8"><title>' + blockOptEsc(title) + '</title>'
            + '<style>' + blockOptExportStyles() + '</style></head><body>'
            + '<div class="vm-block-export-head">'
            + '<h3>' + blockOptEsc(title) + '</h3>'
            + '<p>Generated on ' + blockOptEsc(new Date().toLocaleString()) + '</p>'
            + '</div>'
            + '<div class="vm-block-export-summary">'
            + '<span class="vm-block-export-chip">' + blockOptEsc(userLabel) + ': ' + blockOptEsc(selectedUser || 'All') + '</span>'
            + '<span class="vm-block-export-chip">Records: ' + rows.length + '</span>'
            + '</div>'
            + '<table><thead><tr>'
            + '<th>Sr.No</th><th>Operator Name</th><th>Operator Type</th><th>Status</th>'
            + '</tr></thead><tbody>' + body + '</tbody></table></body></html>';
    }

    function blockOptDownloadExcel(html) {
        var blob = new Blob(['\ufeff', html], { type: 'application/vnd.ms-excel;charset=utf-8;' });
        if (window.navigator && window.navigator.msSaveOrOpenBlob) {
            window.navigator.msSaveOrOpenBlob(blob, 'Block_Service_Report.xls');
            return;
        }
        var url = URL.createObjectURL(blob);
        var link = document.createElement('a');
        link.href = url;
        link.download = 'Block_Service_Report.xls';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        setTimeout(function () { URL.revokeObjectURL(url); }, 800);
    }

    function blockOptOpenPdf(html) {
        var w = window.open('', '_blank');
        if (!w) {
            return;
        }
        w.document.open();
        w.document.write(html);
        w.document.close();
        w.focus();
    }

    function blockOptWarnNoRecords() {
        if (typeof swal === 'function') {
            swal('No records to export', '', 'warning');
            return;
        }
        window.alert('No records to export');
    }

    function blockOptLoadScript(src, done) {
        var s = document.createElement('script');
        s.src = src;
        s.onload = done;
        s.onerror = done;
        document.body.appendChild(s);
    }

    function bootBlockOptPage() {
        var $ = window.jQuery;
        if (!$) {
            window.setTimeout(bootBlockOptPage, 50);
            return;
        }

        function blockOptInitSelect2($el) {
            if (!$el || !$el.length || !$.fn.select2) {
                return;
            }
            if ($el.hasClass('select2-hidden-accessible')) {
                try { $el.select2('destroy'); } catch (ignore) { }
            }
            var placeholder = ($el.data('placeholder') || $el.attr('data-placeholder') || $el.attr('title') || 'Select').toString();
            $el.select2({
                width: '100%',
                dropdownParent: $('body'),
                placeholder: placeholder,
                allowClear: true,
                containerCssClass: 'vm-block-opt-select2',
                dropdownCssClass: 'vm-block-opt-select2-drop',
                minimumResultsForSearch: 0,
                language: {
                    noResults: function () { return 'No matching result'; },
                    searching: function () { return 'Searching...'; }
                }
            });
        }

        function blockOptClearSelect2Search() {
            var field = document.querySelector('.select2-dropdown.vm-block-opt-select2-drop .select2-search__field');
            if (!field) {
                return;
            }
            field.value = '';
            field.focus();
            if (typeof Event === 'function') {
                field.dispatchEvent(new Event('input', { bubbles: true }));
            }
        }

        function afterPlugins() {
            $('.saas-dealer-block-opt-page select.for-select2').each(function () {
                blockOptInitSelect2($(this));
            });

            $(document).off('select2:open.blockOptSearch').on('select2:open.blockOptSearch', '.saas-dealer-block-opt-page select.for-select2', function () {
                window.setTimeout(blockOptClearSelect2Search, 0);
            });

            $('#btnExport').off('click.blockOptEx').on('click.blockOptEx', function () {
                var rows = blockOptTableRows();
                if (!rows.length) {
                    blockOptWarnNoRecords();
                    return;
                }
                blockOptDownloadExcel(blockOptBuildExportHtml(rows, 'Block Service Report'));
            });

            $('#btnPDF').off('click.blockOptPdf').on('click.blockOptPdf', function () {
                var rows = blockOptTableRows();
                if (!rows.length) {
                    blockOptWarnNoRecords();
                    return;
                }
                blockOptOpenPdf(blockOptBuildExportHtml(rows, 'Block Service Report'));
            });
        }

        if ($.fn.select2) {
            afterPlugins();
            return;
        }
        blockOptLoadScript(window.blockOptSelect2Url, afterPlugins);
    }

    if (document.readyState === 'complete') {
        bootBlockOptPage();
    } else {
        window.addEventListener('load', bootBlockOptPage);
    }
</script>

