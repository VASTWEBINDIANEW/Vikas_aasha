@using Vastwebmulti.Models;
@model IEnumerable<Vastwebmulti.Models.select_operator_retailer_Result>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Block Service's";
    Layout = "~/Areas/DEALER/Views/Shared/_Layout.cshtml";

    var nick = "Retailer";
    VastwebmultiEntities DB1 = new VastwebmultiEntities();
    var usernname = DB1.Usernicknames.Where(aa => aa.Role == "Retailer").ToList();
    if (usernname.Any())
    {
        var row = usernname.SingleOrDefault();
        if (row != null && row.Role == "Retailer" && !string.IsNullOrWhiteSpace(row.NickName))
        {
            nick = row.NickName;
        }
    }
    ViewBag.nickname = nick;

    var rows = Model ?? Enumerable.Empty<select_operator_retailer_Result>();
    var rowList = rows.ToList();
    var rowCount = rowList.Count;
    var activeCount = rowList.Count(x => x.status);
    var blockedCount = rowList.Count(x => !x.status);

    var selectedOpttype = (Request["opttype"] ?? "").Trim();
    var selectedRem = (Request["rem"] ?? "").Trim();

    var opttypeItems = new List<SelectListItem>
    {
        new SelectListItem { Value = "", Text = "", Selected = string.IsNullOrEmpty(selectedOpttype) }
    };
    var opttypeSelect = ViewBag.opttype as SelectList;
    if (opttypeSelect != null)
    {
        foreach (SelectListItem item in opttypeSelect)
        {
            var label = !string.IsNullOrWhiteSpace(item.Text) ? item.Text.Trim() : (item.Value ?? "").Trim();
            if (string.IsNullOrWhiteSpace(label))
            {
                continue;
            }
            opttypeItems.Add(new SelectListItem
            {
                Value = label,
                Text = label,
                Selected = string.Equals(label, selectedOpttype, StringComparison.OrdinalIgnoreCase)
            });
        }
    }

    var remItems = new List<SelectListItem>
    {
        new SelectListItem { Value = "", Text = "", Selected = string.IsNullOrEmpty(selectedRem) }
    };
    var retailerSelect = ViewBag.retailer as SelectList;
    if (retailerSelect != null)
    {
        foreach (SelectListItem item in retailerSelect)
        {
            var val = (item.Value ?? "").Trim();
            var txt = !string.IsNullOrWhiteSpace(item.Text) ? item.Text.Trim() : val;
            if (string.IsNullOrWhiteSpace(val))
            {
                continue;
            }
            remItems.Add(new SelectListItem
            {
                Value = val,
                Text = txt,
                Selected = string.Equals(val, selectedRem, StringComparison.OrdinalIgnoreCase)
            });
        }
    }
}

