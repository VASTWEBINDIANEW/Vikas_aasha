@model IEnumerable<Vastwebmulti.Models.microatm_rental_report_Result>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Microatm Rental Report";
    Layout = "~/Areas/DEALER/Views/Shared/_Layout.cshtml";

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";

    var reports = Model ?? Enumerable.Empty<Vastwebmulti.Models.microatm_rental_report_Result>();
    var nick = (ViewBag.nickname as string);
    if (string.IsNullOrWhiteSpace(nick)) { nick = "Dealer"; }
    var totalComm = reports.Sum(x => x.dlmcomm ?? 0m);
    var totalTrans = reports.Sum(x => x.nooftrans ?? 0);
    var totalGst = reports.Sum(x => x.dlmgst ?? 0m);
    var totalTds = reports.Sum(x => x.dlmtds ?? 0m);
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=15" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/dealer-dth-booking-report-modern.css?v=22" rel="stylesheet" />
<script>document.body.classList.add('saas-sell-rch-dp-page');</script>

<div id="loadermoney" class="vm-dmt-loader" style="display:none;"></div>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-dth-booking-report-page saas-sell-recharge-report-page saas-ecommerce-report-page saas-giftcard-report-page saas-matm-rental-report-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var rentalFormAttrs = new Dictionary<string, object>
            {
                { "id", "dealerMatmRentalReportForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("Dealer_Microatm_rental_report", "Home", FormMethod.Post, rentalFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Reports</li>
                        <li>Microatm Rental Report</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters">
                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "txt_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>
                    </div>

                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="matmRentalTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Microatm rental totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideMatmRentalTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--primary">
                            <span class="vm-opr-total-card__label">Total Commission</span>
                            <strong class="vm-opr-total-card__value">@totalComm.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Num. of Trans</span>
                            <strong class="vm-opr-total-card__value">@totalTrans</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">@nick GST</span>
                            <strong class="vm-opr-total-card__value">@totalGst.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">@nick TDS</span>
                            <strong class="vm-opr-total-card__value">@totalTds.ToString("N2")</strong>
                        </div>
                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-tablet-alt" aria-hidden="true"></i>
                        <span>Microatm rental report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-inline-total" title="Total commission for current filter">
                            Total: <strong>&#8377; @totalComm.ToString("N2")</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-radiant-totals-btn vm-sell-rch-totals-btn vm-ecom-totals-btn vm-gift-totals-btn vm-matm-rental-totals-btn" onclick="toggleMatmRentalTotals()" title="Show totals" aria-expanded="false" aria-controls="matmRentalTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="sellRechargeReport" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Frm&nbsp;Name</th>
                                    <th>DeviceId</th>
                                    <th>Plan&nbsp;Name</th>
                                    <th>Num.of&nbsp;Trans</th>
                                    <th>Trans&nbsp;Date</th>
                                    <th>Curr&nbsp;Date</th>
                                    <th>@nick&nbsp;Pre</th>
                                    <th>@nick&nbsp;Commission</th>
                                    <th>@nick&nbsp;GST</th>
                                    <th>@nick&nbsp;TDS</th>
                                    <th>@nick&nbsp;Post</th>
                                </tr>
                            </thead>
                            <tbody>
                                @Html.Partial("_Dealer_Microatm_rental_report", reports)
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<script src="~/MainFrontDesign/js/admin-report-datepicker.js?v=3"></script>
<script>
    window.matmRentalExcelUrl = '@Url.Action("Excel_Dealer_Microatm_rental_report", "Home")';
    window.matmRentalPdfUrl = '@Url.Action("PDF_Dealer_Microatm_rental_report", "Home")';
    window.matmRentalNick = '@Html.Raw((nick ?? "Dealer").Replace("\\", "\\\\").Replace("'", "\\'"))';

    function matmRentalQueryData() {
        var $ = window.jQuery;
        return {
            txt_frm_date: $('#txt_frm_date').val() || '',
            txt_to_date: $('#txt_to_date').val() || ''
        };
    }

    function matmRentalQueryString() {
        var q = matmRentalQueryData();
        return 'txt_frm_date=' + encodeURIComponent(q.txt_frm_date)
            + '&txt_to_date=' + encodeURIComponent(q.txt_to_date);
    }

    function matmRentalEsc(value) {
        return String(value == null ? '' : value)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function matmRentalNum(value) {
        var n = parseFloat(String(value || '').replace(/,/g, '').replace(/[^\d.-]/g, ''));
        return isNaN(n) ? 0 : n;
    }

    function matmRentalNow() {
        var d = new Date();
        var months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        var h = d.getHours();
        var ampm = h >= 12 ? 'PM' : 'AM';
        var hr = h % 12; if (!hr) { hr = 12; }
        var min = d.getMinutes();
        return ('0' + d.getDate()).slice(-2) + ' ' + months[d.getMonth()] + ' ' + d.getFullYear() + ', ' + ('0' + hr).slice(-2) + ':' + ('0' + min).slice(-2) + ' ' + ampm;
    }

    function matmRentalTableRows() {
        var $ = window.jQuery;
        var rows = [];
        $('#sellRechargeReport tbody tr').each(function () {
            var $tr = $(this);
            if ($tr.hasClass('vm-opr-table-empty-row')) {
                return;
            }
            var $cells = $tr.children('td');
            if ($cells.length < 11) {
                return;
            }
            rows.push({
                firm: $.trim($cells.eq(0).text()).replace(/\s+/g, ' '),
                device: $.trim($cells.eq(1).text()).replace(/\s+/g, ' '),
                plan: $.trim($cells.eq(2).text()).replace(/\s+/g, ' '),
                trans: $.trim($cells.eq(3).text()).replace(/\s+/g, ' '),
                transDate: $.trim($cells.eq(4).text()).replace(/\s+/g, ' '),
                currDate: $.trim($cells.eq(5).text()).replace(/\s+/g, ' '),
                pre: $.trim($cells.eq(6).text()).replace(/\s+/g, ' '),
                comm: $.trim($cells.eq(7).text()).replace(/\s+/g, ' '),
                gst: $.trim($cells.eq(8).text()).replace(/\s+/g, ' '),
                tds: $.trim($cells.eq(9).text()).replace(/\s+/g, ' '),
                post: $.trim($cells.eq(10).text()).replace(/\s+/g, ' ')
            });
        });
        return rows;
    }

    function matmRentalExportMeta(rows) {
        var q = matmRentalQueryData();
        var comm = 0, trans = 0, gst = 0, tds = 0;
        for (var i = 0; i < rows.length; i++) {
            comm += matmRentalNum(rows[i].comm);
            trans += matmRentalNum(rows[i].trans);
            gst += matmRentalNum(rows[i].gst);
            tds += matmRentalNum(rows[i].tds);
        }
        return {
            generatedOn: matmRentalNow(),
            frmDate: q.txt_frm_date || '-',
            toDate: q.txt_to_date || '-',
            records: rows.length,
            comm: comm.toFixed(2),
            trans: String(trans),
            gst: gst.toFixed(2),
            tds: tds.toFixed(2),
            nick: window.matmRentalNick || 'Dealer'
        };
    }

    function matmRentalHeads(nick) {
        return ['Frm Name', 'DeviceId', 'Plan Name', 'Num.of Trans', 'Trans Date', 'Curr Date', nick + ' Pre', nick + ' Commission', nick + ' GST', nick + ' TDS', nick + ' Post'];
    }

    function matmRentalBuildExcelHtml(rows) {
        var m = matmRentalExportMeta(rows);
        var html = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel"><head><meta charset="utf-8" /><title>Microatm Rental Report</title></head><body>';
        html += '<table border="1" cellspacing="0" cellpadding="6" style="border-collapse:collapse;">';
        html += '<tr><td colspan="11" bgcolor="#2563EB" style="color:#FFFFFF;font-size:16pt;font-weight:bold;">Microatm Rental Report</td></tr>';
        html += '<tr><td colspan="11" bgcolor="#1D4ED8" style="color:#DBEAFE;font-size:10pt;">Dealer reports - microatm rental</td></tr>';
        html += '<tr><td bgcolor="#F1F5F9" style="font-weight:bold;">Generated On</td><td colspan="2" style="font-weight:bold;">' + matmRentalEsc(m.generatedOn) + '</td>';
        html += '<td bgcolor="#F1F5F9" style="font-weight:bold;">Date Range</td><td colspan="3" style="font-weight:bold;">' + matmRentalEsc(m.frmDate) + ' to ' + matmRentalEsc(m.toDate) + '</td>';
        html += '<td bgcolor="#F1F5F9" style="font-weight:bold;">Records</td><td style="font-weight:bold;">' + m.records + '</td><td colspan="2">&nbsp;</td></tr>';
        html += '<tr><td bgcolor="#EEF2FF" style="font-weight:bold;">Total Commission</td><td bgcolor="#EEF2FF" style="font-weight:bold;">' + m.comm + '</td>';
        html += '<td bgcolor="#ECFDF5" style="font-weight:bold;color:#047857;">Num. of Trans</td><td bgcolor="#ECFDF5" style="font-weight:bold;color:#047857;">' + m.trans + '</td>';
        html += '<td bgcolor="#FEFCE8" style="font-weight:bold;color:#854D0E;">GST</td><td bgcolor="#FEFCE8" style="font-weight:bold;color:#854D0E;">' + m.gst + '</td>';
        html += '<td bgcolor="#FEF2F2" style="font-weight:bold;color:#B91C1C;">TDS</td><td bgcolor="#FEF2F2" style="font-weight:bold;color:#B91C1C;">' + m.tds + '</td><td colspan="3">&nbsp;</td></tr>';
        html += '<tr>';
        var heads = matmRentalHeads(m.nick);
        for (var h = 0; h < heads.length; h++) {
            html += '<th bgcolor="#334155" style="color:#FFFFFF;font-weight:bold;">' + matmRentalEsc(heads[h]) + '</th>';
        }
        html += '</tr>';
        if (!rows.length) {
            html += '<tr><td colspan="11" bgcolor="#F8FAFC" style="text-align:center;font-weight:bold;color:#64748B;height:48px;">Microatm rental report not found.</td></tr>';
        } else {
            for (var i = 0; i < rows.length; i++) {
                var r = rows[i];
                var rowBg = (i % 2 === 1) ? '#F8FAFC' : '#FFFFFF';
                html += '<tr>';
                html += '<td bgcolor="' + rowBg + '">' + matmRentalEsc(r.firm) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + matmRentalEsc(r.device) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + matmRentalEsc(r.plan) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + matmRentalEsc(r.trans) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + matmRentalEsc(r.transDate) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + matmRentalEsc(r.currDate) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + matmRentalEsc(r.pre) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + matmRentalEsc(r.comm) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + matmRentalEsc(r.gst) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + matmRentalEsc(r.tds) + '</td>';
                html += '<td bgcolor="' + rowBg + '">' + matmRentalEsc(r.post) + '</td>';
                html += '</tr>';
            }
        }
        html += '</table></body></html>';
        return html;
    }

    function matmRentalBuildPdfHtml(rows) {
        var m = matmRentalExportMeta(rows);
        var heads = matmRentalHeads(m.nick);
        var body = '';
        if (!rows.length) {
            body = '<tr><td colspan="11" class="empty">Microatm rental report not found.</td></tr>';
        } else {
            for (var i = 0; i < rows.length; i++) {
                var r = rows[i];
                body += '<tr>';
                body += '<td>' + matmRentalEsc(r.firm) + '</td>';
                body += '<td>' + matmRentalEsc(r.device) + '</td>';
                body += '<td>' + matmRentalEsc(r.plan) + '</td>';
                body += '<td>' + matmRentalEsc(r.trans) + '</td>';
                body += '<td>' + matmRentalEsc(r.transDate) + '</td>';
                body += '<td>' + matmRentalEsc(r.currDate) + '</td>';
                body += '<td>' + matmRentalEsc(r.pre) + '</td>';
                body += '<td>' + matmRentalEsc(r.comm) + '</td>';
                body += '<td>' + matmRentalEsc(r.gst) + '</td>';
                body += '<td>' + matmRentalEsc(r.tds) + '</td>';
                body += '<td>' + matmRentalEsc(r.post) + '</td>';
                body += '</tr>';
            }
        }
        var headHtml = '';
        for (var h = 0; h < heads.length; h++) {
            headHtml += '<th>' + matmRentalEsc(heads[h]) + '</th>';
        }
        return '<!DOCTYPE html><html><head><meta charset="utf-8" /><title>Microatm Rental Report</title><style type="text/css">'
            + '@@page { size: A4 landscape; margin: 10mm 8mm 12mm 8mm; }'
            + '* { box-sizing: border-box; } body { margin:0; padding:16px; font-family:Arial,Helvetica,sans-serif; font-size:11px; color:#0f172a; background:#fff; -webkit-print-color-adjust:exact; print-color-adjust:exact; }'
            + 'table { border-collapse:collapse; } .hero { width:100%; border:1px solid #1d4ed8; } .hero-top { padding:14px 18px; background:#2563eb; color:#fff; }'
            + '.hero-top h1 { margin:0; font-size:20px; } .hero-top p { margin:4px 0 0; font-size:11px; color:#dbeafe; }'
            + '.meta { width:100%; background:#f8fafc; } .meta td { padding:8px 12px; border-right:1px solid #e2e8f0; }'
            + '.meta-label { display:block; font-size:9px; font-weight:700; letter-spacing:.06em; text-transform:uppercase; color:#64748b; margin-bottom:3px; }'
            + '.meta-value { font-size:12px; font-weight:700; } .cards { width:100%; margin:12px 0; } .cards td { width:25%; padding:0 6px 0 0; }'
            + '.card { border:1px solid #e2e8f0; padding:10px 12px; } .card-label { display:block; font-size:9px; font-weight:700; text-transform:uppercase; margin-bottom:4px; } .card-value { font-size:16px; font-weight:800; }'
            + '.card-total { background:#eef2ff; } .card-ok { background:#ecfdf5; } .card-fail { background:#fef2f2; } .card-wait { background:#fefce8; }'
            + '.grid { width:100%; border:1px solid #cbd5e1; } .grid th { padding:9px 7px; text-align:left; font-size:10px; font-weight:700; text-transform:uppercase; color:#fff; background:#334155; }'
            + '.grid td { padding:8px 7px; font-size:11px; border-top:1px solid #e2e8f0; } .grid tbody tr:nth-child(even) td { background:#f8fafc; }'
            + '.empty { padding:36px 16px; text-align:center; font-size:14px; font-weight:700; color:#64748b; background:#f8fafc; }'
            + '.foot { margin-top:10px; padding-top:8px; border-top:1px dashed #cbd5e1; font-size:10px; color:#94a3b8; text-align:center; }'
            + '</style></head><body><div class="sheet"><div class="hero"><div class="hero-top"><h1>Microatm Rental Report</h1><p>Dealer reports - microatm rental</p></div>'
            + '<table class="meta" cellpadding="0" cellspacing="0"><tr>'
            + '<td style="width:40%;"><span class="meta-label">Generated On</span><span class="meta-value">' + matmRentalEsc(m.generatedOn) + '</span></td>'
            + '<td style="width:40%;"><span class="meta-label">Date Range</span><span class="meta-value">' + matmRentalEsc(m.frmDate) + ' to ' + matmRentalEsc(m.toDate) + '</span></td>'
            + '<td style="width:20%;"><span class="meta-label">Records</span><span class="meta-value">' + m.records + '</span></td>'
            + '</tr></table></div>'
            + '<table class="cards" cellpadding="0" cellspacing="0"><tr>'
            + '<td><div class="card card-total"><span class="card-label">Total Commission</span><span class="card-value">' + m.comm + '</span></div></td>'
            + '<td><div class="card card-ok"><span class="card-label">Num. of Trans</span><span class="card-value">' + m.trans + '</span></div></td>'
            + '<td><div class="card card-wait"><span class="card-label">GST</span><span class="card-value">' + m.gst + '</span></div></td>'
            + '<td><div class="card card-fail"><span class="card-label">TDS</span><span class="card-value">' + m.tds + '</span></div></td>'
            + '</tr></table>'
            + '<table class="grid" cellpadding="0" cellspacing="0"><thead><tr>' + headHtml + '</tr></thead><tbody>' + body + '</tbody></table>'
            + '<div class="foot">Generated from Dealer panel - Microatm Rental Report</div></div></body></html>';
    }

    function matmRentalDownloadExcel(html) {
        var blob = new Blob(['\ufeff', html], { type: 'application/vnd.ms-excel' });
        if (window.navigator && window.navigator.msSaveOrOpenBlob) {
            window.navigator.msSaveOrOpenBlob(blob, 'Microatm_Rental_Report.xls');
            return;
        }
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'Microatm_Rental_Report.xls';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        setTimeout(function () { URL.revokeObjectURL(url); }, 800);
    }

    function matmRentalOpenPdf(html) {
        var w = window.open('', '_blank');
        if (!w) {
            return;
        }
        w.document.open();
        w.document.write(html);
        w.document.close();
    }

    function toggleMatmRentalTotals() {
        var $ = window.jQuery;
        var panel = $('#matmRentalTotalsPanel');
        var btn = $('.vm-matm-rental-totals-btn');
        if (panel.is(':visible')) {
            hideMatmRentalTotals();
            return;
        }
        panel.slideDown(180).attr('aria-hidden', 'false');
        btn.attr('aria-expanded', 'true');
    }

    function hideMatmRentalTotals() {
        var $ = window.jQuery;
        $('#matmRentalTotalsPanel').slideUp(180).attr('aria-hidden', 'true');
        $('.vm-matm-rental-totals-btn').attr('aria-expanded', 'false');
    }

    function bootMatmRentalReport() {
        var $ = window.jQuery;
        if (!$ || !$.fn || !$.fn.datepicker) {
            window.setTimeout(bootMatmRentalReport, 50);
            return;
        }

        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm('#dealerMatmRentalReportForm');
        } else {
            $('#txt_frm_date, #txt_to_date').datepicker({
                format: 'yyyy-mm-dd',
                todayHighlight: true,
                autoclose: true,
                orientation: 'bottom auto',
                container: 'body'
            });
            if ($('#dealerMatmRentalReportForm').attr('data-date-mode') !== 'post') {
                $('#txt_frm_date').datepicker('setDate', new Date());
                $('#txt_to_date').datepicker('setDate', new Date());
            }
        }

        function pinMatmRentalDatepicker(e) {
            if (typeof window.repositionAdminDatepickerForMobile === 'function') {
                window.repositionAdminDatepickerForMobile(e && e.target ? e.target : this);
            }
        }
        $(document).off('show.matmRentDp shown.matmRentDp').on('show.matmRentDp shown.matmRentDp', '#txt_frm_date, #txt_to_date', pinMatmRentalDatepicker);
        $(window).off('resize.matmRentDp orientationchange.matmRentDp').on('resize.matmRentDp orientationchange.matmRentDp', pinMatmRentalDatepicker);

        $('#btnExport').off('click.matmRentEx').on('click.matmRentEx', function () {
            var rows = matmRentalTableRows();
            if (rows.length) {
                matmRentalDownloadExcel(matmRentalBuildExcelHtml(rows));
                return;
            }
            window.location.href = window.matmRentalExcelUrl + '?' + matmRentalQueryString();
        });
        $('#btnPDF').off('click.matmRentPdf').on('click.matmRentPdf', function () {
            var rows = matmRentalTableRows();
            if (rows.length) {
                matmRentalOpenPdf(matmRentalBuildPdfHtml(rows));
                return;
            }
            window.open(window.matmRentalPdfUrl + '?' + matmRentalQueryString(), '_blank');
        });
    }

    if (document.readyState === 'complete') {
        bootMatmRentalReport();
    } else {
        window.addEventListener('load', bootMatmRentalReport);
    }
</script>

