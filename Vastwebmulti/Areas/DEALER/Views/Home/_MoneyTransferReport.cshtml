@model IEnumerable<Vastwebmulti.Models.money_transfer_report_paging_Result>
@using System.Linq
@{
    Layout = null;
    var items = Model ?? Enumerable.Empty<Vastwebmulti.Models.money_transfer_report_paging_Result>();
}
@if (items.Any())
{
    foreach (var item in items)
    {
        var statusRaw = item.status ?? "";
        var statusTone = "pending";
        var statusLabel = statusRaw;
        var statusFa = "fa-clock-o";
        if (statusRaw.IndexOf("REFUND", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "failed";
            statusLabel = "Refund";
            statusFa = "fa-undo";
        }
        else if (statusRaw.IndexOf("FAILED", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "failed";
            statusLabel = "Failed";
            statusFa = "fa-times";
        }
        else if (statusRaw.IndexOf("SUCCESS", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "success";
            statusLabel = "Success";
            statusFa = "fa-check";
        }
        else if (statusRaw.IndexOf("PENDING", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            statusTone = "pending";
            statusLabel = "Pending";
            statusFa = "fa-clock-o";
        }

        var firm = !string.IsNullOrWhiteSpace(item.frm_name) ? item.frm_name : (item.retailername ?? "—");
        var transType = item.Trans_type ?? "";
        var typeLabel = "Verify";
        if (string.Equals(transType, "IMPS", StringComparison.OrdinalIgnoreCase))
        {
            typeLabel = "IMPS";
        }
        else if (string.Equals(transType, "NEFT", StringComparison.OrdinalIgnoreCase))
        {
            typeLabel = "NEFT";
        }
        var fromLabel = "WEB";
        var fromIcon = "fa-globe";
        if (string.Equals(item.trans_from, "Apps", StringComparison.OrdinalIgnoreCase))
        {
            fromLabel = "APP";
            fromIcon = "fa-android";
        }
        var dmtMark = "";
        if (item.DmtType == "DMT1") { dmtMark = " ➊"; }
        else if (item.DmtType == "DMT2") { dmtMark = " ➋"; }

        decimal amount = item.amount ?? 0;
        decimal remComm = item.rem_comm ?? 0;
        decimal debit;
        if (transType.IndexOf("IMPS_VERIFY", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            debit = remComm;
        }
        else
        {
            debit = amount + remComm;
        }

        var reqDate = item.response_time.HasValue ? item.response_time.Value.ToString("dd-MMM HH:mm:ss") : "—";
        <tr class="vm-dmt-row vm-dmt-row--@statusTone" data-status="@statusRaw">
            <td class="vm-radiant-status-cell vm-ticket-status-cell">
                <span class="vm-dmt-status vm-dmt-status--@statusTone" title="@statusLabel">
                    <i class="fa @statusFa" aria-hidden="true"></i>
                </span>
                <span class="vm-radiant-status-text">@firm</span>
            </td>
            <td>
                <i class="fa @fromIcon" aria-hidden="true" title="@fromLabel"></i>
                <span>@typeLabel</span>@dmtMark
            </td>
            <td>@(item.accountno ?? "—")</td>
            <td>@(item.senderno ?? "—")</td>
            <td class="vm-dmt-amt-cell">@(item.totalamount.HasValue ? item.totalamount.Value.ToString("N2") : "—")</td>
            <td class="vm-dmt-amt-cell">@debit.ToString("N2")</td>
            <td class="vm-dmt-amt-cell">@(item.income.HasValue ? item.income.Value.ToString("N2") : "—")</td>
            <td class="vm-dmt-amt-cell">@(item.dlm_remain_pre.HasValue ? item.dlm_remain_pre.Value.ToString("N2") : "—")</td>
            <td class="vm-dmt-amt-cell">@(item.dlm_income.HasValue ? item.dlm_income.Value.ToString("N2") : "—")</td>
            <td class="vm-dmt-amt-cell">@(item.dlm_remain.HasValue ? item.dlm_remain.Value.ToString("N2") : "—")</td>
            <td>@reqDate</td>
        </tr>
    }
}
else
{
    <tr class="vm-opr-table-empty-row">
        <td colspan="11" class="vm-opr-table-empty">
            <i class="fas fa-exchange-alt" aria-hidden="true"></i>
            <span>Money transfer report not found.</span>
        </td>
    </tr>
}
