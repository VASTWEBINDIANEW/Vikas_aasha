@model IEnumerable<Vastwebmulti.Models.microatm_rental_report_Result>
@using System.Linq
@{
    Layout = null;
    var items = (Model ?? Enumerable.Empty<Vastwebmulti.Models.microatm_rental_report_Result>()).ToList();
}
@if (items.Any())
{
    foreach (var item in items)
    {
        var transDate = item.transdate.HasValue ? item.transdate.Value.ToString("dd-MMM-yyyy") : "-";
        var currDate = item.currdate.HasValue ? item.currdate.Value.ToString("dd-MMM-yyyy") : "-";
        <tr class="vm-dmt-row">
            <td>@(string.IsNullOrWhiteSpace(item.Frm_Name) ? "-" : item.Frm_Name)</td>
            <td>@(string.IsNullOrWhiteSpace(item.deviceid) ? "-" : item.deviceid)</td>
            <td>@(string.IsNullOrWhiteSpace(item.planname) ? "-" : item.planname)</td>
            <td class="vm-dmt-amt-cell">@(item.nooftrans.HasValue ? item.nooftrans.Value.ToString() : "-")</td>
            <td>@transDate</td>
            <td>@currDate</td>
            <td class="vm-dmt-amt-cell">@(item.dlmpre.HasValue ? item.dlmpre.Value.ToString("N2") : "-")</td>
            <td class="vm-dmt-amt-cell">@(item.dlmcomm.HasValue ? item.dlmcomm.Value.ToString("N2") : "-")</td>
            <td class="vm-dmt-amt-cell">@(item.dlmgst.HasValue ? item.dlmgst.Value.ToString("N2") : "-")</td>
            <td class="vm-dmt-amt-cell">@(item.dlmtds.HasValue ? item.dlmtds.Value.ToString("N2") : "-")</td>
            <td class="vm-dmt-amt-cell">@(item.dlmpost.HasValue ? item.dlmpost.Value.ToString("N2") : "-")</td>
        </tr>
    }
}
else
{
    <tr class="vm-opr-table-empty-row">
        <td colspan="11" class="vm-opr-table-empty vm-dmt-table-empty">
            <i class="fas fa-tablet-alt" aria-hidden="true"></i>
            <span>Microatm rental report not found.</span>
        </td>
    </tr>
}
