@using Vastwebmulti.Models
    <link href="~/MainFrontDesign/css/saas-admin-system.css" rel="stylesheet" />
    @{
        var adminLayoutThemeJson = "{\"id\":\"default\",\"name\":\"Classic\",\"topbarBg\":\"#ffffff\",\"sidebarBg\":\"#0b1220\",\"topbarDark\":false}";
        try
        {
            JSONReadWrite adminThemeRw = new JSONReadWrite();
            adminLayoutThemeJson = adminThemeRw.Read("admin-layout-theme.json", "~/JsonData/");
        }
        catch { }
    }
    <script>
        window.__vmAdminServerTheme = @Html.Raw(adminLayoutThemeJson);
        (function () {
            try {
                var theme = window.__vmAdminServerTheme;
                if (!theme || !theme.topbarBg) return;
                localStorage.setItem("vmAdminLayoutTheme", JSON.stringify(theme));
                if (theme.topbarBg) {
                    document.documentElement.style.setProperty("--vm-admin-topbar-bg", theme.topbarBg);
                    var topHeader = document.getElementById("admin-top-header");
                    if (topHeader) {
                        topHeader.style.setProperty("background", theme.topbarBg, "important");
                        topHeader.style.setProperty("background-image", theme.topbarBg, "important");
                    }
                }
                if (theme && theme.sidebarBg) {
                    document.documentElement.style.setProperty("--vm-admin-sidebar-bg", theme.sidebarBg);
                    var sidebar = document.getElementById("leftsidebar");
                    if (sidebar) {
                        sidebar.style.setProperty("background", theme.sidebarBg, "important");
                        sidebar.style.setProperty("background-image", theme.sidebarBg, "important");
                    }
                }
                if (theme && theme.topbarDark) {
                    document.documentElement.classList.add("vm-admin-topbar-dark-pending");
                }
            } catch (e) { }
        })();
    </script>

