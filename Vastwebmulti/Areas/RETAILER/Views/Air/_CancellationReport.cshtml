@model List<Vastwebmulti.Models.proc_FlightCancellationReport_Result>
@using Newtonsoft.Json;
@using System.Web.Mvc.Ajax;
@{
    Layout = null;
    var rows = Model == null ? new List<Vastwebmulti.Models.proc_FlightCancellationReport_Result>() : Model;
}
@if (rows.Count > 0)
{
    foreach (var item in rows)
    {
        var statusTone = "pending";
        var statusFa = "fa-clock-o";
        var dataStatus = "PENDING";
        var sts = item.ChangeRequestStatus.HasValue
            ? ((Vastwebmulti.Areas.RETAILER.Enums.ChangeRequestStatus)Convert.ToInt32(item.ChangeRequestStatus.Value)).ToString()
            : "—";
        if (item.ChangeRequestStatus == 5)
        {
            statusTone = "failed";
            statusFa = "fa-times";
            dataStatus = "FAILED";
        }
        else if (item.ChangeRequestStatus == 4)
        {
            statusTone = "success";
            statusFa = "fa-check";
            dataStatus = "SUCCESS";
        }
        else if (item.ChangeRequestStatus <= 3)
        {
            statusTone = "pending";
            statusFa = "fa-clock-o";
            dataStatus = "PENDING";
        }
        else if (item.ChangeRequestStatus == 6 || item.ChangeRequestStatus == 8)
        {
            statusTone = "refund";
            statusFa = "fa-undo";
            dataStatus = "FAILED";
        }
        else if (item.ChangeRequestStatus == 7)
        {
            statusTone = "info";
            statusFa = "fa-info-circle";
            dataStatus = "PENDING";
        }
        <tr class="vm-dmt-row" data-amount="@(item.RefundedAmount ?? 0)" data-status="@dataStatus">
            <td class="vm-cancel-status-cell">
                <span class="vm-dmt-status vm-dmt-status--@statusTone" title="@sts"><i class="fa @statusFa" aria-hidden="true"></i></span>
                <span class="vm-ticket-status-text vm-cancel-status-text">@sts</span>
            </td>
            <td>
                <span class="vm-dmt-refno-text">@item.RequestType</span>
            </td>
            <td>
                <span class="vm-dmt-refno-text">@item.CancellationType</span>
            </td>
            <td class="vm-cancel-id-cell">
                <span class="vm-dmt-refno-text">@(item.ChangeRequestId.HasValue ? item.ChangeRequestId.Value.ToString() : "—")</span>
            </td>
            <td class="vm-cancel-time-cell">
                <span class="vm-dmt-refno-text">@String.Format("{0:dd-MMM-yyyy HH:mm:ss}", item.CancellationRequestDate)</span>
            </td>
            <td class="vm-cancel-time-cell">
                <span class="vm-dmt-refno-text">@(item.CancellationResponseDate.HasValue ? String.Format("{0:dd-MMM-yyyy HH:mm:ss}", item.CancellationResponseDate.Value) : "—")</span>
            </td>
            <td>
                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @(item.RefundedAmount.HasValue ? Math.Round(item.RefundedAmount.Value, 2).ToString() : "0.00")</span>
            </td>
            <td>
                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @(item.CancellationCharge.HasValue ? Math.Round(item.CancellationCharge.Value, 2).ToString() : "0.00")</span>
            </td>
            <td>
                @if (item.ChangeRequestId.HasValue)
                {
                    @Ajax.ActionLink("STATUS", "CancellationStatus", "Air", new { ChangeReqId = item.ChangeRequestId.Value, idno = item.idno }, new AjaxOptions { HttpMethod = "Post", OnSuccess = "OnSuccess", OnFailure = "OnFailure", LoadingElementId = "loadermoney" }, new { @class = "btn btn-primary btn-sm vm-dmt-status-btn", title = "Check cancellation status" })
                }
            </td>
        </tr>
    }
}
else
{
    <tr class="vm-opr-table-empty-row">
        <td colspan="9">
            <div class="vm-opr-empty-state">
                <i class="fas fa-ban" aria-hidden="true"></i>
                <span>No cancellation records found</span>
            </div>
        </td>
    </tr>
}
