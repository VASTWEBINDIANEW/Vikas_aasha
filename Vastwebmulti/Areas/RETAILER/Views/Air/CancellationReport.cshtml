@model List<Vastwebmulti.Models.proc_FlightCancellationReport_Result>
@using Newtonsoft.Json;
@{
    ViewBag.Title = "Flight Cancellation Report";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";
    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    var selStatus = (Request["ddl_status"] ?? "ALL").Trim();
    if (string.IsNullOrEmpty(selStatus)) { selStatus = "ALL"; }
    var selPNR = (Request["PNR"] ?? "").Trim();
    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=38" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-cancellation-report-modern.css?v=2" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=1" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<style>
    body.saas-admin-ui .saas-dmt-report-page .vm-dmt-filter-row input.vm-cancel-text-input.form-control {
        background-image: none !important;
        cursor: text !important;
        padding: 0 12px !important;
    }
    body.saas-admin-ui .saas-retailer-cancel-report-page #cancellationReport .vm-cancel-status-text {
        display: inline-block;
        vertical-align: middle;
        margin-left: 6px;
        font-size: 0.72rem;
        font-weight: 700;
        color: #334155;
        white-space: nowrap;
    }
    /* Retailer has only 9 columns (ADMIN css targets 25 cols with 3400px min-width) */
    /* Desktop (>=1024px): fit-to-width, no scroll */
    @@media (min-width: 1024px) {
        body.saas-admin-ui .saas-retailer-cancel-report-page #cancellationReport.vm-opr-data-table {
            min-width: 0 !important;
            table-layout: fixed !important;
        }
        body.saas-admin-ui .saas-retailer-cancel-report-page #cancellationReport.vm-opr-data-table thead th,
        body.saas-admin-ui .saas-retailer-cancel-report-page #cancellationReport.vm-opr-data-table tbody td {
            min-width: 0 !important;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        body.saas-admin-ui .saas-retailer-cancel-report-page #cancellationReport.vm-opr-data-table thead th:nth-child(1),
        body.saas-admin-ui .saas-retailer-cancel-report-page #cancellationReport.vm-opr-data-table tbody td:nth-child(1) { width: 17% !important; }
        body.saas-admin-ui .saas-retailer-cancel-report-page #cancellationReport.vm-opr-data-table thead th:nth-child(2),
        body.saas-admin-ui .saas-retailer-cancel-report-page #cancellationReport.vm-opr-data-table tbody td:nth-child(2) { width: 9% !important; }
        body.saas-admin-ui .saas-retailer-cancel-report-page #cancellationReport.vm-opr-data-table thead th:nth-child(3),
        body.saas-admin-ui .saas-retailer-cancel-report-page #cancellationReport.vm-opr-data-table tbody td:nth-child(3) { width: 9% !important; }
        body.saas-admin-ui .saas-retailer-cancel-report-page #cancellationReport.vm-opr-data-table thead th:nth-child(4),
        body.saas-admin-ui .saas-retailer-cancel-report-page #cancellationReport.vm-opr-data-table tbody td:nth-child(4) { width: 12% !important; }
        body.saas-admin-ui .saas-retailer-cancel-report-page #cancellationReport.vm-opr-data-table thead th:nth-child(5),
        body.saas-admin-ui .saas-retailer-cancel-report-page #cancellationReport.vm-opr-data-table tbody td:nth-child(5) { width: 13% !important; }
        body.saas-admin-ui .saas-retailer-cancel-report-page #cancellationReport.vm-opr-data-table thead th:nth-child(6),
        body.saas-admin-ui .saas-retailer-cancel-report-page #cancellationReport.vm-opr-data-table tbody td:nth-child(6) { width: 13% !important; }
        body.saas-admin-ui .saas-retailer-cancel-report-page #cancellationReport.vm-opr-data-table thead th:nth-child(7),
        body.saas-admin-ui .saas-retailer-cancel-report-page #cancellationReport.vm-opr-data-table tbody td:nth-child(7) { width: 11% !important; }
        body.saas-admin-ui .saas-retailer-cancel-report-page #cancellationReport.vm-opr-data-table thead th:nth-child(8),
        body.saas-admin-ui .saas-retailer-cancel-report-page #cancellationReport.vm-opr-data-table tbody td:nth-child(8) { width: 8% !important; }
        body.saas-admin-ui .saas-retailer-cancel-report-page #cancellationReport.vm-opr-data-table thead th:nth-child(9),
        body.saas-admin-ui .saas-retailer-cancel-report-page #cancellationReport.vm-opr-data-table tbody td:nth-child(9) { width: 8% !important; }
    }
    /* Mobile + tablet (<=1023px): natural widths, full text, horizontal scroll */
    @@media (max-width: 1023.98px) {
        body.saas-admin-ui .saas-retailer-cancel-report-page #cancellationReport.vm-opr-data-table {
            min-width: 1020px !important;
            width: max-content !important;
            table-layout: auto !important;
        }
        body.saas-admin-ui .saas-retailer-cancel-report-page #cancellationReport.vm-opr-data-table thead th,
        body.saas-admin-ui .saas-retailer-cancel-report-page #cancellationReport.vm-opr-data-table tbody td {
            min-width: 0 !important;
            width: auto !important;
            overflow: visible !important;
            text-overflow: clip !important;
            white-space: nowrap !important;
        }
        body.saas-admin-ui .saas-retailer-cancel-report-page .vm-opr-table-scroll {
            overflow-x: auto !important;
        }
    }
</style>

<div id="loadermoney" class="vm-dmt-loader" style="display:none;" aria-hidden="true">
    <div class="vm-dmt-loader__panel" role="status" aria-live="polite" aria-label="Processing">
        <div class="vm-dmt-table-loader__spinner" aria-hidden="true"></div>
        <span class="vm-dmt-loader__text">Please wait…</span>
    </div>
</div>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-cancellation-report-page saas-retailer-cancel-report-page">
    <div class="container-fluid vm-opr-page-shell">

        @{
            var cancelFormAttrs = new Dictionary<string, object>
            {
                { "id", "retailerCancelReportForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-report-date-form", "" },
                { "data-report-from", "#retailer_cancel_frm_date" },
                { "data-report-to", "#retailer_cancel_to_date" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("CancellationReport", "Air", FormMethod.Post, cancelFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Travel &amp; Hotels</li>
                        <li>Cancellation Report</li>
                    </ol>
                    <div class="vm-dmt-fin-nav-row vm-ticket-travel-nav-row">
                        @Html.Partial("_FlightMenu")
                    </div>
                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="retailerCancelTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Refunded totals (loaded rows)</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideRetailerCancelTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Success</span>
                            <strong class="vm-opr-total-card__value" id="retailerCancelSuccess">&#8377; 0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Failed</span>
                            <strong class="vm-opr-total-card__value" id="retailerCancelFailed">&#8377; 0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Pending</span>
                            <strong class="vm-opr-total-card__value" id="retailerCancelPending">&#8377; 0.00</strong>
                        </div>
                    </div>
                </div>

                <div class="vm-rpt-filters-panel">
                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--cancel vm-rpt-filters-panel__bar">
                        <div class="vm-opr-field vm-dmt-field" id="sts">
                            @Html.DropDownList("ddl_status", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "All Status", Value = "ALL", Selected = (selStatus == "ALL") },
                                new SelectListItem { Text = "Success", Value = "SUCCESS", Selected = selStatus == "SUCCESS" },
                                new SelectListItem { Text = "Pending", Value = "PENDING", Selected = selStatus == "PENDING" },
                                new SelectListItem { Text = "Failed", Value = "FAILED", Selected = selStatus == "FAILED" }
                            }, new { id = "ddl_status", @class = "vm-opr-select vm-dmt-select form-control", title = "Status" })
                        </div>
                        <div class="vm-opr-field vm-dmt-field vm-dmt-field--pnr">
                            @Html.TextBox("PNR", selPNR, new { @class = "form-control vm-dmt-search-input vm-cancel-pnr-input vm-cancel-text-input", placeholder = "Enter PNR", autocomplete = "off", title = "PNR", id = "PNR" })
                        </div>
                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_cancel_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_cancel_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" value="Old" name="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-ban" aria-hidden="true"></i>
                        <span>Flight cancellation report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-cancel-totals-btn" onclick="FindtotalRetailerCancel()" title="Show totals" aria-expanded="false" aria-controls="retailerCancelTotalsPanel"><i class="fas fa-chart-pie" aria-hidden="true"></i></button>
                            <button type="button" id="btnRetailerCancelExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel"><i class="fas fa-file-excel" aria-hidden="true"></i> Excel</button>
                            <button type="button" id="btnRetailerCancelPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF"><i class="fas fa-file-pdf" aria-hidden="true"></i> PDF</button>
                        </div>
                    </div>
                </div>
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="cancellationReport" class="table vm-opr-data-table" cellspacing="0" style="width:100%;">
                            <thead>
                                <tr>
                                    <th>Live Status</th>
                                    <th>Request Type</th>
                                    <th>Cancel Type</th>
                                    <th>Cancellation Id</th>
                                    <th>Request Date</th>
                                    <th>Response Date</th>
                                    <th>Refunded Amount &#8377;</th>
                                    <th>Charge &#8377;</th>
                                    <th>#</th>
                                </tr>
                            </thead>
                            <tbody id="retailerCancelRows">
                                @{ Html.RenderAction("_CancellationReport", "Air", new { txt_frm_date = frmDate, txt_to_date = toDate, ddl_status = selStatus, PNR = selPNR }); }
                            </tbody>
                        </table>
                        <div id="retailerCancelLoading" class="vm-opr-table-loading vm-dmt-table-loading" style="display:none;">
                            <div class="vm-dmt-table-loader" role="status" aria-live="polite" aria-label="Loading cancellations">
                                <div class="vm-dmt-table-loader__spinner" aria-hidden="true"></div>
                                <span class="vm-dmt-table-loader__text">Loading cancellations…</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section PostVmScripts {
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
<script>
    var retailerCancelPageIndex = 2;
    var retailerCancelNoMore = false;
    var retailerCancelBusy = false;

    function retailerCancelFilters() {
        return {
            txt_frm_date: jQuery('#retailer_cancel_frm_date').val() || '',
            txt_to_date: jQuery('#retailer_cancel_to_date').val() || '',
            ddl_status: jQuery('#ddl_status').val() || 'ALL',
            PNR: jQuery('#PNR').val() || ''
        };
    }

    function hideRetailerCancelTotals() {
        var $panel = jQuery('#retailerCancelTotalsPanel');
        var $btn = jQuery('.vm-cancel-totals-btn');
        $panel.removeClass('is-open').hide().attr('aria-hidden', 'true');
        $btn.removeClass('is-active').attr({ title: 'Show totals', 'aria-expanded': 'false' });
    }

    function calcRetailerCancelTotals() {
        var success = 0, failed = 0, pending = 0;
        jQuery('#retailerCancelRows tr.vm-dmt-row').each(function () {
            var amt = parseFloat(jQuery(this).attr('data-amount')) || 0;
            var st = (jQuery(this).attr('data-status') || '').toUpperCase();
            if (st === 'SUCCESS') { success += amt; }
            else if (st === 'FAILED') { failed += amt; }
            else { pending += amt; }
        });
        jQuery('#retailerCancelSuccess').html('&#8377; ' + success.toFixed(2));
        jQuery('#retailerCancelFailed').html('&#8377; ' + failed.toFixed(2));
        jQuery('#retailerCancelPending').html('&#8377; ' + pending.toFixed(2));
    }

    function FindtotalRetailerCancel() {
        var $panel = jQuery('#retailerCancelTotalsPanel');
        var $btn = jQuery('.vm-cancel-totals-btn');
        if ($panel.hasClass('is-open')) {
            hideRetailerCancelTotals();
            return;
        }
        $panel.addClass('is-open').show().attr('aria-hidden', 'false');
        $btn.addClass('is-active').attr({ title: 'Hide totals', 'aria-expanded': 'true' });
        calcRetailerCancelTotals();
    }

    function OnSuccess(data) {
        var respo = JSON.parse(data);
        if (respo.Status == "Success") {
            swal("Wow!", respo.Message, "success");
            setTimeout(function () {
                location.reload();
            }, 3000);
        } else {
            swal("Oops!", respo.Message, "error");
        }
    }
    function OnFailure() {
        swal("Oops!", "Unable to fetch data", "error");
    }

    function initRetailerCancelSelect2() {
        jQuery('#ddl_status').each(function () {
            var $el = jQuery(this);
            if (!$el.length || !jQuery.fn.select2) { return; }
            if ($el.hasClass('select2-hidden-accessible')) {
                try { $el.select2('destroy'); } catch (e) { }
            }
            $el.select2({ width: '100%', minimumResultsForSearch: 6 });
        });
    }

    function initRetailerCancelDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initRetailerCancelDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm(
                '#retailerCancelReportForm',
                '#retailer_cancel_frm_date',
                '#retailer_cancel_to_date',
                true
            );
        }
    }

    jQuery(function () {
        initRetailerCancelSelect2();
        initRetailerCancelDatepickers();
        window.setTimeout(initRetailerCancelDatepickers, 150);

        jQuery('#btnRetailerCancelExport').on('click', function (e) {
            e.preventDefault();
            var f = retailerCancelFilters();
            location.href = '@Url.Action("Excel_Cancellation_Report", "Air")?txt_frm_date=' + encodeURIComponent(f.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(f.txt_to_date) + '&ddl_status=' + encodeURIComponent(f.ddl_status) + '&PNR=' + encodeURIComponent(f.PNR);
        });
        jQuery('#btnRetailerCancelPDF').on('click', function () {
            var f = retailerCancelFilters();
            window.open('@Url.Action("PDF_CancellationReport", "Air")?txt_frm_date=' + encodeURIComponent(f.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(f.txt_to_date) + '&ddl_status=' + encodeURIComponent(f.ddl_status) + '&PNR=' + encodeURIComponent(f.PNR), '_blank');
        });

        jQuery(window).on('scroll', function () {
            if (retailerCancelNoMore || retailerCancelBusy) { return; }
            var nearBottom = jQuery(window).scrollTop() + jQuery(window).height() > jQuery(document).height() - 400;
            if (!nearBottom) { return; }
            retailerCancelBusy = true;
            jQuery('#retailerCancelLoading').show();
            var f = retailerCancelFilters();
            jQuery.post('@Url.Action("InfiniteScroll_cancelticket", "Air")',
                { pageindex: retailerCancelPageIndex, PNR: f.PNR, ddl_status: f.ddl_status, frm_date: f.txt_frm_date, to_date: f.txt_to_date },
                function (data) {
                    retailerCancelPageIndex = retailerCancelPageIndex + 1;
                    retailerCancelNoMore = data.NoMoredata;
                    var html = data.HTMLString || '';
                    if (html && html.indexOf('vm-opr-table-empty-row') === -1) {
                        jQuery('#retailerCancelRows .vm-opr-table-empty-row').remove();
                        jQuery('#retailerCancelRows').append(html);
                    } else {
                        retailerCancelNoMore = true;
                    }
                    jQuery('#retailerCancelLoading').hide();
                    retailerCancelBusy = false;
                })
                .fail(function () {
                    jQuery('#retailerCancelLoading').hide();
                    retailerCancelBusy = false;
                });
        });
    });
</script>
}
