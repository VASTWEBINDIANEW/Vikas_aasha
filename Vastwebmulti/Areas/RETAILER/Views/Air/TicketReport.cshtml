@model List<Vastwebmulti.Models.proc_FlightReport_Result>
@using Newtonsoft.Json;
@{
    ViewBag.Title = "Ticket Report";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";
    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    var selStatus = (Request["ddl_status"] ?? "").Trim();
    var selPNR = (Request["PNR"] ?? "").Trim();
    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=38" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=1" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<style>
    body.saas-admin-ui .saas-dmt-report-page .vm-dmt-filter-row input.vm-ticket-text-input.form-control {
        background-image: none !important;
        cursor: text !important;
        padding: 0 12px !important;
    }
    body.saas-admin-ui .saas-retailer-ticket-report-page #flightticket .vm-ticket-status-text {
        display: inline-block;
        vertical-align: middle;
        margin-left: 6px;
        font-size: 0.72rem;
        font-weight: 700;
        color: #334155;
        white-space: nowrap;
    }
    body.saas-admin-ui .saas-retailer-ticket-report-page #retailerTicketMsg {
        font-size: 0.72rem;
        font-weight: 700;
        color: green;
        white-space: nowrap;
    }
</style>

<div id="loadermoney" class="vm-dmt-loader" style="display:none;" aria-hidden="true">
    <div class="vm-dmt-loader__panel" role="status" aria-live="polite" aria-label="Processing">
        <div class="vm-dmt-table-loader__spinner" aria-hidden="true"></div>
        <span class="vm-dmt-loader__text">Please wait…</span>
    </div>
</div>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-retailer-ticket-report-page">
    <div class="container-fluid vm-opr-page-shell">

        @{
            var ticketFormAttrs = new Dictionary<string, object>
            {
                { "id", "retailerTicketReportForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-report-date-form", "" },
                { "data-report-from", "#retailer_ticket_frm_date" },
                { "data-report-to", "#retailer_ticket_to_date" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("TicketReport", "Air", FormMethod.Post, ticketFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Travel &amp; Hotels</li>
                        <li>Ticket Report</li>
                    </ol>
                    <div class="vm-dmt-fin-nav-row vm-ticket-travel-nav-row">
                        @Html.Partial("_FlightMenu")
                    </div>
                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="retailerTicketTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Booking totals (loaded rows)</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideRetailerTicketTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Success</span>
                            <strong class="vm-opr-total-card__value" id="retailerTicketSuccess">&#8377; 0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Failed</span>
                            <strong class="vm-opr-total-card__value" id="retailerTicketFailed">&#8377; 0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Pending</span>
                            <strong class="vm-opr-total-card__value" id="retailerTicketPending">&#8377; 0.00</strong>
                        </div>
                    </div>
                </div>

                <div class="vm-rpt-filters-panel">
                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-rpt-filters-panel__bar">
                        <div class="vm-opr-field vm-dmt-field" id="sts">
                            @Html.DropDownList("ddl_status", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "All Status", Value = "", Selected = (selStatus == "") },
                                new SelectListItem { Text = "Success", Value = "SUCCESS", Selected = selStatus == "SUCCESS" },
                                new SelectListItem { Text = "Pending", Value = "PENDING", Selected = selStatus == "PENDING" },
                                new SelectListItem { Text = "Failed", Value = "FAILED", Selected = selStatus == "FAILED" }
                            }, new { id = "ddl_status", @class = "vm-opr-select vm-dmt-select form-control", title = "Status" })
                        </div>
                        <div class="vm-opr-field vm-dmt-field vm-dmt-field--pnr">
                            @Html.TextBox("PNR", selPNR, new { @class = "form-control vm-dmt-search-input vm-ticket-pnr-input vm-ticket-text-input", placeholder = "Enter PNR", autocomplete = "off", title = "PNR", id = "PNR" })
                        </div>
                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_ticket_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_ticket_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" value="Old" name="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-plane" aria-hidden="true"></i>
                        <span>Flight ticket report</span>
                        <span id="retailerTicketMsg"></span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-ticket-totals-btn" onclick="FindtotalRetailerTicket()" title="Show totals" aria-expanded="false" aria-controls="retailerTicketTotalsPanel"><i class="fas fa-chart-pie" aria-hidden="true"></i></button>
                            <button type="button" id="btnRetailerTicketExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel"><i class="fas fa-file-excel" aria-hidden="true"></i> Excel</button>
                            <button type="button" id="btnRetailerTicketPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF"><i class="fas fa-file-pdf" aria-hidden="true"></i> PDF</button>
                        </div>
                    </div>
                </div>
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="flightticket" class="table vm-opr-data-table" cellspacing="0" style="width:100%;">
                            <thead>
                                <tr>
                                    <th>Status</th>
                                    <th>Ticket Status</th>
                                    <th>Passenger Name</th>
                                    <th>Flight</th>
                                    <th>Booking ID</th>
                                    <th>PNR</th>
                                    <th>Booking Date</th>
                                    <th>Fare Amount &#8377;</th>
                                    <th>Pre &#8377;</th>
                                    <th>Post &#8377;</th>
                                    <th>Income &#8377;</th>
                                    <th>Current Status</th>
                                    <th>Cancel</th>
                                    <th>Print</th>
                                </tr>
                            </thead>
                            <tbody id="retailerTicketRows">
                                @{ Html.RenderAction("_ticketreport", "Air", new { txt_frm_date = frmDate, txt_to_date = toDate, ddl_status = selStatus, PNR = selPNR }); }
                            </tbody>
                        </table>
                        <div id="retailerTicketLoading" class="vm-opr-table-loading vm-dmt-table-loading" style="display:none;">
                            <div class="vm-dmt-table-loader" role="status" aria-live="polite" aria-label="Loading tickets">
                                <div class="vm-dmt-table-loader__spinner" aria-hidden="true"></div>
                                <span class="vm-dmt-table-loader__text">Loading tickets…</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section PostVmScripts {
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    var retailerTicketPageIndex = 2;
    var retailerTicketNoMore = false;
    var retailerTicketBusy = false;

    function retailerTicketFilters() {
        return {
            txt_frm_date: jQuery('#retailer_ticket_frm_date').val() || '',
            txt_to_date: jQuery('#retailer_ticket_to_date').val() || '',
            ddl_status: jQuery('#ddl_status').val() || '',
            PNR: jQuery('#PNR').val() || ''
        };
    }

    function hideRetailerTicketTotals() {
        var $panel = jQuery('#retailerTicketTotalsPanel');
        var $btn = jQuery('.vm-dmt-totals-btn');
        $panel.removeClass('is-open').hide().attr('aria-hidden', 'true');
        $btn.removeClass('is-active').attr({ title: 'Show totals', 'aria-expanded': 'false' });
    }

    function calcRetailerTicketTotals() {
        var success = 0, failed = 0, pending = 0;
        jQuery('#retailerTicketRows tr.vm-dmt-row').each(function () {
            var amt = parseFloat(jQuery(this).attr('data-amount')) || 0;
            var st = (jQuery(this).attr('data-status') || '').toUpperCase();
            if (st === 'SUCCESS') { success += amt; }
            else if (st === 'FAILED') { failed += amt; }
            else { pending += amt; }
        });
        jQuery('#retailerTicketSuccess').html('&#8377; ' + success.toFixed(2));
        jQuery('#retailerTicketFailed').html('&#8377; ' + failed.toFixed(2));
        jQuery('#retailerTicketPending').html('&#8377; ' + pending.toFixed(2));
    }

    function FindtotalRetailerTicket() {
        var $panel = jQuery('#retailerTicketTotalsPanel');
        var $btn = jQuery('.vm-dmt-totals-btn');
        if ($panel.hasClass('is-open')) {
            hideRetailerTicketTotals();
            return;
        }
        $panel.addClass('is-open').show().attr('aria-hidden', 'false');
        $btn.addClass('is-active').attr({ title: 'Hide totals', 'aria-expanded': 'true' });
        calcRetailerTicketTotals();
    }

    function getTicketStatus(TraceId, refNo, pnr) {
        var requestObject = {};
        requestObject.BookingId = refNo;
        requestObject.PNR = pnr;
        requestObject.TraceId = TraceId;
        jQuery('#loadermoney').show();
        jQuery.ajax({
            url: '@Url.Action("GetFlightStatus", "Air")',
            type: 'POST',
            data: JSON.stringify(requestObject),
            dataType: 'json',
            contentType: 'application/json; charset=utf-8',
            success: function (data) {
                jQuery('#loadermoney').hide();
                var respo = JSON.parse(data);
                var msg = '';
                if (respo.Status == 'Success') {
                    if (respo.StatusCode == 5) { msg = 'Ticketed successfully'; }
                    else if (respo.StatusCode == 1) { msg = 'Ticket is on Hold'; }
                    else if (respo.StatusCode == 2) { msg = 'Ticket is ready'; }
                    else if (respo.StatusCode == 3) { msg = 'Ticket is cancelled'; }
                    else if (respo.StatusCode == 4) { msg = 'Ticket is in InProgress'; }
                    else { msg = 'Ticket not confirmed yet'; }
                }
                else {
                    msg = respo.Message;
                }
                jQuery('#retailerTicketMsg').text(msg);
            },
            error: function (request, error) {
                jQuery('#loadermoney').hide();
                alert('Error');
                console.log('Request: ' + JSON.stringify(request));
            }
        });
    }

    function changerequest(id, bookingId, orgn, dstn, TicketId) {
        swal({
            title: 'Are you sure?',
            text: 'Do you want to cancel this ticket!',
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#DD6B55',
            confirmButtonText: 'Yes, cancel it!',
            closeOnConfirm: false
        },
        function () {
            jQuery('#loadermoney').show();
            var url = '@Url.Action("CancelTicket", "Air")';
            jQuery.post(url, { idno: id, bookingid: bookingId, origin: orgn, destination: dstn, ticketIds: TicketId }, function (data) {
                var respo = JSON.parse(data);
                if (respo.Status == 'Success') {
                    swal('Wow!!', respo.Message, 'success');
                } else {
                    swal('Oops!!', respo.Message, 'error');
                }
            }).fail(function () {
                swal('Oops!!', 'Unknow error.', 'error');
            }).always(function () {
                jQuery('#loadermoney').hide();
            });
        });
    }

    function initRetailerTicketSelect2() {
        jQuery('#ddl_status').each(function () {
            var $el = jQuery(this);
            if (!$el.length || !jQuery.fn.select2) { return; }
            if ($el.hasClass('select2-hidden-accessible')) {
                try { $el.select2('destroy'); } catch (e) { }
            }
            $el.select2({ width: '100%', minimumResultsForSearch: 6 });
        });
    }

    function initRetailerTicketDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initRetailerTicketDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm(
                '#retailerTicketReportForm',
                '#retailer_ticket_frm_date',
                '#retailer_ticket_to_date',
                true
            );
        }
    }

    jQuery(function () {
        var sts = '@TempData["Status"]';
        var msg = '@TempData["Message"]';
        if (sts != null && sts != '' && msg != null && msg != '') {
            swal('Oops..', msg, 'error');
        }
        initRetailerTicketSelect2();
        initRetailerTicketDatepickers();
        window.setTimeout(initRetailerTicketDatepickers, 150);

        jQuery('#btnRetailerTicketExport').on('click', function (e) {
            e.preventDefault();
            var f = retailerTicketFilters();
            location.href = '@Url.Action("Excel_Ticket_Report", "Air")?txt_frm_date=' + encodeURIComponent(f.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(f.txt_to_date) + '&ddl_status=' + encodeURIComponent(f.ddl_status) + '&PNR=' + encodeURIComponent(f.PNR);
        });
        jQuery('#btnRetailerTicketPDF').on('click', function () {
            var f = retailerTicketFilters();
            window.open('@Url.Action("PDF_TicketReport", "Air")?txt_frm_date=' + encodeURIComponent(f.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(f.txt_to_date) + '&ddl_status=' + encodeURIComponent(f.ddl_status) + '&PNR=' + encodeURIComponent(f.PNR), '_blank');
        });

        jQuery(window).on('scroll', function () {
            if (retailerTicketNoMore || retailerTicketBusy) { return; }
            var nearBottom = jQuery(window).scrollTop() + jQuery(window).height() > jQuery(document).height() - 400;
            if (!nearBottom) { return; }
            retailerTicketBusy = true;
            jQuery('#retailerTicketLoading').show();
            var f = retailerTicketFilters();
            jQuery.post('@Url.Action("InfiniteScroll_ticket", "Air")',
                { pageindex: retailerTicketPageIndex, PNR: f.PNR, ddl_status: f.ddl_status, frm_date: f.txt_frm_date, to_date: f.txt_to_date },
                function (data) {
                    retailerTicketPageIndex = retailerTicketPageIndex + 1;
                    retailerTicketNoMore = data.NoMoredata;
                    var html = data.HTMLString || '';
                    if (html && html.indexOf('vm-opr-table-empty-row') === -1) {
                        jQuery('#retailerTicketRows .vm-opr-table-empty-row').remove();
                        jQuery('#retailerTicketRows').append(html);
                    } else {
                        retailerTicketNoMore = true;
                    }
                    jQuery('#retailerTicketLoading').hide();
                    retailerTicketBusy = false;
                })
                .fail(function () {
                    jQuery('#retailerTicketLoading').hide();
                    retailerTicketBusy = false;
                });
        });
    });
</script>
}
