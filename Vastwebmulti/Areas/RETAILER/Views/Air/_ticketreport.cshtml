@model List<Vastwebmulti.Models.proc_FlightReport_Result>
@using Vastwebmulti.Models;
@using Newtonsoft.Json;
@{
    Layout = null;
    var rows = Model == null ? new List<Vastwebmulti.Models.proc_FlightReport_Result>() : Model;
}
@if (rows.Count > 0)
{
    foreach (var item in rows)
    {
        var statusTone = "pending";
        var statusFa = "fa-clock-o";
        var dataStatus = "PENDING";
        var ticketStatusText = item.TicketStatus ?? "";
        if (ticketStatusText.Contains("FAILED"))
        {
            statusTone = "failed";
            statusFa = "fa-times";
            dataStatus = "FAILED";
        }
        else if (ticketStatusText.Contains("Success"))
        {
            statusTone = "success";
            statusFa = "fa-check";
            dataStatus = "SUCCESS";
        }
        else if (ticketStatusText.ToUpper().Contains("REFUND"))
        {
            statusTone = "refund";
            statusFa = "fa-undo";
            dataStatus = "FAILED";
        }
        else if (ticketStatusText.ToUpper().Contains("PENDING"))
        {
            statusTone = "pending";
            statusFa = "fa-clock-o";
            dataStatus = "PENDING";
        }
        var sts = ((Vastwebmulti.Areas.RETAILER.Enums.TicketStatus)Convert.ToInt32(item.TicketStatusCode)).ToString();
        <tr class="vm-dmt-row" data-amount="@item.FareAmount" data-status="@dataStatus">
            <td class="vm-ticket-status-cell">
                <span class="vm-dmt-status vm-dmt-status--@statusTone" title="@ticketStatusText"><i class="fa @statusFa" aria-hidden="true"></i></span>
                <span class="vm-ticket-status-text">@ticketStatusText</span>
            </td>
            <td><span class="vm-dmt-refno-text">@sts</span></td>
            <td>
                <span class="vm-dmt-consumer-text">@item.LeadPaxFirstName @item.LeadPaxLastName</span>
            </td>
            <td>
                <span class="vm-dmt-refno-text">@item.AirlineName</span>
            </td>
            <td>
                <span class="vm-dmt-refno-text">@item.BookingId</span>
            </td>
            <td class="vm-ticket-pnr-cell">
                <span class="vm-dmt-refno-text">@item.PNR</span>
            </td>
            <td class="vm-ticket-time-cell">
                <span class="vm-dmt-refno-text">@String.Format("{0:dd-MMM-yyyy HH:mm:ss}", item.TicketDate)</span>
            </td>
            <td>
                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(item.FareAmount, 2)</span>
            </td>
            <td>
                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(item.RemPre, 2)</span>
            </td>
            <td>
                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(item.RemPost, 2)</span>
            </td>
            <td>
                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(item.RemInc, 2)</span>
            </td>
            <td>
                @if (!ticketStatusText.Contains("Refund"))
                {
                    <a class="btn btn-info btn-sm vm-dmt-info-btn" onclick="getTicketStatus('@item.TraceId','@item.BookingId','@item.PNR')" title="Click here to get current status"><span class="vm-info-label">Current Status</span><span class="vm-ticket-status-text vm-ticket-status-text--live">@ticketStatusText</span></a>
                }
                else
                {
                    <span class="vm-dmt-refno-text">@ticketStatusText</span>
                }
            </td>
            <td>
                <span>
                    @if (item.TicketStatusCode == 1 && item.ResponseJson != null && item.ResponseJson.Contains("TicketId"))
                    {
                        string ticketids = "";
                        string cancelOrigin = "";
                        string cancelDestination = "";
                        try
                        {
                            dynamic cancelJson = JsonConvert.DeserializeObject(item.ResponseJson.ToString());
                            cancelOrigin = cancelJson["Response"]["FlightItinerary"]["Origin"].ToString();
                            cancelDestination = cancelJson["Response"]["FlightItinerary"]["Destination"].ToString();
                            var cancelPax = cancelJson["Response"]["FlightItinerary"]["Passenger"] as System.Collections.IEnumerable;
                            var cancelIds = new List<string>();
                            if (cancelPax != null)
                            {
                                foreach (dynamic p in cancelPax)
                                {
                                    try
                                    {
                                        string tid = p.Ticket != null ? (string)p.Ticket.TicketId : null;
                                        if (!string.IsNullOrEmpty(tid)) { cancelIds.Add(tid); }
                                    }
                                    catch { }
                                }
                            }
                            ticketids = string.Join(",", cancelIds);
                        }
                        catch { }
                        <a class="btn btn-danger btn-sm vm-dmt-cancel-btn" onclick="changerequest(@item.idno,'@item.BookingId','@cancelOrigin','@cancelDestination','@ticketids')" title="Click here to cancel request">Ticket Cancel</a>
                    }
                </span>
            </td>
            <td>
                <a class="btn btn-primary btn-sm vm-dmt-print-btn" href="@Url.Action("ViewTicket", "Air", new { TraceId = item.TraceId })" title="Click here to print">Print</a>
            </td>
        </tr>
    }
}
else
{
    <tr class="vm-opr-table-empty-row">
        <td colspan="14">
            <div class="vm-opr-empty-state">
                <i class="fas fa-plane" aria-hidden="true"></i>
                <span>No booking records found</span>
            </div>
        </td>
    </tr>
}
