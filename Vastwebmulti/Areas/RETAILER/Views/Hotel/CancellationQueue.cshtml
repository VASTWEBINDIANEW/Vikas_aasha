@model List<Vastwebmulti.Models.proc_HotelCancellationReport_Result>
@using System.Web.Mvc.Ajax;
@{
    ViewBag.Title = "Hotel Cancellation Queue";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";
    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    var selStatus = (Request["ddl_status"] ?? "ALL").Trim();
    if (string.IsNullOrEmpty(selStatus)) { selStatus = "ALL"; }
    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
    var rows = Model == null ? new List<Vastwebmulti.Models.proc_HotelCancellationReport_Result>() : Model;
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=38" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=1" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<style>
    /* Force hotel-cancel table to size by content (never squeeze) + scroll */
    body.saas-admin-ui .saas-retailer-hotelcan-page #hotelBookingReport.vm-opr-data-table {
        width: max-content !important;
        min-width: 1500px !important;
        max-width: none !important;
        table-layout: auto !important;
    }
    body.saas-admin-ui .saas-retailer-hotelcan-page #hotelBookingReport.vm-opr-data-table thead tr,
    body.saas-admin-ui .saas-retailer-hotelcan-page #hotelBookingReport.vm-opr-data-table tbody tr {
        display: table-row !important;
    }
    body.saas-admin-ui .saas-retailer-hotelcan-page #hotelBookingReport.vm-opr-data-table thead th,
    body.saas-admin-ui .saas-retailer-hotelcan-page #hotelBookingReport.vm-opr-data-table tbody td {
        display: table-cell !important;
        width: auto !important;
        max-width: none !important;
        white-space: nowrap !important;
        overflow: visible !important;
        text-overflow: clip !important;
    }
    /* Override operator-report 42px/52px first-two-col rule + room per column */
    body.saas-admin-ui .saas-retailer-hotelcan-page #hotelBookingReport.vm-opr-data-table thead th:first-child {
        width: auto !important;
        min-width: 150px !important;
        max-width: none !important;
    }
    body.saas-admin-ui .saas-retailer-hotelcan-page #hotelBookingReport.vm-opr-data-table thead th:nth-child(2) {
        width: auto !important;
        min-width: 150px !important;
        max-width: none !important;
        text-align: center !important;
    }
    body.saas-admin-ui .saas-retailer-hotelcan-page #hotelBookingReport.vm-opr-data-table thead th:nth-child(3) { min-width: 150px !important; }
    body.saas-admin-ui .saas-retailer-hotelcan-page #hotelBookingReport.vm-opr-data-table thead th:nth-child(4) { min-width: 170px !important; }
    body.saas-admin-ui .saas-retailer-hotelcan-page #hotelBookingReport.vm-opr-data-table thead th:nth-child(5) { min-width: 150px !important; }
    body.saas-admin-ui .saas-retailer-hotelcan-page #hotelBookingReport.vm-opr-data-table thead th:nth-child(6) { min-width: 210px !important; }
    body.saas-admin-ui .saas-retailer-hotelcan-page #hotelBookingReport.vm-opr-data-table thead th:nth-child(7) { min-width: 210px !important; }
    body.saas-admin-ui .saas-retailer-hotelcan-page #hotelBookingReport.vm-opr-data-table thead th:nth-child(8) { min-width: 140px !important; }
    body.saas-admin-ui .saas-retailer-hotelcan-page .vm-hotel-status-text {
        display: inline-block;
        vertical-align: middle;
        margin-left: 6px;
        font-size: 0.72rem;
        font-weight: 700;
        color: #334155;
        white-space: nowrap;
    }
</style>

<div id="loadermoney" class="vm-dmt-loader" style="display:none;" aria-hidden="true">
    <div class="vm-dmt-loader__panel" role="status" aria-live="polite" aria-label="Processing">
        <div class="vm-dmt-table-loader__spinner" aria-hidden="true"></div>
        <span class="vm-dmt-loader__text">Please wait…</span>
    </div>
</div>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-hotel-report-page saas-retailer-hotelcan-page">
    <div class="container-fluid vm-opr-page-shell">

        @{
            var hotelCanFormAttrs = new Dictionary<string, object>
            {
                { "id", "retailerHotelCanForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-report-date-form", "" },
                { "data-report-from", "#retailer_hotelcan_frm_date" },
                { "data-report-to", "#retailer_hotelcan_to_date" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("CancellationQueue", "Hotel", FormMethod.Post, hotelCanFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Travel &amp; Hotels</li>
                        <li>Hotel Cancellation Queue</li>
                    </ol>
                    <div class="vm-dmt-fin-nav-row vm-ticket-travel-nav-row">
                        @Html.Partial("_hotelpartialmenu")
                    </div>
                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="retailerHotelCanTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Cancellation totals (loaded rows)</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideRetailerHotelCanTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Refund Amount</span>
                            <strong class="vm-opr-total-card__value" id="retailerHotelCanRefund">&#8377; 0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Cancel Charge</span>
                            <strong class="vm-opr-total-card__value" id="retailerHotelCanCharge">&#8377; 0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Records</span>
                            <strong class="vm-opr-total-card__value" id="retailerHotelCanCount">0</strong>
                        </div>
                    </div>
                </div>

                <div class="vm-rpt-filters-panel">
                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--hotel vm-rpt-filters-panel__bar">
                        <div class="vm-opr-field vm-dmt-field" id="sts">
                            @Html.DropDownList("ddl_status", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "All Status", Value = "ALL", Selected = (selStatus == "ALL") },
                                new SelectListItem { Text = "Success", Value = "SUCCESS", Selected = selStatus == "SUCCESS" },
                                new SelectListItem { Text = "Pending", Value = "PROCCESSED", Selected = selStatus == "PROCCESSED" },
                                new SelectListItem { Text = "Failed", Value = "FAILED", Selected = selStatus == "FAILED" }
                            }, new { id = "ddl_status", @class = "vm-opr-select vm-dmt-select form-control", title = "Status" })
                        </div>
                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_hotelcan_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_hotelcan_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" value="Old" name="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-ban" aria-hidden="true"></i>
                        <span>Hotel cancellation queue</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-hotel-totals-btn" onclick="FindtotalRetailerHotelCan()" title="Show totals" aria-expanded="false" aria-controls="retailerHotelCanTotalsPanel"><i class="fas fa-chart-pie" aria-hidden="true"></i></button>
                            <button type="button" id="btnRetailerHotelCanExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel"><i class="fas fa-file-excel" aria-hidden="true"></i> Excel</button>
                            <button type="button" id="btnRetailerHotelCanPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF"><i class="fas fa-file-pdf" aria-hidden="true"></i> PDF</button>
                        </div>
                    </div>
                </div>
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="hotelBookingReport" class="table vm-opr-data-table" cellspacing="0" style="width:100%;">
                            <thead>
                                <tr>
                                    <th>Live Status</th>
                                    <th>Cancellation Id</th>
                                    <th>Booking Id</th>
                                    <th>Cancellation Charge &#8377;</th>
                                    <th>Refund Amount &#8377;</th>
                                    <th>Request Date</th>
                                    <th>Response Date</th>
                                    <th>#</th>
                                </tr>
                            </thead>
                            <tbody id="retailerHotelCanRows">
                                @if (rows.Count > 0)
                                {
                                    foreach (var item in rows)
                                    {
                                        var crStatus = item.ChangeRequestStatus ?? "";
                                        var sts = "";
                                        var tone = "pending";
                                        var fa = "fa-clock-o";
                                        if (crStatus.Contains("1") || crStatus.Contains("2"))
                                        {
                                            sts = "Pending";
                                            tone = "pending";
                                            fa = "fa-clock-o";
                                        }
                                        if (crStatus.Contains("3"))
                                        {
                                            sts = "Success";
                                            tone = "success";
                                            fa = "fa-check";
                                        }
                                        if (crStatus.ToUpper().Contains("4"))
                                        {
                                            sts = "Failed";
                                            tone = "failed";
                                            fa = "fa-times";
                                        }
                                        <tr class="vm-dmt-row" data-amount="@(item.RefundedAmount ?? 0)" data-charge="@(item.CancellationCharge ?? 0)">
                                            <td class="vm-ticket-status-cell">
                                                <span class="vm-dmt-status vm-dmt-status--@tone" title="@sts"><i class="fa @fa" aria-hidden="true"></i></span>
                                                <span class="vm-hotel-status-text">@sts</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-refno-text">@(item.ChangeRequestId.HasValue ? item.ChangeRequestId.Value.ToString() : "—")</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-refno-text">@item.BookingId</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @(item.CancellationCharge.HasValue ? Math.Round(item.CancellationCharge.Value, 2).ToString() : "0.00")</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @(item.RefundedAmount.HasValue ? Math.Round(item.RefundedAmount.Value, 2).ToString() : "0.00")</span>
                                            </td>
                                            <td class="vm-ticket-time-cell">
                                                <span class="vm-dmt-refno-text">@String.Format("{0:ddd, MMM d, yyyy HH:mm:ss}", item.CancellationRequestDate)</span>
                                            </td>
                                            <td class="vm-ticket-time-cell">
                                                <span class="vm-dmt-refno-text">@(item.CancellationResponseDate.HasValue ? String.Format("{0:ddd, MMM d, yyyy HH:mm:ss}", item.CancellationResponseDate.Value) : "—")</span>
                                            </td>
                                            <td>
                                                @Ajax.ActionLink("View Status", "CancellationStatus", "Hotel", new { ChangeReqId = item.ChangeRequestId, idno = item.idno }, new AjaxOptions { HttpMethod = "Post", OnSuccess = "OnSuccessStatus", OnFailure = "OnFailedStatus", OnComplete = "reloadPage", LoadingElementId = "loadermoney" }, new { @class = "btn btn-primary btn-sm vm-dmt-status-btn", title = "View cancellation status" })
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="8">
                                            <div class="vm-opr-empty-state">
                                                <i class="fas fa-ban" aria-hidden="true"></i>
                                                <span>No cancellation records found</span>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section PostVmScripts {
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
<script>
    function retailerHotelCanFilters() {
        return {
            ddl_status: jQuery('#ddl_status').val() || 'ALL',
            txt_frm_date: jQuery('#retailer_hotelcan_frm_date').val() || '',
            txt_to_date: jQuery('#retailer_hotelcan_to_date').val() || ''
        };
    }

    function hideRetailerHotelCanTotals() {
        var $panel = jQuery('#retailerHotelCanTotalsPanel');
        var $btn = jQuery('.vm-hotel-totals-btn');
        $panel.removeClass('is-open').hide().attr('aria-hidden', 'true');
        $btn.removeClass('is-active').attr({ title: 'Show totals', 'aria-expanded': 'false' });
    }

    function calcRetailerHotelCanTotals() {
        var refund = 0, charge = 0, count = 0;
        jQuery('#retailerHotelCanRows tr.vm-dmt-row').each(function () {
            refund += parseFloat(jQuery(this).attr('data-amount')) || 0;
            charge += parseFloat(jQuery(this).attr('data-charge')) || 0;
            count += 1;
        });
        jQuery('#retailerHotelCanRefund').html('&#8377; ' + refund.toFixed(2));
        jQuery('#retailerHotelCanCharge').html('&#8377; ' + charge.toFixed(2));
        jQuery('#retailerHotelCanCount').text(count);
    }

    function FindtotalRetailerHotelCan() {
        var $panel = jQuery('#retailerHotelCanTotalsPanel');
        var $btn = jQuery('.vm-hotel-totals-btn');
        if ($panel.hasClass('is-open')) {
            hideRetailerHotelCanTotals();
            return;
        }
        $panel.addClass('is-open').show().attr('aria-hidden', 'false');
        $btn.addClass('is-active').attr({ title: 'Hide totals', 'aria-expanded': 'true' });
        calcRetailerHotelCanTotals();
    }

    function OnSuccessStatus(data) {
        var respo = JSON.parse(data);
        if (respo.Status == "Pending") {
            swal("Keep calm!", respo.Message, "warning");
        }
        else if (respo.Status == "Success") {
            swal("Wow!", respo.Message, "success");
        }
        else {
            swal("Oops!", respo.Message, "error");
        }
    }
    function OnFailedStatus(data) {
        swal("Oops!", "Failed to fetch data.", "error");
    }
    function reloadPage() {
        window.setTimeout(function () {
            location.reload();
        }, 3000);
    }

    function initRetailerHotelCanSelect2() {
        jQuery('#ddl_status').each(function () {
            var $el = jQuery(this);
            if (!$el.length || !jQuery.fn.select2) { return; }
            if ($el.hasClass('select2-hidden-accessible')) {
                try { $el.select2('destroy'); } catch (e) { }
            }
            $el.select2({ width: '100%', minimumResultsForSearch: 6 });
        });
    }

    function initRetailerHotelCanDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initRetailerHotelCanDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm(
                '#retailerHotelCanForm',
                '#retailer_hotelcan_frm_date',
                '#retailer_hotelcan_to_date',
                true
            );
        }
    }

    jQuery(function () {
        var sts = '@TempData["Status"]';
        var msg = '@TempData["Message"]';
        if (sts != null && sts != '') {
            if (sts == "Success") {
                swal("Wow!", msg, "success");
            } else {
                swal("Oops!", msg, "error");
            }
        }
        initRetailerHotelCanSelect2();
        initRetailerHotelCanDatepickers();
        window.setTimeout(initRetailerHotelCanDatepickers, 150);

        jQuery('#btnRetailerHotelCanExport').on('click', function (e) {
            e.preventDefault();
            var f = retailerHotelCanFilters();
            location.href = '@Url.Action("ExcelCancellationQueue", "Hotel")?ddl_status=' + encodeURIComponent(f.ddl_status) + '&txt_frm_date=' + encodeURIComponent(f.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(f.txt_to_date);
        });
        jQuery('#btnRetailerHotelCanPDF').on('click', function () {
            var f = retailerHotelCanFilters();
            window.open('@Url.Action("PDFCancellationQueue", "Hotel")?ddl_status=' + encodeURIComponent(f.ddl_status) + '&txt_frm_date=' + encodeURIComponent(f.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(f.txt_to_date), '_blank');
        });
    });
</script>
}
