@model IEnumerable<Vastwebmulti.Models.proc_PAN_CARD_IPAY_Token_report_Result>
@{
    ViewBag.Title = "Token Purchase Report";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";
    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    var selStatus = (Request["ddl_status"] ?? "").Trim();
    if (selStatus == "" || selStatus == "Status") { selStatus = "ALL"; }
    var selBankId = (Request["BankId"] ?? "").Trim();
    var selAadhar = (Request["aadhar"] ?? "").Trim();
    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
    var totalSuccess = ViewData["totals"] ?? "0";
    var totalPending = ViewData["totalp"] ?? "0";
    var totalFailed = ViewData["totalf"] ?? "0";
    var totalIncome = ViewData["Rincome"] ?? "0";
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=34" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=38" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-pancard-report-modern.css?v=7" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<style>
    body.saas-admin-ui .saas-dmt-report-page .vm-dmt-filter-row input.vm-pan-text-input.form-control {
        background-image: none !important;
        cursor: text !important;
        padding: 0 12px !important;
    }
    body.saas-admin-ui .saas-retailer-pancard-old-page #pancardNew .vm-dmt-txntype {
        display: inline-block;
        vertical-align: middle;
        margin-left: 6px;
        font-size: 0.72rem;
        font-weight: 700;
        color: #334155;
        white-space: nowrap;
    }
    body.saas-admin-ui .saas-retailer-pancard-old-page .vm-opr-mini-tabs {
        display: inline-flex;
        gap: 6px;
        align-items: center;
    }
    body.saas-admin-ui .saas-retailer-pancard-old-page .vm-opr-mini-tabs a {
        padding: 5px 14px;
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 800;
        letter-spacing: 0.04em;
        color: #475569;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        text-decoration: none !important;
    }
    body.saas-admin-ui .saas-retailer-pancard-old-page .vm-opr-mini-tabs a.is-active {
        color: #fff;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        border-color: #1d4ed8;
    }
</style>

<div id="loadermoney" class="vm-dmt-loader" style="display:none;" aria-hidden="true">
    <div class="vm-dmt-loader__panel" role="status" aria-live="polite" aria-label="Processing">
        <div class="vm-dmt-table-loader__spinner" aria-hidden="true"></div>
        <span class="vm-dmt-loader__text">Please wait…</span>
    </div>
</div>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-pancard-report-page saas-pancard-new-page saas-retailer-pancard-old-page">
    <div class="container-fluid vm-opr-page-shell">

        @{
            var panOldFormAttrs = new Dictionary<string, object>
            {
                { "id", "retailerPanOldReportForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-report-date-form", "" },
                { "data-report-from", "#retailer_panold_frm_date" },
                { "data-report-to", "#retailer_panold_to_date" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("TokenPurchaseReport", "PANCARD", FormMethod.Post, panOldFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Financial Services</li>
                        <li>Pan Card Report</li>
                    </ol>
                    <div class="vm-dmt-fin-nav-row">
                        @Html.Partial("~/Areas/RETAILER/Views/Home/_menuFinicalReport.cshtml")
                    </div>
                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="retailerPanOldTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Processing fees totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideRetailerPanOldTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Success</span>
                            <strong class="vm-opr-total-card__value">&#8377; @totalSuccess</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Pending</span>
                            <strong class="vm-opr-total-card__value">&#8377; @totalPending</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Failed</span>
                            <strong class="vm-opr-total-card__value">&#8377; @totalFailed</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Net Income</span>
                            <strong class="vm-opr-total-card__value">&#8377; @totalIncome</strong>
                        </div>
                    </div>
                </div>

                <div class="vm-rpt-filters-panel">
                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-rpt-filters-panel__bar">
                        <div class="vm-opr-field vm-dmt-field">
                            @Html.TextBox("BankId", selBankId, new { @class = "form-control vm-pan-text-input", placeholder = "Bank ID", autocomplete = "off", id = "retailerPanOldBankId", title = "Bank ID" })
                        </div>
                        <div class="vm-opr-field vm-dmt-field">
                            @Html.TextBox("aadhar", selAadhar, new { @class = "form-control vm-pan-text-input", placeholder = "Aadhaar / Bank ID / Amount", autocomplete = "off", id = "retailerPanOldAadhar", title = "Aadhaar / Bank ID / Amount" })
                        </div>
                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("ddl_status", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "All Status", Value = "ALL", Selected = (selStatus == "ALL") },
                                new SelectListItem { Text = "Success", Value = "SUCCESS", Selected = selStatus == "SUCCESS" },
                                new SelectListItem { Text = "Pending", Value = "PENDING", Selected = selStatus == "PENDING" },
                                new SelectListItem { Text = "Failed", Value = "FAILED", Selected = selStatus == "FAILED" }
                            }, new { id = "ddl_status", @class = "vm-opr-select vm-dmt-select form-control", title = "Status" })
                        </div>
                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_panold_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_panold_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-id-card" aria-hidden="true"></i>
                        <span>Pan card token report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <div class="vm-opr-mini-tabs">
                            @Html.ActionLink("NEW", "TokenPurchaseReport_new", "PANCARD", null, new { })
                            @Html.ActionLink("OLD", "TokenPurchaseReport", "PANCARD", null, new { @class = "is-active" })
                            @Html.ActionLink("MANUAL", "TokenPurchaseReport_new_manual", "PANCARD", null, new { })
                        </div>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn" onclick="FindtotalRetailerPanOld()" title="Show totals" aria-expanded="false" aria-controls="retailerPanOldTotalsPanel"><i class="fas fa-chart-pie" aria-hidden="true"></i></button>
                            <button type="button" id="btnRetailerPanOldExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel"><i class="fas fa-file-excel" aria-hidden="true"></i> Excel</button>
                            <button type="button" id="btnRetailerPanOldPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF"><i class="fas fa-file-pdf" aria-hidden="true"></i> PDF</button>
                        </div>
                    </div>
                </div>
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="pancardNew" class="table vm-opr-data-table" cellspacing="0" style="width:100%;">
                            <thead>
                                <tr>
                                    <th>S.R.</th>
                                    <th>Live Status</th>
                                    <th>Processing Fees &#8377;</th>
                                    <th>Physical</th>
                                    <th>Digital</th>
                                    <th>UTI TXN ID</th>
                                    <th>UTI Status</th>
                                    <th>Date</th>
                                    <th>Total &#8377;</th>
                                    <th>Remain Pre &#8377;</th>
                                    <th>Net Income &#8377;</th>
                                    <th>Remain Post &#8377;</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody id="retailerPanOldRows">
                                @{ Html.RenderAction("_TokenPurchaseReport", "PANCARD", new { txt_frm_date = frmDate, txt_to_date = toDate, ddl_status = selStatus }); }
                            </tbody>
                        </table>
                        <div id="retailerPanOldLoading" class="vm-opr-table-loading vm-dmt-table-loading" style="display:none;">
                            <div class="vm-dmt-table-loader" role="status" aria-live="polite" aria-label="Loading transactions">
                                <div class="vm-dmt-table-loader__spinner" aria-hidden="true"></div>
                                <span class="vm-dmt-table-loader__text">Loading transactions…</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section PostVmScripts {
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    var retailerPanOldPageIndex = 2;
    var retailerPanOldNoMore = false;
    var retailerPanOldBusy = false;

    function retailerPanOldFilters() {
        return {
            txt_frm_date: jQuery('#retailer_panold_frm_date').val() || '',
            txt_to_date: jQuery('#retailer_panold_to_date').val() || '',
            ddl_status: jQuery('#ddl_status').val() || 'ALL'
        };
    }

    function renumberRetailerPanOldSr() {
        jQuery('#retailerPanOldRows tr.vm-dmt-row').each(function (i) {
            jQuery(this).find('.vm-dmt-sr-cell').first().text(i + 1);
        });
    }

    function hideRetailerPanOldTotals() {
        var $panel = jQuery('#retailerPanOldTotalsPanel');
        var $btn = jQuery('.vm-dmt-totals-btn');
        $panel.removeClass('is-open').hide().attr('aria-hidden', 'true');
        $btn.removeClass('is-active').attr({ title: 'Show totals', 'aria-expanded': 'false' });
    }

    function FindtotalRetailerPanOld() {
        var $panel = jQuery('#retailerPanOldTotalsPanel');
        var $btn = jQuery('.vm-dmt-totals-btn');
        if ($panel.hasClass('is-open')) {
            hideRetailerPanOldTotals();
            return;
        }
        $panel.addClass('is-open').show().attr('aria-hidden', 'false');
        $btn.addClass('is-active').attr({ title: 'Hide totals', 'aria-expanded': 'true' });
    }

    function tokenStatus(id) {
        var url = '@Url.Action("GetTokenStatus", "PANCARD")';
        jQuery.post(url, { id: id }, function (data) {
            var response = JSON.parse(data);
            if (response.RESULT == "0") {
                swal("Wow!", response.ADDINFO, "success");
            }
            else if (response.RESULT == "2") {
                swal("Oops!", response.ADDINFO, "warning");
            }
            else {
                swal("Oops!!!", response.ADDINFO, "error");
            }
        })
        .fail(function (jqXHR) {
            swal("Oops!!!", jqXHR.responseText, "error");
        });
    }

    function initRetailerPanOldSelect2() {
        jQuery('#ddl_status').each(function () {
            var $el = jQuery(this);
            if (!$el.length || !jQuery.fn.select2) { return; }
            if ($el.hasClass('select2-hidden-accessible')) {
                try { $el.select2('destroy'); } catch (e) { }
            }
            $el.select2({ width: '100%', minimumResultsForSearch: 6 });
        });
    }

    function initRetailerPanOldDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initRetailerPanOldDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm(
                '#retailerPanOldReportForm',
                '#retailer_panold_frm_date',
                '#retailer_panold_to_date',
                true
            );
        }
    }

    jQuery(function () {
        initRetailerPanOldSelect2();
        initRetailerPanOldDatepickers();
        window.setTimeout(initRetailerPanOldDatepickers, 150);
        renumberRetailerPanOldSr();

        jQuery('#btnRetailerPanOldExport').on('click', function (e) {
            e.preventDefault();
            var f = retailerPanOldFilters();
            location.href = '@Url.Action("Excel_TokenPurchase_Report", "PANCARD")?txt_frm_date=' + encodeURIComponent(f.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(f.txt_to_date) + '&ddl_status=' + encodeURIComponent(f.ddl_status);
        });
        jQuery('#btnRetailerPanOldPDF').on('click', function () {
            var f = retailerPanOldFilters();
            window.open('@Url.Action("PDF_TokenPurchaseReport", "PANCARD")?txt_frm_date=' + encodeURIComponent(f.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(f.txt_to_date) + '&ddl_status=' + encodeURIComponent(f.ddl_status), '_blank');
        });

        jQuery(window).on('scroll', function () {
            if (retailerPanOldNoMore || retailerPanOldBusy) { return; }
            var nearBottom = jQuery(window).scrollTop() + jQuery(window).height() > jQuery(document).height() - 400;
            if (!nearBottom) { return; }
            retailerPanOldBusy = true;
            jQuery('#retailerPanOldLoading').show();
            var f = retailerPanOldFilters();
            jQuery.post('@Url.Action("InfiniteScroll", "PANCARD")',
                { pageindex: retailerPanOldPageIndex, txt_frm_date: f.txt_frm_date, txt_to_date: f.txt_to_date, ddl_status: f.ddl_status },
                function (data) {
                    retailerPanOldPageIndex = retailerPanOldPageIndex + 1;
                    retailerPanOldNoMore = data.NoMoredata;
                    var html = data.HTMLString || '';
                    if (html && html.indexOf('vm-opr-table-empty-row') === -1) {
                        jQuery('#retailerPanOldRows .vm-opr-table-empty-row').remove();
                        jQuery('#retailerPanOldRows').append(html);
                    } else {
                        retailerPanOldNoMore = true;
                    }
                    renumberRetailerPanOldSr();
                    jQuery('#retailerPanOldLoading').hide();
                    retailerPanOldBusy = false;
                })
                .fail(function () {
                    jQuery('#retailerPanOldLoading').hide();
                    retailerPanOldBusy = false;
                });
        });
    });
</script>
}
