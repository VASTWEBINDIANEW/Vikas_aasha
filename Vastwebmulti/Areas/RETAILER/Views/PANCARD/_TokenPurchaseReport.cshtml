@model IEnumerable<Vastwebmulti.Models.PAN_CARD_IPAY_Token_report_paging_Result>
@{
    Layout = null;
}
@if (Model != null && Model.ToList().Count > 0)
{
    foreach (var item in Model)
    {
        var part = (item.Particulars ?? "");
        var upper = part.ToUpper();
        var tone = "pending";
        var toneFa = "fa-clock-o";
        var normStatus = "PENDING";
        var label = "Pending";
        if (upper.Contains("SUCCESS"))
        {
            tone = "success"; toneFa = "fa-check"; normStatus = "SUCCESS"; label = "Success";
        }
        else if (upper.Contains("FAILED"))
        {
            tone = "failed"; toneFa = "fa-times"; normStatus = "FAILED"; label = "Failed";
        }
        else if (upper.Contains("REFUND"))
        {
            tone = "failed"; toneFa = "fa-undo"; normStatus = "FAILED"; label = "Refund";
        }
        var total = 0m;
        try { total = Convert.ToDecimal(item.ProcessingFees) - Convert.ToDecimal(item.RetailerIncome); } catch { }
        <tr class="vm-dmt-row vm-dmt-row--@tone" data-amount="@item.ProcessingFees" data-status="@normStatus">
            <td class="vm-dmt-sr-cell"></td>
            <td>
                <span class="vm-dmt-status vm-dmt-status--@tone" title="@part"><i class="fa @toneFa" aria-hidden="true"></i></span>
                <span class="vm-dmt-txntype">@item.MerchantTxnId</span>
            </td>
            <td class="vm-dmt-amt-cell">@item.ProcessingFees</td>
            <td>@item.PhysicalCount</td>
            <td>@item.DigitalCount</td>
            <td>@item.UTI_TXN_ID</td>
            <td>@item.CouponStatus</td>
            <td>@item.Date</td>
            <td class="vm-dmt-amt-cell">@total</td>
            <td class="vm-dmt-amt-cell">@item.retailer_remain_pre</td>
            <td class="vm-dmt-amt-cell">@item.RetailerIncome</td>
            <td class="vm-dmt-amt-cell">@item.retailer_remain_post</td>
            <td class="vm-dmt-action-cell">
                <div class="vm-dmt-action-bar">
                    <button type="button" class="vm-dmt-act-btn" title="View Pancard Status" onclick="tokenStatus('@item.idno')"><i class="material-icons">visibility</i></button>
                </div>
            </td>
        </tr>
    }
}
else
{
    <tr class="vm-opr-table-empty-row">
        <td colspan="13" class="vm-opr-table-empty vm-dmt-table-empty">
            <div class="vm-opr-empty-state">
                <i class="fas fa-inbox" aria-hidden="true"></i>
                <h3>
                    @if (ViewBag.checkdata != null)
                    {
                        <text>No data for current search</text>
                    }
                    else
                    {
                        <text>Data not found</text>
                    }
                </h3>
                <p>Try a different date range or filter.</p>
            </div>
        </td>
    </tr>
}
