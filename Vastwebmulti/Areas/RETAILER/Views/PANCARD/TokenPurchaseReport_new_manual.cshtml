    body.saas-admin-ui .saas-pancard-new-page.saas-retailer-pancard-manual-page #pancardNew.vm-opr-data-table thead th:nth-child(12) { width: 7%; }
    body.saas-admin-ui .saas-pancard-new-page.saas-retailer-pancard-manual-page #pancardNew.vm-opr-data-table thead th:nth-child(13) { width: 4.5%; }
    body.saas-admin-ui .saas-pancard-new-page.saas-retailer-pancard-manual-page #pancardNew.vm-opr-data-table thead th:nth-child(14) { width: 4%; }
    body.saas-admin-ui .saas-pancard-new-page.saas-retailer-pancard-manual-page #pancardNew.vm-opr-data-table thead th:nth-child(15) { width: 3.5%; }
    body.saas-admin-ui .saas-pancard-new-page.saas-retailer-pancard-manual-page #pancardNew.vm-opr-data-table thead th:nth-child(16) { width: 4.5%; }
    body.saas-admin-ui .saas-pancard-new-page.saas-retailer-pancard-manual-page #pancardNew.vm-opr-data-table thead th:nth-child(17) { width: 4.5%; }
