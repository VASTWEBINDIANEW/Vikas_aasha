</style>

<div id="loadermoney" class="vm-dmt-loader" style="display:none;" aria-hidden="true">
    <div class="vm-dmt-loader__panel" role="status" aria-live="polite" aria-label="Processing">
        <div class="vm-dmt-table-loader__spinner" aria-hidden="true"></div>
        <span class="vm-dmt-loader__text">Please wait…</span>
    </div>
</div>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-pancard-report-page saas-pancard-new-page saas-retailer-pancard-manual-page">
    <div class="container-fluid vm-opr-page-shell">

        @{
            var panManFormAttrs = new Dictionary<string, object>
            {
                { "id", "retailerPanManualReportForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-report-date-form", "" },
                { "data-report-from", "#retailer_panman_frm_date" },
                { "data-report-to", "#retailer_panman_to_date" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("TokenPurchaseReport_new_manual", "PANCARD", FormMethod.Post, panManFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Financial Services</li>
                        <li>Pan Card Manual Report</li>
                    </ol>
                    <div class="vm-dmt-fin-nav-row">
                        @Html.Partial("~/Areas/RETAILER/Views/Home/_menuFinicalReport.cshtml")
                    </div>
                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="retailerPanManTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Transaction totals (loaded rows)</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideRetailerPanManTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Success</span>
                            <strong class="vm-opr-total-card__value" id="retailerPanManSuccess">&#8377; 0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Failed</span>
                            <strong class="vm-opr-total-card__value" id="retailerPanManFailed">&#8377; 0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Pending</span>
                            <strong class="vm-opr-total-card__value" id="retailerPanManPending">&#8377; 0.00</strong>
                        </div>
                    </div>
                </div>

                <div class="vm-rpt-filters-panel">
                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-rpt-filters-panel__bar">
                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("ddl_status", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "All Status", Value = "ALL", Selected = (selStatus == "ALL") },
                                new SelectListItem { Text = "Success", Value = "SUCCESS", Selected = selStatus == "SUCCESS" },
                                new SelectListItem { Text = "Pending", Value = "PENDING", Selected = selStatus == "PENDING" },
                                new SelectListItem { Text = "Failed", Value = "FAILED", Selected = selStatus == "FAILED" }
                            }, new { id = "ddl_status", @class = "vm-opr-select vm-dmt-select form-control", title = "Status" })
                        </div>
                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_panman_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_panman_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-id-card" aria-hidden="true"></i>
                        <span>Pan card manual applications</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <div class="vm-opr-mini-tabs">
                            @Html.ActionLink("NEW", "TokenPurchaseReport_new", "PANCARD", null, new { })
                            @Html.ActionLink("OLD", "TokenPurchaseReport", "PANCARD", null, new { })
                            @Html.ActionLink("MANUAL", "TokenPurchaseReport_new_manual", "PANCARD", null, new { @class = "is-active" })
                        </div>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn" onclick="FindtotalRetailerPanMan()" title="Show totals" aria-expanded="false" aria-controls="retailerPanManTotalsPanel"><i class="fas fa-chart-pie" aria-hidden="true"></i></button>
                            <button type="button" id="btnRetailerPanManExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel"><i class="fas fa-file-excel" aria-hidden="true"></i> Excel</button>
                            <button type="button" id="btnRetailerPanManPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF"><i class="fas fa-file-pdf" aria-hidden="true"></i> PDF</button>
                        </div>
                    </div>
                </div>
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="pancardNew" class="table vm-opr-data-table" cellspacing="0" style="width:100%;">
                            <thead>
                                <tr>
                                    <th>S.R.</th>
                                    <th>Status</th>
                                    <th>Name</th>
                                    <th>Mobile</th>
                                    <th>Email</th>
                                    <th>Father Name</th>
                                    <th>DOB</th>
                                    <th>Aadhaar</th>
                                    <th>Gender</th>
                                    <th>Amount &#8377;</th>
                                    <th>Request ID</th>
                                    <th>Request Time</th>
                                    <th>Rem Pre &#8377;</th>
                                    <th>Comm &#8377;</th>
                                    <th>TDS &#8377;</th>
                                    <th>Rem Post &#8377;</th>
                                    <th>Final &#8377;</th>
                                    <th>Doc</th>
                                </tr>
                            </thead>
                            <tbody id="retailerPanManRows">
                                @if (Model != null && Model.Count() > 0)
                                {
                                    foreach (var item in Model)
                                    {
                                        var rawStatus = (item.status ?? "");
                                        var sts = rawStatus.Contains("Refund") ? "Refund" : rawStatus;
                                        var upper = rawStatus.ToUpper();
                                        var tone = "pending";
                                        var toneFa = "fa-clock-o";
                                        var normStatus = "PENDING";
                                        if (upper.Contains("SUCCESS"))
                                        {
                                            tone = "success"; toneFa = "fa-check"; normStatus = "SUCCESS";
                                        }
                                        else if (upper.Contains("FAILED"))
                                        {
                                            tone = "failed"; toneFa = "fa-times"; normStatus = "FAILED";
                                        }
                                        else if (upper.Contains("REFUND"))
                                        {
                                            tone = "failed"; toneFa = "fa-undo"; normStatus = "FAILED";
                                        }
                                        <tr class="vm-dmt-row vm-dmt-row--@tone" data-amount="@item.Amount" data-status="@normStatus">
                                            <td class="vm-dmt-sr-cell"></td>
                                            <td>
                                                <span class="vm-dmt-status vm-dmt-status--@tone" title="@rawStatus"><i class="fa @toneFa" aria-hidden="true"></i></span>
                                                <span class="vm-dmt-txntype">@sts</span>
                                            </td>
                                            <td>@item.Title @item.Name</td>
                                            <td>Aadhar=@item.AadharregNumber<br />Customer=@item.Mobile</td>
                                            <td>@item.Email</td>
                                            <td>@item.Fathername</td>
                                            <td>@item.DOB</td>
                                            <td>@item.Aadharno</td>
                                            <td>@item.Gender</td>
                                            <td class="vm-dmt-amt-cell">@item.Amount</td>
                                            <td>@item.requestid</td>
                                            <td>@item.request_time</td>
                                            <td class="vm-dmt-amt-cell">@item.Rem_pre</td>
                                            <td class="vm-dmt-amt-cell">@item.Rem_comm</td>
                                            <td class="vm-dmt-amt-cell">@item.Rem_tds</td>
                                            <td class="vm-dmt-amt-cell">@item.rem_post</td>
                                            <td class="vm-dmt-amt-cell">@item.Rem_final</td>
                                            <td class="vm-dmt-action-cell">
                                                <div class="vm-dmt-action-bar">
                                                    @if (upper.Contains("FAILED"))
                                                    {
                                                        <span class="vm-dmt-txntype">@item.imageurl</span>
                                                    }
                                                    else if (upper.Contains("SUCCESS"))
                                                    {
                                                        if ((item.imageurl ?? "").Contains("/SlipPanCard/"))
                                                        {
                                                            <button type="button" class="vm-dmt-act-btn" title="View slip" onclick="views(@item.idno)"><i class="material-icons">visibility</i></button>
                                                        }
                                                        else
                                                        {
                                                            <a href="~/@item.imageurl" target="_blank" class="vm-dmt-act-btn" title="View document"><i class="material-icons">visibility</i></a>
                                                        }
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="18" class="vm-opr-table-empty vm-dmt-table-empty">
                                            <div class="vm-opr-empty-state">
                                                <i class="fas fa-inbox" aria-hidden="true"></i>
                                                <h3>Data not found</h3>
                                                <p>Try a different date range or filter.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section PostVmScripts {
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    function retailerPanManFilters() {
        return {
            txt_frm_date: jQuery('#retailer_panman_frm_date').val() || '',
            txt_to_date: jQuery('#retailer_panman_to_date').val() || '',
            ddl_status: jQuery('#ddl_status').val() || 'ALL'
        };
    }

    function renumberRetailerPanManSr() {
        jQuery('#retailerPanManRows tr.vm-dmt-row').each(function (i) {
            jQuery(this).find('.vm-dmt-sr-cell').first().text(i + 1);
        });
    }

    function hideRetailerPanManTotals() {
        var $panel = jQuery('#retailerPanManTotalsPanel');
        var $btn = jQuery('.vm-dmt-totals-btn');
        $panel.removeClass('is-open').hide().attr('aria-hidden', 'true');
        $btn.removeClass('is-active').attr({ title: 'Show totals', 'aria-expanded': 'false' });
    }

    function calcRetailerPanManTotals() {
        var success = 0, failed = 0, pending = 0;
        jQuery('#retailerPanManRows tr.vm-dmt-row').each(function () {
            var amt = parseFloat(jQuery(this).attr('data-amount')) || 0;
            var st = (jQuery(this).attr('data-status') || '').toUpperCase();
            if (st === 'SUCCESS') { success += amt; }
            else if (st === 'FAILED') { failed += amt; }
            else { pending += amt; }
        });
        jQuery('#retailerPanManSuccess').html('&#8377; ' + success.toFixed(2));
        jQuery('#retailerPanManFailed').html('&#8377; ' + failed.toFixed(2));
        jQuery('#retailerPanManPending').html('&#8377; ' + pending.toFixed(2));
    }

    function FindtotalRetailerPanMan() {
        var $panel = jQuery('#retailerPanManTotalsPanel');
        var $btn = jQuery('.vm-dmt-totals-btn');
        if ($panel.hasClass('is-open')) {
            hideRetailerPanManTotals();
            return;
        }
        $panel.addClass('is-open').show().attr('aria-hidden', 'false');
        $btn.addClass('is-active').attr({ title: 'Hide totals', 'aria-expanded': 'true' });
        calcRetailerPanManTotals();
    }

    function views(i) {
        jQuery.ajax({
            url: '@Url.Action("slipview", "Home")',
            type: 'POST',
            data: { Idno: i },
            cache: false,
            success: function (Response) {
                window.open(Response, '_blank');
                window.location.reload();
            }
        });
    }

    function tokenStatus(id) {
        var url = '@Url.Action("GetTokenStatus", "PANCARD")';
        jQuery.post(url, { id: id }, function (data) {
            var response = JSON.parse(data);
            if (response.RESULT == "0") {
                swal("Wow!", response.ADDINFO, "success");
            }
            else if (response.RESULT == "2") {
                swal("Oops!", response.ADDINFO, "warning");
            }
            else {
                swal("Oops!!!", response.ADDINFO, "error");
            }
        })
        .fail(function (jqXHR) {
            swal("Oops!!!", jqXHR.responseText, "error");
        });
    }

    function initRetailerPanManSelect2() {
        jQuery('#ddl_status').each(function () {
            var $el = jQuery(this);
