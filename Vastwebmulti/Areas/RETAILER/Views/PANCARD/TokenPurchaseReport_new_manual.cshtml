    body.saas-admin-ui .saas-pancard-new-page.saas-retailer-pancard-manual-page #pancardNew.vm-opr-data-table thead th:nth-child(4) { width: 9%; }
    body.saas-admin-ui .saas-pancard-new-page.saas-retailer-pancard-manual-page #pancardNew.vm-opr-data-table thead th:nth-child(5) { width: 8%; }
