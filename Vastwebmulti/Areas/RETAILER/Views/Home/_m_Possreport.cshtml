@model IEnumerable<Vastwebmulti.Models.Mpos_Report_New_paging_Result>
@{
    Layout = null;
}
@if (Model != null && Model.Count() > 0)
{
    foreach (var item in Model)
    {
        var isSuccess = (item.status ?? "") == "00";
        var tone = isSuccess ? "success" : "failed";
        var toneFa = isSuccess ? "fa-check" : "fa-times";
        var normStatus = isSuccess ? "SUCCESS" : "FAILED";

        string maskedCard = item.cardnumber;
        try
        {
            maskedCard = "***********" + System.Text.RegularExpressions.Regex.Match(item.cardnumber ?? "", @"(.{6})\s*$");
        }
        catch { }

        string maskedPayment = item.paymentid;
        try
        {
            maskedPayment = "*******" + System.Text.RegularExpressions.Regex.Match(item.paymentid ?? "", @"(.{6})\s*$");
        }
        catch { }

        <tr class="vm-dmt-row vm-dmt-row--@tone" data-amount="@item.amount" data-status="@normStatus">
            <td class="vm-dmt-sr-cell"></td>
            <td>
                <span class="vm-dmt-status vm-dmt-status--@tone" title="@(isSuccess ? "Success" : "Failed")"><i class="fa @toneFa" aria-hidden="true"></i></span>
                <span class="vm-dmt-txntype">@item.transType</span>
            </td>
            <td>@item.mPOSid</td>
            <td>@item.cardbrand</td>
            <td>@item.cardtype</td>
            <td>@maskedCard</td>
            <td>@item.cardholdername</td>
            <td>@maskedPayment</td>
            <td>@item.Rem_comm</td>
            <td class="vm-dmt-amt-cell">@item.remincome</td>
            <td class="vm-dmt-amt-cell">@item.RetailerPre</td>
            <td class="vm-dmt-amt-cell">@item.amount</td>
            <td class="vm-dmt-amt-cell">@item.RetailerPost</td>
            <td class="vm-dmt-action-cell">
                <div class="vm-dmt-action-bar">
                    <button type="button" class="vm-dmt-act-btn" title="View detail"
                            data-merchantid="@item.merchatID"
                            data-bankmerchantid="@item.bankmerchantID"
                            data-bankterminalid="@item.bankterminalID"
                            data-invoiceno="@item.invoiceno"
                            data-merchantaddress="@item.merchantnameaddress"
                            data-requesttime="@item.date"
                            data-retailercomm="@item.Rem_comm"
                            data-retailergst="@item.remgst"
                            data-retailerincome="@item.remincome"
                            onclick="showRetailerMpossDetail(this)"><i class="material-icons">visibility</i></button>
                </div>
            </td>
        </tr>
    }
}
else
{
    <tr class="vm-opr-table-empty-row">
        <td colspan="14" class="vm-opr-table-empty vm-dmt-table-empty">
            <div class="vm-opr-empty-state">
                <i class="fas fa-inbox" aria-hidden="true"></i>
                <h3>
                    @if (ViewBag.checkdata != null)
                    {
                        <text>No data for current search</text>
                    }
                    else
                    {
                        <text>Data not found</text>
                    }
                </h3>
                <p>Try a different date range or filter.</p>
            </div>
        </td>
    </tr>
}
