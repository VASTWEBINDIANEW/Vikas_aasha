<script>
    $(function () {
        function vmRmtHideModalAtRest($modal) {
            if (!$modal || !$modal.length) return;
            $modal.removeClass('in show').attr('aria-hidden', 'true').css('display', 'none');
        }

        vmRmtHideModalAtRest($('#dmtdetails'));
        vmRmtHideModalAtRest($('#aepstableclickpop'));
        vmRmtHideModalAtRest($('#aepstableclickpopee'));

        $('#dmtdetails').on('hidden.bs.modal', function () {
            vmRmtHideModalAtRest($(this));
            $('#Successdatarr').off('click.rmtPending');
        });

        $('#aepstableclickpop, #aepstableclickpopee').on('hidden.bs.modal', function () {
            vmRmtHideModalAtRest($(this));
        });

        if (!$('body.saas-admin-ui .modal.in:visible, body.saas-admin-ui .modal.show:visible').length) {
            $('.modal-backdrop').remove();
            $('body').removeClass('modal-open').css({ overflow: '', 'padding-right': '' });
        }
    });
</script>