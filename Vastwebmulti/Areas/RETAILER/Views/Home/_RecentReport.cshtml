@model Vastwebmulti.Areas.RETAILER.Models.Recent_report
@using System.Web
@using System.Linq

@functions {
    public IHtmlString VmRmtStatusBadgeByMod(string mod, string title)
    {
        var fa = "fa-solid fa-xmark";
        switch (mod)
        {
            case "success": fa = "fa-solid fa-check"; break;
            case "pending": fa = "fa-solid fa-clock"; break;
            case "verify": fa = "fa-solid fa-shield-halved"; break;
            case "refund": fa = "fa-solid fa-rotate-left"; break;
            case "warn": fa = "fa-solid fa-triangle-exclamation"; break;
            case "neutral": fa = "fa-solid fa-circle-info"; break;
        }

        return new HtmlString(string.Format(
            "<span class=\"vm-rmt-txn-status vm-rmt-txn-status--{0}\" title=\"{1}\"><i class=\"{2}\" aria-hidden=\"true\"></i></span>",
            mod,
            HttpUtility.HtmlEncode(string.IsNullOrEmpty(title) ? "Status" : title),
            fa));
    }

    public IHtmlString VmRmtStatusBadge(string status, string transType = "")
    {
        var st = (status ?? "").Trim();
        var stU = st.ToUpperInvariant();
        var mod = "failed";
        if (stU == "SUCCESS") { mod = "success"; }
        else if (stU == "PENDING") { mod = "pending"; }
        else if (stU == "FAILED") { mod = "failed"; }

        if (!string.IsNullOrEmpty(transType) && transType.ToUpperInvariant() == "IMPS_VERIFY")
        {
            mod = "verify";
        }

        return VmRmtStatusBadgeByMod(mod, string.IsNullOrEmpty(st) ? "Unknown" : st);
    }

    public bool VmRmtLooksLikeNumericRrn(string value)
    {
        if (string.IsNullOrEmpty(value)) return false;
        var s = value.Trim();
        if (s.Length < 8 || s.Length > 32) return false;
        return s.All(char.IsDigit);
    }

    public string VmRmtAepsOutcomeMod(string status, string bankRrn)
    {
        var stU = (status ?? "").Trim().ToUpperInvariant();
        if (stU == "SUCCESS" || (stU.Contains("SUCCESS") && !stU.Contains("FAIL"))) return "success";
        if (stU == "FAILED" || stU.Contains("FAIL")) return "failed";
        if (stU == "PENDING" || stU.Contains("PENDING")) return "pending";
        if (stU.Contains("REFUND")) return "refund";

        var rrn = (bankRrn ?? "").Trim();
        if (string.IsNullOrEmpty(rrn)) return "pending";

        if (rrn.IndexOf("success", StringComparison.OrdinalIgnoreCase) >= 0) return "success";
        if (VmRmtLooksLikeNumericRrn(rrn)) return "success";

        if (rrn.IndexOf("invalid", StringComparison.OrdinalIgnoreCase) >= 0
            || rrn.IndexOf("fail", StringComparison.OrdinalIgnoreCase) >= 0
            || rrn.IndexOf("exceeded", StringComparison.OrdinalIgnoreCase) >= 0
            || rrn.IndexOf("threshold", StringComparison.OrdinalIgnoreCase) >= 0
            || rrn.IndexOf("otp", StringComparison.OrdinalIgnoreCase) >= 0
            || rrn.IndexOf("error", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            return "failed";
        }

        return rrn.Length > 16 ? "failed" : "warn";
    }

    public string VmRmtAepsOutcomeLabel(string mod)
    {
        switch (mod)
        {
            case "success": return "Success";
            case "pending": return "Pending";
            case "refund": return "Refunded";
            case "warn": return "Review";
            default: return "Failed";
        }
    }

    public IHtmlString VmRmtAepsStatusCell(string status, string bankRrn, string txnType)
    {
        var mod = VmRmtAepsOutcomeMod(status, bankRrn);
        var outcome = VmRmtAepsOutcomeLabel(mod);
        var typeLabel = string.IsNullOrWhiteSpace(txnType) ? "AEPS" : txnType.Trim();
        var badge = VmRmtStatusBadgeByMod(mod, outcome + " — " + typeLabel);

        return new HtmlString(string.Format(
            "<div class=\"vm-rmt-aeps-status\"><div class=\"vm-rmt-aeps-status__badge\">{0}</div><div class=\"vm-rmt-aeps-status__text\"><span class=\"vm-rmt-txn-type\">{1}</span><span class=\"vm-rmt-txn-outcome vm-rmt-txn-outcome--{2}\">{3}</span></div></div>",
            badge.ToString(),
            HttpUtility.HtmlEncode(typeLabel),
            mod,
            HttpUtility.HtmlEncode(outcome)));
    }

    public IHtmlString VmRmtAepsBankRrnCell(string status, string bankRrn)
    {
        var s = (bankRrn ?? "").Trim();
        if (string.IsNullOrEmpty(s))
        {
            return new HtmlString("<span class=\"vm-rmt-rrn vm-rmt-rrn--muted\">—</span>");
        }

        var mod = VmRmtAepsOutcomeMod(status, s);
        if (mod == "success")
        {
            return VmRmtRrnCell(s);
        }

        return new HtmlString(string.Format(
            "<span class=\"vm-rmt-rrn vm-rmt-rrn--error\" title=\"Bank response\">{0}</span>",
            HttpUtility.HtmlEncode(s)));
    }

    public IHtmlString VmRmtStatusBadgeWarn(string title)
    {
        var t = string.IsNullOrEmpty(title) ? "Attention required" : title;
        return new HtmlString(string.Format(
            "<span class=\"vm-rmt-txn-status vm-rmt-txn-status--warn\" title=\"{0}\"><i class=\"fa-solid fa-triangle-exclamation\" aria-hidden=\"true\"></i></span>",
            HttpUtility.HtmlEncode(t)));
    }

    public IHtmlString VmRmtStatusBadgeForDmt(string status, string transType, string bankTransId)
    {
        var rrn = (bankTransId ?? "").Trim();
        if (rrn.IndexOf("try after", StringComparison.OrdinalIgnoreCase) >= 0
            || rrn.IndexOf("please try", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            return VmRmtStatusBadgeWarn(rrn);
        }
        return VmRmtStatusBadge(status, transType);
    }

    public IHtmlString VmRmtStatusBadgeFromText(string statusText)
    {
        var s = (statusText ?? "").Trim();
        if (string.IsNullOrEmpty(s)) return new HtmlString(string.Empty);

        if (s.IndexOf("refund", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            return new HtmlString(string.Format(
                "<span class=\"vm-rmt-txn-status vm-rmt-txn-status--refund\" title=\"{0}\"><i class=\"fa-solid fa-rotate-left\" aria-hidden=\"true\"></i></span>",
                HttpUtility.HtmlEncode(s)));
        }
        if (s.IndexOf("try after", StringComparison.OrdinalIgnoreCase) >= 0
            || s.IndexOf("please try", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            return VmRmtStatusBadgeWarn(s);
        }
        if (s.IndexOf("pending", StringComparison.OrdinalIgnoreCase) >= 0) return VmRmtStatusBadge("PENDING");
        if (s.IndexOf("success", StringComparison.OrdinalIgnoreCase) >= 0) return VmRmtStatusBadge("SUCCESS");
        if (s.IndexOf("fail", StringComparison.OrdinalIgnoreCase) >= 0) return VmRmtStatusBadge("FAILED");
        return VmRmtStatusBadgeByMod("neutral", s);
    }

    public string VmRmtRowClass(string status, DateTime? transTime)
    {
        if ((status ?? "").ToUpperInvariant() != "PENDING" || !transTime.HasValue) return "vm-rmt-row";
        var mins = DateTime.Now.Subtract(transTime.Value).TotalMinutes;
        return mins < 2 ? "vm-rmt-row vm-rmt-row--pending-hot" : "vm-rmt-row vm-rmt-row--pending";
    }

    public IHtmlString VmRmtRrnCell(string rrnOrStatus)
    {
        var s = (rrnOrStatus ?? "").Trim();
        if (string.IsNullOrEmpty(s)) return new HtmlString(string.Empty);

        var mod = "neutral";
        if (s.IndexOf("fail", StringComparison.OrdinalIgnoreCase) >= 0) mod = "failed";
        else if (s.IndexOf("success", StringComparison.OrdinalIgnoreCase) >= 0) mod = "success";
        else if (s.IndexOf("pending", StringComparison.OrdinalIgnoreCase) >= 0) mod = "pending";
        else if (s.IndexOf("try after", StringComparison.OrdinalIgnoreCase) >= 0
            || s.IndexOf("please try", StringComparison.OrdinalIgnoreCase) >= 0) mod = "warn";

        if (mod == "neutral" && s.Length <= 24 && s.All(c => char.IsDigit(c)))
        {
            return new HtmlString(string.Format(
                "<span class=\"vm-rmt-rrn vm-rmt-rrn--id\" title=\"Bank RRN\">{0}</span>",
                HttpUtility.HtmlEncode(s)));
        }

        return new HtmlString(string.Format(
            "<span class=\"vm-rmt-rrn vm-rmt-rrn--{0}\">{1}</span>",
            mod,
            HttpUtility.HtmlEncode(s)));
    }
}

