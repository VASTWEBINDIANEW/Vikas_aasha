@model Vastwebmulti.Areas.ADMIN.Models.TDSReportModel
@using System.Linq
@{
    ViewBag.Title = "TDSReport";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";

    var tdsRows = Model != null && Model.TDSRetailer != null ? Model.TDSRetailer.ToList() : null;
    var rowCount = tdsRows != null ? tdsRows.Count : 0;
    decimal totalTds = 0m;
    if (tdsRows != null) { foreach (var x in tdsRows) { try { totalTds += Convert.ToDecimal(x.TDS); } catch { } } }
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=38" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=43" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=22" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<style>
    /* TDS Report : Account_verify_Gst_Invocing_report design me toolbar + table */
    body.saas-admin-ui .saas-retailer-tds-page .vm-ledger-nav { display: inline-flex !important; align-items: center; gap: 6px; min-height: 34px; padding: 0 14px; border-radius: 9px; border: 1px solid #dbe2ec; background: #fff; color: #475569; font-size: 12.5px; font-weight: 800; text-decoration: none !important; transition: all .15s ease; white-space: nowrap; }
    body.saas-admin-ui .saas-retailer-tds-page .vm-ledger-nav:hover { border-color: #2563eb; color: #2563eb; box-shadow: 0 4px 12px rgba(37,99,235,.18); }
    body.saas-admin-ui .saas-retailer-tds-page .vm-gstinv-month-badge { display: inline-flex !important; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 999px; background: #eff6ff !important; border: 1px solid #bfdbfe !important; color: #1d4ed8 !important; font-size: 12px; font-weight: 800; white-space: nowrap; }
    body.saas-admin-ui .saas-retailer-tds-page .vm-tds-month-strip { display: flex !important; flex: 1 1 auto !important; width: 100% !important; min-width: 0 !important; gap: 3px !important; padding: 3px 4px !important; background: #f1f5f9 !important; border: 1px solid #dbe4f0 !important; border-radius: 9px !important; box-shadow: inset 0 1px 0 rgba(255,255,255,.85) !important; }
    body.saas-admin-ui .saas-retailer-tds-page .vm-tds-month-form { display: flex !important; flex: 1 1 auto !important; width: 100% !important; gap: 3px !important; align-items: center !important; margin: 0 !important; }
    body.saas-admin-ui .saas-retailer-tds-page .vm-tds-month-btn { flex: 1 1 0 !important; display: inline-flex !important; align-items: center; justify-content: center; gap: 5px; min-height: 28px !important; height: 28px !important; padding: 0 7px !important; border-radius: 7px !important; border: 1px solid #e2e8f0 !important; background: #fff !important; color: #64748b !important; font-size: 12px !important; font-weight: 700 !important; cursor: pointer; transition: all .15s ease; white-space: nowrap; }
    body.saas-admin-ui .saas-retailer-tds-page .vm-tds-month-btn:hover { border-color: #93c5fd !important; color: #1d4ed8 !important; background: #eff6ff !important; }
    body.saas-admin-ui .saas-retailer-tds-page .vm-tds-month-btn.is-active { background: linear-gradient(135deg, #1e40af, #2563eb) !important; border-color: #1d4ed8 !important; color: #fff !important; box-shadow: 0 2px 10px rgba(37,99,235,.35) !important; }
    body.saas-admin-ui .saas-retailer-tds-page .vm-gstinv-num { font-variant-numeric: tabular-nums !important; }
    body.saas-admin-ui .saas-retailer-tds-page .vm-gstinv-total-cell { font-weight: 800 !important; color: #0f172a !important; }
    /* Desktop (>=1024px): fit-to-width, no scroll, tight columns */
    @@media (min-width: 1024px) {
        body.saas-admin-ui .saas-retailer-tds-page #tdsReport.vm-opr-data-table {
            width: 100% !important;
            min-width: 0 !important;
            max-width: 100% !important;
            table-layout: fixed !important;
        }
        body.saas-admin-ui .saas-retailer-tds-page #tdsReport.vm-opr-data-table thead tr,
        body.saas-admin-ui .saas-retailer-tds-page #tdsReport.vm-opr-data-table tbody tr {
            display: table-row !important;
        }
        body.saas-admin-ui .saas-retailer-tds-page #tdsReport.vm-opr-data-table thead th,
        body.saas-admin-ui .saas-retailer-tds-page #tdsReport.vm-opr-data-table tbody td {
            display: table-cell !important;
            min-width: 0 !important;
            max-width: none !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            white-space: nowrap !important;
        }
        body.saas-admin-ui .saas-retailer-tds-page #tdsReport.vm-opr-data-table thead th:nth-child(1),
        body.saas-admin-ui .saas-retailer-tds-page #tdsReport.vm-opr-data-table tbody td:nth-child(1) { width: 8% !important; }
        body.saas-admin-ui .saas-retailer-tds-page #tdsReport.vm-opr-data-table thead th:nth-child(2),
        body.saas-admin-ui .saas-retailer-tds-page #tdsReport.vm-opr-data-table tbody td:nth-child(2) { width: 17% !important; }
        body.saas-admin-ui .saas-retailer-tds-page #tdsReport.vm-opr-data-table thead th:nth-child(3),
        body.saas-admin-ui .saas-retailer-tds-page #tdsReport.vm-opr-data-table tbody td:nth-child(3) { width: 27% !important; }
        body.saas-admin-ui .saas-retailer-tds-page #tdsReport.vm-opr-data-table thead th:nth-child(4),
        body.saas-admin-ui .saas-retailer-tds-page #tdsReport.vm-opr-data-table tbody td:nth-child(4) { width: 26% !important; }
        body.saas-admin-ui .saas-retailer-tds-page #tdsReport.vm-opr-data-table thead th:nth-child(5),
        body.saas-admin-ui .saas-retailer-tds-page #tdsReport.vm-opr-data-table tbody td:nth-child(5) { width: 22% !important; }
    }
    /* Mobile + tablet (<=1023px): natural widths, full text, horizontal scroll */
    @@media (max-width: 1023.98px) {
        body.saas-admin-ui .saas-retailer-tds-page #tdsReport.vm-opr-data-table {
            width: max-content !important;
            min-width: 700px !important;
            max-width: none !important;
            table-layout: auto !important;
        }
        body.saas-admin-ui .saas-retailer-tds-page #tdsReport.vm-opr-data-table thead tr,
        body.saas-admin-ui .saas-retailer-tds-page #tdsReport.vm-opr-data-table tbody tr {
            display: table-row !important;
        }
        body.saas-admin-ui .saas-retailer-tds-page #tdsReport.vm-opr-data-table thead th,
        body.saas-admin-ui .saas-retailer-tds-page #tdsReport.vm-opr-data-table tbody td {
            display: table-cell !important;
            width: auto !important;
            min-width: 0 !important;
            max-width: none !important;
            white-space: nowrap !important;
            overflow: visible !important;
            text-overflow: clip !important;
        }
        body.saas-admin-ui .saas-retailer-tds-page .vm-opr-table-scroll {
            overflow-x: auto !important;
        }
    }
</style>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-retailer-ecomm-transaction-page saas-retailer-tds-page">

    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

            <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line">

                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home", new { area = "RETAILER" })"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>GST</li>
                    <li>TDS Report</li>
                </ol>

                <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                    <a class="vm-ledger-nav" href="@Url.Action("Gst_Invocing_Retailer_report", "Home")" title="Go to GST Report"><i class="fas fa-file-invoice-dollar" aria-hidden="true"></i> Go to GST Report</a>
                    <a class="vm-ledger-nav" href="@Url.Action("Account_verify_Gst_Invocing_report", "Home")" title="Account Verify GST Report"><i class="fas fa-check-circle" aria-hidden="true"></i> Account Verify GST Report</a>
                </div>

            </div>

            <div class="vm-rpt-filters-panel">
                <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-rpt-filters-panel__bar">
                    <div class="vm-dmt-filter-search-group" style="justify-content:flex-start !important;margin-left:0 !important;padding-left:0 !important;">
                        <div class="vm-tds-month-strip">
                        @using (Html.BeginForm("TDSReport", "Home", FormMethod.Post, new { id = "tdsMonthForm", @class = "vm-tds-month-form" }))
                        {
                            foreach (var m in new[] { ViewBag.CurrentMonthName, ViewBag.OldMonth1, ViewBag.OldMonth2 })
                            {
                                var mStr = Convert.ToString(m);
                                var isActive = mStr == Convert.ToString(ViewBag.Crmonth) ? " is-active" : "";
                                <button type="submit" name="submit" value="@mStr" class="vm-tds-month-btn@(isActive)" title="Show @mStr TDS">
                                    <i class="fa fa-calendar" aria-hidden="true"></i><span>@mStr</span>
                                </button>
                            }
                        }
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-percent" aria-hidden="true"></i>
                        <span>TDS report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-gstinv-month-badge" title="Month">
                            <i class="fa fa-calendar" aria-hidden="true"></i> @ViewBag.Crmonth
                        </span>
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong>@rowCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total" title="Total TDS">
                            Total TDS: <strong>&#8377; @totalTds.ToString("N2")</strong>
                        </span>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="tdsReport" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Idno</th>
                                    <th>Role</th>
                                    <th>Farm Name</th>
                                    <th>Name</th>
                                    <th>DMT TDS</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (tdsRows != null)
                                {
                                    var i = 1;
                                    foreach (var item in tdsRows)
                                    {
                                        <tr>
                                            <td>@i</td>
                                            <td title="@item.Role">@item.Role</td>
                                            <td title="@item.FarmName">@item.FarmName</td>
                                            <td title="@item.Name">@item.Name</td>
                                            <td class="vm-gstinv-num vm-gstinv-total-cell" title="@item.TDS">@item.TDS</td>
                                        </tr>
                                        i++;
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>
