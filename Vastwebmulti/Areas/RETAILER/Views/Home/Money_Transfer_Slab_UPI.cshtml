@model Vastwebmulti.Areas.ADMIN.Models.DMT2SlabModel1
@{
    ViewBag.Title = "Money_Transfer_Slab_UPI";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";
    ViewBag.OiActiveTab = "money";
    ViewBag.OiFinActive = "upi";
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/retailer-operator-info-modern.css?v=46" rel="stylesheet" />

<section class="content saas-admin-account-page vm-operator-info-page vm-dmt-slab-page">
    <div class="container-fluid">
        <div class="page-title-box-fourde">
            <h3>Operator Comm</h3>
            <ul>
                <li><a href="@Url.Action("Dashboard", "Home")">Home&nbsp;&nbsp;<i class="fa fa-angle-right"></i></a></li>
                <li><a href="javascript:void(0);">Pages&nbsp;&nbsp;<i class="fa fa-angle-right"></i></a></li>
                <li><a href="javascript:void(0);">Operator Com</a></li>
            </ul>
        </div>

        <div class="row clearfix operator-clearfix">
            <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">

                <div class="page-header-third vm-oi-toolbar-zone">
                    <div class="container-fluid vm-opr-page-shell">
                        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">
                            <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line">
                                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                                    <li>Operator Info</li>
                                    <li class="textshowspanclass-header">Money Transfer</li>
                                </ol>
                                <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group vm-oi-toolbar-actions">
                                    <button type="button" id="btnDmtUpiExport" class="saas-acc-btn saas-acc-btn--excel" title="Excel download"><i class="fas fa-file-excel" aria-hidden="true"></i> Excel</button>
                                    <button type="button" id="btnDmtUpiPdf" class="saas-acc-btn saas-acc-btn--pdf" title="Print / PDF"><i class="fas fa-file-pdf" aria-hidden="true"></i> PDF</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card navbar class-back-tra-fourdesign">
                    <div class="body Gift_Carddbody">
                        <div class="svg-container-third-design" aria-hidden="true"></div>

                        <div class="row vm-oi-white-panel">
                            <div class="col-md-12 giftcardcategory giftcardcategory-second giftcardcategory-second-design giftcardtab-thirddesign">
                                <center class="vm-oi-tab-strip-wrap">
                                    <div class="page-header-third vm-oi-tab-strip-head">
                                        @{ Html.RenderPartial("_OperatorInfoServiceTabs"); }
                                    </div>
                                </center>
                            </div>

                            <div class="page-header-third">
                                <div class="vm-oi-table-area-shell">
                                    <div class="tab-content tab-contentoperators tab-content-gifts-secondde tablethirddesign-new tablethirddesign-newnew four-design-table-design vm-oi-slab-body">

                                        <div class="wallet_transfer">
                                            <ul id="ul" class="financal-second financal-third">
                                                <li><a href="@Url.Action("Money_Transfer_Slab_DMT2", "Home")">Pay Out (Slab1)</a></li>
                                                <li><a href="@Url.Action("Money_Transfer_Slab_DMT1", "Home")">Pay Out(Slab2)</a></li>
                                                <li><a class="vm-oi-fin-active" href="@Url.Action("Money_Transfer_Slab_UPI", "Home")">Pay Out UPI</a></li>
                                                <li><a href="@Url.Action("dmtSlab", "Home")">DMT</a></li>
                                                <li><a href="@Url.Action("DmtSlabPPI", "Home")">DMT PPI</a></li>
                                                <li><a href="@Url.Action("WalleTransferSlab", "Home")">Wallet&nbsp;Transfer</a></li>
                                            </ul>
                                        </div>

                                        <div class="vm-oi-table-scroll-shell">
                                            <div class="col-md-12 vm-oi-slab-table-wrap vm-oi-slab-common-table">
                                                @Html.Partial("_Common_Money_transfer_UPI", Model)
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section PostVmScripts {
<script src="~/MainFrontDesign/js/retailer-operator-info-tabs.js?v=14"></script>
<script>
(function ($) {
    'use strict';
    if (!$) { return; }
    var $page = $('section.vm-dmt-slab-page');
    $page.find('.vm-oi-slab-common-table table').addClass('vm-oi-data-table vm-oi-slab-wide-table');
    $page.find('.vm-oi-slab-common-table .table-responsive, .vm-oi-slab-common-table .slab-edit-table').css({ overflow: 'visible', maxWidth: 'none' });

    $('#btnDmtUpiPdf').on('click', function () {
        document.body.classList.add('oi-printing');
        window.print();
        setTimeout(function () { document.body.classList.remove('oi-printing'); }, 1500);
    });
    $('#btnDmtUpiExport').on('click', function () {
        var $table = $page.find('table.vm-oi-data-table, table.slab-table').first();
        if (!$table.length) { return; }
        var stamp = new Date().toISOString().slice(0, 10).replace(/-/g, '');
        var html = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><meta charset="UTF-8"></head><body>' +
            $table.clone().wrap('<div/>').parent().html() + '</body></html>';
        var blob = new Blob(['\ufeff' + html], { type: 'application/vnd.ms-excel' });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'MoneyTransfer_SlabUPI_' + stamp + '.xls';
        document.body.appendChild(a);
        a.click();
        setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 500);
    });
})(window.jQuery || window.vmAdminJq);
</script>
}
