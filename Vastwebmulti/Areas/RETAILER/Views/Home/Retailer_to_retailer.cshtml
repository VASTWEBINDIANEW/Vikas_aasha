                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_rem2rem_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="retailerRem2RemTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Transfer totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideRetailerRem2RemTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--primary">
                            <span class="vm-opr-total-card__label">Total transfer</span>
                            <strong class="vm-opr-total-card__value">&#8377; @totalTransfer.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Records</span>
                            <strong class="vm-opr-total-card__value">@rowCount</strong>
                        </div>
                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-list" aria-hidden="true"></i>
                        <span>Retailer transfer history</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong>@rowCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total" title="Total transfer amount">
                            Total: <strong>&#8377; @totalTransfer.ToString("N2")</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-ecomm-totals-btn" onclick="showRetailerRem2RemTotals()" title="Show totals" aria-expanded="false" aria-controls="retailerRem2RemTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnExportRetailerRem2Rem" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDFRetailerRem2Rem" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="retailerRem2RemReport" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Retailer&nbsp;id</th>
                                    <th>Transfer&nbsp;amt&nbsp;&#8377;</th>
                                    <th>Retailer&nbsp;old&nbsp;bal</th>
                                    <th>Retailer&nbsp;new&nbsp;bal</th>
                                    <th>Your&nbsp;old&nbsp;bal</th>
                                    <th>Your&nbsp;new&nbsp;bal</th>
                                    <th>Comment</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody id="retailerRem2RemRows">
                                @if (reports.Count > 0)
                                {
                                    foreach (var item in reports)
                                    {
                                        <tr class="vm-dmt-row">
                                            <td>
                                                <span class="vm-dmt-refno-text">@item.rem_to</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(item.value ?? 0m, 2)</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(item.rem_to_old_bal ?? 0m, 2)</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(item.rem_to_new ?? 0m, 2)</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(item.rem_from_old_bal ?? 0m, 2)</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(item.rem_from_new ?? 0m, 2)</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-consumer-text">@item.comment</span>
                                            </td>
                                            <td class="vm-ticket-time-cell">
                                                <span class="vm-dmt-refno-text">@(item.tran_date.HasValue ? String.Format("{0:dd-MMM-yyyy HH:mm:ss}", item.tran_date.Value) : "—")</span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="8" class="vm-opr-table-empty vm-dmt-table-empty">
                                            <i class="fas fa-exchange-alt" aria-hidden="true"></i>
                                            <span>No retailer transfer records found.</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            @if (reports.Count > 0)
                            {
                                <tfoot>
                                    <tr class="vm-dmt-row vm-dmt-total-row">
                                        <td>
                                            <span class="vm-dmt-amount-text"><strong>Total</strong></span>
                                        </td>
                                        <td>
                                            <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> <strong>@totalTransfer.ToString("N2")</strong></span>
                                        </td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section PostVmScripts {
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    function hideRetailerRem2RemTotals() {
        var $panel = jQuery('#retailerRem2RemTotalsPanel');
        var $btn = jQuery('.saas-retailer-rem2rem-page .vm-ecomm-totals-btn');
        $panel.hide().attr('aria-hidden', 'true');
        $btn.attr('aria-expanded', 'false');
    }

    function showRetailerRem2RemTotals() {
        var $panel = jQuery('#retailerRem2RemTotalsPanel');
        var $btn = jQuery('.saas-retailer-rem2rem-page .vm-ecomm-totals-btn');
        if ($panel.is(':visible')) {
            hideRetailerRem2RemTotals();
            return;
        }
        $panel.show().attr('aria-hidden', 'false');
        $btn.attr('aria-expanded', 'true');
    }

    function downloadRetailerRem2RemExcel() {
        var table = document.getElementById('retailerRem2RemReport');
        if (!table || !table.tBodies || !table.tBodies[0] || table.tBodies[0].rows.length === 0) {
            alert('No records to export.');
            return;
        }
        var html = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><meta charset="UTF-8"></head><body>' + table.outerHTML + '</body></html>';
        var blob = new Blob(['\ufeff' + html], { type: 'application/vnd.ms-excel' });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'Retailer_to_retailer.xls';
        document.body.appendChild(a);
        a.click();
        setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 100);
    }

    /* Amount ke shabd dikhao; khaali ho to line hi chhupao */
    function rem2remWordShow(el) {
        var w = '';
        try { w = convertNumberToWords(el.value); } catch (e) { w = ''; }
        jQuery('#word').html(w);
        if (w && jQuery.trim(w) !== '') {
            jQuery('#rem2remWords').addClass('show');
        } else {
            jQuery('#rem2remWords').removeClass('show');
        }
    }

    /* Cancel : form wapas shuru wali haalat me */
    function resetRem2RemForm() {
        jQuery('#RetailerId').val('').removeClass('vm-rem2rem-input-error').attr('data-valid', '0');
        jQuery('#txtbal').val('');
        jQuery('#comment').val('');
        jQuery('#word').html('');
        jQuery('#rem2remWords').removeClass('show');
        jQuery('#retailerinform').hide();
        jQuery('#rem2remLookup').hide();
        jQuery('.new-nextbutton').css('display', '');
        jQuery('.saas-retailer-rem2rem-page .noneandshow').css('display', 'none');
        jQuery('.new-nextbutton button.shownoneclass').prop('disabled', true);
        rem2remHint('', true);
    }

    function isNumber(evt) {
        var iKeyCode = (evt.which) ? evt.which : evt.keyCode
        if (iKeyCode != 45 && iKeyCode > 31 && (iKeyCode < 48 || iKeyCode > 57))
            return false;
        return true;
    }

    function convertNumberToWords(amount) {
        var words = new Array();
        words[0] = '';
        words[1] = 'One';
        words[2] = 'Two';
        words[3] = 'Three';
        words[4] = 'Four';
        words[5] = 'Five';
        words[6] = 'Six';
        words[7] = 'Seven';
        words[8] = 'Eight';
        words[9] = 'Nine';
        words[10] = 'Ten';
        words[11] = 'Eleven';
        words[12] = 'Twelve';
        words[13] = 'Thirteen';
        words[14] = 'Fourteen';
        words[15] = 'Fifteen';
        words[16] = 'Sixteen';
        words[17] = 'Seventeen';
        words[18] = 'Eighteen';
        words[19] = 'Nineteen';
        words[20] = 'Twenty';
        words[30] = 'Thirty';
        words[40] = 'Forty';
        words[50] = 'Fifty';
        words[60] = 'Sixty';
        words[70] = 'Seventy';
        words[80] = 'Eighty';
        words[90] = 'Ninety';
        amount = amount.toString();
        var atemp = amount.split(".");
        var number = atemp[0].split(",").join("");
        var n_length = number.length;
        var words_string = "";
        if (typeof number === 'string') {
            number = parseInt(number, 10);
        }
        if (typeof number === 'number' && isFinite(number)) {
            number = number.toString(10);
        } else {
            return words_string = '';
        }
        if (n_length <= 9) {
            var n_array = new Array(0, 0, 0, 0, 0, 0, 0, 0, 0);
            var received_n_array = new Array();
            for (var i = 0; i < n_length; i++) {
                received_n_array[i] = number.substr(i, 1);
            }
            for (var i = 9 - n_length, j = 0; i < 9; i++, j++) {
                n_array[i] = received_n_array[j];
            }
            for (var i = 0, j = 1; i < 9; i++, j++) {
                if (i == 0 || i == 2 || i == 4 || i == 7) {
                    if (n_array[i] == 1) {
                        n_array[j] = 10 + parseInt(n_array[j]);
                        n_array[i] = 0;
                    }
                }
            }
            value = "";
            for (var i = 0; i < 9; i++) {
                if (i == 0 || i == 2 || i == 4 || i == 7) {
                    value = n_array[i] * 10;
                } else {
                    value = n_array[i];
                }
                if (value != 0) {
                    words_string += words[value] + " ";
                }
                if ((i == 1 && value != 0) || (i == 0 && value != 0 && n_array[i + 1] == 0)) {
                    words_string += "Crores ";
                }
                if ((i == 3 && value != 0) || (i == 2 && value != 0 && n_array[i + 1] == 0)) {
                    words_string += "Lakhs ";
                }
                if ((i == 5 && value != 0) || (i == 4 && value != 0 && n_array[i + 1] == 0)) {
                    words_string += "Thousand ";
                }
                if (i == 6 && value != 0 && (n_array[i + 1] != 0 && n_array[i + 2] != 0)) {
                    words_string += "Hundred and ";
                } else if (i == 6 && value != 0) {
                    words_string += "Hundred ";
                }
            }
            words_string = words_string.split("  ").join(" ");
        }
        return words_string;
    }

    function initRetailerRem2RemSelect2() {
        var $scope = jQuery('.saas-retailer-rem2rem-page');
        $scope.find('#RetailerID').each(function () {
            var $el = jQuery(this);
            if (!$el.length || !jQuery.fn.select2) {
                return;
            }
            if ($el.hasClass('select2-hidden-accessible')) {
                try { $el.select2('destroy'); } catch (e) { }
            }
            var opts = {
                width: '100%',
                dropdownParent: jQuery(document.body),
                minimumResultsForSearch: 0,
                dropdownCssClass: 'vm-admin-select2-dropdown vm-admin-select2-searchable'
            };
            if (typeof window.forceAdminSelect2 === 'function') {
                window.forceAdminSelect2($el, opts, true);
            } else if (typeof window.applyAdminSelect2 === 'function') {
                window.applyAdminSelect2($el, opts, true);
            } else {
                $el.select2(opts);
            }
        });
    }

    function initRetailerRem2RemDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initRetailerRem2RemDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm(
                '#retailerRem2RemForm',
                '#retailer_rem2rem_frm_date',
                '#retailer_rem2rem_to_date',
                true
            );
        }
    }

    jQuery(function () {
        initRetailerRem2RemSelect2();
        initRetailerRem2RemDatepickers();
        window.setTimeout(initRetailerRem2RemDatepickers, 150);
        jQuery('#btnExportRetailerRem2Rem').on('click', function (e) {
            e.preventDefault();
            downloadRetailerRem2RemExcel();
        });
        jQuery('#btnPDFRetailerRem2Rem').on('click', function () {
            window.print();
        });
    });

    /* Server double-JSON string bhejta hai + keys chhote akshar me — sab sambhalo */
    function normRem2RemData(data) {
        if (typeof data === 'string') {
            data = jQuery.trim(data);
            if (data === '') { return null; }
            try { data = jQuery.parseJSON(data); } catch (e) { return null; }
            if (typeof data === 'string') {
                try { data = jQuery.parseJSON(data); } catch (e) { return null; }
            }
        }
        if (!data || typeof data !== 'object') { return null; }
        var get = function () {
            for (var i = 0; i < arguments.length; i++) {
                var want = (arguments[i] + '').toLowerCase();
                for (var p in data) {
                    if (data.hasOwnProperty(p) && (p + '').toLowerCase() === want && data[p] !== null && data[p] !== undefined && jQuery.trim(data[p] + '') !== '') {
                        return data[p];
                    }
                }
            }
            return '';
        };
        var info = {
            frm: get('frm_name', 'frmname', 'firmname', 'firm_name'),
            name: get('retailername', 'retailer_name', 'dealername', 'name'),
            email: get('email'),
            mobile: get('mobile', 'mobileno', 'mobile_no')
        };
        if (info.frm === '' && info.name === '' && info.email === '' && info.mobile === '') { return null; }
        return info;
    }

    function rem2remHint(msg, ok) {
        var $h = jQuery('#rem2remHint');
        $h.removeClass('ok err').html(msg || '');
        if (msg) { $h.addClass(ok ? 'ok' : 'err'); }
    }

    /* Retailer lookup : ek hi jagah se, blur + Next dono yahi use karenge */
    function checkRem2RemRetailer(mobemail, onOk, onFail) {
        mobemail = jQuery.trim(mobemail || '');
        if (mobemail === '') {
            rem2remLookupFail();
            if (typeof onFail === 'function') { onFail(); }
            return;
        }
        rem2remHint('Checking retailer…', true);
        jQuery.ajax({
            url: '@Url.Action("CheckRetailerEmailMobile")',
            type: 'GET',
            dataType: 'json',
            cache: false,
            data: { emailmobile: mobemail },
            success: function (data) {
                var info = normRem2RemData(data);
                if (info) {
                    jQuery('#retailerinform').show();
                    jQuery('#rem2remLookup').show();
                    jQuery('#lblfrmname').text(info.frm);
                    jQuery('#lblreatilername').text(info.name);
                    jQuery('#lblemail').text(info.email);
                    jQuery('#lblmobile').text(info.mobile);
                    jQuery('#submit').removeAttr('disabled');
                    jQuery('#RetailerId').removeClass('vm-rem2rem-input-error').attr('data-valid', '1');
                    rem2remHint('Retailer verified : ' + (info.name || info.email || info.mobile), true);
                    if (typeof onOk === 'function') { onOk(); }
                }
                else {
                    rem2remLookupFail('No retailer found for "' + mobemail + '".');
                    if (typeof onFail === 'function') { onFail(); }
                }
            },
            error: function () {
                rem2remLookupFail('Server se jawab nahi mila, dobara try karo.');
                if (typeof onFail === 'function') { onFail(); }
            }
        });
    }

    function rem2remLookupFail(msg) {
        jQuery('#retailerinform').hide();
        jQuery('#rem2remLookup').hide();
        jQuery('#submit').attr('disabled', 'disabled');
        jQuery('#RetailerId').attr('data-valid', '0');
        rem2remHint(msg || '', false);
    }

    /* Next : verify ho tabhi step-2 (Amount/Comment) khule */
    function goRem2RemNext() {
        var val = jQuery('#RetailerId').val();
        if (jQuery.trim(val || '') === '') {
            jQuery('#RetailerId').addClass('vm-rem2rem-input-error').focus();
            return;
        }
        checkRem2RemRetailer(val, function () {
            jQuery('.new-nextbutton').css('display', 'none');
            jQuery('.saas-retailer-rem2rem-page .vm-rem2rem-form-grid .noneandshow').css('display', 'block');
            jQuery('#txtbal').focus();
        }, function () {
            jQuery('#RetailerId').addClass('vm-rem2rem-input-error').focus();
        });
    }

    jQuery('#RetailerId').on('blur', function () {
        checkRem2RemRetailer(jQuery(this).val());
    });

    jQuery(function () {
        var succ = '@ViewData["success"]';
        var error = '@ViewData["error"]';
        if (succ != null && succ != '') {
            swal('Good job!', succ, 'success');
        }
        if (error != null && error != '') {
            swal('Oops!', error, 'error');
        }
    });

    jQuery('.shownoneclass').on('click', function () {
        goRem2RemNext();
    });

    jQuery(function () {
        jQuery('.new-nextbutton button.shownoneclass').prop('disabled', true);
        /* input event : typing + paste dono pakdega */
        jQuery('.vm-rem2rem-form-grid input#RetailerId').on('input', function () {
            var has = jQuery.trim(jQuery(this).val() || '') !== '';
            jQuery(this).removeClass('vm-rem2rem-input-error').attr('data-valid', '0');
            jQuery('.new-nextbutton button.shownoneclass').prop('disabled', !has);
            rem2remHint('', true);
            if (!has) { rem2remLookupFail(); }
        });
        /* Enter dabane par bhi Next jaisa kaam kare */
        jQuery('.vm-rem2rem-form-grid input#RetailerId').on('keydown', function (e) {
            if (e.which === 13) {
                e.preventDefault();
                goRem2RemNext();
            }
        });
    });
</script>
}
