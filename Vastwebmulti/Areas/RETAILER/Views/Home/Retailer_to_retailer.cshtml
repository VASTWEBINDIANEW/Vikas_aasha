<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-retailer-ecomm-transaction-page saas-retailer-rem2rem-page">

    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

            <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line">

                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home", new { area = "RETAILER" })"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>Reports</li>
                    <li>Fund Transfer To Retailer</li>
                </ol>

            </div>

        </div>

        <div class="vm-opr-main-card vm-rem2rem-transfer-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-exchange-alt" aria-hidden="true"></i>
                        <span>Fund transfer to retailer <i class="fa fa-exchange" aria-hidden="true"></i> retailer</span>
                    </div>
                </div>

                @using (Html.BeginForm("rem_rem_fund_transfer", "Home", FormMethod.Post))
                {
                    <div class="vm-rem2rem-form-grid">
                        <div class="vm-opr-field vm-dmt-field">
                            <input class="vm-opr-select vm-dmt-select form-control" id="RetailerId" name="RetailerId" placeholder="User Email / Mobile No" minlength="6" required="required" type="text" autocomplete="off" />
                        </div>
                        <div class="vm-rem2rem-hint" id="rem2remHint"></div>
                        <div class="vm-opr-field vm-dmt-field noneandshow" style="display:none;">
                            @Html.TextBox("txtbal", "", new { @class = "vm-opr-select vm-dmt-select form-control", placeholder = "Enter Amount", required = "required", @onkeyup = "rem2remWordShow(this)", onkeypress = "return isNumber(event)", autocomplete = "off" })
                        </div>
                        <div class="vm-opr-field vm-dmt-field noneandshow" style="display:none;">
                            <textarea id="comment" name="comment" class="vm-opr-select vm-dmt-select form-control" placeholder="Enter Comment"></textarea>
                        </div>
                        <div class="vm-rem2rem-words" id="rem2remWords">
                            <span id="word"></span>
                        </div>
                        <div class="vm-rem2rem-lookup" id="rem2remLookup" style="display:none;">
                            <div class="row" id="retailerinform" style="display:none;">
                                <div class="nameshow">
                                    <table border="1">
                                        <tr>
                                            <td><label>Firm Name :</label></td>
                                            <td><label id="lblfrmname"></label></td>
                                        </tr>
                                        <tr>
                                            <td><label>Retailer Name:&nbsp;</label></td>
                                            <td><label id="lblreatilername"></label></td>
                                        </tr>
                                        <tr>
                                            <td><label>Email:&nbsp;</label></td>
                                            <td><label id="lblemail"></label></td>
                                        </tr>
                                        <tr>
                                            <td><label>Mobile:&nbsp;</label> </td>
                                            <td><label id="lblmobile"></label></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                        <div class="vm-rem2rem-actions">
                            <div class="new-nextbutton">
                                <button type="button" class="saas-acc-btn" onclick="resetRem2RemForm()">Cancel</button>
                                <button type="button" class="saas-acc-btn saas-acc-btn--search shownoneclass" disabled="disabled">Next</button>
                            </div>
                            <div class="noneandshow" style="display:none;">
                                <button type="button" class="saas-acc-btn" onclick="resetRem2RemForm()">Cancel</button>
                                <button type="submit" id="submit" class="saas-acc-btn saas-acc-btn--search">
                                    <i class="fa fa-exchange" aria-hidden="true"></i>
                                    <span>Transfer</span>
                                </button>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        @{
            var remFormAttrs = new Dictionary<string, object>
            {
