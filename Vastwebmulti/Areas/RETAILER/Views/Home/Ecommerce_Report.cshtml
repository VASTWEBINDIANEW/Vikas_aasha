@model List<Vastwebmulti.Models.Show_Ecommerce_Retailer_Report_Result>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Ecommerce Report";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
    var reports = Model ?? new List<Vastwebmulti.Models.Show_Ecommerce_Retailer_Report_Result>();
    var rowCount = reports.Count;

    decimal totalSuccess = ViewData["totalsuccess"] != null ? Convert.ToDecimal(ViewData["totalsuccess"]) : 0m;
    decimal totalFailed = ViewData["totalfailed"] != null ? Convert.ToDecimal(ViewData["totalfailed"]) : 0m;
    decimal totalPending = ViewData["totalpending"] != null ? Convert.ToDecimal(ViewData["totalpending"]) : 0m;
    decimal totalAmount = totalSuccess + totalFailed + totalPending;
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=43" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=22" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-retailer-ecomm-transaction-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var ecomFormAttrs = new Dictionary<string, object>
            {
                { "id", "retailerEcomReportForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-report-date-form", "" },
                { "data-report-from", "#retailer_ecomrep_frm_date" },
                { "data-report-to", "#retailer_ecomrep_to_date" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("Ecommerce_Report", "Home", FormMethod.Post, ecomFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home", new { area = "RETAILER" })"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Reports</li>
                        <li>Ecommerce Report</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters vm-ecomm-filter-row--one-line">

                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("ddl_status", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "All status", Value = "ALL" },
                                new SelectListItem { Text = "Success", Value = "SUCCESS" },
                                new SelectListItem { Text = "Pending", Value = "PENDING" },
                                new SelectListItem { Text = "Rejected", Value = "FAILED" }
                            }, new { @id = "ddl_status", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("category", ViewBag.category as SelectList, "ALL Category", new { id = "category", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_ecomrep_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_ecomrep_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="retailerEcomRepTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Ecommerce totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideRetailerEcomRepTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--primary">
                            <span class="vm-opr-total-card__label">Total amount</span>
                            <strong class="vm-opr-total-card__value">@totalAmount.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Success</span>
                            <strong class="vm-opr-total-card__value">@totalSuccess.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Rejected</span>
                            <strong class="vm-opr-total-card__value">@totalFailed.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Pending</span>
                            <strong class="vm-opr-total-card__value">@totalPending.ToString("N2")</strong>
                        </div>
                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-shopping-bag" aria-hidden="true"></i>
                        <span>Ecommerce report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong>@rowCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total" title="Total amount for current filter">
                            Total: <strong>&#8377; @totalAmount.ToString("N2")</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-ecomm-totals-btn" onclick="showRetailerEcomRepTotals()" title="Show totals" aria-expanded="false" aria-controls="retailerEcomRepTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnExportRetailerEcomRep" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDFRetailerEcomRep" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="retailerEcommTransactionReport" class="table vm-opr-data-table vm-retailer-ecomm-txn-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Sr&nbsp;no.</th>
                                    <th>Vendor&nbsp;name</th>
                                    <th>Product&nbsp;name</th>
                                    <th>List&nbsp;price&nbsp;&#8377;</th>
                                    <th>Price&nbsp;&#8377;</th>
                                    <th>Qty</th>
                                    <th>Amount&nbsp;&#8377;</th>
                                    <th>OTP</th>
                                    <th>Status</th>
                                    <th>Order&nbsp;date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (reports.Count > 0)
                                {
                                    var sr = 1;
                                    foreach (var item in reports)
                                    {
                                        var sts = "Pending";
                                        var tone = "pending";
                                        var fa = "fa-clock-o";
                                        if (item.AdminStatus == 2)
                                        {
                                            sts = "Success";
                                            tone = "success";
                                            fa = "fa-check";
                                        }
                                        else if (item.AdminStatus == 3)
                                        {
                                            sts = "Rejected";
                                            tone = "failed";
                                            fa = "fa-times";
                                        }
                                        <tr class="vm-dmt-row">
                                            <td class="vm-dmt-sr-cell">@sr</td>
                                            <td>
                                                <span class="vm-dmt-consumer-text">@item.Name</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-refno-text">@item.ProductName</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(item.ListPrice, 2)</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(item.StandardPrice, 2)</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-refno-text">@item.QTY</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(item.Amount, 2)</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-refno-text">@item.DOTP</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-status vm-dmt-status--@tone" title="@sts"><i class="fa @fa" aria-hidden="true"></i></span>
                                            </td>
                                            <td class="vm-ticket-time-cell">
                                                <span class="vm-dmt-refno-text">@(item.OrderDate.HasValue ? String.Format("{0:dd-MMM-yyyy HH:mm:ss}", item.OrderDate.Value) : "—")</span>
                                            </td>
                                        </tr>
                                        sr++;
                                    }
                                }
                                else
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="10" class="vm-opr-table-empty vm-dmt-table-empty">
                                            <i class="fas fa-shopping-bag" aria-hidden="true"></i>
                                            <span>No ecommerce records found.</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section PostVmScripts {
    <script>
        function hideRetailerEcomRepTotals() {
            var $panel = jQuery('#retailerEcomRepTotalsPanel');
            var $btn = jQuery('.saas-retailer-ecomm-transaction-page .vm-ecomm-totals-btn');
            $panel.hide().attr('aria-hidden', 'true');
            $btn.attr('aria-expanded', 'false');
        }

        function showRetailerEcomRepTotals() {
            var $panel = jQuery('#retailerEcomRepTotalsPanel');
            var $btn = jQuery('.saas-retailer-ecomm-transaction-page .vm-ecomm-totals-btn');
            if ($panel.is(':visible')) {
                hideRetailerEcomRepTotals();
                return;
            }
            $panel.show().attr('aria-hidden', 'false');
            $btn.attr('aria-expanded', 'true');
        }

        function retailerEcomRepFilters() {
            return {
                category: jQuery('#category').val() || '',
                ddl_status: jQuery('#ddl_status').val() || 'ALL',
                txt_frm_date: jQuery('#retailer_ecomrep_frm_date').val() || '',
                txt_to_date: jQuery('#retailer_ecomrep_to_date').val() || ''
            };
        }

        function exportRetailerEcomRepTable(type) {
            if (type === 'excel') {
                var f = retailerEcomRepFilters();
                location.href = '@Url.Action("Excel_Ecommerce_Report", "Home")?category=' + encodeURIComponent(f.category) + '&ddl_status=' + encodeURIComponent(f.ddl_status) + '&txt_frm_date=' + encodeURIComponent(f.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(f.txt_to_date);
                return;
            }
            var table = document.getElementById('retailerEcommTransactionReport');
            if (!table) {
                return;
            }
            var title = 'Ecommerce Report';
            var clone = table.cloneNode(true);
            if (clone.querySelector('.vm-opr-table-empty-row')) {
                alert('No data available to export.');
                return;
            }
            var printWin = window.open('', '_blank');
            if (!printWin) {
                alert('Please allow pop-ups to export PDF.');
                return;
            }
            printWin.document.write(
                '<html><head><title>' + title + '</title>'
                + '<style>body{font-family:Arial,sans-serif;padding:16px}h3{margin:0 0 12px}table{border-collapse:collapse;width:100%;font-size:10px}th,td{border:1px solid #ccc;padding:4px;text-align:left}th{background:#f3f4f6}</style>'
                + '</head><body><h3>' + title + '</h3>' + clone.outerHTML + '</body></html>'
            );
            printWin.document.close();
            printWin.focus();
            printWin.print();
        }

        function initRetailerEcomRepSelect2() {
            var $scope = jQuery('.saas-retailer-ecomm-transaction-page');
            $scope.find('#category, #ddl_status').each(function () {
                var $el = jQuery(this);
                if (!$el.length || !jQuery.fn.select2) {
                    return;
                }
                if ($el.hasClass('select2-hidden-accessible')) {
                    try { $el.select2('destroy'); } catch (e) { }
                }
                var opts = {
                    width: '100%',
                    dropdownParent: jQuery(document.body),
                    minimumResultsForSearch: 0,
                    dropdownCssClass: 'vm-admin-select2-dropdown vm-admin-select2-searchable'
                };
                if (typeof window.forceAdminSelect2 === 'function') {
                    window.forceAdminSelect2($el, opts, true);
                } else if (typeof window.applyAdminSelect2 === 'function') {
                    window.applyAdminSelect2($el, opts, true);
                } else {
                    $el.select2(opts);
                }
            });
        }

        function initRetailerEcomRepDatepickers() {
            if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
                window.setTimeout(initRetailerEcomRepDatepickers, 50);
                return;
            }
            if (typeof window.initAdminReportDateForm === 'function') {
                window.initAdminReportDateForm(
                    '#retailerEcomReportForm',
                    '#retailer_ecomrep_frm_date',
                    '#retailer_ecomrep_to_date',
                    true
                );
            }
        }

        jQuery(function () {
            initRetailerEcomRepSelect2();
            initRetailerEcomRepDatepickers();
            window.setTimeout(initRetailerEcomRepDatepickers, 150);
            jQuery('#btnExportRetailerEcomRep').on('click', function () {
                exportRetailerEcomRepTable('excel');
            });
            jQuery('#btnPDFRetailerEcomRep').on('click', function () {
                exportRetailerEcomRepTable('pdf');
            });
        });
    </script>
}
