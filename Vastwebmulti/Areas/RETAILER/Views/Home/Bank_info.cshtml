@model Vastwebmulti.Areas.RETAILER.Models.BankInfo
@using System.Linq
@{
    ViewBag.Title = "Bank_info";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";
    Func<object, string> bankVal = v => (v == null || Convert.ToString(v).Trim() == "") ? "—" : Convert.ToString(v).Trim();
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=15" rel="stylesheet" />
<link href="~/MainFrontDesign/css/dealer-dth-booking-report-modern.css?v=48" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<style>
    /* Retailer Bank & Cash — Credit report wali design language (own scope, always wins) */
    .saas-retailer-bankinfo-page .vm-bank-section { margin: 0 0 16px !important; }
    .saas-retailer-bankinfo-page .vm-bank-section:last-child { margin-bottom: 0 !important; }
    .saas-retailer-bankinfo-page .vm-bank-sectitle { display: flex !important; align-items: center !important; gap: 10px !important; margin: 0 0 12px !important; font-size: 15px !important; font-weight: 800 !important; color: #0f172a !important; }
    .saas-retailer-bankinfo-page .vm-bank-sectitle i { display: inline-flex !important; width: 34px !important; height: 34px !important; min-width: 34px !important; border-radius: 10px !important; background: linear-gradient(135deg,#eef2ff,#e0e7ff) !important; border: 1px solid #c7d2fe !important; color: #4f46e5 !important; align-items: center !important; justify-content: center !important; font-size: 14px !important; }
    .saas-retailer-bankinfo-page .vm-bank-grid { display: grid !important; grid-template-columns: repeat(2, minmax(0, 1fr)) !important; gap: 16px !important; align-items: start !important; margin: 0 0 16px !important; padding: 0 !important; }
    .saas-retailer-bankinfo-page .vm-bank-card { min-width: 0 !important; margin: 0 !important; border: 1px solid #e5e9f2 !important; border-radius: 18px !important; overflow: hidden !important; background: #fff !important; box-shadow: 0 8px 24px rgba(15,23,42,.07) !important; transition: transform .16s ease, box-shadow .16s ease !important; }
    .saas-retailer-bankinfo-page .vm-bank-card:hover { transform: translateY(-2px) !important; box-shadow: 0 14px 32px rgba(15,23,42,.12) !important; }
    .saas-retailer-bankinfo-page .vm-bank-card__head { background: #fff !important; border: none !important; border-bottom: 1.5px solid #eef1f6 !important; padding: 14px 16px !important; display: flex !important; align-items: center !important; gap: 12px !important; }
    .saas-retailer-bankinfo-page .vm-bank-card__head i { display: inline-flex !important; width: 36px !important; height: 36px !important; min-width: 36px !important; border-radius: 11px !important; background: linear-gradient(135deg,#eef2ff,#e0e7ff) !important; border: 1px solid #c7d2fe !important; color: #4f46e5 !important; align-items: center !important; justify-content: center !important; font-size: 15px !important; }
    .saas-retailer-bankinfo-page .vm-bank-card__head span { color: #0f172a !important; font-size: 16px !important; font-weight: 800 !important; line-height: 1.3 !important; }
    .saas-retailer-bankinfo-page .vm-bank-card__body { padding: 12px 16px 14px !important; }
    .saas-retailer-bankinfo-page .vm-bank-charge { display: flex !important; align-items: center !important; justify-content: space-between !important; gap: 10px !important; padding: 12px 14px !important; border-radius: 13px !important; background: linear-gradient(135deg,#4f46e5,#7c3aed) !important; color: #fff !important; box-shadow: 0 8px 18px rgba(99,102,241,.35) !important; }
    .saas-retailer-bankinfo-page .vm-bank-charge__label { font-size: 11px !important; font-weight: 800 !important; text-transform: uppercase !important; letter-spacing: .6px !important; opacity: .9 !important; }
    .saas-retailer-bankinfo-page .vm-bank-charge__value { font-size: 19px !important; font-weight: 800 !important; white-space: nowrap !important; }
    /* Tables */
    .saas-retailer-bankinfo-page .vm-bank-tablecard { border: 1px solid #e5e9f2 !important; border-radius: 18px !important; overflow: hidden !important; background: #fff !important; box-shadow: 0 8px 24px rgba(15,23,42,.07) !important; margin: 0 0 16px !important; }
    .saas-retailer-bankinfo-page .vm-bank-tablecard:last-child { margin-bottom: 0 !important; }
    .saas-retailer-bankinfo-page .vm-bank-tablecard__head { background: #fff !important; border-bottom: 1.5px solid #eef1f6 !important; padding: 14px 16px !important; display: flex !important; align-items: center !important; gap: 12px !important; }
    .saas-retailer-bankinfo-page .vm-bank-tablecard__head i { display: inline-flex !important; width: 36px !important; height: 36px !important; min-width: 36px !important; border-radius: 11px !important; background: linear-gradient(135deg,#eef2ff,#e0e7ff) !important; border: 1px solid #c7d2fe !important; color: #4f46e5 !important; align-items: center !important; justify-content: center !important; font-size: 15px !important; }
    .saas-retailer-bankinfo-page .vm-bank-tablecard__head span { color: #0f172a !important; font-size: 16px !important; font-weight: 800 !important; }
    .saas-retailer-bankinfo-page .vm-bank-tablescroll { overflow-x: auto !important; padding: 6px 16px 14px !important; }
    .saas-retailer-bankinfo-page table.vm-bank-table { width: 100% !important; min-width: 640px !important; border-collapse: collapse !important; margin: 0 !important; font-size: 13px !important; }
    .saas-retailer-bankinfo-page table.vm-bank-table thead th { background: #f1f5f9 !important; color: #475569 !important; font-size: 10.5px !important; font-weight: 800 !important; text-transform: uppercase !important; letter-spacing: .5px !important; padding: 9px 10px !important; text-align: left !important; border: none !important; white-space: nowrap !important; }
    .saas-retailer-bankinfo-page table.vm-bank-table thead th:first-child { border-radius: 10px 0 0 10px !important; }
    .saas-retailer-bankinfo-page table.vm-bank-table thead th:last-child { border-radius: 0 10px 10px 0 !important; }
    .saas-retailer-bankinfo-page table.vm-bank-table tbody td { padding: 10px !important; border: none !important; border-bottom: 1px dashed #e5e9f2 !important; color: #0f172a !important; font-weight: 600 !important; vertical-align: middle !important; }
    .saas-retailer-bankinfo-page table.vm-bank-table tbody tr:last-child td { border-bottom: none !important; }
    .saas-retailer-bankinfo-page table.vm-bank-table tbody tr:hover td { background: #f8fafc !important; }
    .saas-retailer-bankinfo-page table.vm-bank-table td.vm-bank-mono { font-family: Consolas,'Courier New',monospace !important; font-size: 12.5px !important; }
    .saas-retailer-bankinfo-page .vm-bank-empty { padding: 20px 10px !important; text-align: center !important; color: #94a3b8 !important; font-weight: 700 !important; font-size: 13px !important; }
    @@media screen and (max-width:900px) {
        .saas-retailer-bankinfo-page .vm-bank-grid { grid-template-columns: 1fr !important; }
    }
</style>
<script>document.body.classList.add('saas-sell-rch-dp-page', 'saas-dealer-notification-page', 'saas-retailer-bankinfo-page');</script>

<section class="content saas-admin-account-page saas-admin-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-dth-booking-report-page saas-dealer-retailer-index-page saas-dealer-notification-page saas-retailer-bankinfo-page">

    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">
            <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-dr-rem-toolbar-top">
                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>Pages</li>
                    <li>Bank &amp; Cash</li>
                </ol>
            </div>
        </div>

        <div class="vm-bank-section">
            <h2 class="vm-bank-sectitle"><i class="fas fa-landmark" aria-hidden="true"></i>Company Bank Information &amp; Cash Deposit Charges</h2>
            <div class="vm-bank-grid">
                <div class="vm-bank-card">
                    <div class="vm-bank-card__head"><i class="fas fa-money-bill-wave" aria-hidden="true"></i><span>Branch / CMS Cash Deposit</span></div>
                    <div class="vm-bank-card__body">
                        <div class="vm-bank-charge"><span class="vm-bank-charge__label">Charges (in %)</span><span class="vm-bank-charge__value">@bankVal(ViewBag.admincash) %</span></div>
                    </div>
                </div>
                <div class="vm-bank-card">
                    <div class="vm-bank-card__head"><i class="fas fa-hand-holding-usd" aria-hidden="true"></i><span>Credit Fund Charge</span></div>
                    <div class="vm-bank-card__body">
                        <div class="vm-bank-charge"><span class="vm-bank-charge__label">Charges (in %)</span><span class="vm-bank-charge__value">@bankVal(ViewBag.admincredit) %</span></div>
                    </div>
                </div>
            </div>
            <div class="vm-bank-tablecard">
                <div class="vm-bank-tablecard__head"><i class="fas fa-university" aria-hidden="true"></i><span>Company Accounts</span></div>
                <div class="vm-bank-tablescroll">
                    @if (Model != null && Model.adminbank != null && Model.adminbank.Any())
                    {
                        <table class="vm-bank-table">
                            <thead>
                                <tr><th>Bank Name</th><th>IFSC Code</th><th>Account Number</th><th>Account Type</th><th>Account Holder Name</th><th>Branch Address</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.adminbank)
                                {
                                    <tr>
                                        <td><strong>@bankVal(item.banknm)</strong></td>
                                        <td class="vm-bank-mono">@bankVal(item.ifsccode)</td>
                                        <td class="vm-bank-mono">@bankVal(item.acno)</td>
                                        <td>@bankVal(item.actype)</td>
                                        <td>@bankVal(item.holdername)</td>
                                        <td>@bankVal(item.address)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="vm-bank-empty">No company accounts found.</div>
                    }
                </div>
            </div>
            <div class="vm-bank-tablecard">
                <div class="vm-bank-tablecard__head"><i class="fas fa-wallet" aria-hidden="true"></i><span>Company Wallets</span></div>
                <div class="vm-bank-tablescroll">
                    @if (Model != null && Model.Walletinfoadmin != null && Model.Walletinfoadmin.Any())
                    {
                        <table class="vm-bank-table">
                            <thead>
                                <tr><th>Wallet Name</th><th>Wallet Number</th><th>Wallet Holder</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Walletinfoadmin)
                                {
                                    <tr>
                                        <td><strong>@bankVal(item.walletname)</strong></td>
                                        <td class="vm-bank-mono">@bankVal(item.walletno)</td>
                                        <td>@bankVal(item.walletholdername)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="vm-bank-empty">No company wallets found.</div>
                    }
                </div>
            </div>
        </div>

        <div class="vm-bank-section">
            <h2 class="vm-bank-sectitle"><i class="fas fa-user-tie" aria-hidden="true"></i>Distributor Accounts Information &amp; Cash Deposit Charges</h2>
            <div class="vm-bank-grid">
                <div class="vm-bank-card">
                    <div class="vm-bank-card__head"><i class="fas fa-money-bill-wave" aria-hidden="true"></i><span>Branch Cash Deposit</span></div>
                    <div class="vm-bank-card__body">
                        <div class="vm-bank-charge"><span class="vm-bank-charge__label">Charges (in %)</span><span class="vm-bank-charge__value">@bankVal(ViewBag.dealercash) %</span></div>
                    </div>
                </div>
                <div class="vm-bank-card">
                    <div class="vm-bank-card__head"><i class="fas fa-hand-holding-usd" aria-hidden="true"></i><span>Credit Fund Charge</span></div>
                    <div class="vm-bank-card__body">
                        <div class="vm-bank-charge"><span class="vm-bank-charge__label">Charges (in %)</span><span class="vm-bank-charge__value">@bankVal(ViewBag.dealercredit) %</span></div>
                    </div>
                </div>
            </div>
            <div class="vm-bank-tablecard">
                <div class="vm-bank-tablecard__head"><i class="fas fa-university" aria-hidden="true"></i><span>Distributor Accounts</span></div>
                <div class="vm-bank-tablescroll">
                    @if (Model != null && Model.Dealerbank != null && Model.Dealerbank.Any())
                    {
                        <table class="vm-bank-table">
                            <thead>
                                <tr><th>Bank Name</th><th>IFSC Code</th><th>Account Number</th><th>Account Type</th><th>Account Holder Name</th><th>Branch Address</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Dealerbank)
                                {
                                    <tr>
                                        <td><strong>@bankVal(item.banknm)</strong></td>
                                        <td class="vm-bank-mono">@bankVal(item.ifsccode)</td>
                                        <td class="vm-bank-mono">@bankVal(item.acno)</td>
                                        <td>@bankVal(item.actype)</td>
                                        <td>@bankVal(item.holdername)</td>
                                        <td>@bankVal(item.address)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="vm-bank-empty">No distributor accounts found.</div>
                    }
                </div>
            </div>
            <div class="vm-bank-tablecard">
                <div class="vm-bank-tablecard__head"><i class="fas fa-wallet" aria-hidden="true"></i><span>Distributor Wallets</span></div>
                <div class="vm-bank-tablescroll">
                    @if (Model != null && Model.Walletinfodealer != null && Model.Walletinfodealer.Any())
                    {
                        <table class="vm-bank-table">
                            <thead>
                                <tr><th>Wallet Name</th><th>Wallet Number</th><th>Wallet Holder</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Walletinfodealer)
                                {
                                    <tr>
                                        <td><strong>@bankVal(item.walletname)</strong></td>
                                        <td class="vm-bank-mono">@bankVal(item.walletno)</td>
                                        <td>@bankVal(item.walletholdername)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="vm-bank-empty">No distributor wallets found.</div>
                    }
                </div>
            </div>
        </div>

    </div>
</section>
