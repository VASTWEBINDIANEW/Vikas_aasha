@model List<Vastwebmulti.Models.prepaid_card_Transaction>
@{
    ViewBag.Title = "ALL_CARDS";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";
}
<link href="~/MainFrontDesign/css/retailer-money-transfer-modern.css?v=45" rel="stylesheet" />
<link href="~/MainFrontDesign/css/retailer-all-cards-modern.css?v=7" rel="stylesheet" />
<link href="~/AdminDesign/giftcardslider/giftcard.css" rel="stylesheet" />

<section class="vm-rmt-page vm-all-cards-page content is-gift">

    <div class="vm-all-cards-shell">
        <ul id="myDIV1" class="vm-rmt-service-tabs vm-all-cards-top-tabs" role="tablist" aria-label="Cards services">
            <li class="allc vm-rmt-tab-item active_box current" role="tab" aria-selected="true" tabindex="0" data-cards-panel="gift">
                <a href="javascript:void(0);">
                    <img src="~/ashok-images/gift.svg" alt="" />
                    <span>Gift card</span>
                </a>
            </li>
            <li class="allc vm-rmt-tab-item" role="tab" aria-selected="false" tabindex="0" data-cards-panel="prepaid">
                <a href="javascript:void(0);">
                    <img src="~/ashok-images/prepaid-card_2040836.png" alt="" />
                    <span>Prepaid card</span>
                </a>
            </li>
        </ul>

        <div class="giftcardss vm-all-cards-panel vm-all-cards-panel--gift">
            @{ ViewBag.GiftCardEmbed = true; }
            @Html.Partial("Gift_Card")
        </div>

        <div class="PREPAIDCARD vm-all-cards-panel vm-all-cards-panel--prepaid">
            <div id="full" class="vm-rmt-left-panel vm-all-cards-prepaid-buy">
                <div class="vm-all-cards-prepaid-card page-header-third">
                    <div id="image">
                        <img src="~/ashok-images/1_CsJ05WEGfunYMLGfsT2sXA.gif" alt="Loading" />
                    </div>
                    <h2 class="vm-all-cards-prepaid-card__title">Prepaid card</h2>
                    <p class="vm-all-cards-prepaid-card__hint">Enter quantity and amount per card (₹100 – ₹10,000).</p>

                    @using (Ajax.BeginForm("ALL_CARDS", "Home", null, new AjaxOptions
                    {
                        HttpMethod = "POST",
                        OnSuccess = "SuccessMessage",
                        OnFailure = "FailMessage",
                        UpdateTargetId = "resultTarget",
                        LoadingElementId = "image"
                    }, new { id = "MyNewNameId", @class = "vm-all-cards-prepaid-form" }))
                    {
                        <div class="vm-all-cards-field">
                            <label for="vmPrepaidQty">Quantity</label>
                            <input type="number" id="vmPrepaidQty" name="quantity" min="1" placeholder="Enter quantity of cards" autocomplete="off" />
                        </div>
                        <div class="vm-all-cards-field">
                            <label for="vmPrepaidAmt">Amount per card</label>
                            <input type="number" id="vmPrepaidAmt" name="rupees" min="100" max="10000" placeholder="Enter amount per card" autocomplete="off" />
                        </div>
                        <button type="submit" class="vm-all-cards-buy-btn" value="submit">Buy prepaid cards</button>
                    }
                </div>
                <div id="loader" style="display:none">
                    <img src="~/ashok-images/atm-admin.png" alt="" />
                </div>
            </div>

            <div class="vm-rmt-report-panel loader-pagefull">
                <div class="vm-rmt-report-shell">
                    <div id="reportallinone" class="vm-all-cards-report-card">
                        <div id="resultTarget">
                            @Html.Partial("_ALL_CARDS", Model)
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>
<script>
    function vmAllCardsSwitchPanel(panel) {
        var $page = $('section.vm-all-cards-page');
        var isPrepaid = panel === 'prepaid';
        $page.toggleClass('is-prepaid', isPrepaid).toggleClass('is-gift', !isPrepaid);

        var $tabs = $page.find('#myDIV1 > li.allc');
        $tabs.removeClass('active_box current').attr('aria-selected', 'false');
        $tabs.filter('[data-cards-panel="' + panel + '"]').addClass('active_box current').attr('aria-selected', 'true');

        if (isPrepaid) {
            $page.find('.giftcardss').hide();
            $page.find('.PREPAIDCARD').show();
        } else {
            $page.find('.PREPAIDCARD').hide();
            $page.find('.giftcardss').show();
        }
    }

    function makeActive() {
        vmAllCardsSwitchPanel('gift');
    }

    function makeActive1() {
        vmAllCardsSwitchPanel('prepaid');
    }

    function craft1() {
        $('.timer_off').addClass('is-visible').show();
    }

    function SuccessMessage() {
        $('#image').hide();
        $('.timer_off').addClass('is-visible').show();
    }

    function FailMessage() {
        $('#image').hide();
        if (typeof swal === 'function') {
            swal('Oops', 'Request failed. Please try again.', 'error');
        } else {
            alert('Request failed. Please try again.');
        }
    }

    $(function () {
        $('body').addClass('vm-all-cards-active');
        vmAllCardsSwitchPanel('gift');

        $('#defaultModal, #CheckbalModal').removeClass('in show').attr('aria-hidden', 'true').css('display', 'none');
        $('.modal-backdrop').remove();

        $(document).off('click.vmAllCardsTabs keydown.vmAllCardsTabs', 'section.vm-all-cards-page #myDIV1 > li.allc');
        $(document).on('click.vmAllCardsTabs', 'section.vm-all-cards-page #myDIV1 > li.allc', function (e) {
            e.preventDefault();
            vmAllCardsSwitchPanel($(this).attr('data-cards-panel') || 'gift');
        });
        $(document).on('keydown.vmAllCardsTabs', 'section.vm-all-cards-page #myDIV1 > li.allc', function (e) {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                vmAllCardsSwitchPanel($(this).attr('data-cards-panel') || 'gift');
            }
        });

        /* Keep gift purchase modals on body stack when opened */
        $(document).off('show.bs.modal.vmAllCards hidden.bs.modal.vmAllCards', '#defaultModal, #CheckbalModal');
        $(document).on('show.bs.modal.vmAllCards', '#defaultModal', function () {
            if (typeof vmGiftEnsureModalOnBody === 'function') {
                vmGiftEnsureModalOnBody('#defaultModal');
            } else if (!$(this).parent().is('body')) {
                $(this).appendTo('body');
            }
            $('#CheckbalModal').modal('hide');
        });
        $(document).on('show.bs.modal.vmAllCards', '#CheckbalModal', function () {
            if (typeof vmGiftEnsureModalOnBody === 'function') {
                vmGiftEnsureModalOnBody('#CheckbalModal');
            } else if (!$(this).parent().is('body')) {
                $(this).appendTo('body');
            }
            $('#defaultModal').modal('hide');
        });
        $(document).on('hidden.bs.modal.vmAllCards', '#CheckbalModal, #defaultModal', function () {
            if ($('.modal.in:visible, .modal.show:visible').length === 0) {
                $('body').removeClass('modal-open');
                $('.modal-backdrop').remove();
            }
        });
    });
</script>
