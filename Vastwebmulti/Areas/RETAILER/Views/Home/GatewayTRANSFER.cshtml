<section class="content saas-admin-account-page saas-admin-report-page saas-fund-transfer-page saas-fund-transfer-premium saas-dealer-fund-transfer-page saas-retailer-fund-transfer-page saas-retailer-gateway-page">

    <div class="container-fluid vm-ft-page-shell">

        <div class="vm-ft-page-toolbar vm-ft-page-toolbar--premium">
            <div class="vm-ft-page-hero">
                <div>
                    <ol class="vm-ft-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Report's</li>
                        <li>Gateway Transfer</li>
                    </ol>
                </div>
            </div>
            <div class="vm-ft-search-wrap">
                <input class="form-control" type="text" value="" id="myInput" name="myInput" placeholder="Search by mode, amount, RRN..." autocomplete="off" onkeyup="myFunction()" />
            </div>
        </div>

        <div class="vm-ft-layout-wrap">
        <div class="vm-ft-layout vm-ft-layout--full">
            <div class="vm-ft-form-col">
                <div class="fund-trasfer-left vm-ft-form-card">
                    <div class="vm-ft-form-card-header">
                        <div class="vm-ft-form-card-header__icon" aria-hidden="true">
                            <i class="fas fa-credit-card"></i>
                        </div>
                        <div>
                            <span class="vm-ft-form-card-header__title">Add Wallet</span>
                            <span class="vm-ft-form-card-header__sub">Top-up via payment gateway</span>
                        </div>
                    </div>
                    <ul class="nav nav-tabs fullbodydycolorbg1 tab-seconddesign tab-third-design vm-ft-role-tabs fulltabchange" id="tabs">
                        <li class="tab-link vm-ft-role-tab-li vm-ft-role-tab-li--active current active" data-tab="tab-1" role="presentation" style="width:100% !important;">
                            <a data-toggle="tab" href="#home" class="vm-ft-role-tab" aria-expanded="true" aria-selected="true">Wallet By Payment Gateway</a>
                        </li>
                    </ul>

                    <div class="width100 float-left tabcurrent-seconddesign input-border-third">
                        <div id="home" class="width100 float-left tab-pane vm-ft-left-tab-pane fade remove-activein active in">
                            <div class="fund-transfer-form vm-dealer-ft-form-fs14">
                                <div class="vm-gwx-panel">
                                    <div class="vm-gwx-seg">
                                        <label class="vm-gwx-seg-opt" onclick="HideShowGetWay('CreditCard')" style=" padding: 8px;">
                                            <input class="form-check-input" type="radio" name="paymentMode" id="gatewayTransfer" checked>
                                            <i class="fas fa-globe" aria-hidden="true"></i> GATEWAY TRANSFER
                                        </label>
                                        <label class="vm-gwx-seg-opt" onclick="HideShowGetWay('Gateway')" style=" padding: 8px;">
                                            <input class="form-check-input" type="radio" name="paymentMode" id="creditCardPayment">
                                            <i class="far fa-credit-card" aria-hidden="true"></i> CREDIT CARD PAYMENT
                                        </label>
                                    </div>

                                    <div class="pay-mode" id="GetWayMode">
                                        @using (Html.BeginForm("GatewayTransfer_new", "Home", FormMethod.Post))
                                        {
                                            <input type="hidden" id="latss" required name="latss" />
                                            <input type="hidden" id="longloc" required name="longloc" />
                                            <div class="vm-gwx-amt-card">
                                                <div>
                                                    <label class="vm-gwx-label" for="txtamt"><i class="fas fa-wallet" aria-hidden="true"></i>Purchase Amount <span class="vm-gwx-req">*</span></label>
                                                    <div class="vm-gwx-amt">
                                                        <span class="vm-gwx-amt-badge">₹</span>
                                                        @Html.TextBox("txtamt", "", new { @id = "txtamt", @class = "form-control vm-gwx-amt-input", @onkeypress = "return isNumberKey(event)", @placeholder = "Enter Purchase Amount", @style = "padding-left: 44px !important;", @required = true })
                                                    </div>
                                                    <div class="vm-gwx-quick">
                                                        <button type="button" class="vm-gwx-chip-amt" onclick="vmGwxSetAmt('100')">₹100</button>
                                                        <button type="button" class="vm-gwx-chip-amt" onclick="vmGwxSetAmt('500')">₹500</button>
                                                        <button type="button" class="vm-gwx-chip-amt" onclick="vmGwxSetAmt('1000')">₹1000</button>
                                                        <button type="button" class="vm-gwx-chip-amt" onclick="vmGwxSetAmt('5000')">₹5000</button>
                                                    </div>
                                                </div>
                                                <button type="button" class="vm-gwx-proceed" onclick="proceed()">
                                                    Proceed <span class="vm-gwx-arrow"><i class="fa fa-arrow-right"></i></span>
                                                </button>
                                                <button type="button" class="pay-mode-edit vm-gwx-change">
                                                    Change
                                                </button>
                                                <p id="txtmsgerror" class="vm-gw-msg vm-gw-msg--error"></p>
                                                <p class="vm-gw-msg vm-gw-msg--server">@ViewBag.msg</p>
                                            </div>
                                            <div id="showdata" style="display:none;" class="pay-mode-second vm-gw-charge-card">
                                            <div class="responsive-scroll-sate" style="width:100%;float:left;">
                                                <table class="table table-bordered table-striped table-hover" style="width:96%;margin: 0px 2%;">
                                                    <tr>
                                                        <th>Transaction Mode</th>
                                                        <th>Charge&nbsp;(%)</th>
                                                        <th>Total Charge</th>
                                                        <th>Net Receiving</th>
