<script>
    function HideShowGetWay(CheckActive) {
        if (CheckActive === 'Gateway') {
            document.getElementById('GetWayMode').style.display = 'none';
            document.getElementById('CreditCardMode').style.display = 'block';

            document.getElementById('creditCardPayment').checked = true;
            document.getElementById('gatewayTransfer').checked = false;

            $.ajax({
                url: '@Url.Action("GetDiscountedAmount", "Home")',
                type: 'POST',
                success: function (response) {
                    if (response.Status) {
                        var addinfoArray = JSON.parse(response.Addinfo);
                        var IHTML = `<option value="">Select Amount</option>`;
                        for (var i = 0; i < addinfoArray.length; i++) {
                            var billInfo = addinfoArray[i];
                            IHTML += `<option value="${billInfo.Idno}">${billInfo.Amount}</option>`;
                        }
                        document.getElementById('BillInfo').innerHTML = IHTML;
                    } else {
                        console.log(response.Message);
                    }
                },
                error: function (error) {
                    console.log(error);
                }
            });
        } else {
            document.getElementById('GetWayMode').style.display = 'block';
            document.getElementById('CreditCardMode').style.display = 'none';
            document.getElementById('creditCardPayment').checked = false;
            document.getElementById('gatewayTransfer').checked = true;
        }
    }
    function SelectAmount(dropdown) {
        var selectedValue = dropdown.value;
        $.ajax({
            url: '@Url.Action("GetHoldAmount", "Home")',
            type: 'POST',
            data: { Id: selectedValue },
            success: function (response) {
                if (response.Status) {
                    var addinfoArray = JSON.parse(response.Addinfo);
                    document.getElementById("BillDropdown").style.display = 'none';
                    document.getElementById("BillInputBox").style.display = 'block';
                    document.getElementById("Amount").value = addinfoArray.Amount;
                    document.getElementById("hideidno").value = selectedValue;

                    console.log(response.Addinfo)
                } else {
                    console.log(response.Message);
                }
            },
            error: function (error) {
                console.log(error);
            }
        });
    }
    function validateInput(input, type) {
        let value = input.value.replace(/\D/g, '');
        let message = '';
        switch (type) {
            case 'amount':
                input.value = value;
                if (value < 100) {
                    message = 'The Amount must be 100 or more';
                }
                break;
            case 'cardNumber':
                const minLength = 13;
                const maxLength = 19;
                if (value.length > maxLength) value = value.slice(0, maxLength);
                input.value = value;
                if (value.length < minLength || value.length > maxLength) {
                    message = 'Please enter a valid credit card number with 13 to 19 digits.';
                    input.setCustomValidity("Card number must be between 13 and 19 digits long.");
                } else {
                    input.setCustomValidity("");
                }
                break;
            case 'month':
                if (value.length > 2) value = value.slice(0, 2);
                const month = parseInt(value, 10);
                if (value.length === 2 && (month < 1 || month > 12)) {
                    message = 'Select month between 1 to 12 only.';
                }
                if (value.length === 2) {
                    const month = parseInt(value, 10);
                    if (month < 1 || month > 12) {
                        value = value.slice(0, 1);
                    }
                }
                input.value = value;
                break;
            case 'year':
                if (value.length > 2) value = value.slice(0, 2);
                if (value.length < 2) {
                    message = 'Please enter last 2-digit year (e.g., 24).';
                }
                input.value = value;
                break;
            case 'cvv':
                if (value.length > 3) value = value.slice(0, 3);
                input.value = value;
                if (value.length !== 3) {
                    message = 'Please enter a valid 3-digit CVV.';
                }
                break;
            case 'otp':
                input.value = value;
                break;
            default:
                break;
        }
        document.getElementById("VlidateionsMessage").innerHTML = message;
    }
    function CreditCardProceed() {
        let Amount = $('#Amount').val();
        let Name = $('#NameInput').val();
        let Cardnumber = $('#CardNumberInput').val();
        let Month = $('#MonthInput').val();
        let Year = $('#YearInput').val();
        let CVV = $('#CVVInput').val();
        let Otp = $('#OtpInput').val();
        let Idno = $('#hideidno').val();
        let reqid = $('#RequestId').val();
        if (Idno != "") {
            if (Amount >= 100) {
                if (Cardnumber.length > 12 && Cardnumber.length < 20) {
                    if (Month.length > 0 && Month.length < 3) {
                        Month = Month.length === 1 ? 0 + Month : Month;
                        if (Year.length > 0 && Year.length < 3) {
                            if (CVV.length > 2 && CVV.length < 5) {
                                let Exp = Month + "/" + Year;

                                $.ajax({
                                    url: '@Url.Action("CreditCardTransfer", "Home")',
                                    type: 'POST',
                                    data: { Amount, Cardnumber, Name, CVV, Exp, Otp, Idno, reqid },
                                    beforeSend: function () {
                                        document.getElementsByClassName('Loader-set')[0].style.display = 'block';
                                    },
                                    success: function (response) {
                                        document.getElementsByClassName('Loader-set')[0].style.display = 'none';
                                        if (response.Issendotp) {
                                            document.getElementById('RequestId').value = response.RequestId
                                            document.getElementById('OtpBox').style.display = 'block';
                                        }
                                        else {
                                            document.getElementById('VlidateionsMessage').innerHTML = response.Message;
                                        }
                                    },
                                    error: function (error) {
                                        document.getElementsByClassName('Loader-set')[0].style.display = 'none';
                                    },
                                    complete: function (xhr, status) {
                                        document.getElementsByClassName('Loader-set')[0].style.display = 'none';
                                    }
                                });
                            }
                            else {
                                document.getElementById('VlidateionsMessage').innerHTML = 'Please enter a valid 3 or 4-digit CVV.';
                            }
                        }
                        else {
                            document.getElementById('VlidateionsMessage').innerHTML = 'Please enter last 2-digit year (e.g., 24).'
                        }
                    }
                    else {
                        document.getElementById('VlidateionsMessage').innerHTML = 'Select month between 1 to 12 only.'
                    }
                }
                else {
                    document.getElementById("VlidateionsMessage").innerHTML = 'Please enter a valid credit card number with 13 to 19 digits.';
                }
            }
            else {
                document.getElementById("VlidateionsMessage").innerHTML = 'The Amount must be 100 or more';
            }
        }
        else {
            document.getElementById("VlidateionsMessage").innerHTML = 'ID is miss';
        }
    }

    $(document).ready(function () {
        var dateOpts = {
            format: "yyyy-mm-dd",
            todayHighlight: true,
            autoclose: true,
            orientation: "bottom auto",
            forceParse: false,
            enableOnReadonly: true,
            container: 'body'
        };
        if ($.fn.datepicker) {
            $('.input-daterange').datepicker(dateOpts);
            $("#txt_frm_date, #txt_to_date").datepicker(dateOpts);
            $('.saas-fund-transfer-page .saas-acc-dp-icon').on('click', function (e) {
                e.preventDefault();
                e.stopPropagation();
                var $input = $(this).closest('.saas-acc-dp-field').find('.saas-acc-dp-input');
                if ($input.length && $input.data('datepicker')) {
                    $input.datepicker('show');
                }
            });
        }
        var val = '@ViewBag.chk';
        if (val != "post" && $.fn.datepicker) {
            $("#txt_frm_date").datepicker("setDate", new Date());
            $("#txt_to_date").datepicker("setDate", new Date());
        }

        var current = location.pathname;
        $('.report-list-change li a').each(function () {
            var $this = $(this);
            if ($this.attr('href').indexOf(current) !== -1) {
                $this.addClass('active');
            }
        })

        $(".date-sateclassee input").click(function () {
            $(".datepicker").addClass('daqqqqkerrteyyecharge');
        });
    })

    function myFunction() {
        var value = $('#myInput').val().toLowerCase();
        $("#tblbody .tr").filter(function () {
            $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
        });
    }

    $('.third-design-dealer .third-design-table td').mouseenter(function () {
        var $tr = $(this).parent();
        if (!$tr.is('tr')) { return; }
        var colIndex = $tr.children().index($(this)) + 1;
        $tr.addClass('vm-gw-row-hover');
        $tr.closest('table').find("tr").children(":nth-child(" + colIndex + ")").addClass('vm-gw-col-hover');
    });
    $('.third-design-dealer .third-design-table td').mouseleave(function () {
        var $tr = $(this).parent();
        if (!$tr.is('tr')) { return; }
        var colIndex = $tr.children().index($(this)) + 1;
        $tr.removeClass('vm-gw-row-hover');
        $tr.closest('table').find("td:nth-child(" + colIndex + ")").removeClass('vm-gw-col-hover');
    });

    $('.pay-mode-process').click(function () {
        $(this).hide();
        $('.pay-mode-second').show();
        $('.pay-mode-edit').show();
        $('.pay-mode-first input').attr('readonly', 'readonly')

    });
    $('.pay-mode-edit').click(function () {
        $(this).hide();
        $('.pay-mode-second').hide();
        $('.pay-mode-process').show();
        $('.pay-mode-first input').removeAttr('readonly', 'readonly')
    });
    (function () {
        $('.pay-mode-first input').keyup(function () {
            var empty = false;
            $('.pay-mode-first input').each(function () {
                if ($(this).val() == '') {
                    empty = true;
                }
            });
            if (empty) {
                $('.pay-mode-process').attr('disabled', 'disabled');
            }
            else {
                $('.pay-mode-process').removeAttr('disabled');
            }
        });
    })()
    function vmGwxSetAmt(val) {
        var amt = document.getElementById('txtamt');
        if (amt) {
            amt.value = val;
            amt.focus();
            if (typeof $ !== 'undefined') { $('#txtmsgerror').text(''); }
        }
    }
    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : event.keyCode
        if (charCode > 31 && (charCode < 48 || charCode > 57))
            return false;
        return true;
    }

    function proceed() {
        if ($('#txtamt').val() == "") {
            $('#txtmsgerror').text("Amount Not Blank");
        }
        else if ($('#ddl_type').val() == "") {
            $('#txtmsgerror').text("Select Any Type");
        }
        else {
            $('#txtmsgerror').text("");
            $.ajax({
                url: '@Url.Action("calculatecharge_gateway", "Home")',
                type: 'GET',
                dataType: "json",
                data: { amount: $('#txtamt').val(), type: $('#ddl_type').val() },
                success: function (response) {
                    if (response.status) {
                        $('#showdata').show();
                        $('#showdata').find('table').empty();
                        document.getElementById('showdata').querySelector('table').appendChild(tableCreate($('#txtamt').val(), response.cols, response.values, $('#ddl_type').val()));
                    }
                    else {
                        $('#showdata').hide();
                        $('#txtmsgerror').text("Charge Not Set");
                    }
                }
            });
        }
    }
