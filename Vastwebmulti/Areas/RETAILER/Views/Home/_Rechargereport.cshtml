@model List<Vastwebmulti.Models.Sp_Recharge_info_LazyLoad_Result>
@using Vastwebmulti.Models;
@{
    Layout = null;
    VastwebmultiEntities DB1 = new VastwebmultiEntities();
}
@if (Model != null && Model.Count() > 0)
{
    foreach (var item in Model)
    {
        var upper = (item.Rstaus ?? "").ToUpper();
        var tone = "pending";
        var toneFa = "fa-clock-o";
        var normStatus = "PENDING";
        var label = item.Rstaus;

        if (upper.Contains("FAILED TO SUCCESS") || upper == "SUCCESS" || upper == "MANUAL SUCCESS" || (upper.Contains("SUCCESS") && !upper.Contains("SUCCESS TO FAILED")))
        {
            tone = "success"; toneFa = "fa-check"; normStatus = "SUCCESS"; label = "Success";
        }
        else if (upper.Contains("SUCCESS TO FAILED") || upper.Contains("FAILED") || upper.Contains("REFUND"))
        {
            tone = "failed"; toneFa = "fa-times"; normStatus = "FAILED";
            label = upper.Contains("REFUND") ? item.Rstaus : "Failed";
        }
        else if (upper.Contains("REQ") || upper.Contains("RESEND"))
        {
            tone = "pending"; toneFa = "fa-clock-o"; normStatus = "PENDING"; label = "Pending";
        }

        DateTime Rch_time = Convert.ToDateTime(item.Rch_time);
        DateTime Resp_time = Convert.ToDateTime(item.Resp_time);
        var Circle = item.Circle;
        var duedate = item.BillDueDate;
        var amt = item.amount;
        var amtde = item.income;
        decimal? amtdec = 0;
        if (upper.Contains("REFUND")) { amtdec = amt - amtde; amtdec = +amtdec; }
        else { amtdec = amt - amtde; amtdec = -amtdec; }

        var heavyrefreshbtn = "";
        if (item.Operator_type == "DTH" && (item.Rstaus == "SUCCESS" || (item.Rstaus ?? "").StartsWith("Failed To Success")))
        {
            var apinamesfound = DB1.api_name.Where(x => x.heavyRefresh != null && x.heavyRefresh == "mplan").FirstOrDefault();
            if (apinamesfound != null) { heavyrefreshbtn = "OKOK"; }
        }

        var canDispute = ((upper == "SUCCESS" || upper == "MANUAL SUCCESS" || upper.Contains("FAILED TO SUCCESS")) && item.sts == null);
        var canPrint = (upper == "SUCCESS" || upper == "MANUAL SUCCESS" || upper.Contains("FAILED TO SUCCESS") || upper.Contains("REQ"));

        <tr class="vm-dmt-row vm-dmt-row--@tone" data-amount="@item.amount" data-status="@normStatus">
            <td class="vm-radiant-firm-cell">
                <span class="vm-dmt-status vm-dmt-status--@tone" title="@item.Rstaus"><i class="fa @toneFa" aria-hidden="true"></i></span>
                <span>@item.Operator_type</span>
            </td>
            <td>
                <strong>@item.Mobile</strong>
                @if (!string.IsNullOrWhiteSpace(Circle))
                {
                    <br /><small class="text-muted">Circle @Circle</small>
                }
            </td>
            <td class="vm-radiant-firm-cell">
                @item.operator_Name
                @if (!string.IsNullOrWhiteSpace(duedate))
                {
                    <br /><small class="text-muted">Due @duedate</small>
                }
            </td>
            <td class="vm-dmt-amt-cell">@item.amount</td>
            <td class="vm-dmt-amt-cell">@amtdec</td>
            <td class="vm-dmt-amt-cell">@item.income</td>
            <td class="vm-dmt-amt-cell">@item.RemExtracomm</td>
            <td class="vm-dmt-amt-cell">@item.user_remain_pre</td>
            <td class="vm-dmt-amt-cell">@item.Remain</td>
            <td class="vm-radiant-request-cell">@item.OPt_id</td>
            <td class="vm-ticket-time-cell">@Rch_time.ToString("dd-MMM-yyyy HH:mm:ss")</td>
            <td class="vm-ticket-time-cell">
                @if (item.Resp_time != null)
                {
                    @Resp_time.ToString("dd-MMM-yyyy HH:mm:ss")
                }
                else
                {
                    @item.Resp_time
                }
            </td>
            <td class="vm-dmt-action-cell">
                <div class="vm-dmt-action-bar">
                    @if (heavyrefreshbtn == "OKOK")
                    {
                        <button type="button" class="vm-dmt-act-btn" title="DTH Refresh" onclick="Heavyrefreshbtn('@item.operator_Name', '@item.Mobile')">
                            <i class="fa fa-refresh" aria-hidden="true"></i>
                        </button>
                    }
                    @if (canDispute)
                    {
                        <button type="button" class="vm-dmt-act-btn" title="Raise dispute" onclick="openRetailerRchDispute('@item.idno', '@item.Mobile', '@item.operator_Name', '@item.amount', '@item.Operator_type')">
                            <i class="material-icons">gavel</i>
                        </button>
                    }
                    else if (item.sts == "Pending")
                    {
                        <span class="vm-dmt-status vm-dmt-status--pending" title="Dispute pending"><i class="fa fa-clock-o" aria-hidden="true"></i></span>
                    }
                    @if (canPrint)
                    {
                        <button type="button" class="vm-dmt-act-btn" title="Print invoice" onclick="GotoPDFRecharge('@item.idno')">
                            <i class="material-icons">print</i>
                        </button>
                    }
                </div>
                <span class="vm-radiant-status-text" style="display:block;font-size:11px;margin-top:4px;">@label</span>
            </td>
        </tr>
    }
}
else
{
    <tr class="vm-opr-table-empty-row">
        @if (ViewBag.checkdata != null)
        {
            <td colspan="13" class="vm-opr-table-empty vm-dmt-table-empty">
                <i class="fas fa-bolt" aria-hidden="true"></i>
                <span>No data for current search.</span>
            </td>
        }
        else
        {
            <td colspan="13" class="vm-opr-table-empty vm-dmt-table-empty">
                <i class="fas fa-bolt" aria-hidden="true"></i>
                <span>Data not found.</span>
            </td>
        }
    </tr>
}
