@model IEnumerable<Vastwebmulti.Models.microatm_report_Result>
@{
    ViewBag.Title = "Micro ATM Report";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";
    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    var selStatus = (Request["ddl_status"] ?? "").Trim();
    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
    int sno = 0;
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=34" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=38" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<style>
    body.saas-admin-ui .saas-retailer-microatm-report-page #mmm .vm-dmt-txntype {
        display: inline-block;
        vertical-align: middle;
        margin-left: 6px;
        font-size: 0.72rem;
        font-weight: 700;
        color: #334155;
        white-space: nowrap;
    }
    body.saas-admin-ui .saas-retailer-microatm-report-page .vm-dmt-clear-btn {
        white-space: nowrap;
    }
    body.saas-admin-ui .saas-retailer-microatm-report-page .vm-dmt-clear-btn .vm-dmt-mini-loader {
        display: none;
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255,255,255,0.5);
        border-top-color: #fff;
        border-radius: 50%;
        animation: vmDmtSpin 0.8s linear infinite;
    }
    body.saas-admin-ui .saas-retailer-microatm-report-page .vm-dmt-clear-btn.is-busy .vm-dmt-mini-loader {
        display: inline-block;
    }
    body.saas-admin-ui .saas-retailer-microatm-report-page .vm-dmt-clear-btn.is-busy .vm-dmt-clear-btn__icon {
        display: none;
    }
    @@keyframes vmDmtSpin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>

<div id="loadermoney" class="vm-dmt-loader" style="display:none;" aria-hidden="true">
    <div class="vm-dmt-loader__panel" role="status" aria-live="polite" aria-label="Processing">
        <div class="vm-dmt-table-loader__spinner" aria-hidden="true"></div>
        <span class="vm-dmt-loader__text">Please wait…</span>
    </div>
</div>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-retailer-microatm-report-page">
    <div class="container-fluid vm-opr-page-shell">

        @{
            var matmFormAttrs = new Dictionary<string, object>
            {
                { "id", "retailerMatmReportForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-report-date-form", "" },
                { "data-report-from", "#retailer_matm_frm_date" },
                { "data-report-to", "#retailer_matm_to_date" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("MIcroAtmReport", "Home", FormMethod.Post, matmFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Financial Services</li>
                        <li>Micro ATM Report</li>
                    </ol>
                    <div class="vm-dmt-fin-nav-row">
                        @Html.Partial("_menuFinicalReport")
                    </div>
                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="retailerMatmTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Micro ATM totals (loaded rows)</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideRetailerMatmTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Success</span>
                            <strong class="vm-opr-total-card__value" id="retailerMatmSuccess">&#8377; 0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Failed</span>
                            <strong class="vm-opr-total-card__value" id="retailerMatmFailed">&#8377; 0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Pending</span>
                            <strong class="vm-opr-total-card__value" id="retailerMatmPending">&#8377; 0.00</strong>
                        </div>
                    </div>
                </div>

                <div class="vm-rpt-filters-panel">
                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-rpt-filters-panel__bar">
                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("ddl_status", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "All Status", Value = "", Selected = (selStatus == "") },
                                new SelectListItem { Text = "Success", Value = "Success", Selected = selStatus == "Success" },
                                new SelectListItem { Text = "Failed", Value = "Failed", Selected = selStatus == "Failed" },
                                new SelectListItem { Text = "Pending", Value = "Pending", Selected = selStatus == "Pending" }
                            }, new { id = "ddl_status", @class = "vm-opr-select vm-dmt-select form-control", title = "Status" })
                        </div>
                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_matm_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_matm_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                            <button type="button" id="btnRetailerMatmClearPending" class="saas-acc-btn vm-dmt-clear-btn" title="Clear all pending">
                                <span class="vm-dmt-mini-loader" aria-hidden="true"></span>
                                <i class="fas fa-broom vm-dmt-clear-btn__icon" aria-hidden="true"></i><span>Clear Pending</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-credit-card" aria-hidden="true"></i>
                        <span>Micro ATM transactions</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn" onclick="FindtotalRetailerMatm()" title="Show totals" aria-expanded="false" aria-controls="retailerMatmTotalsPanel"><i class="fas fa-chart-pie" aria-hidden="true"></i></button>
                            <button type="button" id="btnRetailerMatmExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel"><i class="fas fa-file-excel" aria-hidden="true"></i> Excel</button>
                            <button type="button" id="btnRetailerMatmPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF"><i class="fas fa-file-pdf" aria-hidden="true"></i> PDF</button>
                        </div>
                    </div>
                </div>
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="mmm" class="table vm-opr-data-table" cellspacing="0" style="width:100%;">
                            <thead>
                                <tr>
                                    <th>S.R.</th>
                                    <th>Status</th>
                                    <th>Firm Name</th>
                                    <th>Amount &#8377;</th>
                                    <th>Time</th>
                                    <th>BankRRN No</th>
                                    <th>Tran Type</th>
                                    <th>Card Type</th>
                                    <th>Pan Card</th>
                                    <th>Remain Pre &#8377;</th>
                                    <th>Comm &#8377;</th>
                                    <th>GST &#8377;</th>
                                    <th>TDS &#8377;</th>
                                    <th>Remain Post &#8377;</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody id="retailerMatmRows">
                                @if (Model != null && Model.Count() > 0)
                                {
                                    foreach (var item in Model)
                                    {
                                        sno += 1;
                                        var upper = (item.status ?? "").ToUpper();
                                        var tone = "pending";
                                        var toneFa = "fa-clock-o";
                                        var normStatus = "PENDING";
                                        if (upper == "SUCCESS")
                                        {
                                            tone = "success"; toneFa = "fa-check"; normStatus = "SUCCESS";
                                        }
                                        else if (upper == "FAILED")
                                        {
                                            tone = "failed"; toneFa = "fa-times"; normStatus = "FAILED";
                                        }
                                        else if (upper.Contains("REFUND"))
                                        {
                                            tone = "failed"; toneFa = "fa-undo"; normStatus = "FAILED";
                                        }
                                        <tr class="vm-dmt-row vm-dmt-row--@tone" data-amount="@item.amount" data-status="@normStatus">
                                            <td class="vm-dmt-sr-cell">@sno</td>
                                            <td>
                                                <span class="vm-dmt-status vm-dmt-status--@tone" title="@item.status"><i class="fa @toneFa" aria-hidden="true"></i></span>
                                                <span class="vm-dmt-txntype">@item.status</span>
                                            </td>
                                            <td>@item.Frm_Name</td>
                                            <td class="vm-dmt-amt-cell">@item.amount</td>
                                            <td>@item.transtime</td>
                                            <td>@item.rrn</td>
                                            <td>@item.transaction_type</td>
                                            <td>@item.card_payment_type</td>
                                            <td>@item.masked_pan</td>
                                            <td class="vm-dmt-amt-cell">@item.retailer_remain_pre</td>
                                            <td class="vm-dmt-amt-cell">@item.Retailer_comm</td>
                                            <td class="vm-dmt-amt-cell">@item.Retailer_gst</td>
                                            <td class="vm-dmt-amt-cell">@item.Retailer_tds</td>
                                            <td class="vm-dmt-amt-cell">@item.retailer_remain_post</td>
                                            <td class="vm-dmt-action-cell">
                                                <div class="vm-dmt-action-bar">
                                                    @if (upper == "SUCCESS")
                                                    {
                                                        <button type="button" class="vm-dmt-act-btn" title="Print slip" onclick="printRetailerMatmSlip('@item.idno')"><i class="material-icons">print</i></button>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="15" class="vm-opr-table-empty vm-dmt-table-empty">
                                            <div class="vm-opr-empty-state">
                                                <i class="fas fa-inbox" aria-hidden="true"></i>
                                                <h3>Data not found</h3>
                                                <p>Try a different date range or filter.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section PostVmScripts {
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    function retailerMatmFilters() {
        return {
            txt_frm_date: jQuery('#retailer_matm_frm_date').val() || '',
            txt_to_date: jQuery('#retailer_matm_to_date').val() || '',
            ddl_status: jQuery('#ddl_status').val() || ''
        };
    }

    function hideRetailerMatmTotals() {
        var $panel = jQuery('#retailerMatmTotalsPanel');
        var $btn = jQuery('.vm-dmt-totals-btn');
        $panel.removeClass('is-open').hide().attr('aria-hidden', 'true');
        $btn.removeClass('is-active').attr({ title: 'Show totals', 'aria-expanded': 'false' });
    }

    function calcRetailerMatmTotals() {
        var success = 0, failed = 0, pending = 0;
        jQuery('#retailerMatmRows tr.vm-dmt-row').each(function () {
            var amt = parseFloat(jQuery(this).attr('data-amount')) || 0;
            var st = (jQuery(this).attr('data-status') || '').toUpperCase();
            if (st === 'SUCCESS') { success += amt; }
            else if (st === 'FAILED') { failed += amt; }
            else { pending += amt; }
        });
        jQuery('#retailerMatmSuccess').html('&#8377; ' + success.toFixed(2));
        jQuery('#retailerMatmFailed').html('&#8377; ' + failed.toFixed(2));
        jQuery('#retailerMatmPending').html('&#8377; ' + pending.toFixed(2));
    }

    function FindtotalRetailerMatm() {
        var $panel = jQuery('#retailerMatmTotalsPanel');
        var $btn = jQuery('.vm-dmt-totals-btn');
        if ($panel.hasClass('is-open')) {
            hideRetailerMatmTotals();
            return;
        }
        $panel.addClass('is-open').show().attr('aria-hidden', 'false');
        $btn.addClass('is-active').attr({ title: 'Hide totals', 'aria-expanded': 'true' });
        calcRetailerMatmTotals();
    }

    function printRetailerMatmSlip(idno) {
        window.open('@Url.Action("MicroAtmslip", "Home")?idno=' + idno, '_blank');
    }

    function initRetailerMatmSelect2() {
        jQuery('#ddl_status').each(function () {
            var $el = jQuery(this);
            if (!$el.length || !jQuery.fn.select2) { return; }
            if ($el.hasClass('select2-hidden-accessible')) {
                try { $el.select2('destroy'); } catch (e) { }
            }
            $el.select2({ width: '100%', minimumResultsForSearch: 6 });
        });
    }

    function initRetailerMatmDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initRetailerMatmDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm(
                '#retailerMatmReportForm',
                '#retailer_matm_frm_date',
                '#retailer_matm_to_date',
                true
            );
        }
    }

    jQuery(function () {
        initRetailerMatmSelect2();
        initRetailerMatmDatepickers();
        window.setTimeout(initRetailerMatmDatepickers, 150);

        jQuery('#btnRetailerMatmExport').on('click', function (e) {
            e.preventDefault();
            var f = retailerMatmFilters();
            location.href = '@Url.Action("ExcelMIcroAtmReport", "Home")?txt_frm_date=' + encodeURIComponent(f.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(f.txt_to_date) + '&ddl_status=' + encodeURIComponent(f.ddl_status);
        });
        jQuery('#btnRetailerMatmPDF').on('click', function () {
            var f = retailerMatmFilters();
            window.open('@Url.Action("PDF_MIcroAtmReport", "Home")?txt_frm_date=' + encodeURIComponent(f.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(f.txt_to_date) + '&ddl_status=' + encodeURIComponent(f.ddl_status), '_blank');
        });
        jQuery('#btnRetailerMatmClearPending').on('click', function () {
            var $btn = jQuery(this);
            if ($btn.hasClass('is-busy')) { return; }
            var f = retailerMatmFilters();
            $btn.addClass('is-busy');
            jQuery.ajax({
                url: '@Url.Action("ClearallMTM", "Home")',
                data: { fromdate: f.txt_frm_date, todate: f.txt_to_date },
                complete: function () {
                    $btn.removeClass('is-busy');
                    location.reload();
                },
                error: function () {
                    $btn.removeClass('is-busy');
                }
            });
        });
    });
</script>
}
