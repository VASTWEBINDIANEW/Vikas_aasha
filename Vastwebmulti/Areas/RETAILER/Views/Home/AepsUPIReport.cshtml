@model IEnumerable<Vastwebmulti.Models.AepsUPIHistory>
@{
    ViewBag.Title = "AEPS UPI Report";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";
    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    var selStatus = (Request["ddl_status"] ?? "").Trim();
    if (selStatus == "" || selStatus == "Status") { selStatus = "ALL"; }
    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=34" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=38" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<style>
    body.saas-admin-ui .saas-retailer-upi-report-page #mmm .vm-dmt-txntype {
        display: inline-block;
        vertical-align: middle;
        margin-left: 6px;
        font-size: 0.72rem;
        font-weight: 700;
        color: #334155;
        white-space: nowrap;
    }
    body.saas-admin-ui .saas-retailer-upi-report-page #mmm .vm-dmt-subtext {
        display: block;
        font-size: 0.68rem;
        font-weight: 600;
        color: #64748b;
        white-space: nowrap;
        margin-top: 2px;
    }
</style>

<div id="loadermoney" class="vm-dmt-loader" style="display:none;" aria-hidden="true">
    <div class="vm-dmt-loader__panel" role="status" aria-live="polite" aria-label="Processing">
        <div class="vm-dmt-table-loader__spinner" aria-hidden="true"></div>
        <span class="vm-dmt-loader__text">Please wait…</span>
    </div>
</div>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-retailer-upi-report-page">
    <div class="container-fluid vm-opr-page-shell">

        @{
            var upiFormAttrs = new Dictionary<string, object>
            {
                { "id", "retailerUpiReportForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-report-date-form", "" },
                { "data-report-from", "#retailer_upi_frm_date" },
                { "data-report-to", "#retailer_upi_to_date" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("AepsUPIReport", "Home", FormMethod.Post, upiFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Financial Services</li>
                        <li>AEPS UPI Report</li>
                    </ol>
                    <div class="vm-dmt-fin-nav-row">
                        @Html.Partial("_menuFinicalReport")
                    </div>
                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="retailerUpiTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>AEPS UPI totals (loaded rows)</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideRetailerUpiTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Success</span>
                            <strong class="vm-opr-total-card__value" id="retailerUpiSuccess">&#8377; 0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Failed</span>
                            <strong class="vm-opr-total-card__value" id="retailerUpiFailed">&#8377; 0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Pending</span>
                            <strong class="vm-opr-total-card__value" id="retailerUpiPending">&#8377; 0.00</strong>
                        </div>
                    </div>
                </div>

                <div class="vm-rpt-filters-panel">
                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-rpt-filters-panel__bar">
                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("ddl_status", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "All Status", Value = "ALL", Selected = (selStatus == "ALL") },
                                new SelectListItem { Text = "Success", Value = "SUCCESS", Selected = selStatus == "SUCCESS" },
                                new SelectListItem { Text = "Pending", Value = "PENDING", Selected = selStatus == "PENDING" },
                                new SelectListItem { Text = "Failed", Value = "FAILED", Selected = selStatus == "FAILED" }
                            }, new { id = "ddl_status", @class = "vm-opr-select vm-dmt-select form-control", title = "Status" })
                        </div>
                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_upi_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_upi_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-mobile-alt" aria-hidden="true"></i>
                        <span>AEPS UPI transactions</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn" onclick="FindtotalRetailerUpi()" title="Show totals" aria-expanded="false" aria-controls="retailerUpiTotalsPanel"><i class="fas fa-chart-pie" aria-hidden="true"></i></button>
                            <button type="button" id="btnRetailerUpiExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel"><i class="fas fa-file-excel" aria-hidden="true"></i> Excel</button>
                            <button type="button" id="btnRetailerUpiPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF"><i class="fas fa-file-pdf" aria-hidden="true"></i> PDF</button>
                        </div>
                    </div>
                </div>
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="mmm" class="table vm-opr-data-table" cellspacing="0" style="width:100%;">
                            <thead>
                                <tr>
                                    <th>S.R.</th>
                                    <th>Status</th>
                                    <th>Unique ID</th>
                                    <th>Remain Pre &#8377;</th>
                                    <th>Amount &#8377;</th>
                                    <th>Remain Post &#8377;</th>
                                    <th>Txn Date</th>
                                    <th>Update Date</th>
                                    <th>Bank RRN</th>
                                    <th>Payer VPA</th>
                                    <th>Payer Name</th>
                                </tr>
                            </thead>
                            <tbody id="retailerUpiRows">
                                @if (Model != null && Model.Count() > 0)
                                {
                                    foreach (var item in Model)
                                    {
                                        var upper = (item.Status ?? "").Trim().ToUpper();
                                        var tone = "pending";
                                        var toneFa = "fa-clock-o";
                                        var normStatus = "PENDING";
                                        if (upper == "SUCCESS")
                                        {
                                            tone = "success"; toneFa = "fa-check"; normStatus = "SUCCESS";
                                        }
                                        else if (upper == "FAILED")
                                        {
                                            tone = "failed"; toneFa = "fa-times"; normStatus = "FAILED";
                                        }
                                        var reqtype = (item.reqtype ?? "").Trim().ToUpper();
                                        var reqFa = reqtype == "APP" ? "fa-mobile" : "fa-globe";
                                        var reqTitle = reqtype == "APP" ? "Mobile App" : "Website";
                                        <tr class="vm-dmt-row vm-dmt-row--@tone" data-amount="@item.Amount" data-status="@normStatus">
                                            <td class="vm-dmt-sr-cell"></td>
                                            <td>
                                                <span class="vm-dmt-status vm-dmt-status--@tone" title="@item.Status"><i class="fa @toneFa" aria-hidden="true"></i></span>
                                                <span class="vm-dmt-txntype">@item.Status</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-status" title="@reqTitle"><i class="fa @reqFa" aria-hidden="true"></i></span>
                                                <span class="vm-dmt-txntype">@item.Txnid</span>
                                            </td>
                                            <td class="vm-dmt-amt-cell">@(item.Remainpre.HasValue ? item.Remainpre.Value.ToString("N2") : "-")</td>
                                            <td class="vm-dmt-amt-cell">
                                                @item.Amount
                                                <span class="vm-dmt-subtext">Comm: &#8377;@item.totalcomm</span>
                                            </td>
                                            <td class="vm-dmt-amt-cell">@(item.RemainPost.HasValue ? item.RemainPost.Value.ToString("N2") : "-")</td>
                                            <td>@(item.txndate.HasValue ? item.txndate.Value.ToString("dd-MM-yyyy HH:mm:ss") : "-")</td>
                                            <td>@(item.updatedate.HasValue ? item.updatedate.Value.ToString("dd-MM-yyyy HH:mm:ss") : "-")</td>
                                            <td>@item.Bankrrn</td>
                                            <td>@item.PayerVPA</td>
                                            <td>@item.PayerName</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="11" class="vm-opr-table-empty vm-dmt-table-empty">
                                            <div class="vm-opr-empty-state">
                                                <i class="fas fa-inbox" aria-hidden="true"></i>
                                                <h3>Data not found</h3>
                                                <p>Try a different date range or filter.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section PostVmScripts {
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    function retailerUpiFilters() {
        return {
            txt_frm_date: jQuery('#retailer_upi_frm_date').val() || '',
            txt_to_date: jQuery('#retailer_upi_to_date').val() || '',
            ddl_status: jQuery('#ddl_status').val() || 'ALL'
        };
    }

    function renumberRetailerUpiSr() {
        jQuery('#retailerUpiRows tr.vm-dmt-row').each(function (i) {
            jQuery(this).find('.vm-dmt-sr-cell').first().text(i + 1);
        });
    }

    function hideRetailerUpiTotals() {
        var $panel = jQuery('#retailerUpiTotalsPanel');
        var $btn = jQuery('.vm-dmt-totals-btn');
        $panel.removeClass('is-open').hide().attr('aria-hidden', 'true');
        $btn.removeClass('is-active').attr({ title: 'Show totals', 'aria-expanded': 'false' });
    }

    function FindtotalRetailerUpi() {
        var $panel = jQuery('#retailerUpiTotalsPanel');
        var $btn = jQuery('.vm-dmt-totals-btn');
        if ($panel.hasClass('is-open')) {
            hideRetailerUpiTotals();
            return;
        }
        $panel.addClass('is-open').show().attr('aria-hidden', 'false');
        $btn.addClass('is-active').attr({ title: 'Hide totals', 'aria-expanded': 'true' });
        var success = 0, failed = 0, pending = 0;
        jQuery('#retailerUpiRows tr.vm-dmt-row').each(function () {
            var amt = parseFloat(jQuery(this).attr('data-amount')) || 0;
            var st = (jQuery(this).attr('data-status') || '').toUpperCase();
            if (st === 'SUCCESS') { success += amt; }
            else if (st === 'FAILED') { failed += amt; }
            else { pending += amt; }
        });
        jQuery('#retailerUpiSuccess').html('&#8377; ' + success.toFixed(2));
        jQuery('#retailerUpiFailed').html('&#8377; ' + failed.toFixed(2));
        jQuery('#retailerUpiPending').html('&#8377; ' + pending.toFixed(2));
    }

    function initRetailerUpiSelect2() {
        jQuery('#ddl_status').each(function () {
            var $el = jQuery(this);
            if (!$el.length || !jQuery.fn.select2) { return; }
            if ($el.hasClass('select2-hidden-accessible')) {
                try { $el.select2('destroy'); } catch (e) { }
            }
            $el.select2({ width: '100%', minimumResultsForSearch: 6 });
        });
    }

    function initRetailerUpiDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initRetailerUpiDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm(
                '#retailerUpiReportForm',
                '#retailer_upi_frm_date',
                '#retailer_upi_to_date',
                true
            );
        }
    }

    jQuery(function () {
        initRetailerUpiSelect2();
        initRetailerUpiDatepickers();
        window.setTimeout(initRetailerUpiDatepickers, 150);
        renumberRetailerUpiSr();

        jQuery('#btnRetailerUpiExport').on('click', function () {
            if (jQuery('#retailerUpiRows tr.vm-dmt-row').length === 0) {
                alert('Export ke liye koi data nahi hai. Pehle aisi date select karo jisme transactions hon.');
                return;
            }
            var f = retailerUpiFilters();
            var $tbl = jQuery('#mmm').clone();
            $tbl.find('i.fa').remove();
            var tableHtml = $tbl.prop('outerHTML');
            var excelHtml = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40">'
                + '<head><meta charset="UTF-8"></head><body>'
                + '<h3>AEPS UPI Report (' + f.txt_frm_date + ' to ' + f.txt_to_date + ')</h3>'
                + tableHtml + '</body></html>';
            var blob = new Blob(['\ufeff' + excelHtml], { type: 'application/vnd.ms-excel' });
            var a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'AepsUPI_Report_' + f.txt_frm_date + '_to_' + f.txt_to_date + '.xls';
            document.body.appendChild(a);
            a.click();
            window.setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 500);
        });
        jQuery('#btnRetailerUpiPDF').on('click', function () {
            if (jQuery('#retailerUpiRows tr.vm-dmt-row').length === 0) {
                alert('PDF ke liye koi data nahi hai. Pehle aisi date select karo jisme transactions hon.');
                return;
            }
            var f = retailerUpiFilters();
            var $tbl = jQuery('#mmm').clone();
            $tbl.find('i.fa').remove();
            var tableHtml = $tbl.prop('outerHTML');
            var w = window.open('', '_blank');
            if (!w) {
                alert('Popup block ho gaya hai. Browser me popup allow karo phir PDF dabao.');
                return;
            }
            w.document.write('<html><head><title>AEPS UPI Report</title>'
                + '<style>body{font-family:Arial,sans-serif;}h3{text-align:center;}'
                + 'table{border-collapse:collapse;width:100%;font-size:11px;}'
                + 'td,th{border:1px solid #000;padding:4px 6px;text-align:left;}'
                + 'thead tr{background:#eee;}</style>'
                + '</head><body>'
                + '<h3>AEPS UPI Report (' + f.txt_frm_date + ' to ' + f.txt_to_date + ')</h3>'
                + tableHtml
                + '<script>window.onload=function(){window.print();}<\/script>'
                + '</body></html>');
            w.document.close();
            w.focus();
        });
    });
</script>
}
