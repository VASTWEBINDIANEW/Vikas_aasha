<!--Refund Model-->
<div class="modal fade" id="defaultModal1" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header" style="background-color:whitesmoke;">
                <h4 class="modal-title" id="defaultModalLabel">Refund</h4>
            </div>
            <div class="modal-body">
                <div class="body">
                    <div class="row clearfix">
                        <div class="col-lg-3 col-md-3 col-sm-4 col-xs-5 form-control-label">
                            <label for="email_address_2">Reason</label>
                        </div>
                        <div class="col-lg-9 col-md-9 col-sm-8 col-xs-7">
                            <div class="form-group">
                                @Html.TextBox("txtrefidno", "", new { style = "display:none;" })
                                @Html.TextBox("txtbankid", "", new { style = "display:none;" })
                                @Html.TextBox("txtrecivername", "", new { style = "display:none;" })
                                <div class="" style="border:1px solid #dddddd;">
                                    @Html.DropDownList("ddl_refund", new List<SelectListItem>
                                           {
                     new SelectListItem{ Text="Manual Failed",Value="Manual FAILED"},
                     new SelectListItem{Text="Bank Server Down ",Value="Bank Server Down"},
                   new SelectListItem{ Text="Failed Due To Invalid Choice",Value="Failed Due To Invalid Choice"},
                  new SelectListItem{Text="Network Down",Value="Network Down"},
                    new SelectListItem{Text="Unsupported Network",Value="Unsupported Network"},
                 new SelectListItem{Text="Network issue",Value="Network issue"},
                 new SelectListItem{Text="Insufficient Fund ",Value="Insufficient Fund"}
                            }, new { @class = "btn-group bootstrap-select form-control show-tick dropup" })

                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row clearfix">
                        <div class="col-lg-3 col-md-3 col-sm-4 col-xs-5 form-control-label">
                            <label for="email_address_2">Security&nbsp;Password</label>
                        </div>
                        <div class="col-lg-9 col-md-9 col-sm-8 col-xs-7">
                            <div class="form-group">
                                <div class="" style="border:1px solid #dddddd;">
                                    <input type="text" id="securitypass" name="securitypass" class="form-control" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="submit" class="btn bg-grey waves-effect" style="margin-top: 4px; margin-right: 12px; height:34px;" onclick="Failed()">
                            <span style="top:-2px;color:black;">Save Change</span>
                        </button>
                        <button type="button" class="btn bg-grey waves-effect" style="margin-top: 4px; margin-left: -3px; height:34px;" data-dismiss="modal">
                            <span style="top:-2px;color:black;">Close</span>
                        </button>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>


