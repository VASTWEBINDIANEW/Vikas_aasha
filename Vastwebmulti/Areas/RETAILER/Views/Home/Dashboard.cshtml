@model Vastwebmulti.Areas.ADMIN.ViewModel.TargetSetviewmodel
@using Vastwebmulti.Models
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";

    DateTime todaysDate = DateTime.Now.Date;

    int newsCount = 0;
    if (ViewBag.newsdata != null)
    {
        foreach (var n in ViewBag.newsdata) { newsCount++; }
    }
    int holidayCount = 0;
    if (ViewBag.showholiday != null)
    {
        foreach (var h in ViewBag.showholiday) { holidayCount++; }
    }
    var companyName = ViewBag.companyname as string ?? "";
}

<link href="~/MainFrontDesign/css/admin-dashboard-modern.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/dealer-dashboard-modern.css?v=30" rel="stylesheet" />

<style>
    body.saas-admin-ui .saas-admin-dashboard.sevent_box,
    body.saas-admin-ui .saas-admin-dashboard .sevent_box0,
    body.saas-admin-ui .saas-admin-dashboard .sevent_box3 {
        background: #fff !important;
    }
    body.saas-admin-ui .saas-dash-modern .tab-content2 {
        background: #fff;
    }
    /* Retailer today/yesterday radio toggle row */
    body.saas-admin-ui .saas-retailer-biz-toggle {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 10px 4px;
        font-size: 13px;
        font-weight: 600;
        color: #0f172a;
    }
    body.saas-admin-ui .saas-retailer-biz-toggle label {
        margin: 0 0 0 4px;
        cursor: pointer;
    }
</style>

<section class="content tmw-dashaboard fourdesign-section-admin main-laout saas-admin-dashboard saas-dash-modern">
    <div class="container-fluid">

        <div class="saas-dash-body-row">
            <div class="saas-dash-panel saas-dash-panel-menu second-design-tab sevent_box0">
                <div class="saas-dash-panel-head">
                    <span class="saas-dash-panel-title"><i class="fas fa-th-large" aria-hidden="true"></i> @companyName  / Retailer Center</span>
                </div>

                <ul class="tabs2 width100 float-left nav-tabs" role="tablist">
                    <li class="tab-link current2" data-tab="retailer-tab-services" role="presentation">
                        <a href="#retailer-services"><i class="fas fa-bolt" aria-hidden="true"></i> My Account</a>
                    </li>
                    <li class="tab-link" data-tab="retailer-tab-profile" role="presentation">
                        <a href="#retailer-profile"><i class="fas fa-user-circle" aria-hidden="true"></i> Manage Profile</a>
                    </li>
                </ul>

                <div id="retailer-tab-services" class="tab-content2 current2" role="tabpanel">
                    <div class="saas-dash-menu-grid">
                        <a href="@Url.Action("RetailerLedger", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-book"></i></span><span>Ledger</span></a>
                        <a href="@Url.Action("Retailer_Daybook_Report", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-calendar-day"></i></span><span>Day Book</span></a>
                        <a href="@Url.Action("Actual_Retailer_income", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-sack-dollar"></i></span><span>My Earn</span></a>
                        <a href="@Url.Action("Set_Referral", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-share-nodes"></i></span><span>Referral</span></a>
                        <a href="@Url.Action("Service_Fee", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-percent"></i></span><span>Service Fee</span></a>
                        <a href="@Url.Action("WebLogin", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-lock"></i></span><span>Login Info</span></a>
                        <a href="@Url.Action("Bank_info", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-building-columns"></i></span><span>Bank &amp; Cash</span></a>
                        <a href="@Url.Action("WalletUnloadReport", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-money-bill-transfer"></i></span><span>Wallet Unload</span></a>
                        <a href="@Url.Action("Operator_info", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-tower-broadcast"></i></span><span>Operator Comm</span></a>
                        <a href="@Url.Action("MarkupSetting", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-sliders"></i></span><span>Markup Setting</span></a>
                        <a href="@Url.Action("DisputeReport", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-triangle-exclamation"></i></span><span>Dispute List</span></a>
                        <a href="@Url.Action("Show_Credit_report_by_admin", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-indian-rupee-sign"></i></span><span>My Credit</span></a>
                        <a href="@Url.Action("RetailerSellgst", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-file-invoice"></i></span><span>Invoice</span></a>
                        <a href="@Url.Action("Gst_Invocing_Retailer_report", "Home")" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-receipt"></i></span><span>GST &amp; TDS</span></a>
                        <a href="@Url.Action("Certificate", "Home")" target="_blank" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-award"></i></span><span>Certification</span></a>
                        <a href="@Url.Action("Manual_Formdetails", "Home")" target="_blank" class="saas-dash-menu-item"><span class="saas-dash-menu-icon"><i class="fas fa-file-pen"></i></span><span>Manual Form</span></a>
                    </div>
                </div>

                <div id="retailer-tab-profile" class="tab-content2" role="tabpanel">
                    <div class="saas-dealer-profile">
                        <div class="saas-dealer-profile-card">
                            <div class="saas-dealer-profile-avatar-wrap">
                                @if (ViewBag.image != null && ViewBag.image != "")
                                {
                                    <img src="@Url.Content("~/" + ViewBag.image)" class="saas-dealer-profile-avatar" alt="User profile" />
                                }
                                else
                                {
                                    <img src="@Url.Content("~/images/Team_user.png")" class="saas-dealer-profile-avatar" alt="User profile" />
                                }
                                <span class="saas-dealer-profile-badge" aria-hidden="true"><i class="fas fa-user-check"></i></span>
                            </div>
                            <div class="saas-dealer-profile-meta">
                                <span class="saas-dealer-profile-label">Signed in as</span>
                                <p class="saas-dealer-profile-name">@ViewBag.name</p>
                                <p class="saas-dealer-profile-email">@ViewBag.email</p>
                            </div>
                            <div class="saas-dealer-profile-actions">
                                <a href="~/RETAILER/Home/Profile" class="saas-dealer-profile-btn saas-dealer-profile-btn-primary">
                                    <span class="saas-dealer-profile-btn-icon"><i class="fas fa-user" aria-hidden="true"></i></span>
                                    <span class="saas-dealer-profile-btn-text">My Profile</span>
                                </a>
                                <a href="~/RETAILER/Home/ChangePassword" class="saas-dealer-profile-btn saas-dealer-profile-btn-secondary">
                                    <span class="saas-dealer-profile-btn-icon"><i class="fas fa-key" aria-hidden="true"></i></span>
                                    <span class="saas-dealer-profile-btn-text">Manage Password</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="saas-dash-panel saas-dash-panel-txn second-design-tab-width sevent_box3">
                <div class="saas-dash-panel-head">
                    <span class="saas-dash-panel-title"><i class="fas fa-arrow-right-arrow-left" aria-hidden="true"></i> Activity Center</span>
                </div>

                <ul class="tabs3 width100 float-left saas-dash-txn-tabs" role="tablist">
                    <li class="tab-link current3" role="tab" data-tab="retailer-pane-notify" aria-selected="true">Notification</li>
                    <li class="tab-link" role="tab" data-tab="retailer-pane-offers" aria-selected="false">Offers</li>
                    <li class="tab-link" role="tab" data-tab="retailer-pane-txn" aria-selected="false">Recent Transactions</li>
                    <li class="tab-link" role="tab" data-tab="retailer-pane-gross" aria-selected="false">Gross Business</li>
                </ul>

                <div id="retailer-pane-notify" class="tab-content3 current3" role="tabpanel">
                    <div class="vm-retailer-notify" id="vmRetailerNotify">
                        <div class="vm-notify-track">
                            @{ var vmNotiIdx = 0; }
                            @if (newsCount > 0)
                            {
                                foreach (var item in ViewBag.newsdata)
                                {
                                    if (item.name == null && item.name == "") { continue; }
                                    var nmType = (item.name ?? "").Trim().ToLower();
                                    var iconCls = "fas fa-bullhorn";
                                    if (nmType.Contains("down") || nmType.Contains("warning") || nmType.Contains("alert") || nmType.Contains("fail"))
                                    {
                                        iconCls = "fas fa-triangle-exclamation";
                                    }
                                    else if (nmType.Contains("up") || nmType.Contains("success") || nmType.Contains("active"))
                                    {
                                        iconCls = "fas fa-arrow-trend-up";
                                    }
                                    else if (nmType.Contains("new") || nmType.Contains("service") || nmType.Contains("launch") || nmType.Contains("offer"))
                                    {
                                        iconCls = "fas fa-wand-magic-sparkles";
                                    }
                                    else if (nmType.Contains("holiday"))
                                    {
                                        iconCls = "fas fa-calendar-day";
                                    }
                                    <article class="vm-notify-slide@(vmNotiIdx == 0 ? " vm-active" : "")">
                                        <div class="vm-notify-card">
                                            <div class="vm-notify-top">
                                                <span class="vm-notify-ic"><i class="@iconCls" aria-hidden="true"></i></span>
                                                <div class="vm-notify-head">
                                                    <h3>@item.Header</h3>
                                                    <span class="vm-notify-tag">@item.name</span>
                                                </div>
                                            </div>
                                            <p class="vm-notify-msg">@item.message</p>
                                            <div class="vm-notify-foot"><span class="vm-notify-count">@(vmNotiIdx + 1) / @newsCount</span><span class="vm-notify-live"><i></i>AUTO</span></div>
                                        </div>
                                    </article>
                                    vmNotiIdx++;
                                }
                            }
                            else
                            {
                                <div class="saas-dt-empty">
                                    <i class="fas fa-inbox" aria-hidden="true"></i>
                                    <p>No notifications found</p>
                                </div>
                            }
                        </div>
                        @if (newsCount > 1)
                        {
                            <button type="button" class="vm-notify-arrow vm-prev" id="vmNotifyPrev" aria-label="Previous notification"><i class="fas fa-chevron-left"></i></button>
                            <button type="button" class="vm-notify-arrow vm-next" id="vmNotifyNext" aria-label="Next notification"><i class="fas fa-chevron-right"></i></button>
                        }
                    </div>
                    <div class="vm-holiday-wrap">
                        <h4 class="vm-holiday-title"><i class="fas fa-calendar-day" aria-hidden="true"></i> Bank Holidays</h4>
                        @if (holidayCount > 0)
                        {
                            <div class="saas-dealer-holiday-grid">
                                @foreach (var item in ViewBag.showholiday)
                                {
                                    <div class="saas-dealer-holiday-card">
                                        <i class="fas fa-calendar-day" aria-hidden="true"></i>
                                        <span class="saas-dealer-holiday-date"><em>@item.HolidayDate.Day</em> <strong>@item.HolidayDate.ToString("MMM") @item.HolidayDate.Year</strong></span>
                                        <span class="saas-dealer-holiday-name">@item.HolidayName</span>
                                        <span class="saas-dealer-holiday-week">@item.HolidayDate.ToString("dddd")</span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="saas-dt-empty">
                                <i class="fas fa-calendar-check" aria-hidden="true"></i>
                                <p>No upcoming holidays</p>
                            </div>
                        }
                    </div>
                </div>

                <div id="retailer-pane-offers" class="tab-content3" role="tabpanel" hidden>
                    <ul class="tabs3 width100 saas-dash-txn-tabs saas-dealer-month-tabs" role="tablist">
                        <li class="tab-link current3" id="CurrentMonthYYY">@todaysDate.ToString("MMMM") Offer</li>
                        <li class="tab-link" id="NextMonthYYY">@todaysDate.AddMonths(1).ToString("MMMM") Offer</li>
                    </ul>
                    @Html.Partial("_CurrentMonthTargetOffer")
                </div>

                <div id="retailer-pane-txn" class="tab-content3" role="tabpanel" hidden>
                    <div id="rch">
                        <div class="table-responsive saas-dash-table-scroll">
                            <table class="table table-bordered saas-dash-txn-table" style="width:100%;">
                                <thead>
                                    <tr>
                                        <th>Type</th>
                                        <th>Transaction Description</th>
                                        <th>Transaction Date</th>
                                        <th>Cr/Dr</th>
                                        <th>Updated Bal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @Html.Partial("_Recent_Transaction")
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div id="retailer-pane-gross" class="tab-content3" role="tabpanel" hidden>
                    <div class="saas-retailer-biz-toggle">
                        <span>
                            <input type="radio" id="TodayBusiness" onclick="today(this)" checked="checked" name="Business" />
                            <label for="TodayBusiness">Today Business</label>
                        </span>
                        <span>
                            <input type="radio" id="YesterdayBusiness" onclick="today(this)" name="Business" />
                            <label for="YesterdayBusiness">Yesterday Business</label>
                        </span>
                    </div>
                    <div class="saas-dash-txn-card">
                        <div class="saas-dash-table-scroll table-responsive">
                            <table class="table table-hover table-bordered saas-dash-txn-table" style="width:100%;text-align:center;">
                                <thead>
                                    <tr>
                                        <th style="text-align:center;">Symbol</th>
                                        <th style="text-align:center;">Services</th>
                                        <th style="text-align:center;">Success &#8377;</th>
                                        <th style="text-align:center;">Ratio (%)</th>
                                        <th style="text-align:center;">Count</th>
                                        <th style="text-align:center;">My Earn</th>
                                    </tr>
                                </thead>
                                <tbody id="tabletoday"></tbody>
                            </table>
                        </div>
                    </div>
                    <div id="donut_chart" class="graph" style="display:none;" aria-hidden="true"></div>
                </div>

            </div>
        </div>
    </div>
</section>

<script>
    var retailerGrossLoaded = false;

    function switchRetailerActivityTab(tabId) {
        var $panel = $('.sevent_box3');
        $panel.find('ul.tabs3 li[data-tab]').removeClass('current3').attr('aria-selected', 'false');
        $panel.find('.tab-content3').removeClass('current3').attr('hidden', 'hidden');

        $panel.find('ul.tabs3 li[data-tab="' + tabId + '"]').addClass('current3').attr('aria-selected', 'true');
        var $pane = $('#' + tabId);
        $pane.addClass('current3').removeAttr('hidden');

        if (tabId === 'retailer-pane-gross' && !retailerGrossLoaded) {
            var el = document.getElementById('TodayBusiness');
            if (el) { today(el); }
        }
    }

    function today(a) {
        $("#tabletoday").empty();
        var x = a.id;
        if (x == 'Today') {
            $('#TodayBusiness').prop("checked", true);
        }
        $.ajax({
            url: '@Url.Action("Show_Today_All_Recharge", "Home")',
            type: 'POST',
            dataType: "html",
            data: { yesterday: x },
            success: function (data) {
                var x = JSON.parse(data);
                var newRow =
                    "<tr>" +
                    "<td><p style='margin-bottom:0;'><img src='../../ashok-images/utilty.svg' style='width:26px;' /></p></td>" +
                    "<td><p>Prepaid & Utility</p></td>" +
                    "<td><p>" + x.Recharge + "</p></td>" +
                    "<td><p>0</p></td>" +
                    "<td><p>0</p></td>" +
                    "<td><p>" + x.RechargeEran + "</p></td>" + "</tr>" +
                    "<tr>" +
                    "<td><p style='margin-bottom:0;'><img src='../../ashok-images/mnytrf.svg' style='width:26px;' /></p></td>" +
                    "<td><p>Money Transfar</p></td>" +
                    "<td><p>" + x.Moneytransfer + "</p></td>" +
                    "<td><p>0</p></td>" +
                    "<td><p>0</p></td>" +
                    "<td><p>" + x.DmtEarn + "</p></td>" + "</tr>" +
                    "<tr>" +
                    "<td><p style='margin-bottom:0;'><img src='../../ashok-images/aepsfngr.svg' style='width:26px;' /></p></td>" +
                    "<td><p>Aeps Services</p></td>" +
                    "<td><p>" + x.Aeps + "</p></td>" +
                    "<td><p>0</p></td>" +
                    "<td><p>0</p></td>" +
                    "<td><p>" + x.AepsEarn + "</p></td>" + "</tr>" +
                    "<tr>" +
                    "<td><p style='margin-bottom:0;'><img src='../../ashok-images/mpsatm.svg' style='width:26px;' /></p></td>" +
                    "<td><p>Mpose (Micro ATM)</p></td>" +
                    "<td><p>" + x.Aeps + "</p></td>" +
                    "<td><p>0</p></td>" +
                    "<td><p>0</p></td>" +
                    "<td><p>" + x.AepsEarn + "</p></td>" + "</tr>" +
                    "<tr>" +
                    "<td><p style='margin-bottom:0;'><img src='../../ashok-images/pncrd.svg' style='width:26px;' /></p></td>" +
                    "<td><p>Pancard</p></td>" +
                    "<td><p>" + x.Pancard + "</p></td>" +
                    "<td><p>0</p></td>" +
                    "<td><p>0</p></td>" +
                    "<td><p>" + x.PancardEarn + "</p></td>" + "</tr>" +
                    "<tr>" +
                    "<td><p style='margin-bottom:0;'><img src='../../ashok-images/flybok.svg' style='width:26px;' /></p></td>" +
                    "<td><p>Flight Booking</p></td>" +
                    "<td><p>" + 0.00 + "</p></td>" +
                    "<td><p>0</p></td>" +
                    "<td><p>0</p></td>" +
                    "<td><p>" + 0.00 + "</p></td>" + "</tr>" +
                    "<tr>" +
                    "<td><p style='margin-bottom:0;'><img src='../../ashok-images/busbok.svg' style='width:26px;' /></p></td>" +
                    "<td><p>Bus Booking</p></td>" +
                    "<td><p>" + 0.00 + "</p></td>" +
                    "<td><p>0</p></td>" +
                    "<td><p>0</p></td>" +
                    "<td><p>" + 0.00 + "</p></td>" + "</tr>" +
                    "<tr>" +
                    "<td><p style='margin-bottom:0;'><img src='../../ashok-images/hotelnnj.svg' style='width:26px;' /></p></td>" +
                    "<td><p>Hotel Booking</p></td>" +
                    "<td><p>" + 0.00 + "</p></td>" +
                    "<td><p>0</p></td>" +
                    "<td><p>0</p></td>" +
                    "<td><p>" + 0.00 + "</p></td>" + "</tr>" +
                    "<tr>" +
                    "<td><p style='margin-bottom:0;'><img src='../../ashok-images/giftcrd.svg' style='width:26px;' /></p></td>" +
                    "<td><p>Gift Cards</p></td>" +
                    "<td><p>" + 0.00 + "</p></td>" +
                    "<td><p>0</p></td>" +
                    "<td><p>0</p></td>" +
                    "<td><p>" + 0.00 + "</p></td>" + "</tr>" +
                    "<tr>" +
                    "<td><p style='margin-bottom:0;'><img src='../../ashok-images/cartnu.svg' style='width:26px;' /></p></td>" +
                    "<td><p>E-Commerce</p></td>" +
                    "<td><p>" + 0.00 + "</p></td>" +
                    "<td><p>0</p></td>" +
                    "<td><p>0</p></td>" +
                    "<td><p>" + 0.00 + "</p></td>" + "</tr>" +
                    "<tr>" +
                    "<td><p style='margin-bottom:0;'><img src='../../ashok-images/shieldni.svg' style='width:26px;' /></p></td>" +
                    "<td><p>Security Services</p></td>" +
                    "<td><p>" + 0.00 + "</p></td>" +
                    "<td><p>0</p></td>" +
                    "<td><p>0</p></td>" +
                    "<td><p>" + 0.00 + "</p></td>" + "</tr>";
                $('#tabletoday').append(newRow);
                $("#donut_chart").empty();
                initDonutChart(x.Recharge, x.Moneytransfer, x.Aeps, x.Pancard);
                retailerGrossLoaded = true;
            },
            error: function (data) {
            }
        });
        return true;
    }

    function initDonutChart(rechargebill, moneytrasfer, aepstransferamount, pancardamount) {
        if (typeof Morris === "undefined" || !document.getElementById("donut_chart")) {
            return;
        }
        Morris.Donut({
            element: 'donut_chart',
            data: [
                { label: 'Recharge & bill', value: rechargebill },
                { label: 'Financial', value: moneytrasfer },
                { label: 'Aeps', value: aepstransferamount },
                { label: 'Pancard', value: pancardamount },
                { label: 'Travels', value: 0.00 },
                { label: 'Gift Cards', value: 0.00 },
                { label: 'E-Commerce', value: 0.00 },
                { label: 'Dth-Booking', value: 0.00 }
            ],
            colors: ['rgb(233, 30, 99)', 'rgb(0, 128, 255)', 'rgb(255, 152, 0)', 'rgb(0, 0, 0)', 'rgb(76, 175, 80)', 'rgb(255, 0, 0)', 'rgb(128, 128, 128)', 'rgb(121, 85, 72)'],
            formatter: function (y) { return y; }
        });
    }

    $(function () {
        $('.sevent_box0 > ul.tabs2 li').click(function () {
            var tabId = $(this).attr('data-tab');
            $('.sevent_box0 > ul.tabs2 li').removeClass('current2');
            $('.sevent_box0 .tab-content2').removeClass('current2');
            $(this).addClass('current2');
            $('#' + tabId).addClass('current2');
        });

        $('.sevent_box3').on('click', 'ul.tabs3 li[data-tab]', function (e) {
            e.preventDefault();
            var tabId = $(this).attr('data-tab');
            if (tabId) switchRetailerActivityTab(tabId);
        });

        $('.saas-dealer-month-tabs li').click(function () {
            $(this).addClass('current3').siblings().removeClass('current3');
        });

        $('#NextMonthYYY').click(function () {
            $('#myCarouselslide3').show();
            $('#myCarouselslide2').hide();
        });
        $('#CurrentMonthYYY').click(function () {
            $('#myCarouselslide2').show();
            $('#myCarouselslide3').hide();
        });

        /* Retailer notification auto-slider (4s interval, pause on hover) */
        (function () {
            var box = document.getElementById('vmRetailerNotify');
            if (!box) return;
            var slides = box.querySelectorAll('.vm-notify-slide');
            if (!slides.length) return;
            var idx = 0, timer = null;
            function show(n) {
                slides[idx].classList.remove('vm-active');
                idx = (n + slides.length) % slides.length;
                slides[idx].classList.add('vm-active');
            }
            function stop() { if (timer) { clearInterval(timer); timer = null; } }
            function restart() { stop(); if (slides.length > 1) timer = setInterval(function () { show(idx + 1); }, 4000); }
            var prev = document.getElementById('vmNotifyPrev');
            var next = document.getElementById('vmNotifyNext');
            if (prev) prev.addEventListener('click', function () { show(idx - 1); restart(); });
            if (next) next.addEventListener('click', function () { show(idx + 1); restart(); });
            box.addEventListener('mouseenter', stop);
            box.addEventListener('mouseleave', restart);
            restart();
        })();

        var errormsg = '@ViewBag.msg';
        if (errormsg != "") {
            swal("Oops!", errormsg, "error");
        }
    });
</script>
