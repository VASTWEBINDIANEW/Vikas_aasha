<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-retailer-ecomm-transaction-page saas-retailer-giftcard-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var giftFormAttrs = new Dictionary<string, object>
            {
                { "id", "retailerGiftcardForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-report-date-form", "" },
                { "data-report-from", "#retailer_gift_frm_date" },
                { "data-report-to", "#retailer_gift_to_date" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("Giftcard_Report", "Home", FormMethod.Post, giftFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home", new { area = "RETAILER" })"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Reports</li>
                        <li>Giftcard Report</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters vm-ecomm-filter-row--one-line">

                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("ddl_status", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "All status", Value = "ALL" },
                                new SelectListItem { Text = "Success", Value = "SUCCESS" },
                                new SelectListItem { Text = "Pending", Value = "PENDING" },
                                new SelectListItem { Text = "Failed", Value = "FAILED" }
                            }, new { @id = "ddl_status", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-dmt-field--operator">
                            @Html.DropDownList("Operator", ViewBag.Operator as SelectList, "Select Gift Card Operator", new { id = "Operator", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_gift_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_gift_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" name="btntype" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="retailerGiftcardTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Giftcard totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideRetailerGiftcardTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--primary">
                            <span class="vm-opr-total-card__label">Total amount</span>
                            <strong class="vm-opr-total-card__value">@totalAmount.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Success</span>
                            <strong class="vm-opr-total-card__value">@totalSuccess.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Failed</span>
                            <strong class="vm-opr-total-card__value">@totalFailed.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Pending</span>
                            <strong class="vm-opr-total-card__value">@totalPending.ToString("N2")</strong>
                        </div>
                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-gift" aria-hidden="true"></i>
                        <span>Giftcard report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong>@rowCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total" title="Total amount for current filter">
                            Total: <strong>&#8377; @totalAmount.ToString("N2")</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-ecomm-totals-btn" onclick="showRetailerGiftcardTotals()" title="Show totals" aria-expanded="false" aria-controls="retailerGiftcardTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnExportRetailerGiftcard" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDFRetailerGiftcard" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="retailerGiftcardReport" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Status</th>
                                    <th>Receiver</th>
                                    <th>User&nbsp;email</th>
                                    <th>User&nbsp;no</th>
                                    <th>Amount&nbsp;&#8377;</th>
                                    <th>Pre&nbsp;&#8377;</th>
                                    <th>Dr/Cr&nbsp;&#8377;</th>
                                    <th>Post&nbsp;&#8377;</th>
                                    <th>Request&nbsp;time</th>
                                    <th>Operator&nbsp;id</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody id="retailerGiftcardRows">
                                @if (reports.Count > 0)
                                {
                                    foreach (var item in reports)
                                    {
                                        var st = (item.status ?? "").Trim();
                                        var stu = st.ToUpper();
                                        var tone = "refund";
                                        var fa = "fa-undo";
                                        if (stu == "SUCCESS")
                                        {
                                            tone = "success";
                                            fa = "fa-check";
                                        }
                                        else if (stu == "FAILED")
                                        {
                                            tone = "failed";
                                            fa = "fa-times";
                                        }
                                        else if (stu == "PENDING")
                                        {
                                            tone = "pending";
                                            fa = "fa-clock-o";
                                        }
                                        <tr class="vm-dmt-row">
                                            <td>
                                                <span class="vm-dmt-status vm-dmt-status--@tone" title="@st"><i class="fa @fa" aria-hidden="true"></i></span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-consumer-text">@item.reciver_name</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-refno-text">@item.reciver_email</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-refno-text">@item.reciver_mobile</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(item.amount ?? 0m, 2)</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(item.rem_pre_remain ?? 0m, 2)</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(item.amount ?? 0m, 2)</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(item.rem_post_remain ?? 0m, 2)</span>
                                            </td>
                                            <td class="vm-ticket-time-cell">
                                                <span class="vm-dmt-refno-text">@(item.request_time.HasValue ? String.Format("{0:dd-MMM-yyyy HH:mm:ss}", item.request_time.Value) : "—")</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-refno-text">@item.operator_id</span>
                                            </td>
                                            <td>
                                                <button type="button" class="btn btn-primary btn-sm vm-dmt-print-btn" onclick="window.print()" title="Print"><i class="fa fa-print" aria-hidden="true"></i></button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="11" class="vm-opr-table-empty vm-dmt-table-empty">
                                            <i class="fas fa-gift" aria-hidden="true"></i>
                                            <span>No giftcard records found.</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section PostVmScripts {
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    function hideRetailerGiftcardTotals() {
        var $panel = jQuery('#retailerGiftcardTotalsPanel');
        var $btn = jQuery('.saas-retailer-giftcard-page .vm-ecomm-totals-btn');
        $panel.hide().attr('aria-hidden', 'true');
        $btn.attr('aria-expanded', 'false');
    }

    function showRetailerGiftcardTotals() {
        var $panel = jQuery('#retailerGiftcardTotalsPanel');
        var $btn = jQuery('.saas-retailer-giftcard-page .vm-ecomm-totals-btn');
        if ($panel.is(':visible')) {
            hideRetailerGiftcardTotals();
            return;
        }
        $panel.show().attr('aria-hidden', 'false');
        $btn.attr('aria-expanded', 'true');
    }

    function retailerGiftcardFilters() {
        return {
            btntype: '',
            txt_frm_date: jQuery('#retailer_gift_frm_date').val() || '',
            txt_to_date: jQuery('#retailer_gift_to_date').val() || '',
            ddl_status: jQuery('#ddl_status').val() || 'ALL',
            Operator: jQuery('#Operator').val() || '',
            ddl_top: ''
        };
    }

    function initRetailerGiftcardSelect2() {
        var $scope = jQuery('.saas-retailer-giftcard-page');
        $scope.find('#ddl_status, #Operator').each(function () {
            var $el = jQuery(this);
            if (!$el.length || !jQuery.fn.select2) {
                return;
            }
            if ($el.hasClass('select2-hidden-accessible')) {
                try { $el.select2('destroy'); } catch (e) { }
            }
            var opts = {
                width: '100%',
                dropdownParent: jQuery(document.body),
                minimumResultsForSearch: 0,
                dropdownCssClass: 'vm-admin-select2-dropdown vm-admin-select2-searchable'
            };
            if (typeof window.forceAdminSelect2 === 'function') {
                window.forceAdminSelect2($el, opts, true);
            } else if (typeof window.applyAdminSelect2 === 'function') {
                window.applyAdminSelect2($el, opts, true);
            } else {
                $el.select2(opts);
            }
        });
    }

    function initRetailerGiftcardDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initRetailerGiftcardDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm(
                '#retailerGiftcardForm',
                '#retailer_gift_frm_date',
                '#retailer_gift_to_date',
                true
            );
        }
    }

    jQuery(function () {
