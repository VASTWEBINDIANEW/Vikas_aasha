        body.saas-admin-ui .saas-retailer-giftcard-page #retailerGiftcardReport.vm-opr-data-table thead th:nth-child(8),
        body.saas-admin-ui .saas-retailer-giftcard-page #retailerGiftcardReport.vm-opr-data-table tbody td:nth-child(8) { width: 7% !important; }
        body.saas-admin-ui .saas-retailer-giftcard-page #retailerGiftcardReport.vm-opr-data-table thead th:nth-child(9),
