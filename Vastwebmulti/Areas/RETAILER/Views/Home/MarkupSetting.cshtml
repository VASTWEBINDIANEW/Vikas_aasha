@model IEnumerable<Vastwebmulti.Models.Convence_Fees>
@using System.Linq
@{
    ViewBag.Title = "MarkupSetting";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";

    var markupRows = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.Convence_Fees>();
    var markupCount = markupRows.Count;
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=43" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=22" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<style>
    /* MarkupSetting : income-page design me edit/save controls */
    body.saas-admin-ui .saas-retailer-markup-page .vm-opr-data-table td.vm-markup-amount-cell { position: relative !important; }
    body.saas-admin-ui .saas-retailer-markup-page .vm-opr-data-table .clsshide { display: none; }
    body.saas-admin-ui .saas-retailer-markup-page .vm-markup-amount-text { font-weight: 800 !important; font-variant-numeric: tabular-nums !important; }
    body.saas-admin-ui .saas-retailer-markup-page .vm-markup-edit-input {
        width: 121px !important; padding: 5px 8px !important;
        border: 1px solid #cbd5e1 !important; border-radius: 8px !important;
    }
    body.saas-admin-ui .saas-retailer-markup-page .vm-markup-edit-btn {
        background: transparent !important; border: 1px solid #bfdbfe !important;
        color: #1d4ed8 !important; border-radius: 8px !important;
        padding: 5px 20px !important; font-weight: 700 !important; cursor: pointer !important;
    }
    body.saas-admin-ui .saas-retailer-markup-page .vm-markup-edit-btn:hover { background: #eff6ff !important; }
    body.saas-admin-ui .saas-retailer-markup-page .vm-markup-save-btn {
        background: linear-gradient(135deg,#2563eb,#1d4ed8) !important;
        border: 1px solid #1e40af !important; color: #fff !important;
        border-radius: 8px !important; padding: 5px 17px !important;
        font-weight: 700 !important; cursor: pointer !important;
        box-shadow: 0 8px 20px rgba(37,99,235,.35) !important;
    }
    /* Table : sabhi 6 columns barabar size (fixed equal widths) */
    body.saas-admin-ui .saas-retailer-markup-page #markupSettingReport.vm-opr-data-table {
        table-layout: fixed !important; width: 100% !important;
    }
    body.saas-admin-ui .saas-retailer-markup-page #markupSettingReport.vm-opr-data-table thead th,
    body.saas-admin-ui .saas-retailer-markup-page #markupSettingReport.vm-opr-data-table tbody td {
        width: 16.666% !important; text-align: center !important; vertical-align: middle !important;
        white-space: nowrap !important; overflow: hidden !important; text-overflow: ellipsis !important;
    }
    @@media print {
        body.vm-markup-printing .saas-acc-toolbar,
        body.vm-markup-printing .vm-dmt-table-actions { display: none !important; }
        body.vm-markup-printing #markupSettingReport th:last-child,
        body.vm-markup-printing #markupSettingReport td:last-child { display: none !important; }
    }
</style>


<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-retailer-income-page saas-retailer-markup-page">
    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
            <div class="saas-acc-toolbar-top vm-opr-toolbar-head">
                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home", new { area = "RETAILER" })"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>My Account</li>
                    <li>Markup Setting</li>
                </ol>
            </div>
        </div>
        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-tags" aria-hidden="true"></i>
                        <span>Markup Setting</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong>@markupCount</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" id="btnExportMarkup" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDFMarkup" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="markupSettingReport" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Sr</th>
                                    <th>Particulars</th>
                                    <th>Amount</th>
                                    <th>Description</th>
                                    <th>Last Updated Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                                    <tbody>
                                        @{ var i = 1;}
                                        @foreach (var item in markupRows)
                                        {
                                            <tr role="row" class="odd htmltbl-@item.idno">
                                                <td>@i</td>
                                                <td title="@item.Role">@item.Role</td>
                                                <td class="vm-markup-amount-cell">
                                                    <span id="spans-@item.idno" class="amountfont-size clssshow vm-markup-amount-text">@item.Amount</span>
                                                    <input type="text" id="editamountmarkup-@item.idno" class="clsshide vm-markup-edit-input" />
                                                </td>
                                                <td>Description</td>
                                                <td><span id="sndte-@item.idno"> @item.Date</span></td>
                                                <td>
                                                    <button type="button" id="butedit-@item.idno" class="clssshow vm-markup-edit-btn" onclick="EditFunction('@item.idno','@item.Role')">
                                                        <span>Edit</span>
                                                    </button>
                                                    <button type="button" id="savechangeamount-@item.idno" class="clsshide clsshide-button vm-markup-save-btn" onclick="savedatamarkupsetting('@item.idno')">Save</button>
                                                </td>
                                            </tr>
                                            i++;
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
</section>
<script>
    jQuery(function () {
        jQuery('#btnExportMarkup').on('click', function (e) {
            e.preventDefault();
            var tbl = document.getElementById('markupSettingReport');
            if (!tbl) { return; }
            var html = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><meta charset="UTF-8"></head><body>' + tbl.outerHTML + '</body></html>';
            var blob = new Blob([html], { type: 'application/vnd.ms-excel' });
            var a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'MarkupSetting.xls';
            document.body.appendChild(a);
            a.click();
            setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 500);
        });
        jQuery('#btnPDFMarkup').on('click', function () {
            document.body.classList.add('vm-markup-printing');
            function done() {
                document.body.classList.remove('vm-markup-printing');
                window.removeEventListener('afterprint', done);
            }
            window.addEventListener('afterprint', done);
            window.print();
            setTimeout(function () { document.body.classList.remove('vm-markup-printing'); }, 1500);
        });
    });
</script>
<script>
    function EditFunction(id, role, amnt) {
        
        $('.clssshow').show();
        $('.clsshide').hide();
        var txtidss = 'editamountmarkup-' + id;
        var spnidsss = 'spans-' + id;
        var tbneditidsss = 'butedit-' + id;
        var tbnsaveidsss = 'savechangeamount-' + id;

        $('#' + txtidss).val($('#' + spnidsss).text()).show();
        $('#' + spnidsss).hide();
        $('#' + tbneditidsss).hide();
        $('#' + tbnsaveidsss).show();
      


    }


    function savedatamarkupsetting(idno) {

        var txtidss = 'editamountmarkup-' + idno;
        var spnidsss = 'spans-' + idno;
        var tbneditidsss = 'butedit-' + idno;
        var tbnsaveidsss = 'savechangeamount-' + idno;
        var tbnspnadate = 'sndte-' + idno;

       var amountsss=  $('#' + txtidss).val();

       


            $.ajax({
                url: '@Url.Action("MarkupSettingdgdfghfghn")',
                type: 'POST',
                data: { txtidno: idno, txtamount: amountsss },
                success: function (data) {
                    
                    if (data.status == 'success') {
                        const d = new Date(parseInt(data.datess.substring(data.datess.indexOf('(') + 1, data.datess.lastIndexOf(')'))));//new Date(data.datess.match(/\d+/)[0] * 1);
                        // const formattedDate = d.getFullYear() + '-' + ("0" + (d.getMonth() + 1)).slice(-2) + '-' + ("0" + d.getDate()).slice(-2)
                     //   console.log(d.toTimeString());
                        // var ddd = data.datess.toDateString();
                        $("#" + spnidsss).slideUp("fast").text(data.amnt);
                        $("#" + tbnspnadate).text(d.toLocaleString());
                        $('.clssshow').show();
                        $('.clsshide').hide();
                    }
                    else {
                        alert('some thing went wrong');
                        location.reload();
                    }
                }
            });







    }


</script>
