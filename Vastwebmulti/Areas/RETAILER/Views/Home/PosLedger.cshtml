        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table tfoot td:nth-child(2) { width: 16% !important; }
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table thead th:nth-child(3),
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table tbody td:nth-child(3),
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table tfoot td:nth-child(3) { width: 8% !important; }
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table thead th:nth-child(4),
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table tbody td:nth-child(4),
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table tfoot td:nth-child(4) { width: 9% !important; }
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table thead th:nth-child(5),
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table tbody td:nth-child(5),
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table tfoot td:nth-child(5) { width: 9% !important; }
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table thead th:nth-child(6),
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table tbody td:nth-child(6),
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table tfoot td:nth-child(6) { width: 14% !important; }
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table thead th:nth-child(7),
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table tbody td:nth-child(7),
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table tfoot td:nth-child(7) { width: 8% !important; }
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table thead th:nth-child(8),
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table tbody td:nth-child(8),
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table tfoot td:nth-child(8) { width: 8% !important; }
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table thead th:nth-child(9),
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table tbody td:nth-child(9),
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table tfoot td:nth-child(9) { width: 8% !important; }
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table thead th:nth-child(10),
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table tbody td:nth-child(10),
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table tfoot td:nth-child(10) { width: 8% !important; }
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table thead th:nth-child(11),
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table tbody td:nth-child(11),
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table tfoot td:nth-child(11) { width: 8% !important; }
    }
    /* Mobile + tablet (<=1023px): natural widths, full text, horizontal scroll */
    @@media (max-width: 1023.98px) {
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table {
            width: max-content !important;
            min-width: 1200px !important;
            max-width: none !important;
            table-layout: auto !important;
        }
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table thead tr,
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table tbody tr,
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table tfoot tr {
            display: table-row !important;
        }
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table thead th,
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table tbody td,
        body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport.vm-opr-data-table tfoot td {
            display: table-cell !important;
            width: auto !important;
            min-width: 0 !important;
            max-width: none !important;
            white-space: nowrap !important;
            overflow: visible !important;
            text-overflow: clip !important;
        }
        body.saas-admin-ui .saas-retailer-pos-page .vm-opr-table-scroll {
            overflow-x: auto !important;
