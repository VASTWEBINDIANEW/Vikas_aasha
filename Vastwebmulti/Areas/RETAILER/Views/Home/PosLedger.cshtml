</style>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-retailer-ecomm-transaction-page saas-retailer-pos-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var posFormAttrs = new Dictionary<string, object>
            {
                { "id", "retailerPosForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-report-date-form", "" },
                { "data-report-from", "#retailer_pos_frm_date" },
                { "data-report-to", "#retailer_pos_to_date" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("PosLedger", "Home", FormMethod.Post, posFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home", new { area = "RETAILER" })"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li><a href="@Url.Action("RetailerLedger", "Home")">Retailer Ledger</a></li>
                        <li>POS Ledger</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters vm-ecomm-filter-row--one-line">

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_pos_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_pos_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="retailerPosTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>POS totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideRetailerPosTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Total credit</span>
                            <strong class="vm-opr-total-card__value">&#8377; @totalCredit.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Total debit</span>
                            <strong class="vm-opr-total-card__value">&#8377; @totalDebit.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Records</span>
                            <strong class="vm-opr-total-card__value">@rowCount</strong>
                        </div>
                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-credit-card" aria-hidden="true"></i>
                        <span>POS ledger</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong>@rowCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total" title="Total credit">
                            Cr: <strong>&#8377; @totalCredit.ToString("N2")</strong>
                        </span>
                        <span class="vm-radiant-inline-total" title="Total debit">
                            Dr: <strong>&#8377; @totalDebit.ToString("N2")</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <a class="vm-ledger-nav" href="@Url.Action("RetailerLedger", "Home")" title="Back to main ledger"><i class="fas fa-arrow-left" aria-hidden="true"></i> Main Ledger</a>
                            <a class="vm-ledger-nav" href="@Url.Action("CMSLedger", "Home")" title="CMS Ledger"><i class="fas fa-university" aria-hidden="true"></i> CMS Ledger</a>
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-ecomm-totals-btn" onclick="showRetailerPosTotals()" title="Show totals" aria-expanded="false" aria-controls="retailerPosTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnExportRetailerPos" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDFRetailerPos" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="retailerPosLedgerReport" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>S.N.</th>
                                    <th>Details</th>
                                    <th>Amount &#8377;</th>
                                    <th>POS Bal Pre</th>
                                    <th>POS Bal Post</th>
                                    <th>Transaction Date</th>
                                    <th>Credit</th>
                                    <th>Debit</th>
                                    <th>Comm</th>
                                    <th>GST</th>
                                    <th>TDS</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (reports.Count > 0)
                                {
                                    int i = 1;
                                    foreach (var item in reports)
                                    {
                                        decimal cr = 0m, dr = 0m;
                                        try { cr = Convert.ToDecimal(item.cr); } catch { }
                                        try { dr = Convert.ToDecimal(item.dr); } catch { }
                                        string dstr = "";
                                        try { dstr = Convert.ToDateTime(item.ledgerdate).ToString("d-MMM-yyyy HH:mm:ss"); } catch { dstr = Convert.ToString(item.ledgerdate); }
                                        var tone = cr > 0 ? "vm-ledger-row--credit" : (dr > 0 ? "vm-ledger-row--debit" : "");
                                        <tr class="vm-dmt-row vm-ledger-row @tone">
                                            <td><span class="vm-dmt-refno-text">@i</span></td>
                                            <td><span class="vm-dmt-consumer-text" title="@item.Details">@item.Details</span></td>
                                            <td><span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @item.Amount</span></td>
                                            <td><span class="vm-dmt-amount-text">@item.remainpre</span></td>
                                            <td><span class="vm-dmt-amount-text">@item.remainpost</span></td>
                                            <td class="vm-ticket-time-cell"><span class="vm-dmt-refno-text">@dstr</span></td>
                                            <td>
                                                @if (cr > 0)
                                                {
                                                    <span class="vm-ledger-cd vm-ledger-cd--cr"><i class="fa fa-arrow-up" aria-hidden="true"></i>@item.cr</span>
                                                }
                                                else
                                                {
                                                    <span class="vm-dmt-amount-text">@item.cr</span>
                                                }
                                            </td>
                                            <td>
                                                @if (dr > 0)
                                                {
                                                    <span class="vm-ledger-cd vm-ledger-cd--dr"><i class="fa fa-arrow-down" aria-hidden="true"></i>@item.dr</span>
                                                }
                                                else
                                                {
                                                    <span class="vm-dmt-amount-text">@item.dr</span>
                                                }
                                            </td>
                                            <td><span class="vm-dmt-amount-text">@item.comm</span></td>
                                            <td><span class="vm-dmt-amount-text">@item.gst</span></td>
                                            <td><span class="vm-dmt-amount-text">@item.tds</span></td>
                                        </tr>
                                        i++;
                                    }
                                }
                                else
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="11" class="vm-opr-table-empty vm-dmt-table-empty">
                                            <i class="fas fa-credit-card" aria-hidden="true"></i>
                                            <span>No POS ledger records found.</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            @if (reports.Count > 0)
                            {
                                <tfoot>
                                    <tr class="vm-dmt-row vm-dmt-total-row">
                                        <td><span class="vm-dmt-amount-text"><strong>Total</strong></span></td>
                                        <td></td>
                                        <td><span class="vm-dmt-amount-text"><strong>@Model.Sum(a => a.Amount)</strong></span></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td><span class="vm-dmt-amount-text"><strong>@Model.Sum(a => a.cr)</strong></span></td>
                                        <td><span class="vm-dmt-amount-text"><strong>@Model.Sum(a => a.dr)</strong></span></td>
                                        <td><span class="vm-dmt-amount-text"><strong>@Model.Sum(a => a.comm)</strong></span></td>
                                        <td><span class="vm-dmt-amount-text"><strong>@Model.Sum(a => a.gst)</strong></span></td>
                                        <td><span class="vm-dmt-amount-text"><strong>@Model.Sum(a => a.tds)</strong></span></td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section PostVmScripts {
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    function hideRetailerPosTotals() {
        var $panel = jQuery('#retailerPosTotalsPanel');
        var $btn = jQuery('.saas-retailer-pos-page .vm-ecomm-totals-btn');
        $panel.hide().attr('aria-hidden', 'true');
        $btn.attr('aria-expanded', 'false');
    }

    function showRetailerPosTotals() {
        var $panel = jQuery('#retailerPosTotalsPanel');
        var $btn = jQuery('.saas-retailer-pos-page .vm-ecomm-totals-btn');
        if ($panel.is(':visible')) {
            hideRetailerPosTotals();
            return;
        }
        $panel.show().attr('aria-hidden', 'false');
        $btn.attr('aria-expanded', 'true');
    }

    function retailerPosDates() {
        return {
            txt_frm_date: jQuery('#retailer_pos_frm_date').val() || '',
            txt_to_date: jQuery('#retailer_pos_to_date').val() || ''
        };
    }

    function initRetailerPosDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initRetailerPosDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm(
                '#retailerPosForm',
                '#retailer_pos_frm_date',
                '#retailer_pos_to_date',
                true
            );
        }
    }

    jQuery(function () {
        initRetailerPosDatepickers();
        window.setTimeout(initRetailerPosDatepickers, 150);
        jQuery('#btnExportRetailerPos').on('click', function (e) {
            e.preventDefault();
            var d = retailerPosDates();
            location.href = '@Url.Action("ExcelRetailerposreport", "Home")?txt_frm_date=' + encodeURIComponent(d.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(d.txt_to_date);
        });
        jQuery('#btnPDFRetailerPos').on('click', function () {
            var d = retailerPosDates();
            window.open('@Url.Action("PDFRetailerposreport", "Home")?txt_frm_date=' + encodeURIComponent(d.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(d.txt_to_date), '_blank');
        });
    });
</script>
}
