    body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport tbody tr:hover { background: #f6f9ff !important; }
    body.saas-admin-ui .saas-retailer-pos-page #retailerPosLedgerReport tfoot tr.vm-dmt-total-row { background: #eef2ff !important; }
