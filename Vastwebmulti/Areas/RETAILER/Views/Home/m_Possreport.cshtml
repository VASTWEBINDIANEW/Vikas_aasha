@model IEnumerable<Vastwebmulti.Models.Mpos_Report_New_paging_Result>
@{
    ViewBag.Title = "M-POS Report";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";
    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    var selStatus = (Request["ddl_status"] ?? "").Trim();
    if (selStatus == "" || selStatus == "Status") { selStatus = "ALL"; }
    var selBankId = (Request["BankId"] ?? "").Trim();
    var selAadhar = (Request["aadhar"] ?? "").Trim();
    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=34" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=38" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<style>
    /* M-POS text inputs are not selects — remove select chevron */
    body.saas-admin-ui .saas-dmt-report-page .vm-dmt-filter-row input.vm-mposs-text-input.form-control {
        background-image: none !important;
        cursor: text !important;
        padding: 0 12px !important;
    }
    body.saas-admin-ui .saas-retailer-mposs-report-page #mmm .vm-dmt-txntype {
        display: inline-block;
        vertical-align: middle;
        margin-left: 6px;
        font-size: 0.72rem;
        font-weight: 700;
        color: #334155;
        white-space: nowrap;
    }
</style>

<div id="loadermoney" class="vm-dmt-loader" style="display:none;" aria-hidden="true">
    <div class="vm-dmt-loader__panel" role="status" aria-live="polite" aria-label="Processing">
        <div class="vm-dmt-table-loader__spinner" aria-hidden="true"></div>
        <span class="vm-dmt-loader__text">Please wait…</span>
    </div>
</div>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-retailer-mposs-report-page">
    <div class="container-fluid vm-opr-page-shell">

        @{
            var mpossFormAttrs = new Dictionary<string, object>
            {
                { "id", "retailerMpossReportForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-report-date-form", "" },
                { "data-report-from", "#retailer_mposs_frm_date" },
                { "data-report-to", "#retailer_mposs_to_date" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("m_Possreport", "Home", FormMethod.Post, mpossFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Financial Services</li>
                        <li>M-POS Report</li>
                    </ol>
                    <div class="vm-dmt-fin-nav-row">
                        @Html.Partial("_menuFinicalReport")
                    </div>
                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="retailerMpossTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>M-POS totals (loaded rows)</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideRetailerMpossTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Success</span>
                            <strong class="vm-opr-total-card__value" id="retailerMpossSuccess">&#8377; 0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Failed</span>
                            <strong class="vm-opr-total-card__value" id="retailerMpossFailed">&#8377; 0.00</strong>
                        </div>
                    </div>
                </div>

                <div class="vm-rpt-filters-panel">
                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-rpt-filters-panel__bar">
                        <div class="vm-opr-field vm-dmt-field">
                            @Html.TextBox("BankId", selBankId, new { @class = "form-control vm-mposs-text-input", placeholder = "Bank ID", autocomplete = "off", id = "retailerMpossBankId", title = "Bank ID" })
                        </div>
                        <div class="vm-opr-field vm-dmt-field">
                            @Html.TextBox("aadhar", selAadhar, new { @class = "form-control vm-mposs-text-input", placeholder = "Aadhaar / Bank ID / Amount", autocomplete = "off", id = "retailerMpossAadhar", title = "Aadhaar / Bank ID / Amount" })
                        </div>
                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("ddl_status", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "All Status", Value = "ALL", Selected = (selStatus == "ALL") },
                                new SelectListItem { Text = "Success", Value = "SUCCESS", Selected = selStatus == "SUCCESS" },
                                new SelectListItem { Text = "Pending", Value = "PENDING", Selected = selStatus == "PENDING" },
                                new SelectListItem { Text = "Failed", Value = "FAILED", Selected = selStatus == "FAILED" }
                            }, new { id = "ddl_status", @class = "vm-opr-select vm-dmt-select form-control", title = "Status" })
                        </div>
                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_mposs_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_mposs_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-credit-card" aria-hidden="true"></i>
                        <span>M-POS transactions</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn" onclick="FindtotalRetailerMposs()" title="Show totals" aria-expanded="false" aria-controls="retailerMpossTotalsPanel"><i class="fas fa-chart-pie" aria-hidden="true"></i></button>
                            <button type="button" id="btnRetailerMpossExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel"><i class="fas fa-file-excel" aria-hidden="true"></i> Excel</button>
                            <button type="button" id="btnRetailerMpossPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF"><i class="fas fa-file-pdf" aria-hidden="true"></i> PDF</button>
                        </div>
                    </div>
                </div>
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="mmm" class="table vm-opr-data-table" cellspacing="0" style="width:100%;">
                            <thead>
                                <tr>
                                    <th>S.R.</th>
                                    <th>Status</th>
                                    <th>M-POS ID</th>
                                    <th>Brand</th>
                                    <th>Card Type</th>
                                    <th>Card Number</th>
                                    <th>Card Holder</th>
                                    <th>Payment ID</th>
                                    <th>User Fee</th>
                                    <th>Earn &#8377;</th>
                                    <th>Pre &#8377;</th>
                                    <th>Cr Dr</th>
                                    <th>Post &#8377;</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody id="retailerMpossRows">
                                @{ Html.RenderAction("_m_Possreport", "Home", new { txt_frm_date = frmDate, txt_to_date = toDate, ddl_status = selStatus }); }
                            </tbody>
                        </table>
                        <div id="retailerMpossLoading" class="vm-opr-table-loading vm-dmt-table-loading" style="display:none;">
                            <div class="vm-dmt-table-loader" role="status" aria-live="polite" aria-label="Loading transactions">
                                <div class="vm-dmt-table-loader__spinner" aria-hidden="true"></div>
                                <span class="vm-dmt-table-loader__text">Loading transactions…</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<div class="modal fade vm-opr-modal" id="retailerMpossDetailModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content vm-opr-modal-card">
            <div class="modal-header vm-opr-modal-head">
                <h4 class="modal-title"><i class="fas fa-receipt" aria-hidden="true"></i> M-POS transaction detail</h4>
                <button type="button" class="close vm-opr-modal-close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body vm-opr-modal-body">
                <table class="table vm-opr-modal-table" cellspacing="0">
                    <tr><th>Merchant ID</th><td id="mpossD_MerchantID">-</td></tr>
                    <tr><th>Bank Merchant ID</th><td id="mpossD_BankMerchantID">-</td></tr>
                    <tr><th>Bank Terminal ID</th><td id="mpossD_BankTerminalID">-</td></tr>
                    <tr><th>Invoice No</th><td id="mpossD_InvoiceNo">-</td></tr>
                    <tr><th>Merchant Address</th><td id="mpossD_MerchantAddress">-</td></tr>
                    <tr><th>Request Time</th><td id="mpossD_RequestTime">-</td></tr>
                    <tr><th>Retailer Comm</th><td id="mpossD_RetailerComm">-</td></tr>
                    <tr><th>Retailer GST</th><td id="mpossD_RetailerGST">-</td></tr>
                    <tr><th>Retailer Income</th><td id="mpossD_RetailerIncome">-</td></tr>
                </table>
            </div>
            <div class="modal-footer vm-opr-modal-foot">
                <button type="button" class="saas-acc-btn" data-dismiss="modal">Close</button>
                <button type="button" class="saas-acc-btn saas-acc-btn--search" onclick="window.print()"><i class="material-icons">print</i> Print</button>
            </div>
        </div>
    </div>
</div>

@section PostVmScripts {
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    var retailerMpossPageIndex = 2;
    var retailerMpossNoMore = false;
    var retailerMpossBusy = false;

    function retailerMpossFilters() {
        return {
            txt_frm_date: jQuery('#retailer_mposs_frm_date').val() || '',
            txt_to_date: jQuery('#retailer_mposs_to_date').val() || '',
            ddl_status: jQuery('#ddl_status').val() || 'ALL'
        };
    }

    function renumberRetailerMpossSr() {
        jQuery('#retailerMpossRows tr.vm-dmt-row').each(function (i) {
            jQuery(this).find('.vm-dmt-sr-cell').first().text(i + 1);
        });
    }

    function hideRetailerMpossTotals() {
        var $panel = jQuery('#retailerMpossTotalsPanel');
        var $btn = jQuery('.vm-dmt-totals-btn');
        $panel.removeClass('is-open').hide().attr('aria-hidden', 'true');
        $btn.removeClass('is-active').attr({ title: 'Show totals', 'aria-expanded': 'false' });
    }

    function calcRetailerMpossTotals() {
        var success = 0, failed = 0;
        jQuery('#retailerMpossRows tr.vm-dmt-row').each(function () {
            var amt = parseFloat(jQuery(this).attr('data-amount')) || 0;
            var st = (jQuery(this).attr('data-status') || '').toUpperCase();
            if (st === 'SUCCESS') { success += amt; } else { failed += amt; }
        });
        jQuery('#retailerMpossSuccess').html('&#8377; ' + success.toFixed(2));
        jQuery('#retailerMpossFailed').html('&#8377; ' + failed.toFixed(2));
    }

    function FindtotalRetailerMposs() {
        var $panel = jQuery('#retailerMpossTotalsPanel');
        var $btn = jQuery('.vm-dmt-totals-btn');
        if ($panel.hasClass('is-open')) {
            hideRetailerMpossTotals();
            return;
        }
        $panel.addClass('is-open').show().attr('aria-hidden', 'false');
        $btn.addClass('is-active').attr({ title: 'Hide totals', 'aria-expanded': 'true' });
        calcRetailerMpossTotals();
    }

    function showRetailerMpossDetail(btn) {
        var $btn = jQuery(btn);
        jQuery('#mpossD_MerchantID').text($btn.data('merchantid') || '-');
        jQuery('#mpossD_BankMerchantID').text($btn.data('bankmerchantid') || '-');
        jQuery('#mpossD_BankTerminalID').text($btn.data('bankterminalid') || '-');
        jQuery('#mpossD_InvoiceNo').text($btn.data('invoiceno') || '-');
        jQuery('#mpossD_MerchantAddress').text($btn.data('merchantaddress') || '-');
        jQuery('#mpossD_RequestTime').text($btn.data('requesttime') || '-');
        jQuery('#mpossD_RetailerComm').text($btn.data('retailercomm') || '-');
        jQuery('#mpossD_RetailerGST').text($btn.data('retailergst') || '-');
        jQuery('#mpossD_RetailerIncome').text($btn.data('retailerincome') || '-');
        jQuery('#retailerMpossDetailModal').modal('show');
    }

    function initRetailerMpossSelect2() {
        jQuery('#ddl_status').each(function () {
            var $el = jQuery(this);
            if (!$el.length || !jQuery.fn.select2) { return; }
            if ($el.hasClass('select2-hidden-accessible')) {
                try { $el.select2('destroy'); } catch (e) { }
            }
            $el.select2({ width: '100%', minimumResultsForSearch: 6 });
        });
    }

    function initRetailerMpossDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initRetailerMpossDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm(
                '#retailerMpossReportForm',
                '#retailer_mposs_frm_date',
                '#retailer_mposs_to_date',
                true
            );
        }
    }

    jQuery(function () {
        initRetailerMpossSelect2();
        initRetailerMpossDatepickers();
        window.setTimeout(initRetailerMpossDatepickers, 150);
        renumberRetailerMpossSr();

        jQuery('#btnRetailerMpossExport').on('click', function () {
            var f = retailerMpossFilters();
            location.href = '@Url.Action("Execl_m_Poss_Report", "Home")?txt_frm_date=' + encodeURIComponent(f.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(f.txt_to_date) + '&ddl_status=' + encodeURIComponent(f.ddl_status);
        });
        jQuery('#btnRetailerMpossPDF').on('click', function () {
            var f = retailerMpossFilters();
            window.open('@Url.Action("PDF_M_PossReport", "Home")?txt_frm_date=' + encodeURIComponent(f.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(f.txt_to_date) + '&ddl_status=' + encodeURIComponent(f.ddl_status), '_blank');
        });

        jQuery(window).on('scroll', function () {
            if (retailerMpossNoMore || retailerMpossBusy) { return; }
            var nearBottom = jQuery(window).scrollTop() + jQuery(window).height() > jQuery(document).height() - 400;
            if (!nearBottom) { return; }
            retailerMpossBusy = true;
            jQuery('#retailerMpossLoading').show();
            var f = retailerMpossFilters();
            jQuery.post('@Url.Action("InfiniteScroll_mposs", "Home")',
                { pageindex: retailerMpossPageIndex, txt_frm_date: f.txt_frm_date, txt_to_date: f.txt_to_date, ddl_status: f.ddl_status },
                function (data) {
                    retailerMpossPageIndex = retailerMpossPageIndex + 1;
                    retailerMpossNoMore = data.NoMoredata;
                    var html = data.HTMLString || '';
                    if (html && html.indexOf('vm-opr-table-empty-row') === -1) {
                        jQuery('#retailerMpossRows .vm-opr-table-empty-row').remove();
                        jQuery('#retailerMpossRows').append(html);
                    } else {
                        retailerMpossNoMore = true;
                    }
                    renumberRetailerMpossSr();
                    if (jQuery('#retailerMpossTotalsPanel').hasClass('is-open')) {
                        calcRetailerMpossTotals();
                    }
                    jQuery('#retailerMpossLoading').hide();
                    retailerMpossBusy = false;
                })
                .fail(function () {
                    jQuery('#retailerMpossLoading').hide();
                    retailerMpossBusy = false;
                });
        });
    });
</script>
}
