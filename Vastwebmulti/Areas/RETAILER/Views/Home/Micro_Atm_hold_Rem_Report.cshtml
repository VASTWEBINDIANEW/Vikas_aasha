@model IEnumerable<Vastwebmulti.Models.Show_MicroAtm_Unload_report_Result>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Micro ATM Hold Amount Report";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";

    var reports = (Model ?? Enumerable.Empty<Vastwebmulti.Models.Show_MicroAtm_Unload_report_Result>()).ToList();
    var rowCount = reports.Count;
    decimal totalAmount = reports.Sum(m => m.amount ?? 0m);
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=43" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=22" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<style>
    /* Desktop (>=1024px): fit-to-width, no scroll, tight columns */
    @@media (min-width: 1024px) {
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table {
            width: 100% !important;
            min-width: 0 !important;
            max-width: 100% !important;
            table-layout: fixed !important;
        }
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table thead tr,
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table tbody tr {
            display: table-row !important;
        }
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table thead th,
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table tbody td {
            display: table-cell !important;
            min-width: 0 !important;
            max-width: none !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            white-space: nowrap !important;
        }
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table thead th:nth-child(1),
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table tbody td:nth-child(1) { width: 8% !important; }
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table thead th:nth-child(2),
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table tbody td:nth-child(2) { width: 12% !important; }
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table thead th:nth-child(3),
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table tbody td:nth-child(3) { width: 10% !important; }
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table thead th:nth-child(4),
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table tbody td:nth-child(4) { width: 10% !important; }
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table thead th:nth-child(5),
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table tbody td:nth-child(5) { width: 9% !important; }
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table thead th:nth-child(6),
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table tbody td:nth-child(6) { width: 10% !important; }
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table thead th:nth-child(7),
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table tbody td:nth-child(7) { width: 11% !important; }
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table thead th:nth-child(8),
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table tbody td:nth-child(8) { width: 12% !important; }
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table thead th:nth-child(9),
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table tbody td:nth-child(9) { width: 8% !important; }
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table thead th:nth-child(10),
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table tbody td:nth-child(10) { width: 10% !important; }
    }
    /* Mobile + tablet (<=1023px): natural widths, full text, horizontal scroll */
    @@media (max-width: 1023.98px) {
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table {
            width: max-content !important;
            min-width: 1050px !important;
            max-width: none !important;
            table-layout: auto !important;
        }
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table thead tr,
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table tbody tr {
            display: table-row !important;
        }
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table thead th,
        body.saas-admin-ui .saas-retailer-microhold-page #retailerMicroHoldReport.vm-opr-data-table tbody td {
            display: table-cell !important;
            width: auto !important;
            min-width: 0 !important;
            max-width: none !important;
            white-space: nowrap !important;
            overflow: visible !important;
            text-overflow: clip !important;
        }
        body.saas-admin-ui .saas-retailer-microhold-page .vm-opr-table-scroll {
            overflow-x: auto !important;
        }
    }
</style>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-retailer-ecomm-transaction-page saas-retailer-microhold-page">

    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

            <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line">

                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home", new { area = "RETAILER" })"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>Reports</li>
                    <li>Micro ATM Hold Amount</li>
                </ol>

            </div>

            <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="retailerMicroHoldTotalsPanel" style="display:none;" aria-hidden="true">
                <div class="vm-dmt-totals-head">
                    <div class="vm-dmt-totals-head__title">
                        <i class="fas fa-chart-pie" aria-hidden="true"></i>
                        <span>Hold amount totals</span>
                    </div>
                    <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideRetailerMicroHoldTotals()" title="Hide totals" aria-label="Hide totals">
                        <i class="fas fa-chevron-up" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                    <div class="vm-opr-total-card vm-opr-total-card--primary">
                        <span class="vm-opr-total-card__label">Total amount</span>
                        <strong class="vm-opr-total-card__value" id="retailerMicroHoldTotal">&#8377; 0.00</strong>
                    </div>
                    <div class="vm-opr-total-card vm-opr-total-card--pending">
                        <span class="vm-opr-total-card__label">Hold</span>
                        <strong class="vm-opr-total-card__value" id="retailerMicroHoldHold">&#8377; 0.00</strong>
                    </div>
                    <div class="vm-opr-total-card vm-opr-total-card--success">
                        <span class="vm-opr-total-card__label">Un-hold</span>
                        <strong class="vm-opr-total-card__value" id="retailerMicroHoldUnhold">&#8377; 0.00</strong>
                    </div>
                </div>
            </div>

        </div>

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-pause-circle" aria-hidden="true"></i>
                        <span>Micro ATM hold amount</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong>@rowCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total" title="Total amount">
                            Total: <strong>&#8377; @totalAmount.ToString("N2")</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-ecomm-totals-btn" onclick="showRetailerMicroHoldTotals()" title="Show totals" aria-expanded="false" aria-controls="retailerMicroHoldTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnExportRetailerMicroHold" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDFRetailerMicroHold" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="retailerMicroHoldReport" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Status</th>
                                    <th>Bank&nbsp;RRN</th>
                                    <th>Txn&nbsp;type</th>
                                    <th>Payment&nbsp;method</th>
                                    <th>Amount&nbsp;&#8377;</th>
                                    <th>Card&nbsp;pay&nbsp;type</th>
                                    <th>Masked&nbsp;pan</th>
                                    <th>Txn&nbsp;time</th>
                                    <th>Network</th>
                                    <th>Request&nbsp;id</th>
                                </tr>
                            </thead>
                            <tbody id="retailerMicroHoldRows">
                                @if (reports.Count > 0)
                                {
                                    foreach (var item in reports)
                                    {
                                        var isHold = item.IsHold == true;
                                        var tone = isHold ? "pending" : "success";
                                        var fa = isHold ? "fa-pause-circle" : "fa-check-circle";
                                        var label = isHold ? "Hold" : "Un_Hold";
                                        <tr class="vm-dmt-row" data-amount="@(item.amount ?? 0m)" data-hold="@(isHold ? "1" : "0")">
                                            <td>
                                                <span class="vm-dmt-status vm-dmt-status--@tone" title="@label"><i class="fa @fa" aria-hidden="true"></i></span>
                                                <span class="vm-dmt-refno-text">@label</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-refno-text">@item.rrn</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-refno-text">@item.transaction_type</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-refno-text">@item.payment_method</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(item.amount ?? 0m, 2)</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-refno-text">@item.card_payment_type</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-refno-text">@item.masked_pan</span>
                                            </td>
                                            <td class="vm-ticket-time-cell">
                                                <span class="vm-dmt-refno-text">@(item.transtime.HasValue ? String.Format("{0:dd-MMM-yyyy HH:mm:ss}", item.transtime.Value) : "—")</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-refno-text">@item.network</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-refno-text">@item.Requestid</span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="10" class="vm-opr-table-empty vm-dmt-table-empty">
                                            <i class="fas fa-pause-circle" aria-hidden="true"></i>
                                            <span>No hold amount records found.</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section PostVmScripts {
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    function hideRetailerMicroHoldTotals() {
        var $panel = jQuery('#retailerMicroHoldTotalsPanel');
        var $btn = jQuery('.saas-retailer-microhold-page .vm-ecomm-totals-btn');
        $panel.hide().attr('aria-hidden', 'true');
        $btn.attr('aria-expanded', 'false');
    }

    function showRetailerMicroHoldTotals() {
        var $panel = jQuery('#retailerMicroHoldTotalsPanel');
        var $btn = jQuery('.saas-retailer-microhold-page .vm-ecomm-totals-btn');
        if ($panel.is(':visible')) {
            hideRetailerMicroHoldTotals();
            return;
        }
        var total = 0, hold = 0, unhold = 0;
        jQuery('#retailerMicroHoldRows tr.vm-dmt-row').each(function () {
            var amt = parseFloat(jQuery(this).attr('data-amount')) || 0;
            total += amt;
            if (jQuery(this).attr('data-hold') === '1') { hold += amt; }
            else { unhold += amt; }
        });
        jQuery('#retailerMicroHoldTotal').html('&#8377; ' + total.toFixed(2));
        jQuery('#retailerMicroHoldHold').html('&#8377; ' + hold.toFixed(2));
        jQuery('#retailerMicroHoldUnhold').html('&#8377; ' + unhold.toFixed(2));
        $panel.show().attr('aria-hidden', 'false');
        $btn.attr('aria-expanded', 'true');
    }

    function downloadRetailerMicroHoldExcel() {
        var table = document.getElementById('retailerMicroHoldReport');
        if (!table || !table.tBodies || !table.tBodies[0] || table.tBodies[0].rows.length === 0) {
            alert('No records to export.');
            return;
        }
        var html = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><meta charset="UTF-8"></head><body>' + table.outerHTML + '</body></html>';
        var blob = new Blob(['\ufeff' + html], { type: 'application/vnd.ms-excel' });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'Micro_Atm_hold_Rem_Report.xls';
        document.body.appendChild(a);
        a.click();
        setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 100);
    }

    jQuery(function () {
        jQuery('#btnExportRetailerMicroHold').on('click', function (e) {
            e.preventDefault();
            downloadRetailerMicroHoldExcel();
        });
        jQuery('#btnPDFRetailerMicroHold').on('click', function () {
            window.print();
        });
    });
</script>
}
