@{
    Layout = null;
}
<nav class="vm-fin-nav vm-fin-nav--pill vm-fin-nav--single-line" id="fin-report-nav" aria-label="Financial service reports">
    <ul class="vm-fin-nav__list" id="fin-report-nav-list">
        <li>
            <a class="vm-fin-nav__link" href="@Url.Action("Money_Transfer_Report", "Home")" title="IMPS/NEFT">
                <i class="fas fa-exchange-alt vm-fin-nav__ico" aria-hidden="true"></i>
                <span>IMPS/NEFT</span>
            </a>
        </li>
        <li>
            <a class="vm-fin-nav__link" href="@Url.Action("m_Possreport", "Home")" title="M-POS">
                <i class="fas fa-credit-card vm-fin-nav__ico" aria-hidden="true"></i>
                <span>M-POS</span>
            </a>
        </li>
        <li>
            <a class="vm-fin-nav__link" href="@Url.Action("AepsReport", "Home")" title="AEPS">
                <i class="fas fa-fingerprint vm-fin-nav__ico" aria-hidden="true"></i>
                <span>AEPS</span>
            </a>
        </li>
        <li>
            <a class="vm-fin-nav__link" href="@Url.Action("AepsUPIReport", "Home")" title="AEPS UPI">
                <i class="fas fa-university vm-fin-nav__ico" aria-hidden="true"></i>
                <span>AEPS UPI</span>
            </a>
        </li>
        <li>
            <a class="vm-fin-nav__link" href="@Url.Action("AepsChargesReprt", "Home")" title="Aeps Charges">
                <i class="fas fa-file-invoice-dollar vm-fin-nav__ico" aria-hidden="true"></i>
                <span>Aeps Charges</span>
            </a>
        </li>
        <li>
            <a class="vm-fin-nav__link" href="@Url.Action("TokenPurchaseReport_new", "PANCARD")" title="Pan Card">
                <i class="fas fa-id-card vm-fin-nav__ico" aria-hidden="true"></i>
                <span>Pan Card</span>
            </a>
        </li>
        <li>
            <a class="vm-fin-nav__link" href="@Url.Action("MIcroAtmReport", "Home")" title="Micro ATM">
                <i class="fas fa-university vm-fin-nav__ico" aria-hidden="true"></i>
                <span>Micro ATM</span>
            </a>
        </li>
        <li>
            <a class="vm-fin-nav__link" href="@Url.Action("CashDepositReport", "Home")" title="Cash Deposit">
                <i class="fas fa-money-bill-wave vm-fin-nav__ico" aria-hidden="true"></i>
                <span>Cash Deposit</span>
            </a>
        </li>
    </ul>
</nav>
<script>
    (function () {
        try {
            var nav = document.getElementById('fin-report-nav-list');
            if (!nav) { return; }
            var current = (window.location.pathname || '').toLowerCase().replace(/\/+$/, '');
            var links = nav.querySelectorAll('a.vm-fin-nav__link');
            var best = null, bestLen = 0;
            for (var i = 0; i < links.length; i++) {
                var href = (links[i].getAttribute('href') || '').toLowerCase().replace(/\?.*$/, '').replace(/#.*$/, '').replace(/\/+$/, '');
                if (!href || href.indexOf('javascript:') === 0) { continue; }
                if (current === href || current.indexOf(href) !== -1 || href.indexOf(current) !== -1) {
                    if (href.length > bestLen) { bestLen = href.length; best = links[i]; }
                }
            }
            if (best) { best.classList.add('is-active'); }
        } catch (e) { }
    })();
</script>
