        if (amount != "") {
            if (amount >= 100 && amount <= 1000) {
                $("#overlay").fadeIn(300);
                $.ajax({
                    url: '@Url.Action("RadaintUPIATMSendOTP", "Home")',
                    cache: false,
                    data: { amount },
                    type: "POST",
                    success: function (data) {
                        $("#overlay").fadeOut(300);
                        var dataout = JSON.parse(data);
                        $('#hiderefid').val(dataout.refid)
                        $('#hideotprefid').val(dataout.otpRef_id)
                        var msg = dataout.msg;
                        if (msg == "OK") {
                            document.getElementById("txtamount").readOnly = true;
                            $('#divotp').show();
                            $('#createotp').hide();
                            $('#submitotp').show();
                        }
                        else {
                            $('#txtmsginfo').text(msg)
                        }
                    }
                })
            }
            else {
                $('#txtmsginfo').text("Amount Should be Between 100 and 1000")
            }
        }
        else {
            $('#txtmsginfo').text("Please Enter The Amount")
        }
    }
</script>

<script>
