<style type="text/css">
    @@keyframes ldio-zdyd6mf6t5 {
        0% { top: 96px; left: 96px; width: 0; height: 0; opacity: 1; }
        100% { top: 18px; left: 18px; width: 156px; height: 156px; opacity: 0; }
    }
    .ldio-zdyd6mf6t5 div {
        position: absolute;
        border-width: 4px;
        border-style: solid;
        opacity: 1;
        border-radius: 50%;
        animation: ldio-zdyd6mf6t5 1s cubic-bezier(0,0.2,0.8,1) infinite;
    }
    .ldio-zdyd6mf6t5 div:nth-child(1) { border-color: #e90c59; }
    .ldio-zdyd6mf6t5 div:nth-child(2) { border-color: #46dff0; animation-delay: -0.5s; }
    .loadingio-spinner-ripple-92ar2pfqk5j {
        width: 200px;
        height: 200px;
        display: inline-block;
        overflow: hidden;
        background: transparent;
    }
    .ldio-zdyd6mf6t5 {
        width: 100%;
        height: 100%;
        position: relative;
        transform: translateZ(0) scale(1);
        backface-visibility: hidden;
        transform-origin: 0 0;
    }
    .ldio-zdyd6mf6t5 div { box-sizing: content-box; }
</style>

<style>
    /* ---- UPI QR functional styling (kept from old page) ---- */
    .qr_ex_buttona {
        cursor: pointer;
        background: var(--main-bg-lcolor);
        border-radius: 3px;
    }
    .pen::after {
        content: "";
        position: absolute;
        width: 44px;
        height: 122px;
        background: #ffffff4f;
        z-index: 1;
        top: -24px;
        transform: rotate(35deg);
        animation: l_to_r 4s linear infinite;
        background-image: linear-gradient(140deg, #FFF0 0%, #FF00AE00 50%, #BFD64100 75%);
    }
    @@keyframes l_to_r {
        0% { left: -74px; }
        100% { left: 100%; }
    }
    #successgenrate .qr_ex h2 { font-size: 32px; }
    #successgenrate .qr_ex p { font-size: 17px; }
    .qr_ex h2 {
        width: 100%;
        float: left;
        margin-bottom: 16px;
        margin-top: 0;
        font-size: 40px;
        color: #68820d;
    }
    .qr_ex p { float: left; width: 100%; }
    .success-checkmark { width: 160px; height: 230px; margin: 0 auto; }
    .success-checkmark .check-icon {
        width: 160px; height: 160px; position: relative; border-radius: 50%;
        box-sizing: content-box; border: 8px solid #4caf50;
    }
    .success-checkmark .check-icon::before {
        top: 6px; left: -4px; width: 60px;
        transform-origin: 100% 50%; border-radius: 100px 0 0 100px;
    }
    .success-checkmark .check-icon::after {
        top: 0; left: 60px; width: 120px;
        transform-origin: 0 50%; border-radius: 0 100px 100px 0;
        animation: rotate-circle 4.25s ease-in;
    }
    .success-checkmark .check-icon::before, .success-checkmark .check-icon::after {
        content: ""; height: 200px; position: absolute; transform: rotate(-45deg);
    }
    .success-checkmark .check-icon .icon-line {
        height: 10px; background-color: #4caf50; display: block;
        border-radius: 4px; position: absolute; z-index: 10;
    }
    .success-checkmark .check-icon .icon-line.line-tip {
        top: 92px; left: 28px; width: 50px;
        transform: rotate(45deg); animation: icon-line-tip 0.75s;
    }
    .success-checkmark .check-icon .icon-line.line-long {
        top: 76px; right: 16px; width: 94px;
        transform: rotate(-45deg); animation: icon-line-long 0.75s;
    }
    .success-checkmark .check-icon .icon-circle {
        top: -8px; left: -8px; z-index: 10; width: 160px; height: 160px;
        border-radius: 50%; position: absolute; box-sizing: content-box;
        border: 8px solid rgba(76, 175, 80, 0.5);
    }
    .success-checkmark .check-icon .icon-fix {
        top: 16px; width: 10px; left: 52px; z-index: 1; height: 170px;
        position: absolute; transform: rotate(-45deg);
    }
    @@keyframes rotate-circle {
        0% { transform: rotate(-45deg); }
        5% { transform: rotate(-45deg); }
        12% { transform: rotate(-405deg); }
        100% { transform: rotate(-405deg); }
    }
    @@keyframes icon-line-tip {
        0% { width: 0; left: 2px; top: 38px; }
        54% { width: 0; left: 2px; top: 38px; }
        70% { width: 100px; left: -16px; top: 74px; }
        84% { width: 34px; left: 42px; top: 96px; }
        100% { width: 50px; left: 28px; top: 90px; }
    }
    @@keyframes icon-line-long {
        0% { width: 0; right: 92px; top: 108px; }
        65% { width: 0; right: 92px; top: 108px; }
        84% { width: 110px; right: 0; top: 70px; }
        100% { width: 94px; right: 16px; top: 76px; }
    }
    .set_so {
        color: red; font-size: 72px; font-weight: 800;
        text-shadow: 1px 1px 1px #000; margin: 0;
    }
    .qr_ex_button {
        width: 100%; float: left; display: flex;
        align-items: center; justify-content: space-between; padding-top: 20px;
    }
    .qr_ex_button a {
        padding: 6px 12px; border: 1px solid var(--main-bg-rcolor);
        border-radius: 3px; background: var(--main-bg-rcolor); color: #fff;
    }
    .qr_ex { width: 100%; float: left; text-align: center; padding: 20px; }
    .qr_ex img { margin: auto; width: 252px; }
    .swal2-popup.swal2-modal.swal2-icon-success.swal2-show { width: 40em; font-size: 14px; }
    #timer { font-weight: 800; padding-left: 10px; padding-right: 10px; }
    .set_time1 {
        display: flex; align-items: center; justify-content: space-between;
        position: relative; z-index: 5;
    }
    #divamount h3 { padding-bottom: 15px; }
    .set_time {
        width: 100%; float: left; text-align: center; display: flex;
        align-items: center; justify-content: center; padding: 10px;
        position: relative; color: #fff;
    }
    .set_time h3 { margin: 0; font-size: 20px; position: relative; z-index: 5; }
    @@keyframes mymove {
        0% { color: #fff; }
        50% { color: green; }
        100% { color: red; }
    }
    .pen {
        position: absolute; top: 0px; left: 0px; height: 100%; width: 100%;
        overflow: hidden;
        background-image: linear-gradient(to right, #f20000, #0f8a28) !important;
        z-index: 2;
    }
    .loaders443 {
        width: 31px; height: 30px; border: 5px solid #FFF;
        border-bottom-color: #FF3D00; border-radius: 50%;
        display: inline-block; box-sizing: border-box;
        animation: rotation 1s linear infinite;
    }
    @@keyframes rotation {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
    .datepicker table tr td span { color: #555 !important; }
    .datepicker table tr td span.active { color: #fff !important; }

    /* UPI history table + hover (same pattern as purchase-request page) */
    body.saas-admin-ui .saas-retailer-upi-page #tblshowMasterUPI table { min-width: 820px; }
    body.saas-admin-ui .saas-retailer-upi-page #tblshowMasterUPI tbody td { font-size: 13px; }
    body.saas-admin-ui .saas-retailer-upi-page #tblshowMasterUPI tbody td.vm-upi-nowrap { white-space: nowrap !important; }
    body.saas-admin-ui .saas-retailer-upi-page #tblshowMasterUPI tbody tr.vm-upi-row-hover td { background: #eff6ff !important; }
    body.saas-admin-ui .saas-retailer-upi-page #tblshowMasterUPI tbody td.vm-upi-col-hover { background: #dbeafe !important; }
    body.saas-admin-ui .saas-retailer-upi-page .status-failsuccessa img { border-radius: 50%; padding: 3px; }
    body.saas-admin-ui .saas-retailer-upi-page #tblshowMasterUPI .vm-opr-table-empty-row td {
        text-align: center !important;
        padding: 26px 10px !important;
        color: #64748b !important;
        font-weight: 600 !important;
    }
    /* Charges card table (left panel) — latest design */
    body.saas-admin-ui .saas-retailer-upi-page .vm-upi-charges-table {
        width: 100% !important;
        margin: 10px 0 4px !important;
        border-collapse: separate !important;
        border-spacing: 0;
        border: 1px solid #e2e8f0 !important;
        border-radius: 10px;
        overflow: hidden;
        font-size: 13px;
        background: #fff;
    }
    body.saas-admin-ui .saas-retailer-upi-page .vm-upi-charges-table th {
        background: linear-gradient(180deg, #f1f5f9, #e2e8f0) !important;
        color: #334155 !important;
        font-weight: 800 !important;
        font-size: 12px !important;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        text-align: center !important;
        padding: 9px 10px !important;
        border: none !important;
        border-bottom: 2px solid #cbd5e1 !important;
    }
    body.saas-admin-ui .saas-retailer-upi-page .vm-upi-charges-table td {
        padding: 8px 12px !important;
        border: none !important;
        border-bottom: 1px solid #f1f5f9 !important;
        color: #475569 !important;
    }
    body.saas-admin-ui .saas-retailer-upi-page .vm-upi-charges-table tr:last-child td {
        border-bottom: none !important;
    }
    body.saas-admin-ui .saas-retailer-upi-page .vm-upi-charges-table td:last-child {
        font-weight: 800 !important;
        text-align: right !important;
        color: #0f172a !important;
        white-space: nowrap !important;
    }

    @@media screen and (max-width:767px) {
        body.saas-admin-ui .saas-retailer-upi-page #tblshowMasterUPI table { min-width: 680px; }
    }
    @@media screen and (max-width:480px) {
        #successgenrate .qr_ex h2 { font-size: 24px; }
        #successgenrate .qr_ex p { font-size: 14px; }
        .success-checkmark { width: 177px; height: 224px; }
        #successgenrate .qr_ex_button a { margin-bottom: 5px; }
        .qr_ex_button a { width: 100%; float: left; }
        .qr_ex_buttona { margin-bottom: 5px; width: 100%; float: left; }
        .set_so { font-size: 45px; }
        .qr_ex h2 { font-size: 30px; }
        .qr_ex img { width: 220px; }
        .qr_ex_button { display: block; }
        #divamount h3 { font-size: 18px; padding-bottom: 0; }
        .set_time h3 { font-size: 16px; }
        #timer { font-size: 16px !important; }
        .scan-first button p { font-size: 30px; }
        .scan-first button { font-size: 50px; }
    }
    @@media screen and (max-width:420px) {
        .set_time h3 { font-size: 14px; }
        #timer { font-size: 14px !important; }
    }
    /* Clean print (PDF) — only history table prints */
    @@media print {
        body.saas-admin-ui .saas-retailer-upi-page .vm-ft-form-col,
        body.saas-admin-ui .saas-retailer-upi-page .vm-ft-page-toolbar,
        body.saas-admin-ui .saas-retailer-upi-page .vm-ft-history-toolbar__filters,
        body.saas-admin-ui .saas-retailer-upi-page .vm-ft-export-group,
        body.saas-admin-ui .saas-retailer-upi-page #overlay {
            display: none !important;
        }
        body.saas-admin-ui .saas-retailer-upi-page .vm-ft-layout {
            display: block !important;
        }
        body.saas-admin-ui .saas-retailer-upi-page .vm-ft-history-col {
            width: 100% !important;
            max-width: 100% !important;
            flex: 0 0 100% !important;
        }
        body.saas-admin-ui .saas-retailer-upi-page #tblshowMasterUPI {
            overflow: visible !important;
            max-height: none !important;
        }
        body.saas-admin-ui .saas-retailer-upi-page #tblshowMasterUPI table {
            min-width: 0 !important;
            width: 100% !important;
        }
    }
</style>
<style>
    #overlay {
        position: fixed; top: 0; z-index: 100; width: 100%; height: 100%;
        display: none; background: rgba(0,0,0,0.6);
    }
    .cv-spinner { height: 100%; display: flex; justify-content: center; align-items: center; }
    .spinner {
        width: 40px; height: 40px; border: 4px #ddd solid;
        border-top: 4px #2e93e6 solid; border-radius: 50%;
        animation: sp-anime 0.8s infinite linear;
    }
    @@keyframes sp-anime {
        100% { transform: rotate(360deg); }
    }
    .is-hide { display: none; }
</style>

<section class="content saas-admin-account-page saas-admin-report-page saas-fund-transfer-page saas-fund-transfer-premium saas-dealer-fund-transfer-page saas-retailer-fund-transfer-page saas-retailer-upi-page">

    <div class="container-fluid vm-ft-page-shell">

        <div class="vm-ft-page-toolbar vm-ft-page-toolbar--premium">
            <div class="vm-ft-page-hero">
                <div>
                    <ol class="vm-ft-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Report's</li>
                        <li>UPI QR</li>
                    </ol>
                </div>
            </div>
            <div class="vm-ft-search-wrap">
                <input class="form-control" type="text" value="" id="myInput" name="myInput" placeholder="Search by name, amount, RRN..." autocomplete="off" onkeyup="myFunction()" />
            </div>
        </div>

        <div class="vm-ft-layout-wrap">
        <div class="vm-ft-layout vm-ft-layout--full">
            <div class="vm-ft-form-col">
                <div class="fund-trasfer-left vm-ft-form-card">
                    <div class="vm-ft-form-card-header">
                        <div class="vm-ft-form-card-header__icon" aria-hidden="true">
                            <i class="fas fa-qrcode"></i>
                        </div>
                        <div>
                            <span class="vm-ft-form-card-header__title">UPI QR</span>
                            <span class="vm-ft-form-card-header__sub">Generate QR &amp; add wallet money</span>
                        </div>
                    </div>
                    <ul class="nav nav-tabs fullbodydycolorbg1 tab-seconddesign tab-third-design vm-ft-role-tabs fulltabchange" id="tabs">
                        <li class="tab-link vm-ft-role-tab-li vm-ft-role-tab-li--active current active" data-tab="tab-1" role="presentation" style="width:100% !important;">
                            <a data-toggle="tab" href="#home" class="vm-ft-role-tab" aria-expanded="true" aria-selected="true">Add Wallet By UPI QR</a>
                        </li>
                    </ul>

                    <div class="width100 float-left tabcurrent-seconddesign input-border-third">
                        <div id="home" class="width100 float-left tab-pane vm-ft-left-tab-pane fade remove-activein active in">
                            <div class="fund-transfer-form vm-dealer-ft-form-fs14">
                                <div class="scan-outer">

                                    <div id="qrregenrate" style="display:none">
                                        <div class="qr_ex">
                                            <div style="width: 100%; float: left; padding-bottom: 2px; ">
                                                <img src="https://i.ibb.co/Vv6ynb2/bin-unscreen.gif" alt="QR Code Expired" />
                                            </div>
                                            <p class="set_so"><i>Sorry !</i></p>
                                            <h2>QR Code Expired</h2>
                                            <p>
                                                QR code has expired, please re-generate a new QR code if you need to make payment. Remember don't use this QR Code after expiry does not receive any benefit.
                                            </p>
                                            <div class="qr_ex_button">
                                                <div onclick="location.reload();" style="cursor: pointer;"><a style="background: var(--main-bg-lcolor); border: 1px solid var(--main-bg-lcolor); ">Re-Generate QR Code</a></div>
                                                <a href="@Url.Action("Dashboard", "Home")">Go To Dashboard</a>
                                            </div>
                                        </div>
                                    </div>

                                    <div id="successgenrate" style="display:none;">
                                        <div class="qr_ex">
                                            <div style="width: 100%; float: left; padding-top: 27px; border-radius: 4px;">
                                                <div class="success-checkmark">
                                                    <div class="check-icon">
                                                        <span class="icon-line line-tip"></span>
                                                        <span class="icon-line line-long"></span>
                                                        <div class="icon-circle"></div>
                                                        <div class="icon-fix"></div>
                                                    </div>
                                                </div>
                                            </div>
                                            <h2 style="color: #333333;">Payment Successfull</h2>
                                            <p>
                                                Payment has been successfully updated in your wallet. Check the Add Money report if you need more details.
                                            </p>
                                            <div class="qr_ex_button">
                                                <a style="background: var(--main-bg-lcolor); border: 1px solid var(--main-bg-lcolor); " href="">Payment Again</a>
                                                <a style=" " href="@Url.Action("Dashboard", "Home")">Go To Dashboard</a>
                                            </div>
                                        </div>
                                    </div>

                                    @if (ViewBag.msg == "OK")
                                    {
                                        if (ViewBag.Api == "ICICI")
                                        {
                                            if (ViewBag.set == "NOTOK")
                                            {
                                                <div class="scan-first">
                                                    @using (Html.BeginForm("UPITRANSFER_add_QR", "Home", FormMethod.Post))
                                                    {
                                                        <button type="submit" style="border: 1px solid #aaa4a4; background: #fff;">
                                                            <p style="text-align:center;"> Generate</p> QR Code
                                                        </button>
                                                    }
                                                    <p style="color: red; text-align: center; font-weight: bold; ">@ViewBag.chkmsg </p>
                                                </div>
                                            }
                                            else
                                            {
                                                <img src="@ViewBag.QRCodeImage" alt="" style=" border:5px solid black;max-width:100%;" />
                                            }
                                        }
                                        else if (ViewBag.Api == "PAYU")
                                        {
                                            if (ViewBag.set == "NOTOK")
                                            {
                                                <div class="scan-first">
                                                    @using (Html.BeginForm("UPITRANSFER_add_QR", "Home", FormMethod.Post))
                                                    {
                                                        <button type="submit" style="border: 1px solid #aaa4a4; background: #fff;">
                                                            <p style="text-align:center;"> Generate</p> QR Code
                                                        </button>
                                                    }
                                                    <p style="color: red; text-align: center; font-weight: bold; ">@ViewBag.chkmsg </p>
                                                </div>
                                            }
                                            else
                                            {
                                                <img src="@ViewBag.QRCodeImage" alt="" style=" border:5px solid black;max-width:100%;" />
                                            }
                                        }
                                        else if (ViewBag.Api == "RADIANT")
                                        {
                                            if (ViewBag.respmsg == "OK")
                                            {
                                                <div id="showgenrateform">
                                                    <div class="form-group">
                                                        <div id="divamount" class="col-md-12 col-sm-12 col-xs-12">
                                                            <div class="col-md-3 col-sm-3 col-xs-3">
                                                                <label>Amount </label>
                                                            </div>
                                                            <div class="col-md-6 col-sm-6 col-xs-6">
                                                                @Html.TextBox("txtamount", "", new { @type = "number", @class = "form-control", placeholder = "Enter Amount" })
                                                            </div>
                                                        </div>
                                                        <div id="divotp" class="col-md-12 col-sm-12 col-xs-12" style="margin-top: 3px; display: none;">
                                                            <div class="col-md-3 col-sm-3 col-xs-3">
                                                                <label>OTP </label>
                                                            </div>
                                                            <div class="col-md-6 col-sm-6 col-xs-6">
                                                                @Html.Hidden("hiderefid")
                                                                @Html.Hidden("hideotprefid")
                                                                @Html.TextBox("txtotp", "", new { @type = "number", @class = "form-control", placeholder = "Enter OTP" })
                                                            </div>
                                                        </div>
                                                        <div class="col-md-12 col-sm-12 col-xs-12" style="margin-top: 3px;">
                                                            <div id="createotp" class="col-md-3 col-sm-3 col-xs-3">
                                                                <button onclick="Subscription()" class="btn btn-primary">Send OTP</button>
                                                            </div>
                                                        </div>
                                                        <div class="col-md-12 col-sm-12 col-xs-12" style="margin-top: 3px;">
                                                            <div id="submitotp" class="col-md-3 col-sm-3 col-xs-3" style="display:none;">
                                                                <button onclick="Submitotp()" class="btn btn-primary">Genrate QR</button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div id="radiqrcodeshow" style="display:none">
                                                    <img id="showqrradiantimg" alt="" style=" border:5px solid black;max-width:100%;" />
                                                </div>
                                                <p id="txtmsginfo" style="color: red; text-align: center; font-weight: bold; "> </p>
                                            }
                                            else
                                            {
                                                <p style="color: red; text-align: center; font-weight: bold; ">@ViewBag.respmsg </p>
                                            }
                                        }
                                        else if (ViewBag.Api == "PAYTM")
                                        {
                                            if (ViewBag.respmsg == "OK")
                                            {
                                                <div id="paytmshowgenrateform" style=" margin-top: 18px;display:block;">
                                                    <div class="form-group">
                                                        <div id="divamount" class="">
                                                            <div class="col-md-12 col-sm-12 col-xs-12">
                                                                <h3 style=" margin-top: 0; ">Enter Amount And Generate QR</h3>
                                                            </div>
                                                            <div class="col-md-8 col-sm-8 col-xs-8">
                                                                @Html.TextBox("paytmamounts", "", new { @type = "number", @class = "form-control", placeholder = "Enter Amount" })
                                                            </div>
                                                            <div class="col-md-4 col-sm-4 col-xs-4" style="">
                                                                <div id="GenrateQr" class="">
                                                                    <button id="generatte" onclick="generatepaytmqr()" class="btn btn-primary">Generate QR</button>
                                                                </div>
                                                            </div>
                                                            <div id="payidmess" style="color:red"></div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div id="paytmqrcodeshow" style="display:none">
                                                    <div class="set_time">
                                                        <div class="set_time1">
                                                            <h3>This QR Will Expire After </h3>
                                                            <div style=" font-size: 20px; " id=timer></div>
                                                        </div>
                                                        <h3>Minutes</h3>
                                                        <div class="pen">
