@{
    ViewBag.Title = "Help";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";
    Func<string, string> helpVal = v => string.IsNullOrWhiteSpace(v) ? "No Data Found !" : v.Trim();
    string adminCompany = "", adminName = "", adminEmail = "", adminMobile = "", adminAddress = "";
    string dlrCompany = "", dlrName = "", dlrEmail = "", dlrMobile = "", dlrAddress = "";
    try
    {
        if (ViewBag.admin != null)
        {
            if (ViewBag.admin.Companyname != null) { adminCompany = Convert.ToString(ViewBag.admin.Companyname); }
            if (ViewBag.admin.Name != null) { adminName = Convert.ToString(ViewBag.admin.Name); }
            try { if (ViewBag.admin.email1 != null && Convert.ToString(ViewBag.admin.email1) != "") { adminEmail = Convert.ToString(ViewBag.admin.email1); } else if (ViewBag.admin.email != null) { adminEmail = Convert.ToString(ViewBag.admin.email); } } catch { }
            try { if (ViewBag.admin.mobile1 != null && Convert.ToString(ViewBag.admin.mobile1) != "") { adminMobile = Convert.ToString(ViewBag.admin.mobile1); } else if (ViewBag.admin.mobile != null) { adminMobile = Convert.ToString(ViewBag.admin.mobile); } } catch { }
            if (ViewBag.admin.Address != null) { adminAddress = Convert.ToString(ViewBag.admin.Address); }
        }
    }
    catch { }
    try
    {
        if (ViewBag.dealer != null)
        {
            if (ViewBag.dealer.FarmName != null) { dlrCompany = Convert.ToString(ViewBag.dealer.FarmName); }
            if (ViewBag.dealer.DealerName != null) { dlrName = Convert.ToString(ViewBag.dealer.DealerName); }
            if (ViewBag.dealer.Email != null) { dlrEmail = Convert.ToString(ViewBag.dealer.Email); }
            if (ViewBag.dealer.Mobile != null) { dlrMobile = Convert.ToString(ViewBag.dealer.Mobile); }
            if (ViewBag.dealer.Address != null) { dlrAddress = Convert.ToString(ViewBag.dealer.Address); }
        }
    }
    catch { }
}

