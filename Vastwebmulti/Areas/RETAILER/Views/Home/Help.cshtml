<style>
    /* Retailer Help — 2-column premium grid (own scope, always wins) */
    .saas-retailer-help-page .vm-dr-help-grid { display: grid !important; grid-template-columns: repeat(2, minmax(0, 1fr)) !important; gap: 16px !important; align-items: start !important; }
    .saas-retailer-help-page .vm-dr-help-card { min-width: 0 !important; margin: 0 !important; }
    .saas-retailer-help-page .vm-dr-help-panel { border: 1px solid #e5e9f2 !important; border-radius: 18px !important; overflow: hidden !important; background: #fff !important; box-shadow: 0 8px 24px rgba(15,23,42,.07) !important; transition: transform .16s ease, box-shadow .16s ease !important; }
    .saas-retailer-help-page .vm-dr-help-panel:hover { transform: translateY(-2px) !important; box-shadow: 0 14px 32px rgba(15,23,42,.12) !important; }
    .saas-retailer-help-page .vm-dr-help-panel__head { background: #fff !important; border: none !important; border-bottom: 1.5px solid #eef1f6 !important; padding: 14px 16px !important; }
    .saas-retailer-help-page .vm-opr-table-panel__title { color: #0f172a !important; font-size: 17px !important; font-weight: 800 !important; display: flex !important; align-items: center !important; gap: 12px !important; line-height: 1.3 !important; }
    .saas-retailer-help-page .vm-opr-table-panel__title i { display: inline-flex !important; width: 36px !important; height: 36px !important; min-width: 36px !important; border-radius: 11px !important; background: linear-gradient(135deg,#eef2ff,#e0e7ff) !important; border: 1px solid #c7d2fe !important; color: #4f46e5 !important; align-items: center !important; justify-content: center !important; font-size: 15px !important; margin: 0 !important; }
    .saas-retailer-help-page .vm-dr-help-panel__body { padding: 8px 16px 14px !important; }
    .saas-retailer-help-page .vm-dr-help-schedule { list-style: none !important; margin: 0 !important; padding: 0 !important; }
    .saas-retailer-help-page .vm-dr-help-schedule__row { display: flex !important; align-items: center !important; justify-content: space-between !important; gap: 10px !important; padding: 10px 2px !important; border-bottom: 1px dashed #e5e9f2 !important; }
    .saas-retailer-help-page .vm-dr-help-schedule__row:last-child { border-bottom: none !important; }
    .saas-retailer-help-page .vm-dr-help-schedule__day { font-size: 13px !important; font-weight: 800 !important; color: #1e293b !important; display: inline-flex !important; align-items: center !important; gap: 8px !important; }
    .saas-retailer-help-page .vm-dr-help-schedule__day::before { content: '' !important; width: 8px !important; height: 8px !important; border-radius: 50% !important; background: linear-gradient(135deg,#4f46e5,#7c3aed) !important; display: inline-block !important; }
    .saas-retailer-help-page .vm-dr-help-schedule__time { font-size: 12.5px !important; font-weight: 700 !important; color: #334155 !important; background: none !important; border: none !important; border-radius: 0 !important; padding: 0 !important; white-space: nowrap !important; }
    .saas-retailer-help-page .vm-dr-help-schedule__row--highlight .vm-dr-help-schedule__time { background: none !important; border: none !important; color: #b45309 !important; }
    .saas-retailer-help-page .vm-dr-help-contact { margin: 0 !important; padding: 0 !important; }
    .saas-retailer-help-page .vm-dr-help-contact__row { display: grid !important; grid-template-columns: 130px 1fr !important; gap: 10px !important; padding: 10px 2px !important; border-bottom: 1px dashed #e5e9f2 !important; margin: 0 !important; }
    .saas-retailer-help-page .vm-dr-help-contact__row:last-child { border-bottom: none !important; }
    .saas-retailer-help-page .vm-dr-help-contact__row dt { font-size: 10.5px !important; font-weight: 800 !important; text-transform: uppercase !important; letter-spacing: .5px !important; color: #64748b !important; }
    .saas-retailer-help-page .vm-dr-help-contact__row dd { margin: 0 !important; font-size: 13.5px !important; font-weight: 700 !important; color: #0f172a !important; word-break: break-word !important; }
    .saas-retailer-help-page .vm-dr-help-contact__row--full { grid-template-columns: 130px 1fr !important; }
    @@media screen and (max-width:900px) {
        .saas-retailer-help-page .vm-dr-help-grid { grid-template-columns: 1fr !important; }
    }
    @@media screen and (max-width:480px) {
        .saas-retailer-help-page .vm-dr-help-contact__row { grid-template-columns: 1fr !important; gap: 3px !important; }
    }
</style>
<script>document.body.classList.add('saas-sell-rch-dp-page', 'saas-dealer-notification-page', 'saas-retailer-help-page');</script>

