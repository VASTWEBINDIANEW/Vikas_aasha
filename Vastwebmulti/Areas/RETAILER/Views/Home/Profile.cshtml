@* ======================================================================
   RP MODAL MANAGER (V2) — sabhi Profile modals ka single reliable system
   - Inline panels ko overlay me wrap karta hai
   - Backdrop click / ESC / Close button se band hota hai
   - Body scroll lock karta hai
   - Purane duplicate/conflicting handlers ko override karta hai
   ====================================================================== *@
<script>
(function () {
    'use strict';

    function lockScroll() { document.body.classList.add('rp-lock'); }
    function unlockScroll() {
        if ($('.rp-overlay.open').length === 0) { document.body.classList.remove('rp-lock'); }
    }

    // Kisi panel element ko overlay-wrapper me wrap karo (sirf ek baar)
    function ensureOverlay($panel, sizeClass) {
        if (!$panel || !$panel.length) return null;
        var $existing = $panel.closest('.rp-overlay');
        if ($existing.length) return $existing;
        $panel.wrap('<div class="rp-overlay"><div class="rp-modal ' + (sizeClass || '') + '"></div></div>');
        return $panel.closest('.rp-overlay');
    }

    function openOverlay($overlay) {
        if (!$overlay || !$overlay.length) return;
        // doosre inline overlays band karo (Bootstrap gallery/print modals ko haath mat lagao)
        $('.rp-overlay.open').not($overlay).removeClass('open');
        $overlay.addClass('open');
        lockScroll();
    }

    function closeOverlay($overlay) {
        if (!$overlay || !$overlay.length) return;
        $overlay.removeClass('open');
        unlockScroll();
    }

    function panelToOverlay(selector, sizeClass) {
        var $p = $(selector);
        if (!$p.length) return null;
        return ensureOverlay($p, sizeClass);
    }

    $(function () {
        /* ---- 0. Purane conflicting direct handlers hatao (overlay stuck ka main kaaran) ---- */
        try {
            $('#modalnonelist, #profiletablenone, #uploadprofileimg, #modalnonecloser, #SaveAccount, #togglenew').off('click');
            $('.profilecloses, .closeaadar, .closeprofile').off('click');
        } catch (e) { console.log(e); }

        /* ---- 1. Sirf address + bank panels overlay-popup me; photo/account/docs INLINE (koi popup nahi) ---- */
        panelToOverlay('#EditaddressModal', '');
        // Bank edit panels (har account ka apna overlay — duplicate-ID fix ke saath)
        $('.js-bank-edit').each(function () {
            ensureOverlay($(this), '');
        });

        /* ---- 2. Backdrop click se close ---- */
        $(document).on('click', '.retailer-prof-page .rp-overlay', function (e) {
            if (e.target === this) { closeOverlay($(this)); restoreViews($(this)); }
        });

        /* ---- 3. ESC se close ---- */
        $(document).on('keydown', function (e) {
            if (e.key === 'Escape' || e.keyCode === 27) {
                var $open = $('.retailer-prof-page .rp-overlay.open').last();
                if ($open.length) { closeOverlay($open); restoreViews($open); }
            }
        });

        /* ---- 4. View restore helper (address/account panels ke peeche wali list wapas dikhao) ---- */
        function restoreViews($overlay) {
            var $panel = $overlay.find('> .rp-modal > div').first();
            var id = ($panel.attr('id') || '');
            if (id === 'EditaddressModal') { $('#vm-listwert').show(); }
            if (id === 'EditnameandpancardModal') { $('#profileshowtable').show(); }
            if ($panel.hasClass('js-bank-edit')) {
                var bid = $panel.data('bank-edit');
                if (bid) { $('#vm-listwertee1-' + bid).show(); }
            }
            if (id === 'EditProfileimageModal') { $('.profileupload').show(); }
        }

        /* ---- 5. Close buttons (sabhi purane + naye) ---- */
        $(document).on('click', '.retailer-prof-page .rp-overlay .profilecloses, ' +
            '.retailer-prof-page .rp-overlay .closeaadar, ' +
            '.retailer-prof-page .rp-overlay .closeprofile, ' +
            '.retailer-prof-page .rp-overlay #modalnonelist, ' +
            '.retailer-prof-page .rp-overlay #profiletablenone, ' +
            '.retailer-prof-page .rp-overlay .js-bank-close, ' +
            '.retailer-prof-page .rp-overlay .rp-modal__close', function (e) {
            e.preventDefault();
            var $ov = $(this).closest('.rp-overlay');
            closeOverlay($ov);
            restoreViews($ov);
        });

        // Purane IDs jo overlay ke bahar reh gaye (backward compat)
        $(document).off('click', '#modalnonelist').on('click', '#modalnonelist', function (e) {
            e.preventDefault();
            var $ov = $('#EditaddressModal').closest('.rp-overlay');
            if ($ov.length) { closeOverlay($ov); } else { $('#EditaddressModal').hide(); }
            $('#vm-listwert').show();
        });
        $(document).off('click', '#profiletablenone').on('click', '#profiletablenone', function (e) {
            e.preventDefault();
            /* INLINE swap wapas: edit form band, list wapas */
            $('#EditnameandpancardModal').hide();
            $('#profileshowtable').show();
        });
        $(document).off('click', '.profilecloses').on('click', '.profilecloses', function (e) {
            e.preventDefault();
            /* inline swap wapas: upload panel band, OTP box wapas */
            $('#EditProfileimageModal').hide();
            $('.profileupload').show();
        });
        $(document).off('click', '.closeaadar, .closeprofile').on('click', '.closeaadar, .closeprofile', function (e) {
            e.preventDefault();
            /* docs forms INLINE hain — bas band karo (koi overlay nahi) */
            $(this).closest('.vm-docmodal').hide();
        });

        /* ---- 6. Bank Edit open (delegated — har row ka apna modal) ---- */
        $(document).off('click', '.js-bank-edit-btn').on('click', '.js-bank-edit-btn', function (e) {
            e.preventDefault();
            var bid = $(this).data('bank-id');
            var $edit = bid ? $('#EditBankinfoModal-' + bid) : $('.js-bank-edit').first();
            if (!$edit.length) $edit = $('#EditBankinfoModal');
            var $ov = $edit.closest('.rp-overlay');
            if (bid) { $('#vm-listwertee1-' + bid).hide(); }
            $edit.show();
            openOverlay($ov);
        });

        /* ---- 7. Profile photo open fix (inline onclick + jQuery double-fire rokna) ---- */
        $(document).off('click', '#uploadprofileimg').on('click', '#uploadprofileimg', function (e) {
            e.preventDefault();
            e.stopImmediatePropagation();
            var rid = $('#txtprofileid').val() || '';
            if (typeof uploadimage === 'function' && !window.__rpPhotoOpen) {
                window.__rpPhotoOpen = true;
                try { uploadimage(rid); } finally { setTimeout(function () { window.__rpPhotoOpen = false; }, 50); }
            } else {
                /* inline swap: OTP box chhupao, upload panel uski jagah dikhao (koi popup nahi) */
                $('.profileupload').hide();
                $('#EditProfileimageModal').show();
            }
        });
    });

    /* ---- 8. Global open functions — purani definitions ko reliable version se badlo ---- */
    /* Profile photo: INLINE swap (popup nahi) — avatar click pe OTP box ki jagah upload panel */
    window.uploadimage = function (retailerid) {
        if (retailerid) { $('#txtprofileid').val(retailerid); }
        $('.profileupload').hide();
        $('#EditProfileimageModal').show();
    };
    /* Docs upload forms: INLINE (koi popup nahi) — docs card ke upar wahi khulte hain, ek baar me ek */
    window.uploadaadhaarDoc = function (retailerid) {
        if (retailerid) { $('#txtaadharid').val(retailerid); }
        $('.vm-docmodal').hide();
        $('#EditAadhaardocModal').show();
    };
    window.uploadpancardDoc = function (retailerid) {
        if (retailerid) { $('#txtpancardid').val(retailerid); }
        $('.vm-docmodal').hide();
        $('#EditPancarddocModal').show();
    };
    window.uploadShopwithSalfieDoc = function (retailerid) {
        if (retailerid) { $('#txtshopwithselfieid').val(retailerid); $('#txtpancardid').val(retailerid); }
        $('.vm-docmodal').hide();
        $('#EditShopwithSalfiedocModal').show();
    };
    window.uploadRegistractionCertificateDoc = function (retailerid) {
        if (retailerid) { $('#txtRegistractionid').val(retailerid); }
        $('.vm-docmodal').hide();
        $('#EditRegistractiondocModal').show();
    };
    window.uploadserviceDoc = function (retailerid) {
        if (retailerid) { $('#txtserviceid').val(retailerid); }
        $('.vm-docmodal').hide();
        $('#EditServicedocModal').show();
    };
    window.uploadAddressProofDoc = function (retailerid) {
        if (retailerid) { $('#txtAddressproofid').val(retailerid); }
        $('.vm-docmodal').hide();
        $('#EditAddressProofdocModal').show();
    };
    // myFunctio purane markup me reh gaya tha (undefined) — ab safe no-op/redirect to bank handler
    window.myFunctio = function () { /* deprecated: bank edit .js-bank-edit-btn se khulta hai */ };

    window.shownImg = function (url) {
        var img = document.getElementById('uploadprofileim112g');
        if (img && url) { img.src = url; }
    };

    /* ---- 9. BOOTSTRAP MODALS (Print Size / Add Bank / Gallery) reliable hide-show ----
       Screenshot wali dikkat ka kaaran: #Printsize123 me "fade in" class +
       inline display:none + float:right dialog style. Ab Bootstrap API se
       kholo/band karo + fallback manual. */
    function bsModal($m, action) {
        if (!$m || !$m.length) return;
        try {
            if (typeof $m.modal === 'function') { $m.modal(action); return; }
        } catch (e) { console.log(e); }
        // Fallback (agar bootstrap JS na ho)
        if (action === 'show') {
            $m.show().addClass('in');
            if ($('.modal-backdrop.rp-fallback').length === 0) {
                $('<div class="modal-backdrop fade in rp-fallback"></div>').appendTo('body');
            }
            $('body').addClass('modal-open');
        } else {
            $m.hide().removeClass('in');
            $('.modal-backdrop.rp-fallback').remove();
            $('body').removeClass('modal-open');
        }
    }
    $(function () {
        // Print Size trigger — Bootstrap ke saath-saath manual fallback bhi
        $(document).off('click', '#myModal123showdata2').on('click', '#myModal123showdata2', function (e) {
            var dt = $(this).attr('data-target') || '#Printsize123';
            // agar Bootstrap khud handle kar le to double-open roko
            setTimeout(function () {
                var $m = $(dt);
                if ($m.length && !$m.hasClass('in') && $m.css('display') !== 'block') { bsModal($m, 'show'); }
            }, 60);
        });
        // Add Wallet Unload trigger (#myBtn14)
        $(document).off('click', '#myBtn14').on('click', '#myBtn14', function () {
            setTimeout(function () {
                var $m = $('#defaultModal222');
                if ($m.length && !$m.hasClass('in') && $m.css('display') !== 'block') { bsModal($m, 'show'); }
            }, 60);
        });
        // Gallery image buttons — src set + Bootstrap show
        $(document).off('click', '.image-profilemodal').on('click', '.image-profilemodal', function () {
            setTimeout(function () {
                var $m = $('#galleryimageprofile-modal');
                if ($m.length && !$m.hasClass('in') && $m.css('display') !== 'block') { bsModal($m, 'show'); }
            }, 60);
        });
        // Print Size save ke baad modal band karo (UX)
        $(document).on('click', '#SaveAll1', function () {
            setTimeout(function () { bsModal($('#Printsize123'), 'hide'); }, 900);
        });
        // data-dismiss fallback (agar Bootstrap binding miss ho)
        $(document).on('click', '.rp-bs-modal [data-dismiss="modal"]', function (e) {
            var $m = $(this).closest('.rp-bs-modal');
            setTimeout(function () {
                if ($m.length && ($m.hasClass('in') || $m.css('display') === 'block')) { bsModal($m, 'hide'); }
            }, 60);
        });
    });
})();
</script>