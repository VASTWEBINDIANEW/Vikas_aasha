                                                <div class="vm-ekyc-half">
                                                    @{

                                                        var userid = User.Identity.GetUserId();
                                                        var set = DB1.rediantremtresponses.Where(s => s.userid == userid).ToList();
                                                        var set1 = DB1.radiantauths.ToList();
                                                    }
                                                    @if (set.Count == 0)
                                                    {
                                                        <a href="@Url.Action("Rediantcreate", "Home")"><button class="vm-create-btn"> Create </button></a>
                                                    }
                                                    else
                                                    {
                                                        if (set[0].Sts == "Approved")
