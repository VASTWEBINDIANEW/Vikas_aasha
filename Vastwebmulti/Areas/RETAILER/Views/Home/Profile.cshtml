                                                            <div class="vm-ekyc-ok">APPROVED</div>
                                                        }
                                                        else
                                                        {
                                                            <div id="redfull"><div id="redtext">@set[0].Sts</div> <div id="redbutton"><button onclick="checkrediantsts();">Check Status</button></div></div>
                                                        }
                                                    }
                                                    <script>
                           function checkrediantsts() {
                               $.ajax({
                                type: "POST", url: '@Url.Action("checkrediantremsts", "Home")',

                                   cache: false,
                                   success: function (data) {
                                       alert(data);
                                       if (data == "Approved") {
                                           document.getElementById('redfull').innerHTML = "APPROVED";
                                        document.getElementById('redfull').style.color = "white";
                                        document.getElementById('redfull').style.background = "green";
                                        document.getElementById('redfull').style.textAlign = "center";

                                    }

                                }
                            });
                        }
                                                    </script>
                                                </div>
                                            </div>
