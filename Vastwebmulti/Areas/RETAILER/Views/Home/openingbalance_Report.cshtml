@model List<Vastwebmulti.Models.closingbalance>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Opening Balance Report";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var dateMode = "get";
    var reports = Model ?? new List<Vastwebmulti.Models.closingbalance>();
    var rowCount = reports.Count;
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=43" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=22" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<style>
    /* Desktop (>=1024px): fit-to-width, no scroll */
    @@media (min-width: 1024px) {
        body.saas-admin-ui .saas-retailer-openbal-page #retailerOpenbalReport.vm-opr-data-table {
            width: 100% !important;
            min-width: 0 !important;
            max-width: 100% !important;
            table-layout: fixed !important;
        }
        body.saas-admin-ui .saas-retailer-openbal-page #retailerOpenbalReport.vm-opr-data-table thead tr,
        body.saas-admin-ui .saas-retailer-openbal-page #retailerOpenbalReport.vm-opr-data-table tbody tr {
            display: table-row !important;
        }
        body.saas-admin-ui .saas-retailer-openbal-page #retailerOpenbalReport.vm-opr-data-table thead th,
        body.saas-admin-ui .saas-retailer-openbal-page #retailerOpenbalReport.vm-opr-data-table tbody td {
            display: table-cell !important;
            min-width: 0 !important;
            max-width: none !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            white-space: nowrap !important;
        }
        body.saas-admin-ui .saas-retailer-openbal-page #retailerOpenbalReport.vm-opr-data-table thead th:nth-child(1),
        body.saas-admin-ui .saas-retailer-openbal-page #retailerOpenbalReport.vm-opr-data-table tbody td:nth-child(1) { width: 50% !important; }
        body.saas-admin-ui .saas-retailer-openbal-page #retailerOpenbalReport.vm-opr-data-table thead th:nth-child(2),
        body.saas-admin-ui .saas-retailer-openbal-page #retailerOpenbalReport.vm-opr-data-table tbody td:nth-child(2) { width: 50% !important; }
    }
    /* Mobile + tablet (<=1023px): natural widths, horizontal scroll */
    @@media (max-width: 1023.98px) {
        body.saas-admin-ui .saas-retailer-openbal-page #retailerOpenbalReport.vm-opr-data-table {
            width: max-content !important;
            min-width: 100% !important;
            max-width: none !important;
            table-layout: auto !important;
        }
        body.saas-admin-ui .saas-retailer-openbal-page #retailerOpenbalReport.vm-opr-data-table thead tr,
        body.saas-admin-ui .saas-retailer-openbal-page #retailerOpenbalReport.vm-opr-data-table tbody tr {
            display: table-row !important;
        }
        body.saas-admin-ui .saas-retailer-openbal-page #retailerOpenbalReport.vm-opr-data-table thead th,
        body.saas-admin-ui .saas-retailer-openbal-page #retailerOpenbalReport.vm-opr-data-table tbody td {
            display: table-cell !important;
            width: auto !important;
            min-width: 140px !important;
            max-width: none !important;
            white-space: nowrap !important;
            overflow: visible !important;
            text-overflow: clip !important;
        }
        body.saas-admin-ui .saas-retailer-openbal-page .vm-opr-table-scroll {
            overflow-x: auto !important;
        }
    }
</style>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-retailer-ecomm-transaction-page saas-retailer-openbal-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var openbalFormAttrs = new Dictionary<string, object>
            {
                { "id", "retailerOpenbalForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-report-date-form", "" },
                { "data-report-from", "#retailer_openbal_frm_date" },
                { "data-report-to", "#retailer_openbal_to_date" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("openingbalance_Report", "Home", FormMethod.Post, openbalFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home", new { area = "RETAILER" })"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Reports</li>
                        <li>Opening Balance Report</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters vm-ecomm-filter-row--one-line">

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_openbal_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_openbal_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" name="btntype" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-wallet" aria-hidden="true"></i>
                        <span>Opening balance report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong>@rowCount</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" id="btnExportRetailerOpenbal" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDFRetailerOpenbal" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="retailerOpenbalReport" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Opening&nbsp;Balance&nbsp;&#8377;</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody id="retailerOpenbalRows">
                                @if (reports.Count > 0)
                                {
                                    foreach (var item in reports)
                                    {
                                        <tr class="vm-dmt-row">
                                            <td>
                                                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @(item.closingbalance1.HasValue ? Math.Round(item.closingbalance1.Value, 2).ToString() : "0.00")</span>
                                            </td>
                                            <td class="vm-ticket-time-cell">
                                                <span class="vm-dmt-refno-text">@(item.date.HasValue ? String.Format("{0:dd-MMM-yyyy HH:mm:ss}", item.date.Value) : "—")</span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="2" class="vm-opr-table-empty vm-dmt-table-empty">
                                            <i class="fas fa-wallet" aria-hidden="true"></i>
                                            <span>No opening balance records found.</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section PostVmScripts {
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    function exportRetailerOpenbalTable(type) {
        var table = document.getElementById('retailerOpenbalReport');
        if (!table) {
            return;
        }
        var stamp = new Date().toISOString().slice(0, 10);
        var title = 'Opening Balance Report';
        var clone = table.cloneNode(true);
        if (clone.querySelector('.vm-opr-table-empty-row')) {
            alert('No data available to export.');
            return;
        }
        if (type === 'excel') {
            var excelHtml = '<html><head><meta charset="utf-8"></head><body>' + clone.outerHTML + '</body></html>';
            var blob = new Blob(['\ufeff', excelHtml], { type: 'application/vnd.ms-excel' });
            var link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = 'Retailer_Opening_Balance_' + stamp + '.xls';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
            return;
        }
        var printWin = window.open('', '_blank');
        if (!printWin) {
            alert('Please allow pop-ups to export PDF.');
            return;
        }
        printWin.document.write(
            '<html><head><title>' + title + '</title>'
            + '<style>body{font-family:Arial,sans-serif;padding:16px}h3{margin:0 0 12px}table{border-collapse:collapse;width:100%;font-size:12px}th,td{border:1px solid #ccc;padding:6px;text-align:left}th{background:#f3f4f6}</style>'
            + '</head><body><h3>' + title + '</h3>' + clone.outerHTML + '</body></html>'
        );
        printWin.document.close();
        printWin.focus();
        printWin.print();
    }

    function initRetailerOpenbalDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initRetailerOpenbalDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm(
                '#retailerOpenbalForm',
                '#retailer_openbal_frm_date',
                '#retailer_openbal_to_date',
                true
            );
        }
    }

    jQuery(function () {
        initRetailerOpenbalDatepickers();
        window.setTimeout(initRetailerOpenbalDatepickers, 150);
        jQuery('#btnExportRetailerOpenbal').on('click', function () {
            exportRetailerOpenbalTable('excel');
        });
        jQuery('#btnPDFRetailerOpenbal').on('click', function () {
            exportRetailerOpenbalTable('pdf');
        });
    });
</script>
}
