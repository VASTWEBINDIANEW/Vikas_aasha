<script>
        function ValidateDevice_NEW() {
            var cap_NEW = $('#cap_NEW').val();
            var capxml_NEW= $('#capxml_NEW').val();
            var devicesrno = $('#device_srno').val();
            var devicenm = $('#txtdevice').val();
            var apinm = $('#checkapi').val()
            $('#namechnage_NEW').hide();
            $('#EditName_NEW').show();
            $('#updatename_NEW').hide();
            console.log(capxml_NEW)
            if (cap_NEW == "") {
                $('#errdevicefind').text("Please Scan Again");
            }
            else {
                $.ajax({
                    url: '@Url.Action("ValidateDeviceinfo", "Home")',
                    cache: false,
                    type: "POST",
                    data: { cap_NEW: cap_NEW, capxml_NEW: encodeURIComponent(capxml_NEW), devicesrno: devicesrno, devicenm: devicenm, activeapinm:apinm },
                    beforeSend: function () {
                        $(".loader").show();
                    },
                    success: function (data) {
                        $('#cap_NEW').val("");
                        $('#capxml_NEW').val("");
                        $('#device_srno').val("");
                        $('#txtdevice').val("");
                        var output = data; //JSON.parse(data);
                        var status = output.Status;
                        var msg = output.Message;
                        if (status == "Success") {
                            var url = '@Url.Action("Money_transfer2", "Home")';
                            window.location.href = url;
                        }
                         else if (status == "ERROR")
                        {
                            alert(msg)
                            var url = '@Url.Action("Money_transfer2", "Home")';
                            window.location.href = url;
                        }
                        else {
                            if (msg.includes("NAME NOT MATCHING")) {
                                $('#namechnage_NEW').show();
                            }
                            $('#errdevicefind').text(msg);
                        }
                    },
                    complete: function () {
                        $(".loader").hide();
                    },
                    error: function () {
                        $(".loader").hide();
                    }
                })
            }
    }
</script>
