<script>
    function Genrateotpekyc_NEW() {
        var apinm = $('#checkapi').val()
        $('#verifyotperr_NEW').text("")
            $.ajax({
                url: '@Url.Action("RegisterMerchant", "Home")',
                cache: false,
                type: "POST",
                data: {apinameinfo:apinm },
                beforeSend: function () {
                    $(".loader").show();
                },
                success: function (data) {
                    var output = data; //JSON.parse(data);
                    var status = output.Status;
                    var msg = output.Message;
                    if (status == "Success") {
                        location.reload();
                        $(".loader").hide();
                        //var primarykey = output.primarykey;
                        //var encodetxnid = output.encodetxnid;
                        //$('#primaryhide_NEW').val(primarykey);
                        //$('#encodehide_NEW').val(encodetxnid);
                        //$('#divotpsend_NEW').hide();
                        //$('#verifyotp_NEW').show();
                        //$('#verifyotperr_NEW').text(msg)
                    }
                    else {
                        $('#otperror123_NEW').text(msg);
                    }
                },
                complete: function () {
                    $(".loader").hide();
                },
                error: function () {
                    $(".loader").hide();
                }
            })
        }
</script>
<script>
        function VerifyotpEkyc_NEW() {
            var otp = $('#txtotp').val();
            var primaryhide_NEW = $('#primaryhide_NEW').val();
            var encodehide_NEW = $('#encodehide_NEW').val();
            var apinm = $('#checkapi').val()
            if (otp == "") {
                $('#verifyotperr_NEW').text("Please Enter The OTP");
            }
            else {
                $.ajax({
                    url: '@Url.Action("VerifyotpEkyc", "Home")',
                    cache: false,
                    type: "POST",
                    data: { otp: otp, primaryhide_NEW: primaryhide_NEW, encodehide_NEW: encodehide_NEW, apinameinfo:apinm },
                    beforeSend: function () {
                        $(".loader").show();
                    },
                    success: function (data) {
                        var output = data;//JSON.parse(data);
                        var status = output.Status;
                        var msg = output.Message;
                        if (status == "Success") {
                            $('#divotpsend_NEW').hide();
                            $('#verifyotp_NEW').hide();
                            $('#scancheck_NEW').show();
                        }
                        else {
                            $('#verifyotperr_NEW').text(msg);
                        }
                    },
                    complete: function () {
                        $(".loader").hide();
                    },
                    error: function () {
                        $(".loader").hide();
                    }
                })
            }
        }
</script>
