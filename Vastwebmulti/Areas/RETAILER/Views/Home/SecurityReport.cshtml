@model List<Vastwebmulti.Models.history_norton_Result>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Security Report";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
    var reports = Model ?? new List<Vastwebmulti.Models.history_norton_Result>();
    var rowCount = reports.Count;
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=43" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=22" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<style>
    /* Desktop (>=1024px): fit-to-width, no scroll, tight columns */
    @@media (min-width: 1024px) {
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table {
            width: 100% !important;
            min-width: 0 !important;
            max-width: 100% !important;
            table-layout: fixed !important;
        }
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table thead tr,
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table tbody tr {
            display: table-row !important;
        }
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table thead th,
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table tbody td {
            display: table-cell !important;
            min-width: 0 !important;
            max-width: none !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            white-space: nowrap !important;
        }
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table thead th:nth-child(1),
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table tbody td:nth-child(1) { width: 12% !important; }
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table thead th:nth-child(2),
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table tbody td:nth-child(2) { width: 13% !important; }
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table thead th:nth-child(3),
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table tbody td:nth-child(3) { width: 10% !important; }
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table thead th:nth-child(4),
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table tbody td:nth-child(4) { width: 15% !important; }
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table thead th:nth-child(5),
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table tbody td:nth-child(5) { width: 7% !important; }
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table thead th:nth-child(6),
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table tbody td:nth-child(6) { width: 8% !important; }
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table thead th:nth-child(7),
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table tbody td:nth-child(7) { width: 8% !important; }
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table thead th:nth-child(8),
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table tbody td:nth-child(8) { width: 7% !important; }
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table thead th:nth-child(9),
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table tbody td:nth-child(9) { width: 12% !important; }
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table thead th:nth-child(10),
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table tbody td:nth-child(10) { width: 8% !important; }
    }
    /* Mobile + tablet (<=1023px): natural widths, full text, horizontal scroll */
    @@media (max-width: 1023.98px) {
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table {
            width: max-content !important;
            min-width: 1100px !important;
            max-width: none !important;
            table-layout: auto !important;
        }
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table thead tr,
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table tbody tr {
            display: table-row !important;
        }
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table thead th,
        body.saas-admin-ui .saas-retailer-security-page #retailerSecurityReport.vm-opr-data-table tbody td {
            display: table-cell !important;
            width: auto !important;
            min-width: 0 !important;
            max-width: none !important;
            white-space: nowrap !important;
            overflow: visible !important;
            text-overflow: clip !important;
        }
        body.saas-admin-ui .saas-retailer-security-page .vm-opr-table-scroll {
            overflow-x: auto !important;
        }
        /* Mobile + tablet: status dropdown full width */
        body.saas-admin-ui .saas-retailer-security-page .vm-opr-filter-row > .vm-opr-field,
        body.saas-admin-ui .saas-retailer-security-page .vm-rpt-filters-panel__bar > .vm-opr-field {
            flex: 1 1 100% !important;
            min-width: 0 !important;
            max-width: 100% !important;
            width: 100% !important;
        }
        body.saas-admin-ui .saas-retailer-security-page .vm-opr-filter-row > .vm-opr-field .vm-opr-select,
        body.saas-admin-ui .saas-retailer-security-page .vm-opr-filter-row > .vm-opr-field .select2,
        body.saas-admin-ui .saas-retailer-security-page .vm-opr-filter-row > .vm-opr-field .select2-container {
            width: 100% !important;
            max-width: 100% !important;
        }
    }
</style>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-retailer-ecomm-transaction-page saas-retailer-security-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var secFormAttrs = new Dictionary<string, object>
            {
                { "id", "retailerSecurityForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-report-date-form", "" },
                { "data-report-from", "#retailer_security_frm_date" },
                { "data-report-to", "#retailer_security_to_date" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("SecurityReport", "Home", FormMethod.Post, secFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home", new { area = "RETAILER" })"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Reports</li>
                        <li>Security Report</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters vm-ecomm-filter-row--one-line">

                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("ddl_status", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "All status", Value = "" },
                                new SelectListItem { Text = "Success", Value = "SUCCESS" },
                                new SelectListItem { Text = "Pending", Value = "PENDING" },
                                new SelectListItem { Text = "Failed", Value = "FAILED" }
                            }, new { @id = "ddl_status", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_security_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_security_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="retailerSecurityTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Security totals (amount)</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideRetailerSecurityTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Success</span>
                            <strong class="vm-opr-total-card__value" id="retailerSecuritySuccess">&#8377; 0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Failed</span>
                            <strong class="vm-opr-total-card__value" id="retailerSecurityFailed">&#8377; 0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Pending</span>
                            <strong class="vm-opr-total-card__value" id="retailerSecurityPending">&#8377; 0.00</strong>
                        </div>
                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-shield-alt" aria-hidden="true"></i>
                        <span>Security report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong>@rowCount</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-ecomm-totals-btn" onclick="showRetailerSecurityTotals()" title="Show totals" aria-expanded="false" aria-controls="retailerSecurityTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnExportRetailerSecurity" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDFRetailerSecurity" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="retailerSecurityReport" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Status</th>
                                    <th>Plan&nbsp;name</th>
                                    <th>Customer&nbsp;mobile</th>
                                    <th>Customer&nbsp;email</th>
                                    <th>Pre&nbsp;&#8377;</th>
                                    <th>Amount&nbsp;&#8377;</th>
                                    <th>Cr/Dr&nbsp;&#8377;</th>
                                    <th>Post&nbsp;&#8377;</th>
                                    <th>Request&nbsp;time</th>
                                    <th>Operator&nbsp;id</th>
                                </tr>
                            </thead>
                            <tbody id="retailerSecurityRows">
                                @if (reports.Count > 0)
                                {
                                    foreach (var item in reports)
                                    {
                                        var st = (item.Status ?? "").Trim();
                                        var stu = st.ToUpper();
                                        var tone = "refund";
                                        var fa = "fa-undo";
                                        var dataStatus = "PENDING";
                                        if (stu == "SUCCESS")
                                        {
                                            tone = "success";
                                            fa = "fa-check";
                                            dataStatus = "SUCCESS";
                                        }
                                        else if (stu == "FAILED")
                                        {
                                            tone = "failed";
                                            fa = "fa-times";
                                            dataStatus = "FAILED";
                                        }
                                        else if (stu == "PENDING")
                                        {
                                            tone = "pending";
                                            fa = "fa-clock-o";
                                            dataStatus = "PENDING";
                                        }
                                        var amt = item.amount ?? 0m;
                                        var paid = item.total_rem_pay ?? 0m;
                                        var crdr = amt - paid;
                                        <tr class="vm-dmt-row" data-amount="@amt" data-status="@dataStatus">
                                            <td>
                                                <span class="vm-dmt-status vm-dmt-status--@tone" title="@st"><i class="fa @fa" aria-hidden="true"></i></span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-consumer-text">@item.plan_nm</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-refno-text">@item.customermobile</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-refno-text">@item.customeremail</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(item.rempre ?? 0m, 2)</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(amt, 2)</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(crdr, 2)</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(item.rempost ?? 0m, 2)</span>
                                            </td>
                                            <td class="vm-ticket-time-cell">
                                                <span class="vm-dmt-refno-text">@(item.transfer_time.HasValue ? String.Format("{0:dd-MMM-yyyy HH:mm:ss}", item.transfer_time.Value) : "—")</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-refno-text">@item.OPerator_id</span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="10" class="vm-opr-table-empty vm-dmt-table-empty">
                                            <i class="fas fa-shield-alt" aria-hidden="true"></i>
                                            <span>No security records found.</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section PostVmScripts {
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    function hideRetailerSecurityTotals() {
        var $panel = jQuery('#retailerSecurityTotalsPanel');
        var $btn = jQuery('.saas-retailer-security-page .vm-ecomm-totals-btn');
        $panel.hide().attr('aria-hidden', 'true');
        $btn.attr('aria-expanded', 'false');
    }

    function showRetailerSecurityTotals() {
        var $panel = jQuery('#retailerSecurityTotalsPanel');
        var $btn = jQuery('.saas-retailer-security-page .vm-ecomm-totals-btn');
        if ($panel.is(':visible')) {
            hideRetailerSecurityTotals();
            return;
        }
        var success = 0, failed = 0, pending = 0;
        jQuery('#retailerSecurityRows tr.vm-dmt-row').each(function () {
            var amt = parseFloat(jQuery(this).attr('data-amount')) || 0;
            var st = (jQuery(this).attr('data-status') || '').toUpperCase();
            if (st === 'SUCCESS') { success += amt; }
            else if (st === 'FAILED') { failed += amt; }
            else { pending += amt; }
        });
        jQuery('#retailerSecuritySuccess').html('&#8377; ' + success.toFixed(2));
        jQuery('#retailerSecurityFailed').html('&#8377; ' + failed.toFixed(2));
        jQuery('#retailerSecurityPending').html('&#8377; ' + pending.toFixed(2));
        $panel.show().attr('aria-hidden', 'false');
        $btn.attr('aria-expanded', 'true');
    }

    function retailerSecurityFilters() {
        return {
            ddl_status: jQuery('#ddl_status').val() || '',
            txt_frm_date: jQuery('#retailer_security_frm_date').val() || '',
            txt_to_date: jQuery('#retailer_security_to_date').val() || ''
        };
    }

    function initRetailerSecuritySelect2() {
        var $scope = jQuery('.saas-retailer-security-page');
        $scope.find('#ddl_status').each(function () {
            var $el = jQuery(this);
            if (!$el.length || !jQuery.fn.select2) {
                return;
            }
            if ($el.hasClass('select2-hidden-accessible')) {
                try { $el.select2('destroy'); } catch (e) { }
            }
            var opts = {
                width: '100%',
                dropdownParent: jQuery(document.body),
                minimumResultsForSearch: 0,
                dropdownCssClass: 'vm-admin-select2-dropdown vm-admin-select2-searchable'
            };
            if (typeof window.forceAdminSelect2 === 'function') {
                window.forceAdminSelect2($el, opts, true);
            } else if (typeof window.applyAdminSelect2 === 'function') {
                window.applyAdminSelect2($el, opts, true);
            } else {
                $el.select2(opts);
            }
        });
    }

    function initRetailerSecurityDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initRetailerSecurityDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm(
                '#retailerSecurityForm',
                '#retailer_security_frm_date',
                '#retailer_security_to_date',
                true
            );
        }
    }

    jQuery(function () {
        initRetailerSecuritySelect2();
        initRetailerSecurityDatepickers();
        window.setTimeout(initRetailerSecurityDatepickers, 150);
        jQuery('#btnExportRetailerSecurity').on('click', function (e) {
            e.preventDefault();
            var f = retailerSecurityFilters();
            location.href = '@Url.Action("ExcelSecurityReport", "Home")?ddl_status=' + encodeURIComponent(f.ddl_status) + '&txt_frm_date=' + encodeURIComponent(f.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(f.txt_to_date);
        });
        jQuery('#btnPDFRetailerSecurity').on('click', function () {
            var f = retailerSecurityFilters();
            window.open('@Url.Action("PDF_SecurityReport", "Home")?ddl_status=' + encodeURIComponent(f.ddl_status) + '&txt_frm_date=' + encodeURIComponent(f.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(f.txt_to_date), '_blank');
        });
    });
</script>
}
