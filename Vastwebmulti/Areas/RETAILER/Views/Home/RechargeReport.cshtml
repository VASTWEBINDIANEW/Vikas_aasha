@model List<Vastwebmulti.Models.Sp_Recharge_info_LazyLoad_Result>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Prepaid & Utility Report";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var selStatus = (Request["ddl_status"] ?? "").Trim();
    var selOperator = (Request["Operator"] ?? "").Trim();
    var selMob = (Request["txtmob"] ?? "").Trim();
    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=43" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=22" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.0.1/css/toastr.css" rel="stylesheet" />
<style>
    /* Consumer number is a text input, not a select — kill the select chevron from .vm-dmt-filter-row .form-control */
    body.saas-admin-ui .saas-retailer-recharge-report-page .vm-dmt-filter-row input.vm-rch-consumer-text.form-control {
        background-image: none !important;
        cursor: text !important;
        padding: 0 10px !important;
    }
</style>

<div id="loadermoney" class="vm-dmt-loader" style="display:none;"></div>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-retailer-recharge-report-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var rchFormAttrs = new Dictionary<string, object>
            {
                { "id", "retailerRechargeReportForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-report-date-form", "" },
                { "data-report-from", "#retailer_rch_frm_date" },
                { "data-report-to", "#retailer_rch_to_date" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("RechargeReport", "Home", FormMethod.Post, rchFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Reports</li>
                        <li>Prepaid &amp; Utility</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters">

                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("ddl_status", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "All Status", Value = "", Selected = string.IsNullOrEmpty(selStatus) },
                                new SelectListItem { Text = "Success", Value = "SUCCESS", Selected = selStatus == "SUCCESS" },
                                new SelectListItem { Text = "Pending", Value = "PENDING", Selected = selStatus == "PENDING" },
                                new SelectListItem { Text = "Failed", Value = "FAILED", Selected = selStatus == "FAILED" }
                            }, new { id = "ddl_status", @class = "vm-opr-select vm-dmt-select form-control", title = "Status" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("Operator", ViewBag.Operator as SelectList, "All Operators", new { id = "Operator", @class = "vm-opr-select vm-dmt-select form-control", title = "Operator" })
                        </div>

                        <div class="vm-opr-field vm-dmt-field vm-opr-field--text">
                            @Html.TextBox("txtmob", selMob, new { @class = "form-control vm-rch-consumer-text", placeholder = "Consumer number", autocomplete = "off", id = "txtmob", title = "Consumer number", onkeypress = "return isNumber(event)" })
                        </div>

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_rch_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_rch_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="retailerRechargeTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Recharge totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideRetailerRechargeTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--primary">
                            <span class="vm-opr-total-card__label">Total Amount</span>
                            <strong class="vm-opr-total-card__value" id="retailerRchTotalAmount">0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Success</span>
                            <strong class="vm-opr-total-card__value" id="retailerRchSuccessAmount">0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Failed</span>
                            <strong class="vm-opr-total-card__value" id="retailerRchFailedAmount">0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Pending</span>
                            <strong class="vm-opr-total-card__value" id="retailerRchPendingAmount">0.00</strong>
                        </div>
                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-bolt" aria-hidden="true"></i>
                        <span>Prepaid &amp; utility report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-inline-total" title="Total of current filter">
                            Total: <strong>&#8377; <span id="retailerRchInlineTotal">0.00</span></strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn" onclick="findtotalRetailerRecharge()" title="Show totals" aria-expanded="false" aria-controls="retailerRechargeTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnRetailerRchExcel" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnRetailerRchPdf" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="retailerRechargeReport" class="table vm-opr-data-table" cellspacing="0" style="width:100%;">
                            <thead>
                                <tr>
                                    <th>Category</th>
                                    <th>Consumer<br>Circle</th>
                                    <th>Operator<br>Name</th>
                                    <th>Net&nbsp;Amt<br>&#8377;</th>
                                    <th>Debit<br>Credit</th>
                                    <th>Earn<br>&#8377;</th>
                                    <th>Extra<br>Comm</th>
                                    <th>Remain<br>Pre&nbsp;&#8377;</th>
                                    <th>Remain<br>Post&nbsp;&#8377;</th>
                                    <th>Trans.<br>ID</th>
                                    <th>Request<br>Date</th>
                                    <th>Resp<br>Date</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody id="retailerRechargeRows">
                                @{ Html.RenderAction("_Rechargereport", "Home", new { txt_frm_date = frmDate, txt_to_date = toDate, ddl_status = selStatus, Operator = selOperator, txtmob = selMob }); }
                            </tbody>
                        </table>
                    </div>
                    <div id="retailerRchLoading" style="text-align:center;display:none;padding:14px;">
                        <span class="loadertablecssnew">Loading…</span>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<!-- Dispute modal (single, page level) -->
<div class="modal fade vm-admin-modal" id="retailerRchDisputeModal" tabindex="-1" role="dialog" aria-labelledby="retailerRchDisputeTitle" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="retailerRchDisputeTitle">Raise complaint</h4>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body">
                <p class="text-muted" id="retailerRchDisputeSub">Enter details to raise a complaint.</p>
                <input type="hidden" id="retailerRchDisputeId" />
                <input type="hidden" id="retailerRchDisputeMobile" />
                <input type="hidden" id="retailerRchDisputeOp" />
                <input type="hidden" id="retailerRchDisputeAmt" />
                <div class="form-group">
                    <label for="retailerRchDisputeText">Description</label>
                    <textarea id="retailerRchDisputeText" class="form-control" rows="3" placeholder="Enter detailed complaint…"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="saas-acc-btn" data-dismiss="modal">Close</button>
                <button type="button" class="saas-acc-btn saas-acc-btn--search" onclick="submitRetailerRchDispute()">Submit</button>
            </div>
        </div>
    </div>
</div>

<!-- Complaint success modal -->
<div class="modal fade vm-admin-modal" id="retailerRchComplaintSuccessModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm" role="document">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Success</h5>
                <button type="button" class="close text-white" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
            </div>
            <div class="modal-body"><strong>Complaint submitted successfully!</strong></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success" data-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

@section PostVmScripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/2.0.1/js/toastr.js"></script>
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    window.retailerRchBaseUrl = '@Url.Action("RechargeReport", "Home")';
    var retailerRchPageIndex = 2;
    var retailerRchNoMore = false;
    var retailerRchBusy = false;

    function isNumber(evt) {
        var iKeyCode = (evt.which) ? evt.which : evt.keyCode;
        if (iKeyCode != 45 && iKeyCode > 31 && (iKeyCode < 48 || iKeyCode > 57)) {
            return false;
        }
        return true;
    }

    function retailerRchFilters() {
        return {
            txt_frm_date: jQuery('#retailer_rch_frm_date').val() || '',
            txt_to_date: jQuery('#retailer_rch_to_date').val() || '',
            ddl_status: jQuery('#ddl_status').val() || '',
            Operator: jQuery('#Operator').val() || '',
            txtmob: jQuery('#txtmob').val() || ''
        };
    }

    function formatRchAmount(value) {
        var num = parseFloat(value);
        if (isNaN(num)) { return '0.00'; }
        return num.toFixed(2);
    }

    function applyRetailerRchTotals(data) {
        if (!data) { return; }
        var success = parseFloat(data.success) || 0;
        var failed = parseFloat(data.failed) || 0;
        var pending = parseFloat(data.pending) || 0;
        jQuery('#retailerRchSuccessAmount').text(formatRchAmount(success));
        jQuery('#retailerRchFailedAmount').text(formatRchAmount(failed));
        jQuery('#retailerRchPendingAmount').text(formatRchAmount(pending));
        jQuery('#retailerRchTotalAmount').text(formatRchAmount(success + failed + pending));
        jQuery('#retailerRchInlineTotal').text(formatRchAmount(success + failed + pending));
    }

    function collectRetailerRchTotalsFromTable() {
        var success = 0, failed = 0, pending = 0;
        jQuery('#retailerRechargeRows tr.vm-dmt-row').each(function () {
            var amount = parseFloat(jQuery(this).attr('data-amount'));
            if (isNaN(amount)) { amount = 0; }
            var status = (jQuery(this).attr('data-status') || '').toString().toUpperCase();
            if (status === 'SUCCESS') { success += amount; }
            else if (status === 'FAILED') { failed += amount; }
            else { pending += amount; }
        });
        return { success: success, failed: failed, pending: pending };
    }

    function findtotalRetailerRecharge() {
        var panel = jQuery('#retailerRechargeTotalsPanel');
        var btn = jQuery('.vm-opr-totals-btn');
        if (panel.is(':visible')) {
            hideRetailerRechargeTotals();
            return;
        }
        jQuery('#loadermoney').show();
        jQuery.post('@Url.Action("FindTotal", "Home")', retailerRchFilters())
            .done(function (data) {
                applyRetailerRchTotals(data);
                panel.slideDown(180).attr('aria-hidden', 'false');
                btn.attr('aria-expanded', 'true');
            })
            .fail(function () {
                applyRetailerRchTotals(collectRetailerRchTotalsFromTable());
                panel.slideDown(180).attr('aria-hidden', 'false');
                btn.attr('aria-expanded', 'true');
            })
            .always(function () {
                jQuery('#loadermoney').hide();
            });
    }

    function hideRetailerRechargeTotals() {
        jQuery('#retailerRechargeTotalsPanel').slideUp(180).attr('aria-hidden', 'true');
        jQuery('.vm-opr-totals-btn').attr('aria-expanded', 'false');
    }

    function buildRetailerRchExportQuery() {
        var f = retailerRchFilters();
        return 'txt_frm_date=' + encodeURIComponent(f.txt_frm_date)
            + '&txt_to_date=' + encodeURIComponent(f.txt_to_date)
            + '&ddl_status=' + encodeURIComponent(f.ddl_status)
            + '&Operator=' + encodeURIComponent(f.Operator)
            + '&txtmob=' + encodeURIComponent(f.txtmob);
    }

    function GotoPDFRecharge(e) {
        var idno = e.toString();
        var url = '@Url.Action("RechargePDF", "Home")?Idno=' + idno;
        window.open(url, '_blank');
    }

    function GenrateInvoice(ultra_request_id, RechargeTo, OptName, amt, OptID, Date) {
        var url = '@Url.Action("GotoInvoicePDF1", "Home")?Id=' + ultra_request_id + '&RechargeTo=' + RechargeTo + '&OptName=' + OptName + '&amt=' + amt + '&OptID=' + OptID + '&Date=' + Date;
        window.open(url, '_blank');
    }

    function Heavyrefreshbtn(optname, mobile) {
        jQuery.ajax({
            url: '@Url.Action("HeavyRefreshurldth", "Home")',
            type: 'POST',
            data: { optname: optname, mobileno: mobile },
            success: function (response) {
                if (response === 'OK') {
                    alert('Heavy Request Successfully Sent');
                }
            }
        });
    }

    function openRetailerRchDispute(id, mobile, opname, amount, category) {
        jQuery('#retailerRchDisputeId').val(id);
        jQuery('#retailerRchDisputeMobile').val(mobile);
        jQuery('#retailerRchDisputeOp').val(opname);
        jQuery('#retailerRchDisputeAmt').val(amount);
        jQuery('#retailerRchDisputeText').val('');
        jQuery('#retailerRchDisputeSub').text((category || 'Recharge') + ' • ' + opname + ' • ' + mobile + ' • ₹' + amount);
        jQuery('#retailerRchDisputeModal').modal('show');
    }

    function submitRetailerRchDispute() {
        var id = jQuery('#retailerRchDisputeId').val();
        var txtregion = jQuery.trim(jQuery('#retailerRchDisputeText').val());
        if (!txtregion) {
            if (window.toastr) { toastr.warning('Please enter a description!'); }
            else { alert('Please enter a description!'); }
            return;
        }
        jQuery('#loadermoney').show();
        jQuery.post('@Url.Action("dispute", "Home")', {
            id: id,
            txtregion: txtregion,
            mobileno: jQuery('#retailerRchDisputeMobile').val(),
            optname: jQuery('#retailerRchDisputeOp').val(),
            amount: jQuery('#retailerRchDisputeAmt').val()
        })
        .done(function (data) {
            jQuery('#retailerRchDisputeModal').modal('hide');
            if (data === 'Success') {
                jQuery('#retailerRchComplaintSuccessModal').modal('show');
            } else if (window.toastr) {
                toastr.info(data);
            } else {
                alert(data);
            }
        })
        .fail(function (xhr) {
            if (window.toastr) { toastr.error('Error: ' + xhr.responseText); }
            else { alert('Error: ' + xhr.responseText); }
        })
        .always(function () {
            jQuery('#loadermoney').hide();
        });
    }

    function initRetailerRchSelect2() {
        jQuery('#ddl_status, #Operator').each(function () {
            var $el = jQuery(this);
            if (!$el.length || !jQuery.fn.select2) { return; }
            if ($el.hasClass('select2-hidden-accessible')) {
                try { $el.select2('destroy'); } catch (e) { }
            }
            $el.select2({ width: '100%', minimumResultsForSearch: 6 });
        });
    }

    function initRetailerRchDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initRetailerRchDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm(
                '#retailerRechargeReportForm',
                '#retailer_rch_frm_date',
                '#retailer_rch_to_date',
                true
            );
        }
    }

    jQuery(function () {
        initRetailerRchSelect2();
        initRetailerRchDatepickers();
        window.setTimeout(initRetailerRchDatepickers, 150);

        jQuery('#btnRetailerRchExcel').on('click', function () {
            location.href = '@Url.Action("ExcelRechargereport", "Home")?' + buildRetailerRchExportQuery();
        });
        jQuery('#btnRetailerRchPdf').on('click', function () {
            window.open('@Url.Action("PDFRechargereport", "Home")?' + buildRetailerRchExportQuery(), '_blank');
        });

        applyRetailerRchTotals(collectRetailerRchTotalsFromTable());

        jQuery(window).on('scroll', function () {
            if (retailerRchNoMore || retailerRchBusy) { return; }
            var nearBottom = jQuery(window).scrollTop() + jQuery(window).height() > jQuery(document).height() - 400;
            if (!nearBottom) { return; }
            retailerRchBusy = true;
            jQuery('#retailerRchLoading').show();
            var payload = retailerRchFilters();
            payload.pageindex = retailerRchPageIndex;
            jQuery.post('@Url.Action("InfiniteScroll", "Home")', payload)
                .done(function (data) {
                    retailerRchPageIndex = retailerRchPageIndex + 1;
                    retailerRchNoMore = data.NoMoredata;
                    if (data.HTMLString) {
                        jQuery('#retailerRechargeRows').append(data.HTMLString);
                        applyRetailerRchTotals(collectRetailerRchTotalsFromTable());
                    }
                })
                .always(function () {
                    jQuery('#retailerRchLoading').hide();
                    retailerRchBusy = false;
                });
        });
    });
</script>
}
