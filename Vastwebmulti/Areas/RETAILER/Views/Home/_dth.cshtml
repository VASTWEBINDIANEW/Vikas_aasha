@model Vastwebmulti.Areas.RETAILER.Models.remmulti

@* vm-rch: DTH — same one-line grid as Mobile (vm-rch-formgrid) *@
<div id="dthrchform" class="vm-rch-formgrid fund-transfer-form">
    <div class="vm-rch-fcell vm-rch-fop dthrchform-class">
        <div>
            <p id="dthoperator" class="vm-rch-err"></p>
        </div>
        <i class="fa fa-television vm-rch-in-ico vm-rch-in-ico--op" aria-hidden="true"></i>
        @Html.DropDownList("dthddl", ViewBag.dth as SelectList, "Select Operators", new { id = "dthddl", @class = "form-control", onchange = "dthddltype(this)" })
    </div>

    <div class="vm-rch-fcell vm-rch-fnum dthrchform-first">
        <div>
            <p id="dthmessage" class="vm-rch-err"></p>
        </div>
        <i class="fa fa-id-card vm-rch-in-ico" aria-hidden="true"></i>
        <input type="text" id="txtdthcardno" name="txtdthcardno" class="form-control" placeholder="Enter Customer Id (start with 3)" onkeypress="return isNumber(event)" />
        <div class="vm-rch-infield-action dthrchform-for" id="dthtvviewplan" style="display: none; margin: 0px 0 0 !important; right: 0px !important; ">
            <a href="#" id="dthplaan" class="vm-rch-linkbtn vm-rch-linkbtn--ok" onclick="getdthviewofferplan(); return false;">Customer&nbsp;Info</a>
        </div>
    </div>

    <div class="vm-rch-fcell vm-rch-famt dthrchform-second">
        <div>
            <p id="dthamtmessage" class="vm-rch-err"></p>
        </div>
        <i class="fa fa-inr vm-rch-in-ico" aria-hidden="true"></i>
        <input type="text" id="txtdthamount" name="txtdthamount" class="form-control" placeholder="Enter Amount" onkeypress="return isNumber(event)" />
    </div>

    <div class="vm-rch-fcell vm-rch-fbtn2 dthrchform-three vm-rch-fbtn2--aux" id="checkplan" style="display:none;">
        <a href="#" class="vm-rch-linkbtn vm-rch-linkbtn--warn" onclick="getbestViewofferplandth(); return false;">Check&nbsp;Plan's</a>
    </div>

    <div class="vm-rch-fcell vm-rch-fbtn2 dthrchform-five">
        <input type="button" id="btn" class="btn bg-blue-grey" value="Continue" onclick="getdthcontinuebtn('dthddl')" />
    </div>
</div>

<div class="loader loaderwww"></div>

<div id="DthmsgBox" style="margin-top:10px;"></div>

  

<table id="confirmDTH" class="for-prepaid" style="width:100%;margin-top:-11px;display:none;">
    <tr>
        <th style="width:10%;"></th>
        <th style="width:30%;">Operator</th>
        <th style="width:30%;">Recharge to</th>
        <th style="width:15%;">amount</th>
        @if (Model.Ispin == true)
        {
            <th style="width:15%;">pin</th>
        }

        <th style="width:15%;">Action</th>
    </tr>
    <tr>
        <td>
            <button style="padding: 5px 20px;" onclick="backDTH()"><img src="~/AdminDesign/images/back.svg" style="width:18px;" /></button>
        </td>
        <td style="font-size: 24px;"><b><span id="showoptdth"></span> </b></td>
        <td class="border-centerbe" style="font-size: 24px;"><b> <span id="shownumberdth"></span> </b></td>
        <td style="font-size: 24px;"><b><span id="showamountdth"></span></b></td>
        @if (Model.Ispin == true)
        {
            <td style="font-size: 24px;">
                <input style=" width: 120px; " type="password"
                       id="DTHRechargepin"
                       name="DTHRechargepin"
                       class="form-control text-center"
                       placeholder="Enter PIN"
                       maxlength="6"
                       autocomplete="off" />
                <span id="DthpinError"
                      style="color:red; font-size:13px; display:none; margin-top:5px;">
                </span>
            </td>
        }
        <td><button style="float: right;background: linear-gradient(135deg, #1e40af, #3b82f6) !important;border: 0px;color: #fff;padding: 4px 19px;font-size: 20px;" onclick="dthprocessToPay()">Procces To Pay</button></td>
    </tr>
</table>
<table id="rechargeconfirmDTH" class="for-prepaid" style="width:100%;margin-top:-11px !important;display:none;">
    <tr>
        <th style="width:25%;">Recharge Status</th>
        <th style="width:37%;">Message</th>
        <th style="width:11%;">Action</th>
    </tr>
    <tr>
        <td style="font-size: 20px;"><b> <span id="rchstatuschkdth"></span> </b></td>
        <td class="border-centerbe border-centerbess" style="font-size: 20px;"><b><span id="rchmsgdth"></span></b></td>
        <td><button style="float: right;background: linear-gradient(135deg, #1e40af, #3b82f6) !important;border: 0px;color: #fff;padding: 4px 19px;font-size: 20px;" onclick="RechargeagainDTH()">Recharge Again</button></td>
    </tr>
</table>

<script src="~/Retailerjavascript/Rechargepaybill/Dth.js"></script>
<script>
    var isDthPinOn = @Model.Ispin.ToString().ToLower();
    j('#dthddl').select2();
    function dthddltype(l) {
        var p = l.options[l.selectedIndex].text;
        getdthdropdowntext(p);
        showdthplanandhideplan(p);
    }
    function backDTH() {
        $('#showoptdth').text("");
        $('#shownumberdth').text("");
        $('#showamountdth').text("");
        $('#confirmDTH').hide();
        $('#dthrchform').show();
    }
    function getdthcontinuebtn(dth) {
        var e = document.getElementById(dth);
        var ddldth = e.options[e.selectedIndex].text;
        var optvalue = e.options[e.selectedIndex].value;
        var custromerid = $("#txtdthcardno").val();
        var dthamount = $("#txtdthamount").val();
        var sts = getdthcontiunebtn(ddldth, custromerid, dthamount);
        if (sts == true) {
            $('#showoptdth').text(ddldth);
            $('#shownumberdth').text(custromerid);
            $('#showamountdth').text(dthamount);
            $('#confirmDTH').show();
            $('#dthrchform').hide();
            $('#DTHCustomerInfo').hide();
            event.preventDefault();
            return false;
        }
        event.preventDefault();
        return false;
    }
    function dthprocessToPay() {
        if (isDthPinOn) {
            var pin = $('#DTHRechargepin').val();
            if (!pin) {
                alert('Please enter transaction PIN');
                $('#DTHRechargepin').focus();
                return;
            }
            DTHrechargeconfirm(pin);
        } else {
            DTHrechargeconfirm('');
        }
    }
    function DTHrechargeconfirm(pin) {
        var e = document.getElementById("dthddl");
        var ddldth = e.options[e.selectedIndex].text;
        var optvalue = e.options[e.selectedIndex].value;
        var custromerid = $("#txtdthcardno").val();
        var dthamount = $("#txtdthamount").val();
        $("#txtdthcardno").val("");
        $("#txtdthamount").val("");
        if (custromerid != "" && dthamount != "") {
            $.ajax({
                type: "POST",
                url: "@Url.Action("Recharge","Home")",
                data: { OperatorName: ddldth, OptCode: optvalue, mobileno: custromerid, Amount: dthamount, optional1: "", optional2: "", optional3: "", optional4: "", comm: "", BillRefId: "", Rechargepin: pin },
                cache: false,
                dataType: 'json',
                beforeSend: function () { $('.loader').show(); },
                success: function (result) {
                    $('#rchstatuschkdth').text(result.Response);
                    $('#rchmsgdth').text(result.Message);
                    $('#confirmDTH').hide();
                    $('#rechargeconfirmDTH').show();
                },
                complete: function () {
                    $("#remainretailer").load(location.href + " #remainretailer");
                    $('.loader').hide();
                    $.ajax({
                        url: '@Url.Action("showrecentrecharge", "Home")',
                        type: 'GET',
                        dataType: "html",
                        data: { type: "DTH" },
                        success: function (data) { $('#reportchk').html(data); }
                    });
                },
                error: function () {
                    $("#remainretailer").load(location.href + " #remainretailer");
                    $('.loader').hide();
                }
            });
        }
    }
    function RechargeagainDTH() {
        $('#numbershowmobile').text("");
        $("#txtdthcardno").val("");
        $("#txtdthamount").val("");
        j('#dthddl').val("");
        j('#dthddl').select2().trigger('change');
        $('#rechargeconfirmDTH').hide();
        $('#dthrchform').show();
    }
    function getdthviewofferplan() {
        var e = document.getElementById("dthddl");
        var optname = e.options[e.selectedIndex].text;
        var textvalue = $("#txtdthcardno").val();
        if (!validationbsetoffer(optname, textvalue)) { return false; }
        $('#dthoffertable').html('');
        $('#airteldthoffertable').html('');
        $('#Videoconoffertable').html('');
        $.ajax({
            url: '@Url.Action("RechargeBestofferplan", "Home")',
            type: 'GET',
            dataType: "json",
            data: { optname: optname, mobileno: textvalue },
            success: function (response) {
                $('#DTHCustomerTbl').empty();
                if (optname == "Dish TV" && response.status == "SUCCESS") {
                    var jsonObj = response.Response;
                    var newRow = "<div class='col-sm-4' style='text-align: left;'>" + "Name :" + jsonObj.SubscriberName + "</br> SubBalance : " + jsonObj.SubsBalance + "</br> Address : " + jsonObj.address + "," + jsonObj.State + "</div>";
                    newRow += "<div class='col-sm-4' style='text-align: left;'> Activated ON : " + jsonObj.ActivatedOn + "</br> SchemeName : " + jsonObj.SchemeName + "</div>";
                    newRow += "<div class='col-sm-4' style='text-align: left;'> Status : " + jsonObj.StatusName + "</br> Payterm Name : " + jsonObj.PaytermName + "</br> Package Price : " + jsonObj.PackagePrice + "</div>";
                    $('#DTHCustomerTbl').append(newRow);
                    $('#DTHCustomerInfo').css('display', 'block');
                }
                if (optname == "Airtel Digital TV" && response.status == "SUCCESS") {
                    var jsonObj = response.Response;
                    $('#DTHCustomerTbl').append("<div class='col-sm-4' style='text-align: left;'>Name :" + jsonObj.name + "</br> Current Balance : " + jsonObj.currentbalance + "</br> valid Till : " + jsonObj.validTill + "</div>");
                    $('#DTHCustomerInfo').css('display', 'block');
                }
                if (optname == "Videocon D2H" && response.status == "SUCCESS") {
                    var jsonObj = response.Response;
                    var newRow = "<div class='col-sm-4' style='text-align: left;'>Name :" + jsonObj.customerName + "</br> Recharge DueDate : " + jsonObj.rechargedueDate + "</div>";
                    newRow += "<div class='col-sm-4' style='text-align: left;'> Monthly Recharge : " + jsonObj.monthlyRecharge + "</br> Customer Status : " + jsonObj.customerStatus + "</div>";
                    $('#DTHCustomerTbl').append(newRow);
                    $('#DTHCustomerInfo').css('display', 'block');
                }
                if (optname == "Tata Sky" && response.status == "SUCCESS") {
                    var jsonObj = response.Response;
                    var newRow = "<div class='col-sm-4' style='text-align: left;'>Name :" + jsonObj.customerName + "</br> Balance : " + jsonObj.balance + "</br> Recharge DueDate : " + jsonObj.rechargedueDate + "</div>";
                    newRow += "<div class='col-sm-4' style='text-align: left;'> Monthly Recharge : " + jsonObj.monthlyRecharge + "</br> Customer Status : " + jsonObj.customerStatus + "</div>";
                    $('#DTHCustomerTbl').append(newRow);
                    $('#DTHCustomerInfo').css('display', 'block');
                }
            }
        });
        return true;
    }
    function getbestViewofferplandth() {
        var e = document.getElementById("dthddl");
        var optname = e.options[e.selectedIndex].text;
        var textvalue = $("#txtdthcardno").val();
        if (!validationbsetoffer(optname, textvalue)) { return false; }
        $('#dthofferopt').text(optname);
        $('#dthofferno').text(textvalue);
        $('#dthbestofferModal').modal('show');
        return false;
    }
</script>
