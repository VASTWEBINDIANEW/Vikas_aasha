@model Vastwebmulti.Areas.RETAILER.Models.remmulti
@* vm-rch: recent recharge table — full-width header, compact side padding *@
<div class="body vm-rch-recent-body">
    <div class="vm-rch-recenthead">
        <div class="vm-rch-recenthead-in">
            <span class="vm-rch-recenthead-ico" aria-hidden="true"><i class="fa fa-history"></i></span>
            <div class="vm-rch-recenthead-text">
                <h2>Recent Activity</h2>
                <span class="vm-rch-recenthead-sub">Latest recharge requests on your account</span>
            </div>
        </div>
    </div>
    <div class="table-responsive vm-rch-recent-scroll">
            <table id="example" class="table vm-rch-recent-table example-recharge recharge-tableoperator" cellspacing="0">
                <thead>
                    <tr class="recharge-tableoperator vm-rch-recent-thead">
                        <th class="vm-rch-recent-th vm-rch-recent-th--op">Operator</th>
                        <th class="vm-rch-recent-th vm-rch-recent-th--id">Req ID</th>
                        <th class="vm-rch-recent-th vm-rch-recent-th--mob">Recharge No</th>
                        <th class="vm-rch-recent-th vm-rch-recent-th--amt">Amount</th>
                        <th class="vm-rch-recent-th vm-rch-recent-th--oid">Operator ID</th>
                        <th class="vm-rch-recent-th vm-rch-recent-th--time">Req Time</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.recent_rechargereport != null)
                    {
                        foreach (var item in Model.recent_rechargereport)
                        {
                            var color = "#000000f2";
                            var icon = "";
                            var opticon = "";
                            if (item.Rstaus.Contains("Request Send"))
                            {
                                color = "#ff9600";
                            }
                            if (item.Rstaus.Contains("FAILED"))
                            {
                                color = "red";
                            }
                            if (item.Rstaus.Contains("SUCCESS"))
                            {
                                color = "green";
                            }

                            if (item.Rstaus.Contains("Refund"))
                            {
                                icon = "fa fa-share-square";
                                color = "blue";
                            }
                            if (item.rch_type == "ONLINE")
                            {
                                icon = "fa fa-globe";
                            }
                            if (item.rch_type == "Apps")
                            {
                                icon = "fa fa-android";
                            }
                            

                            <tr style="color:@color;">
                                <td>
                                    @if (item.Rstaus.ToUpper().Contains("REQ"))
                                    {
                                        <img style="height: 20px;width: 20px;margin-right:3px;float:left;max-width: 100%;padding: 0; background-color:;" src="../../ashok-images/clock.svg">

                                    }
                                    else
                                    {
                                        if (item.Rstaus.ToUpper() == "SUCCESS")
                                        {
                                            <img src="../../ashok-images/correct.svg" style="height:20px;width:20px;margin-right:3px;float:left; background-color:green;" />
                                        }
                                        else
                                        {
                                            <img src="../../ashok-images/closes.svg" style="height:20px;width:20px;margin-right:3px;float:left; background-color:red;" />
                                        }
                                    }

                                    <i class="@opticon"></i>&nbsp;@item.operator_Name
                                </td>
                                <td><i class="@icon" style="font-size:14px;"></i>&nbsp;@item.idno</td>
                                <td>@item.Mobile</td>

                                <td>@item.amount</td>

                                <td style="font-size:14px;">@item.OPt_id</td>
                                <td>
                                    <p style="font-size:14px;">
                                        @String.Format("{0:dd-MMM HH:mm:ss}", item.Rch_time)

                                    </p>
                                </td>
                            </tr>
                        }
                    }

                </tbody>

            </table>

        
    </div>

</div>



<script>
    $(document).ready(function () {
        var $tbl = $('#my-index #reportchk #example.vm-rch-recent-table');
        if ($tbl.length && $.fn.DataTable && !$.fn.DataTable.isDataTable($tbl[0])) {
            $tbl.DataTable({ paging: false, searching: false, info: false, ordering: false });
        }
    });
</script>