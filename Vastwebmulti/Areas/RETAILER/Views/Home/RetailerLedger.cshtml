@model IEnumerable<Vastwebmulti.Models.Sp_ledgerreport_Result>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "RetailerLedger";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
    var reports = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.Sp_ledgerreport_Result>();
    var rowCount = reports.Count;
    decimal totalCredit = reports.Sum(m => (decimal?)m.Credit ?? 0m);
    decimal totalDebit = reports.Sum(m => (decimal?)m.Debit ?? 0m);
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=43" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=22" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<style>
    /* Ledger rows : credit green-tint, debit red-tint */
    body.saas-admin-ui .saas-retailer-ledger-page #retailerLedgerReport tbody tr.vm-ledger-row--credit { background: #f6fef9 !important; }
    body.saas-admin-ui .saas-retailer-ledger-page #retailerLedgerReport tbody tr.vm-ledger-row--debit { background: #fff7f7 !important; }
    body.saas-admin-ui .saas-retailer-ledger-page #retailerLedgerReport tbody tr:hover { background: #f6f9ff !important; }
    body.saas-admin-ui .saas-retailer-ledger-page .vm-ledger-cd { display: inline-flex !important; align-items: center; gap: 5px; font-size: 10.5px; font-weight: 800; padding: 2px 9px; border-radius: 999px; white-space: nowrap; }
    body.saas-admin-ui .saas-retailer-ledger-page .vm-ledger-cd--cr { background: #e7f7ee !important; color: #15803d !important; }
    body.saas-admin-ui .saas-retailer-ledger-page .vm-ledger-cd--dr { background: #fdecec !important; color: #c62828 !important; }
    body.saas-admin-ui .saas-retailer-ledger-page .vm-ledger-nav { display: inline-flex !important; align-items: center; gap: 6px; min-height: 34px; padding: 0 14px; border-radius: 9px; border: 1px solid #dbe2ec; background: #fff; color: #475569; font-size: 12.5px; font-weight: 800; text-decoration: none !important; transition: all .15s ease; white-space: nowrap; }
    body.saas-admin-ui .saas-retailer-ledger-page .vm-ledger-nav:hover { border-color: #2563eb; color: #2563eb; box-shadow: 0 4px 12px rgba(37,99,235,.18); }
    /* Desktop (>=1024px): fit-to-width, no scroll, tight columns */
    @@media (min-width: 1024px) {
        body.saas-admin-ui .saas-retailer-ledger-page #retailerLedgerReport.vm-opr-data-table {
            width: 100% !important;
            min-width: 0 !important;
            max-width: 100% !important;
            table-layout: fixed !important;
        }
        body.saas-admin-ui .saas-retailer-ledger-page #retailerLedgerReport.vm-opr-data-table thead tr,
        body.saas-admin-ui .saas-retailer-ledger-page #retailerLedgerReport.vm-opr-data-table tbody tr {
            display: table-row !important;
        }
        body.saas-admin-ui .saas-retailer-ledger-page #retailerLedgerReport.vm-opr-data-table thead th,
        body.saas-admin-ui .saas-retailer-ledger-page #retailerLedgerReport.vm-opr-data-table tbody td {
            display: table-cell !important;
            min-width: 0 !important;
            max-width: none !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            white-space: nowrap !important;
        }
        body.saas-admin-ui .saas-retailer-ledger-page #retailerLedgerReport.vm-opr-data-table thead th:nth-child(1),
        body.saas-admin-ui .saas-retailer-ledger-page #retailerLedgerReport.vm-opr-data-table tbody td:nth-child(1) { width: 28% !important; }
        body.saas-admin-ui .saas-retailer-ledger-page #retailerLedgerReport.vm-opr-data-table thead th:nth-child(2),
        body.saas-admin-ui .saas-retailer-ledger-page #retailerLedgerReport.vm-opr-data-table tbody td:nth-child(2) { width: 12% !important; }
        body.saas-admin-ui .saas-retailer-ledger-page #retailerLedgerReport.vm-opr-data-table thead th:nth-child(3),
        body.saas-admin-ui .saas-retailer-ledger-page #retailerLedgerReport.vm-opr-data-table tbody td:nth-child(3) { width: 12% !important; }
        body.saas-admin-ui .saas-retailer-ledger-page #retailerLedgerReport.vm-opr-data-table thead th:nth-child(4),
        body.saas-admin-ui .saas-retailer-ledger-page #retailerLedgerReport.vm-opr-data-table tbody td:nth-child(4) { width: 12% !important; }
        body.saas-admin-ui .saas-retailer-ledger-page #retailerLedgerReport.vm-opr-data-table thead th:nth-child(5),
        body.saas-admin-ui .saas-retailer-ledger-page #retailerLedgerReport.vm-opr-data-table tbody td:nth-child(5) { width: 14% !important; }
        body.saas-admin-ui .saas-retailer-ledger-page #retailerLedgerReport.vm-opr-data-table thead th:nth-child(6),
        body.saas-admin-ui .saas-retailer-ledger-page #retailerLedgerReport.vm-opr-data-table tbody td:nth-child(6) { width: 22% !important; }
    }
    /* Mobile + tablet (<=1023px): natural widths, full text, horizontal scroll */
    @@media (max-width: 1023.98px) {
        body.saas-admin-ui .saas-retailer-ledger-page #retailerLedgerReport.vm-opr-data-table {
            width: max-content !important;
            min-width: 900px !important;
            max-width: none !important;
            table-layout: auto !important;
        }
        body.saas-admin-ui .saas-retailer-ledger-page #retailerLedgerReport.vm-opr-data-table thead tr,
        body.saas-admin-ui .saas-retailer-ledger-page #retailerLedgerReport.vm-opr-data-table tbody tr {
            display: table-row !important;
        }
        body.saas-admin-ui .saas-retailer-ledger-page #retailerLedgerReport.vm-opr-data-table thead th,
        body.saas-admin-ui .saas-retailer-ledger-page #retailerLedgerReport.vm-opr-data-table tbody td {
            display: table-cell !important;
            width: auto !important;
            min-width: 0 !important;
            max-width: none !important;
            white-space: nowrap !important;
            overflow: visible !important;
            text-overflow: clip !important;
        }
        body.saas-admin-ui .saas-retailer-ledger-page .vm-opr-table-scroll {
            overflow-x: auto !important;
        }
    }
</style>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-retailer-ecomm-transaction-page saas-retailer-ledger-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var ledgerFormAttrs = new Dictionary<string, object>
            {
                { "id", "retailerLedgerForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-report-date-form", "" },
                { "data-report-from", "#retailer_ledger_frm_date" },
                { "data-report-to", "#retailer_ledger_to_date" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("RetailerLedger", "Home", FormMethod.Post, ledgerFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home", new { area = "RETAILER" })"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>My Account</li>
                        <li>Retailer Ledger</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters vm-ecomm-filter-row--one-line">

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_ledger_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_ledger_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="retailerLedgerTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Ledger totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideRetailerLedgerTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Total credit</span>
                            <strong class="vm-opr-total-card__value">&#8377; @totalCredit.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Total debit</span>
                            <strong class="vm-opr-total-card__value">&#8377; @totalDebit.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Records</span>
                            <strong class="vm-opr-total-card__value">@rowCount</strong>
                        </div>
                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-book" aria-hidden="true"></i>
                        <span>Retailer ledger</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong id="retailerLedgerRowCount">@rowCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total" title="Total credit">
                            Cr: <strong>&#8377; @totalCredit.ToString("N2")</strong>
                        </span>
                        <span class="vm-radiant-inline-total" title="Total debit">
                            Dr: <strong>&#8377; @totalDebit.ToString("N2")</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <a class="vm-ledger-nav" href="@Url.Action("CMSLedger", "Home")" title="CMS Ledger"><i class="fas fa-university" aria-hidden="true"></i> CMS Ledger</a>
                            <a class="vm-ledger-nav" href="@Url.Action("PosLedger", "Home")" title="Pos Ledger"><i class="fas fa-credit-card" aria-hidden="true"></i> Pos Ledger</a>
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-ecomm-totals-btn" onclick="showRetailerLedgerTotals()" title="Show totals" aria-expanded="false" aria-controls="retailerLedgerTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnExportRetailerLedger" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDFRetailerLedger" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="retailerLedgerReport" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Particular</th>
                                    <th>Amount &#8377;</th>
                                    <th>Credit</th>
                                    <th>Debit</th>
                                    <th>Balance</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody id="trow">
                                @{
                                    Html.RenderAction("_RetailerLedger", "Home", new { Model = Model });
                                }
                            </tbody>
                        </table>
                        <div id="loadingdiv" class="vm-opr-table-loading vm-dmt-table-loading" style="display:none;">
                            <div class="vm-dmt-table-loader" role="status" aria-live="polite" aria-label="Loading ledger">
                                <div class="vm-dmt-table-loader__spinner" aria-hidden="true"></div>
                                <span class="vm-dmt-table-loader__text">Loading more records…</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section PostVmScripts {
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    var retailerLedgerPageIndex = 2;
    var retailerLedgerNoMore = false;
    var retailerLedgerBusy = false;

    function hideRetailerLedgerTotals() {
        var $panel = jQuery('#retailerLedgerTotalsPanel');
        var $btn = jQuery('.saas-retailer-ledger-page .vm-ecomm-totals-btn');
        $panel.hide().attr('aria-hidden', 'true');
        $btn.attr('aria-expanded', 'false');
    }

    function showRetailerLedgerTotals() {
        var $panel = jQuery('#retailerLedgerTotalsPanel');
        var $btn = jQuery('.saas-retailer-ledger-page .vm-ecomm-totals-btn');
        if ($panel.is(':visible')) {
            hideRetailerLedgerTotals();
            return;
        }
        $panel.show().attr('aria-hidden', 'false');
        $btn.attr('aria-expanded', 'true');
    }

    function retailerLedgerDates() {
        return {
            txt_frm_date: jQuery('#retailer_ledger_frm_date').val() || '',
            txt_to_date: jQuery('#retailer_ledger_to_date').val() || ''
        };
    }

    function loadMoreRetailerLedger() {
        if (retailerLedgerNoMore || retailerLedgerBusy) { return; }
        retailerLedgerBusy = true;
        jQuery('#loadingdiv').show();
        var d = retailerLedgerDates();
        jQuery.post('@Url.Action("InfiniteScrollLedger", "Home")',
            { pageindex: retailerLedgerPageIndex, txt_frm_date: d.txt_frm_date, txt_to_date: d.txt_to_date },
            function (data) {
                retailerLedgerPageIndex = retailerLedgerPageIndex + 1;
                if (data) {
                    retailerLedgerNoMore = data.NoMoredata;
                    if (data.HTMLString) { jQuery('#trow').append(data.HTMLString); }
                } else {
                    retailerLedgerNoMore = true;
                }
                jQuery('#loadingdiv').hide();
                retailerLedgerBusy = false;
            }, 'json').fail(function () {
                jQuery('#loadingdiv').hide();
                retailerLedgerBusy = false;
            });
    }

    function initRetailerLedgerDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initRetailerLedgerDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm(
                '#retailerLedgerForm',
                '#retailer_ledger_frm_date',
                '#retailer_ledger_to_date',
                true
            );
        }
    }

    jQuery(function () {
        initRetailerLedgerDatepickers();
        window.setTimeout(initRetailerLedgerDatepickers, 150);
        jQuery(window).on('scroll', function () {
            if (jQuery(window).scrollTop() + jQuery(window).height() > jQuery(document).height() - 250) {
                loadMoreRetailerLedger();
            }
        });
        jQuery('#btnExportRetailerLedger').on('click', function (e) {
            e.preventDefault();
            var d = retailerLedgerDates();
            location.href = '@Url.Action("Excel_Retailer_Ledger", "Home")?txt_frm_date=' + encodeURIComponent(d.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(d.txt_to_date);
        });
        jQuery('#btnPDFRetailerLedger').on('click', function () {
            var d = retailerLedgerDates();
            window.open('@Url.Action("PDF_RetailerLedger", "Home")?txt_frm_date=' + encodeURIComponent(d.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(d.txt_to_date), '_blank');
        });
    });
</script>
}
