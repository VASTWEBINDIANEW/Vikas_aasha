
@{
    ViewBag.Title = "AccountOpening";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";
    var raoFrmDate = DateTime.Today.ToString("yyyy-MM-dd");
    var raoToDate = raoFrmDate;
}
<link href="~/MainFrontDesign/css/retailer-money-transfer-modern.css?v=45" rel="stylesheet" />
<link href="~/MainFrontDesign/css/retailer-account-opening-modern.css?v=9" rel="stylesheet" />
<section class="vm-rmt-page vm-rao-page content">
    <div id="full" class="vm-rmt-left-panel">
        <div class="vm-rmt-left-shell">
            <ul class="vm-rmt-service-tabs" id="tabsmyss" role="tablist">
                <li class="vm-rmt-tab-item current" role="tab" aria-selected="true" data-tab="tab-1" tabindex="0">
                    <span class="vm-rmt-tab-icon-wrap" aria-hidden="true">
                        <img class="vm-rmt-tab-icon vm-rmt-tab-icon--active" src="~/images/transfer.svg" alt="" />
                        <img class="vm-rmt-tab-icon vm-rmt-tab-icon--idle" src="~/images/transfer-money.png" alt="" />
                    </span>
                    <span class="vm-rmt-tab-label">Axis&nbsp;Bank<small class="vm-rmt-tab-sublabel">Saving A/c</small></span>
                </li>
                <li class="vm-rmt-tab-item" role="tab" aria-selected="false" data-tab="tab-2" tabindex="0">
                    <span class="vm-rmt-tab-icon-wrap" aria-hidden="true">
                        <img class="vm-rmt-tab-icon vm-rmt-tab-icon--active" src="~/images/aeps1.png" alt="" />
                        <img class="vm-rmt-tab-icon vm-rmt-tab-icon--idle" src="~/images/aespicon.png" alt="" />
                    </span>
                    <span class="vm-rmt-tab-label">ICICI&nbsp;Bank<small class="vm-rmt-tab-sublabel">Coming soon</small></span>
                </li>
            </ul>

            <div id="tab-1" class="vm-rmt-tab-pane tab-content current" aria-hidden="false">
                <div id="reload" class="vm-rao-pane-body">
                    @Html.Partial("_account_opening")
                </div>
            </div>
            <div id="tab-2" class="vm-rmt-tab-pane tab-content" aria-hidden="true">
                <div class="vm-rao-coming-soon">
                    <p class="vm-rao-coming-soon__title">Coming soon</p>
                    <p class="vm-rao-coming-soon__hint">ICICI account opening will be available here.</p>
                </div>
            </div>
            <div id="backtodashboardcall" data-request-url="@Url.Action("Dashboard", "Home")"></div>
            <input type="hidden" id="latss" required name="latss" />
            <input type="hidden" id="longloc" required name="longloc" />
        </div>
    </div>

    <div class="vm-rmt-report-panel">
        <div class="vm-rmt-report-shell vm-rao-report-shell">
            <div class="vm-rao-report-card">
                <div class="vm-rao-report-card__head">
                    <div class="vm-rao-report-card__title-wrap">
                        <span class="vm-rao-report-card__title-icon" aria-hidden="true"><i class="fas fa-table-list"></i></span>
                        <h2 class="vm-rao-report-card__title">Account opening report</h2>
                    </div>
                    <div class="vm-rao-report-toolbar" role="search">
                        <label class="vm-rao-search-field">
                            <span class="vm-rao-search-field__icon" aria-hidden="true"><i class="fas fa-search"></i></span>
                            <input type="search" name="search" id="search_axis_input" value="" class="form-control vm-rao-search-field__input" placeholder="Search…" autocomplete="off" aria-label="Search report" />
                        </label>
                        <form id="raoAccountOpeningDateForm" class="vm-rao-date-filter-form" data-report-date-form data-date-mode="set" data-frm-date="@raoFrmDate" data-to-date="@raoToDate" onsubmit="return false;">
                            <div class="vm-dmt-filter-search-group vm-rao-dp-group">
                                <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                    <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                    @Html.TextBox("axis_from_date", raoFrmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "axis_from_date", placeholder = "From", title = "From date" })
                                </div>
                                <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                    <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                    @Html.TextBox("axis_to_date", raoToDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "axis_to_date", placeholder = "To", title = "To date" })
                                </div>
                                <button type="button" class="vm-rao-report-search-btn" id="search_axis_report" title="Search">
                                    <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
                <div id="reportallinone" class="vm-rao-report-card__body">
                    @Html.Partial("_AccountOpeningReport")
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    function vmRaoSwitchTab(tabId) {
        if (!tabId) return;
        var $scope = $('section.vm-rao-page');
        var $tabs = $scope.find('ul.vm-rmt-service-tabs#tabsmyss > li.vm-rmt-tab-item');
        var $panes = $scope.find('#full.vm-rmt-left-panel .vm-rmt-tab-pane');

        $tabs.removeClass('current').attr('aria-selected', 'false');
        $panes.removeClass('current').attr('aria-hidden', 'true');

        $tabs.filter('[data-tab="' + tabId + '"]').addClass('current').attr('aria-selected', 'true');
        $scope.find('#full.vm-rmt-left-panel #' + tabId).addClass('current').attr('aria-hidden', 'false');

        if (tabId === 'tab-1' && typeof fetch_account_opening_status === 'function') {
            fetch_account_opening_status();
        }
    }

    $(document).off('click.vmRaoTabs keydown.vmRaoTabs', 'section.vm-rao-page ul.vm-rmt-service-tabs#tabsmyss > li.vm-rmt-tab-item');
    $(document).on('click.vmRaoTabs', 'section.vm-rao-page ul.vm-rmt-service-tabs#tabsmyss > li.vm-rmt-tab-item', function () {
        vmRaoSwitchTab($(this).attr('data-tab'));
    });
    $(document).on('keydown.vmRaoTabs', 'section.vm-rao-page ul.vm-rmt-service-tabs#tabsmyss > li.vm-rmt-tab-item', function (e) {
        if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            vmRaoSwitchTab($(this).attr('data-tab'));
        }
    });
</script>

<script>
    $(document).ready(function () {
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm('#raoAccountOpeningDateForm', '#axis_from_date', '#axis_to_date');
        }
        fetch_account_opening_status();
    });

    function fetch_account_opening_status() {
        $('#customer_acc_error').text('');
        fetch('@Url.Action("account_customer_status")')
            .then(function (res) { return res.json(); })
            .then(function (data) {
                if (data.status) {
                    $('#account_opening').show();
                    $('#not_active').hide();
                } else {
                    $('#account_opening').hide();
                    $('#not_active').show();
                }
                fetch_axis_report();
            });
    }
</script>

<script>
    var submit_loading = false;
    $('#account_opening_customer_btn').click(function () {
        $('#customer_acc_error').text('');
        if (submit_loading) return;
        submit_loading = true;

        fetch('@Url.Action("activate_customer_account")')
            .then(function (res) { return res.json(); })
            .then(function (data) {
                submit_loading = false;
                if (data.status) {
                    $('#account_opening').show();
                    $('#not_active').hide();
                } else {
                    $('#customer_acc_error').text(data.message);
                }
            })
            .catch(function (err) {
                submit_loading = false;
                $('#customer_acc_error').text(err.message);
            });

        fetch_axis_report();
    });

    function isNumeric(str) {
        if (typeof str != "string") return false;
        return !isNaN(str) && !isNaN(parseFloat(str));
    }
</script>

<script>
    function fetch_axis_report() {
        $.ajax({
            url: '@Url.Action("account_axis_report", "Home")',
            cache: false,
            type: "GET",
            dataType: "html",
            success: function (data) {
                $('#reportallinone').html(data);
            }
        });
    }

    $('#account_submit').click(function () {
        $('#account_submit_error').text('');
        var form = $('#account_form');
        var formData = new FormData(form[0]);

        var fname = formData.get('fname');
        var lname = formData.get('lname');
        var email = formData.get('email');
        var mobile = formData.get('mobile');
        var dob = formData.get('dob');
        var pincode = formData.get('pincode');

        if (!fname) return $('#account_submit_error').text('first name is required');
        if (!lname) return $('#account_submit_error').text('last name is required');
        if (!email) return $('#account_submit_error').text('email is required');
        if (!mobile || mobile.length != 10) return $('#account_submit_error').text('mobile error');
        if (!dob) return $('#account_submit_error').text('dob is required');
        if (!pincode || pincode.length != 6) return $('#account_submit_error').text('pincode error');

        if (submit_loading) return;
        submit_loading = true;

        fetch('@Url.Action("submit_saving_account")', {
            method: 'POST',
            body: formData
        })
            .then(function (res) { return res.json(); })
            .then(function (data) {
                submit_loading = false;
                if (data.status) {
                    window.open(data.url, '_blank');
                    $('#account_reset').click();
                    fetch_axis_report();
                } else {
                    $('#account_submit_error').text(data.message);
                }
            })
            .catch(function (err) {
                submit_loading = false;
                console.error(err);
                $('#account_submit_error').text(err.message);
            });
    });
</script>

<script>
    $('#search_axis_input').on('keydown', function (e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            $('#search_axis_report').click();
        }
    });

    $('#search_axis_report').click(function () {
        var search = $('#search_axis_input').val();
        var from = $('#axis_from_date').val();
        var to = $('#axis_to_date').val();
        $.ajax({
            url: '@Url.Action("account_axis_report", "Home")?search=' + encodeURIComponent(search) + '&from=' + encodeURIComponent(from) + '&to=' + encodeURIComponent(to),
            cache: false,
            type: "GET",
            dataType: "html",
            success: function (data) {
                $('#reportallinone').html(data);
            }
        });
    });

    function status_check(uniqueid) {
        if (submit_loading) return;
        submit_loading = true;
        fetch('@Url.Action("account_status_check")?uniqueid=' + encodeURIComponent(uniqueid), {
            method: 'POST'
        })
            .then(function (res) { return res.json(); })
            .then(function (data) {
                submit_loading = false;
                if (data.status) {
                    fetch_axis_report();
                } else {
                    alert(data.message);
                }
            })
            .catch(function (err) {
                submit_loading = false;
                console.error(err);
                $('#account_submit_error').text(err.message);
            });
    }
</script>

