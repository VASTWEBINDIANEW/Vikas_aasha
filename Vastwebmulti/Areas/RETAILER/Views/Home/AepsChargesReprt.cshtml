@{
    ViewBag.Title = "AEPS Charges Report";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";
    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    var selType = (Request["Type"] ?? "").Trim();
    var dateMode = !string.IsNullOrEmpty(Request["txt_frm_date"]) ? "post" : "get";
    var i = 1;
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=34" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=38" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<style>
    body.saas-admin-ui .saas-retailer-charges-report-page #mmm .vm-dmt-txntype {
        display: block;
        margin: 3px 0 0 0;
        font-size: 0.6rem;
        font-weight: 800;
        color: #334155;
        white-space: nowrap;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        line-height: 1.2;
    }
    /* Compact status cell: small icon-dot on top + tiny label below */
    body.saas-admin-ui .saas-dmt-report-page.saas-retailer-charges-report-page #mmm .vm-dmt-status {
        width: 20px !important;
        height: 20px !important;
        min-width: 20px !important;
        min-height: 20px !important;
        margin: 0 auto !important;
    }
    body.saas-admin-ui .saas-dmt-report-page.saas-retailer-charges-report-page #mmm .vm-dmt-status i.fa {
        display: inline-block !important;
        color: #fff !important;
        font-size: 10px !important;
        line-height: 1 !important;
    }
    body.saas-admin-ui .saas-dmt-report-page.saas-retailer-charges-report-page #mmm tbody td:last-child {
        text-align: center !important;
        min-width: 64px;
    }
</style>

<div id="loadermoney" class="vm-dmt-loader" style="display:none;" aria-hidden="true">
    <div class="vm-dmt-loader__panel" role="status" aria-live="polite" aria-label="Processing">
        <div class="vm-dmt-table-loader__spinner" aria-hidden="true"></div>
        <span class="vm-dmt-loader__text">Please wait…</span>
    </div>
</div>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-retailer-charges-report-page">
    <div class="container-fluid vm-opr-page-shell">

        @{
            var chargesFormAttrs = new Dictionary<string, object>
            {
                { "id", "retailerChargesReportForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-report-date-form", "" },
                { "data-report-from", "#retailer_charges_frm_date" },
                { "data-report-to", "#retailer_charges_to_date" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("AepsChargesReprt", "Home", FormMethod.Post, chargesFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Financial Services</li>
                        <li>AEPS Charges Report</li>
                    </ol>
                    <div class="vm-dmt-fin-nav-row">
                        @Html.Partial("_menuFinicalReport")
                    </div>
                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="retailerChargesTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>AEPS charges totals (loaded rows)</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideRetailerChargesTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">AEPS Charges</span>
                            <strong class="vm-opr-total-card__value" id="retailerChargesAeps">&#8377; 0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">AadharPay Charges</span>
                            <strong class="vm-opr-total-card__value" id="retailerChargesAadharpay">&#8377; 0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">GST</span>
                            <strong class="vm-opr-total-card__value" id="retailerChargesGst">&#8377; 0.00</strong>
                        </div>
                    </div>
                </div>

                <div class="vm-rpt-filters-panel">
                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-rpt-filters-panel__bar">
                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("Type", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "All Type", Value = "", Selected = (selType == "" || selType == "All") },
                                new SelectListItem { Text = "Aeps", Value = "Aeps", Selected = selType == "Aeps" },
                                new SelectListItem { Text = "Aadharpay", Value = "Aadharpay", Selected = selType == "Aadharpay" }
                            }, new { id = "Type", @class = "vm-opr-select vm-dmt-select form-control", title = "Type" })
                        </div>
                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_charges_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_charges_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-percentage" aria-hidden="true"></i>
                        <span>AEPS charges</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn" onclick="FindtotalRetailerCharges()" title="Show totals" aria-expanded="false" aria-controls="retailerChargesTotalsPanel"><i class="fas fa-chart-pie" aria-hidden="true"></i></button>
                            <button type="button" id="btnRetailerChargesExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel"><i class="fas fa-file-excel" aria-hidden="true"></i> Excel</button>
                            <button type="button" id="btnRetailerChargesPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF"><i class="fas fa-file-pdf" aria-hidden="true"></i> PDF</button>
                        </div>
                    </div>
                </div>
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="mmm" class="table vm-opr-data-table" cellspacing="0" style="width:100%;">
                            <thead>
                                <tr>
                                    <th>S.R.</th>
                                    <th>Retailer Name</th>
                                    <th>Mobile</th>
                                    <th>Type</th>
                                    <th>AEPS Charges &#8377;</th>
                                    <th>AadharPay Charges &#8377;</th>
                                    <th>GST &#8377;</th>
                                    <th>Remain Pre &#8377;</th>
                                    <th>Remain Post &#8377;</th>
                                    <th>Transaction Time</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody id="retailerChargesRows">
                                @if (Model != null)
                                {
                                    foreach (var item in Model)
                                    {
                                        var upper = ((item.Status ?? "") as string ?? "").Trim().ToUpper();
                                        var tone = "pending";
                                        var toneFa = "fa-clock-o";
                                        if (upper == "SUCCESS" || upper == "DONE") { tone = "success"; toneFa = "fa-check"; }
                                        else if (upper == "FAILED" || upper.Contains("FAIL")) { tone = "failed"; toneFa = "fa-times"; }
                                        <tr class="vm-dmt-row vm-dmt-row--@tone" data-status="@upper">
                                            <td class="vm-dmt-sr-cell">@i</td>
                                            <td>@item.RetailerName</td>
                                            <td>@item.Mobile</td>
                                            <td>@item.Type</td>
                                            <td class="vm-dmt-amt-cell">@item.AepsCharges</td>
                                            <td class="vm-dmt-amt-cell">@item.AadharpayCharges</td>
                                            <td class="vm-dmt-amt-cell">@item.Gst</td>
                                            <td class="vm-dmt-amt-cell">@item.RemainPre</td>
                                            <td class="vm-dmt-amt-cell">@item.RemainPose</td>
                                            <td>@item.TransactionTime</td>
                                            <td>
                                                <span class="vm-dmt-status vm-dmt-status--@tone" title="@item.Status"><i class="fa @toneFa" aria-hidden="true"></i></span>
                                                <span class="vm-dmt-txntype">@item.Status</span>
                                            </td>
                                        </tr>
                                        i++;
                                    }
                                }
                                @if (i == 1)
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="11" class="vm-opr-table-empty vm-dmt-table-empty">
                                            <div class="vm-opr-empty-state">
                                                <i class="fas fa-inbox" aria-hidden="true"></i>
                                                <h3>Data not found</h3>
                                                <p>Try a different date range or filter.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section PostVmScripts {
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    function retailerChargesFilters() {
        return {
            txt_frm_date: jQuery('#retailer_charges_frm_date').val() || '',
            txt_to_date: jQuery('#retailer_charges_to_date').val() || ''
        };
    }

    function hideRetailerChargesTotals() {
        var $panel = jQuery('#retailerChargesTotalsPanel');
        var $btn = jQuery('.vm-dmt-totals-btn');
        $panel.removeClass('is-open').hide().attr('aria-hidden', 'true');
        $btn.removeClass('is-active').attr({ title: 'Show totals', 'aria-expanded': 'false' });
    }

    function calcRetailerChargesTotals() {
        var aeps = 0, aadharpay = 0, gst = 0;
        jQuery('#retailerChargesRows tr.vm-dmt-row').each(function () {
            var $tds = jQuery(this).find('td');
            aeps += parseFloat(jQuery($tds[4]).text()) || 0;
            aadharpay += parseFloat(jQuery($tds[5]).text()) || 0;
            gst += parseFloat(jQuery($tds[6]).text()) || 0;
        });
        jQuery('#retailerChargesAeps').html('&#8377; ' + aeps.toFixed(4));
        jQuery('#retailerChargesAadharpay').html('&#8377; ' + aadharpay.toFixed(4));
        jQuery('#retailerChargesGst').html('&#8377; ' + gst.toFixed(4));
    }

    function FindtotalRetailerCharges() {
        var $panel = jQuery('#retailerChargesTotalsPanel');
        var $btn = jQuery('.vm-dmt-totals-btn');
        if ($panel.hasClass('is-open')) {
            hideRetailerChargesTotals();
            return;
        }
        $panel.addClass('is-open').show().attr('aria-hidden', 'false');
        $btn.addClass('is-active').attr({ title: 'Hide totals', 'aria-expanded': 'true' });
        calcRetailerChargesTotals();
    }

    function retailerChargesTableHtml() {
        var $tbl = jQuery('#mmm').clone();
        $tbl.find('i.fa').remove();
        return $tbl.prop('outerHTML');
    }

    function initRetailerChargesSelect2() {
        jQuery('#Type').each(function () {
            var $el = jQuery(this);
            if (!$el.length || !jQuery.fn.select2) { return; }
            if ($el.hasClass('select2-hidden-accessible')) {
                try { $el.select2('destroy'); } catch (e) { }
            }
            $el.select2({ width: '100%', minimumResultsForSearch: 6 });
        });
    }

    function initRetailerChargesDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initRetailerChargesDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm(
                '#retailerChargesReportForm',
                '#retailer_charges_frm_date',
                '#retailer_charges_to_date',
                true
            );
        }
    }

    jQuery(function () {
        initRetailerChargesSelect2();
        initRetailerChargesDatepickers();
        window.setTimeout(initRetailerChargesDatepickers, 150);

        jQuery('#btnRetailerChargesExport').on('click', function () {
            if (jQuery('#retailerChargesRows tr.vm-dmt-row').length === 0) {
                alert('Export ke liye koi data nahi hai. Pehle aisi date select karo jisme transactions hon.');
                return;
            }
            var f = retailerChargesFilters();
            var excelHtml = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40">'
                + '<head><meta charset="UTF-8"></head><body>'
                + '<h3>AEPS Charges Report (' + f.txt_frm_date + ' to ' + f.txt_to_date + ')</h3>'
                + retailerChargesTableHtml() + '</body></html>';
            var blob = new Blob(['\ufeff' + excelHtml], { type: 'application/vnd.ms-excel' });
            var a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'AepsCharges_Report_' + f.txt_frm_date + '_to_' + f.txt_to_date + '.xls';
            document.body.appendChild(a);
            a.click();
            window.setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 500);
        });
        jQuery('#btnRetailerChargesPDF').on('click', function () {
            if (jQuery('#retailerChargesRows tr.vm-dmt-row').length === 0) {
                alert('PDF ke liye koi data nahi hai. Pehle aisi date select karo jisme transactions hon.');
                return;
            }
            var f = retailerChargesFilters();
            var w = window.open('', '_blank');
            if (!w) {
                alert('Popup block ho gaya hai. Browser me popup allow karo phir PDF dabao.');
                return;
            }
            w.document.write('<html><head><title>AEPS Charges Report</title>'
                + '<style>body{font-family:Arial,sans-serif;}h3{text-align:center;}'
                + 'table{border-collapse:collapse;width:100%;font-size:11px;}'
                + 'td,th{border:1px solid #000;padding:4px 6px;text-align:left;}'
                + 'thead tr{background:#eee;}</style>'
                + '</head><body>'
                + '<h3>AEPS Charges Report (' + f.txt_frm_date + ' to ' + f.txt_to_date + ')</h3>'
                + retailerChargesTableHtml()
                + '<script>window.onload=function(){window.print();}<\/script>'
                + '</body></html>');
            w.document.close();
            w.focus();
        });
    });
</script>
}
