@using Vastwebmulti.Models;
@model IEnumerable<Vastwebmulti.Models.microatm_rental_report_Result>
@{
    ViewBag.Title = "MicroATM Rental Report";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";
    VastwebmultiEntities DB1 = new VastwebmultiEntities();
    var usernname = DB1.Usernicknames.Where(aa => aa.Role == "Retailer").ToList();
    var favimage = "Balance";
    if (usernname.Count() > 0 && usernname.SingleOrDefault() != null)
    {
        favimage = usernname.SingleOrDefault().NickName;
    }
    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    var dateMode = !string.IsNullOrEmpty(Request["txt_frm_date"]) ? "post" : "get";
    int i = 1;
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=34" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=38" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=47" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<style>
    /* Rental toolbar: breadcrumb + dates + search — always one line on desktop */
    body.saas-admin-ui .saas-retailer-rental-report-page .vm-radiant-toolbar-one-line {
        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        gap: 12px !important;
        flex-wrap: nowrap !important;
    }
    body.saas-admin-ui .saas-retailer-rental-report-page .vm-radiant-toolbar-one-line .vm-dmt-breadcrumb {
        flex: 0 1 auto !important;
        min-width: 0 !important;
        margin-bottom: 0 !important;
    }
    body.saas-admin-ui .saas-retailer-rental-report-page .vm-radiant-toolbar-filters {
        display: flex !important;
        align-items: center !important;
        gap: 8px !important;
        flex-wrap: nowrap !important;
        margin-left: auto !important;
        flex: 0 0 auto !important;
    }
    @@media (max-width: 991px) {
        body.saas-admin-ui .saas-retailer-rental-report-page .vm-radiant-toolbar-one-line {
            flex-wrap: wrap !important;
        }
        body.saas-admin-ui .saas-retailer-rental-report-page .vm-radiant-toolbar-filters {
            flex-wrap: wrap !important;
            margin-left: 0 !important;
            width: 100% !important;
        }
    }
</style>

<div id="loadermoney" class="vm-dmt-loader" style="display:none;" aria-hidden="true">
    <div class="vm-dmt-loader__panel" role="status" aria-live="polite" aria-label="Processing">
        <div class="vm-dmt-table-loader__spinner" aria-hidden="true"></div>
        <span class="vm-dmt-loader__text">Please wait…</span>
    </div>
</div>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-retailer-rental-report-page">
    <div class="container-fluid vm-opr-page-shell">

        @{
            var rentalFormAttrs = new Dictionary<string, object>
            {
                { "id", "retailerRentalReportForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-report-date-form", "" },
                { "data-report-from", "#retailer_rental_frm_date" },
                { "data-report-to", "#retailer_rental_to_date" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("Retailer_Microatm_rental_report", "Home", FormMethod.Post, rentalFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">
                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line">
                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>My Account</li>
                        <li>MicroATM Rental Report</li>
                    </ol>
                    <div class="vm-dmt-filter-search-group vm-radiant-toolbar-filters">
                        <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                            <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                            @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_rental_frm_date", placeholder = "From", title = "From date" })
                        </div>
                        <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                            <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                            @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_rental_to_date", placeholder = "To", title = "To date" })
                        </div>
                        <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search" title="Search">
                            <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                        </button>
                    </div>
                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="retailerRentalTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Rental totals (loaded rows)</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideRetailerRentalTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Charge</span>
                            <strong class="vm-opr-total-card__value" id="retailerRentalCharge">&#8377; 0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">GST</span>
                            <strong class="vm-opr-total-card__value" id="retailerRentalGst">&#8377; 0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">TDS</span>
                            <strong class="vm-opr-total-card__value" id="retailerRentalTds">&#8377; 0.00</strong>
                        </div>
                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-cash-register" aria-hidden="true"></i>
                        <span>MicroATM rental report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn" onclick="FindtotalRetailerRental()" title="Show totals" aria-expanded="false" aria-controls="retailerRentalTotalsPanel"><i class="fas fa-chart-pie" aria-hidden="true"></i></button>
                            <button type="button" id="btnRetailerRentalExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel"><i class="fas fa-file-excel" aria-hidden="true"></i> Excel</button>
                            <button type="button" id="btnRetailerRentalPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF"><i class="fas fa-file-pdf" aria-hidden="true"></i> PDF</button>
                        </div>
                    </div>
                </div>
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="mmm" class="table vm-opr-data-table" cellspacing="0" style="width:100%;">
                            <thead>
                                <tr>
                                    <th>S.R.</th>
                                    <th>Firm Name</th>
                                    <th>Device ID</th>
                                    <th>Plan Name</th>
                                    <th>Num. of Trans</th>
                                    <th>Trans Date</th>
                                    <th>Curr Date</th>
                                    <th>@favimage Pre &#8377;</th>
                                    <th>@favimage Charge &#8377;</th>
                                    <th>@favimage GST &#8377;</th>
                                    <th>@favimage TDS &#8377;</th>
                                    <th>@favimage Post &#8377;</th>
                                </tr>
                            </thead>
                            <tbody id="retailerRentalRows">
                                @if (Model != null && Model.Count() > 0)
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr class="vm-dmt-row" data-charge="@item.remcomm" data-gst="@item.remgst" data-tds="@item.remtds">
                                            <td class="vm-dmt-sr-cell">@i</td>
                                            <td>@item.Frm_Name</td>
                                            <td>@item.deviceid</td>
                                            <td>@item.planname</td>
                                            <td>@item.nooftrans</td>
                                            <td>@item.transdate</td>
                                            <td>@item.currdate</td>
                                            <td class="vm-dmt-amt-cell">@item.rempre</td>
                                            <td class="vm-dmt-amt-cell">@item.remcomm</td>
                                            <td class="vm-dmt-amt-cell">@item.remgst</td>
                                            <td class="vm-dmt-amt-cell">@item.remtds</td>
                                            <td class="vm-dmt-amt-cell">@item.rempost</td>
                                        </tr>
                                        i++;
                                    }
                                }
                                else
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="12" class="vm-opr-table-empty vm-dmt-table-empty">
                                            <div class="vm-opr-empty-state">
                                                <i class="fas fa-inbox" aria-hidden="true"></i>
                                                <h3>Data not found</h3>
                                                <p>Try a different date range.</p>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section PostVmScripts {
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    function retailerRentalFilters() {
        return {
            txt_frm_date: jQuery('#retailer_rental_frm_date').val() || '',
            txt_to_date: jQuery('#retailer_rental_to_date').val() || ''
        };
    }

    function hideRetailerRentalTotals() {
        var $panel = jQuery('#retailerRentalTotalsPanel');
        var $btn = jQuery('.vm-dmt-totals-btn');
        $panel.removeClass('is-open').hide().attr('aria-hidden', 'true');
        $btn.removeClass('is-active').attr({ title: 'Show totals', 'aria-expanded': 'false' });
    }

    function calcRetailerRentalTotals() {
        var charge = 0, gst = 0, tds = 0;
        jQuery('#retailerRentalRows tr.vm-dmt-row').each(function () {
            charge += parseFloat(jQuery(this).attr('data-charge')) || 0;
            gst += parseFloat(jQuery(this).attr('data-gst')) || 0;
            tds += parseFloat(jQuery(this).attr('data-tds')) || 0;
        });
        jQuery('#retailerRentalCharge').html('&#8377; ' + charge.toFixed(2));
        jQuery('#retailerRentalGst').html('&#8377; ' + gst.toFixed(2));
        jQuery('#retailerRentalTds').html('&#8377; ' + tds.toFixed(2));
    }

    function FindtotalRetailerRental() {
        var $panel = jQuery('#retailerRentalTotalsPanel');
        var $btn = jQuery('.vm-dmt-totals-btn');
        if ($panel.hasClass('is-open')) {
            hideRetailerRentalTotals();
            return;
        }
        $panel.addClass('is-open').show().attr('aria-hidden', 'false');
        $btn.addClass('is-active').attr({ title: 'Hide totals', 'aria-expanded': 'true' });
        calcRetailerRentalTotals();
    }

    function retailerRentalTableHtml() {
        return jQuery('#mmm').prop('outerHTML');
    }

    function initRetailerRentalDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initRetailerRentalDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm(
                '#retailerRentalReportForm',
                '#retailer_rental_frm_date',
                '#retailer_rental_to_date',
                true
            );
        }
    }

    jQuery(function () {
        initRetailerRentalDatepickers();
        window.setTimeout(initRetailerRentalDatepickers, 150);

        jQuery('#btnRetailerRentalExport').on('click', function () {
            if (jQuery('#retailerRentalRows tr.vm-dmt-row').length === 0) {
                alert('Export ke liye koi data nahi hai. Pehle aisi date select karo jisme records hon.');
                return;
            }
            var f = retailerRentalFilters();
            var excelHtml = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40">'
                + '<head><meta charset="UTF-8"></head><body>'
                + '<h3>MicroATM Rental Report (' + f.txt_frm_date + ' to ' + f.txt_to_date + ')</h3>'
                + retailerRentalTableHtml() + '</body></html>';
            var blob = new Blob(['\ufeff' + excelHtml], { type: 'application/vnd.ms-excel' });
            var a = document.createElement('a');
            a.href = URL.createObjectURL(blob);
            a.download = 'MicroATM_Rental_Report_' + f.txt_frm_date + '_to_' + f.txt_to_date + '.xls';
            document.body.appendChild(a);
            a.click();
            window.setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 500);
        });
        jQuery('#btnRetailerRentalPDF').on('click', function () {
            if (jQuery('#retailerRentalRows tr.vm-dmt-row').length === 0) {
                alert('PDF ke liye koi data nahi hai. Pehle aisi date select karo jisme records hon.');
                return;
            }
            var f = retailerRentalFilters();
            var w = window.open('', '_blank');
            if (!w) {
                alert('Popup block ho gaya hai. Browser me popup allow karo phir PDF dabao.');
                return;
            }
            w.document.write('<html><head><title>MicroATM Rental Report</title>'
                + '<style>body{font-family:Arial,sans-serif;}h3{text-align:center;}'
                + 'table{border-collapse:collapse;width:100%;font-size:11px;}'
                + 'td,th{border:1px solid #000;padding:4px 6px;text-align:left;}'
                + 'thead tr{background:#eee;}</style>'
                + '</head><body>'
                + '<h3>MicroATM Rental Report (' + f.txt_frm_date + ' to ' + f.txt_to_date + ')</h3>'
                + retailerRentalTableHtml()
                + '<script>window.onload=function(){window.print();}<\/script>'
                + '</body></html>');
            w.document.close();
            w.focus();
        });
    });
</script>
}
