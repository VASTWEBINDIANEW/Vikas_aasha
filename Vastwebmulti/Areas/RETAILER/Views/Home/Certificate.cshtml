@{
    ViewBag.Title = "Certificate";
    Layout = null;
}
<link href="~/MainFrontDesign/css/globalallcss.css" rel="stylesheet" />


<style>
    * {
        box-sizing: border-box;
    }

    body {
        background: linear-gradient(160deg, #eef2f7 0%, #e2e8f0 100%) !important;
        font-family: 'Segoe UI', Roboto, Arial, sans-serif;
    }

    /* Download button : screen only, never in PDF/print */
    .vm-cert-toolbar {
        max-width: 842px;
        margin: 18px auto 14px auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }
    .vm-cert-toolbar .vm-cert-tool-title {
        font-size: 13px;
        font-weight: 800;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: #64748b;
    }
    #download {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        height: 40px;
        padding: 0 22px;
        border: none;
        border-radius: 10px;
        background: linear-gradient(135deg, #1e40af, #2563eb);
        color: #fff;
        font-size: 14px;
        font-weight: 800;
        cursor: pointer;
        box-shadow: 0 6px 18px rgba(37,99,235,.35);
        transition: all .15s ease;
    }
    #download:hover {
        transform: translateY(-1px);
        box-shadow: 0 10px 24px rgba(37,99,235,.45);
    }

    .full-body {
        width: 100%;
        position: relative;
    }

    /* Certificate card : gold double frame */
    #invoice {
        max-width: 842px;
        margin: 0 auto 30px auto;
        background: #fff;
        border: 3px solid #c9a227;
        outline: 1px solid #e7d08a;
        outline-offset: 5px;
        box-shadow: 0 18px 50px rgba(15,23,42,.18);
        overflow: hidden;
    }

    .full-body-21 {
        height: 8px;
        background: linear-gradient(90deg, #0f172a 0%, #1e40af 50%, #0f172a 100%);
    }

    .headers {
        width: 100%;
        text-align: center;
        padding: 18px 26px 12px 26px;
        display: flex;
        align-items: center;
        background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);
    }

    .logo {
        width: 22%;
        text-align: left;
    }
    .logo .img-responsive {
        width: 116px !important;
        height: 49px;
        object-fit: contain;
    }

    .headig-2 {
        width: 78%;
    }
    .headig-2 .headig h1 {
        font-size: 15px;
        text-transform: uppercase;
        text-align: center;
        line-height: 1.6;
        color: #0f172a;
        font-weight: 700;
        font-family: Georgia, 'Times New Roman', serif;
        letter-spacing: .04em;
        margin: 0;
    }
    .headig.headig-1 {
        display: none;
    }

    /* Title band */
    .holder {
        width: 100%;
        float: left;
        background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 60%, #2563eb 100%);
        margin: 2px 0px;
        border-top: 2px solid #c9a227;
        border-bottom: 2px solid #c9a227;
    }
    .holder p {
        font-size: 32px;
        text-transform: uppercase;
        color: #f5e6b8;
        text-align: center;
        font-weight: bold;
        letter-spacing: 3px;
        line-height: 1.3;
        font-family: Georgia, 'Times New Roman', serif;
        margin: 12px;
        text-shadow: 1px 1px 2px rgba(0,0,0,.5);
    }

    .prove {
        width: 100%;
        display: flex;
        align-items: center;
        padding: 10px 26px 0 26px;
    }
    .prov {
        width: 55%;
        text-align: center;
    }
    .prov h2 {
        text-transform: uppercase;
        font-weight: inherit;
        color: #0f172a;
        font-size: 20px;
        font-family: Georgia, 'Times New Roman', serif;
        margin: 0;
    }
    .prov-1 {
        width: 45%;
        float: left;
    }

    .borders {
        border-bottom: 3px double #c9a227 !important;
        margin: 10px 26px 6px 26px;
        text-align: center;
    }

    /* Photo + details */
    .user {
        width: 100%;
        display: flex;
        align-items: center;
        padding: 8px 26px;
    }
    .user-id {
        width: 72%;
    }
    .on-duty {
        width: 28%;
        padding: 10px 14px 10px 0;
    }
    .on-duty-1 {
        max-width: 164px;
        max-height: 204px;
        border: 3px solid #c9a227 !important;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 8px 20px rgba(15,23,42,.18);
        background: #f1f5f9;
    }
    .on-duty-1 img {
        width: 100%;
        height: auto;
        display: block;
    }

    .table2 {
        width: 100%;
        float: right;
        font-family: 'Segoe UI', Roboto, Arial, sans-serif;
        color: black;
        border-collapse: collapse;
    }
    .table2 tr {
        border-bottom: 1px dashed #e2e8f0;
    }
    .table2 tr:last-child {
        border-bottom: none;
    }
    .table2 td {
        padding: 9px 4px;
        font-size: 14.5px;
        text-transform: uppercase;
    }
    .table2 td:first-child {
        color: #64748b;
        font-weight: 700;
        letter-spacing: .03em;
        white-space: nowrap;
    }
    .table2 td:last-child {
        text-align: right;
        color: #0f172a;
        font-weight: 800;
    }

    .more {
        width: 100%;
        text-align: center;
        padding: 2px 26px 8px 26px;
    }
    .more p {
        font-size: 13.5px;
        font-family: 'Segoe UI', Roboto, Arial, sans-serif;
        padding: 2px 6px;
        color: #334155;
        text-align: justify;
        line-height: 1.6;
    }

    /* Signature / QR / seal */
    .sales {
        width: 100%;
        float: left;
        background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 100%);
        display: flex;
        align-items: center;
        padding: 20px 26px;
    }
    .sale {
        width: 35%;
    }
    .backs-1 {
        width: 65%;
        display: flex;
        align-items: center;
    }
    .sale-1 {
        width: 50%;
        text-align: center;
    }
    .sale-2 {
        text-align: center;
        float: left;
        margin-left: 40px;
    }
    .sale-2 p {
        font-family: 'Segoe UI', Roboto, Arial, sans-serif;
        color: #f5e6b8;
        line-height: 1.5;
        font-size: 12.5px;
        margin: 2px 0;
    }
    .signature {
        width: 120px;
        height: 40px;
        object-fit: contain;
        background: #fff;
        border-radius: 6px;
        padding: 2px 6px;
    }
    .sale-3 {
        width: 50%;
        text-align: center;
    }

    /* ON DUTY seal */
    .weave::before, .weave::after {
        display: block;
        width: 65px;
        height: 65px;
        border: 2px solid #c9a227;
        border-radius: 50px;
        content: "";
        position: absolute;
        top: -2px;
        left: -2px;
    }
    .weave::before {
        transform: rotate(30deg);
    }
    .weave::after {
        transform: rotate(60deg);
    }
    .weave {
        display: block;
        width: 69px;
        height: 69px;
        border: 2px solid #c9a227;
        border-radius: 50px;
        margin: 10px 10px !important;
        position: relative;
        text-align: center;
        font: 700 22px/120px "Quicksand", sans-serif;
        background: #fff;
    }
    .weave p {
        line-height: 1.2;
        padding: 10px;
        color: #9a3412;
        font-size: 15px;
    }
    .curved-text {
        position: relative;
        display: inline-block;
        margin: 0 auto;
    }
    .curved-text-out {
        float: left;
        min-width: 0px !important;
        text-align: center;
        margin-left: -2px;
    }
    .curved-text span {
        min-width: 0.5em;
        text-align: center;
        padding: 0;
        margin: 0;
        font-size: 9px;
        color: #f5e6b8;
        margin-left: -7px;
        margin-top: 1px;
    }
    .sale-4 {
        width: 101px;
        height: 101px;
        border: 6px double #c9a227;
        border-radius: 50%;
        text-align: center;
        margin-right: 40px;
        background: rgba(255,255,255,.06);
        float: right;
    }

    /* Notes strip */
    .nots {
        width: 100%;
        float: left;
        background: #0f172a;
        padding: 8px 26px;
        line-height: 1.5;
    }
    .nots ul {
        margin: 4px 0;
        padding-left: 20px;
    }
    .nots li {
        color: #cbd5e1;
        font-family: 'Segoe UI', Roboto, Arial, sans-serif;
        font-size: 12.5px;
        line-height: 1.8;
    }
    .nots li::marker {
        color: #c9a227;
    }

    .error-1 h2 {
        background: #fef2f2;
        padding: 18px;
        text-transform: uppercase;
        color: #dc2626;
        text-align: center;
        font-family: 'Segoe UI', Roboto, Arial, sans-serif;
        border: 2px solid #fecaca;
        border-radius: 12px;
    }

    @@media print {
        body {
            background: #fff !important;
        }
        .vm-cert-toolbar {
            display: none !important;
        }
        #invoice {
            box-shadow: none;
            margin: 0 auto;
        }
    }
</style>

<section id="drag" class="content" style="margin-top: 18px;">
    <div class="container-fluid retailer-page fundtranfer">
        <div class="body rwertfdaaa">
            @if (ViewBag.sts == true)
            {
                <div class="vm-cert-toolbar">
                    <span class="vm-cert-tool-title">Certificate of Association</span>
                    <button id="download">&#8681; Download / Print PDF</button>
                </div>

                <div id="invoice" class="full-body">
                    <div class="full-body-21"></div>

                    <header>
                        <div class="headers">
                            <div class="logo">
                                @if (ViewBag.logo == "")
                                {
                                    <img src="/img/Default_Logo.png" class="img-responsive">
                                }
                                else
                                {
                                    <img src="@Url.Content("~/" + ViewBag.logo)" class="img-responsive">
                                }
                            </div>

                            <div class="headig headig-1">
                                <h1>Essential service provider to the country<br>(Banking, AEPS & ATM services)</h1>
                            </div>

                            <div class="headig-2">
                                <div class="headig">
                                    <h1>Essential service provider to the country<br>(Banking, AEPS & ATM services)</h1>
                                </div>
                            </div>
                        </div>
                    </header>

                    <div class="holder">
                        <p>CERTIFICATE OF ASSOCIATION</p>
                    </div>
                    <div class="prove">
                        <div class="prov">
                            <h2><b>Authorised business correspondent</b></h2>
                        </div>
                        <div class="prov-1">
                            <div style="width: 96.50%;text-align: center;">
                                <img src="../../certificate/logo-3.png" alt="Kotak Bank" style="width: 38%;">
                                <img src="../../certificate/cub-logo-new-size.jpg" alt="CU Bank" style="float: right;width: 157px;">
                            </div>
                        </div>
                    </div>
                    <div class="borders"></div>
                    <div class="user">
                        <div class="on-duty">
                            <div class="on-duty-1">
                                <img src="@ViewBag.photo" alt="Photo">
                            </div>
                        </div>
                        <div class="user-id">
                            <table class="table2">
                                <tr>
                                    <td><b>AGENT NAME:</b></td>
                                    <td>@ViewBag.name</td>
                                </tr>
                                <tr>
                                    <td><b>AGENT FIRM:</b></td>
                                    <td>@ViewBag.firmname</td>
                                </tr>
                                <tr>
                                    <td><b>REGISTERED MOBILE:</b></td>
                                    <td>@ViewBag.mobile</td>
                                </tr>
                                <tr>
                                    <td><b>JOINING DATE:</b></td>
                                    <td>@ViewBag.joindate</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                    <div class="more">
                        <p>
                            The above is hereby authorized as a Banking Channel Partner to provide banking and other financial services provided by the Company from the date of issue to the validity of the Retail Agreement.
                            For more information on terms and conditions, please visit our website.
                        </p>
                    </div>
                    <div class="sales">
                        <div class="sale">
                            <div class="sale-2">
                                <img src="~/@ViewBag.signature" class="signature" />
                                <p>@ViewBag.name</p>
                                <p>Authorities Signature</p>
                            </div>
                        </div>
                        <div class="backs-1">
                            <div class="sale-1">
                                <img src="@ViewBag.qr" alt="QR" style="width: 94px;height: 94px;border: 2px solid #c9a227;border-radius: 8px;background: #fff;padding: 3px;">
                            </div>
                            <div class="sale-3">
                                <div class="sale-4">
                                    <div class="curved-text curved-text-out">Essential Services Available Here&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;*&nbsp;&nbsp;*&nbsp;&nbsp;*&nbsp;&nbsp;&nbsp;</div>
                                    <div class="weave">
                                        <p style="font-size: 15px;line-height: 1.1;padding: 0px;">ON<br>DUTY</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="nots">
                        <ul>
                            <li>This Certificate must be produced as per demand.</li>
                            <li>This is a system generated certificate.</li>
                            <li>Holders of this certificate will be acciuntable for ant misuse, loss and damage caused.</li>
                        </ul>
                    </div>
                </div>
            }
            else
            {
                <div class="full-body error-1" style="max-width: 842px; margin: auto;">
                    <h2>@ViewBag.message</h2>
                </div>
            }
        </div>
    </div>
</section>

<!-- Jquery Core Js -->
<script src="~/AdminDesign/plugins/jquery/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.9.2/html2pdf.bundle.js"></script>

<script>
    window.onload = function () {
        document.getElementById("download")
            .addEventListener("click", () => {
                const invoice = this.document.getElementById("invoice");
                console.log(invoice);
                console.log(window);
                var opt = {
                    margin: 0,
                    filename: 'Certificate.pdf',
                    image: { type: 'jpeg', quality: 0.98 },
                    html2canvas: { scale: 2 },
                    jsPDF: { unit: 'in', format: 'letter', orientation: 'portrait' }
                };
                html2pdf().from(invoice).set(opt).save();
            })
    }
</script>

<script>
    function updateCurvedText($curvedText, radius) {
        $curvedText.css("min-width", "initial");
        $curvedText.css("min-height", "initial");
        var w = $curvedText.width(),
            h = $curvedText.height();
        $curvedText.css("min-width", w + "px");
        $curvedText.css("min-height", h + "px");
        var text = $curvedText.text();
        var html = "";

        Array.from(text).forEach(function (letter) {
            html += `<span>${letter}</span>`;
        });
        $curvedText.html(html);

        var $letters = $curvedText.find("span");
        $letters.css({
            position: "absolute",
            height: `${radius}px`,
            transformOrigin: "bottom center"
        });

        var circleLength = 2 * Math.PI * radius;
        var angleRad = w / (2 * radius);
        var angle = 2 * angleRad * 360 / Math.PI / text.length;
        var d = 2.2;
        $letters.each(function (idx, el) {
            d = d + (4.6 - 1.3) / 44;
            $(el).css({
                transform: `translate(${w / 2}px,0px) rotate(${idx * angle - text.length * angle / d}deg)`
            })
        });
    }

    var $curvedText = $(".curved-text");
    updateCurvedText($curvedText, 44);

    function settingsChanged() {
        $curvedText.text($(".text").val());
        updateCurvedText($curvedText, $(".radius").val());
    }

    $(".radius").on("input change", settingsChanged);
    $(".text").on("input change", settingsChanged);
</script>
