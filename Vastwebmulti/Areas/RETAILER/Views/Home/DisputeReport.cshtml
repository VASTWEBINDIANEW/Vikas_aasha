<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-retailer-income-page saas-retailer-dispute-page">
    <div class="container-fluid vm-opr-page-shell">
        @using (Html.BeginForm("DisputeReport", "Home", FormMethod.Post, new Dictionary<string, object>
        {
            { "id", "disputeReportForm" },
            { "class", "vm-rpt-filters-panel__form" },
            { "data-report-date-form", "" },
            { "data-report-from", "#txt_frm_date" },
            { "data-report-to", "#txt_to_date" },
            { "data-date-mode", dispDateMode },
            { "data-frm-date", dispFrmDate },
            { "data-to-date", dispToDate }
        }))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">
                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line">
                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home", new { area = "RETAILER" })"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>My Account</li>
                        <li>Dispute List</li>
                    </ol>
                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters vm-ecomm-filter-row--one-line">
                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field">
                                <input type="text" placeholder="Enter Dispute Number" class="form-control saas-acc-dp-input" />
                            </div>
                            <div class="input-daterange saas-acc-dp-range-group">
                                <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                    <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                    @Html.TextBox("txt_frm_date", dispFrmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", placeholder = "From", title = "From date" })
                                </div>
                                <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                    <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                    @Html.TextBox("txt_to_date", dispToDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", placeholder = "To", title = "To date" })
                                </div>
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>
                    </div>
                </div>
                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="disputeTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Dispute totals (amount)</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideDisputeTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Success</span>
                            <strong class="vm-opr-total-card__value" id="disputeTotalSuccess">&#8377; 0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Failed</span>
                            <strong class="vm-opr-total-card__value" id="disputeTotalFailed">&#8377; 0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Pending</span>
                            <strong class="vm-opr-total-card__value" id="disputeTotalPending">&#8377; 0.00</strong>
                        </div>
                    </div>
                </div>
            </div>
        }
        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
                        <span>Dispute List</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong>@disputeCount</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-ecomm-totals-btn" onclick="showDisputeTotals()" title="Show totals" aria-expanded="false" aria-controls="disputeTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="disputeReportTable" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                        <tr>
                                            <th>Sr</th>
                                            <th>Status&nbsp;&&nbsp;Description</th>
                                            <th>Number</th>
                                            <th>Operator&nbsp;Name</th>
                                            <th>₹&nbsp;Amount</th>
                                            <th>Transition&nbsp;Date</th>
                                            <th>Dispute&nbsp;Reason</th>
                                            <th>Response</th>
                                            <th>Dispute&nbsp;Date</th>
                                            <th>Status</th>

                                        </tr>
                                    </thead>
                                    <tbody id="disputeReportRows">
                                        @if (disputeRows.Count > 0)
                                        {

                                            int i = 1;
                                            foreach (var item in disputeRows)
                                            {
                                                var sts = "";
                                                var pendingColor = "";
                                                var pillCls = "vm-dsp-pill--ok";
                                                var tone = "success";
                                                var fa = "fa-check";
                                                var tStatus = "SUCCESS";
                                                if (item.sts.Contains("Pending"))
                                                {
                                                    sts = "Request Pending";
                                                    pendingColor = "#fff8d1";
                                                    pillCls = "vm-dsp-pill--wait";
                                                    tone = "pending";
                                                    fa = "fa-clock-o";
                                                    tStatus = "PENDING";
                                                }
                                                if (item.sts.Contains("Rejected"))
                                                {
                                                    sts = "Request Rejected (Transition Confirm Successful)";
                                                    pillCls = "vm-dsp-pill--bad";
                                                    tone = "failed";
                                                    fa = "fa-times";
                                                    tStatus = "PENDING";
                                                }
                                                if (item.sts.Contains("Success"))
                                                {
                                                    sts = "Success";
                                                }
                                                if (item.sts.Contains("Failed"))
                                                {
                                                    sts = "Failed";
                                                    tone = "failed";
                                                    fa = "fa-times";
                                                    tStatus = "FAILED";
                                                }
                                                if (item.sts.Contains("Approved"))
                                                {
                                                    sts = "Request Approved (Transition Refund Successfully)";
                                                    tone = "success";
                                                    fa = "fa-check";
                                                    tStatus = "SUCCESS";
                                                }
                                                <tr class="vm-dmt-row" data-amount="@item.rch_amount" data-status="@tStatus" style="background-color:@pendingColor">
                                                    <td>@i</td>
                                                    <td><span class="vm-dmt-status vm-dmt-status--@tone" title="@sts"><i class="fa @fa" aria-hidden="true"></i></span> <span class="vm-dsp-pill @pillCls">@sts</span></td>
                                                    <td>@Html.DisplayFor(modelItem => item.rch_number)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.operator_Name)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.rch_amount)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.rch_time)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.dispute_region)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.comment)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.dis_time)</td>
                                                    <td>@Html.DisplayFor(modelItem => item.sts)</td>

                                                </tr>
                                                i++;
                                            }
                                        }
                                        else
                                        {
                                            <tr class="vm-opr-table-empty-row">
                                                <td colspan="10" class="vm-opr-table-empty vm-dmt-table-empty">
                                                    <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
                                                    <span>No dispute records found.</span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
</section>

