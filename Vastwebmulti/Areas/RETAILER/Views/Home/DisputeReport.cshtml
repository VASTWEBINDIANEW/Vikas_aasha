<script>
    function isNumber(evt) {
        var iKeyCode = (evt.which) ? evt.which : evt.keyCode
        if (iKeyCode != 45 && iKeyCode > 31 && (iKeyCode < 48 || iKeyCode > 57))
            return false;
        return true;
    }
</script>
<!--Calendar Javascript-->
<script>
    function hideDisputeTotals() {
        var $panel = jQuery('#disputeTotalsPanel');
        var $btn = jQuery('.saas-retailer-dispute-page .vm-ecomm-totals-btn');
        $panel.hide().attr('aria-hidden', 'true');
        $btn.attr('aria-expanded', 'false');
    }

    function showDisputeTotals() {
        var $panel = jQuery('#disputeTotalsPanel');
        var $btn = jQuery('.saas-retailer-dispute-page .vm-ecomm-totals-btn');
        if ($panel.is(':visible')) {
            hideDisputeTotals();
            return;
        }
        var success = 0, failed = 0, pending = 0;
        jQuery('#disputeReportRows tr.vm-dmt-row').each(function () {
            var amt = parseFloat(jQuery(this).attr('data-amount')) || 0;
            var st = (jQuery(this).attr('data-status') || '').toUpperCase();
            if (st === 'SUCCESS') { success += amt; }
            else if (st === 'FAILED') { failed += amt; }
            else { pending += amt; }
        });
        jQuery('#disputeTotalSuccess').html('&#8377; ' + success.toFixed(2));
        jQuery('#disputeTotalFailed').html('&#8377; ' + failed.toFixed(2));
        jQuery('#disputeTotalPending').html('&#8377; ' + pending.toFixed(2));
        $panel.show().attr('aria-hidden', 'false');
        $btn.attr('aria-expanded', 'true');
    }

    function initDisputeDatepickers() {
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm(
                '#disputeReportForm',
                '#txt_frm_date',
                '#txt_to_date',
                true
            );
            return;
        }
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initDisputeDatepickers, 50);
            return;
        }
        jQuery('.input-daterange').datepicker({
            format: "yyyy-mm-dd",
            todayHighlight: true,
            autoclose: true,
            orientation: "bottom auto"
        });
    }

    $(document).ready(function()
    {
        initDisputeDatepickers();
        window.setTimeout(initDisputeDatepickers, 150);
    })
</script>

