@model IEnumerable<Vastwebmulti.Models.show_dispute_list_Result>
@using System.Linq
@{
    ViewBag.Title = "DisputeReport";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";

    var disputeRows = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.show_dispute_list_Result>();
    var disputeCount = disputeRows.Count;

    var dispFrmDate = (Request["txt_frm_date"] ?? "").Trim();
    var dispToDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(dispFrmDate)) { dispFrmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(dispToDate)) { dispToDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    var dispDateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
}
