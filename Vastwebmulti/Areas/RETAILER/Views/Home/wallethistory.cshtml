@section PostVmScripts {
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
<script>
    function retailerWalletRefreshCount() {
        var n = jQuery('#tblshowMasterD #tblbody tr.tr').length;
        jQuery('#retailerWalletCount').text(n);
    }

    function retailerWalletAjaxDone() {
        retailerWalletDecorate();
        retailerWalletRefreshCount();
        myFunction();
    }

    // Latest-look touches on the shared-partial table (no partial change)
    function retailerWalletDecorate() {
        var $tbl = jQuery('#tblshowMasterD table');
        $tbl.addClass('vm-opr-data-table');
        jQuery('#tblshowMasterD #tblbody tr.tr').each(function () {
            var $tr = jQuery(this);
            // Charge-back rows keep their soft red tint
            var st = ($tr.attr('style') || '').replace(/\s/g, '').toLowerCase();
            if (st.indexOf('ff0000') !== -1) {
                $tr.addClass('vm-wallet-chargeback');
            }
            // Detail icon: tooltip for latest feel
            jQuery('#tblshowMasterD img[data-toggle="modal"]').each(function () {
                jQuery(this).attr('title', 'View fund details');
                jQuery(this).attr('alt', 'View details');
            });
            // Action cell: wrap date text so icon never overlaps it
            jQuery('#tblshowMasterD #tblbody tr.tr').each(function () {
                var $tr = jQuery(this);
                var $last = $tr.children('td').last();
                if ($last.length && !$last.attr('data-action-done')) {
                    $last.attr('data-action-done', '1');
                    $last.addClass('vm-txn-action-cell');
                    var $img = $last.find('img[data-toggle="modal"]');
                    $last.contents().filter(function () {
                        return this.nodeType === 3 && jQuery.trim(this.nodeValue) !== '';
                    }).wrap('<span class="vm-txn-time"></span>');
                    $last.find('.vm-txn-time').css({ 'color': '#0f172a', 'font-weight': '600' });
                    if ($img.length) {
                        $last.find('.vm-txn-time').first().after($img);
                    }
                    $last.wrapInner('<span class="vm-txn-action-wrap"></span>');
                    // Inline (unbeatable): single-line date + time chip with icon at right
                    $last.css({ 'white-space': 'nowrap', 'overflow': 'visible' });
                    $last.find('.vm-txn-action-wrap').css({ 'display': 'flex', 'align-items': 'center', 'gap': '6px', 'white-space': 'nowrap' });
                    $last.find('.vm-txn-time').each(function () {
                        var $t = jQuery(this);
                        if ($t.attr('data-chip-done')) { return; }
                        $t.attr('data-chip-done', '1');
                        var parts = jQuery.trim($t.text()).split(/\s+/);
                        if (parts.length >= 2) {
                            $t.empty().append(
                                jQuery('<span class="vm-txn-date"></span>').text(parts[0]),
                                ' ',
                                jQuery('<span class="vm-txn-clock"></span>').text(parts.slice(1).join(' '))
                            );
                        }
                        $t.css({ 'display': 'inline-flex', 'align-items': 'center', 'gap': '6px', 'white-space': 'nowrap', 'background': '#eff6ff', 'border': '1px solid #dbeafe', 'border-radius': '8px', 'padding': '4px 8px' });
                        $t.find('.vm-txn-date').css({ 'display': 'inline', 'color': '#0f172a', 'font-weight': '700', 'font-size': '12.5px', 'line-height': '1.3' });
                        $t.find('.vm-txn-clock').css({ 'display': 'inline', 'color': '#1a56db', 'font-weight': '600', 'font-size': '11.5px', 'line-height': '1.3' });
                    });
                    $last.find('img[data-toggle="modal"]').css({
                        'display': 'inline-block', 'width': '30px', 'height': '30px',
                        'padding': '7px', 'border': 'none', 'border-radius': '50%',
                        'background': 'linear-gradient(135deg, #1a56db 0%, #3b82f6 100%)',
                        'float': 'none', 'margin': '0', 'cursor': 'pointer'
                    });
                }
            });
            // Pay-from pill badges (once only)
            var $first = $tr.children('td').first();
            if ($first.length && !$first.attr('data-pill-done')) {
                $first.attr('data-pill-done', '1');
                var txt = jQuery.trim($first.text());
                var cls = 'vm-role-other';
                if (/^admin$/i.test(txt)) { cls = 'vm-role-admin'; }
                else if (/retailer/i.test(txt)) { cls = 'vm-role-retailer'; }
                $first.addClass(cls);
                $first.wrapInner('<span class="vm-role-pill"></span>');
            }
        });
    }

    function initRetailerWalletSelect2() {
        var $scope = jQuery('.saas-retailer-wallethistory-page');
        $scope.find('#ddtrnsfrom').each(function () {
            var $el = jQuery(this);
            if (!$el.length || !jQuery.fn.select2) {
                return;
            }
            if ($el.hasClass('select2-hidden-accessible')) {
                try { $el.select2('destroy'); } catch (e) { }
            }
            var opts = {
                width: '100%',
                dropdownParent: jQuery(document.body),
                minimumResultsForSearch: 0,
                dropdownCssClass: 'vm-admin-select2-dropdown vm-admin-select2-searchable'
            };
            if (typeof window.forceAdminSelect2 === 'function') {
                window.forceAdminSelect2($el, opts, true);
            } else if (typeof window.applyAdminSelect2 === 'function') {
                window.applyAdminSelect2($el, opts, true);
            } else {
                $el.select2(opts);
            }
        });
    }

    function initRetailerWalletDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initRetailerWalletDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm(
                '#retailerWalletForm',
                '#retailer_wallet_frm_date',
                '#retailer_wallet_to_date',
                true
            );
        }
    }

    jQuery(function () {
        initRetailerWalletSelect2();
        initRetailerWalletDatepickers();
        window.setTimeout(initRetailerWalletDatepickers, 150);
        retailerWalletRefreshCount();
        // Style the ajax-loaded table with the modern grid classes
        retailerWalletDecorate();
        jQuery('#btnExportRetailerWallet').on('click', function (e) {
            e.preventDefault();
            var url = '@Url.Action("ExportExcellFundtransfer", "Home")?tabtype=FundTranferAllReport&txt_frm_date=' + encodeURIComponent(jQuery('#retailer_wallet_frm_date').val() || '') + '&txt_to_date=' + encodeURIComponent(jQuery('#retailer_wallet_to_date').val() || '') + '&ddtrnsfrom=' + encodeURIComponent(jQuery('#ddtrnsfrom').val() || '');
            location.href = url;
        });
        jQuery('#btnPDFRetailerWallet').on('click', function () {
            window.print();
        });
        // Action cell (date/icon) click => fill (via row onclick bubble) then open fund popup, guaranteed.
        // Bound to last-child so it works even before/without decoration.
        jQuery(document).off('click.vmWalletIcon').on('click.vmWalletIcon', '#tblshowMasterD #tblbody tr.tr td:last-child', function () {
            window.setTimeout(function () {
                retailerFundModalTwoCol();
                jQuery('#m-d-fund-orderRecive').modal('show');
            }, 0);
        });
    });

    // Re-apply grid class whenever the ajax table refreshes
    jQuery(document).ajaxComplete(function () {
