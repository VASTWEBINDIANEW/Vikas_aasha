<script>
    // 2-column layout: CSS grid handles it — just clear any old inline floats
    function retailerFundModalTwoCol() {
        if (!window.jQuery) { return; }
        jQuery('#m-d-fund-orderRecive .vm-fund-modal-grid .form-group').each(function () {
            var el = this;
            el.style.float = '';
            el.style.clear = '';
            el.style.width = '';
            el.style.margin = '';
        });
        jQuery('#ALLdatashow .vm-fund-modal-grid, #retailerdatashowonly .vm-fund-modal-grid').css({ 'overflow': 'visible', 'width': '100%' });
    }

    // Ensure the fund-info popup hides cleanly (close btn / backdrop / Esc)
    jQuery(function () {
        var $fundModal = jQuery('#m-d-fund-orderRecive');
        $fundModal.modal({ show: false, backdrop: true, keyboard: true });
        retailerFundModalTwoCol();
        $fundModal.on('hidden.bs.modal', function () {
            jQuery('body').removeClass('modal-open');
            jQuery('.modal-backdrop').remove();
            $fundModal.hide();
        });
    });
</script>
