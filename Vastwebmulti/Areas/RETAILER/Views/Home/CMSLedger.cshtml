        body.saas-admin-ui .saas-retailer-cms-page #retailerCmsLedgerReport.vm-opr-data-table thead th:nth-child(3),
        body.saas-admin-ui .saas-retailer-cms-page #retailerCmsLedgerReport.vm-opr-data-table tbody td:nth-child(3) { width: 19% !important; }
        body.saas-admin-ui .saas-retailer-cms-page #retailerCmsLedgerReport.vm-opr-data-table thead th:nth-child(4),
        body.saas-admin-ui .saas-retailer-cms-page #retailerCmsLedgerReport.vm-opr-data-table tbody td:nth-child(4) { width: 9% !important; }
        body.saas-admin-ui .saas-retailer-cms-page #retailerCmsLedgerReport.vm-opr-data-table thead th:nth-child(5),
        body.saas-admin-ui .saas-retailer-cms-page #retailerCmsLedgerReport.vm-opr-data-table tbody td:nth-child(5) { width: 9% !important; }
        body.saas-admin-ui .saas-retailer-cms-page #retailerCmsLedgerReport.vm-opr-data-table thead th:nth-child(6),
        body.saas-admin-ui .saas-retailer-cms-page #retailerCmsLedgerReport.vm-opr-data-table tbody td:nth-child(6) { width: 9% !important; }
        body.saas-admin-ui .saas-retailer-cms-page #retailerCmsLedgerReport.vm-opr-data-table thead th:nth-child(7),
        body.saas-admin-ui .saas-retailer-cms-page #retailerCmsLedgerReport.vm-opr-data-table tbody td:nth-child(7) { width: 9% !important; }
        body.saas-admin-ui .saas-retailer-cms-page #retailerCmsLedgerReport.vm-opr-data-table thead th:nth-child(8),
        body.saas-admin-ui .saas-retailer-cms-page #retailerCmsLedgerReport.vm-opr-data-table tbody td:nth-child(8) { width: 9% !important; }
        body.saas-admin-ui .saas-retailer-cms-page #retailerCmsLedgerReport.vm-opr-data-table thead th:nth-child(9),
        body.saas-admin-ui .saas-retailer-cms-page #retailerCmsLedgerReport.vm-opr-data-table tbody td:nth-child(9) { width: 20% !important; }
    }
    /* Mobile + tablet (<=1023px): natural widths, full text, horizontal scroll */
    @@media (max-width: 1023.98px) {
        body.saas-admin-ui .saas-retailer-cms-page #retailerCmsLedgerReport.vm-opr-data-table {
            width: max-content !important;
            min-width: 1100px !important;
            max-width: none !important;
            table-layout: auto !important;
        }
        body.saas-admin-ui .saas-retailer-cms-page #retailerCmsLedgerReport.vm-opr-data-table thead tr,
        body.saas-admin-ui .saas-retailer-cms-page #retailerCmsLedgerReport.vm-opr-data-table tbody tr {
            display: table-row !important;
        }
        body.saas-admin-ui .saas-retailer-cms-page #retailerCmsLedgerReport.vm-opr-data-table thead th,
        body.saas-admin-ui .saas-retailer-cms-page #retailerCmsLedgerReport.vm-opr-data-table tbody td {
            display: table-cell !important;
            width: auto !important;
            min-width: 0 !important;
            max-width: none !important;
            white-space: nowrap !important;
            overflow: visible !important;
            text-overflow: clip !important;
        }
        body.saas-admin-ui .saas-retailer-cms-page .vm-opr-table-scroll {
            overflow-x: auto !important;
        }
    }
</style>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-retailer-ecomm-transaction-page saas-retailer-cms-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var cmsFormAttrs = new Dictionary<string, object>
            {
                { "id", "retailerCmsForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-report-date-form", "" },
                { "data-report-from", "#retailer_cms_frm_date" },
                { "data-report-to", "#retailer_cms_to_date" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("CMSLedger", "Home", FormMethod.Post, cmsFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home", new { area = "RETAILER" })"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li><a href="@Url.Action("RetailerLedger", "Home")">Retailer Ledger</a></li>
                        <li>CMS Ledger</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters vm-ecomm-filter-row--one-line">

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_cms_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_cms_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="retailerCmsTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>CMS totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideRetailerCmsTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Total credit</span>
                            <strong class="vm-opr-total-card__value">&#8377; @totalCredit.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Total debit</span>
                            <strong class="vm-opr-total-card__value">&#8377; @totalDebit.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Records</span>
                            <strong class="vm-opr-total-card__value">@rowCount</strong>
                        </div>
                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-university" aria-hidden="true"></i>
                        <span>CMS ledger</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong>@rowCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total" title="Total credit">
                            Cr: <strong>&#8377; @totalCredit.ToString("N2")</strong>
                        </span>
                        <span class="vm-radiant-inline-total" title="Total debit">
                            Dr: <strong>&#8377; @totalDebit.ToString("N2")</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <a class="vm-ledger-nav" href="@Url.Action("RetailerLedger", "Home")" title="Back to main ledger"><i class="fas fa-arrow-left" aria-hidden="true"></i> Main Ledger</a>
                            <a class="vm-ledger-nav" href="@Url.Action("PosLedger", "Home")" title="Pos Ledger"><i class="fas fa-credit-card" aria-hidden="true"></i> Pos Ledger</a>
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-ecomm-totals-btn" onclick="showRetailerCmsTotals()" title="Show totals" aria-expanded="false" aria-controls="retailerCmsTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnExportRetailerCms" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDFRetailerCms" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="retailerCmsLedgerReport" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Sr. No</th>
                                    <th>User Id</th>
                                    <th>Description</th>
                                    <th>Amount &#8377;</th>
                                    <th>Credit</th>
                                    <th>Debit</th>
                                    <th>Remain Pre</th>
                                    <th>Remain Post</th>
                                    <th>Date &amp; Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (reports.Count > 0)
                                {
                                    int idno = 1;
                                    foreach (var item in reports)
                                    {
                                        decimal cr = 0m, dr = 0m;
                                        try { cr = Convert.ToDecimal(item.Credit); } catch { }
                                        try { dr = Convert.ToDecimal(item.Debit); } catch { }
                                        var tone = cr > 0 ? "vm-ledger-row--credit" : (dr > 0 ? "vm-ledger-row--debit" : "");
                                        <tr class="vm-dmt-row vm-ledger-row @tone">
                                            <td><span class="vm-dmt-refno-text">@idno</span></td>
                                            <td><span class="vm-dmt-refno-text" title="@item.Frm_Name">@item.Frm_Name</span></td>
                                            <td><span class="vm-dmt-consumer-text" title="@item.Description">@item.Description</span></td>
                                            <td><span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @item.Amount</span></td>
                                            <td>
                                                @if (cr > 0)
                                                {
                                                    <span class="vm-ledger-cd vm-ledger-cd--cr"><i class="fa fa-arrow-up" aria-hidden="true"></i>@item.Credit</span>
                                                }
                                                else
                                                {
                                                    <span class="vm-dmt-amount-text">@item.Credit</span>
                                                }
                                            </td>
                                            <td>
                                                @if (dr > 0)
                                                {
                                                    <span class="vm-ledger-cd vm-ledger-cd--dr"><i class="fa fa-arrow-down" aria-hidden="true"></i>@item.Debit</span>
                                                }
                                                else
                                                {
                                                    <span class="vm-dmt-amount-text">@item.Debit</span>
                                                }
                                            </td>
                                            <td><span class="vm-dmt-amount-text">@item.RemainPre</span></td>
                                            <td><span class="vm-dmt-amount-text">@item.RemainPost</span></td>
                                            <td class="vm-ticket-time-cell"><span class="vm-dmt-refno-text">@item.Insertdate</span></td>
                                        </tr>
                                        idno++;
                                    }
                                }
                                else
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="9" class="vm-opr-table-empty vm-dmt-table-empty">
                                            <i class="fas fa-university" aria-hidden="true"></i>
                                            <span>No CMS ledger records found.</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section PostVmScripts {
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    function hideRetailerCmsTotals() {
        var $panel = jQuery('#retailerCmsTotalsPanel');
        var $btn = jQuery('.saas-retailer-cms-page .vm-ecomm-totals-btn');
        $panel.hide().attr('aria-hidden', 'true');
        $btn.attr('aria-expanded', 'false');
    }

    function showRetailerCmsTotals() {
        var $panel = jQuery('#retailerCmsTotalsPanel');
        var $btn = jQuery('.saas-retailer-cms-page .vm-ecomm-totals-btn');
        if ($panel.is(':visible')) {
            hideRetailerCmsTotals();
            return;
        }
        $panel.show().attr('aria-hidden', 'false');
        $btn.attr('aria-expanded', 'true');
    }

    function retailerCmsDates() {
        return {
            txt_frm_date: jQuery('#retailer_cms_frm_date').val() || '',
            txt_to_date: jQuery('#retailer_cms_to_date').val() || ''
        };
    }

    function initRetailerCmsDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initRetailerCmsDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm(
                '#retailerCmsForm',
                '#retailer_cms_frm_date',
                '#retailer_cms_to_date',
                true
            );
        }
    }

    jQuery(function () {
        initRetailerCmsDatepickers();
        window.setTimeout(initRetailerCmsDatepickers, 150);
        jQuery('#btnExportRetailerCms').on('click', function (e) {
            e.preventDefault();
            var d = retailerCmsDates();
            location.href = '@Url.Action("ExcelRetailerposreport", "Home")?txt_frm_date=' + encodeURIComponent(d.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(d.txt_to_date);
        });
        jQuery('#btnPDFRetailerCms').on('click', function () {
            var d = retailerCmsDates();
            window.open('@Url.Action("PDFRetailerposreport", "Home")?txt_frm_date=' + encodeURIComponent(d.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(d.txt_to_date), '_blank');
        });
    });
</script>
}
