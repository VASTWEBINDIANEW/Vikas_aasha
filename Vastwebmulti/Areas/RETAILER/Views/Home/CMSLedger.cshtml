    body.saas-admin-ui .saas-retailer-cms-page #retailerCmsLedgerReport tbody tr.vm-ledger-row--debit { background: #fff7f7 !important; }
    body.saas-admin-ui .saas-retailer-cms-page #retailerCmsLedgerReport tbody tr:hover { background: #f6f9ff !important; }
    body.saas-admin-ui .saas-retailer-cms-page .vm-ledger-cd { display: inline-flex !important; align-items: center; gap: 5px; font-size: 10.5px; font-weight: 800; padding: 2px 9px; border-radius: 999px; white-space: nowrap; }
    body.saas-admin-ui .saas-retailer-cms-page .vm-ledger-cd--cr { background: #e7f7ee !important; color: #15803d !important; }
    body.saas-admin-ui .saas-retailer-cms-page .vm-ledger-cd--dr { background: #fdecec !important; color: #c62828 !important; }
    body.saas-admin-ui .saas-retailer-cms-page .vm-ledger-nav { display: inline-flex !important; align-items: center; gap: 6px; min-height: 34px; padding: 0 14px; border-radius: 9px; border: 1px solid #dbe2ec; background: #fff; color: #475569; font-size: 12.5px; font-weight: 800; text-decoration: none !important; transition: all .15s ease; white-space: nowrap; }
    body.saas-admin-ui .saas-retailer-cms-page .vm-ledger-nav:hover { border-color: #2563eb; color: #2563eb; box-shadow: 0 4px 12px rgba(37,99,235,.18); }
