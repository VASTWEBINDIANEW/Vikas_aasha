@model IEnumerable<Vastwebmulti.Models.show_all_user_income_Result>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Actual_Retailer_income";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
    var reports = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.show_all_user_income_Result>();
    var rowCount = reports.Count;
    decimal totalIncome = 0m;
    try { totalIncome = reports.Sum(m => Convert.ToDecimal(m.Amount)); } catch { totalIncome = 0m; }
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=43" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=22" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<style>
    /* Income counts : success/pending/failed colors */
    body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport tbody tr:hover { background: #f6f9ff !important; }
    body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport tfoot tr.vm-dmt-total-row { background: #eef2ff !important; }
    body.saas-admin-ui .saas-retailer-income-page .vm-inc-count { display: inline-block !important; font-weight: 800 !important; font-size: 13px !important; font-variant-numeric: tabular-nums !important; }
    body.saas-admin-ui .saas-retailer-income-page .vm-inc-count--ok { color: #15803d !important; }
    body.saas-admin-ui .saas-retailer-income-page .vm-inc-count--wait { color: #a16207 !important; }
    body.saas-admin-ui .saas-retailer-income-page .vm-inc-count--bad { color: #c62828 !important; }
    /* Desktop (>=1024px): fit-to-width, no scroll, tight columns */
    @@media (min-width: 1024px) {
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table {
            width: 100% !important;
            min-width: 0 !important;
            max-width: 100% !important;
            table-layout: fixed !important;
        }
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table thead tr,
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table tbody tr,
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table tfoot tr {
            display: table-row !important;
        }
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table thead th,
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table tbody td,
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table tfoot td {
            display: table-cell !important;
            min-width: 0 !important;
            max-width: none !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            white-space: nowrap !important;
        }
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table thead th:nth-child(1),
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table tbody td:nth-child(1),
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table tfoot td:nth-child(1) { width: 8% !important; }
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table thead th:nth-child(2),
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table tbody td:nth-child(2),
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table tfoot td:nth-child(2) { width: 28% !important; }
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table thead th:nth-child(3),
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table tbody td:nth-child(3),
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table tfoot td:nth-child(3) { width: 16% !important; }
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table thead th:nth-child(4),
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table tbody td:nth-child(4),
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table tfoot td:nth-child(4) { width: 16% !important; }
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table thead th:nth-child(5),
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table tbody td:nth-child(5),
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table tfoot td:nth-child(5) { width: 16% !important; }
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table thead th:nth-child(6),
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table tbody td:nth-child(6),
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table tfoot td:nth-child(6) { width: 16% !important; }
    }
    /* Mobile + tablet (<=1023px): natural widths, full text, horizontal scroll */
    @@media (max-width: 1023.98px) {
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table {
            width: max-content !important;
            min-width: 720px !important;
            max-width: none !important;
            table-layout: auto !important;
        }
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table thead tr,
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table tbody tr,
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table tfoot tr {
            display: table-row !important;
        }
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table thead th,
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table tbody td,
        body.saas-admin-ui .saas-retailer-income-page #retailerIncomeReport.vm-opr-data-table tfoot td {
            display: table-cell !important;
            width: auto !important;
            min-width: 0 !important;
            max-width: none !important;
            white-space: nowrap !important;
            overflow: visible !important;
            text-overflow: clip !important;
        }
        body.saas-admin-ui .saas-retailer-income-page .vm-opr-table-scroll {
            overflow-x: auto !important;
        }
    }
</style>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-retailer-ecomm-transaction-page saas-retailer-income-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var incomeFormAttrs = new Dictionary<string, object>
            {
                { "id", "retailerIncomeForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-report-date-form", "" },
                { "data-report-from", "#retailer_income_frm_date" },
                { "data-report-to", "#retailer_income_to_date" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("Actual_Retailer_income", "Home", FormMethod.Post, incomeFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home", new { area = "RETAILER" })"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>My Account</li>
                        <li>My Earn (Day Income)</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters vm-ecomm-filter-row--one-line">

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_income_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_income_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="retailerIncomeTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Income totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideRetailerIncomeTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Total income</span>
                            <strong class="vm-opr-total-card__value">&#8377; @totalIncome.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Records</span>
                            <strong class="vm-opr-total-card__value">@rowCount</strong>
                        </div>
                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-coins" aria-hidden="true"></i>
                        <span>My earn (day income)</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong>@rowCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total" title="Total income">
                            Total: <strong>&#8377; @totalIncome.ToString("N2")</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-ecomm-totals-btn" onclick="showRetailerIncomeTotals()" title="Show totals" aria-expanded="false" aria-controls="retailerIncomeTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnExportRetailerIncome" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDFRetailerIncome" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="retailerIncomeReport" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Sr. No</th>
                                    <th>Type</th>
                                    <th>Total Success</th>
                                    <th>Total Pending</th>
                                    <th>Total Failed</th>
                                    <th>Income &#8377;</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (reports.Count > 0)
                                {
                                    int i = 1;
                                    foreach (var item in reports)
                                    {
                                        <tr class="vm-dmt-row">
                                            <td><span class="vm-dmt-refno-text">@i</span></td>
                                            <td><span class="vm-dmt-consumer-text" title="@item.Type">@item.Type</span></td>
                                            <td><span class="vm-inc-count vm-inc-count--ok">@item.TotalSuccess</span></td>
                                            <td><span class="vm-inc-count vm-inc-count--wait">@item.TotalPending</span></td>
                                            <td><span class="vm-inc-count vm-inc-count--bad">@item.TotalFailed</span></td>
                                            <td><span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @item.Amount</span></td>
                                        </tr>
                                        i++;
                                    }
                                }
                                else
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="6" class="vm-opr-table-empty vm-dmt-table-empty">
                                            <i class="fas fa-coins" aria-hidden="true"></i>
                                            <span>No income records found.</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            @if (reports.Count > 0)
                            {
                                <tfoot>
                                    <tr class="vm-dmt-row vm-dmt-total-row">
                                        <td><span class="vm-dmt-amount-text"><strong>Total</strong></span></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td></td>
                                        <td><span class="vm-dmt-amount-text"><strong>&#8377; @totalIncome.ToString("N2")</strong></span></td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section PostVmScripts {
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    function hideRetailerIncomeTotals() {
        var $panel = jQuery('#retailerIncomeTotalsPanel');
        var $btn = jQuery('.saas-retailer-income-page .vm-ecomm-totals-btn');
        $panel.hide().attr('aria-hidden', 'false');
        $btn.attr('aria-expanded', 'false');
    }

    function showRetailerIncomeTotals() {
        var $panel = jQuery('#retailerIncomeTotalsPanel');
        var $btn = jQuery('.saas-retailer-income-page .vm-ecomm-totals-btn');
        if ($panel.is(':visible')) {
            hideRetailerIncomeTotals();
            return;
        }
        $panel.show().attr('aria-hidden', 'false');
        $btn.attr('aria-expanded', 'true');
    }

    function retailerIncomeDates() {
        return {
            txt_frm_date: jQuery('#retailer_income_frm_date').val() || '',
            txt_to_date: jQuery('#retailer_income_to_date').val() || ''
        };
    }

    function initRetailerIncomeDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initRetailerIncomeDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm(
                '#retailerIncomeForm',
                '#retailer_income_frm_date',
                '#retailer_income_to_date',
                true
            );
        }
    }

    jQuery(function () {
        initRetailerIncomeDatepickers();
        window.setTimeout(initRetailerIncomeDatepickers, 150);
        jQuery('#btnExportRetailerIncome').on('click', function (e) {
            e.preventDefault();
            var d = retailerIncomeDates();
            location.href = '@Url.Action("Excel_Actual_Retailer_income", "Home")?txt_frm_date=' + encodeURIComponent(d.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(d.txt_to_date);
        });
        jQuery('#btnPDFRetailerIncome').on('click', function () {
            var d = retailerIncomeDates();
            window.open('@Url.Action("PDF_Actual_Retailer_income", "Home")?txt_frm_date=' + encodeURIComponent(d.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(d.txt_to_date), '_blank');
        });
    });
</script>
}
