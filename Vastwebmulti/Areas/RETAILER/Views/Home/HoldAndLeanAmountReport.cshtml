</style>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-retailer-ecomm-transaction-page saas-retailer-holdlean-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var holdFormAttrs = new Dictionary<string, object>
            {
                { "id", "retailerHoldLeanForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-report-date-form", "" },
                { "data-report-from", "#retailer_hold_frm_date" },
                { "data-report-to", "#retailer_hold_to_date" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("HoldAndLeanAmountReport", "Home", FormMethod.Post, holdFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home", new { area = "RETAILER" })"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Reports</li>
                        <li>Hold And Lean Amount Report</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters vm-ecomm-filter-row--one-line">

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_hold_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_hold_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="retailerHoldLeanTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Hold amount totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideRetailerHoldLeanTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--primary">
                            <span class="vm-opr-total-card__label">Total hold amount</span>
                            <strong class="vm-opr-total-card__value">&#8377; @totalHold.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Records</span>
                            <strong class="vm-opr-total-card__value">@rowCount</strong>
                        </div>
                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-pause-circle" aria-hidden="true"></i>
                        <span>Hold and lean amount report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong>@rowCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total" title="Total hold amount">
                            Total Hold: <strong>&#8377; @totalHold.ToString("N2")</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-ecomm-totals-btn" onclick="showRetailerHoldLeanTotals()" title="Show totals" aria-expanded="false" aria-controls="retailerHoldLeanTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnExportRetailerHoldLean" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDFRetailerHoldLean" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="retailerHoldLeanReport" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Firm&nbsp;name</th>
                                    <th>Amount&nbsp;&#8377;</th>
                                    <th>Type</th>
                                    <th>Request&nbsp;id</th>
                                    <th>Description</th>
                                    <th>Remain&nbsp;pre&nbsp;&#8377;</th>
                                    <th>Remain&nbsp;post&nbsp;&#8377;</th>
                                    <th>Hold&nbsp;pre&nbsp;&#8377;</th>
                                    <th>Hold&nbsp;post&nbsp;&#8377;</th>
                                    <th>Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody id="retailerHoldLeanRows">
                                @if (reports.Count > 0)
                                {
                                    foreach (var item in reports)
                                    {
                                        var st = (item.Status ?? "").Trim();
                                        var stu = st.ToUpper();
                                        var tone = "pending";
                                        var fa = "fa-clock-o";
                                        if (stu == "SUCCESS" || stu == "COMPLETED" || stu == "APPROVED" || stu == "RELEASED")
                                        {
                                            tone = "success";
                                            fa = "fa-check";
                                        }
                                        else if (stu == "FAILED" || stu == "REJECTED" || stu == "CANCELLED" || stu == "CANCELED")
                                        {
                                            tone = "failed";
                                            fa = "fa-times";
                                        }
                                        <tr class="vm-dmt-row">
                                            <td>
                                                <span class="vm-dmt-consumer-text">@item.Firmname</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(item.Amount ?? 0m, 2)</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-refno-text">@item.Type</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-refno-text">@item.RequestId</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-consumer-text">@item.Description</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(item.RemainPre ?? 0m, 2)</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(item.RemainPost ?? 0m, 2)</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(item.HoldRemainPre ?? 0m, 2)</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(item.HoldRemainPost ?? 0m, 2)</span>
                                            </td>
                                            <td class="vm-ticket-time-cell">
                                                <span class="vm-dmt-refno-text">@(item.InsertDate.HasValue ? String.Format("{0:dd-MMM-yyyy HH:mm:ss}", item.InsertDate.Value) : "—")</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-status vm-dmt-status--@tone" title="@st"><i class="fa @fa" aria-hidden="true"></i></span>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="11" class="vm-opr-table-empty vm-dmt-table-empty">
                                            <i class="fas fa-pause-circle" aria-hidden="true"></i>
                                            <span>No hold amount records found.</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section PostVmScripts {
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    function hideRetailerHoldLeanTotals() {
        var $panel = jQuery('#retailerHoldLeanTotalsPanel');
        var $btn = jQuery('.saas-retailer-holdlean-page .vm-ecomm-totals-btn');
        $panel.hide().attr('aria-hidden', 'true');
        $btn.attr('aria-expanded', 'false');
    }

    function showRetailerHoldLeanTotals() {
        var $panel = jQuery('#retailerHoldLeanTotalsPanel');
        var $btn = jQuery('.saas-retailer-holdlean-page .vm-ecomm-totals-btn');
        if ($panel.is(':visible')) {
            hideRetailerHoldLeanTotals();
            return;
        }
        $panel.show().attr('aria-hidden', 'false');
        $btn.attr('aria-expanded', 'true');
    }

    function downloadRetailerHoldLeanExcel() {
        var table = document.getElementById('retailerHoldLeanReport');
        if (!table || !table.tBodies || !table.tBodies[0] || table.tBodies[0].rows.length === 0) {
            alert('No records to export.');
            return;
        }
        var html = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><meta charset="UTF-8"></head><body>' + table.outerHTML + '</body></html>';
        var blob = new Blob(['\ufeff' + html], { type: 'application/vnd.ms-excel' });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'HoldAndLeanAmountReport.xls';
        document.body.appendChild(a);
        a.click();
        setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 100);
    }

    function initRetailerHoldLeanDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initRetailerHoldLeanDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm(
                '#retailerHoldLeanForm',
                '#retailer_hold_frm_date',
                '#retailer_hold_to_date',
                true
            );
        }
    }

    jQuery(function () {
        initRetailerHoldLeanDatepickers();
        window.setTimeout(initRetailerHoldLeanDatepickers, 150);
        jQuery('#btnExportRetailerHoldLean').on('click', function (e) {
            e.preventDefault();
            downloadRetailerHoldLeanExcel();
        });
        jQuery('#btnPDFRetailerHoldLean').on('click', function () {
            window.print();
        });
    });
</script>
}
