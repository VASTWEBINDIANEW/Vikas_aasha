        body.saas-admin-ui .saas-retailer-holdlean-page #retailerHoldLeanReport.vm-opr-data-table thead th:nth-child(11),
        body.saas-admin-ui .saas-retailer-holdlean-page #retailerHoldLeanReport.vm-opr-data-table tbody td:nth-child(11) { width: 7% !important; }
    }
    /* Mobile + tablet (<=1023px): natural widths, full text, horizontal scroll */
    @@media (max-width: 1023.98px) {
        body.saas-admin-ui .saas-retailer-holdlean-page #retailerHoldLeanReport.vm-opr-data-table {
            width: max-content !important;
            min-width: 1150px !important;
            max-width: none !important;
            table-layout: auto !important;
        }
        body.saas-admin-ui .saas-retailer-holdlean-page #retailerHoldLeanReport.vm-opr-data-table thead tr,
        body.saas-admin-ui .saas-retailer-holdlean-page #retailerHoldLeanReport.vm-opr-data-table tbody tr {
            display: table-row !important;
        }
        body.saas-admin-ui .saas-retailer-holdlean-page #retailerHoldLeanReport.vm-opr-data-table thead th,
        body.saas-admin-ui .saas-retailer-holdlean-page #retailerHoldLeanReport.vm-opr-data-table tbody td {
            display: table-cell !important;
            width: auto !important;
            min-width: 0 !important;
            max-width: none !important;
            white-space: nowrap !important;
            overflow: visible !important;
            text-overflow: clip !important;
        }
        body.saas-admin-ui .saas-retailer-holdlean-page .vm-opr-table-scroll {
            overflow-x: auto !important;
        }
        /* Mobile + tablet: filter dropdowns full width */
        body.saas-admin-ui .saas-retailer-holdlean-page .vm-opr-filter-row > .vm-opr-field,
        body.saas-admin-ui .saas-retailer-holdlean-page .vm-rpt-filters-panel__bar > .vm-opr-field {
            flex: 1 1 100% !important;
            min-width: 0 !important;
            max-width: 100% !important;
            width: 100% !important;
        }
        body.saas-admin-ui .saas-retailer-holdlean-page .vm-opr-filter-row > .vm-opr-field .vm-opr-select,
        body.saas-admin-ui .saas-retailer-holdlean-page .vm-opr-filter-row > .vm-opr-field .select2,
        body.saas-admin-ui .saas-retailer-holdlean-page .vm-opr-filter-row > .vm-opr-field .select2-container {
            width: 100% !important;
