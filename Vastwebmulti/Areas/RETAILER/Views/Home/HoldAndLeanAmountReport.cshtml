        body.saas-admin-ui .saas-retailer-holdlean-page #retailerHoldLeanReport.vm-opr-data-table thead th:nth-child(6),
        body.saas-admin-ui .saas-retailer-holdlean-page #retailerHoldLeanReport.vm-opr-data-table tbody td:nth-child(6) { width: 8% !important; }
        body.saas-admin-ui .saas-retailer-holdlean-page #retailerHoldLeanReport.vm-opr-data-table thead th:nth-child(7),
