<script>
    function otpsendr2r(otpcount, otpfor) {
        $.ajax({
            url: '@Url.Action("Transactionotpsend", "Home")',
            data: { otpcount: otpcount, otpfor: otpfor },
            cache: false,
            type: "POST",
            success: function (data) {
                var status = data.status;
                var msg = data.Message;
                if (status == "Success") {
                    msg = data.Message;
                    setTimeout(function () {
                        var deadline = new Date().getTime() + 60000;
                        var x = setInterval(function () {
                            var now = new Date().getTime();
                            var t = deadline - now;
                            var seconds = Math.max(0, Math.floor(t / 1000));
                            var demo = document.getElementById("demor2r");
                            if (demo) { demo.innerHTML = "Resend OTP after " + seconds + " seconds "; }
                            if (seconds <= 0) {
                                clearInterval(x);
                                var d = document.getElementById("demor2r");
                                if (d) { d.style.display = "none"; }
                                document.getElementById('hideshowotpbtnr2r').style.display = "none";
                                document.getElementById('resendotpr2r').style.display = "block";
                            }
                        }, 1000);
                    }, 4000);
                    setTimeout(function () {
                        document.getElementById('hideshowotpbtnr2r').style.display = "none";
                        document.getElementById('otpsubmithideshowr2r').style.display = 'block';
                        document.getElementById('dmtsuccesscodeotpr2r').style.display = "block";
                        $('#dmtsuccesscodeotpr2r').text(msg);
                        setTimeout(function () { document.getElementById('dmtsuccesscodeotpr2r').style.display = "none"; }, 5000);
                    });
                }
                else {
                    $('#dmterrorcodeotpr2r').text(msg);
                    setTimeout(function () { document.getElementById('dmterrorcodeotpr2r').style.display = "none"; }, 4000);
                }
            }
        });
    }
</script>
