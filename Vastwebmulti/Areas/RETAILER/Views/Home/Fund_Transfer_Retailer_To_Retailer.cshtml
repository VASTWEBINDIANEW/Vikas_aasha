<script>
    $("#RetailerId").blur(function (event) {
        var mobemail = $("#RetailerId").val();
        if (!mobemail || mobemail.length < 6) { $('#retailerinform').hide(); $('#shownoneclass').prop('disabled', true); return; }
        $.ajax({
            url: "@Url.Action("CheckRetailerEmailMobile")",
            data: { emailmobile: mobemail },
            success: function (txt) {
                if (txt != '') {
                    var data = JSON.parse(txt);
                    $('#retailerinform').show();
                    $('#lblfrmname').text(data.frm_name);
                    $('#lblreatilername').text(data.retailername);
                    $('#lblemail').text(data.email);
                    $('#lblmobile').text(data.mobile);
                    $('#shownoneclass').prop('disabled', false);
                }
                else {
                    $('#retailerinform').hide();
                    $('#shownoneclass').prop('disabled', true);
                }
            },
            error: function (xhr) {
                alert('Request Status: ' + xhr.status + ' Status Text: ' + xhr.statusText + ' ' + xhr.responseText);
            }
        });
    });
</script>

