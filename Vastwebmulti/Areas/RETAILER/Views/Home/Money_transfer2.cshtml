                                        <p class="vm-rmt-aeps-2fa-card__subtitle">Complete Aadhaar scan before Green / Yellow line options appear.</p>
                                    </div>
                                </header>
                                <div class="vm-rmt-aeps-2fa-card__body">
                                    @Html.Partial("_2FA")
                                </div>
                            </div>
                        }
                        else if (ViewBag.req == "APPROVAL-PENDING")
                        {
