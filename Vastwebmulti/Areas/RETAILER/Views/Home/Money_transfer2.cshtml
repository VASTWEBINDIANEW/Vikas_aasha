<script>
    function vmRmtSelect2DropdownParent($scope) {
        var $scopeEl = ($scope && $scope.length) ? $scope : $('#full');
        var $tab = $scopeEl.closest('.vm-rmt-tab-pane');
        if ($tab.length) {
            return $tab;
        }
        return $('section.vm-rmt-page').first();
    }

    function vmRmtInitMoneyTransferSelect2($scope) {
        if (!window.jQuery || !$.fn.select2) {
            return;
        }
        var $root = ($scope && $scope.length) ? $scope : $('#full');
        var $targets = $root.find('select').not('#manual select, #Corrections select');
        var opts = { dropdownParent: vmRmtSelect2DropdownParent($root), width: '100%' };
        if (typeof window.applyAdminSelect2 === 'function') {
            window.applyAdminSelect2($targets, opts, true);
        } else {
            $targets.each(function () {
                var $s = $(this);
                if ($s.hasClass('select2-hidden-accessible')) {
                    try { $s.select2('destroy'); } catch (ignore) { }
                }
                if ($s.is(':visible') || $root.is('#tab-1')) {
                    $s.select2(opts);
                }
            });
        }
    }

    $(function () {
        vmRmtInitMoneyTransferSelect2($('#tab-1'));
    });
</script>
<script>
    function RegisterAccount(senderno, account, ifsccode, originalifsccode, benname) {
        $('#errorsenderno').text('');
        if (senderno != "" && account != "" && ifsccode != "" && originalifsccode != "" && benname != "") {
            $.ajax({
                url: '@Url.Action("Register_ben")',
                data: { senderno, account, ifsccode, originalifsccode, benname },
                cache: false,
                type: "POST",
                success: function (data) {
                    var sts = data.statuscode;
                    var msg = data.status;
                    if (sts == "TXN") {
                        fetchDmtReport();
                    }
                    else {
                        $('#errorsenderno').text(msg);
                    }
                }
            });
        }
    }
    function fetchDmtReport(e) {
        vmRmtLoadReport(vmRmtActiveServiceKey());
    }

    function PayAgain(senderno, mode, accountno, amount) {
        $('#Firstpage').show();
        $('#remlist').hide();
        $('#dmttransfer').hide();
        $('#dmtconfirm').hide();

        $('#senderno').val(senderno);
        senderdetails('new', (err, ben_list) => {
            if (err) return $('#errorsenderno').text(err);

            var _mode = 'impsbutton';

            if (mode == 'UPI') {
                _mode = 'upibutton';
            }
            else if (mode == 'NEFT') {
                _mode = 'neftbutton';
            }
            else if (mode == 'WALLET') {
                _mode = 'paytmwalletbutton';
            }

            $('#' + _mode).prop('checked', true);

            if (mode == 'IMPS' || mode == 'NEFT') {
                var ben_obj = ben_list.find(s => s.account == accountno);

                if (!ben_obj || !ben_obj.id) {
                    return;
                }

                let id = ben_obj.id;

                setTimeout(() => {
                    var el = $(`tr#${id} a.addtabledata`)

                    el.click();

                    $('#amounttransfer').val(amount);
                }, 500);
            }
            else if (mode == 'UPI') {
                upibenlist(senderno, (err, list) => {
                    if (err) return;
                    list = JSON.parse(list);

                    let upi_obj = list.find(s => s.UPIID == accountno);
                    if (!upi_obj) return;

                    setTimeout(() => {
                        let el = $(`tr#${upi_obj.idno} a.addtabledata`);
                        el.click();
                        $('#amounttransfer').val(amount);
                    }, 500);

                });
            }
            //else if (mode == 'WALLET') {
            //    paytmwalletbenlist(senderno, (err, list) => {
            //        if (err) return;
            //        list = JSON.parse(list);

            //        let upi_obj = list.find(s => s.UPIID == accountno);
            //        if (!upi_obj) return;

            //        setTimeout(() => {
            //            let el = $(`tr#${upi_obj.idno} a.addtabledata`);
            //            el.click();
            //            $('#amounttransfer').val(amount);
            //        }, 500);

            //    });
            //}


        });
    }

    var loading = false;

    function Dmt_status_check() {
        if (loading == true) return;

        loading = true;
        $.ajax({
            url: '@Url.Action("Dmt_status_check")',
            type: "GET",
            cache: false,
            success: function (data) {
                loading = false;
                fetchDmtReport();
            }
        })
    }

</script>

<script>
    var otpReferenceID = '';
    var hash = '';

    $('#createBtn').click(() => {
        otpReferenceID = '';
        hash = '';

        $.ajax({
            url: '@Url.Action("sendOtpForOutlet", "Home")',
            cache: false,
            type: "GET",
            beforeSend: function () {
                $(".loader").show();
                $('#otp-box').hide();
            },
            success: function (data) {
                $(".loader").hide();
                console.clear();

                if (data.status) {
                    $('#createBtn').hide();
                    $('#otp-input').val('');
                    $('#otp-box').show();

                    otpReferenceID = encodeURIComponent(data.otpReferenceID);
                    hash = encodeURIComponent(data.hash);
                }
                else {
                    $('#otp-box').hide();
                    alert(data.message);
                    $('#createBtn').show();
                    $('#gotoscan').hide();
                }
            },
            error: function (data) {
                //scanfing();
                $(".loader").hide();
            }
        })
    })

    function checkRetailerOutlet() {
        $.ajax({
            url: '@Url.Action("checkRetailerOutlet", "Home")',
            cache: false,
            type: "GET",
            beforeSend: function () {
                $(".loader").show();
            },
            success: function (data) {
                $(".loader").hide();

                if (data.status) {
                    $('#createBtn').hide();
                    $('#aeps2_outlet_box').hide();
                    $('#gotoscan').show();
                }
                else {
                    $('#createBtn').show();
                    $('#aeps2_outlet_box').show();
                    $('#gotoscan').hide();
                }
            },
            error: function (data) {
                //scanfing();
                $(".loader").hide();
            }
        })
    }

    var submit_btn_loading = false;
    $('#aeps2_otp_submit').click(() => {
        if (submit_btn_loading) return;

        let otp = $('#otp-input').val();
        if (!otp) return;

        $('#otperror').text('');
        submit_btn_loading = true;

        $.ajax({
            url: '@Url.Action("Aeps2VerifyOtp", "Home")?otp=' + otp + '&otpReferenceID=' + otpReferenceID + '&hash=' + hash,
            cache: false,
            type: "GET",
            beforeSend: function () {
                $(".loader").show();
                $('#createBtn').hide();
            },
            success: function (data) {
                $(".loader").hide();
                submit_btn_loading = false;

                if (data.status) {
                    $('#otp-box').hide();
                    $('#otp-input').val('');
                    $('#gotoscan').show();

                    otpReferenceID = '';
                    hash = '';
                }
                else {
                    alert(data.message);
                }
            },
            error: function (data) {
                //scanfing();
                $(".loader").hide();
            }
        })
    })

    function aeps1() {
        $('#aeps2_outlet_box').hide();
        $('#otp-box').hide();
        $('#gotoscan').show();
    }

</script>
