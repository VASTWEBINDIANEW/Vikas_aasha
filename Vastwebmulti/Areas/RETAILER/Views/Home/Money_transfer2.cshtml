<script>
    var vmRmtReportUrls = {
        dmt: '@Url.Action("DMTreportnew", "Home")',
        aeps: '@Url.Action("AEPSreportnew", "Home")',
        aepsupi: '@Url.Action("AEPSUPIreportnew", "Home")',
        pancard: '@Url.Action("PANCARDreportnew", "Home")',
        microatm: '@Url.Action("MIcroAtmReportnew", "Home")'
    };

    function vmRmtDismissPageBlockers() {
        $('#aepstableclickpop, #aepstableclickpopee, #dmtdetails').removeClass('in show').attr('aria-hidden', 'true').css('display', 'none');
        var hasVisibleModal = $('body.saas-admin-ui .modal').filter(function () {
            var $m = $(this);
            return ($m.hasClass('in') || $m.hasClass('show')) && $m.is(':visible');
        }).length > 0;
        if (!hasVisibleModal) {
            $('.modal-backdrop').remove();
            $('body').removeClass('modal-open').css({ overflow: '', 'padding-right': '' });
        }
        $('section.vm-rmt-page .loader').each(function () {
            var $ld = $(this);
            if (!$ld.is(':visible')) {
                $ld.css({ display: 'none', pointerEvents: 'none', visibility: 'hidden' });
            }
        });
    }

    function vmRmtLoadReport(serviceKey) {
        var url = vmRmtReportUrls[serviceKey];
        if (!url) return;
        var $refresh = $('section.vm-rmt-page .vm-rmt-table-refresh');
        $refresh.addClass('is-loading').prop('disabled', true);
        $.ajax({
            url: url,
            cache: false,
            type: "GET",
            dataType: "html",
            success: function (data) {
                $('#reportallinone').html(data);
                vmRmtDismissPageBlockers();
            },
            error: function (xhr) {
                var msg = 'Unable to load report. Please try again.';
                if (xhr && xhr.status === 401) {
                    msg = 'Session expired. Please log in again.';
                }
                $('#reportallinone').html(
                    '<div class="vm-rmt-report-error" role="alert">' + msg + '</div>'
                );
            },
            complete: function () {
                $('section.vm-rmt-page .vm-rmt-table-refresh').removeClass('is-loading').prop('disabled', false);
            }
        });
    }

    function vmRmtRefreshActivePaneWidgets(serviceKey) {
        window.setTimeout(function () {
            try {
                if (serviceKey === 'dmt') {
                    if (typeof vmRmtInitMoneyTransferSelect2 === 'function') {
                        vmRmtInitMoneyTransferSelect2($('#tab-1'));
                    }
                } else if (serviceKey === 'pancard') {
                    if ($('#manual').is(':visible') && typeof window.vmRmtInitPancardManualSelect2 === 'function') {
                        window.vmRmtInitPancardManualSelect2();
                    }
                    if ($('#Corrections').is(':visible') && typeof window.vmRmtInitPancardCorrectionSelect2 === 'function') {
                        window.vmRmtInitPancardCorrectionSelect2();
                    }
                }
            } catch (err) {
                console.error('vmRmtRefreshActivePaneWidgets', serviceKey, err);
            }
        }, 120);
    }

    function vmRmtSwitchTab(tabId) {
        if (!tabId) return;
        var $tabs = $('ul.vm-rmt-service-tabs#tabsmyss > li.vm-rmt-tab-item');
        var $panes = $('section.vm-rmt-page #full.vm-rmt-left-panel .vm-rmt-tab-pane');

        $tabs.removeClass('current').attr('aria-selected', 'false');
        $panes.removeClass('current').attr('aria-hidden', 'true');

        var $activeTab = $tabs.filter('[data-tab="' + tabId + '"]');
        var $activePane = $('section.vm-rmt-page #full.vm-rmt-left-panel #' + tabId);

        $activeTab.addClass('current').attr('aria-selected', 'true');
        $activePane.addClass('current').attr('aria-hidden', 'false');
    }

    function vmRmtActiveServiceKey() {
        var $cur = $('ul.vm-rmt-service-tabs#tabsmyss > li.vm-rmt-tab-item.current').first();
        return $cur.attr('data-vm-rmt-service') || 'dmt';
    }

    function vmRmtDefaultAepsLine() {
        var enabled = '@(ViewBag.aepsenabled ?? "")';
        if (enabled === 'Green') {
            return 'A1';
        }
        return 'A2';
    }

    function vmRmtDefaultAepsUpiLine() {
        var enabled = '@(ViewBag.UPIaepsenabled ?? "")';
        if (enabled === 'Green') {
            return 'A1UPI';
        }
        return 'A2UPI';
    }

    function vmRmtInitDmtForm() {
        var currentUrl = window.location.href;
        if (currentUrl.indexOf("AEPS") !== -1) {
            window.location.href = currentUrl.replace("/AEPS", "");
            return false;
        }
        try {
            var dmtUrl = new URL(window.location.href);
            if (dmtUrl.searchParams.has('info')) {
                dmtUrl.searchParams.delete('info');
                window.location.href = dmtUrl.toString();
                return false;
            }
        } catch (e) { }
        $('#addaccount-add123').show();
        $('#addaccount-add123_again').hide();
        $('#senderno').val("");
        $('#Firstpage').show();
        $('#NewSenderregister').hide();
        $('#otpshow').hide();
        $('#remlist').hide();
        $('#dmttransfer').hide();
        $('#dmtconfirm').hide();
        $('#dmttransferfinal').hide();
        $('#register_new_ben').hide();
        $('#benadd').hide();
        if (typeof vmRmtInitMoneyTransferSelect2 === 'function') {
            window.setTimeout(function () { vmRmtInitMoneyTransferSelect2($('#tab-1')); }, 0);
        }
        return true;
    }

    function vmRmtInitServicePane(serviceKey) {
        switch (serviceKey) {
            case 'dmt':
                vmRmtInitDmtForm();
                break;
            case 'aeps':
                if ($('#checkapi').length && typeof AEPS === 'function') {
                    AEPS();
                }
                break;
            case 'aepsupi':
                if (typeof AEPSUPI === 'function') {
                    AEPSUPI();
                }
                break;
            case 'pancard':
                if (typeof PANCARD === 'function') PANCARD();
                break;
            case 'microatm':
                if (typeof GotoATMActive === 'function') GotoATMActive();
                break;
        }
    }

    function vmRmtRunServiceTab(tabId, serviceKey) {
        if (!tabId || !serviceKey) return;

        var urlParams = new URLSearchParams(window.location.search);
        var infoParam = urlParams.get('info');

        if (serviceKey === 'aeps') {
            if (infoParam !== 'A1' && infoParam !== 'A2') {
                AEPSinfo(vmRmtDefaultAepsLine());
                return;
            }
        } else if (serviceKey === 'aepsupi') {
            if (infoParam !== 'A1UPI' && infoParam !== 'A2UPI') {
                AEPSinfo(vmRmtDefaultAepsUpiLine());
                return;
            }
        }

        vmRmtSwitchTab(tabId);

        if (vmRmtReportUrls[serviceKey]) {
            vmRmtLoadReport(serviceKey);
        }

        window.setTimeout(function () {
            try {
                vmRmtInitServicePane(serviceKey);
                vmRmtRefreshActivePaneWidgets(serviceKey);
            } catch (err) {
                console.error('vmRmtInitServicePane', serviceKey, err);
            }
        }, 0);
    }

    function AEPSUPI() {
        vmRmtLoadReport('aepsupi');
    }

    function DMT() {
        if (vmRmtInitDmtForm() === false) return;
        vmRmtLoadReport('dmt');
    }
</script>
<script>
    $(function () {
        function activateFromTab($tab) {
            if (!$tab || !$tab.length) return;
            var tab_id = $tab.attr('data-tab');
            var serviceKey = $tab.attr('data-vm-rmt-service');
            if (!tab_id || !serviceKey) return;
            vmRmtRunServiceTab(tab_id, serviceKey);
        }

        $(document).off('click.vmRmtTabs keydown.vmRmtTabs', 'section.vm-rmt-page ul.vm-rmt-service-tabs#tabsmyss > li.vm-rmt-tab-item');
        $(document).on('click.vmRmtTabs', 'section.vm-rmt-page ul.vm-rmt-service-tabs#tabsmyss > li.vm-rmt-tab-item', function (e) {
            e.preventDefault();
            e.stopPropagation();
            activateFromTab($(this));
        });
        $(document).on('keydown.vmRmtTabs', 'section.vm-rmt-page ul.vm-rmt-service-tabs#tabsmyss > li.vm-rmt-tab-item', function (e) {
            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                activateFromTab($(this));
            }
        });

        $('ul.tabsmy#tabsmyss').off('click');

        window.vmRmtRunServiceTab = vmRmtRunServiceTab;
        window.vmRmtLoadReport = vmRmtLoadReport;
        window.vmRmtSwitchTab = vmRmtSwitchTab;

        vmRmtDismissPageBlockers();
        setTimeout(vmRmtDismissPageBlockers, 0);
        setTimeout(vmRmtDismissPageBlockers, 400);

        var vmRmtResizeTimer;
        $(window).on('resize.vmRmtPage orientationchange.vmRmtPage', function () {
            clearTimeout(vmRmtResizeTimer);
            vmRmtResizeTimer = setTimeout(function () {
                vmRmtRefreshActivePaneWidgets(vmRmtActiveServiceKey());
            }, 200);
        });
    });
</script>
