                    var aepsReq = ViewBag.req as string;
                    var aepsNoApi = aepsApiNm == "NO";
                    var aepsHasFlow = !string.IsNullOrEmpty(aepsReq);
                    var aepsNeeds2Fa = aepsReq == "2FAREQUIRED" || ViewBag.daily2fa_AEPS == false;
                    var aepsPreTxn = aepsReq == "REQUIREDOTP" || aepsReq == "REQUIREDSCAN" || aepsReq == "REQUIREDEKYC" || aepsReq == "APPROVAL-PENDING";
                    var aepsShowLineTabs = !(aepsNoApi && !aepsHasFlow) && !aepsNeeds2Fa && !aepsPreTxn;
                }
                @if (aepsShowLineTabs)
                {
                    <div class="vm-rmt-aeps-line-block">
                        <div class="vm-rmt-aeps-line-block__head">
                            <span class="vm-rmt-aeps-step-badge vm-rmt-aeps-step-badge--done">Step 2</span>
                            <div class="vm-rmt-aeps-line-block__titles">
                                <strong class="vm-rmt-aeps-line-block__title">Choose AEPS line</strong>
                                <span class="vm-rmt-aeps-line-block__hint">2FA complete — select Green or Yellow line to continue</span>
                            </div>
                        </div>
                        <ul class="vm-rmt-line-tabs vm-rmt-line-tabs--post-2fa" id="tabs-aeps-line">
                            <li id="tab1info" class="vm-rmt-line-tabs__item">
                                <a class="vm-rmt-line-tabs__btn vm-rmt-line-tabs__btn--green" href="javascript:void(0);" onclick="AEPSinfo('A1');">Green Line AEPS</a>
                            </li>
                            <li id="tab2info" class="vm-rmt-line-tabs__item">
                                <a class="vm-rmt-line-tabs__btn vm-rmt-line-tabs__btn--yellow" href="javascript:void(0);" onclick="AEPSinfo('A2');">Yellow Line AEPS</a>
                            </li>
                        </ul>
                    </div>
                }

