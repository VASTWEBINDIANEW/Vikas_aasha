                    @if (aepsNoApi && !aepsHasFlow)
                    {
                        <div class="vm-rmt-aeps-empty">
                            <span class="vm-rmt-aeps-empty__icon" aria-hidden="true">!</span>
                            <p class="vm-rmt-aeps-empty__title">No API open</p>
                            <p class="vm-rmt-aeps-empty__text">Contact support or try another AEPS line after it is enabled.</p>
                        </div>
                    }
                    else
                    {
                        if (!aepsNoApi)
