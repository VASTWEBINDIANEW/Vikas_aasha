<style>
    #overlay {
        position: fixed;
        top: 0;
        z-index: 100;
        width: 100%;
        height: 100%;
        display: none;
        background: rgba(0,0,0,0.6);
    }
    .cv-spinner {
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    .spinner {
        width: 40px;
        height: 40px;
        border: 4px #ddd solid;
        border-top: 4px #2e93e6 solid;
        border-radius: 50%;
        animation: sp-anime 0.8s infinite linear;
    }
    @@keyframes sp-anime {
        100% {
            transform: rotate(360deg);
        }
    }
    .is-hide {
        display: none;
    }
</style>

<section class="content saas-admin-account-page saas-admin-report-page saas-fund-transfer-page saas-fund-transfer-premium saas-dealer-fund-transfer-page saas-retailer-fund-transfer-page saas-retailer-upi-page saas-retailer-upi-collect-page">

    <div class="container-fluid vm-ft-page-shell">

        <div class="vm-ft-page-toolbar vm-ft-page-toolbar--premium">
            <div class="vm-ft-page-hero">
                <div>
                    <ol class="vm-ft-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Report's</li>
                        <li>UPI Collection</li>
                    </ol>
                </div>
            </div>
            <div class="vm-ft-search-wrap">
                <input class="form-control" type="text" value="" id="myInput" name="myInput" placeholder="Search by name, amount, RRN..." autocomplete="off" onkeyup="myFunction()" />
            </div>
        </div>

        <div class="vm-ft-layout-wrap">
        <div class="vm-ft-layout vm-ft-layout--full">
            <div class="vm-ft-form-col">
                <div class="fund-trasfer-left vm-ft-form-card">
                    <div class="vm-ft-form-card-header">
                        <div class="vm-ft-form-card-header__icon" aria-hidden="true">
                            <i class="fas fa-hand-holding-usd"></i>
                        </div>
                        <div>
                            <span class="vm-ft-form-card-header__title">UPI Collection</span>
                            <span class="vm-ft-form-card-header__sub">Collect payment via UPI ID</span>
                        </div>
                    </div>
                    <ul class="nav nav-tabs fullbodydycolorbg1 tab-seconddesign tab-third-design vm-ft-role-tabs fulltabchange" id="tabs">
                        <li class="tab-link vm-ft-role-tab-li vm-ft-role-tab-li--active current active" data-tab="tab-1" role="presentation" style="width:100% !important;">
                            <a data-toggle="tab" href="#home" class="vm-ft-role-tab" aria-expanded="true" aria-selected="true">Add Wallet By UPI Collection</a>
                        </li>
                    </ul>

                    <div class="width100 float-left tabcurrent-seconddesign input-border-third">
                        <div id="home" class="width100 float-left tab-pane vm-ft-left-tab-pane fade remove-activein active in">
                            <div class="fund-transfer-form vm-dealer-ft-form-fs14">
                                <div class="scan-outer">
                                    <p id="msgg" style="color:#b45309;text-align:center;font-weight:bold;margin:0;"></p>
                                    @if (ViewBag.msg == "OK")
                                    {
                                        if (ViewBag.Api == "RADIANT")
                                        {
                                            if (ViewBag.set == "OK")
                                            {
                                                using (Html.BeginForm("Add_balance_UPI_Collection", "Home", FormMethod.Post))
                                                {
                                                    <div class="vm-upi-modern-form">
                                                        <div class="vm-upi-modern-field">
                                                            <label for="txtupi_id">UPI ID <span class="vm-upi-modern-req">*</span></label>
                                                            <div class="vm-upi-id-group">
                                                                @Html.TextBox("txtupi_id", "", new { @class = "form-control vm-upi-modern-input", placeholder = "example@upi", @required = true, autocomplete = "off" })
                                                                <button type="button" onclick="Verifynm()" class="vm-upi-modern-verify-btn">
                                                                    <i class="fa fa-check-circle"></i> Verify
                                                                </button>
                                                            </div>
                                                        </div>
                                                        <div class="vm-upi-modern-field">
                                                            <label for="txtupi_name">Payer Name <span class="vm-upi-modern-req">*</span></label>
                                                            <div class="vm-upi-modern-inputwrap">
                                                                <i class="fa fa-user vm-upi-modern-input-icon"></i>
                                                                @Html.TextBox("txtupi_name", "", new { @class = "form-control vm-upi-modern-input vm-upi-modern-input--icon", placeholder = "Auto-filled after Verify", @required = true, autocomplete = "off", @style = "padding-left: 41px !important;" })
                                                            </div>
                                                        </div>
                                                        <div class="vm-upi-modern-field">
                                                            <label for="txtupi_amount">Amount <span class="vm-upi-modern-req">*</span></label>
                                                            <div class="vm-upi-modern-inputwrap">
                                                                <span class="vm-upi-modern-rupee">₹</span>
                                                                @Html.TextBox("txtupi_amount", "", new { @class = "form-control vm-upi-modern-input vm-upi-modern-input--rupee", placeholder = "Enter Amount", @type = "number", @min = "1", @required = true })
                                                            </div>
                                                        </div>
                                                        <button type="submit" class="vm-upi-modern-submit-btn">
                                                            Collect Payment <i class="fa fa-arrow-right"></i>
                                                        </button>
                                                    </div>
                                                }
                                                <p id="txtmsg" style="color: red; text-align: center; font-weight: bold; "> </p>
                                                if (ViewBag.chkmsg == "DONE")
                                                {
                                                    <p style="color: green; text-align: center; font-weight: bold; ">
                                                        Your request processed successfully. Please open your UPI app and respond to the request.
                                                    </p>
                                                }
                                                else
                                                {
                                                    <p style="color: red; text-align: center; font-weight: bold; ">@ViewBag.chkmsg </p>
                                                }
                                                @* Collect-status panel (UPIAUTOSERVICE polling flow) — only when a collect txn is in progress *@
                                                if (TempData["GetUniqueid"] != null)
                                                {
                                                    <div class="vm-upi-status-panel" id="contentshowhide">
                                                        <div class="vm-upi-status-spinner" id="upispinner22" style="display:none;"><span class="spinner vm-upi-status-spin"></span></div>
                                                        <div id="hidemsg1212">
                                                            <p id="msggcollect" class="vm-upi-status-msg"></p>
                                                            <p id="countDownShow" class="vm-upi-status-count"></p>
                                                            <div id="QrShowHide"></div>
                                                        </div>
                                                    </div>
                                                    <div class="vm-upi-status-panel vm-upi-status-result" id="gobackshow" style="display:none;">
                                                        <p id="MessageShoHidecollect" class="vm-upi-status-final" style="display:none;"></p>
                                                        <p id="MessageShoHide" class="vm-upi-status-final" style="display:none;"></p>
                                                        <a href="@Url.Action("UPICollection", "Home")" class="vm-upi-status-back">&larr; Go Back</a>
                                                    </div>
                                                }
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <p style="color: red; text-align: center; font-weight: bold; ">@ViewBag.msg </p>
                                    }
                                    <div class="scan-third scan-third-responshive" style="width:100%;float:left;">
                                        <ol>
                                            <li>You can Not update the amount in your wallet by scanning the QR code.</li>
                                            <li>You can print a hard copy of the QR code and update through all the UPI wallets.</li>
                                            <li>Refresh the page after the customer's payment process is complete, you will get the transaction status report on the page, and after deducting the Charges on the success transaction, the balance will be updated in your wallet.</li>
                                        </ol>
                                        <table class="table vm-upi-charges-table">
                                            <tr>
                                                <th colspan="2">Charges</th>
                                            </tr>
                                            <tr>
                                                <td>Minimum Fix Charge (In Rupees)</td>
                                                <td>@ViewBag.min&nbsp;₹</td>
                                            </tr>
                                            <tr>
                                                <td> Charges (In Precentage)</td>
                                                <td>@ViewBag.charge&nbsp;%</td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

            <div class="vm-ft-history-col">
                <div class="fund-trasfer-right vm-ft-history-panel">

                    <div id="tab-1" class="vm-ft-history-body">

                        <div class="vm-ft-history-toolbar vm-ft-history-toolbar--premium">
                            <div class="vm-ft-history-toolbar__head">
                                <i class="fas fa-history" aria-hidden="true"></i>
                                <div>
                                    <span class="vm-ft-history-toolbar__title">UPI History</span>
                                    <span class="vm-ft-history-toolbar__sub">View, filter &amp; export UPI transactions</span>
                                </div>
                                <span class="vm-radiant-record-badge" title="Total records" style="margin-left:auto;">
                                    Records: <strong id="upiRecordCount">@upiRowCount</strong>
                                </span>
                            </div>
                            @using (Html.BeginForm("UPITRANSFER", "Home", FormMethod.Post))
                            {
                                <div class="vm-ft-history-toolbar__filters vm-ft-history-filters-row">
                                    <div class="vm-dmt-filter-search-group vm-ft-date-search-group">
                                        <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                            <span class="saas-acc-dp-icon"><i class="fa fa-calendar" aria-hidden="true"></i></span>
                                            @Html.TextBox("txt_frm_date", "", new { @class = "form-control saas-acc-dp-input", autocomplete = "off", placeholder = "From", title = "From date" })
                                        </div>
                                        <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                            <span class="saas-acc-dp-icon"><i class="fa fa-calendar" aria-hidden="true"></i></span>
                                            @Html.TextBox("txt_to_date", "", new { @class = "form-control saas-acc-dp-input", autocomplete = "off", placeholder = "To", title = "To date" })
