<script>
    $('.third-design-dealer .third-design-table td').mouseenter(function () {
        var $tr = $(this).parent();
        if (!$tr.is('tr')) { return; }
        var colIndex = $tr.children().index($(this)) + 1;
        $tr.addClass('vm-upi-row-hover');
        $tr.closest('table').find("tr").children(":nth-child(" + colIndex + ")").addClass('vm-upi-col-hover');
    });
    $('.third-design-dealer .third-design-table td').mouseleave(function () {
        var $tr = $(this).parent();
        if (!$tr.is('tr')) { return; }
        var colIndex = $tr.children().index($(this)) + 1;
        $tr.removeClass('vm-upi-row-hover');
        $tr.closest('table').find("td:nth-child(" + colIndex + ")").removeClass('vm-upi-col-hover');
    });
</script>

