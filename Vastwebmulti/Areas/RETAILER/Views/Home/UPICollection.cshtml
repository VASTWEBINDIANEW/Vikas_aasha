<script>
    Verifynm = () => {
        var upiid = $('#txtupi_id').val();
        if (upiid != "") {
            $("#overlay").fadeIn(300);
            $.ajax({
                url: '@Url.Action("VerifyUPIID", "Home")',
                data: { upiid },
                cache: false,
                type: "POST",
                success: function (data) {
                    $("#overlay").fadeOut(300);
                    var name = data.name;
                    var Message = data.Message;
                    var sts = data.sts;
                    if (sts == true) {
                        $('#txtmsg').text('');
                        $('#txtupi_name').val(name);
                    }
                    else {
                        $('#txtmsg').text(Message);
                    }
                },
                error: function () {
                    $("#overlay").fadeOut(300);
                    $('#txtmsg').text('Something went wrong. Please try again.');
                }
            })
        }
        else {
            alert("Please Enter Valid UPIID")
        }
    }
