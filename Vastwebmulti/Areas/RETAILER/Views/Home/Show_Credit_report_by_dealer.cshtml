@model List<Vastwebmulti.Models.select_retailer_credit_report_by_dealer_Result>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "My Credit Report By Distributor";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";

    var reports = Model ?? new List<Vastwebmulti.Models.select_retailer_credit_report_by_dealer_Result>();
    var rowCount = reports.Count;
    decimal totalOutstanding = reports.Sum(a => a.cr);
    decimal totalLive = reports.Sum(a => a.remain_amount);
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=43" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=22" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<style>
    /* Desktop (>=1024px): fit-to-width, no scroll, tight columns */
    @@media (min-width: 1024px) {
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table {
            width: 100% !important;
            min-width: 0 !important;
            max-width: 100% !important;
            table-layout: fixed !important;
        }
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table thead tr,
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table tbody tr,
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table tfoot tr {
            display: table-row !important;
        }
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table thead th,
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table tbody td,
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table tfoot td {
            display: table-cell !important;
            min-width: 0 !important;
            max-width: none !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            white-space: nowrap !important;
        }
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table thead th:nth-child(1),
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table tbody td:nth-child(1),
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table tfoot td:nth-child(1) { width: 7% !important; }
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table thead th:nth-child(2),
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table tbody td:nth-child(2),
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table tfoot td:nth-child(2) { width: 20% !important; }
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table thead th:nth-child(3),
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table tbody td:nth-child(3),
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table tfoot td:nth-child(3) { width: 15% !important; }
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table thead th:nth-child(4),
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table tbody td:nth-child(4),
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table tfoot td:nth-child(4) { width: 15% !important; }
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table thead th:nth-child(5),
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table tbody td:nth-child(5),
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table tfoot td:nth-child(5) { width: 14% !important; }
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table thead th:nth-child(6),
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table tbody td:nth-child(6),
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table tfoot td:nth-child(6) { width: 14% !important; }
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table thead th:nth-child(7),
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table tbody td:nth-child(7),
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table tfoot td:nth-child(7) { width: 15% !important; }
    }
    /* Mobile + tablet (<=1023px): natural widths, full text, horizontal scroll */
    @@media (max-width: 1023.98px) {
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table {
            width: max-content !important;
            min-width: 820px !important;
            max-width: none !important;
            table-layout: auto !important;
        }
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table thead tr,
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table tbody tr,
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table tfoot tr {
            display: table-row !important;
        }
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table thead th,
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table tbody td,
        body.saas-admin-ui .saas-retailer-credit-page #retailerCreditReport.vm-opr-data-table tfoot td {
            display: table-cell !important;
            width: auto !important;
            min-width: 0 !important;
            max-width: none !important;
            white-space: nowrap !important;
            overflow: visible !important;
            text-overflow: clip !important;
        }
        body.saas-admin-ui .saas-retailer-credit-page .vm-opr-table-scroll {
            overflow-x: auto !important;
        }
    }
</style>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-retailer-ecomm-transaction-page saas-retailer-credit-page">

    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

            <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line">

                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home", new { area = "RETAILER" })"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>Reports</li>
                    <li>My Credit Report By Distributor</li>
                </ol>

            </div>

            <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="retailerCreditTotalsPanel" style="display:none;" aria-hidden="true">
                <div class="vm-dmt-totals-head">
                    <div class="vm-dmt-totals-head__title">
                        <i class="fas fa-chart-pie" aria-hidden="true"></i>
                        <span>Credit totals</span>
                    </div>
                    <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideRetailerCreditTotals()" title="Hide totals" aria-label="Hide totals">
                        <i class="fas fa-chevron-up" aria-hidden="true"></i>
                    </button>
                </div>
                <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                    <div class="vm-opr-total-card vm-opr-total-card--primary">
                        <span class="vm-opr-total-card__label">Total outstanding</span>
                        <strong class="vm-opr-total-card__value">&#8377; @totalOutstanding.ToString("N2")</strong>
                    </div>
                    <div class="vm-opr-total-card vm-opr-total-card--success">
                        <span class="vm-opr-total-card__label">Total live balance</span>
                        <strong class="vm-opr-total-card__value">&#8377; @totalLive.ToString("N2")</strong>
                    </div>
                    <div class="vm-opr-total-card vm-opr-total-card--pending">
                        <span class="vm-opr-total-card__label">Records</span>
                        <strong class="vm-opr-total-card__value">@rowCount</strong>
                    </div>
                </div>
            </div>

        </div>

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-hand-holding-usd" aria-hidden="true"></i>
                        <span>My credit report by distributor</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong>@rowCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total" title="Total current outstanding">
                            Outstanding: <strong>&#8377; @totalOutstanding.ToString("N2")</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-ecomm-totals-btn" onclick="showRetailerCreditTotals()" title="Show totals" aria-expanded="false" aria-controls="retailerCreditTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnExportRetailerCredit" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDFRetailerCredit" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="retailerCreditReport" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Sr.&nbsp;no</th>
                                    <th>Email</th>
                                    <th>Name</th>
                                    <th>Last&nbsp;txn&nbsp;date</th>
                                    <th>Last&nbsp;txn&nbsp;type</th>
                                    <th>Live&nbsp;balance&nbsp;&#8377;</th>
                                    <th>Outstanding&nbsp;&#8377;</th>
                                </tr>
                            </thead>
                            <tbody id="retailerCreditRows">
                                @if (reports.Count > 0)
                                {
                                    int sr = 1;
                                    foreach (var item in reports)
                                    {
                                        <tr class="vm-dmt-row">
                                            <td>
                                                <span class="vm-dmt-refno-text">@sr</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-refno-text">@item.DLMEmail</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-consumer-text">@item.DealerName</span>
                                            </td>
                                            <td class="vm-ticket-time-cell">
                                                <span class="vm-dmt-refno-text">@(item.RechargeDate.HasValue ? String.Format("{0:dd-MMM-yyyy HH:mm:ss}", item.RechargeDate.Value) : "—")</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-refno-text">@item.bal_type</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(item.remain_amount, 2)</span>
                                            </td>
                                            <td>
                                                <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(item.cr, 2)</span>
                                            </td>
                                        </tr>
                                        sr++;
                                    }
                                }
                                else
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="7" class="vm-opr-table-empty vm-dmt-table-empty">
                                            <i class="fas fa-hand-holding-usd" aria-hidden="true"></i>
                                            <span>No credit records found.</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            @if (reports.Count > 0)
                            {
                                <tfoot>
                                    <tr class="vm-dmt-row vm-dmt-total-row">
                                        <td colspan="5">
                                            <span class="vm-dmt-amount-text"><strong>Total</strong></span>
                                        </td>
                                        <td>
                                            <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> <strong>@totalLive.ToString("N2")</strong></span>
                                        </td>
                                        <td>
                                            <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> <strong>@totalOutstanding.ToString("N2")</strong></span>
                                        </td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section PostVmScripts {
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    function hideRetailerCreditTotals() {
        var $panel = jQuery('#retailerCreditTotalsPanel');
        var $btn = jQuery('.saas-retailer-credit-page .vm-ecomm-totals-btn');
        $panel.hide().attr('aria-hidden', 'true');
        $btn.attr('aria-expanded', 'false');
    }

    function showRetailerCreditTotals() {
        var $panel = jQuery('#retailerCreditTotalsPanel');
        var $btn = jQuery('.saas-retailer-credit-page .vm-ecomm-totals-btn');
        if ($panel.is(':visible')) {
            hideRetailerCreditTotals();
            return;
        }
        $panel.show().attr('aria-hidden', 'false');
        $btn.attr('aria-expanded', 'true');
    }

    function downloadRetailerCreditExcel() {
        var table = document.getElementById('retailerCreditReport');
        if (!table || !table.tBodies || !table.tBodies[0] || table.tBodies[0].rows.length === 0) {
            alert('No records to export.');
            return;
        }
        var html = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><meta charset="UTF-8"></head><body>' + table.outerHTML + '</body></html>';
        var blob = new Blob(['\ufeff' + html], { type: 'application/vnd.ms-excel' });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'Show_Credit_report_by_dealer.xls';
        document.body.appendChild(a);
        a.click();
        setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 100);
    }

    jQuery(function () {
        jQuery('#btnExportRetailerCredit').on('click', function (e) {
            e.preventDefault();
            downloadRetailerCreditExcel();
        });
        jQuery('#btnPDFRetailerCredit').on('click', function () {
            window.print();
        });
    });
</script>
}
