    @@media (max-width: 767px) {
        /* Detail modals stay centered cards on mobile (same treatment as dealer modal) */
        body.saas-admin-ui #m-d-fund-transfer12.vm-ft-detail-modal.in,
        body.saas-admin-ui #m-d-fund-transfer12.vm-ft-detail-modal.show,
        body.saas-admin-ui #ALLm-d-fund-transfer12.vm-ft-detail-modal.in,
        body.saas-admin-ui #ALLm-d-fund-transfer12.vm-ft-detail-modal.show {
            padding: 64px 10px 16px !important;
        }
        body.saas-admin-ui #m-d-fund-transfer12.vm-ft-detail-modal.in .modal-dialog,
        body.saas-admin-ui #m-d-fund-transfer12.vm-ft-detail-modal.show .modal-dialog,
        body.saas-admin-ui #ALLm-d-fund-transfer12.vm-ft-detail-modal.in .modal-dialog,
        body.saas-admin-ui #ALLm-d-fund-transfer12.vm-ft-detail-modal.show .modal-dialog {
            width: calc(100% - 12px) !important;
            max-width: calc(100% - 12px) !important;
            margin: 0 auto !important;
            float: none !important;
            height: auto !important;
            max-height: calc(100dvh - 80px) !important;
        }
        body.saas-admin-ui .saas-retailer-fund-transfer-page #tblshowMasterD table {
            min-width: 720px;
        }
        body.saas-admin-ui .saas-retailer-fund-transfer-page #btndistributorInform {
            width: 100% !important;
            float: none !important;
            margin-top: 12px !important;
        }
        body.saas-admin-ui .saas-retailer-fund-transfer-page .tab-menur ul {
            gap: 6px !important;
        }
        body.saas-admin-ui .saas-retailer-fund-transfer-page .tab-menur li a {
            font-size: 12px !important;
            padding: 10px 4px !important;
        }
    }
    @@media (max-width: 480px) {
        body.saas-admin-ui .saas-retailer-fund-transfer-page .tab-menur ul {
            flex-direction: column !important;
        }
