<style type="text/css">
    @@keyframes ldio-zdyd6mf6t5 {
        0% { top: 96px; left: 96px; width: 0; height: 0; opacity: 1; }
        100% { top: 18px; left: 18px; width: 156px; height: 156px; opacity: 0; }
    }
    .ldio-zdyd6mf6t5 div {
        position: absolute;
        border-width: 4px;
        border-style: solid;
        opacity: 1;
        border-radius: 50%;
        animation: ldio-zdyd6mf6t5 1s cubic-bezier(0,0.2,0.8,1) infinite;
    }
    .ldio-zdyd6mf6t5 div:nth-child(1) { border-color: #e90c59; }
    .ldio-zdyd6mf6t5 div:nth-child(2) { border-color: #46dff0; animation-delay: -0.5s; }
    .loadingio-spinner-ripple-92ar2pfqk5j {
        width: 200px;
        height: 200px;
        display: inline-block;
        overflow: hidden;
        background: transparent;
    }
    .ldio-zdyd6mf6t5 {
        width: 100%;
        height: 100%;
        position: relative;
        transform: translateZ(0) scale(1);
        backface-visibility: hidden;
        transform-origin: 0 0;
    }
    .ldio-zdyd6mf6t5 div { box-sizing: content-box; }
</style>

<style type="text/css">
    /* Purchase-request sub tabs (Request To Dealer / Admin) — latest pill design */
    body.saas-admin-ui .saas-retailer-fund-transfer-page .tab-menur {
        margin: 2px 0 4px;
    }
