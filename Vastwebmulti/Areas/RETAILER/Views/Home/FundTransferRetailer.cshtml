        flex: 1 1 0;
        width: auto;
        float: none;
        text-align: center;
    }
    body.saas-admin-ui .saas-retailer-fund-transfer-page .tab-menur li a {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
