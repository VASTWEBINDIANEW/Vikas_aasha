<script>
    function syncDealerLinkedNo(selectEl) {
        if (!selectEl || !selectEl.id) { return; }
        var map = { dealerbank: 'txtdealeraccountno', dealerwallets: 'txtdealerwalletno' };
        var inputId = map[selectEl.id];
        if (!inputId) { return; }
        var input = document.getElementById(inputId);
        if (!input) { return; }
        var val = (selectEl.value || '').trim();
        if (!val || val === '0' || val.toLowerCase().indexOf('select') >= 0) {
            input.value = '';
            return;
        }
        input.value = val;
    }
    $('#dealerbank').change(function () {
        syncDealerLinkedNo(this);
    })
    $('#dealerwallets').change(function () {
        syncDealerLinkedNo(this);
    })
    $(document).on('change.dealerLink select2:select.dealerLink', '#dealerbank, #dealerwallets', function () {
        syncDealerLinkedNo(this);
    })
</script>

