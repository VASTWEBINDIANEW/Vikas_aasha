@model IEnumerable<Vastwebmulti.Models.BankAccountForAep>
@{
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";
}
@* RP: Fund_transfer (ADMIN) wali latest design — wahi vm-ft-* CSS reuse + page CSS. IDs/OTP flow/handlers same, koi inline <style> nahi. *@
<link href="~/MainFrontDesign/css/admin-fund-transfer-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/retailer-addaeps-modern.css?v=4" rel="stylesheet" />

<section class="content saas-fund-transfer-page vm-aeps-page">
    <div class="container-fluid vm-ft-page-shell">

        <div class="vm-ft-page-toolbar vm-ft-page-toolbar--premium">
            <div class="vm-ft-page-hero vm-aeps-hero">
                <ol class="vm-ft-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>AEPS</li>
                    <li>Add Account</li>
                </ol>
                <div class="vm-aeps-title">
                    <h1 class="vm-ft-page-title">Add AEPS Bank Account</h1>
                    <p class="vm-ft-page-subtitle">Link a bank account for AEPS integration</p>
                </div>
            </div>
        </div>

        <div class="vm-ft-layout-wrap">
            <div class="row vm-ft-layout vm-ft-layout--full">
                <div class="vm-ft-form-col">
                    <div class="fund-trasfer-left vm-ft-form-card">
                        <div class="vm-ft-form-card-header">
                            <div class="vm-ft-form-card-header__icon" aria-hidden="true"><i class="fas fa-plus-circle"></i></div>
                            <div>
                                <span class="vm-ft-form-card-header__title">Add Bank Account For Aeps Integration</span>
                                <span class="vm-ft-form-card-header__sub">Fill details, verify with OTP</span>
                            </div>
                        </div>
                        <div class="fund-transfer-form">
                            @using (Html.BeginForm("AddAepsAccount", "Home", FormMethod.Post))
                            {
                                <div class="col-md-12 col-sm-12 col-xs-12">
                                    <label class="form-label" for="BankName">Bank Name</label>
                                    @Html.TextBox("BankName", Model.FirstOrDefault()?.BankName, new { @class = "form-control", @placeholder = "Enter Bank Name", @id = "BankName" })
                                </div>

                                <div class="col-md-12 col-sm-12 col-xs-12">
                                    <label class="form-label" for="accountno">Account Number</label>
                                    @Html.TextBox("accountno", Model.FirstOrDefault()?.AccountNO, new { @class = "form-control", @placeholder = "Enter Account Number", @id = "accountno" })
                                    <span id="accountnoError" class="text-danger"></span>
                                </div>

                                <div class="col-md-12 col-sm-12 col-xs-12">
                                    <label class="form-label" for="ifscCode">IFSC Code</label>
                                    @Html.TextBox("ifscCode", Model.FirstOrDefault()?.IFSC_CODE, new { @class = "form-control", @placeholder = "Enter IFSC Code", @id = "ifscCode" })
                                    <span id="ifscCodeError" class="text-danger"></span>
                                </div>

                                <div class="col-md-12 col-sm-12 col-xs-12">
                                    <label class="form-label" for="AccountHolderName">Account Holder Name</label>
                                    @Html.TextBox("AccountHolderName", Model.FirstOrDefault()?.AccountHolder, new { @class = "form-control", @placeholder = "Enter Account Holder Name", @id = "AccountHolderName" })
                                </div>

                                <div class="col-md-12 col-sm-12 col-xs-12">
                                    <label class="form-label" for="BankAddress">Bank Address</label>
                                    @Html.TextBox("BankAddress", Model.FirstOrDefault()?.BankAddress, new { @class = "form-control", @placeholder = "Enter Bank Address", @id = "BankAddress" })
                                </div>

                                <div class="col-md-12 col-sm-12 col-xs-12 vm-aeps-otp" id="OTPShow" style="display: none;">
                                    <label class="form-label" for="OTP">OTP</label>
                                    @Html.TextBox("OTP", null, new { @class = "form-control", @placeholder = "Enter OTP", @id = "OTP" })
                                </div>

                                <div class="col-md-12 col-sm-12 col-xs-12">
                                    <p class="vm-aeps-msg">@ViewBag.message</p>
                                    <button id="SubmitBankDetails" type="submit" class="vm-aeps-btn vm-aeps-btn--go" style="display: none;"><i class="fas fa-check" aria-hidden="true"></i> Submit</button>
                                </div>
                            }
                            <div class="col-md-12 col-sm-12 col-xs-12">
                                <button class="vm-aeps-btn vm-aeps-btn--go" id="ShowOtpBox" onclick="validateForm()"><i class="fas fa-paper-plane" aria-hidden="true"></i> Send Otp</button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="vm-ft-history-col">
                    <div class="fund-trasfer-left vm-ft-form-card">
                        <div class="vm-ft-form-card-header">
                            <div class="vm-ft-form-card-header__icon" aria-hidden="true"><i class="fas fa-list-check"></i></div>
                            <div>
                                <span class="vm-ft-form-card-header__title">Added Bank Account For Aeps</span>
                                <span class="vm-ft-form-card-header__sub">List of added accounts</span>
                            </div>
                        </div>
                        <div class="vm-ft-table-wrap">
                            <table class="vm-aeps-table">
                                <thead>
                                    <tr>
                                        <th>Bank Name</th>
                                        <th>Account Number</th>
                                        <th>IFSC Code</th>
                                        <th>Account Holder</th>
                                        <th>Bank Address</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (Model.Count() > 0)
                                    {
                                        foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>@item.BankName</td>
                                                <td>@item.AccountNO</td>
                                                <td>@item.IFSC_CODE</td>
                                                <td>@item.AccountHolder</td>
                                                <td>@item.BankAddress</td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" class="vm-aeps-empty">Account Not Add Yet!</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>
<div id="Account_Loder" class="Account_Loder" style="display: none;">
    <div id="loadredmodel" style="display:block;">
        <div style="position: absolute;top: 50%;left: 50%;transform: translate(-50%,-50%);" class="loadingio-spinner-ripple-92ar2pfqk5j">
            <div class="ldio-zdyd6mf6t5">
                <div></div><div></div>
            </div>
        </div>
    </div>
</div>
<script>
    function validateForm() {
        const accountno = document.getElementById("accountno").value.trim();
        const ifscCode = document.getElementById("ifscCode").value.trim();

        const accountnoError = document.getElementById("accountnoError");
        const ifscCodeError = document.getElementById("ifscCodeError");

        accountnoError.innerText = "";
        ifscCodeError.innerText = "";

        let isValid = true;
        if (accountno === "") {
            accountnoError.innerText = "Account Number is required.";
            isValid = false;
        } else if (!/^\d+$/.test(accountno)) {
            accountnoError.innerText = "Account Number must be numeric.";
            isValid = false;
        }
        if (ifscCode === "") {
            ifscCodeError.innerText = "IFSC Code is required.";
            isValid = false;
        } else if (ifscCode.length !== 11) {
            ifscCodeError.innerText = "IFSC Code must be 11 characters long.";
            isValid = false;
        }
        if (isValid) {
            document.getElementById('Account_Loder').style.display = 'block';
            $.ajax({
                url: '@Url.Action("SentBankOtp", "Home")',
                type: 'POST',
                success: function () {
                    document.getElementById('OTPShow').style.display = 'block';
                    document.getElementById('ShowOtpBox').style.display = 'none';
                    document.getElementById('SubmitBankDetails').style.display = 'block';
                    document.getElementById('Account_Loder').style.display = 'none';

                }
            })
        }
    }
</script>
