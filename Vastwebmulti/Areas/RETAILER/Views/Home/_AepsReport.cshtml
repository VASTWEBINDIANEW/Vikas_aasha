@model IEnumerable<Vastwebmulti.Models.Aeps_Report_New_Result>
@{
    Layout = null;
}
@if (Model != null && Model.Count() > 0)
{
    foreach (var item in Model)
    {
        var upper = (item.Status ?? "").ToUpper();

        var tone = "pending";
        var toneFa = "fa-clock-o";
        var normStatus = "PENDING";
        var label = item.Status;

        if (upper.Contains("SUCCESS") && !upper.Contains("FAILED"))
        {
            tone = "success"; toneFa = "fa-check"; normStatus = "SUCCESS"; label = "Success";
        }
        else if (upper.Contains("FAILED") || upper.Contains("REFUND"))
        {
            tone = "failed"; toneFa = "fa-times"; normStatus = "FAILED";
            label = upper.Contains("REFUND") ? "Refund" : "Failed";
        }
        else if (upper.Contains("PENDING"))
        {
            tone = "pending"; toneFa = "fa-clock-o"; normStatus = "PENDING"; label = "Pending";
        }

        var txnType = (item.Type ?? "").Trim();
        if (string.IsNullOrEmpty(txnType))
        {
            if (upper.Contains("M_"))
            {
                txnType = "Mini Statement";
            }
            else if (upper.Contains("BALANCE"))
            {
                txnType = "Balance Enquiry";
            }
            else
            {
                txnType = "Cash Withdrawal";
            }
        }

        string maskedAadhaar = "";
        if (!string.IsNullOrEmpty(item.AccountHolderAadhaar) && item.AccountHolderAadhaar.Length >= 4)
        {
            var lastPart = item.AccountHolderAadhaar.Substring(item.AccountHolderAadhaar.Length - 4, 4);
            maskedAadhaar = "XXXXX" + lastPart;
        }

        decimal usercredit = 0;
        try
        {
            if (item.Role == "Retailer")
            {
                usercredit = Convert.ToDecimal(item.Amount) + Convert.ToDecimal(item.RemIncome);
            }
        }
        catch { }

        var rrnOrError = item.Status != null && item.Status.ToUpper() == "SUCCESS" ? (item.BankRRN ?? "") : (item.Remark ?? "");

        <tr class="vm-dmt-row vm-dmt-row--@tone" data-amount="@item.Amount" data-status="@normStatus">
            <td class="vm-dmt-sr-cell"></td>
            <td>
                <span class="vm-dmt-status vm-dmt-status--@tone" title="@item.Status"><i class="fa @toneFa" aria-hidden="true"></i></span>
                <span class="vm-dmt-txntype">@txnType</span>
            </td>
            <td>@item.BankName</td>
            <td>@item.customerremain</td>
            <td>@maskedAadhaar</td>
            <td>@item.Mobile</td>
            <td>@item.username</td>
            <td class="vm-dmt-amt-cell">@String.Format("{0:0.00#}", item.Amount)</td>
            <td>@item.charge</td>
            <td class="vm-dmt-amt-cell">@item.RemIncome</td>
            <td>@item.RemGST</td>
            <td>0</td>
            <td class="vm-dmt-amt-cell">@String.Format("{0:0.00#}", item.RemPre)</td>
            <td class="vm-dmt-amt-cell">@String.Format("{0:0.00#}", usercredit)</td>
            <td class="vm-dmt-amt-cell">@String.Format("{0:0.00#}", item.RemPost)</td>
            <td>@rrnOrError</td>
            <td>@String.Format("{0:dd-MMM HH:mm:ss}", item.Txn_Date)</td>
            <td class="vm-dmt-action-cell">
                <div class="vm-dmt-action-bar">
                    <a href="@Url.Action("Aeps_print", "Home", new { id = item.MerchantTxnId })" target="_blank" class="vm-dmt-act-btn" title="Print receipt"><i class="material-icons">print</i></a>
                </div>
            </td>
        </tr>
    }
}
else
{
    <tr class="vm-opr-table-empty-row">
        <td colspan="18" class="vm-opr-table-empty vm-dmt-table-empty">
            <div class="vm-opr-empty-state">
                <i class="fas fa-inbox" aria-hidden="true"></i>
                <h3>
                    @if (ViewBag.checkdata != null)
                    {
                        <text>No data for current search</text>
                    }
                    else
                    {
                        <text>Data not found</text>
                    }
                </h3>
                <p>Try a different date range or filter.</p>
            </div>
        </td>
    </tr>
}
