@model List<Vastwebmulti.Models.money_transfer_report_paging_Result>
@{
    Layout = null;
}
@if (Model != null && Model.Count > 0)
{
    foreach (var item in Model)
    {
        var upper = (item.status ?? "").ToUpper();
        if (upper.Contains("RESEND"))
        {
            continue;
        }

        var tone = "pending";
        var toneFa = "fa-clock-o";
        var normStatus = "PENDING";
        var label = item.status;

        if (upper.Contains("FAILED TO SUCCESS") || upper == "SUCCESS")
        {
            tone = "success"; toneFa = "fa-check"; normStatus = "SUCCESS"; label = "Success";
        }
        else if (upper.Contains("SUCCESS TO FAILED") || upper == "FAILED" || upper.Contains("REFUND"))
        {
            tone = "failed"; toneFa = "fa-times"; normStatus = "FAILED";
            label = upper.Contains("REFUND") ? item.status : "Failed";
        }
        else if (upper.Contains("PENDING"))
        {
            tone = "pending"; toneFa = "fa-clock-o"; normStatus = "PENDING"; label = "Pending";
        }

        decimal amount = 0;
        decimal debit = 0;
        try
        {
            if ((item.Trans_type ?? "").Contains("IMPS_VERIFY"))
            {
                amount = Convert.ToDecimal(item.amount);
                debit = Convert.ToDecimal(item.rem_comm);
            }
            else
            {
                amount = Convert.ToDecimal(item.amount);
                debit = amount + Convert.ToDecimal(item.rem_comm);
            }
        }
        catch { }

        var showDmtView = (item.DmtType == "DMT2" || item.DmtType == "DMT1") && upper.Contains("PENDING")
            && (item.Trans_type == "IMPS" || item.Trans_type == "NEFT" || item.Trans_type == "UPI");
        var showPrint = (upper == "SUCCESS" || upper.Contains("FAILED TO SUCCESS"));

        <tr class="vm-dmt-row vm-dmt-row--@tone" data-amount="@item.amount" data-status="@normStatus">
            <td class="vm-dmt-sr-cell"></td>
            <td class="vm-dmt-status-cell">
                <span class="vm-dmt-status-cell-inner">
                    <span class="vm-dmt-status vm-dmt-status--@tone" title="@item.status"><i class="fa @toneFa" aria-hidden="true"></i><em>@label</em></span>
                    <small class="vm-dmt-type-chip">@item.Trans_type</small>
                </span>
            </td>
            <td><strong class="vm-dmt-strong" title="@item.senderno">@item.senderno</strong></td>
            <td><span class="vm-dmt-ellipsis" title="@item.accountno">@item.accountno</span></td>
            <td><span class="vm-dmt-ellipsis vm-dmt-ellipsis--name" title="@item.recivername">@item.recivername</span></td>
            <td class="vm-dmt-amt-cell">@item.amount</td>
            <td class="vm-dmt-amt-cell">@item.rem_comm</td>
            <td class="vm-dmt-amt-cell">@debit</td>
            <td class="vm-dmt-amt-cell">@item.user_remain_pre</td>
            <td class="vm-dmt-amt-cell">@item.user_remain</td>
            <td class="vm-ticket-time-cell"><span class="vm-dmt-time-chip">@String.Format("{0:dd-MMM HH:mm:ss}", item.trans_time)</span></td>
            <td class="vm-ticket-time-cell"><span class="vm-dmt-time-chip">@String.Format("{0:dd-MMM HH:mm:ss}", item.response_time)</span></td>
            <td><span class="vm-dmt-ellipsis vm-dmt-ellipsis--utr" title="@item.bank_trans_id">@item.bank_trans_id</span></td>
            <td class="vm-dmt-action-cell">
                <div class="vm-dmt-action-bar">
                    @if (item.DmtType == "DMTN" && upper == "PENDING")
                    {
                        <button type="button" class="saas-acc-btn saas-acc-btn--search" style="min-height:32px;padding:0 10px;font-size:11px;" onclick="Refund('@item.trans_id')">Refund</button>
                    }
                    @if (item.DmtType == "DMTPPI" && upper == "PENDING")
                    {
                        <button type="button" class="saas-acc-btn saas-acc-btn--search" style="min-height:32px;padding:0 10px;font-size:11px;" onclick="RefundPPI('@item.trans_id')">Refund</button>
                    }
                </div>
            </td>
            <td class="vm-dmt-action-cell">
                <div class="vm-dmt-action-bar">
                    @if (showPrint)
                    {
                        <button type="button" class="vm-dmt-act-btn" title="Print receipt" onclick="GotoPDF('@item.trans_common_id')"><i class="material-icons">print</i></button>
                    }
                    @if (showDmtView)
                    {
                        if (item.DmtType == "DMT2")
                        {
                            <button type="button" class="vm-dmt-act-btn" title="View status" onclick="GotoView('@item.trans_id')"><i class="material-icons">visibility</i></button>
                        }
                        else
                        {
                            <button type="button" class="vm-dmt-act-btn" title="View status" onclick="GotoViewDMT1('@item.trans_id')"><i class="material-icons">visibility</i></button>
                        }
                    }
                </div>
            </td>
        </tr>
    }
}
else
{
    <tr class="vm-opr-table-empty-row">
        @if (ViewBag.checkdata != null)
        {
            <td colspan="15" class="vm-opr-table-empty vm-dmt-table-empty">
                <i class="fas fa-exchange-alt" aria-hidden="true"></i>
                <span>No data for current search.</span>
            </td>
        }
        else
        {
            <td colspan="15" class="vm-opr-table-empty vm-dmt-table-empty">
                <i class="fas fa-exchange-alt" aria-hidden="true"></i>
                <span>Data not found.</span>
            </td>
        }
    </tr>
}
