@model IEnumerable<Vastwebmulti.Models.Login_info>
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "WebLogin";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
    var reports = Model != null ? Model.ToList() : new List<Vastwebmulti.Models.Login_info>();
    var rowCount = reports.Count;
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=43" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=22" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<style>
    /* Login tabs : beech me; dates+Search bilkul right side */
    .saas-retailer-weblogin-page .vm-opr-toolbar-head { flex-wrap: wrap !important; }
    .saas-retailer-weblogin-page .vm-login-tabs { display: inline-flex !important; flex-wrap: nowrap !important; width: max-content !important; max-width: 100% !important; flex: 0 0 auto !important; gap: 8px !important; background: #eef1f6 !important; border-radius: 12px !important; padding: 4px !important; margin: 0 12px 0 auto !important; align-self: center !important; }
    .saas-retailer-weblogin-page .vm-login-tabs .vm-login-tab { display: inline-flex !important; width: auto !important; flex: 0 0 auto !important; float: none !important; white-space: nowrap !important; }
    .saas-retailer-weblogin-page .saas-acc-filter-bar { margin-left: 0 !important; }
    .saas-retailer-weblogin-page .vm-login-tab { display: inline-flex !important; align-items: center !important; gap: 7px !important; padding: 8px 18px !important; border-radius: 9px !important; font-size: 13px !important; font-weight: 800 !important; color: #64748b !important; text-decoration: none !important; transition: all .15s ease !important; white-space: nowrap !important; }
    .saas-retailer-weblogin-page .vm-login-tab:hover { color: #0f172a !important; }
    .saas-retailer-weblogin-page .vm-login-tab--active { background: #fff !important; color: #1d4ed8 !important; box-shadow: 0 2px 8px rgba(15,23,42,.12) !important; }
    /* Status pill */
    body.saas-admin-ui .saas-retailer-weblogin-page #retailerWebLoginReport tbody tr:hover { background: #f6f9ff !important; }
    body.saas-admin-ui .saas-retailer-weblogin-page .vm-login-status { display: inline-flex !important; align-items: center; gap: 6px; font-size: 11.5px; font-weight: 800; padding: 4px 12px; border-radius: 999px; white-space: nowrap; background: #e7f7ee !important; color: #15803d !important; }
    body.saas-admin-ui .saas-retailer-weblogin-page .vm-login-ip { font-family: Consolas,'Courier New',monospace !important; font-size: 12px !important; }
    /* Desktop (>=1024px): fit-to-width, no scroll, tight columns */
    @@media (min-width: 1024px) {
        body.saas-admin-ui .saas-retailer-weblogin-page #retailerWebLoginReport.vm-opr-data-table {
            width: 100% !important;
            min-width: 0 !important;
            max-width: 100% !important;
            table-layout: fixed !important;
        }
        body.saas-admin-ui .saas-retailer-weblogin-page #retailerWebLoginReport.vm-opr-data-table thead tr,
        body.saas-admin-ui .saas-retailer-weblogin-page #retailerWebLoginReport.vm-opr-data-table tbody tr {
            display: table-row !important;
        }
        body.saas-admin-ui .saas-retailer-weblogin-page #retailerWebLoginReport.vm-opr-data-table thead th,
        body.saas-admin-ui .saas-retailer-weblogin-page #retailerWebLoginReport.vm-opr-data-table tbody td {
            display: table-cell !important;
            min-width: 0 !important;
            max-width: none !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            white-space: nowrap !important;
        }
        body.saas-admin-ui .saas-retailer-weblogin-page #retailerWebLoginReport.vm-opr-data-table thead th:nth-child(1),
        body.saas-admin-ui .saas-retailer-weblogin-page #retailerWebLoginReport.vm-opr-data-table tbody td:nth-child(1) { width: 12% !important; }
        body.saas-admin-ui .saas-retailer-weblogin-page #retailerWebLoginReport.vm-opr-data-table thead th:nth-child(2),
        body.saas-admin-ui .saas-retailer-weblogin-page #retailerWebLoginReport.vm-opr-data-table tbody td:nth-child(2) { width: 17% !important; }
        body.saas-admin-ui .saas-retailer-weblogin-page #retailerWebLoginReport.vm-opr-data-table thead th:nth-child(3),
        body.saas-admin-ui .saas-retailer-weblogin-page #retailerWebLoginReport.vm-opr-data-table tbody td:nth-child(3) { width: 14% !important; }
        body.saas-admin-ui .saas-retailer-weblogin-page #retailerWebLoginReport.vm-opr-data-table thead th:nth-child(4),
        body.saas-admin-ui .saas-retailer-weblogin-page #retailerWebLoginReport.vm-opr-data-table tbody td:nth-child(4) { width: 17% !important; }
        body.saas-admin-ui .saas-retailer-weblogin-page #retailerWebLoginReport.vm-opr-data-table thead th:nth-child(5),
        body.saas-admin-ui .saas-retailer-weblogin-page #retailerWebLoginReport.vm-opr-data-table tbody td:nth-child(5) { width: 9% !important; }
        body.saas-admin-ui .saas-retailer-weblogin-page #retailerWebLoginReport.vm-opr-data-table thead th:nth-child(6),
        body.saas-admin-ui .saas-retailer-weblogin-page #retailerWebLoginReport.vm-opr-data-table tbody td:nth-child(6) { width: 9% !important; }
        body.saas-admin-ui .saas-retailer-weblogin-page #retailerWebLoginReport.vm-opr-data-table thead th:nth-child(7),
        body.saas-admin-ui .saas-retailer-weblogin-page #retailerWebLoginReport.vm-opr-data-table tbody td:nth-child(7) { width: 22% !important; }
    }
    /* Mobile + tablet (<=1023px): natural widths, full text, horizontal scroll */
    @@media (max-width: 1023.98px) {
        body.saas-admin-ui .saas-retailer-weblogin-page #retailerWebLoginReport.vm-opr-data-table {
            width: max-content !important;
            min-width: 950px !important;
            max-width: none !important;
            table-layout: auto !important;
        }
        body.saas-admin-ui .saas-retailer-weblogin-page #retailerWebLoginReport.vm-opr-data-table thead tr,
        body.saas-admin-ui .saas-retailer-weblogin-page #retailerWebLoginReport.vm-opr-data-table tbody tr {
            display: table-row !important;
        }
        body.saas-admin-ui .saas-retailer-weblogin-page #retailerWebLoginReport.vm-opr-data-table thead th,
        body.saas-admin-ui .saas-retailer-weblogin-page #retailerWebLoginReport.vm-opr-data-table tbody td {
            display: table-cell !important;
            width: auto !important;
            min-width: 0 !important;
            max-width: none !important;
            white-space: nowrap !important;
            overflow: visible !important;
            text-overflow: clip !important;
        }
        body.saas-admin-ui .saas-retailer-weblogin-page .vm-opr-table-scroll {
            overflow-x: auto !important;
        }
    }
</style>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-retailer-ecomm-transaction-page saas-retailer-weblogin-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var loginFormAttrs = new Dictionary<string, object>
            {
                { "id", "retailerWebLoginForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-report-date-form", "" },
                { "data-report-from", "#retailer_weblogin_frm_date" },
                { "data-report-to", "#retailer_weblogin_to_date" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("WebLogin", "Home", FormMethod.Post, loginFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home", new { area = "RETAILER" })"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>My Account</li>
                        <li>Web Login History</li>
                    </ol>

                    <div class="vm-login-tabs" role="tablist">
                        <a class="vm-login-tab vm-login-tab--active" href="@Url.Action("WebLogin", "Home")"><i class="fas fa-globe" aria-hidden="true"></i> Web Login History</a>
                        <a class="vm-login-tab" href="@Url.Action("WebLoginFailed", "Home")" title="Go to App Login History"><i class="fas fa-mobile-alt" aria-hidden="true"></i> App Login History</a>
                    </div>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters vm-ecomm-filter-row--one-line">

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_weblogin_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_weblogin_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-history" aria-hidden="true"></i>
                        <span>Web login history</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong>@rowCount</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" id="btnExportRetailerWebLogin" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDFRetailerWebLogin" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="retailerWebLoginReport" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Login Status</th>
                                    <th>Login Id Details</th>
                                    <th>IP Address</th>
                                    <th>Browser</th>
                                    <th>Latitude</th>
                                    <th>Longitude</th>
                                    <th>Login Date Time</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (reports.Count > 0)
                                {
                                    foreach (var item in reports)
                                    {
                                        <tr class="vm-dmt-row">
                                            <td><span class="vm-login-status"><i class="fa fa-check" aria-hidden="true"></i>Success</span></td>
                                            <td><span class="vm-dmt-consumer-text" title="@item.UserId">@item.UserId</span></td>
                                            <td><span class="vm-dmt-refno-text vm-login-ip">@item.IP_Address</span></td>
                                            <td><span class="vm-dmt-refno-text" title="@item.browser">@item.browser</span></td>
                                            <td><span class="vm-dmt-refno-text">@item.Latitude</span></td>
                                            <td><span class="vm-dmt-refno-text">@item.Logitude</span></td>
                                            <td class="vm-ticket-time-cell"><span class="vm-dmt-refno-text">@item.CurrentLoginTime</span></td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="7" class="vm-opr-table-empty vm-dmt-table-empty">
                                            <i class="fas fa-history" aria-hidden="true"></i>
                                            <span>No login records found.</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section PostVmScripts {
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    function retailerWebLoginDates() {
        return {
            txt_frm_date: jQuery('#retailer_weblogin_frm_date').val() || '',
            txt_to_date: jQuery('#retailer_weblogin_to_date').val() || ''
        };
    }

    function initRetailerWebLoginDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initRetailerWebLoginDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm(
                '#retailerWebLoginForm',
                '#retailer_weblogin_frm_date',
                '#retailer_weblogin_to_date',
                true
            );
        }
    }

    jQuery(function () {
        initRetailerWebLoginDatepickers();
        window.setTimeout(initRetailerWebLoginDatepickers, 150);
        jQuery('#btnExportRetailerWebLogin').on('click', function (e) {
            e.preventDefault();
            var d = retailerWebLoginDates();
            location.href = '@Url.Action("ExcelWebLogin", "Home")?txt_frm_date=' + encodeURIComponent(d.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(d.txt_to_date);
        });
        jQuery('#btnPDFRetailerWebLogin').on('click', function () {
            var d = retailerWebLoginDates();
            window.open('@Url.Action("PDF_WebLogin", "Home")?txt_frm_date=' + encodeURIComponent(d.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(d.txt_to_date), '_blank');
        });
    });
</script>
}
