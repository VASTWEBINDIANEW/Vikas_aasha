@section PostVmScripts {
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    var retailerDmtPageIndex = 2;
    var retailerDmtNoMore = false;
    var retailerDmtBusy = false;

    function isNumber(evt) {
        var iKeyCode = (evt.which) ? evt.which : evt.keyCode;
        if (iKeyCode != 45 && iKeyCode > 31 && (iKeyCode < 48 || iKeyCode > 57)) {
            return false;
        }
        return true;
    }

    function retailerDmtFilters() {
        return {
            txt_frm_date: jQuery('#retailer_dmt_frm_date').val() || '',
            txt_to_date: jQuery('#retailer_dmt_to_date').val() || '',
            ddl_status: jQuery('#ddl_status').val() || 'ALL',
            ddl_Type: jQuery('#ddl_Type').val() || 'ALL',
            txtnumberfind: jQuery('#retailerDmtNumberfind').val() || ''
        };
    }

    function renumberRetailerDmtSr() {
        jQuery('#retailerDmtRows tr.vm-dmt-row').each(function (i) {
            jQuery(this).find('.vm-dmt-sr-cell').first().text(i + 1);
        });
    }

    function hideRetailerDmtTotals() {
        var $panel = jQuery('#retailerDmtTotalsPanel');
        var $btn = jQuery('.vm-dmt-totals-btn');
        $panel.removeClass('is-open').hide().attr('aria-hidden', 'true');
        $btn.removeClass('is-active').attr({ title: 'Show totals', 'aria-expanded': 'false' });
    }

    function FindtotalRetailerDmt() {
        var $panel = jQuery('#retailerDmtTotalsPanel');
        var $btn = jQuery('.vm-dmt-totals-btn');
        if ($panel.hasClass('is-open')) {
            hideRetailerDmtTotals();
            return;
        }
        $panel.addClass('is-open').show().attr('aria-hidden', 'false');
        $btn.addClass('is-active').attr({ title: 'Hide totals', 'aria-expanded': 'true' });
        var f = retailerDmtFilters();
        jQuery.ajax({
            url: '@Url.Action("FindCurrentTotal")',
            type: 'GET',
            data: { txt_frm_date: f.txt_frm_date, txt_to_date: f.txt_to_date, ddl_status: f.ddl_status, ddl_Type: f.ddl_Type },
            success: function (data) {
                jQuery('#retailerDmtSuccess').html('&#8377; ' + data.success);
                jQuery('#retailerDmtFailed').html('&#8377; ' + data.failed);
                jQuery('#retailerDmtPending').html('&#8377; ' + data.pending);
            }
        });
    }

    function GotoPDF(e) {
        var url = '@Url.Action("IMPSPDF", "Home")?Idno=' + e.toString();
        window.open(url, '_blank');
    }

    function GotoView(idno) {
        jQuery.ajax({
            url: '@Url.Action("viewsearch", "Home")', type: 'Post', dataType: 'json', cache: false, data: { idno: idno },
            success: function (result) {
                var resp = result.split('~');
                var output = resp[0];
                jQuery('#TID').val(resp[1]);
                if (output == 'RefundPending') { jQuery('#myModal').modal('show'); }
                else if (output == 'Success') { swal({ title: 'Response !', text: 'Money Transfer Success.', type: 'success' }, function () { location.reload(); }); }
                else if (output == 'Failed' || output == 'Refunded') { swal({ title: 'Response !', text: 'Money Transfer Failed.', type: 'error' }, function () { location.reload(); }); }
                else if (output == 'Pending') { swal({ title: 'Response !', text: 'Money Transfer Pending.', type: 'warning' }, function () { }); }
            }
        });
    }

    function GotoViewDMT1(idno) {
        jQuery.ajax({
            url: '@Url.Action("viewsearchDMT1", "Home")', type: 'Post', dataType: 'json', cache: false, data: { idno: idno },
            success: function (result) {
                var resp = result.split('~');
                var output = resp[0];
                jQuery('#TID').val(resp[1]);
                if (output == 'RefundPending') { jQuery('#myModal').modal('show'); }
                else if (output == 'Success') { swal({ title: 'Response !', text: 'Money Transfer Success.', type: 'success' }, function () { location.reload(); }); }
                else if (output == 'Failed' || output == 'Refunded') { swal({ title: 'Response !', text: 'Money Transfer Failed.', type: 'error' }, function () { location.reload(); }); }
                else if (output == 'Pending') { swal({ title: 'Response !', text: 'Money Transfer Pending.', type: 'warning' }, function () { }); }
            }
        });
    }

    function GotoViewold(idno) {
        jQuery.ajax({
            url: '@Url.Action("viewsearchold", "Home")', type: 'Post', dataType: 'json', cache: false, data: { idno: idno },
            success: function (result) {
                var resp = result.split('~');
                var output = resp[0];
                jQuery('#TIDold').val(resp[1]);
                if (output == 'RefundPending') { jQuery('#myModalold').modal('show'); }
                else if (output == 'Success') { swal({ title: 'Response !', text: 'Money Transfer Success.', type: 'success' }, function () { location.reload(); }); }
                else if (output == 'Failed' || output == 'Refunded') { swal({ title: 'Response !', text: 'Money Transfer Failed.', type: 'error' }, function () { location.reload(); }); }
                else if (output == 'Pending') { swal({ title: 'Response !', text: 'Money Transfer Pending.', type: 'warning' }, function () { }); }
            }
        });
    }

    function GotoViewoldDMT1(idno) {
        jQuery.ajax({
            url: '@Url.Action("viewsearcholdDMT1", "Home")', type: 'Post', dataType: 'json', cache: false, data: { idno: idno },
            success: function (result) {
                var resp = result.split('~');
                var output = resp[0];
                jQuery('#TIDold').val(resp[1]);
                if (output == 'RefundPending') { jQuery('#myModal').modal('show'); }
                else if (output == 'Success') { swal({ title: 'Response !', text: 'Money Transfer Success.', type: 'success' }, function () { location.reload(); }); }
                else if (output == 'Failed' || output == 'Refunded') { swal({ title: 'Response !', text: 'Money Transfer Failed.', type: 'error' }, function () { location.reload(); }); }
                else if (output == 'Pending') { swal({ title: 'Response !', text: 'Money Transfer Pending.', type: 'warning' }, function () { }); }
            }
        });
    }

    function Submit() {
        var tid = jQuery('#TID').val();
        var otp = jQuery('#name').val();
        jQuery.ajax({
            url: '@Url.Action("Refund", "Home")', type: 'Post', dataType: 'json', cache: false, data: { tid: tid, otp: otp },
            success: function (result) {
                swal('Response ! ', result, 'success');
                if (result != 'Wrong TID or OTP') { jQuery('#myModal').modal('hide'); }
            }
        });
    }

    function Submitold() {
        var tid = jQuery('#TIDold').val();
        var otp = jQuery('#nameold').val();
        jQuery.ajax({
            url: '@Url.Action("Refundold", "Home")', type: 'Post', dataType: 'json', cache: false, data: { tid: tid, otp: otp },
            success: function (result) {
                swal('Response ! ', result, 'success');
                if (result != 'Wrong TID or OTP') { jQuery('#myModalold').modal('hide'); }
            }
        });
    }

    function Resendotp() {
        var tid = jQuery('#TID').val();
        jQuery.ajax({
            url: '@Url.Action("ResendDMT", "Home")', type: 'Post', dataType: 'json', cache: false, data: { tid: tid },
            success: function (result) { swal('Response ! ', result, 'success'); }
        });
    }

    function Resendotpold() {
        var tid = jQuery('#TIDold').val();
        jQuery.ajax({
            url: '@Url.Action("ResendDMT", "Home")', type: 'Post', dataType: 'json', cache: false, data: { tid: tid },
            success: function (result) { swal('Response ! ', result, 'success'); }
        });
    }

    Submitinfo = function () {
        var txnid = jQuery('#hidetxnid').val();
        var otp = jQuery('#txtotpinfo').val();
        jQuery.ajax({
            url: '@Url.Action("PaysprintVerifyOTP", "Home")', type: 'Post', dataType: 'json', cache: false,
            data: { txnid: txnid, otp: otp },
            success: function (result) { alert(result.message); location.reload(); }
        });
    };

    SubmitinfoPPI = function () {
        var txnid = jQuery('#hidetxnidPPI').val();
        var otp = jQuery('#txtotpinfoPPI').val();
        var stateresp = jQuery('#hidestateresp').val();
        jQuery.ajax({
            url: '@Url.Action("PaysprintVerifyOTPPPI", "Home")', type: 'Post', dataType: 'json', cache: false,
            data: { txnid: txnid, otp: otp, stateresp: stateresp },
            success: function (result) { alert(result.message); location.reload(); }
        });
    };

    Refund = function (transid) {
        jQuery.ajax({
            url: '@Url.Action("PaysprintRefundOTP", "Home")', type: 'Post', dataType: 'json', cache: false, data: { txnid: transid },
            success: function (result) {
                if (result.status) { jQuery('#myModalRefund').modal('show'); jQuery('#hidetxnid').val(transid); }
                else { alert(result.message); }
            }
        });
    };

    RefundPPI = function (transid) {
        jQuery.ajax({
            url: '@Url.Action("PaysprintRefundOTPPPI", "Home")', type: 'Post', dataType: 'json', cache: false, data: { txnid: transid },
            success: function (result) {
                if (result.status == true) {
                    jQuery('#myModalRefundPPI').modal('show');
                    jQuery('#hidetxnidPPI').val(transid);
                    jQuery('#hidestateresp').val(result.data.stateresp);
                }
                else { alert(result.message); }
            }
        });
    };

    function initRetailerDmtSelect2() {
        jQuery('#ddl_status, #ddl_Type').each(function () {
            var $el = jQuery(this);
            if (!$el.length || !jQuery.fn.select2) { return; }
            if ($el.hasClass('select2-hidden-accessible')) {
                try { $el.select2('destroy'); } catch (e) { }
            }
            $el.select2({ width: '100%', minimumResultsForSearch: 6 });
        });
    }

    function initRetailerDmtDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initRetailerDmtDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm(
                '#retailerDmtReportForm',
                '#retailer_dmt_frm_date',
                '#retailer_dmt_to_date',
                true
            );
        }
    }

    jQuery(function () {
        initRetailerDmtSelect2();
        initRetailerDmtDatepickers();
        window.setTimeout(initRetailerDmtDatepickers, 150);
        renumberRetailerDmtSr();

        jQuery('#btnRetailerDmtExport').on('click', function () {
            var f = retailerDmtFilters();
            location.href = '@Url.Action("Excel_Money_Transfer_Report", "Home")?txt_frm_date=' + encodeURIComponent(f.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(f.txt_to_date) + '&ddl_status=' + encodeURIComponent(f.ddl_status) + '&ddl_Type=' + encodeURIComponent(f.ddl_Type) + '&txtnumberfind=' + encodeURIComponent(f.txtnumberfind);
        });
        jQuery('#btnRetailerDmtPDF').on('click', function () {
            var f = retailerDmtFilters();
            window.open('@Url.Action("PDF_Money_Transfer_Report", "Home")?txt_frm_date=' + encodeURIComponent(f.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(f.txt_to_date) + '&ddl_status=' + encodeURIComponent(f.ddl_status) + '&ddl_Type=' + encodeURIComponent(f.ddl_Type) + '&txtnumberfind=' + encodeURIComponent(f.txtnumberfind), '_blank');
        });

        jQuery(window).on('scroll', function () {
            if (retailerDmtNoMore || retailerDmtBusy) { return; }
            var nearBottom = jQuery(window).scrollTop() + jQuery(window).height() > jQuery(document).height() - 400;
            if (!nearBottom) { return; }
            retailerDmtBusy = true;
            jQuery('#retailerDmtLoading').show();
            var f = retailerDmtFilters();
            jQuery.post('@Url.Action("InfiniteScroll_money", "Home")',
                { pageindex: retailerDmtPageIndex, txt_frm_date: f.txt_frm_date, txt_to_date: f.txt_to_date, ddl_status: f.ddl_status, ddl_Type: f.ddl_Type, txtnumberfind: f.txtnumberfind },
                function (data) {
                    retailerDmtPageIndex = retailerDmtPageIndex + 1;
                    retailerDmtNoMore = data.NoMoredata;
                    var html = data.HTMLString || '';
                    if (html && html.indexOf('vm-opr-table-empty-row') === -1) {
                        jQuery('#retailerDmtRows .vm-opr-table-empty-row').remove();
                        jQuery('#retailerDmtRows').append(html);
                    } else {
                        retailerDmtNoMore = true;
                    }
                    renumberRetailerDmtSr();
                    jQuery('#retailerDmtLoading').hide();
                    retailerDmtBusy = false;
                })
                .fail(function () {
                    jQuery('#retailerDmtLoading').hide();
                    retailerDmtBusy = false;
                });
        });
    });
</script>
}
