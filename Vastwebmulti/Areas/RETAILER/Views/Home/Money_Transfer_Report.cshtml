@model List<Vastwebmulti.Models.money_transfer_report_paging_Result>
@{
    ViewBag.Title = "Money_Transfer_Report";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";
    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    var selStatus = (Request["ddl_status"] ?? "").Trim();
    var selType = (Request["ddl_Type"] ?? "").Trim();
    var selFind = (Request["txtnumberfind"] ?? "").Trim();
    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=34" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=38" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<style>
    /* Sender/Bank A/C is a text input, not a select — remove select chevron */
    body.saas-admin-ui .saas-dmt-report-page #retailerDmtNumberfind.form-control {
        background-image: none !important;
        cursor: text !important;
        padding: 0 12px !important;
    }
    /* ==== Money transfer rows : latest clean look ==== */
    /* Har cell single-line : koi text upar-niche nahi dabega, table side-scroll hogi */
    body.saas-admin-ui .saas-dmt-report-page .vm-opr-table-scroll{overflow-x:auto !important;}
    /* Desktop (>=1024px): table hamesha full 100% width cover karegi, fixed columns */
    @@media (min-width: 1024px) {
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable{table-layout:fixed !important;width:100% !important;min-width:0 !important;max-width:100% !important;}
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable thead tr,
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable tbody tr{display:table-row !important;}
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable thead th,
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable tbody td{display:table-cell !important;min-width:0 !important;max-width:none !important;overflow:hidden !important;text-overflow:ellipsis !important;white-space:nowrap !important;}
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable thead th:nth-child(1),
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable tbody td:nth-child(1){width:3% !important;}
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable thead th:nth-child(2),
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable tbody td:nth-child(2){width:8% !important;}
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable thead th:nth-child(3),
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable tbody td:nth-child(3){width:8% !important;}
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable thead th:nth-child(4),
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable tbody td:nth-child(4){width:7% !important;}
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable thead th:nth-child(5),
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable tbody td:nth-child(5){width:8% !important;}
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable thead th:nth-child(6),
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable tbody td:nth-child(6),
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable thead th:nth-child(7),
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable tbody td:nth-child(7),
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable thead th:nth-child(8),
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable tbody td:nth-child(8),
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable thead th:nth-child(9),
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable tbody td:nth-child(9),
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable thead th:nth-child(10),
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable tbody td:nth-child(10){width:6% !important;}
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable thead th:nth-child(11),
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable tbody td:nth-child(11){width:8% !important;}
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable thead th:nth-child(12),
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable tbody td:nth-child(12){width:9% !important;}
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable thead th:nth-child(13),
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable tbody td:nth-child(13){width:8% !important;}
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable thead th:nth-child(14),
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable tbody td:nth-child(14){width:4% !important;}
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable thead th:nth-child(15),
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable tbody td:nth-child(15){width:7% !important;}
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable .vm-dmt-ellipsis{max-width:100% !important;}
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable .vm-dmt-time-chip{font-size:10.5px !important;padding:2px 8px !important;}
    }
    /* Mobile + tablet (<=1023px): natural widths, full text, horizontal scroll */
    @@media (max-width: 1023.98px) {
        body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable{table-layout:auto !important;width:max-content !important;min-width:100% !important;max-width:none !important;}
    }
    body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable thead th{white-space:nowrap !important;vertical-align:middle !important;font-size:12px;padding:10px 10px !important;}
    body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable tbody td{white-space:nowrap !important;vertical-align:middle !important;font-size:12.5px;padding:9px 10px !important;}
    body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable tbody tr{border-bottom:1px solid #eef1f6 !important;transition:background .15s ease;}
    body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable tbody tr:hover{background:#f6f9ff !important;}
    body.saas-admin-ui .saas-dmt-report-page .vm-dmt-row--success{background:#f6fef9 !important;}
    body.saas-admin-ui .saas-dmt-report-page .vm-dmt-sr-cell{color:#8a94a6;font-weight:700;}
    /* Status : pill + type chip ek hi line me (flex row) */
    body.saas-admin-ui .saas-dmt-report-page .vm-dmt-status-cell{white-space:nowrap !important;}
    body.saas-admin-ui .saas-dmt-report-page .vm-dmt-status-cell-inner{display:inline-flex !important;align-items:center;gap:6px;flex-wrap:nowrap !important;}
    body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable tbody tr{border-bottom:1px solid #eef1f6 !important;transition:background .15s ease;}
    body.saas-admin-ui .saas-dmt-report-page #retailerDmtTable tbody tr:hover{background:#f6f9ff !important;}
    body.saas-admin-ui .saas-dmt-report-page .vm-dmt-row--success{background:#f6fef9 !important;}
    body.saas-admin-ui .saas-dmt-report-page .vm-dmt-sr-cell{color:#8a94a6;font-weight:700;}
    /* Status : icon + label ek hi pill me */
    body.saas-admin-ui .saas-dmt-report-page .vm-dmt-status{display:inline-flex !important;align-items:center;gap:6px;padding:4px 12px;border-radius:999px;font-size:11.5px;font-weight:700;white-space:nowrap;}
    body.saas-admin-ui .saas-dmt-report-page .vm-dmt-status em{font-style:normal;}
    body.saas-admin-ui .saas-dmt-report-page .vm-dmt-status .fa{font-size:11px;}
    body.saas-admin-ui .saas-dmt-report-page .vm-dmt-status--success{background:#e7f7ee !important;color:#15803d !important;}
    body.saas-admin-ui .saas-dmt-report-page .vm-dmt-status--failed{background:#fdecec !important;color:#c62828 !important;}
    body.saas-admin-ui .saas-dmt-report-page .vm-dmt-status--pending{background:#fff7e0 !important;color:#a16207 !important;}
    body.saas-admin-ui .saas-dmt-report-page .vm-dmt-type-chip{display:inline-block;margin-top:0;padding:1px 8px;border-radius:999px;background:#eef1f6;color:#5b6b82;font-size:10.5px;font-weight:700;letter-spacing:.3px;white-space:nowrap;}
    body.saas-admin-ui .saas-dmt-report-page .vm-dmt-strong{white-space:nowrap;}
    /* Lambe text : ... ke sath, row kabhi failegi nahi (hover = full text) */
    body.saas-admin-ui .saas-dmt-report-page .vm-dmt-ellipsis{display:inline-block;max-width:130px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;vertical-align:middle;}
    body.saas-admin-ui .saas-dmt-report-page .vm-dmt-ellipsis--name{max-width:150px;text-transform:uppercase;font-weight:600;color:#334155;}
    body.saas-admin-ui .saas-dmt-report-page .vm-dmt-ellipsis--utr{max-width:150px;font-family:Consolas,'Courier New',monospace;font-size:11.5px;color:#475569;}
    /* Amounts : mono look, right side, ek line me */
    body.saas-admin-ui .saas-dmt-report-page .vm-dmt-amt-cell{white-space:nowrap !important;font-variant-numeric:tabular-nums;font-weight:600;color:#1e293b;text-align:right !important;}
    /* Time : single-line chip */
    body.saas-admin-ui .saas-dmt-report-page .vm-dmt-time-chip{display:inline-flex;align-items:center;white-space:nowrap;font-size:11.5px;font-weight:600;color:#475569;background:#f1f5f9;border:1px solid #e2e8f0;border-radius:999px;padding:3px 10px;}
    /* Action buttons : ek line me */
    body.saas-admin-ui .saas-dmt-report-page .vm-dmt-action-bar{display:flex !important;align-items:center;gap:6px;flex-wrap:nowrap !important;}
    body.saas-admin-ui .saas-dmt-report-page .vm-dmt-act-btn{width:32px;height:32px;display:inline-flex;align-items:center;justify-content:center;border-radius:9px;border:1px solid #e2e8f0;background:#fff;color:#5b6b82;cursor:pointer;transition:all .15s ease;}
    body.saas-admin-ui .saas-dmt-report-page .vm-dmt-act-btn:hover{background:#0ea5e9;border-color:#0ea5e9;color:#fff;box-shadow:0 4px 10px rgba(14,165,233,.35);}
    body.saas-admin-ui .saas-dmt-report-page .vm-dmt-act-btn .material-icons{font-size:17px;}
</style>

<div id="loadermoney" class="vm-dmt-loader" style="display:none;" aria-hidden="true">
    <div class="vm-dmt-loader__panel" role="status" aria-live="polite" aria-label="Processing">
        <div class="vm-dmt-table-loader__spinner" aria-hidden="true"></div>
        <span class="vm-dmt-loader__text">Please wait…</span>
    </div>
</div>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-retailer-dmt-report-page">
    <div class="container-fluid vm-opr-page-shell">

        @{
            var dmtFormAttrs = new Dictionary<string, object>
            {
                { "id", "retailerDmtReportForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-report-date-form", "" },
                { "data-report-from", "#retailer_dmt_frm_date" },
                { "data-report-to", "#retailer_dmt_to_date" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("Money_Transfer_Report", "Home", FormMethod.Post, dmtFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Financial Services</li>
                        <li>Money Transfer Report</li>
                    </ol>
                    <div class="vm-dmt-fin-nav-row">
                        @Html.Partial("_menuFinicalReport")
                    </div>
                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="retailerDmtTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Transaction totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideRetailerDmtTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Success</span>
                            <strong class="vm-opr-total-card__value" id="retailerDmtSuccess">&#8377; 0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Failed</span>
                            <strong class="vm-opr-total-card__value" id="retailerDmtFailed">&#8377; 0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Pending</span>
                            <strong class="vm-opr-total-card__value" id="retailerDmtPending">&#8377; 0.00</strong>
                        </div>
                    </div>
                </div>

                <div class="vm-rpt-filters-panel">
                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-rpt-filters-panel__bar">
                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("ddl_status", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "All Status", Value = "ALL", Selected = (selStatus == "" || selStatus == "ALL") },
                                new SelectListItem { Text = "Success", Value = "SUCCESS", Selected = selStatus == "SUCCESS" },
                                new SelectListItem { Text = "Pending", Value = "PENDING", Selected = selStatus == "PENDING" },
                                new SelectListItem { Text = "Failed", Value = "FAILED", Selected = selStatus == "FAILED" }
                            }, new { id = "ddl_status", @class = "vm-opr-select vm-dmt-select form-control", title = "Status" })
                        </div>
                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("ddl_Type", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "All Types", Value = "ALL", Selected = (selType == "" || selType == "ALL") },
                                new SelectListItem { Text = "Account Transfer", Value = "IMPS", Selected = selType == "IMPS" },
                                new SelectListItem { Text = "UPI Transfer", Value = "UPI", Selected = selType == "UPI" },
                                new SelectListItem { Text = "Paytm Wallet", Value = "WALLET", Selected = selType == "WALLET" },
                                new SelectListItem { Text = "Verify", Value = "IMPS_VERIFY", Selected = selType == "IMPS_VERIFY" },
                                new SelectListItem { Text = "Credit Card", Value = "Credit Card", Selected = selType == "Credit Card" }
                            }, new { id = "ddl_Type", @class = "vm-opr-select vm-dmt-select form-control", title = "Transfer type" })
                        </div>
                        <div class="vm-dmt-filter-search-group">
                            <div class="vm-opr-field vm-dmt-field vm-dmt-field--search">
                                @Html.TextBox("txtnumberfind", selFind, new { @class = "form-control vm-dmt-search-input", placeholder = "Sender No. / Bank A/C", autocomplete = "off", id = "retailerDmtNumberfind", title = "Sender number or bank account", onkeypress = "return isNumber(event)" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_dmt_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_dmt_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" value="LIVE" name="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-exchange-alt" aria-hidden="true"></i>
                        <span>Money transfer transactions</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn" onclick="FindtotalRetailerDmt()" title="Show totals" aria-expanded="false" aria-controls="retailerDmtTotalsPanel"><i class="fas fa-chart-pie" aria-hidden="true"></i></button>
                            <button type="button" id="btnRetailerDmtExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel"><i class="fas fa-file-excel" aria-hidden="true"></i> Excel</button>
                            <button type="button" id="btnRetailerDmtPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF"><i class="fas fa-file-pdf" aria-hidden="true"></i> PDF</button>
                        </div>
                    </div>
                </div>
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="retailerDmtTable" class="table vm-opr-data-table" cellspacing="0" style="width:100%;">
                            <thead>
                                <tr>
                                    <th>S.R.</th>
                                    <th>Status</th>
                                    <th>Sender Number</th>
                                    <th>Beneficiary A/C</th>
                                    <th>Beneficiary Name</th>
                                    <th>Net T/F &#8377;</th>
                                    <th>Charge &#8377;</th>
                                    <th>Debit &#8377;</th>
                                    <th>Pre &#8377;</th>
                                    <th>Post &#8377;</th>
                                    <th>Request Time</th>
                                    <th>Resp Time</th>
                                    <th>Bank UTR</th>
                                    <th>Refund</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody id="retailerDmtRows">
                                @{ Html.RenderAction("_Money_Transfer_Report", "Home", new { txt_frm_date = frmDate, txt_to_date = toDate, ddl_status = (selStatus == "" ? "ALL" : selStatus), ddl_Type = (selType == "" ? "ALL" : selType), txtnumberfind = selFind }); }
                            </tbody>
                        </table>
                        <div id="retailerDmtLoading" class="vm-opr-table-loading vm-dmt-table-loading" style="display:none;">
                            <div class="vm-dmt-table-loader" role="status" aria-live="polite" aria-label="Loading transactions">
                                <div class="vm-dmt-table-loader__spinner" aria-hidden="true"></div>
                                <span class="vm-dmt-table-loader__text">Loading transactions…</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

<!-- Refund OTP -->
<div class="modal fade saas-admin-modal vm-dmt-modal" id="myModal" role="dialog" data-keyboard="false" data-backdrop="static">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">
            <div class="modal-header saas-admin-modal-header accent-amber">
                <div class="saas-admin-modal-head-main">
                    <div class="saas-admin-modal-icon"><i class="fas fa-shield-alt" aria-hidden="true"></i></div>
                    <div>
                        <h4 class="modal-title saas-admin-modal-title">Refund OTP</h4>
                        <p class="saas-admin-modal-sub">Enter OTP to confirm refund</p>
                    </div>
                </div>
                <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
            </div>
            <div class="modal-body vm-dmt-modal-body">
                <div class="vm-dmt-modal-field">
                    <label for="name">OTP</label>
                    <input type="text" id="name" name="name" class="form-control vm-dmt-modal-input" autocomplete="off" placeholder="Enter OTP" />
                    @Html.Hidden("TID")
                    <span class="vm-dmt-modal-error" id="invalidname"></span>
                </div>
            </div>
            <div class="modal-footer saas-admin-modal-footer">
                <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--ghost" onclick="Resendotp()"><i class="fas fa-redo" aria-hidden="true"></i> Resend OTP</button>
                <button type="button" class="saas-admin-modal-btn saas-admin-modal-btn--primary" onclick="Submit()"><i class="fas fa-paper-plane" aria-hidden="true"></i> Send</button>
            </div>
