@*@model IEnumerable<Vastwebmulti.Areas.RETAILER.Models.operatorlist>*@
@model Vastwebmulti.Areas.RETAILER.Models.remmulti
@* vm-rch: Your Offers — modern table rows (avatar + status pill + offer chip) *@

<table id="showoptcomm" class="table table-striped vm-rch-offer-table" style="width:100%;">
    <thead>
        <tr class="operator-showoptcomm">
            <th>Operator</th>
            <th class="vm-rch-offer-th-status">Status</th>
            <th class="vm-rch-offer-th-amt">Offer</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.optlist)
        {
            var msg = "";
            var statusClass = "vm-rch-offer-status--live";
            DateTime? dd;

            if (item.blocktime == null)
            {
                msg = "Live";
            }
            else
            {
                dd = Convert.ToDateTime(item.blocktime);
                msg = String.Format("{0:dd-MM:HH:mm}", dd);
                statusClass = "vm-rch-offer-status--blocked";
            }
            <tr class="tableimgsecond vm-rch-offer-row">
                <td class="vm-rch-offer-op-cell">@item.operator_Name</td>
                <td class="img-rightss vm-rch-offer-st-cell">
                    <span class="vm-rch-offer-status @statusClass">
                        <span class="vm-rch-offer-dot" aria-hidden="true"></span>@msg
                    </span>
                </td>
                <td class="vm-rch-offer-amt-cell">
                    <span class="vm-rch-offer-val-chip" title="Commission offer"><span class="vm-rch-offer-val-sym">₹</span>@item.comm</span>
                </td>
            </tr>
        }
    </tbody>
</table>
