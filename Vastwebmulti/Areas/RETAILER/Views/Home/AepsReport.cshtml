@model IEnumerable<Vastwebmulti.Models.Aeps_Report_New_Result>
@{
    ViewBag.Title = "AEPS Report";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";
    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    var selStatus = (Request["ddl_status"] ?? "").Trim();
    var selAmount = (Request["amount"] ?? "").Trim();
    var selBankId = (Request["BankId"] ?? "").Trim();
    var selAadhar = (Request["aadhar"] ?? "").Trim();
    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-nav.css?v=8" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=34" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=38" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<style>
    /* AEPS text inputs are not selects — remove select chevron */
    body.saas-admin-ui .saas-dmt-report-page .vm-dmt-filter-row input.vm-aeps-text-input.form-control {
        background-image: none !important;
        cursor: text !important;
        padding: 0 12px !important;
    }
    /* AEPS: 18 columns must fit page width on desktop — NO horizontal scroll.
       Fixed layout + wrapping headers so nothing overlaps. */
    body.saas-admin-ui .saas-retailer-aeps-report-page #mmm.vm-opr-data-table {
        min-width: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
        table-layout: fixed !important;
    }
    body.saas-admin-ui .saas-retailer-aeps-report-page #mmm.vm-opr-data-table thead th {
        white-space: normal !important;
        word-break: break-word !important;
        line-height: 1.25 !important;
        padding: 8px 3px !important;
        font-size: 0.68rem !important;
        text-align: center !important;
        vertical-align: middle !important;
    }
    body.saas-admin-ui .saas-retailer-aeps-report-page #mmm.vm-opr-data-table tbody td {
        white-space: normal !important;
        word-break: break-word !important;
        overflow-wrap: anywhere !important;
        padding: 7px 3px !important;
        font-size: 0.8rem !important;
        text-align: center !important;
        vertical-align: middle !important;
    }
    body.saas-admin-ui .saas-retailer-aeps-report-page #mmm .vm-dmt-txntype {
        display: block;
        margin: 2px 0 0 0;
        font-size: 0.72rem;
        font-weight: 700;
        color: #334155;
        white-space: normal;
        line-height: 1.2;
    }
    body.saas-admin-ui .saas-retailer-aeps-report-page #mmm.vm-opr-data-table thead th:nth-child(1) { width: 3%; }
    body.saas-admin-ui .saas-retailer-aeps-report-page #mmm.vm-opr-data-table thead th:nth-child(2) { width: 5.5%; }
    body.saas-admin-ui .saas-retailer-aeps-report-page #mmm.vm-opr-data-table thead th:nth-child(3) { width: 7.5%; }
    body.saas-admin-ui .saas-retailer-aeps-report-page #mmm.vm-opr-data-table thead th:nth-child(4) { width: 7.5%; }
    body.saas-admin-ui .saas-retailer-aeps-report-page #mmm.vm-opr-data-table thead th:nth-child(5) { width: 6%; }
    body.saas-admin-ui .saas-retailer-aeps-report-page #mmm.vm-opr-data-table thead th:nth-child(6) { width: 6%; }
    body.saas-admin-ui .saas-retailer-aeps-report-page #mmm.vm-opr-data-table thead th:nth-child(7) { width: 6.5%; }
    body.saas-admin-ui .saas-retailer-aeps-report-page #mmm.vm-opr-data-table thead th:nth-child(8) { width: 5%; }
    body.saas-admin-ui .saas-retailer-aeps-report-page #mmm.vm-opr-data-table thead th:nth-child(9) { width: 4.5%; }
    body.saas-admin-ui .saas-retailer-aeps-report-page #mmm.vm-opr-data-table thead th:nth-child(10) { width: 4.5%; }
    body.saas-admin-ui .saas-retailer-aeps-report-page #mmm.vm-opr-data-table thead th:nth-child(11) { width: 4%; }
    body.saas-admin-ui .saas-retailer-aeps-report-page #mmm.vm-opr-data-table thead th:nth-child(12) { width: 3.5%; }
    body.saas-admin-ui .saas-retailer-aeps-report-page #mmm.vm-opr-data-table thead th:nth-child(13) { width: 5%; }
    body.saas-admin-ui .saas-retailer-aeps-report-page #mmm.vm-opr-data-table thead th:nth-child(14) { width: 4.5%; }
    body.saas-admin-ui .saas-retailer-aeps-report-page #mmm.vm-opr-data-table thead th:nth-child(15) { width: 5%; }
    body.saas-admin-ui .saas-retailer-aeps-report-page #mmm.vm-opr-data-table thead th:nth-child(16) { width: 9%; }
    body.saas-admin-ui .saas-retailer-aeps-report-page #mmm.vm-opr-data-table thead th:nth-child(17) { width: 7%; }
    body.saas-admin-ui .saas-retailer-aeps-report-page #mmm.vm-opr-data-table thead th:nth-child(18) { width: 6%; }
</style>

<div id="loadermoney" class="vm-dmt-loader" style="display:none;" aria-hidden="true">
    <div class="vm-dmt-loader__panel" role="status" aria-live="polite" aria-label="Processing">
        <div class="vm-dmt-table-loader__spinner" aria-hidden="true"></div>
        <span class="vm-dmt-loader__text">Please wait…</span>
    </div>
</div>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-retailer-aeps-report-page">
    <div class="container-fluid vm-opr-page-shell">

        @{
            var aepsFormAttrs = new Dictionary<string, object>
            {
                { "id", "retailerAepsReportForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-report-date-form", "" },
                { "data-report-from", "#retailer_aeps_frm_date" },
                { "data-report-to", "#retailer_aeps_to_date" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("AepsReport", "Home", FormMethod.Post, aepsFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Financial Services</li>
                        <li>AEPS Report</li>
                    </ol>
                    <div class="vm-dmt-fin-nav-row">
                        @Html.Partial("_menuFinicalReport")
                    </div>
                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="retailerAepsTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>AEPS totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideRetailerAepsTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Success</span>
                            <strong class="vm-opr-total-card__value" id="retailerAepsSuccess">&#8377; 0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Failed</span>
                            <strong class="vm-opr-total-card__value" id="retailerAepsFailed">&#8377; 0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Pending</span>
                            <strong class="vm-opr-total-card__value" id="retailerAepsPending">&#8377; 0.00</strong>
                        </div>
                    </div>
                </div>

                <div class="vm-rpt-filters-panel">
                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-rpt-filters-panel__bar">
                        <div class="vm-opr-field vm-dmt-field">
                            @Html.TextBox("amount", selAmount, new { @class = "form-control vm-aeps-text-input", placeholder = "Amount", autocomplete = "off", id = "retailerAepsAmount", title = "Amount", onkeypress = "return isNumber(event)" })
                        </div>
                        <div class="vm-opr-field vm-dmt-field">
                            @Html.TextBox("BankId", selBankId, new { @class = "form-control vm-aeps-text-input", placeholder = "Bank ID", autocomplete = "off", id = "retailerAepsBankId", title = "Bank ID" })
                        </div>
                        <div class="vm-opr-field vm-dmt-field">
                            @Html.TextBox("aadhar", selAadhar, new { @class = "form-control vm-aeps-text-input", placeholder = "Aadhaar / Mobile", autocomplete = "off", id = "retailerAepsAadhar", title = "Aadhaar number", onkeypress = "return isNumber(event)" })
                        </div>
                        <div class="vm-opr-field vm-dmt-field">
                            @Html.DropDownList("ddl_status", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "All Status", Value = "ALL", Selected = (selStatus == "" || selStatus == "ALL") },
                                new SelectListItem { Text = "Success", Value = "SUCCESS", Selected = selStatus == "SUCCESS" },
                                new SelectListItem { Text = "Pending", Value = "PENDING", Selected = selStatus == "PENDING" },
                                new SelectListItem { Text = "Failed", Value = "FAILED", Selected = selStatus == "FAILED" }
                            }, new { id = "ddl_status", @class = "vm-opr-select vm-dmt-select form-control", title = "Status" })
                        </div>
                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_aeps_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_aeps_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-fingerprint" aria-hidden="true"></i>
                        <span>AEPS transactions</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn" onclick="FindtotalRetailerAeps()" title="Show totals" aria-expanded="false" aria-controls="retailerAepsTotalsPanel"><i class="fas fa-chart-pie" aria-hidden="true"></i></button>
                            <button type="button" id="btnRetailerAepsExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel"><i class="fas fa-file-excel" aria-hidden="true"></i> Excel</button>
                            <button type="button" id="btnRetailerAepsPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF"><i class="fas fa-file-pdf" aria-hidden="true"></i> PDF</button>
                        </div>
                    </div>
                </div>
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="mmm" class="table vm-opr-data-table" cellspacing="0" style="width:100%;">
                            <thead>
                                <tr>
                                    <th>S.R.</th>
                                    <th>Status</th>
                                    <th>User Bank</th>
                                    <th>User A/C</th>
                                    <th>User Aadhaar</th>
                                    <th>User Mobile</th>
                                    <th>User Name</th>
                                    <th>Net Amt &#8377;</th>
                                    <th>User Fee</th>
                                    <th>Earn &#8377;</th>
                                    <th>GST IN</th>
                                    <th>TDS</th>
                                    <th>Pre &#8377;</th>
                                    <th>Cr Dr</th>
                                    <th>Post &#8377;</th>
                                    <th>Bank RRN / Error</th>
                                    <th>Request Time</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody id="retailerAepsRows">
                                @{ Html.RenderAction("_AepsReport", "Home", new { txt_frm_date = frmDate, txt_to_date = toDate, ddl_status = (selStatus == "" ? "ALL" : selStatus), amount = (string.IsNullOrWhiteSpace(selAmount) ? null : selAmount), BankId = selBankId, aadhar = selAadhar }); }
                            </tbody>
                        </table>
                        <div id="retailerAepsLoading" class="vm-opr-table-loading vm-dmt-table-loading" style="display:none;">
                            <div class="vm-dmt-table-loader" role="status" aria-live="polite" aria-label="Loading transactions">
                                <div class="vm-dmt-table-loader__spinner" aria-hidden="true"></div>
                                <span class="vm-dmt-table-loader__text">Loading transactions…</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section PostVmScripts {
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    var retailerAepsPageIndex = 2;
    var retailerAepsNoMore = false;
    var retailerAepsBusy = false;

    function isNumber(evt) {
        var iKeyCode = (evt.which) ? evt.which : evt.keyCode;
        if (iKeyCode != 45 && iKeyCode > 31 && (iKeyCode < 48 || iKeyCode > 57)) {
            return false;
        }
        return true;
    }

    function retailerAepsFilters() {
        return {
            txt_frm_date: jQuery('#retailer_aeps_frm_date').val() || '',
            txt_to_date: jQuery('#retailer_aeps_to_date').val() || '',
            ddl_status: jQuery('#ddl_status').val() || 'ALL',
            amount: jQuery('#retailerAepsAmount').val() || '',
            BankId: jQuery('#retailerAepsBankId').val() || '',
            aadhar: jQuery('#retailerAepsAadhar').val() || ''
        };
    }

    function renumberRetailerAepsSr() {
        jQuery('#retailerAepsRows tr.vm-dmt-row').each(function (i) {
            jQuery(this).find('.vm-dmt-sr-cell').first().text(i + 1);
        });
    }

    function hideRetailerAepsTotals() {
        var $panel = jQuery('#retailerAepsTotalsPanel');
        var $btn = jQuery('.vm-dmt-totals-btn');
        $panel.removeClass('is-open').hide().attr('aria-hidden', 'true');
        $btn.removeClass('is-active').attr({ title: 'Show totals', 'aria-expanded': 'false' });
    }

    function FindtotalRetailerAeps() {
        var $panel = jQuery('#retailerAepsTotalsPanel');
        var $btn = jQuery('.vm-dmt-totals-btn');
        if ($panel.hasClass('is-open')) {
            hideRetailerAepsTotals();
            return;
        }
        $panel.addClass('is-open').show().attr('aria-hidden', 'false');
        $btn.addClass('is-active').attr({ title: 'Hide totals', 'aria-expanded': 'true' });
        var f = retailerAepsFilters();
        jQuery.ajax({
            url: '@Url.Action("AepsReport_Total", "Home")',
            type: 'GET',
            data: { txt_frm_date: f.txt_frm_date, txt_to_date: f.txt_to_date, ddl_status: f.ddl_status },
            success: function (data) {
                jQuery('#retailerAepsSuccess').html('&#8377; ' + data.success);
                jQuery('#retailerAepsFailed').html('&#8377; ' + data.failed);
                jQuery('#retailerAepsPending').html('&#8377; ' + data.pending);
            }
        });
    }

    function GotoPDF(e) {
        var url = '@Url.Action("GeneratePDF", "Home")?Idno=' + e.toString();
        window.open(url, '_blank');
    }

    function initRetailerAepsSelect2() {
        jQuery('#ddl_status').each(function () {
            var $el = jQuery(this);
            if (!$el.length || !jQuery.fn.select2) { return; }
            if ($el.hasClass('select2-hidden-accessible')) {
                try { $el.select2('destroy'); } catch (e) { }
            }
            $el.select2({ width: '100%', minimumResultsForSearch: 6 });
        });
    }

    function initRetailerAepsDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initRetailerAepsDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm(
                '#retailerAepsReportForm',
                '#retailer_aeps_frm_date',
                '#retailer_aeps_to_date',
                true
            );
        }
    }

    jQuery(function () {
        initRetailerAepsSelect2();
        initRetailerAepsDatepickers();
        window.setTimeout(initRetailerAepsDatepickers, 150);
        renumberRetailerAepsSr();

        jQuery('#btnRetailerAepsExport').on('click', function () {
            var f = retailerAepsFilters();
            location.href = '@Url.Action("Excel_Aeps_Report", "Home")?txt_frm_date=' + encodeURIComponent(f.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(f.txt_to_date) + '&ddl_status=' + encodeURIComponent(f.ddl_status) + '&amount=' + encodeURIComponent(f.amount) + '&BankId=' + encodeURIComponent(f.BankId) + '&aadhar=' + encodeURIComponent(f.aadhar);
        });
        jQuery('#btnRetailerAepsPDF').on('click', function () {
            var f = retailerAepsFilters();
            window.open('@Url.Action("PDF_AepsReport", "Home")?txt_frm_date=' + encodeURIComponent(f.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(f.txt_to_date) + '&ddl_status=' + encodeURIComponent(f.ddl_status) + '&amount=' + encodeURIComponent(f.amount) + '&BankId=' + encodeURIComponent(f.BankId) + '&aadhar=' + encodeURIComponent(f.aadhar), '_blank');
        });

        jQuery(window).on('scroll', function () {
            if (retailerAepsNoMore || retailerAepsBusy) { return; }
            var nearBottom = jQuery(window).scrollTop() + jQuery(window).height() > jQuery(document).height() - 400;
            if (!nearBottom) { return; }
            retailerAepsBusy = true;
            jQuery('#retailerAepsLoading').show();
            var f = retailerAepsFilters();
            jQuery.post('@Url.Action("InfiniteScroll_aeps", "Home")',
                { pageindex: retailerAepsPageIndex, txt_frm_date: f.txt_frm_date, txt_to_date: f.txt_to_date, ddl_status: f.ddl_status, amount: f.amount, BankId: f.BankId, aadhar: f.aadhar },
                function (data) {
                    retailerAepsPageIndex = retailerAepsPageIndex + 1;
                    retailerAepsNoMore = data.NoMoredata;
                    var html = data.HTMLString || '';
                    if (html && html.indexOf('vm-opr-table-empty-row') === -1) {
                        jQuery('#retailerAepsRows .vm-opr-table-empty-row').remove();
                        jQuery('#retailerAepsRows').append(html);
                    } else {
                        retailerAepsNoMore = true;
                    }
                    renumberRetailerAepsSr();
                    jQuery('#retailerAepsLoading').hide();
                    retailerAepsBusy = false;
                })
                .fail(function () {
                    jQuery('#retailerAepsLoading').hide();
                    retailerAepsBusy = false;
                });
        });
    });
</script>
}
