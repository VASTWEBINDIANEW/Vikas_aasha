<script>
    function Recharge(optname, optvalue, mobileno, amount, optional1, optional2, optional3, optional4, comm, BillRefId) {
        let latssss = null;
        let longloccc = null;
            swal({
                title: "<span style='color:#bfb6b6;'>Are you sure !</span>",
                //text: "Your Entered details are Correct !",
                html: true,
                text: "<span style='color:#f1a563; font-size:17px;'>Your Entered details are Correct !</span>" +
                    "</br></br><span style='color:black; font-size:20px;'><b> No: " + mobileno + "&nbsp;&nbsp;₹: " + amount + "</b></span>" +
                    "</br><span style='color:black; font-size:17px;'>Operator: " + optname + "</span>",
                type: "warning",
                confirmButtonClass: "btn-danger",
                confirmButtonText: "Yes Recharge It!",
                showCancelButton: true,
                cancelButtonText: "Cancel!",
                closeOnConfirm: true,
                closeOnCancel: false

            },
                function (isConfirm) {
                    if (isConfirm) {
                        $.ajax({
                            type: "POST",
                            url: "@Url.Action("Recharge","Home")",
                            data: { OperatorName: optname, OptCode: optvalue, mobileno: mobileno, Amount: amount, optional1: optional1, optional2: optional2, optional3: optional3, optional4: optional4, comm: comm, BillRefId: BillRefId, latss: latssss, longloc: longloccc },
                            cache: false,
                            dataType: 'json',
                            closeOnConfirm: true,
                            success: function (result) {
                                if (result.Response == 'SUCCESS') {
                                    swal({
                                        title: "Good job!",
                                        text: result.Message,
                                        type: "success"
                                    }, function () {
                                        window.location.href = "@Url.Action("Index", "Home")";
                                    });
                                }
                                else if (result.Response == 'EERROR') {
                                    var price = result.Price;

                                    if (price == "") {
                                        swal({
                                            title: "Failed!",
                                            text: result.Message,
                                            type: "error"
                                        }, function () {
                                            window.location.href = "@Url.Action("Index", "Home")";
                                        });
                                    }
                                    else {
                                        //price = parseInt(price);
                                        $('#electricityAmount').val(price);
                                        swal("Failed!", "The Actual bill value is :" + price + "", "error")
                                    }
                                }
                                else {
                                    swal({
                                        title: "Failed!",
                                        text: result.Message,
                                        type: "error"
                                    }, function () {
                                        window.location.href = "@Url.Action("Index", "Home")";
                                    });
                                }
                            }
                        });
                    } else {
                        swal("Opps!", "This Process Is Cancel", "error");
                    }
                });


        }
</script>

