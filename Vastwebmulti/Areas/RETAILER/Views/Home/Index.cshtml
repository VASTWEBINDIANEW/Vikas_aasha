<script>
    function vmRchSyncMoreMenuBodyClass() {
        var open = $(".morebuttontab").hasClass("morebuttontab-after");
        $("body").toggleClass("vm-rch-more-menu-open", open);
        $("li.vm-rch-tab-more").toggleClass("vm-rch-tab-more-open", open);
    }
    function vmRchPositionMoreMenu() {
        var $menu = $("li.vm-rch-tab-more > ul.morebuttontab.morebuttontab-after");
        var $btn = $("#moreclickulshow");
        if (!$menu.length || !$btn.length) {
            document.documentElement.style.removeProperty("--vm-rch-more-top");
            document.documentElement.style.removeProperty("--vm-rch-more-right");
            return;
        }
        var r = $btn[0].getBoundingClientRect();
        document.documentElement.style.setProperty("--vm-rch-more-top", (r.bottom + 8) + "px");
        document.documentElement.style.setProperty("--vm-rch-more-right", Math.max(8, window.innerWidth - r.right) + "px");
    }
    function vmRchCloseMoreMenu() {
        $(".morebuttontab").removeClass("morebuttontab-after");
        $("#moreclickulshow").attr("aria-expanded", "false");
        vmRchSyncMoreMenuBodyClass();
        vmRchPositionMoreMenu();
    }
    function vmRchSetMoreTabActive($subLink) {
        var $subLi = $subLink.closest("ul.morebuttontab li");
        $("#changeborderbotto > li").not(".vm-rch-tab-more").removeClass("active");
        $("ul.morebuttontab li").removeClass("active");
        $subLi.addClass("active");
        $("li.vm-rch-tab-more").addClass("active");
    }
    function vmRchClearMoreTabActive() {
        $("li.vm-rch-tab-more").removeClass("active");
        $("ul.morebuttontab li").removeClass("active");
    }
    $("#moreclickulshow").click(function (e) {
        e.preventDefault();
        e.stopPropagation();
        var $menu = $("li.vm-rch-tab-more > ul.morebuttontab");
        $menu.toggleClass("morebuttontab-after");
        var open = $menu.hasClass("morebuttontab-after");
        $(this).attr("aria-expanded", open ? "true" : "false");
        vmRchSyncMoreMenuBodyClass();
        vmRchPositionMoreMenu();
    });
    $(document).on("shown.bs.tab", "ul.morebuttontab a[data-toggle='tab']", function (e) {
        vmRchSetMoreTabActive($(e.target));
        vmRchCloseMoreMenu();
    });
    $(document).on("shown.bs.tab", "#changeborderbotto > li:not(.vm-rch-tab-more) > a[data-toggle='tab']", function () {
        vmRchClearMoreTabActive();
        vmRchCloseMoreMenu();
    });
    $(window).on("resize scroll", function () {
        if ($(".morebuttontab").hasClass("morebuttontab-after")) {
            vmRchPositionMoreMenu();
        }
    });
    $(document).on("click", function (e) {
        if (!$(e.target).closest(".vm-rch-tab-more, .morebuttontab").length) {
            vmRchCloseMoreMenu();
        }
    });
</script>

