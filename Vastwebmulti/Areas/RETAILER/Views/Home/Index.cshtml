<!--select loan dropdown — Admin Select2 + search box (global searchable dropdown) -->
<script>
    function vmRchInitLoanLenderSelect() {
        var $ = window.vmAdminJq || window.jQuery;
        if (!$) { return; }
        var $el = $("#loanddltype");
        if (!$el.length) { return; }
        var run = function (attempt) {
            if (!$.fn.select2 || typeof window.forceAdminSelect2 !== "function") {
                if (attempt < 40) { window.setTimeout(function () { run(attempt + 1); }, 100); }
                return;
            }
            $("#divloanddl .bootstrap-select").remove();
            window.forceAdminSelect2($el, {
                width: "100%",
                placeholder: "Select Lender",
                allowClear: false,
                minimumResultsForSearch: 0,
                dropdownParent: $("#loan .vm-rch-pane-wrap"),
                dropdownCssClass: "vm-admin-select2-dropdown vm-admin-select2-searchable vm-rch-loan-lender-drop"
            }, true);
            if (typeof window.forceAdminSelect2SearchAlways === "function") {
                window.forceAdminSelect2SearchAlways($el);
            }
            if (typeof window.ensureAdminSelect2SearchVisible === "function") {
                $el.off("select2:open.vmRchLoan").on("select2:open.vmRchLoan", function () {
                    window.ensureAdminSelect2SearchVisible($el, "Search lender...");
                });
            }
            $el.off("change.vmRchLoan select2:select.vmRchLoan").on("change.vmRchLoan select2:select.vmRchLoan", function () {
                loanoperatorddl(this);
            });
        };
        run(0);
    }
    $(function () {
        $('a[data-toggle="tab"][href="#loan"]').on("shown.bs.tab", function () {
            window.setTimeout(vmRchInitLoanLenderSelect, 50);
        });
        if ($("#loan").hasClass("active")) {
            window.setTimeout(vmRchInitLoanLenderSelect, 50);
        }
    });
    $(window).on("load", function () {
        window.setTimeout(vmRchInitLoanLenderSelect, 300);
    });
    function loanoperatorddl(a) {
        if (!a || !a.options || a.selectedIndex < 0) { return; }
        var p = a.options[a.selectedIndex].text;
        if (!p || p === "Select Lender") { return; }
        if (document.getElementById("LoanAccount")) {
            document.getElementById("LoanAccount").style.marginTop = "-2px";
        }
        if (typeof Loandropdown === "function") {
            Loandropdown(p);
        }
    }
</script>
