<script>
(function () {
    var amt = document.getElementById('txtamount');
    var chips = document.querySelectorAll('#fundtransfer .vm-txm-chipbtn');
    Array.prototype.forEach.call(chips, function (b) {
        b.addEventListener('click', function () {
            Array.prototype.forEach.call(chips, function (x) { x.classList.remove('active'); });
            b.classList.add('active');
            if (amt) { amt.value = b.getAttribute('data-amt'); amt.focus(); hideErr('txtamount'); }
        });
    });
    function hideErr(id) { var e = document.getElementById('err-' + id); if (e) e.style.setProperty('display', 'none', 'important'); }
    function showErr(id) { var e = document.getElementById('err-' + id); if (e) e.style.setProperty('display', 'block', 'important'); }
    if (amt) {
        amt.addEventListener('input', function () {
            amt.value = amt.value.replace(/[^0-9]/g, '').slice(0, 7);
            if (amt.value && parseInt(amt.value, 10) > 0) hideErr('txtamount'); 
        });
    }
    var rrn = document.getElementById('txtbankrrn');
    if (rrn) {
        rrn.addEventListener('input', function () {
            rrn.value = rrn.value.replace(/[^0-9]/g, '').slice(0, 22);
            if (rrn.value.length >= 12) hideErr('txtbankrrn');
        });
    }
    var form = document.getElementById('vmTxmForm');
    if (form) {
        form.addEventListener('submit', function (ev) {
            var ok = true;
            if (!amt || !/^[1-9][0-9]*$/.test(amt.value)) { showErr('txtamount'); ok = false; }
            if (!rrn || rrn.value.length < 12) { showErr('txtbankrrn'); ok = false; }
            if (!ok) { ev.preventDefault(); return false; }
            var btn = document.getElementById('vmTxmSubmit');
            if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Submitting...'; }
        });
    }
})();
</script>
