<script>
    function formatString(e) {
        var ev = e || window.event;
        var code = ev.keyCode || ev.which;
        var allowedKeys = [8];
        if (allowedKeys.indexOf(code) !== -1) {
            return;
        }
        var tgt = ev.target || ev.srcElement;
        tgt.value = tgt.value.replace(
            /^([1-9]\/|[2-9])$/g, '0$1/'
        ).replace(
            /^(0[1-9]|1[0-2])$/g, '$1/'
        ).replace(
            /^([0-1])([3-9])$/g, '0$1/$2'
        ).replace(
            /^(0?[1-9]|1[0-2])([0-9]{2})$/g, '$1/$2'
        ).replace(
            /^([0]+)\/|[0]+$/g, '0'
        ).replace(
            /[^\d\/]|^[\/]*$/g, ''
        ).replace(
            /\/\//g, '/'
        );
    }
</script>
<script>
    $('#txtdebitCardnumber').on('keyup', function (e) {
        var val = $(this).val();
        var newval = '';
        val = val.replace(/\s/g, '');
        for (var i = 0; i < val.length; i++) {
            if (i % 4 == 0 && i > 0) newval = newval.concat(' ');
            newval = newval.concat(val[i]);
        }
        $(this).val(newval);
    });
</script>
<script>
    if (`@TempData["GetUniqueid"]` != '' && document.getElementById('countDownShow')) {
        let hitservice = 'NOTOK';
        let deadline = new Date().getTime() + 482000;
        let x = setInterval(() => {
            let requestUrlResp = '@TempData["GetUniqueid"]'
            $.ajax({
                url: '@Url.Action("UPIAUTOSERVICE", "Home")',
                data: { generatedid: requestUrlResp },
                cache: false,
                type: "POST",
                success: function (data) {
                    var status = data.status;
                    var upists = data.upists;
                    var refid = data.refid;
                    var amount = data.amount;
                    if (window.__upiY2) { clearInterval(window.__upiY2); }
                    var y = setInterval(function () {
                        var now = new Date().getTime();
                        var t = deadline - now;
                        var seconds = Math.max(0, Math.floor(t / 1000));
                        document.getElementById("countDownShow").innerHTML = "QR code disappear after " + seconds + " seconds ";
                        if ((status == "SUCCESS")) {
                            clearInterval(y);
                            clearInterval(x);
                            window.__upiY2 = null;
                            document.getElementById("countDownShow").style.display = "none";
                            document.getElementById("QrShowHide").style.display = "none";
                            if (upists == "FAILED" || upists == "Failed") {
                                document.getElementById('MessageShoHide').style.cssText = `display: block; color: red;`;
                            }
                            else {
                                document.getElementById('MessageShoHide').style.cssText = `display: block; color: green;`;
                            }
                            document.getElementById('MessageShoHide').innerHTML = `STATUS: ${upists} <br> BANKRR NO : ${refid} <br> AMOUNT : ${amount} `;
                        }
                        else if (status == "FAILED") {
                            if (seconds <= 0) {
                                clearInterval(y);
                                clearInterval(x);
                                window.__upiY2 = null;
                                document.getElementById("countDownShow").style.display = "none";
                                document.getElementById("QrShowHide").style.display = "none";
                                document.getElementById('MessageShoHide').style.cssText = `display: block; color: red;`;
                                document.getElementById('MessageShoHide').innerHTML = "No Response Found Please Go Back";
                            }
                        }
                    }, 1000);
                    window.__upiY2 = y;
                }
            })
        }, 3000)
    }
</script>
