<script>
    // Manual UPI requests toggle — FIXED v2 (single fetch, proper toggle, loader + error)
    (function () {
        var btn = document.getElementById('btnUPIreq');
        if (!btn) { return; }
        var isManual = false;
        var loadedOnce = false;
        var loading = false;
        var origHtml = 'Manual REQ';
        function setBtn(manual) {
            isManual = manual;
            btn.textContent = manual ? 'Show History' : origHtml;
            btn.value = manual ? 'SHOW UPI HISTORY' : 'Show Manual UPI REQ';
            btn.classList.toggle('vm-tx-mini-btn--primary', manual);
            btn.setAttribute('title', manual ? 'Back to UPI history' : 'Show manual UPI requests');
        }
        btn.addEventListener('click', function () {
            var mainTable = document.getElementById('btnUPIreqnonetable');
            var secondBox = document.getElementById('btnUPIreqnonetableSecond');
            var loader = document.getElementById('loadingdiv');
            if (isManual) {
                // back to history — no ajax needed
                if (secondBox) { secondBox.style.display = 'none'; }
                if (window.jQuery) { $("#btnUPIreqnonetable").show(); $("#btnUPIreqnonetableSecond").hide(); }
                else if (mainTable) { mainTable.style.display = ''; }
                setBtn(false);
                if (window.jQuery) { $('#upiRecordCount').text($('#tblbody tr.tr').length); }
                return;
            }
            if (loading) { return; }
            if (!window.jQuery) {
                if (mainTable) { mainTable.style.display = 'none'; }
                if (secondBox) { secondBox.style.display = 'block'; }
                setBtn(true);
                return;
            }
            // show manual — fetch once, cache after
            if (loadedOnce) {
                $("#btnUPIreqnonetable").hide();
                $("#btnUPIreqnonetableSecond").show();
                setBtn(true);
                return;
            }
            loading = true;
            btn.disabled = true;
            var oldTxt = btn.textContent;
            btn.innerHTML = "<i class='fa fa-spinner fa-spin'></i> Loading...";
            if (loader) { loader.style.display = 'block'; }
            $.ajax({
                url: '@Url.Action("Show_UPImanual_Request", "Home")',
                type: 'POST',
                cache: false
            }).done(function (data) {
                $("#btnUPIreqnonetable").hide();
                $("#btnUPIreqnonetableSecond").html(data);
                $("#btnUPIreqnonetableSecond").show();
                loadedOnce = true;
                setBtn(true);
                // update record badge to manual count
                var rows = $("#btnUPIreqnonetableSecond .mreq-table tbody tr").not('.mreq-empty').length;
                $('#upiRecordCount').text(rows);
                if (typeof myFunction === 'function') { myFunction(); }
            }).fail(function (xhr) {
                $("#btnUPIreqnonetableSecond").html("<div class='mreq-wrap'><div style='padding:26px;text-align:center;color:#b91c1c;font-weight:700;'>Manual requests load nahi hui. Dobara try karein. (" + (xhr.status || 'error') + ")</div></div>");
                $("#btnUPIreqnonetable").hide();
                $("#btnUPIreqnonetableSecond").show();
                setBtn(true);
            }).always(function () {
                loading = false;
                btn.disabled = false;
                btn.textContent = isManual ? 'Show History' : origHtml;
                if (loader) { loader.style.display = 'none'; }
            });
        });
    })();
</script>
