<script>
    function visibleUPIHistoryTable() {
        var manualBox = document.getElementById('btnUPIreqnonetableSecond');
        var manualVisible = manualBox && manualBox.style.display !== 'none' && manualBox.querySelector('table');
        if (manualVisible) { return manualBox.querySelector('table'); }
        return document.querySelector('#tblshowMasterUPI table#btnUPIreqnonetable');
    }
    function exportUPITransferExcel() {
        var table = visibleUPIHistoryTable();
        if (!table || !table.querySelector('tbody tr') || table.querySelector('.mreq-empty') && !table.querySelector('tbody tr:not(.mreq-empty)')) { alert('No data to export.'); return; }
        var html = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel"><head><meta charset="UTF-8"></head><body>' + table.outerHTML + '</body></html>';
        var blob = new Blob(['\ufeff' + html], { type: 'application/vnd.ms-excel' });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = (document.getElementById('btnUPIreqnonetableSecond') && document.getElementById('btnUPIreqnonetableSecond').style.display !== 'none') ? 'ManualUPIRequests.xls' : 'UPITransferHistory.xls';
        document.body.appendChild(a);
        a.click();
        setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 100);
    }
    function printUPITransferHistory() {
        window.print();
    }
    (function bindUPITransferExportButtons() {
        var btnExport = document.getElementById('btnExport');
        if (btnExport) {
            btnExport.addEventListener('click', exportUPITransferExcel);
            btnExport.onclick = exportUPITransferExcel;
        }
        var btnPDF = document.getElementById('btnPDF');
        if (btnPDF) {
            btnPDF.addEventListener('click', printUPITransferHistory);
            btnPDF.onclick = printUPITransferHistory;
        }
    })();
</script>
