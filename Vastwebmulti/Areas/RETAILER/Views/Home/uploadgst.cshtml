<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />

<script src="@Url.Content("~/Scripts/jquery.validate.min.js")"></script>
<script src="@Url.Content("~/Scripts/jquery.validate.unobtrusive.min.js")"></script>
<script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/select2/4.0.8/js/select2.min.js" defer></script>
<script>
    $(document).ready(function () {
       var month = '@ViewBag.chkmonth';
         var val = '@ViewBag.chk';
        if (val != "post") {
            $('#Month').val(month);
            $('#Month').select2().trigger('change');
            $('#Year').select2();
        }
    });
</script>
<script>
    $('#btnupload').click(function () {
        var fileUpload = $("#upload").get(0);
        var files = fileUpload.files;
        var month = $('#Month').val();
        var year = $('#Year').val();
        // Create FormData object
        var fileData = new FormData();
        for (var i = 0; i < files.length; i++) {
            fileData.append(files[i].name, files[i]);
        }
        fileData.append("month", month);
        fileData.append("year", year);
        $.ajax({
            url: "@Url.Action("uploadgstfile", "Home")",
            type: "POST",
            contentType: false, // Not to set any content header
            processData: false, // Not to process data
            data:  fileData ,// '{files:' + fileData + ',Month:' + month + ',Year:' + year+'}',
            //data: '{"fileData":"+fileData"}' ,
            success: function (result) {
                location.reload();
            },
            error: function (err) {
                alert(err.statusText);
            }
        });
    });
</script>
<script>
    function show(str) {
        $('#ifrmgst').attr("src", "../../" + str);
        $('#m-d-fund-transfer12').modal('show');
    }
    $(document).ready(function () {
        $('#m-d-fund-transfer12').on('hidden.bs.modal', function () {
            $('#ifrmgst').attr('src', 'about:blank');
        });
    });
    function vmGstFilePicked(input) {
        var name = 'No file selected';
        if (input && input.files && input.files.length > 0 && input.files[0].name) {
            name = input.files[0].name;
        } else if (input && input.value) {
            var v = input.value || '';
            name = v.substring(v.lastIndexOf(String.fromCharCode(92)) + 1) || name;
        }
        $('#vmGstFileName').text(name);
    }
</script>
