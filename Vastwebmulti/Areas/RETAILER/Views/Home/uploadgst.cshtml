<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-retailer-gst-page">
    <div class="container-fluid vm-opr-page-shell">
        @using (Html.BeginForm("uploadgst", "Home", FormMethod.Post, new { id = "uploadGstForm", @class = "vm-rpt-filters-panel__form" }))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
            <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home", new { area = "RETAILER" })"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>GST</li>
                    <li>Upload GST</li>
                </ol>
                <div class="vm-dmt-fin-nav-row">
                    <nav class="vm-fin-nav vm-fin-nav--pill vm-fin-nav--single-line" id="invoice-gst-nav" aria-label="GST reports">
                        <ul class="vm-fin-nav__list" id="invoice-gst-nav-list">
                            <li>
                                <a class="vm-fin-nav__link" href="@Url.Action("RetailerSellgst", "Home")" title="Sell Gst">
                                    <i class="fas fa-file-invoice vm-fin-nav__ico" aria-hidden="true"></i>
                                    <span>Sell Gst</span>
                                </a>
                            </li>
                            <li>
                                <a class="vm-fin-nav__link" href="@Url.Action("retailerPurchasegst", "Home")" title="Purchase Gst">
                                    <i class="fas fa-shopping-cart vm-fin-nav__ico" aria-hidden="true"></i>
                                    <span>Purchase Gst</span>
                                </a>
                            </li>
                            <li>
                                <a class="vm-fin-nav__link" href="@Url.Action("uploadgst", "Home")" title="Upload Gst">
                                    <i class="fas fa-upload vm-fin-nav__ico" aria-hidden="true"></i>
                                    <span>Upload Gst</span>
                                </a>
                            </li>
                            <li>
                                <a class="vm-fin-nav__link" href="@Url.Action("RetailerRechargeSellgst", "Home")" title="Recharge Sell Gst">
                                    <i class="fas fa-mobile-alt vm-fin-nav__ico" aria-hidden="true"></i>
                                    <span>Recharge Sell Gst</span>
                                </a>
                            </li>
                            <li>
                                <a class="vm-fin-nav__link" href="@Url.Action("Rechargeuploadgst", "Home")" title="Recharge Upload Gst">
                                    <i class="fas fa-cloud-upload-alt vm-fin-nav__ico" aria-hidden="true"></i>
                                    <span>Recharge Upload Gst</span>
                                </a>
                            </li>
                        </ul>
                    </nav>
                    <script>
                        (function () {
                            try {
                                var navList = document.getElementById('invoice-gst-nav-list');
                                if (!navList) { return; }
                                var current = (window.location.pathname || '').toLowerCase();
                                var links = navList.querySelectorAll('a.vm-fin-nav__link');
                                var best = null, bestLen = 0;
                                for (var i = 0; i < links.length; i++) {
                                    var href = (links[i].getAttribute('href') || '').toLowerCase().split('?')[0].split('#')[0];
                                    if (!href || href.indexOf('javascript:') === 0) { continue; }
                                    if (current === href || current.indexOf(href) !== -1) {
                                        if (href.length > bestLen) { bestLen = href.length; best = links[i]; }
                                    }
                                }
                                if (best) { best.classList.add('is-active'); }
                            } catch (e) { }
                        })();
                    </script>
                </div>
            </div>
                <div class="vm-rpt-filters-panel">
                <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-rpt-filters-panel__bar">
                    <div class="vm-dmt-filter-search-group">
                        <div class="saas-acc-dp-field vm-gst-filter-field">
                            @Html.DropDownList("Month", ViewBag.month as SelectList, new { @class = "form-control saas-acc-dp-input" })
                        </div>
                        <div class="saas-acc-dp-field vm-gst-filter-field">
                            @Html.DropDownList("Year", ViewBag.year as SelectList, new { @class = "form-control saas-acc-dp-input" })
                        </div>
                        <input type="hidden" id="tabtype" name="tabtype" value="FundTranferAllReport" />
                        <button type="submit" id="btnchangetabbutton" name="btnDsearch" class="saas-acc-btn saas-acc-btn--search vm-gst-search-btn" data-loading-text="<i class='fa fa-spinner fa-spin'></i>" title="Search">
                            <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                        </button>
                        <div class="vm-gst-upload-group">
                            <label class="vm-gst-file-picker" for="upload" title="Accept Only pdf File">
                                <span class="vm-gst-file-ico"><i class="fa fa-paperclip" aria-hidden="true"></i></span>
                                <span class="vm-gst-file-name" id="vmGstFileName">No file selected</span>
                            </label>
                            @Html.TextBox("upload", "", new { type = "file", accept = "application/pdf", @class = "vm-gst-file-input", title = "Accept Only pdf File", onchange = "vmGstFilePicked(this)" })
                            <span class="vm-gst-file-hint">PDF only</span>
                            <button id="btnupload" type="button" name="Uploadgst" class="vm-gst-upload-btn" data-loading-text="<i class='fa fa-spinner fa-spin'></i>" title="Upload GST PDF">
                                <i class="fa fa-upload" aria-hidden="true"></i><span>Upload</span>
                            </button>
                        </div>
                    </div>
                </div>
                </div>
            </div>
        }
        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-file-invoice" aria-hidden="true"></i>
                        <span>Upload GST</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong>@ugstCount</strong>
                        </span>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="uploadGstReport" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Month</th>
                                    <th>Year</th>
                                    <th>Status</th>
                                    <th>View</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in ugstRows)
                                {
                                    <tr>
                                        <td title="@item.monthchk">@item.monthchk</td>
                                        <td title="@item.yearchk">@item.yearchk</td>
                                        <td title="@item.status">@item.status</td>
                                        <td>
                                            <button type="button" class="vm-gst-pdf-btn" title="View GST PDF" onclick="show('@item.uploadfile')">
                                                <i class="fa fa-file-pdf-o" aria-hidden="true"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
    <!--orderrecive-->
</section>
<!---------Purchase request send-->
<div class="modal fade saas-admin-modal vm-gst-modal" id="m-d-fund-transfer12" tabindex="-1" role="dialog" data-backdrop="static" aria-labelledby="mdhis">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header saas-admin-modal-header accent-danger">
                <div class="saas-admin-modal-head-main">
                    <div class="saas-admin-modal-icon"><i class="fas fa-file-pdf" aria-hidden="true"></i></div>
                    <div class="saas-admin-modal-title-wrap">
                        <h4 class="modal-title saas-admin-modal-title" id="mdhis">Retailer Upload GST</h4>
                        <p class="saas-admin-modal-subtitle">GST invoice PDF preview</p>
                    </div>
                </div>
                <button type="button" class="saas-admin-modal-close" data-dismiss="modal" aria-label="Close"><i class="fas fa-times" aria-hidden="true"></i></button>
            </div>
            <div class="modal-body saas-admin-modal-body">
                <iframe id="ifrmgst" class="vm-gst-modal-frame" src="about:blank" title="GST PDF preview"></iframe>
            </div>
        </div>
    </div>
</div>


<script src="~/AdminDesign/plugins/jquery/jquery.min.js"></script>
<!-- Custom Js -->
