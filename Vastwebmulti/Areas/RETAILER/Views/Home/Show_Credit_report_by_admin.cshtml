@using Vastwebmulti.Models;
@model IEnumerable<Vastwebmulti.Models.select_retailer_credit_report_by_admin_Result>
@{
    ViewBag.Title = "Show_Credit_report_by_admin";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";
    VastwebmultiEntities DB1 = new VastwebmultiEntities();
    var usernname = DB1.Usernicknames.Where(aa => aa.Role == "Dealer").ToList();
    if (usernname.Count() > 0)
    {
        if (usernname.SingleOrDefault().Role == "Dealer")
        {
          var  favimage = usernname.SingleOrDefault().NickName;
            ViewBag.nickname = favimage;
        }
    }
    Func<object, string> creditVal = v => (v == null || Convert.ToString(v).Trim() == "") ? "No Data Found !" : Convert.ToString(v).Trim();
    string nickName = ViewBag.nickname != null ? Convert.ToString(ViewBag.nickname) : "Distributor";
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=15" rel="stylesheet" />
<link href="~/MainFrontDesign/css/dealer-dth-booking-report-modern.css?v=48" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<style>
    /* Retailer My Credit — premium cards, Help page wali design language (own scope, always wins) */
    .saas-retailer-credit-page .vm-credit-grid { display: grid !important; grid-template-columns: repeat(2, minmax(0, 1fr)) !important; gap: 16px !important; align-items: start !important; }
    .saas-retailer-credit-page .vm-credit-card { min-width: 0 !important; margin: 0 !important; }
    .saas-retailer-credit-page .vm-credit-panel { border: 1px solid #e5e9f2 !important; border-radius: 18px !important; overflow: hidden !important; background: #fff !important; box-shadow: 0 8px 24px rgba(15,23,42,.07) !important; transition: transform .16s ease, box-shadow .16s ease !important; }
    .saas-retailer-credit-page .vm-credit-panel:hover { transform: translateY(-2px) !important; box-shadow: 0 14px 32px rgba(15,23,42,.12) !important; }
    .saas-retailer-credit-page .vm-credit-panel__head { background: #fff !important; border: none !important; border-bottom: 1.5px solid #eef1f6 !important; padding: 14px 16px !important; }
    .saas-retailer-credit-page .vm-opr-table-panel__title { color: #0f172a !important; font-size: 17px !important; font-weight: 800 !important; display: flex !important; align-items: center !important; gap: 12px !important; line-height: 1.3 !important; }
    .saas-retailer-credit-page .vm-opr-table-panel__title i { display: inline-flex !important; width: 36px !important; height: 36px !important; min-width: 36px !important; border-radius: 11px !important; background: linear-gradient(135deg,#eef2ff,#e0e7ff) !important; border: 1px solid #c7d2fe !important; color: #4f46e5 !important; align-items: center !important; justify-content: center !important; font-size: 15px !important; margin: 0 !important; }
    .saas-retailer-credit-page .vm-credit-panel__body { padding: 8px 16px 14px !important; }
    .saas-retailer-credit-page .vm-credit-rows { margin: 0 !important; padding: 0 !important; }
    .saas-retailer-credit-page .vm-credit-row { display: grid !important; grid-template-columns: 150px 1fr !important; gap: 10px !important; padding: 11px 2px !important; border-bottom: 1px dashed #e5e9f2 !important; margin: 0 !important; align-items: center !important; }
    .saas-retailer-credit-page .vm-credit-row:last-child { border-bottom: none !important; }
    .saas-retailer-credit-page .vm-credit-row dt { font-size: 10.5px !important; font-weight: 800 !important; text-transform: uppercase !important; letter-spacing: .5px !important; color: #64748b !important; }
    .saas-retailer-credit-page .vm-credit-row dd { margin: 0 !important; font-size: 13.5px !important; font-weight: 700 !important; color: #0f172a !important; word-break: break-word !important; }
    .saas-retailer-credit-page .vm-credit-row dd.vm-credit-money { font-variant-numeric: tabular-nums !important; }
    .saas-retailer-credit-page .vm-credit-money .fa-inr { font-size: 11.5px !important; color: #64748b !important; margin-right: 2px !important; }
    /* Current credit : bottom highlight bar */
    .saas-retailer-credit-page .vm-credit-total { display: flex !important; align-items: center !important; justify-content: space-between !important; gap: 10px !important; margin: 10px 0 4px !important; padding: 12px 14px !important; border-radius: 13px !important; background: linear-gradient(135deg,#4f46e5,#7c3aed) !important; color: #fff !important; box-shadow: 0 8px 18px rgba(99,102,241,.35) !important; }
    .saas-retailer-credit-page .vm-credit-total__label { font-size: 11px !important; font-weight: 800 !important; text-transform: uppercase !important; letter-spacing: .6px !important; opacity: .9 !important; display: inline-flex !important; align-items: center !important; gap: 8px !important; }
    .saas-retailer-credit-page .vm-credit-total__label i { font-size: 14px !important; }
    .saas-retailer-credit-page .vm-credit-total__value { font-size: 19px !important; font-weight: 800 !important; font-variant-numeric: tabular-nums !important; white-space: nowrap !important; }
    .saas-retailer-credit-page .vm-credit-total__value .fa-inr { font-size: 14px !important; margin-right: 2px !important; }
    .saas-retailer-credit-page .vm-credit-empty { padding: 22px 10px !important; text-align: center !important; color: #94a3b8 !important; font-size: 13px !important; font-weight: 700 !important; }
    @@media screen and (max-width:900px) {
        .saas-retailer-credit-page .vm-credit-grid { grid-template-columns: 1fr !important; }
    }
    @@media screen and (max-width:480px) {
        .saas-retailer-credit-page .vm-credit-row { grid-template-columns: 1fr !important; gap: 3px !important; }
        .saas-retailer-credit-page .vm-credit-total { flex-direction: column !important; align-items: flex-start !important; }
    }
</style>
<script>document.body.classList.add('saas-sell-rch-dp-page', 'saas-dealer-notification-page', 'saas-retailer-credit-page');</script>

<section class="content saas-admin-account-page saas-admin-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-dth-booking-report-page saas-dealer-retailer-index-page saas-dealer-notification-page saas-retailer-credit-page">

    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">
            <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-dr-rem-toolbar-top">
                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>My Credit</li>
                    <li>Show Credit Report By Admin</li>
                </ol>
            </div>
        </div>

        <div class="vm-credit-grid">

            <div class="vm-opr-main-card vm-credit-card">
                <div class="vm-opr-table-panel vm-credit-panel">
                    <div class="vm-opr-table-panel__head vm-dmt-table-panel__head vm-credit-panel__head">
                        <div class="vm-opr-table-panel__title">
                            <i class="fas fa-building" aria-hidden="true"></i>
                            <span>Credit From Company</span>
                        </div>
                    </div>
                    <div class="vm-credit-panel__body">
                        @if (ViewBag.admin != null)
                        {
                            foreach (var item in ViewBag.admin)
                            {
                                <dl class="vm-credit-rows">
                                    <div class="vm-credit-row">
                                        <dt>Company name</dt>
                                        <dd>@creditVal(item.AdminEmail)</dd>
                                    </div>
                                    <div class="vm-credit-row">
                                        <dt>Company mobile no</dt>
                                        <dd>@creditVal(item.Name)</dd>
                                    </div>
                                    <div class="vm-credit-row">
                                        <dt>Current balance</dt>
                                        <dd class="vm-credit-money"><i class="fa fa-inr" aria-hidden="true"></i>@creditVal(item.remain_amount)</dd>
                                    </div>
                                </dl>
                                <div class="vm-credit-total">
                                    <span class="vm-credit-total__label"><i class="fas fa-wallet" aria-hidden="true"></i>Current credit</span>
                                    <span class="vm-credit-total__value"><i class="fa fa-inr" aria-hidden="true"></i>@creditVal(item.cr)</span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="vm-credit-empty">No Data Found !</div>
                        }
                    </div>
                </div>
            </div>

            <div class="vm-opr-main-card vm-credit-card">
                <div class="vm-opr-table-panel vm-credit-panel">
                    <div class="vm-opr-table-panel__head vm-dmt-table-panel__head vm-credit-panel__head">
                        <div class="vm-opr-table-panel__title">
                            <i class="fas fa-user-tie" aria-hidden="true"></i>
                            <span>Credit From @nickName</span>
                        </div>
                    </div>
                    <div class="vm-credit-panel__body">
                        @if (ViewBag.dealer != null)
                        {
                            foreach (var item in ViewBag.dealer)
                            {
                                <dl class="vm-credit-rows">
                                    <div class="vm-credit-row">
                                        <dt>@nickName name</dt>
                                        <dd>@creditVal(item.DLMEmail)</dd>
                                    </div>
                                    <div class="vm-credit-row">
                                        <dt>@nickName mobile no</dt>
                                        <dd>@creditVal(item.DealerName)</dd>
                                    </div>
                                    <div class="vm-credit-row">
                                        <dt>Current balance</dt>
                                        <dd class="vm-credit-money"><i class="fa fa-inr" aria-hidden="true"></i>@creditVal(item.remain_amount)</dd>
                                    </div>
                                </dl>
                                <div class="vm-credit-total">
                                    <span class="vm-credit-total__label"><i class="fas fa-wallet" aria-hidden="true"></i>Current credit</span>
                                    <span class="vm-credit-total__value"><i class="fa fa-inr" aria-hidden="true"></i>@creditVal(item.cr)</span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="vm-credit-empty">No Data Found !</div>
                        }
                    </div>
                </div>
            </div>

        </div>

    </div>
</section>
