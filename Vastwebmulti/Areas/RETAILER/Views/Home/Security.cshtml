@model List<Vastwebmulti.Areas.RETAILER.Models.Securityinfo>

@{

    ViewBag.Title = "Security";

    var plans = Model ?? new List<Vastwebmulti.Areas.RETAILER.Models.Securityinfo>();

    var providerMsg = ViewBag.msg as string;

}



<link href="~/MainFrontDesign/css/retailer-money-transfer-modern.css?v=45" rel="stylesheet" />

<link href="~/MainFrontDesign/css/retailer-security-modern.css?v=2" rel="stylesheet" />



<section class="content vm-security-page">

    <div class="vm-security-shell">

        <div class="vm-security-main-card">

            <header class="vm-security-head">

                <div class="vm-security-head__left">

                    <nav class="vm-security-breadcrumb" aria-label="Breadcrumb">

                        <a href="@Url.Action("Dashboard", "Home")">Home</a>

                        <span class="vm-security-breadcrumb__sep">/</span>

                        <span>Security</span>

                    </nav>

                    <h1 class="vm-security-head__title">

                        <i class="material-icons" aria-hidden="true">verified_user</i>

                        Norton security plans

                    </h1>

                    <p class="vm-security-head__hint">Select a plan, enter customer details, and pay from your wallet balance.</p>

                </div>

                <a class="vm-security-head__report" href="@Url.Action("SecurityReport", "Home")">

                    <i class="material-icons" aria-hidden="true">assessment</i>

                    <span>Security report</span>

                </a>

            </header>



            @if (!string.IsNullOrWhiteSpace(providerMsg))

            {

                <div class="vm-security-empty">

                    <div class="vm-security-empty__icon" aria-hidden="true"><i class="material-icons">cloud_off</i></div>

                    <h3>Plans unavailable</h3>

                    <p>@providerMsg</p>

                </div>

            }

            else if (plans.Count == 0)

            {

                <div class="vm-security-empty">

                    <div class="vm-security-empty__icon" aria-hidden="true"><i class="material-icons">inventory_2</i></div>

                    <h3>No plans found</h3>

                    <p>Security plans are not available right now. Please try again later.</p>

                </div>

            }

            else

            {

                <div class="vm-security-grid">

                    @foreach (var item in plans)

                    {

                        var per = item.Producation_price > 0

                            ? (1 - (item.offer_price) / item.Producation_price) * 100

                            : 0;



                        <article class="vm-security-plan-card">

                            <div class="vm-security-plan-card__top">

                                <img class="vm-security-plan-card__logo" src="~/ashok-images/nortonlifelogo.png" alt="Norton" />

                                <div class="vm-security-plan-card__badges">

                                    <span class="vm-security-plan-card__badge vm-security-plan-card__badge--device">@item.Device device</span>

                                    <span class="vm-security-plan-card__badge vm-security-plan-card__badge--term">@item.Month month</span>

                                </div>

                            </div>

                            <div class="vm-security-plan-card__body">

                                <h2 class="vm-security-plan-card__name">@item.Plan_name</h2>

                                <div class="vm-security-plan-card__pricing">

                                    <div class="vm-security-plan-card__pricing-row">

                                        <span class="vm-security-plan-card__mrp"><del>MRP ₹ @item.Producation_price</del></span>

                                        <span class="vm-security-plan-card__off">@per.ToString("0.##")% OFF</span>

                                    </div>

                                    <span class="vm-security-plan-card__offer">Now ₹ @item.offer_price</span>

                                </div>

                                <p class="vm-security-plan-card__note">Key features — see norton.com for full details.</p>

                                <ul class="vm-security-plan-card__features">

                                    @if (!string.IsNullOrWhiteSpace(item.features1)) { <li>@item.features1</li> }

                                    @if (!string.IsNullOrWhiteSpace(item.features2)) { <li>@item.features2</li> }

                                    @if (!string.IsNullOrWhiteSpace(item.features3)) { <li>@item.features3</li> }

                                    @if (!string.IsNullOrWhiteSpace(item.features4)) { <li>@item.features4</li> }

                                    @if (!string.IsNullOrWhiteSpace(item.features5)) { <li>@item.features5</li> }

                                </ul>

                                <button type="button" class="clickpurchase vm-security-plan-card__buy" data-ssp-code="@item.SSp_Code">

                                    <i class="material-icons" aria-hidden="true">shopping_cart</i>

                                    <span>Purchase now</span>

                                </button>

                            </div>

                        </article>

                    }

                </div>

            }

        </div>

    </div>



    @if (string.IsNullOrWhiteSpace(providerMsg) && plans.Count > 0)

    {

        <div class="vm-security-modals-root" aria-hidden="true">

            @foreach (var item in plans)

            {

                var idmob = item.SSp_Code + "txtmobile";

                var idemail = item.SSp_Code + "txtemail";

                <div class="form-popup purchasemypopup" style="display:none;" role="dialog" aria-modal="true" data-ssp-code="@item.SSp_Code" aria-labelledby="vmSecPurchTitle_@item.SSp_Code">

                    <div class="for-background-clr vm-security-modal">

                        <button type="button" class="vm-security-modal__close purchaseblock" onclick="closeForm()" aria-label="Close">&times;</button>

                        <div class="confirm-purch">

                            <h3 class="vm-security-modal__title" id="vmSecPurchTitle_@item.SSp_Code">Purchase @item.Plan_name</h3>

                            <label class="vm-security-field-label" for="@idmob">Consumer mobile number</label>

                            <input id="@idmob" type="tel" required placeholder="10-digit mobile" maxlength="10" inputmode="numeric" autocomplete="tel" class="vm-security-field" />

                            <label class="vm-security-field-label" for="@idemail">Consumer email ID</label>

                            <input id="@idemail" type="email" required placeholder="Email address" autocomplete="email" class="vm-security-field" />

                            <p class="purchasenote vm-security-modal__note"><strong>Note:</strong> Customer receives the anti-virus key by SMS/email. Do not share it.</p>

                            <div class="buttonbottom vm-security-modal__actions">

                                <button type="button" class="btn purchaseblock vm-security-btn vm-security-btn--ghost" onclick="closeForm()">Cancel</button>

                                <button type="button" onclick="confirm('@item.SSp_Code')" class="rightbuttonpu vm-security-btn vm-security-btn--primary">Continue</button>

                            </div>

                            <span class="errmsg vm-security-modal__error"></span>

                        </div>

                        <div class="purchaseconfirmcheck" style="display:none;">

                            <h3 class="vm-security-modal__title">Confirm purchase</h3>

                            <p><span>Plan name</span><span>@item.Plan_name</span></p>

                            <p><span>Price</span><span>₹ @item.offer_price</span></p>

                            <p><span>Customer mobile</span><span class="c_mobile"></span></p>

                            <p><span>Customer email</span><span class="h_email"></span></p>

                            <p class="purchasenote vm-security-modal__note">Customer receives the key by SMS/email.</p>

                            <div class="buttonbottom vm-security-modal__actions">

                                <button type="button" class="btn purchaseblock vm-security-btn vm-security-btn--ghost" onclick="closeForm()">Cancel</button>

                                <button type="button" onclick="pay('@item.SSp_Code','@item.offer_price','@item.Plan_name','@item.Month','@item.Device')" class="rightbuttonpu vm-security-btn vm-security-btn--primary">Confirm &amp; pay</button>

                            </div>

                            <span class="errmsg vm-security-modal__error"></span>

                        </div>

                        <div class="purchasesucces" style="display:none;">

                            <div class="ghgh vm-security-result vm-security-result--success" style="display:none;">

                                <img src="~/ashok-images/correct.svg" alt="" class="vm-security-result__icon" />

                                <span class="koibhe vm-security-result__title"></span>

                                <p>Purchase complete. Key and PIN sent to customer email.</p>

                            </div>

                            <div class="ghgh1 vm-security-result vm-security-result--pending" style="display:none;">

                                <img src="~/ashok-images/clock.svg" alt="" class="vm-security-result__icon" />

                                <span class="koibhe1 vm-security-result__title"></span>

                                <p>Order pending — check Security report for status.</p>

                            </div>

                            <div class="ghgh2 vm-security-result vm-security-result--failed" style="display:none;">

                                <img src="~/ashok-images/closes.svg" alt="" class="vm-security-result__icon" />

                                <span class="koibhe2 vm-security-result__title"></span>

                                <p>Please read the message and try again.</p>

                            </div>

                            <div class="buttonlastpu vm-security-modal__actions vm-security-modal__actions--stack">

                                <button type="button" class="cancelclasnone vm-security-btn vm-security-btn--ghost" onclick="closeForm()">Close</button>

                                <a href="@Url.Action("SecurityReport", "Home")" class="vm-security-btn vm-security-btn--primary vm-security-btn--link">Go to report</a>

                            </div>

                        </div>

                    </div>

                </div>

            }

        </div>

    }



    <div class="model-drop" style="display:none;" aria-hidden="true"></div>

    <div id="backtodashboardcall" data-request-url="@Url.Action("Dashboard", "Home")"></div>

    <input type="hidden" id="latss" name="latss" />

    <input type="hidden" id="longloc" name="longloc" />

</section>



<div id="loadredmodel" style="display:none;" aria-hidden="true" role="status">

    <div class="vm-security-pay-loader" aria-label="Processing payment"></div>

</div>



@section PostVmScripts {

    <script src="~/Scripts/CheckValidation/valideatelocations.js"></script>

    <script>

        function vmSecurityGetPopup(sspcode) {
            return jQuery('.purchasemypopup').filter(function () {
                return jQuery(this).attr('data-ssp-code') === sspcode;
            });
        }



        function closeForm() {

            jQuery('.purchasemypopup').hide();

            jQuery('.model-drop').hide();

            jQuery('.confirm-purch').show();

            jQuery('.purchaseconfirmcheck').hide();

            jQuery('.purchasesucces').hide();

            jQuery('.ghgh, .ghgh1, .ghgh2').hide();

            jQuery('.errmsg').text('');

            jQuery('body').removeClass('vm-security-modal-open');

        }



        function confirm(sspcode) {

            var mobilecode = '#' + sspcode + 'txtmobile';

            var emailcode = '#' + sspcode + 'txtemail';

            var txtmobile1 = jQuery(mobilecode).val();

            var email = jQuery(emailcode).val();

            var intRegex = /[0-9 -()+]+$/;

            var expr = /^([\w-\.]+)@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([\w-]+\.)+))([a-zA-Z]{2,4}|[0-9]{1,3})(\]?)$/;

            var $popup = vmSecurityGetPopup(sspcode);

            $popup.find('.errmsg').text('');



            if (!intRegex.test(txtmobile1)) {

                $popup.find('.confirm-purch .errmsg').text('Please enter a valid phone number.');

            } else if (txtmobile1.length === 10) {

                if (!expr.test(email)) {

                    $popup.find('.confirm-purch .errmsg').text('Please enter a valid email address.');

                } else {

                    $popup.find('.c_mobile').text(txtmobile1);

                    $popup.find('.h_email').text(email);

                    $popup.find('.purchaseconfirmcheck').show();

                    $popup.find('.confirm-purch').hide();

                }

            } else {

                $popup.find('.confirm-purch .errmsg').text('Please enter a valid 10-digit mobile number.');

            }

        }



        function pay(sspcode, offerprice, planname, month, device) {

            var latss = jQuery('#latss').val();

            var longloc = jQuery('#longloc').val();

            var mobilecode = '#' + sspcode + 'txtmobile';

            var emailcode = '#' + sspcode + 'txtemail';

            var txtmobile = jQuery(mobilecode).val();

            var email = jQuery(emailcode).val();

            var $popup = vmSecurityGetPopup(sspcode);



            jQuery('#loadredmodel').css('display', 'flex');

            $popup.find('.purchaseconfirmcheck').hide();

            if (typeof window.showAdminLoader === 'function') {

                window.showAdminLoader();

            }



            jQuery.ajax({

                type: 'POST',

                url: '@Url.Action("AddPurchase", "Home")',

                data: {

                    sspcode: sspcode,

                    offerprice: offerprice,

                    planname: planname,

                    month: month,

                    txtmobile: txtmobile,

                    email: email,

                    device: device,

                    latss: latss,

                    longloc: longloc

                },

                dataType: 'json',

                cache: false,

                success: function (result) {

                    jQuery('#loadredmodel').hide();

                    if (typeof window.hideAdminLoader === 'function') {

                        window.hideAdminLoader();

                    }

                    $popup.find('.purchasesucces').show();

                    $popup.find('.ghgh, .ghgh1, .ghgh2').hide();



                    if (result === 'DONE') {

                        $popup.find('.koibhe').text('Successfully purchased');

                        $popup.find('.ghgh').show();

                    } else if (result === 'PENDING') {

                        $popup.find('.koibhe1').text('Order pending');

                        $popup.find('.ghgh1').show();

                    } else {

                        $popup.find('.koibhe2').text(result);

                        $popup.find('.ghgh2').show();

                    }

                },

                error: function () {

                    jQuery('#loadredmodel').hide();

                    if (typeof window.hideAdminLoader === 'function') {

                        window.hideAdminLoader();

                    }

                    $popup.find('.purchasesucces').show();

                    $popup.find('.ghgh, .ghgh1, .ghgh2').hide();

                    $popup.find('.koibhe2').text('Request failed. Please try again.');

                    $popup.find('.ghgh2').show();

                }

            });

        }



        jQuery(function ($) {

            $('.clickpurchase').on('click', function () {

                var ssp = $(this).attr('data-ssp-code');

                var $popup = vmSecurityGetPopup(ssp);

                closeForm();

                $popup.find('.confirm-purch').show();

                $popup.find('.purchaseconfirmcheck, .purchasesucces').hide();

                $popup.css('display', 'flex');

                $('.model-drop').show();

                $('body').addClass('vm-security-modal-open');

                $popup.find('.vm-security-field').first().trigger('focus');

            });



            $('.purchaseblock').on('click', function () {

                closeForm();

            });



            $('.cancelclasnone').on('click', function () {

                closeForm();

            });



            $(document).on('keydown', function (e) {

                if (e.key === 'Escape') {

                    closeForm();

                }

            });

        });

    </script>

}

