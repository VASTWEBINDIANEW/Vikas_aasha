<section class="content saas-admin-account-page saas-admin-report-page saas-fund-transfer-page saas-fund-transfer-premium saas-retailer-unload-page">
    <div class="container-fluid vm-ft-page-shell">

        <div class="vm-ft-page-toolbar vm-ft-page-toolbar--premium">
            <div class="vm-ft-page-hero">
                <div>
                    <ol class="vm-ft-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>My Account</li>
                        <li>Wallet Unload</li>
                    </ol>
                </div>
            </div>
            <div class="vm-ft-export-group">
                <button type="button" id="btnExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel"><i class="fas fa-file-excel" aria-hidden="true"></i> Excel</button>
                <button type="button" id="btnPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF"><i class="fas fa-file-pdf" aria-hidden="true"></i> PDF</button>
            </div>
        </div>

        <div class="vm-unload-layout">
            <div class="vm-unload-left">
                <div class="vm-unload-modes">
                    <input type="radio" value="bywalletunload" name="group1" id="bywalletunload" onchange="change('bywalletunload')" checked="">
                    <label for="bywalletunload">POS To Bank Account</label>
                    <input type="radio" value="byposunload" name="group1" onchange="change('byposunload')" id="byposunload">
                    <label for="byposunload">POS To Main Wallet</label>
                    <input type="radio" value="byposDis" name="group1" onchange="change('byposDis')" id="byposDis">
                    <label for="byposDis">POS To Distributor</label>
                </div>

                <div id="WalletUnload">
                    <div class="vm-unload-form-card">
                        <h2>Wallet Unload</h2>
                        @using (Ajax.BeginForm("AddWalletToBankRequest", "Home", new AjaxOptions { HttpMethod = "POST", LoadingElementId = "outer-loader", OnSuccess = "OnSuccess", OnFailure = "OnFailed", OnComplete = "Competetransection" }))
                        {
                            <div class="vm-unload-field">
                                <input class="form-control" id="Amount" name="Amount" onkeypress="return isNumber(event)" placeholder="Enter Amount" required="required" type="text">
                            </div>
                            <div class="vm-unload-field">
                                <select id="Type" name="Type" class="form-control" required="">
                                    <option value="IMPS">IMPS</option>
                                    <option value="NEFT">NEFT</option>
                                </select>
                            </div>
                            <div class="vm-unload-field">
                                @Html.DropDownList("BankAccountNo", (IEnumerable<SelectListItem>)ViewBag.remaccounts, "Select Account No", new { @class = "form-control", required = "required", id = "AccountNo", name = "AccountNo" })
                            </div>
                            if (ViewBag.dmtpin_otp != null)
                            {
                                if (ViewBag.dmtpin_otp.status == true)
                                {
                                    <div class="vm-unload-field" id="otpsubmithideshow" style="display:none;">
                                        <input class="form-control" id="txtdmtpin" name="txtdmtpin" placeholder="Enter OTP" required="required" type="text">
                                    </div>
                                    <div class="vm-unload-field" id="resendotp" style="display:none;">
                                        <a class="vm-unload-otpbtn" style="cursor: pointer;" onclick="otpsend('SECOND','WALLETPINOTP')">Resend OTP</a>
                                    </div>
                                    <div class="vm-unload-field" id="hideshowotpbtn">
                                        <a class="vm-unload-otpbtn" style="cursor: pointer;" onclick="otpsend('FIRST','WALLETPINOTP')">Send OTP</a>
                                    </div>
                                }
                                else
                                {
                                    <div class="vm-unload-field notshowdmttxt" style="display: none">
                                        <input class="form-control" id="txtdmtpin" name="txtdmtpin" placeholder="Enter Transaction Pin" required="required" type="text">
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="vm-unload-field notshowdmttxt" style="display: none">
                                    <input class="form-control" id="txtdmtpin" name="txtdmtpin" placeholder="Enter Transaction Pin" required="required" type="text">
                                </div>
                            }
                            <div id="dmtsuccesscodeotp" class="vm-unload-msg-ok"></div>
                            <div id="dmterrorcodeotp" class="vm-unload-msg-err"></div>
                            <div id="demo" class="vm-unload-msg-err"></div>
                            <div class="vm-unload-field notshowdmttxt11" style="display: none">
                                <label class="form-control" id="lbltransectionid"></label>
                            </div>
                            <div class="vm-unload-field notshowdmttxt" style="display: none">
                                <div>Bank Info</div>
                                <label class="vm-unload-bankinfo" id="lblBankinfo"></label>
                            </div>
                            <div class="vm-unload-field">
                                <label id="errormsg" class="vm-unload-msg-err"></label>
                            </div>
                            <div class="vm-unload-field" id="firsttimeshow">
                                <button type="button" id="btnaskdmtpin" class="vm-unload-btn vm-unload-btn--ghost">Check</button>
                            </div>
                            <div class="vm-unload-field notshowdmttxt" style="display:none;">
                                <button type="submit" id="submit" class="vm-unload-btn">Transfer</button>
                            </div>
                            <input type="hidden" id="Hdtransectionidgen" name="Hdtransectionidgen" value="0" />
                        }
                    </div>
                    <div id="outer-loader" style="display:none;">
                        <div class="vm-upi-loader">
                            <span class="vm-upi-loader-ring"><span></span></span>
                            <span class="vm-upi-loader-txt">Processing...</span>
                            <span class="vm-upi-loader-bar"><span></span></span>
                        </div>
                    </div>
                </div>

                <div id="posunload" style="display:none;">
                    <div class="vm-unload-form-card">
                        <h2>POS Unload</h2>
                        @using (Ajax.BeginForm("AddWalletToPosRequest", "Home", new AjaxOptions { HttpMethod = "POST", LoadingElementId = "outer-loaderpos", OnSuccess = "OnSuccessPOS", OnFailure = "OnFailedPOS", OnComplete = "CompetetransectionPOS" }))
                        {
                            <div class="vm-unload-field">
                                <input class="form-control" id="Amountpos" name="Amountpos" onkeypress="return isNumber(event)" placeholder="Enter Amount" required="required" type="text">
                            </div>
                            if (ViewBag.dmtpin_otp != null)
                            {
                                if (ViewBag.dmtpin_otp.status == true)
                                {
                                    <div class="vm-unload-field" style="display:none;" id="otpsubmithideshowmain">
                                        <input class="form-control" id="txtdmtpinpos" name="txtdmtpinpos" placeholder="Enter OTP" required="required" autocomplete="new-password" type="password" readonly onfocus="this.removeAttribute('readonly');">
                                    </div>
                                    <div class="vm-unload-field" id="resendotpmain" style="display:none;">
                                        <a class="vm-unload-otpbtn" style="cursor: pointer;" onclick="otpsendmain('SECOND','MAINWALLETPINOTP')">Resend OTP</a>
                                    </div>
                                    <div class="vm-unload-field" id="hideshowotpbtnmain">
                                        <a class="vm-unload-otpbtn" style="cursor: pointer;" onclick="otpsendmain('FIRST','MAINWALLETPINOTP')">Send OTP</a>
                                    </div>
                                }
                                else
                                {
                                    <div class="vm-unload-field">
                                        <input class="form-control" id="txtdmtpinpos" name="txtdmtpinpos" placeholder="Enter Transaction Pin" required="required" autocomplete="new-password" type="password" readonly onfocus="this.removeAttribute('readonly');">
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="vm-unload-field">
                                    <input class="form-control" id="txtdmtpinpos" name="txtdmtpinpos" placeholder="Enter Transaction Pin" required="required" autocomplete="new-password" type="password" readonly onfocus="this.removeAttribute('readonly');">
                                </div>
                            }
                            <div id="dmtsuccesscodeotpmain" class="vm-unload-msg-ok"></div>
                            <div id="dmterrorcodeotpmain" class="vm-unload-msg-err"></div>
                            <div id="demomain" class="vm-unload-msg-err"></div>
                            <div class="vm-unload-field">
                                <button type="submit" class="vm-unload-btn">Transfer</button>
                            </div>
                            <div id="outer-loaderpos" style="display:none;">
                                <div class="vm-upi-loader">
                                    <span class="vm-upi-loader-ring"><span></span></span>
                                    <span class="vm-upi-loader-txt">Processing...</span>
                                    <span class="vm-upi-loader-bar"><span></span></span>
                                </div>
                            </div>
                            <div class="vm-unload-field">
                                <label id="errormsgPOS" class="vm-unload-msg-err"></label>
                            </div>
                        }
                    </div>
                </div>

                <div id="tabsmyss1" class="tab-content" style="display:none;">
                    <div class="vm-unload-form-card">
                        <h2>POS To Distributor Unload</h2>
                        @using (Ajax.BeginForm("AddWalletToPosToDistributorrequest", "Home", new AjaxOptions { HttpMethod = "POST", LoadingElementId = "outer-loaderposToDealer", OnSuccess = "OnSuccessPOSToDealer", OnFailure = "OnFailedPOS", OnComplete = "CompetetransectionPOS" }))
                        {
                            <div class="vm-unload-field">
                                <input class="form-control" id="Amountpos1" name="Amountpos1" onkeypress="return isNumber(event)" placeholder="Enter Amount" required="required" type="text">
