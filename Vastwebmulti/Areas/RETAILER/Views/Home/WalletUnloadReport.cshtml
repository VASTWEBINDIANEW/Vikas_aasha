<script>
    function change(chk) {
        if (chk == "bywalletunload") {
            $('#WalletUnload').show();
            $('#tabsmyss1').hide();
            $('#posunload').hide();
            $('#datashowPOS').hide();
            $('#datashowPOS1').hide();
            $('#datashow').show();
        }
        else if (chk == "byposunload") {
            $('#posunload').show();
            $('#WalletUnload').hide();
            $('#tabsmyss1').hide();
            $('#datashowPOS1').hide();
            $('#datashowPOS').show();
            $('#datashow').hide();
        }
        else if (chk == "byposDis") {
            $('#tabsmyss1').show();
            $('#WalletUnload').hide();
            $('#posunload').hide();
            $('#datashowPOS').hide();
            $('#datashowPOS1').show();
            $('#datashow').hide();
        }
    }
</script>

<script>
    function isNumber(evt) {
        var iKeyCode = (evt.which) ? evt.which : evt.keyCode
        if (iKeyCode != 45 && iKeyCode > 31 && (iKeyCode < 48 || iKeyCode > 57))
            return false;
        return true;
    }
</script>

