<script>
    $('#btnaskdmtpin').click(function () {
        $('#Hdtransectionidgen').val(0)
        $('#lbltransectionid').text('')
        $.ajax({
            url: '@Url.Action("GenerateUniqueID")',
            data: { Amount: $('#Amount').val(), Type: $('#Type').val(), AccountNo: $('#AccountNo').val() },
            cache: false,
            type: "POST",
            success: function (data) {
                if (data.sts == 'success') {
                    $('#Hdtransectionidgen').val(data.transferid)
                    $('#lbltransectionid').text(data.transferid)
                    $('#lblBankinfo').html(data.bankdetails)
                    $('#firsttimeshow').hide();
                    $('.notshowdmttxt').show();
                }
            },
            error: function (reponse) {
                alert("error : " + reponse.statusText);
            }
        });
    })
    function Competetransection() {
        $('#Hdtransectionidgen').val(0)
        $('#lbltransectionid').text('')
        $('.notshowdmttxt').hide();
        $('#firsttimeshow').show();
    }
</script>

<script>
    function OnSuccess(data)
    {
        $('#Hdtransectionidgen').val(0)
        $('#lbltransectionid').text('')
        $('.notshowdmttxt').hide();
        $('#firsttimeshow').show();
        $('#Amount').val("");
        var respose = JSON.parse(data);
        if (respose.status == "Success") {
            $('#errormsg').text(respose.Message);
            $("#datashow").load(location.href + " #datashow");
            window.location.href = "@Url.Action("WalletUnloadReport")"
        }
        else if (respose.status == "Failed") {
            $('#errormsg').text(respose.Message);
        }
        else if(respose.status=="Profile") {
            window.location.href = "@Url.Action("Profile")"
        }
    }
    function OnFailed()
    {
        $('#Hdtransectionidgen').val(0)
        $('#lbltransectionid').text('')
        $('.notshowdmttxt').hide();
        $('#firsttimeshow').show();
        $('#errormsg').text("Internal Error");
    }
</script>

