    ViewBag.Title = "Wallet Unload";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";

    var charges = Model != null && Model.Charges != null ? Model.Charges.OrderBy(a => a.AmtFromTatkal).ToList() : null;
}
