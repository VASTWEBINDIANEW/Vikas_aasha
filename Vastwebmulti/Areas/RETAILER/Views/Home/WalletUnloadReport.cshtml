    body.saas-admin-ui .saas-retailer-unload-page .vm-unload-action-btn { display: inline-flex !important; align-items: center !important; gap: 6px !important; min-height: 38px !important; padding: 0 14px !important; border-radius: 9px !important; border: 1px solid #dbe2ec !important; background: #fff !important; color: #475569 !important; font-size: 12.5px !important; font-weight: 800 !important; cursor: pointer !important; }
    body.saas-admin-ui .saas-retailer-unload-page .vm-unload-action-btn:hover { border-color: #2563eb !important; color: #2563eb !important; }
