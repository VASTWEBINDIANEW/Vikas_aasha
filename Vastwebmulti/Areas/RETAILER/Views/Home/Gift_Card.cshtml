<script>
    $(function () {
        if (!$('section.vm-all-cards-page').length) {
            $('body').addClass('vm-all-cards-active');
        }
        $('#defaultModal, #CheckbalModal').removeClass('in show').attr('aria-hidden', 'true').css('display', 'none');
        $('.modal-backdrop').remove();

        function vmGiftSyncTitlePane(tabHref) {
            if (!tabHref) return;
            var key = tabHref.replace('#', '');
            var titleId = key === 'All' ? 'vmGiftTitleAll' : ('vmGiftTitle' + key);
            $('.vm-gift-card-panel__titles > .tab-pane').removeClass('active');
            $('#' + titleId).addClass('active');
        }

        $('#leftulbar a[data-toggle="tab"]').on('shown.bs.tab', function (e) {
            var href = $(e.target).attr('href') || '#All';
            vmGiftSyncTitlePane(href);
            var key = href.replace('#', '');
            if (key !== 'All' && typeof showdata === 'function') {
                var cid = key + '_container';
                if ($('#' + cid).length && $('#' + cid).children().length === 0) {
                    showdata(key);
                }
            }
        });
        vmGiftSyncTitlePane($('#leftulbar li.active a').attr('href') || '#All');
    });
</script>