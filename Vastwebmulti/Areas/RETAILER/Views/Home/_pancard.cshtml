<script>
    function colorchanges(t) {
        var s = document.getElementsByClassName('btmd');
        var s1 = document.getElementsByClassName('manual');
        for (var i = 0; i < s.length; i++) {
            s[i].classList.remove('backgroundss');
            s1[i].style.display = 'none';
        }
        s[t].classList.add('backgroundss');
        s1[t].style.display = 'block';

    }

    function vmRmtPancardSelect2Parent() {
        var $tab = $('#tab-4');
        if ($tab.length) {
            return $tab;
        }
        return $('section.vm-rmt-page').first();
    }

    function vmRmtDestroyPancardSelect2($selects) {
        if (!$selects || !$selects.length || !window.jQuery) {
            return;
        }
        $selects.each(function () {
            var $s = $(this);
            if ($s.hasClass('select2-hidden-accessible')) {
                try {
                    $s.select2('destroy');
                } catch (ignore) { }
            }
            $s.nextAll('.select2-container').remove();
        });
    }

    window.vmRmtInitPancardManualSelect2 = function () {
        if (!window.jQuery || !$.fn.select2) {
            return;
        }
        var $manual = $('#manual');
        if (!$manual.length || $manual.css('display') === 'none') {
            return;
        }
        var $selects = $manual.find('select.vm-rmt-pancard-select');
        $selects.removeAttr('data-no-select2');
        vmRmtDestroyPancardSelect2($selects);
        var opts = { dropdownParent: vmRmtPancardSelect2Parent(), width: '100%' };
        if (typeof window.applyAdminSelect2 === 'function') {
            window.applyAdminSelect2($selects, opts, true);
        } else {
            $selects.select2(opts);
        }
    };

    $(document).off('change.vmRmtPancardFile', '#Corrections .vm-rmt-pancard-file-input');
    $(document).on('change.vmRmtPancardFile', '#Corrections .vm-rmt-pancard-file-input', function () {
        var $wrap = $(this).closest('.vm-rmt-pancard-file-upload');
        var $name = $wrap.find('.vm-rmt-pancard-file-upload__name');
        var placeholder = $name.attr('data-placeholder') || 'No file chosen';
        var file = this.files && this.files[0];
        if (file) {
            $name.text(file.name);
            $wrap.addClass('has-file');
        } else {
            $name.text(placeholder);
            $wrap.removeClass('has-file');
        }
    });

    window.vmRmtInitPancardCorrectionSelect2 = function () {
        if (!window.jQuery || !$.fn.select2) {
            return;
        }
        var $corr = $('#Corrections');
        if (!$corr.length || $corr.css('display') === 'none') {
            return;
        }
        var $selects = $corr.find('select.vm-rmt-pancard-select');
        $selects.removeAttr('data-no-select2');
        vmRmtDestroyPancardSelect2($selects);
        var opts = { dropdownParent: vmRmtPancardSelect2Parent(), width: '100%' };
        if (typeof window.applyAdminSelect2 === 'function') {
            window.applyAdminSelect2($selects, opts, true);
        } else {
            $selects.select2(opts);
        }
    };
</script>

