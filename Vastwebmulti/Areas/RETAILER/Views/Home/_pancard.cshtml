                    $mess.text('Please Enter Aadhaar Card No.');
                }
                else {
                    if (isBlank(panname)) {
                        $mess.text('Please Enter Name');
                    }
                    else {
                        if (isBlank(pandob)) {
                            $mess.text('Please Enter Dob');
                        }
                        else {
                            if (isBlank(panmobno)) {
                                $mess.text('Please Enter Mobile No.');
                            }
                            else {
                                if (isBlank(panfathername)) {
                                    $mess.text('Please Enter Father Name');
                                }
                                else {
                                    if (isBlank(panemail)) {
                                        $mess.text('Please Enter Email id');
                                    }
                                    else {
                                        if (isBlank(pancustmno)) {
                                            $mess.text('Please Enter Customer Mobile No.');
                                        }
                                        else {
                                            if (isBlank(userstate)) {
                                                $mess.text('Please Select State.');
                                            }
                                            else {
                                                $.ajax({
                                                    url: '@Url.Action("pancardmanual", "Home")',
                                                    data: { msts: panmarrigests, adharno: panadharno, name: panname, dob: pandob, mobile: panmobno, father: panfathername, Email: panemail, cmobile: pancustmno, gender: panradio, state: userstate },
                                                    cache: false,
                                                    type: "POST",
                                                    dataType: 'json',
                                                    success: function (data) {
                                                        $mess.text(data.message || '');
                                                        if (data.status === 'Pending' || data.status === 'pending') {
                                                            PANCARD_manual();
                                                        }
                                                    },
                                                    error: function () {
                                                        $mess.text('Unable to submit. Please try again.');
                                                    }
                                                });
                                            }

                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

        }
        function isBlank(str) {
            return (!str || /^\s*$/.test(str));
        }
</script>
