<script>
    function checkstatus() {
        $('#pendingstserror').text('');
        $.ajax({
            url: '@Url.Action("CheckStatus","PANCARD")',
            cache: false,
            type: "POST",
            beforeSend: function () {
                $('.loader').show();
            },
            success: function (data) {
                $('.loader').hide();
                var output = data;
                if (typeof data === 'string') {
                    try {
                        output = JSON.parse(data);
                    } catch (e) {
                        $('#pendingstserror').text('Invalid response from server.');
                        return;
                    }
                }
                if (output.Status == "Success") {
                    PANCARD();
                }
                else {
                    $('#pendingstserror').text(output.Message || 'Status check failed. Please try again.');
                }
            },
            error: function () {
                $('.loader').hide();
                $('#pendingstserror').text('Unable to check status. Please try again.');
            }
        });
    }
</script>
