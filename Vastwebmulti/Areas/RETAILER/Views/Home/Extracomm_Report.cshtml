@model List<Vastwebmulti.Models.daywisecomm>
@using Vastwebmulti.Models
@using Microsoft.AspNet.Identity
@{
    ViewBag.Title = "Extra Commission Report";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";
    VastwebmultiEntities db = new VastwebmultiEntities();

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
    var reports = Model ?? new List<Vastwebmulti.Models.daywisecomm>();
    var rowCount = reports.Count;

    var settleSlabs = db.daywisesettelecomms.ToList();
    var userid = User.Identity.GetUserId();
    var mySlabs = db.daywisecommsetforusers.Where(s => s.userid == userid && s.role == "Retailer").ToList();

    decimal totalComm = 0m;
    foreach (var r in reports) { totalComm += (r.comm ?? 0m); }
}
<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-settings-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-upi-gateway-setting-modern.css?v=8" rel="stylesheet" />
<link href="~/Swalalert/sweetalert.css" rel="stylesheet" />
<style>
    /* Desktop (>=1024px): history table fit-to-width, no scroll */
    @@media (min-width: 1024px) {
        body.saas-admin-ui .saas-retailer-extracomm-page #retailerExtracommReport.vm-opr-data-table {
            width: 100% !important;
            min-width: 0 !important;
            max-width: 100% !important;
            table-layout: fixed !important;
        }
        body.saas-admin-ui .saas-retailer-extracomm-page #retailerExtracommReport.vm-opr-data-table thead tr,
        body.saas-admin-ui .saas-retailer-extracomm-page #retailerExtracommReport.vm-opr-data-table tbody tr {
            display: table-row !important;
        }
        body.saas-admin-ui .saas-retailer-extracomm-page #retailerExtracommReport.vm-opr-data-table thead th,
        body.saas-admin-ui .saas-retailer-extracomm-page #retailerExtracommReport.vm-opr-data-table tbody td {
            display: table-cell !important;
            min-width: 0 !important;
            max-width: none !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            white-space: nowrap !important;
        }
        body.saas-admin-ui .saas-retailer-extracomm-page #retailerExtracommReport.vm-opr-data-table thead th:nth-child(1),
        body.saas-admin-ui .saas-retailer-extracomm-page #retailerExtracommReport.vm-opr-data-table tbody td:nth-child(1) { width: 25% !important; }
        body.saas-admin-ui .saas-retailer-extracomm-page #retailerExtracommReport.vm-opr-data-table thead th:nth-child(2),
        body.saas-admin-ui .saas-retailer-extracomm-page #retailerExtracommReport.vm-opr-data-table tbody td:nth-child(2) { width: 25% !important; }
        body.saas-admin-ui .saas-retailer-extracomm-page #retailerExtracommReport.vm-opr-data-table thead th:nth-child(3),
        body.saas-admin-ui .saas-retailer-extracomm-page #retailerExtracommReport.vm-opr-data-table tbody td:nth-child(3) { width: 25% !important; }
        body.saas-admin-ui .saas-retailer-extracomm-page #retailerExtracommReport.vm-opr-data-table thead th:nth-child(4),
        body.saas-admin-ui .saas-retailer-extracomm-page #retailerExtracommReport.vm-opr-data-table tbody td:nth-child(4) { width: 25% !important; }
    }
    /* Mobile + tablet (<=1023px): natural widths, full text, horizontal scroll */
    @@media (max-width: 1023.98px) {
        body.saas-admin-ui .saas-retailer-extracomm-page #retailerExtracommReport.vm-opr-data-table {
            width: max-content !important;
            min-width: 560px !important;
            max-width: none !important;
            table-layout: auto !important;
        }
        body.saas-admin-ui .saas-retailer-extracomm-page #retailerExtracommReport.vm-opr-data-table thead tr,
        body.saas-admin-ui .saas-retailer-extracomm-page #retailerExtracommReport.vm-opr-data-table tbody tr {
            display: table-row !important;
        }
        body.saas-admin-ui .saas-retailer-extracomm-page #retailerExtracommReport.vm-opr-data-table thead th,
        body.saas-admin-ui .saas-retailer-extracomm-page #retailerExtracommReport.vm-opr-data-table tbody td {
            display: table-cell !important;
            width: auto !important;
            min-width: 0 !important;
            max-width: none !important;
            white-space: nowrap !important;
            overflow: visible !important;
            text-overflow: clip !important;
        }
        body.saas-admin-ui .saas-retailer-extracomm-page .vm-opr-table-scroll {
            overflow-x: auto !important;
        }
    }
    /* Filter card: one-line row with normal gap from upper card */
    body.saas-admin-ui .saas-retailer-extracomm-page .vm-extracomm-filter-card {
        margin-top: 18px !important;
        margin-bottom: 18px !important;
    }
    body.saas-admin-ui .saas-retailer-extracomm-page .vm-extracomm-filter-body {
        display: flex !important;
        flex-wrap: nowrap !important;
        align-items: center !important;
        gap: 10px !important;
        padding: 14px 16px !important;
    }
    body.saas-admin-ui .saas-retailer-extracomm-page .vm-extracomm-filter-body .saas-acc-dp-field {
        flex: 0 0 190px !important;
        min-width: 0 !important;
    }
    @@media (max-width: 767.98px) {
        body.saas-admin-ui .saas-retailer-extracomm-page .vm-extracomm-filter-body {
            flex-wrap: wrap !important;
        }
        body.saas-admin-ui .saas-retailer-extracomm-page .vm-extracomm-filter-body .saas-acc-dp-field {
            flex: 1 1 100% !important;
        }
        body.saas-admin-ui .saas-retailer-extracomm-page .vm-extracomm-filter-body .saas-acc-btn--search {
            width: 100% !important;
            justify-content: center !important;
        }
    }
</style>

<section class="content saas-admin-account-page saas-admin-settings-page saas-upi-gateway-setting-page saas-retailer-extracomm-page">
    <div class="container-fluid">

        <div class="saas-acc-toolbar">
            <ol class="saas-acc-breadcrumb">
                <li><a href="@Url.Action("Dashboard", "Home", new { area = "RETAILER" })"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                <li>Reports</li>
                <li>Extra Commission Report</li>
            </ol>
        </div>

        <div class="saas-acc-table-card">
            <div class="saas-acc-table-card-head">
                <h3><i class="fas fa-sliders-h" aria-hidden="true"></i> Day-wise Settlement Commission</h3>
                <span class="saas-acc-row-count"><i class="fas fa-list" aria-hidden="true"></i> @settleSlabs.Count records</span>
            </div>
            <div class="saas-acc-table-wrap table-responsive">
                <table class="table saas-acc-table table-bordered vm-upi-set-table">
                    <thead>
                        <tr>
                            <th>Days</th>
                            <th>Minimum</th>
                            <th>Maximum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (settleSlabs.Count == 0)
                        {
                            <tr>
                                <td data-label="Days">0</td>
                                <td data-label="Minimum">0</td>
                                <td data-label="Maximum">0</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var s in settleSlabs)
                            {
                                <tr>
                                    <td data-label="Days" class="vm-upi-set-name-cell">@s.dayscounts</td>
                                    <td data-label="Minimum">@s.minamount</td>
                                    <td data-label="Maximum">@s.maxamount</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="saas-acc-table-card">
            <div class="saas-acc-table-card-head">
                <h3><i class="fas fa-percentage" aria-hidden="true"></i> My Commission Slabs</h3>
                <span class="saas-acc-row-count"><i class="fas fa-list" aria-hidden="true"></i> @mySlabs.Count records</span>
            </div>
            <div class="saas-acc-table-wrap table-responsive">
                <table class="table saas-acc-table table-bordered vm-upi-set-table">
                    <thead>
                        <tr>
                            <th>Commission 2000 to 5000</th>
                            <th>Commission 5001 to 10000</th>
                            <th>Commission 10001 to Above</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (mySlabs.Count == 0)
                        {
                            <tr class="vm-opr-table-empty-row">
                                <td colspan="3" class="vm-opr-table-empty vm-dmt-table-empty">
                                    <i class="fas fa-percentage" aria-hidden="true"></i>
                                    <span>No commission slabs found.</span>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var i in mySlabs)
                            {
                                <tr>
                                    <td data-label="Commission 2000 to 5000">@i.Comm_2000_5000 %</td>
                                    <td data-label="Commission 5001 to 10000">@i.Comm_5001_10000 %</td>
                                    <td data-label="Commission 10001 to Above">@i.Comm_10001_max %</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @{
            var extraFormAttrs = new Dictionary<string, object>
            {
                { "id", "retailerExtracommForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-report-date-form", "" },
                { "data-report-from", "#retailer_extra_frm_date" },
                { "data-report-to", "#retailer_extra_to_date" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("Extracomm_Report", "Home", FormMethod.Post, extraFormAttrs))
        {
            <div class="saas-acc-table-card vm-extracomm-filter-card">
                <div class="saas-acc-table-card-head">
                    <h3><i class="fas fa-filter" aria-hidden="true"></i> Filter Commission History</h3>
                </div>
                <div class="vm-extracomm-filter-body">
                    <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                        <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                        @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_extra_frm_date", placeholder = "From", title = "From date" })
                    </div>
                    <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                        <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                        @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_extra_to_date", placeholder = "To", title = "To date" })
                    </div>
                    <button type="submit" name="btntype" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                        <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                    </button>
                </div>
            </div>
        }

        <div class="saas-acc-table-card">
            <div class="saas-acc-table-card-head vm-upi-set-card-head">
                <h3><i class="fas fa-gift" aria-hidden="true"></i> Extra Commission History</h3>
                <div class="vm-upi-set-card-head-actions vm-dmt-table-panel__right">
                    <span class="vm-radiant-record-badge" title="Total records">
                        Records: <strong>@rowCount</strong>
                    </span>
                    <span class="vm-radiant-inline-total" title="Total commission for current filter">
                        Total: <strong>&#8377; @totalComm.ToString("N2")</strong>
                    </span>
                    <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                        <button type="button" id="btnExportRetailerExtracomm" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                            <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                        </button>
                        <button type="button" id="btnPDFRetailerExtracomm" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                            <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                        </button>
                    </div>
                </div>
            </div>
            <div class="saas-acc-table-wrap">
                <div class="table-responsive vm-opr-table-scroll">
                    <table id="retailerExtracommReport" class="table saas-acc-table vm-opr-data-table" cellspacing="0">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Commission&nbsp;&#8377;</th>
                                <th>Remain&nbsp;pre&nbsp;&#8377;</th>
                                <th>Remain&nbsp;post&nbsp;&#8377;</th>
                            </tr>
                        </thead>
                        <tbody id="retailerExtracommRows">
                            @if (reports.Count > 0)
                            {
                                foreach (var i in reports)
                                {
                                    <tr class="vm-dmt-row">
                                        <td class="vm-ticket-time-cell">
                                            <span class="vm-dmt-refno-text">@(i.date.HasValue ? String.Format("{0:dd-MMM-yyyy}", i.date.Value) : "—")</span>
                                        </td>
                                        <td>
                                            <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(i.comm ?? 0m, 2)</span>
                                        </td>
                                        <td>
                                            <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(i.remainpre ?? 0m, 2)</span>
                                        </td>
                                        <td>
                                            <span class="vm-dmt-amount-text"><span class="vm-dmt-rupee">&#8377;</span> @Math.Round(i.remainpost ?? 0m, 2)</span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr class="vm-opr-table-empty-row">
                                    <td colspan="4" class="vm-opr-table-empty vm-dmt-table-empty">
                                        <i class="fas fa-gift" aria-hidden="true"></i>
                                        <span>No extra commission records found.</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</section>

@section PostVmScripts {
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    function downloadRetailerExtracommExcel() {
        var table = document.getElementById('retailerExtracommReport');
        if (!table || !table.tBodies || !table.tBodies[0] || table.tBodies[0].rows.length === 0) {
            alert('No records to export.');
            return;
        }
        var html = '<html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40"><head><meta charset="UTF-8"></head><body>' + table.outerHTML + '</body></html>';
        var blob = new Blob(['\ufeff' + html], { type: 'application/vnd.ms-excel' });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'Extracomm_Report.xls';
        document.body.appendChild(a);
        a.click();
        setTimeout(function () { URL.revokeObjectURL(a.href); a.remove(); }, 100);
    }

    function initRetailerExtracommDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initRetailerExtracommDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm(
                '#retailerExtracommForm',
                '#retailer_extra_frm_date',
                '#retailer_extra_to_date',
                true
            );
        }
    }

    jQuery(function () {
        initRetailerExtracommDatepickers();
        window.setTimeout(initRetailerExtracommDatepickers, 150);
        jQuery('#btnExportRetailerExtracomm').on('click', function (e) {
            e.preventDefault();
            downloadRetailerExtracommExcel();
        });
        jQuery('#btnPDFRetailerExtracomm').on('click', function () {
            window.print();
        });
    });
</script>
}
