                            <div id="Flightreport" class="vm-travel-report-pane vm-travel-report-active" data-travel-report="FLIGHT">
                                <div class="table-responsive flight-responsive travel-page-report vm-travel-report-table-wrap changeback-four-design">
                                    <table id="example" class="table vm-travel-report-table" cellspacing="0">
                                        <thead>
                                            <tr>
                                                <th style="width:110px;">Ticket&nbsp;Status</th>
                                                <th>Passanger&nbsp;Name</th>
                                                <th>Flight</th>
                                                <th>PNR&nbsp;₹</th>
                                                <th>Booking&nbsp;Date</th>
                                                <th>Fare&nbsp;Amount</th>
                                            </tr>
                                        </thead>
                                        <tbody id="trow">
                                            @if (Model.recentflight != null && Model.recentflight.Count() > 0)
                                            {
                                                foreach (var item in Model.recentflight)
                                                {
                                                    var img = "";
                                                    var color = "";
                                                    if (item.TicketStatus.ToUpper() == "FAILED")
                                                    {
                                                        img = "../../ashok-images/closes.svg";
                                                        color = "red";
                                                    }
                                                    else
                                                    {
                                                        img = "../../ashok-images/closes.svg";
                                                        color = "red";

                                                    }
                                                    if (item.TicketStatus.ToUpper() == "PROCCESSED")
                                                    {
                                                        img = "../../ashok-images/clkk.png";
                                                        color = "#FF9800";
                                                    }
                                                    if (item.TicketStatus.ToUpper() == "SUCCESS")
                                                    {
                                                        img = "../../ashok-images/correct.svg";
                                                        color = "green";
                                                    }

                                                    <tr>
