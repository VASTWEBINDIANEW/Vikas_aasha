                if (type == "FLIGHT") {
                    $('#PaymentType2').html(data.PaymentType);
                    $('#Price2').html(data.Price);
                    $('#firstpur2').hide();
                    $('#ALLpur2').hide();
                    $('#BOTHpur2').hide();
                    $('#secpur2').show();
                }
                else if (type == "HOTEL") {
                    $('#PaymentType3').html(data.PaymentType);
                    $('#Price3').html(data.Price);
                    $('#firstpur3').hide();
                    $('#ALLpur3').hide();
                    $('#BOTHpur3').hide();
                    $('#secpur3').show();
                }
                else if (type == "BUS") {
                    $('#PaymentType4').html(data.PaymentType);
                    $('#Price4').html(data.Price);
                    $('#firstpur4').hide();
                    $('#BOTHpur4').hide();
                    $('#ALLpur4').hide();
                    $('#secpur4').show();

                }
                $('#HDServicesname').val(e);
            }
        });
    }
    function FinalPurchase(e) {
         $.ajax({
            url: '@Url.Action("ServicePurchase","Home")',
             data: { Service: $('#HDServicesname').val() },
            cache: false,
            type: "POST",
             dataType: 'json',
            beforeSend: function() {
                      $('.loader').show();
                     },
             success: function (data) {
                 $('.loader').hide();
                 if (data.Status == "Success") {
                     checkservices(e);
                 }
                 else {
                     if (e == "FLIGHT") {
                         $('#errmsgFLIGHT').text(data.Message);
                     }
                     else if (e == "HOTEL") {
                         $('#errmsgHOTEL').text(data.Message);
                     }
                     else if (e == "BUS") {
                         $('#errmsgBUS').text(data.Message);
                     }
                 }

            }
        });
    }
</script>



<script>
    $(document).ready(function () {
            $.ajax({
            url: '@Url.Action("Showtravlessts","Home")',
            data: { type: "FLIGHT" },
            cache: false,
            type: "POST",
            dataType: 'json',
                success: function (data) {
                    if (data == "DONE") {

                        $('#flightservice').show();
                        $('#firstpur2').hide();
                        $('#ALLpur2').hide();
                        $('#BOTHpur2').hide();
                        $('#secpur2').hide();
                    }
                    else if (data == "ALLNOTDONE") {
                        $('#flightservice').hide();
                        $('#firstpur2').hide();
                        $('#ALLpur2').show();
                        $('#BOTHpur2').hide();
                        $('#secpur2').hide();
                    }
                    else if (data == "NOTOK") {

                        $('#flightservice').hide();
                        $('#firstpur2').show();
                        $('#ALLpur2').hide();
                        $('#BOTHpur2').hide();
                        $('#secpur2').hide();

                    }
                    else if (data == "BOTHNOTDONE") {

                        $('#flightservice').hide();
                        $('#firstpur2').hide();
                        $('#ALLpur2').hide();
                        $('#BOTHpur2').show();
                        $('#secpur2').hide();

                    }
                    else {
                        $('#flightservice').hide();
                        $('#firstpur2').show();
                        $('#secpur2').hide();
                    }
            }
        });
    });
</script>

