<script>

    function vmTravelSetActiveReport(serviceKey) {
        var $panes = $('#reportallinone .vm-travel-report-pane');
        $panes.removeClass('vm-travel-report-active');
        if (!serviceKey) return;
        var $match = $panes.filter('[data-travel-report="' + serviceKey + '"]');
        if ($match.length) {
            $match.addClass('vm-travel-report-active');
        }
    }

    function vmTravelSwitchTab(tabId, serviceKey) {
        if (!tabId) return;
        var $scope = $('section.vm-travel-page');
        var $tabs = $scope.find('ul.vm-rmt-service-tabs#tabsmyss > li.vm-rmt-tab-item');
        var $panes = $scope.find('#full.vm-rmt-left-panel .vm-rmt-tab-pane');

        $tabs.removeClass('current').attr('aria-selected', 'false');
        $panes.removeClass('current').attr('aria-hidden', 'true');

        $tabs.filter('[data-tab="' + tabId + '"]').addClass('current').attr('aria-selected', 'true');
        var $activePane = $scope.find('#full.vm-rmt-left-panel #' + tabId);
        $activePane.addClass('current').attr('aria-hidden', 'false');

        if (serviceKey) {
            vmTravelSetActiveReport(serviceKey);
        }

        if (serviceKey === 'IRCTC') {
            checkservicesIRCTC('IRCTC');
        } else if (serviceKey) {
            checkservices(serviceKey);
        }
    }

