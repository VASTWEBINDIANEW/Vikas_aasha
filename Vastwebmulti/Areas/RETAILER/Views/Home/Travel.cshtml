<style>
      /* new css */
    .loader.full {
        transform: translate(-24%,-66%);
        margin: auto;
    }
    .travel-customestart .tab-content, .col-md-4.travel-customestart {
        background: #fff !important;
    }
    .page-header-third .row {
        margin: 0;
    }
    .col-md-4.travel-customestart {
        padding: 0;
    }
      
      /* new css */


    .scrollypy {
        overflow-y: auto !important;
        height: 250px;
    }

    .btmPlusMinus {
        padding: 3px 10px;
        margin-right: 4px;
        padding-bottom: 11px;
        border-radius: 5px;
    }

        .btmPlusMinus i {
            font-size: 10px;
        }

    /* Legacy hotel traveller dropdown only — do not push flight pickers down */
    #hotelservice .header-dropdown .dropdown-menu,
    #hotelservice .dropdown-menu.change-css {
        margin-top: 81px !important;
    }

    .travel-page-report {
        background: #eae9e9;
        min-height: 634px;
    }

        .travel-page-report table tr td img {
            height: 20px;
            width: 20px;
            margin-right: 3px;
            float: left;
        }

        .travel-page-report table tr td {
            padding: 10px 0;
        }
    .packege-first {
        width: 50%;
        float: left;
        margin: 0 !important;
    }
    .packege-first-first {
        padding-left: 0;
    }
    .packege-first-second {
        padding-right: 0;
    }
    .satepackeheform .row .packege-first .hotel-htmlfirst span {
        min-width: auto !important;
        width: 50%;
    }
    .satepackeheform .row .packege-first .hotel-htmlfirst img {
        width: 50% !important;
    }
    .packege-first-first {
        padding-right: 2px;
    }
    .packege-first-second {
        padding-left: 2px;
    }
    .satepackeheform .doc-aligment-pacege-content .packege-first .hotel-htmlfirst span {
        width: auto;
    }
    .packegeimgclass .pandingstatusback {
        background: #FF9800;
        width: 120px;
        height: 120px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        padding: 15px;
        margin-bottom: 20px;
    }
    .packge-pandingstatus img {
        width: 100%;
        margin: 0;
    }
    .packegeimgclass label {
        font-size: 20px;
        text-transform: uppercase;
        letter-spacing: 3px;
    }
</style>

<style>

    .loaderssee {
        position: fixed;
        top: -90px;
        left: 0;
        background-color: rgba(255,255,255,0.7);
        z-index: 999999999999;
        display: none;
        height: 100vw;
        width: 100vw;
    }

    @@-webkit-keyframes spin {
        from {
            -webkit-transform: rotate(0deg);
        }

        to {
            -webkit-transform: rotate(360deg);
        }
    }

    @@keyframes spin {
        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }

    .loaderssee::after {
        content: '';
        display: block;
        position: absolute;
        left: 48%;
        top: 25%;
        width: 100px;
        height: 100px;
        border-style: solid;
        border-color: black;
        border-top-color: transparent;
        border-width: 4px;
        border-radius: 50%;
        -webkit-animation: spin .8s linear infinite;
        animation: spin .8s linear infinite;
    }

    .satepackeheform {
        margin: 0;
    }
        .satepackeheform .row {
            margin: 0 !important;
        }
            .satepackeheform .row .hotel-htmlfirst {
                border: 1px solid #ddd;
                display: flex;
                align-items: center;
                width:100% !important;
                padding:0px !important;
            }
                .satepackeheform .row .hotel-htmlfirst span {
                    background: #f5f5f5;
                    font-size: 14px !important;
                    padding: 8px 10px;
                    min-width: 141px !important;
                    text-align: left;
                }
                .satepackeheform .row .hotel-htmlfirst strong {
                    padding-left: 10px;
                }
    .packegeclassaw-scroll {
        height: 547px;
        overflow-y: auto;
        overflow-x: hidden;
    }
    .satepackeheform .row .hotel-htmlfirst.hotel-htmlfirstimgadd img {
        margin: 0;
        width: 70px;
        float: right;
        height: 36px;
    }
    .satepackeheform .row .hotel-htmlfirst.hotel-htmlfirstimgadd {
        display: block;
    }
    .satepackeheform .hotel-html-responshive-end .row .hotel-htmlfirst span {
        min-width: 170px !important;
        margin: 0;
    }
    .satepackeheform .hotel-html-responshive-end .row .hotel-htmlfirst input {
        border: 0;
        margin: 0 !important;
        height: 36px;
        border-left: 1px solid #ddd;
        box-shadow:none !important;
    }
    .satepackeheform .hotel-html-responshive-end .form-group {
        margin: 0;
        width: 100%;
        float: left;
    }
        .satepackeheform .hotel-html-responshive-end .form-group input {
            float: right;
            padding: 8px 20px;
            background: #a4a0a0;
            border: #a4a0a0;
            color: #333;
            text-transform: uppercase;
            transition: all .4s linear;
        }
    .satepackeheform .row .hotel-htmlfirst span {
        text-transform: capitalize;
    }
    .travel-page-report {
        background: #eae9e9;
        height: 634px;
    }
        .travel-page-report table tr td {
            padding-right: 5px;
            padding-left: 5px !important;
        }


@@media only screen and (max-width:767px){
    .navbar-header .bars {
        top: 6px !important;
    }
}



    @@media screen and (max-width:766px) {
        .fourthdesign-retailer-allnone .body.travel-custome.addtravelcustome.padding-right-none-four {
            padding: 0;
            padding-right: 0px;
        }
        .satepackeheform .row .hotel-htmlfirst {
            display: block;
            text-align: left;
            background: #f5f5f5;
            float: left;
            height: auto;
        }
            .satepackeheform .row .hotel-htmlfirst span, .satepackeheform .row .hotel-htmlfirst strong {
                width: 100% !important;
                height: 36px !important;
                float: left !important;
                display: flex;
                align-items: center;
            }
            .satepackeheform .row .hotel-htmlfirst span {
                border-bottom: 1px solid #ddd;
            }
        .satepackeheform .row .packege-first .hotel-htmlfirst img {
            width: 100% !important;
        }
        .row.doc-aligment-pacege.doc-aligment-pacege-content .packege-first {
            width: 100%;
        }
    }
</style>


