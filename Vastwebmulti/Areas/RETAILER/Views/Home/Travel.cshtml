          function dateFormat(d) {
       return ((d.getMonth() + 1) + "").padStart(2, "0")
          + "/" + (d.getDate() + "").padStart(2, "0")
          + "/" + d.getFullYear();
    }
    Date.prototype.addDays = function(days) {
    var date = new Date(this.valueOf());
    date.setDate(date.getDate() + days);
    return date;
}
    function vmTravelHotelDaysBetween(checkInStr, checkOutStr) {
        var checkIn = new Date(checkInStr);
        var checkOut = new Date(checkOutStr);
        var ms = checkOut.getTime() - checkIn.getTime();
        return Math.round(ms / (1000 * 3600 * 24));
    }
    function vmTravelSetHotelDayCount(rawDays) {
        var days = parseInt(rawDays, 10);
        if (isNaN(days) || days < 1) {
            days = 1;
        }
        $("#txtNights").val(days);
        var unit = $("#txtNightsUnit");
        if (unit.length) {
            unit.text(days === 1 ? "Day" : "Days");
        }
    }
</script>

<script>
    function vmTravelApplyDateMode() {
        var checked = document.querySelector('#flightservice input[name="JourneyType"]:checked');
        if (!checked) return;
        var isRound = checked.value === "2" || checked.value === "5";
        var $block = $('#flightservice .vm-travel-date-block');
        $block.toggleClass('is-oneway', !isRound).toggleClass('is-roundtrip', isRound);

        var $retInput = $('#txt_to_date');
        if (!isRound) {
            $retInput.prop('disabled', true).prop('required', false).removeAttr('required');
        } else {
            $retInput.prop('disabled', false).prop('required', true).attr('required', 'required');
            if (!$retInput.val()) {
                try { $retInput.datepicker('setDate', new Date()); } catch (ex) { }
            }
        }
    }

    $(document).off('change.vmTravelJourney', '#flightservice input[name="JourneyType"]');
    $(document).on('change.vmTravelJourney', '#flightservice input[name="JourneyType"]', function () {
        getvalue();
    });

    function vmTravelUpdateSpecialReturnSummary() {
        var el = document.querySelector('#divForSpacialReturn input[name="ReturnType"]:checked');
        var label = document.getElementById('showSpecialReturnSummary');
        if (!el || !label) return;
        label.textContent = el.value === 'GDS' ? 'GDS Special Return' : 'LCC Special Return';
    }

    function vmTravelResetPickerMenu($dd) {
        if (!$dd || !$dd.length) return;
        $dd.removeClass('vm-travel-picker--up');
        $dd.find('.vm-travel-travellers-menu, .vm-travel-special-menu').css({
            position: '',
            top: '',
            left: '',
            width: '',
            bottom: '',
            margin: '',
            zIndex: '',
            maxHeight: '',
            overflowY: '',
            overflowX: '',
            visibility: '',
            background: '',
            backgroundColor: ''
        });
    }

    function vmTravelScrollPickerMenuIntoPanel($dd, menuSelector) {
        vmTravelResetPickerMenu($dd);
        window.requestAnimationFrame(function () {
            var menuEl = $dd.find(menuSelector)[0];
            var $pane = $dd.closest('.vm-rmt-tab-pane.current');
            var panelEl = $dd.closest('#full.vm-rmt-left-panel')[0];
            if (!menuEl || !$pane.length || !panelEl) return;
            var menuRect = menuEl.getBoundingClientRect();
            var panelRect = panelEl.getBoundingClientRect();
            var pad = 12;
            var overflowTop = panelRect.top + pad - menuRect.top;
            if (overflowTop > 0) {
                $pane[0].scrollTop -= overflowTop;
                menuRect = menuEl.getBoundingClientRect();
            }
            var overflowBottom = menuRect.bottom - panelRect.bottom + pad;
            if (overflowBottom > 0) {
                $pane[0].scrollTop += overflowBottom;
            }
        });
    }

    function vmTravelAlignPickerMenu($dd) {
        if ($dd.hasClass('vm-travel-travellers-dropdown')) {
            vmTravelScrollPickerMenuIntoPanel($dd, '.vm-travel-travellers-menu');
            return;
        }
        if ($dd.hasClass('vm-travel-special-dropdown')) {
            vmTravelScrollPickerMenuIntoPanel($dd, '.vm-travel-special-menu');
            return;
        }

        var $menu = $dd.find('.vm-travel-travellers-menu, .vm-travel-special-menu').first();
        var btn = $dd.find('.vm-travel-picker-trigger')[0];
        if (!$menu.length || !btn) return;

        var $panel = $dd.closest('#full.vm-rmt-left-panel');
        var panelEl = $panel.length ? $panel[0] : null;
        var panelRect = panelEl ? panelEl.getBoundingClientRect() : null;

        var r = btn.getBoundingClientRect();
        var menuWidth = Math.round(r.width);
        if ($dd.hasClass('vm-travel-travellers-dropdown')) {
            menuWidth = Math.max(menuWidth, 280);
        }
        if (panelRect) {
            var panelInner = Math.round(panelRect.width - 20);
            if (menuWidth > panelInner) menuWidth = Math.max(240, panelInner);
        }

        var left = Math.round(r.left);
        var minLeft = panelRect ? Math.round(panelRect.left + 10) : 8;
        var maxLeft = panelRect
            ? Math.round(panelRect.right - menuWidth - 10)
            : window.innerWidth - menuWidth - 8;
        if (left < minLeft) left = minLeft;
        if (left > maxLeft) left = Math.max(minLeft, maxLeft);

        $menu.css({
            position: 'fixed',
            display: 'block',
            visibility: 'hidden',
            top: '0',
            left: '-9999px',
            width: menuWidth + 'px',
            maxHeight: 'none',
            overflowY: 'visible'
        });
        var naturalH = $menu.outerHeight();
        var gap = 6;
        var vh = window.innerHeight || document.documentElement.clientHeight;
        var viewBelow = vh - r.bottom - gap;
        var viewAbove = r.top - gap;
        var panelBelow = panelRect ? panelRect.bottom - r.bottom - gap : viewBelow;
        var panelAbove = panelRect ? r.top - panelRect.top - gap : viewAbove;
        var spaceBelow = Math.max(0, Math.min(viewBelow, panelBelow));
        var spaceAbove = Math.max(0, Math.min(viewAbove, panelAbove));
        var openUp = naturalH > spaceBelow && spaceAbove >= spaceBelow;
        var heightCap = $dd.hasClass('vm-travel-travellers-dropdown') ? 240 : 360;
        var maxH = Math.min(heightCap, Math.max(120, (openUp ? spaceAbove : spaceBelow) - 8));
        var usedH = Math.min(naturalH, maxH);
        var top = openUp
            ? Math.round(r.top - gap - usedH)
            : Math.round(r.bottom + gap);

        if (panelRect) {
            var panelTop = Math.round(panelRect.top + 8);
            var panelBottom = Math.round(panelRect.bottom - 8);
            if (!openUp && top + usedH > panelBottom) {
                var topUp = Math.round(r.top - gap - usedH);
                if (topUp >= panelTop) {
                    openUp = true;
                    top = topUp;
                    maxH = Math.min(heightCap, Math.max(120, r.top - panelTop - gap - 8));
                    usedH = Math.min(naturalH, maxH);
                    top = Math.round(r.top - gap - usedH);
                } else {
                    maxH = Math.min(maxH, Math.max(100, panelBottom - top));
                    usedH = Math.min(naturalH, maxH);
                }
            } else if (openUp && top < panelTop) {
                top = Math.round(r.bottom + gap);
                openUp = false;
                maxH = Math.min(heightCap, Math.max(100, panelBottom - top));
                usedH = Math.min(naturalH, maxH);
            }
        }

        $dd.toggleClass('vm-travel-picker--up', openUp);
        $menu.css({
            position: 'fixed',
            top: Math.max(8, top) + 'px',
            left: left + 'px',
            width: menuWidth + 'px',
            bottom: 'auto',
            margin: 0,
            maxHeight: maxH + 'px',
            overflowY: naturalH > maxH ? 'auto' : 'hidden',
            overflowX: 'hidden',
            visibility: 'visible',
            zIndex: 10050,
            background: '#fff',
            backgroundColor: '#fff'
        });
    }

    function vmTravelCloseFlightPickers($flight) {
        $flight.find('.vm-travel-travellers-dropdown.open, .vm-travel-special-dropdown.open').each(function () {
            var $dd = $(this);
            vmTravelResetPickerMenu($dd);
            $dd.removeClass('open').find('.vm-travel-picker-trigger').attr('aria-expanded', 'false');
        });
        $flight.closest('.vm-rmt-tab-pane').removeClass('vm-travel-tab-pane--picker-open');
    }

    function vmTravelInitFlightPickers() {
        var $flight = $('#flightservice');
        if (!$flight.length) return;

        $(document).off('click.vmTravelFlightPickers', '#flightservice .vm-travel-picker-trigger');
        $(document).on('click.vmTravelFlightPickers', '#flightservice .vm-travel-picker-trigger', function (e) {
            e.preventDefault();
            e.stopPropagation();
            var $dd = $(this).closest('.vm-travel-travellers-dropdown, .vm-travel-special-dropdown');
            var openNow = $dd.hasClass('open');
            vmTravelCloseFlightPickers($flight);
            if (!openNow) {
                $dd.addClass('open');
                $(this).attr('aria-expanded', 'true');
