<div class="loader loaderpancard"></div>
<div class="vm-rao-pane-inner">
    <div id="not_active" style="display: none;">
        <p class="vm-rao-activate-title">Your account is not activated</p>
        <p class="vm-rao-activate-hint">Activate your account first to open saving accounts for customers.</p>
        <span class="text-danger" id="customer_acc_error"></span>
        <button type="button" class="btn" id="account_opening_customer_btn">Activate</button>
    </div>
    <div id="account_opening" style="display: none;">
        <div class="vm-rao-form-head">
            <h3 class="vm-rao-form-head__title">Axis bank saving account opening</h3>
            <p class="vm-rao-form-head__kyc">Please enter correct information as per customer KYC documents below.</p>
        </div>
        <span class="whight_line"></span>
        <div class="form-set_1">
            <form id="account_form">
                <div class="input">
                    <label for="rao_fname">First name</label>
                    <input class="form-control" type="text" name="fname" id="rao_fname" value="" required placeholder="Customer first name" />
                </div>
                <div class="input">
                    <label for="rao_lname">Last name</label>
                    <input class="form-control" type="text" name="lname" id="rao_lname" value="" required placeholder="Customer last name" />
                </div>
                <div class="input">
                    <label for="rao_email">Email</label>
                    <input class="form-control" type="text" name="email" id="rao_email" value="" required placeholder="Customer email" />
                </div>
                <div class="input">
                    <label for="rao_mobile">Mobile</label>
                    <input class="form-control" type="text" name="mobile" id="rao_mobile" value="" required placeholder="10-digit mobile" maxlength="10" oninput="this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\..*)\./g, '$1');" />
                </div>
                <div class="input">
                    <label for="rao_dob">DOB</label>
                    <input class="form-control" type="date" name="dob" id="rao_dob" value="" required />
                </div>
                <div class="input">
                    <label for="rao_pincode">Area pincode</label>
                    <input class="form-control" type="text" name="pincode" id="rao_pincode" value="" required placeholder="6-digit pincode" maxlength="6" oninput="this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\..*)\./g, '$1');" />
                </div>
                <div class="vm-rao-form-actions">
                    <input class="btn" type="button" value="Submit" id="account_submit" />
                    <input class="btn" type="reset" value="Reset" id="account_reset" />
                </div>
                <span class="text-danger" id="account_submit_error"></span>
            </form>
        </div>
    </div>
</div>
