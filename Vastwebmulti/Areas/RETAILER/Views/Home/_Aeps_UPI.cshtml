<script>
    (function () {
        var timerInterval = null;
        var statusCheckInterval = null;
        var TOTAL_SECONDS = 60;
        var STATUS_CHECK_MS = 20000; // 20 sec
        var CIRCUMFERENCE = 144.5; // 2 * PI * 23
        var currentTxnId = null;
        var isFinished = false; // guard so resetForm() never runs twice

        function stopAllTimers() {
            clearInterval(timerInterval);
            clearInterval(statusCheckInterval);
            timerInterval = null;
            statusCheckInterval = null;
        }

        function resetForm(message, type) {
            if (isFinished) return;
            isFinished = true;

            stopAllTimers();

            $("#qrContainer").hide();
            $("#qrImage").attr("src", "");
            $("#btnGenerateQR").prop("disabled", false);
            $("#btnGenerateQR .qrgen-btn-text").text("Generate QR Code");
            $("#txtAmount").prop("readonly", false);
            currentTxnId = null;

            if (message) {
                $("#msgContainer")
                    .removeClass("qrgen-msg-success qrgen-msg-error")
                    .addClass(type === "success" ? "qrgen-msg-success" : "qrgen-msg-error")
                    .text(message)
                    .show();
            }

            AEPSUPI();
        }

        function startTimer(seconds) {
            var remaining = seconds;
            var $ring = $("#qrRingProgress");
            var $timerText = $("#qrTimer");

            $timerText.text(remaining);
            $ring.css("stroke-dashoffset", 0);

            timerInterval = setInterval(function () {
                remaining--;
                $timerText.text(remaining);

                var offset = CIRCUMFERENCE * (1 - remaining / TOTAL_SECONDS);
                $ring.css("stroke-dashoffset", offset);

                if (remaining <= 10) {
                    $ring.css("stroke", "#DC2626");
                }

                if (remaining <= 0) {
                    // Countdown reached 0. If the status-check interval's
                    // final (60s) call hasn't resolved yet, give it a brief
                    // moment; otherwise just terminate here.
                    if (!isFinished) {
                        resetForm(); // expired, no success message
                    }
                }
            }, 1000);
        }

        function checkQRStatus() {
            if (isFinished || !currentTxnId) return;

            $.ajax({
                url: "@Url.Action("CheckAEPSQRStatus", "Home")", // change to your actual status-check endpoint
                type: "POST",
                data: { txnId: currentTxnId },
                dataType: "json",
                success: function (res) {
                    if (isFinished) return; // already terminated by countdown expiry

                    if (res.sts === true) {
                        // Payment confirmed — stop everything now, don't wait for 60s
                        if (res.Status === "Success") {
                            resetForm(res.message || "Payment received successfully.", "success");
                        } else if (res.Status === "Failed") {
                            resetForm(res.message || "Payment failed.", "error");
                        }
                    }
                    // if res.sts === false, do nothing — interval will fire again
                    // at the next 20s mark (or terminate at 60s via the countdown)
                },
                error: function () {
                    // Network/status-check failure: don't kill the QR on a single
                    // failed poll, just let it retry on the next 20s tick or
                    // expire naturally at 60s.
                }
            });
        }

        function startStatusPolling(txnId) {
            currentTxnId = txnId;
            isFinished = false;

            // Fires at 20s, 40s, 60s — the 60s tick coincides with countdown expiry
            statusCheckInterval = setInterval(checkQRStatus, STATUS_CHECK_MS);
        }

        $("#btnGenerateQR").on("click", function () {
            var amount = $("#txtAmount").val();
            $("#msgContainer").hide().removeClass("qrgen-msg-success qrgen-msg-error").text("");
            var amt = parseFloat(amount);
            if (!amount || isNaN(amt) || amt < 100 || amt > 5000) {
                $("#msgContainer").addClass("qrgen-msg-error")
                    .text("Please enter an amount between ₹100 and ₹5000.")
                    .show();
                return;
            }
            

            var $btn = $(this);
            $btn.prop("disabled", true);
            $btn.find(".qrgen-btn-text").text("Generating...");
            $btn.find(".qrgen-spinner").show();

            $.ajax({
                url: "@Url.Action("GenerateAEPSQRCode", "Home")",
                type: "POST",
                data: { amount: amount },
                dataType: "json",
                success: function (res) {
                    $btn.find(".qrgen-spinner").hide();
                    AEPSUPI();
                    if (res.sts === true) {
                        // Lock the form
                        $("#txtAmount").prop("readonly", true);
                        $btn.prop("disabled", true);
                        $btn.find(".qrgen-btn-text").text("Generate QR Code");

                        // Reset ring color/state before showing
                        $("#qrRingProgress").css("stroke", "#1E5EFF");

                        // Show QR
                        $("#qrImage").attr("src", "data:image/png;base64," + res.qrCode);
                        // If your API returns a direct URL instead of base64, use:
                        // $("#qrImage").attr("src", res.qrCode);

                        $("#qrContainer").show();
                   

                        isFinished = false;
                        startTimer(TOTAL_SECONDS);
                        startStatusPolling(res.txnId); // <-- pass whatever unique id your API returns
                    } else {
                        $btn.prop("disabled", false);
                        $btn.find(".qrgen-btn-text").text("Generate QR Code");
                        $("#msgContainer").addClass("qrgen-msg-error").text(res.message || "Failed to generate QR code.").show();
                    }
                },
                error: function () {
                    $btn.prop("disabled", false);
                    $btn.find(".qrgen-btn-text").text("Generate QR Code");
                    $("#msgContainer").addClass("qrgen-msg-error").text("Something went wrong. Please try again.").show();
                }
            });
        });
    })();
</script>

<script>
    function AEPSUPI() {
        $.ajax({
            url: '@Url.Action("AEPSUPIreportnew", "Home")',
            cache: false,
            type: "GET",
            cache: false,
            dataType: "html",
            success: function (data) {
                $('#reportallinone').html(data);
            }
        })
    }
    
</script>