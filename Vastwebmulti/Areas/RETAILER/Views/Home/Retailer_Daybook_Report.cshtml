<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-retailer-ecomm-transaction-page saas-retailer-daybook-page">

    <div class="container-fluid vm-opr-page-shell">

        @{
            var daybookFormAttrs = new Dictionary<string, object>
            {
                { "id", "retailerDaybookForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-report-date-form", "" },
                { "data-report-from", "#retailer_daybook_frm_date" },
                { "data-report-to", "#retailer_daybook_to_date" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("Retailer_Daybook_Report", "Home", FormMethod.Post, daybookFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home", new { area = "RETAILER" })"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>My Account</li>
                        <li>Day Book</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters vm-ecomm-filter-row--one-line">

                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_daybook_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_daybook_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                    </div>

                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="retailerDaybookTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Daybook totals</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideRetailerDaybookTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid vm-radiant-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Total opening bal</span>
                            <strong class="vm-opr-total-card__value">&#8377; @totalOpen.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Total closing bal</span>
                            <strong class="vm-opr-total-card__value">&#8377; @totalClose.ToString("N2")</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Records</span>
                            <strong class="vm-opr-total-card__value">@rowCount</strong>
                        </div>
                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-book-open" aria-hidden="true"></i>
                        <span>Day book report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong>@rowCount</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-ecomm-totals-btn" onclick="showRetailerDaybookTotals()" title="Show totals" aria-expanded="false" aria-controls="retailerDaybookTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            </button>
                            <button type="button" id="btnExportRetailerDaybook" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" id="btnPDFRetailerDaybook" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="retailerDaybookReport" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Firm Name</th>
                                    <th>Recharge &amp; Bill</th>
                                    <th>IMPS</th>
                                    <th>AEPS</th>
                                    <th>M-POS</th>
                                    <th>Pancard</th>
                                    <th>Travel</th>
                                    <th>Purchase</th>
                                    <th>Opening Bal</th>
                                    <th>Closing Bal</th>
                                    <th>Old Day Refund</th>
                                    <th>Old Day Failed</th>
                                    <th>Diff</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (isLive)
                                {
                                    foreach (var item in Model.Daybooklive)
                                    {
                                        string firmName = item.Frm_Name == null ? Convert.ToString(item.RetailerName) : Convert.ToString(item.Frm_Name);
                                        string diffCls = "";
                                        try { if (Convert.ToDecimal(item.DIFF) < 0) { diffCls = "vm-db-neg"; } } catch { }
                                        <tr class="vm-dmt-row">
                                            <td><span class="vm-dmt-consumer-text" title="@firmName">@firmName</span></td>
                                            <td><span class="vm-dmt-amount-text">@item.RCH</span></td>
                                            <td><span class="vm-dmt-amount-text">@item.IMPS</span></td>
                                            <td><span class="vm-dmt-amount-text">@item.AEPS</span></td>
                                            <td><span class="vm-dmt-amount-text vm-db-zero">0.00</span></td>
                                            <td><span class="vm-dmt-amount-text">@item.PAN</span></td>
                                            <td><span class="vm-dmt-amount-text vm-db-zero">0.00</span></td>
                                            <td><span class="vm-dmt-amount-text">@item.PURCHASE</span></td>
                                            <td><span class="vm-dmt-amount-text">@item.openbal</span></td>
                                            <td><span class="vm-dmt-amount-text">@item.closebal</span></td>
                                            <td><span class="vm-dmt-amount-text">@item.OLDDAYREFUND</span></td>
                                            <td><span class="vm-dmt-amount-text">@item.OLDDAYFAILED</span></td>
                                            <td><span class="vm-dmt-amount-text @diffCls">@item.DIFF</span></td>
                                        </tr>
                                    }
                                }
                                else if (Model != null && Model.DayboolOLD != null)
                                {
                                    foreach (var item in Model.DayboolOLD)
                                    {
                                        string firmName = item.Frm_Name == null ? Convert.ToString(item.RetailerName) : Convert.ToString(item.Frm_Name);
                                        string diffCls = "";
                                        try { if (Convert.ToDecimal(item.DIFF) < 0) { diffCls = "vm-db-neg"; } } catch { }
                                        <tr class="vm-dmt-row">
                                            <td><span class="vm-dmt-consumer-text" title="@firmName">@firmName</span></td>
                                            <td><span class="vm-dmt-amount-text">@item.RCH</span></td>
                                            <td><span class="vm-dmt-amount-text">@item.IMPS</span></td>
                                            <td><span class="vm-dmt-amount-text">@item.AEPS</span></td>
                                            <td><span class="vm-dmt-amount-text vm-db-zero">0.00</span></td>
                                            <td><span class="vm-dmt-amount-text">@item.PAN</span></td>
                                            <td><span class="vm-dmt-amount-text vm-db-zero">0.00</span></td>
                                            <td><span class="vm-dmt-amount-text">@item.PURCHASE</span></td>
                                            <td><span class="vm-dmt-amount-text">@item.openbal</span></td>
                                            <td><span class="vm-dmt-amount-text">@item.closebal</span></td>
                                            <td><span class="vm-dmt-amount-text">@item.OLDDAYREFUND</span></td>
                                            <td><span class="vm-dmt-amount-text">@item.OLDDAYFAILED</span></td>
                                            <td><span class="vm-dmt-amount-text @diffCls">@item.DIFF</span></td>
                                        </tr>
                                    }
                                }
                                @if (rowCount == 0)
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="13" class="vm-opr-table-empty vm-dmt-table-empty">
                                            <i class="fas fa-book-open" aria-hidden="true"></i>
                                            <span>No daybook records found.</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section PostVmScripts {
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    function hideRetailerDaybookTotals() {
        var $panel = jQuery('#retailerDaybookTotalsPanel');
        var $btn = jQuery('.saas-retailer-daybook-page .vm-ecomm-totals-btn');
        $panel.hide().attr('aria-hidden', 'true');
        $btn.attr('aria-expanded', 'false');
    }

    function showRetailerDaybookTotals() {
        var $panel = jQuery('#retailerDaybookTotalsPanel');
        var $btn = jQuery('.saas-retailer-daybook-page .vm-ecomm-totals-btn');
        if ($panel.is(':visible')) {
            hideRetailerDaybookTotals();
            return;
        }
        $panel.show().attr('aria-hidden', 'false');
        $btn.attr('aria-expanded', 'true');
    }

    function retailerDaybookDates() {
        return {
            txt_frm_date: jQuery('#retailer_daybook_frm_date').val() || '',
            txt_to_date: jQuery('#retailer_daybook_to_date').val() || ''
        };
    }

    function initRetailerDaybookDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initRetailerDaybookDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm(
                '#retailerDaybookForm',
                '#retailer_daybook_frm_date',
                '#retailer_daybook_to_date',
                true
            );
        }
    }

    jQuery(function () {
        initRetailerDaybookDatepickers();
        window.setTimeout(initRetailerDaybookDatepickers, 150);
        jQuery('#btnExportRetailerDaybook').on('click', function (e) {
            e.preventDefault();
            var d = retailerDaybookDates();
            location.href = '@Url.Action("Excel_Retailer_Daybook_Report", "Home")?txt_frm_date=' + encodeURIComponent(d.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(d.txt_to_date);
        });
        jQuery('#btnPDFRetailerDaybook').on('click', function () {
            var d = retailerDaybookDates();
            window.open('@Url.Action("PDF_Retailer_Day_Book_Report", "Home")?txt_frm_date=' + encodeURIComponent(d.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(d.txt_to_date), '_blank');
        });
    });
</script>
}
