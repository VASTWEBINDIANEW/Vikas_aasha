@model Vastwebmulti.Areas.RETAILER.Models.Daybookretailerrreport
@using System.Linq
@using System.Collections.Generic
@{
    ViewBag.Title = "Retailer_Daybook_Report";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";

    var frmDate = (Request["txt_frm_date"] ?? "").Trim();
    var toDate = (Request["txt_to_date"] ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); }

    var dateMode = ViewBag.chk != null && ViewBag.chk.ToString() == "post" ? "post" : "get";
    bool isLive = Model != null && Model.Daybooklive != null;
    int rowCount = 0;
    decimal totalOpen = 0m, totalClose = 0m;
    try
    {
        if (isLive) { rowCount = Model.Daybooklive.Count(); }
        else if (Model != null && Model.DayboolOLD != null) { rowCount = Model.DayboolOLD.Count(); }
    }
    catch { }
    try
    {
        if (isLive)
        {
            foreach (var m in Model.Daybooklive)
            {
                try { totalOpen += Convert.ToDecimal(m.openbal); } catch { }
                try { totalClose += Convert.ToDecimal(m.closebal); } catch { }
            }
        }
        else if (Model != null && Model.DayboolOLD != null)
        {
            foreach (var m in Model.DayboolOLD)
            {
                try { totalOpen += Convert.ToDecimal(m.openbal); } catch { }
                try { totalClose += Convert.ToDecimal(m.closebal); } catch { }
            }
        }
    }
    catch { }
}
