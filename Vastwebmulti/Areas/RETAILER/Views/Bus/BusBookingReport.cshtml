            </div>
        </div>
    </div>
</div>

@section PostVmScripts {
<script src="~/Swalalert/sweetalert-dev.js"></script>
<script>
    var retailerBusPageIndex = 2;
    var retailerBusNoMore = false;
    var retailerBusBusy = false;

    function retailerBusFilters() {
        return {
            txt_frm_date: jQuery('#retailer_bus_frm_date').val() || '',
            txt_to_date: jQuery('#retailer_bus_to_date').val() || '',
            ddl_status: jQuery('#ddl_status').val() || 'ALL'
        };
    }

    function hideRetailerBusTotals() {
        var $panel = jQuery('#retailerBusTotalsPanel');
        var $btn = jQuery('.vm-bus-totals-btn');
        $panel.removeClass('is-open').hide().attr('aria-hidden', 'true');
        $btn.removeClass('is-active').attr({ title: 'Show totals', 'aria-expanded': 'false' });
    }

    function calcRetailerBusTotals() {
        var success = 0, failed = 0, pending = 0;
        jQuery('#retailerBusRows tr.vm-dmt-row').each(function () {
            var amt = parseFloat(jQuery(this).attr('data-amount')) || 0;
            var st = (jQuery(this).attr('data-status') || '').toUpperCase();
            if (st === 'SUCCESS') { success += amt; }
            else if (st === 'FAILED') { failed += amt; }
            else { pending += amt; }
        });
        jQuery('#retailerBusSuccess').html('&#8377; ' + success.toFixed(2));
        jQuery('#retailerBusFailed').html('&#8377; ' + failed.toFixed(2));
        jQuery('#retailerBusPending').html('&#8377; ' + pending.toFixed(2));
    }

    function FindtotalRetailerBus() {
        var $panel = jQuery('#retailerBusTotalsPanel');
        var $btn = jQuery('.vm-bus-totals-btn');
        if ($panel.hasClass('is-open')) {
            hideRetailerBusTotals();
            return;
        }
        $panel.addClass('is-open').show().attr('aria-hidden', 'false');
        $btn.addClass('is-active').attr({ title: 'Hide totals', 'aria-expanded': 'true' });
        calcRetailerBusTotals();
    }

    function BookingDetails(id) {
        jQuery('#loadermoney').show();
        var url = '@Url.Action("getBookingDetails", "Bus")';
        jQuery.post(url, { TraceId: id }, function (data) {
            var response = JSON.parse(data);
            if (response.Status == "Success") {
                jQuery('#loadermoney').hide();
                if (response.Message.Error.ErrorCode == 0) {
                    jQuery("#spanSourceCityName").html(response.Message.Itinerary.Origin);
                    jQuery("#spanDepartureDateTime").html(response.Message.Itinerary.DepartureTime + "," + response.Message.Itinerary.DateOfJourney);
                    jQuery("#spanDestinationCityName").html(response.Message.Itinerary.Destination);
                    jQuery("#spanArrivalDateTime").html(response.Message.Itinerary.ArrivalTime);
                    jQuery("#spanBoardingPoint").html(response.Message.Itinerary.BoardingPointdetails.CityPointName);
                    jQuery("#spanBoardingcontantno").html(response.Message.Itinerary.BoardingPointdetails.CityPointContactNumber);
                    jQuery("#spanDroppingPoint").html(response.Message.Itinerary.BoardingPointdetails.CityPointLandmark);
                    jQuery("#spanBusOptName").html(response.Message.Itinerary.TravelName);
                    jQuery("#spanTicketNum").html(response.Message.Itinerary.TicketNo);
                    jQuery("#spanPNR").html(response.Message.Itinerary.TravelOperatorPNR);
                    jQuery("#spanBaseFare").html(response.Message.Itinerary.Price.BasePrice);
                    jQuery("#spanTaxAmount").html(parseInt(response.Message.Itinerary.Price.OtherCharges + response.Message.Itinerary.Price.Tax));
                    jQuery("#spanTotalFareWithTax").html(response.Message.Itinerary.Price.PublishedPriceRoundedOff);
                    var tabRow = '';
                    var PaxCount = 1;
                    response.Message.Itinerary.Passenger.forEach(function (entry) {
                        var Paxgender = entry.Gender == "1" ? "Male" : "Female";
                        tabRow = tabRow + '<tr><th scope="row">' + PaxCount + '</th><td>' + entry.FirstName + ' ' + entry.LastName + '</td><td>' + entry.Seat.SeatName + '</td><td>' + Paxgender + '</td></tr>';
                        PaxCount = PaxCount + 1;
                    });
                    jQuery("#travellerDetails").html(tabRow);
                    jQuery("#BookingDetailsModel").modal('show');
                } else {
                    swal("Oops!!!", response.Message.Error.ErrorMessage, "error");
                }
            }
            else {
                jQuery('#loadermoney').hide();
                swal("Oops!!!", response.Message, "error");
            }
        })
        .fail(function (jqXHR) {
            jQuery('#loadermoney').hide();
            swal("Oops!!!", jqXHR.responseText, "error");
        });
    }

    function CancelBooking(id, bid, tcno) {
        swal({
            title: 'Are you sure?',
            text: 'Once cancelled, You will not be able to recover this again!',
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dd6b55',
            cancelButtonColor: '#999',
            confirmButtonText: 'Yes!',
            cancelButtonText: 'No',
            closeOnConfirm: false
        }, function (data) {
            if (data == true) {
                CancelBookingConfirm(id, bid, tcno);
            }
        });
    }

    function CancelBookingConfirm(id, bid, tcno) {
        try {
            jQuery('#loadermoney').show();
            var url = '@Url.Action("seatCancellationConfirm", "Bus")';
            jQuery.post(url, { TraceId: id, BusId: bid, Ticketno: tcno }, function (data) {
                jQuery('#loadermoney').hide();
                var response = JSON.parse(data);
                if (response.Status == "Success") {
                    if (response.Message.Content.Addinfo.Error.ErrorCode == 0) {
                        swal("Wow!!!", "Ticket cancellation proceeded successfully", "success");
                        setTimeout(function () {
                            location.reload();
                        }, 5000);
                    } else {
                        swal("Oops!!!", response.Message.Content.Addinfo.Error.ErrorMessage, "error");
                    }
                }
                else {
                    swal("Oops!!!", response.Message, "error");
                }
            })
            .fail(function (jqXHR) {
                jQuery('#loadermoney').hide();
                swal("Oops!!!", jqXHR.responseText, "error");
            });
        } catch (err) {
            jQuery('#loadermoney').hide();
            console.log('Error : ' + err.message);
        }
    }

    function initRetailerBusSelect2() {
        jQuery('#ddl_status').each(function () {
            var $el = jQuery(this);
            if (!$el.length || !jQuery.fn.select2) { return; }
            if ($el.hasClass('select2-hidden-accessible')) {
                try { $el.select2('destroy'); } catch (e) { }
            }
            $el.select2({ width: '100%', minimumResultsForSearch: 6 });
        });
    }

    function initRetailerBusDatepickers() {
        if (!window.jQuery || !jQuery.fn || !jQuery.fn.datepicker) {
            window.setTimeout(initRetailerBusDatepickers, 50);
            return;
        }
        if (typeof window.initAdminReportDateForm === 'function') {
            window.initAdminReportDateForm(
                '#retailerBusReportForm',
                '#retailer_bus_frm_date',
                '#retailer_bus_to_date',
                true
            );
        }
    }

    jQuery(function () {
        var sts = '@ViewData["status"]';
        var errormsg = '@ViewData["Message"]';
        if (sts == "Failed" && sts != "") {
            swal("Oops!..", errormsg, "error");
        }
        initRetailerBusSelect2();
        initRetailerBusDatepickers();
        window.setTimeout(initRetailerBusDatepickers, 150);

        jQuery('#btnRetailerBusExport').on('click', function (e) {
            e.preventDefault();
            var f = retailerBusFilters();
            location.href = '@Url.Action("Excel_Ticketbus_Report", "Bus")?txt_frm_date=' + encodeURIComponent(f.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(f.txt_to_date) + '&ddl_status=' + encodeURIComponent(f.ddl_status);
        });
        jQuery('#btnRetailerBusPDF').on('click', function () {
            var f = retailerBusFilters();
            window.open('@Url.Action("PDF_TicketBusReport", "Bus")?txt_frm_date=' + encodeURIComponent(f.txt_frm_date) + '&txt_to_date=' + encodeURIComponent(f.txt_to_date) + '&ddl_status=' + encodeURIComponent(f.ddl_status), '_blank');
        });

        jQuery(window).on('scroll', function () {
            if (retailerBusNoMore || retailerBusBusy) { return; }
            var nearBottom = jQuery(window).scrollTop() + jQuery(window).height() > jQuery(document).height() - 400;
            if (!nearBottom) { return; }
            retailerBusBusy = true;
            jQuery('#retailerBusLoading').show();
            var f = retailerBusFilters();
            jQuery.post('@Url.Action("InfiniteScroll_bus", "Bus")',
                { pageindex: retailerBusPageIndex, ddl_status: f.ddl_status, frm_date: f.txt_frm_date, to_date: f.txt_to_date },
                function (data) {
                    retailerBusPageIndex = retailerBusPageIndex + 1;
                    retailerBusNoMore = data.NoMoredata;
                    var html = data.HTMLString || '';
                    if (html && html.indexOf('vm-opr-table-empty-row') === -1) {
                        jQuery('#retailerBusRows .vm-opr-table-empty-row').remove();
                        jQuery('#retailerBusRows').append(html);
                    } else {
                        retailerBusNoMore = true;
                    }
                    jQuery('#retailerBusLoading').hide();
                    retailerBusBusy = false;
                })
                .fail(function () {
                    jQuery('#retailerBusLoading').hide();
                    retailerBusBusy = false;
                });
        });
    });
</script>
}
