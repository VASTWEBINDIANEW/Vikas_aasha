<div id="loadermoney" class="vm-dmt-loader" style="display:none;" aria-hidden="true">
    <div class="vm-dmt-loader__panel" role="status" aria-live="polite" aria-label="Processing">
        <div class="vm-dmt-table-loader__spinner" aria-hidden="true"></div>
        <span class="vm-dmt-loader__text">Please wait…</span>
    </div>
</div>

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-bus-booking-report-page saas-retailer-bus-report-page">
    <div class="container-fluid vm-opr-page-shell">

        @{
            var busFormAttrs = new Dictionary<string, object>
            {
                { "id", "retailerBusReportForm" },
                { "class", "vm-rpt-filters-panel__form" },
                { "data-report-date-form", "" },
                { "data-report-from", "#retailer_bus_frm_date" },
                { "data-report-to", "#retailer_bus_to_date" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("BusBookingReport", "Bus", FormMethod.Post, busFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified">
                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line">
                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home")"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Travel &amp; Hotels</li>
                        <li>Bus Booking Report</li>
                    </ol>
                    <div class="vm-dmt-fin-nav-row vm-ticket-travel-nav-row">
                        @Html.Partial("_Buspartialmenu")
                    </div>
                </div>

                <div class="vm-opr-totals-panel vm-dmt-totals-panel" id="retailerBusTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-dmt-totals-head">
                        <div class="vm-dmt-totals-head__title">
                            <i class="fas fa-chart-pie" aria-hidden="true"></i>
                            <span>Booking totals (loaded rows)</span>
                        </div>
                        <button type="button" class="vm-dmt-totals-hide-btn" onclick="hideRetailerBusTotals()" title="Hide totals" aria-label="Hide totals">
                            <i class="fas fa-chevron-up" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-opr-totals-grid vm-dmt-totals-grid">
                        <div class="vm-opr-total-card vm-opr-total-card--success">
                            <span class="vm-opr-total-card__label">Success</span>
                            <strong class="vm-opr-total-card__value" id="retailerBusSuccess">&#8377; 0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--failed">
                            <span class="vm-opr-total-card__label">Failed</span>
                            <strong class="vm-opr-total-card__value" id="retailerBusFailed">&#8377; 0.00</strong>
                        </div>
                        <div class="vm-opr-total-card vm-opr-total-card--pending">
                            <span class="vm-opr-total-card__label">Pending</span>
                            <strong class="vm-opr-total-card__value" id="retailerBusPending">&#8377; 0.00</strong>
                        </div>
                    </div>
                </div>

                <div class="vm-rpt-filters-panel">
                    <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--bus vm-rpt-filters-panel__bar">
                        <div class="vm-opr-field vm-dmt-field" id="sts">
                            @Html.DropDownList("ddl_status", new List<SelectListItem>
                            {
                                new SelectListItem { Text = "All Status", Value = "ALL", Selected = (selStatus == "ALL") },
                                new SelectListItem { Text = "Success", Value = "Confirmed", Selected = selStatus == "Confirmed" },
                                new SelectListItem { Text = "Pending", Value = "Proccessed", Selected = selStatus == "Proccessed" },
                                new SelectListItem { Text = "Failed", Value = "FAILED", Selected = selStatus == "FAILED" }
                            }, new { id = "ddl_status", @class = "vm-opr-select vm-dmt-select form-control", title = "Status" })
                        </div>
                        <div class="vm-dmt-filter-search-group">
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_frm_date", frmDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_bus_frm_date", placeholder = "From", title = "From date" })
                            </div>
                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-opr-field vm-dmt-field--date">
                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar"></i></span>
                                @Html.TextBox("txt_to_date", toDate, new { @class = "form-control saas-acc-dp-input", required = "required", autocomplete = "off", id = "retailer_bus_to_date", placeholder = "To", title = "To date" })
                            </div>
                            <button type="submit" value="Old" name="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="vm-opr-main-card">
            <div class="vm-opr-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-bus" aria-hidden="true"></i>
                        <span>Bus booking report</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-opr-icon-btn vm-opr-totals-btn vm-dmt-totals-btn vm-bus-totals-btn" onclick="FindtotalRetailerBus()" title="Show totals" aria-expanded="false" aria-controls="retailerBusTotalsPanel"><i class="fas fa-chart-pie" aria-hidden="true"></i></button>
                            <button type="button" id="btnRetailerBusExport" class="saas-acc-btn saas-acc-btn--excel" title="Export Excel"><i class="fas fa-file-excel" aria-hidden="true"></i> Excel</button>
                            <button type="button" id="btnRetailerBusPDF" class="saas-acc-btn saas-acc-btn--pdf" title="Export PDF"><i class="fas fa-file-pdf" aria-hidden="true"></i> PDF</button>
                        </div>
                    </div>
                </div>
                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="busBookingReport" class="table vm-opr-data-table" cellspacing="0" style="width:100%;">
                            <thead>
                                <tr>
                                    <th>Status</th>
                                    <th>Ticket Status</th>
                                    <th>Passenger Name</th>
                                    <th>Source (From)</th>
                                    <th>Destination (To)</th>
                                    <th>Date Of Journey</th>
                                    <th>Fare &#8377;</th>
                                    <th>Pre &#8377;</th>
                                    <th>Post &#8377;</th>
                                    <th>Income &#8377;</th>
                                    <th>PNR</th>
                                    <th>Booking Date</th>
                                    <th>Current Status</th>
                                    <th>Cancel</th>
                                    <th>Print</th>
                                </tr>
                            </thead>
                            <tbody id="retailerBusRows">
                                @{ Html.RenderAction("_ticketbusreport", "Bus", new { txt_frm_date = frmDate, txt_to_date = toDate, ddl_status = selStatus }); }
                            </tbody>
                        </table>
                        <div id="retailerBusLoading" class="vm-opr-table-loading vm-dmt-table-loading" style="display:none;">
                            <div class="vm-dmt-table-loader" role="status" aria-live="polite" aria-label="Loading bookings">
                                <div class="vm-dmt-table-loader__spinner" aria-hidden="true"></div>
                                <span class="vm-dmt-table-loader__text">Loading bookings…</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

