@model Vastwebmulti.Areas.RETAILER.ViewModels.ProductDetails
@{
    var productCount = Model.lstProducts != null ? Model.lstProducts.Count : 0;
    var activeSort = Request.QueryString["SortBy"];
    if (string.IsNullOrWhiteSpace(activeSort))
    {
        activeSort = Request.Form["SortBy"];
    }
    var searchQ = Request.QueryString["txtSearch"];
    Func<string, bool> sortActive = key => !string.IsNullOrWhiteSpace(activeSort)
        && activeSort.IndexOf(key, StringComparison.OrdinalIgnoreCase) >= 0;
}

<div class="vm-ecomm-list-root">
    <div class="vm-ecomm-main-card">
        <div class="vm-ecomm-toolbar">
            <div class="vm-ecomm-toolbar__search">
                @using (Html.BeginForm("Index", "ECommerce", FormMethod.Get, new { @class = "vm-ecomm-search-form" }))
                {
                    <div class="input-group">
                        <input type="text" class="form-control" name="txtSearch" id="txtSearch" placeholder="Search products, brands and more" autocomplete="off" value="@Request.QueryString["txtSearch"]" />
                        <span class="input-group-addon">
                            <button type="submit" id="btnSearchSubmit" class="btn btn-default waves-effect" aria-label="Search">
                                <i class="material-icons">search</i>
                            </button>
                        </span>
                    </div>
                }
            </div>
            <div class="vm-ecomm-toolbar__actions">
                <a class="vm-ecomm-cart-pill" href="javascript:void(0);" onclick="javascript:location.href='@Url.Action("viewCart")'">
                    <i class="material-icons">shopping_cart</i>
                    <span>Cart</span>
                    <span class="vm-ecomm-cart-pill__count">@(Model.itemsInCart > 0 ? Model.itemsInCart.ToString() : "0")</span>
                </a>
                <a class="vm-ecomm-btn-ghost" href="javascript:void(0);" onclick="javascript:location.href='@Url.Action("Transaction","ECommerce")'">
                    <i class="fa fa-list-ul"></i>
                    <span>Transactions</span>
                </a>
                <div class="vm-ecomm-sort dropdown">
                    <button type="button" class="vm-ecomm-btn-ghost vm-ecomm-sort__btn dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" title="Sort products">
                        <i class="material-icons">filter_list</i>
                        <span class="vm-ecomm-sort__label">
                            @if (sortActive("Date"))
                            {
                                @:Newest
                            }
                            else if (sortActive("PriceLow"))
                            {
                                @:Price ↑
                            }
                            else if (sortActive("PriceHigh"))
                            {
                                @:Price ↓
                            }
                            else
                            {
                                @:Filter
                            }
                        </span>
                    </button>
                    <ul class="dropdown-menu vm-ecomm-sort-menu vm-ecomm-sort-menu--left" role="menu">
                        <li class="vm-ecomm-sort-menu__head" role="presentation">
                            <span>Sort products</span>
                        </li>
                        <li class="vm-ecomm-sort-menu__divider" role="separator"></li>
                        <li class="@(sortActive("Date") ? "active" : "")" role="presentation">
                            <a href="@Url.Action("Index", "ECommerce", new { area = "RETAILER", SortBy = "Date", txtSearch = searchQ })" data-vm-sort="Date" class="vm-ecomm-sort-menu__link" role="menuitem">
                                <span class="vm-ecomm-sort-menu__icon" aria-hidden="true"><i class="material-icons">fiber_new</i></span>
                                <span class="vm-ecomm-sort-menu__text">
                                    <strong>Sort by New</strong>
                                    <small>Latest added first</small>
                                </span>
                                <i class="material-icons vm-ecomm-sort-menu__check" aria-hidden="true">check_circle</i>
                            </a>
                        </li>
                        <li class="@(sortActive("PriceLow") ? "active" : "")" role="presentation">
                            <a href="@Url.Action("Index", "ECommerce", new { area = "RETAILER", SortBy = "PriceLow", txtSearch = searchQ })" data-vm-sort="PriceLow" class="vm-ecomm-sort-menu__link" role="menuitem">
                                <span class="vm-ecomm-sort-menu__icon" aria-hidden="true"><i class="material-icons">south</i></span>
                                <span class="vm-ecomm-sort-menu__text">
                                    <strong>Sort by Low Price</strong>
                                    <small>Cheapest first</small>
                                </span>
                                <i class="material-icons vm-ecomm-sort-menu__check" aria-hidden="true">check_circle</i>
                            </a>
                        </li>
                        <li class="@(sortActive("PriceHigh") ? "active" : "")" role="presentation">
                            <a href="@Url.Action("Index", "ECommerce", new { area = "RETAILER", SortBy = "PriceHigh", txtSearch = searchQ })" data-vm-sort="PriceHigh" class="vm-ecomm-sort-menu__link" role="menuitem">
                                <span class="vm-ecomm-sort-menu__icon" aria-hidden="true"><i class="material-icons">north</i></span>
                                <span class="vm-ecomm-sort-menu__text">
                                    <strong>Sort by High Price</strong>
                                    <small>Most expensive first</small>
                                </span>
                                <i class="material-icons vm-ecomm-sort-menu__check" aria-hidden="true">check_circle</i>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="vm-ecomm-products-head">
            <div class="vm-ecomm-products-head__left">
                <h2 class="vm-ecomm-products-card__title">
                    <span id="topProduct">
                        @if (Model.CataTitle != null && !string.IsNullOrWhiteSpace(Model.CataTitle))
                        {
                            @Model.CataTitle
                        }
                        else
                        {
                            @:Top products
                        }
                    </span>
                </h2>
                <p class="vm-ecomm-products-head__hint">Approved items — add to cart or open details</p>
            </div>
            @if (productCount > 0)
            {
                <span class="vm-ecomm-products-head__badge">@productCount item@(productCount == 1 ? "" : "s")</span>
            }
        </div>

        @if (productCount > 0)
        {
            <div class="row vm-ecomm-product-grid">
                @foreach (var product in Model.lstProducts)
                {
                    decimal totalstandprice = product.StandardPrice;
                    decimal totalgst = (product.StandardPrice * product.GST) / (100 + product.GST);
                    <div class="col-sm-6 col-md-3">
                        <div class="vm-ecomm-product-card thumbnail">
                            <a class="vm-ecomm-product-card__img-link" href="@Url.Action("ProductView", new { id = product.ProductID, type = "show" })" target="_blank">
                                <img class="object-fit_scale-down" src="@Url.Content("~" + product.Photo)" alt="@product.Name" />
                            </a>
                            <div class="caption">
                                <h3 class="stringTrucateWithEllipsis">@product.Name</h3>
                                <p class="stringTrucateWithEllipsis vm-ecomm-product-card__desc">@product.ShortDescription</p>
                                <div class="vm-ecomm-product-card__pricing">
                                    <p class="vm-ecomm-product-card__mrp"><span>MRP</span> ₹ @product.ListPrice</p>
                                    <p class="vm-ecomm-product-card__price">₹ <strong>@product.StandardPrice</strong> <small>+ @product.GST% GST</small></p>
                                    <p class="vm-ecomm-product-card__total">Pay ₹ <strong>@string.Format("{0:0.0#}", (totalstandprice + totalgst))</strong></p>
                                </div>
                                <a href="@Url.Action("ProductView", new { id = product.ProductID, type = "Addcartitem" })" target="_blank" class="vm-ecomm-add-cart" role="button">
                                    <i class="material-icons">add_shopping_cart</i>
                                    <span>Add to cart</span>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="vm-ecomm-empty">
                <div class="vm-ecomm-empty__icon" aria-hidden="true">
                    <i class="material-icons">shopping_bag</i>
                </div>
                <h3>No products found</h3>
                <p>Try <strong>All categories</strong>, pick a subcategory from the left, or search by name.</p>
                <button type="button" class="vm-ecomm-empty__btn" id="Catagories_li_empty_trigger">Show all products</button>
            </div>
        }
    </div>
</div>
<script type="text/javascript">
    (function ($) {
        if (window.vmEcommSortNavReady) {
            return;
        }
        window.vmEcommSortNavReady = true;

        function vmEcommBuildSortUrl(sortBy) {
            var base = '@Url.Action("Index", "ECommerce", new { area = "RETAILER" })';
            var qs = [];
            if (sortBy) {
                qs.push('SortBy=' + encodeURIComponent(sortBy));
            }
            var txt = $.trim($('#txtSearch').val() || '');
            if (txt) {
                qs.push('txtSearch=' + encodeURIComponent(txt));
            }
            return qs.length ? (base + (base.indexOf('?') >= 0 ? '&' : '?') + qs.join('&')) : base;
        }

        $(document).on('click', '.vm-ecomm-sort-menu a[data-vm-sort]', function (e) {
            e.preventDefault();
            e.stopPropagation();
            window.location.assign(vmEcommBuildSortUrl($(this).attr('data-vm-sort')));
        });
    })(jQuery);
</script>
