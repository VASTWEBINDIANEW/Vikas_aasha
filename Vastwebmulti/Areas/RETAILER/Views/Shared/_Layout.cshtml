    <script>
        (function ($) {
            function normalizeAdminHref(href) {
                return (href || "")
                    .replace(/^~\//, "/")
                    .replace(/^https?:\/\/[^/]+/i, "")
                    .replace(/\?.*$/, "")
                    .replace(/#.*$/, "")
                    .replace(/\/+$/, "")
                    .toLowerCase();
            }
            function initAdminSidebarAccordion() {
                var $sidebar = $("#leftsidebar.admin-sidebar-shell");
                if (!$sidebar.length) {
                    return;
                }
                var $groups = $sidebar.find(".admin-sidebar-group");
                var currentPath = normalizeAdminHref(window.location.pathname);
                $groups.each(function () {
                    var $group = $(this);
                    var $trigger = $group.children(".llkj");
                    var $submenu = $group.children(".admin-sidebar-sub");
                    $group.addClass("admin-sidebar-open");
                    $submenu.show();
                    $trigger.attr("aria-expanded", "true");
                    $submenu.find("a[href]").each(function () {
                        var linkPath = normalizeAdminHref($(this).attr("href"));
                        if (linkPath && (currentPath === linkPath || currentPath.indexOf(linkPath) !== -1)) {
                            $(this).addClass("activee");
                        }
                    });
                });
                $groups.children(".llkj").off("click.adminSidebar").on("click.adminSidebar", function (event) {
                    event.preventDefault();
                    var $trigger = $(this);
                    var $group = $trigger.closest(".admin-sidebar-group");
                    var $submenu = $group.children(".admin-sidebar-sub");
                    var isOpen = $group.hasClass("admin-sidebar-open");
                    if (isOpen) {
                        $group.removeClass("admin-sidebar-open");
                        $submenu.slideUp(260);
                        $trigger.attr("aria-expanded", "false");
                    } else {
                        $group.addClass("admin-sidebar-open");
                        $submenu.slideDown(260, function () {
                            if (window.syncAdminSidebarScroll) {
                                window.syncAdminSidebarScroll();
                            }
                        });
                        $trigger.attr("aria-expanded", "true");
                    }
                    if (window.syncAdminSidebarScroll) {
                        window.syncAdminSidebarScroll();
                    }
                });
            }
            $(function () {
                initAdminSidebarAccordion();
                if (window.syncAdminSidebarScroll) {
                    window.syncAdminSidebarScroll();
                }
            });
            $(window).on("resize.adminSidebarScroll", function () {
                if (window.syncAdminSidebarScroll) {
                    window.syncAdminSidebarScroll();
                }
            });
        })(jQuery);
    </script>
    <script>
        (function () {
            var $body = $("body");
            var $sidebar = $("#leftsidebar");
            var $overlay = $(".overlay");
            var $topMenu = $("#navbar-collapse");
            var $topMenuHost = $("#admin-top-header");
            var $topMenuBtn = $("#admin-topmenu-open");
            var topMenuMoved = false;
            function destroyLegacySidebarSlimScroll() {
                if (typeof jQuery === "undefined" || !jQuery.fn.slimscroll) {
                    return;
                }
                var $sidebar = jQuery("#leftsidebar.admin-sidebar-shell");
                if (!$sidebar.length) {
                    return;
                }
                $sidebar.find(".admin-sidebar-list, .list").each(function () {
                    var $list = jQuery(this);
                    try {
                        $list.slimscroll({ destroy: true });
                    } catch (e) { }
                    $list.css({ height: "auto", overflow: "visible", maxHeight: "none" });
                });
                $sidebar.find(".slimScrollBar, .slimScrollRail").remove();
                $sidebar.find(".slimScrollDiv").each(function () {
                    var wrap = this;
                    var list = wrap.querySelector(".admin-sidebar-list, .list");
                    if (list && wrap.parentNode) {
                        wrap.parentNode.insertBefore(list, wrap);
                        wrap.parentNode.removeChild(wrap);
                    }
                });
            }
            function syncAdminSidebarScroll() {
                var sidebar = document.getElementById("leftsidebar");
                if (!sidebar || !sidebar.classList.contains("admin-sidebar-shell")) {
                    return;
                }
                destroyLegacySidebarSlimScroll();
                var scrollWrap = document.getElementById("admin-sidebar-scroll");
                var nav = document.getElementById("custnav");
                if (!scrollWrap || !nav) {
                    return;
                }
                nav.style.removeProperty("height");
                nav.style.removeProperty("max-height");
                scrollWrap.style.removeProperty("height");
                scrollWrap.style.removeProperty("max-height");
                scrollWrap.style.setProperty("overflow-y", "auto", "important");
                scrollWrap.style.setProperty("overflow-x", "hidden", "important");
                scrollWrap.style.setProperty("flex", "1 1 0", "important");
                scrollWrap.style.setProperty("min-height", "0", "important");
            }
            window.syncAdminSidebarScroll = syncAdminSidebarScroll;
            function isMobileLayout() {
                return window.matchMedia("(max-width: 1199px)").matches;
            }
            function mountMobileTopMenu() {
                if (!$topMenu.length) {
                    return;
                }
                if (isMobileLayout()) {
                    if (!topMenuMoved) {
                        $topMenu.appendTo($body);
                        topMenuMoved = true;
                    }
                } else if (topMenuMoved && $topMenuHost.length) {
                    $topMenu.appendTo($topMenuHost.find(".admin-header-row").first());
                    topMenuMoved = false;
                }
            }
            function syncTopMenuPanelState() {
                mountMobileTopMenu();
                if (!$topMenu.length) {
                    return;
                }
                $topMenu.removeClass("collapse collapsing navbar-collapse show");
                if (isMobileLayout()) {
                    $topMenu.removeAttr("style");
                    if ($body.hasClass("admin-topmenu-open")) {
                        $topMenu.attr("aria-hidden", "false");
                        $topMenuBtn.attr("aria-expanded", "true");
                    } else {
                        $topMenu.attr("aria-hidden", "true");
                        $topMenuBtn.attr("aria-expanded", "false");
                    }
                } else {
                    $body.removeClass("admin-topmenu-open");
                    $topMenu.attr("aria-hidden", "false");
                    $topMenuBtn.attr("aria-expanded", "false");
                    $topMenu.css({
                        display: "flex",
                        visibility: "visible",
                        height: "auto",
                        opacity: 1
                    });
                }
            }
            window.closeAdminSidebar = function () {
                $sidebar.removeClass("me-left admin-sidebar-visible");
                $body.removeClass("saas-sidebar-collapsed admin-sidebar-open");
                if (!$body.hasClass("admin-topmenu-open")) {
                    $body.removeClass("overlay-open");
                }
            };
            window.openAdminSidebar = function () {
                closeAdminTopMenu();
                $sidebar.addClass("me-left admin-sidebar-visible");
                $body.addClass("saas-sidebar-collapsed admin-sidebar-open overlay-open");
            };
            function toggleAdminSidebar() {
                if ($sidebar.hasClass("me-left")) closeAdminSidebar();
                else openAdminSidebar();
            }
            window.closeAdminTopMenu = function () {
                $body.removeClass("admin-topmenu-open");
                $topMenuBtn.attr("aria-expanded", "false");
                if ($topMenu.length) {
                    $topMenu.attr("aria-hidden", "true");
                }
                if (!$body.hasClass("admin-sidebar-open")) {
                    $body.removeClass("overlay-open");
                }
                syncTopMenuPanelState();
            };
            window.openAdminTopMenu = function () {
                closeAdminSidebar();
                mountMobileTopMenu();
                $body.addClass("admin-topmenu-open overlay-open");
                $topMenuBtn.attr("aria-expanded", "true");
                if ($topMenu.length) {
                    $topMenu.attr("aria-hidden", "false");
                }
                syncTopMenuPanelState();
            };
            function toggleAdminTopMenu() {
                if ($body.hasClass("admin-topmenu-open")) closeAdminTopMenu();
                else openAdminTopMenu();
            }
            $(document).on("click", "#sidebar-open", function (e) {
                e.preventDefault();
                e.stopImmediatePropagation();
                if (isMobileLayout()) toggleAdminSidebar();
                else $body.toggleClass("saas-sidebar-collapsed");
            });
            $(document).on("click", "#admin-topmenu-open", function (e) {
                e.preventDefault();
                e.stopImmediatePropagation();
                if (!isMobileLayout()) {
                    return;
                }
                toggleAdminTopMenu();
            });
            $(document).on("click", "#admin-sidebar-close", function (e) {
                e.preventDefault();
                closeAdminSidebar();
            });
            $(document).on("click", "#admin-topmenu-close", function (e) {
                e.preventDefault();
                closeAdminTopMenu();
            });
            $overlay.on("click", function () {
                if (isMobileLayout()) {
                    closeAdminSidebar();
                    closeAdminTopMenu();
                }
            });
            $sidebar.on("click", ".admin-sidebar-item > a, .admin-sidebar-sub a", function () {
                var href = $(this).attr("href");
                if (href && href.indexOf("javascript") !== 0 && !$(this).hasClass("llkj")) {
                    if (typeof window.showSaasPageLoader === "function") {
                        window.showSaasPageLoader();
                    }
                }
                if (isMobileLayout() && href && href.indexOf("javascript") !== 0) {
                    closeAdminSidebar();
                }
            });
            $(document).on("click", "#navbar-collapse .admin-header-actions a[href], #navbar-collapse .admin-header-actions button[type='submit']", function () {
                var href = $(this).attr("href");
                var dataToggle = $(this).attr("data-toggle");
                if (isMobileLayout() && href && href.indexOf("javascript") !== 0 && !$(this).hasClass("dropdown-toggle") && dataToggle !== "dropdown") {
                    closeAdminTopMenu();
                }
            });
            $(document).on("keydown", function (e) {
                if (e.key === "Escape") {
                    closeAdminSidebar();
                    closeAdminTopMenu();
                }
            });
            $(window).on("resize", function () {
                if (!isMobileLayout()) {
                    closeAdminSidebar();
                    closeAdminTopMenu();
                }
                syncTopMenuPanelState();
                if (window.syncAdminSidebarScroll) {
                    window.syncAdminSidebarScroll();
                }
            });
            window.syncAdminTopMenuPanel = syncTopMenuPanelState;
            $(function () {
                if (!$body.hasClass("saas-admin-ui")) {
                    return;
                }
                $(".bars").off("click");
                if ($.AdminBSB && $.AdminBSB.leftSideBar) {
                    $.AdminBSB.leftSideBar.isOpen = function () {
                        return $body.hasClass("admin-sidebar-open");
                    };
                }
                syncTopMenuPanelState();
                if (window.syncAdminSidebarScroll) {
                    window.syncAdminSidebarScroll();
                }
            });
        })();
    </script>
