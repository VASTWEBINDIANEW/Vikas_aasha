@model Vastwebmulti.Areas.RETAILER.Models.LoanReportFilterVM
@{
    ViewBag.Title = "My Loan Applications";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";

    var statuses = new[]
    {
        "NEW", "UNDER_PROCESS", "DOCUMENT_REQUIRED", "VERIFICATION",
        "ON_HOLD", "APPROVED", "REJECTED", "DISBURSED", "CANCELLED"
    };

    var results = Model.Results ?? new List<Vastwebmulti.Areas.RETAILER.Models.LoanApplicationVm>();
    var rowCount = results.Count;

    decimal totalAmount = results.Any() ? results.Sum(i => i.LoanAmount) : 0m;
    decimal approvedAmount = results.Where(i => string.Equals(i.Status, "APPROVED", StringComparison.OrdinalIgnoreCase)).Sum(i => i.LoanAmount);
    decimal disbursedAmount = results.Where(i => string.Equals(i.Status, "DISBURSED", StringComparison.OrdinalIgnoreCase)).Sum(i => i.LoanAmount);
    int pendingCount = results.Count(i => !string.Equals(i.Status, "APPROVED", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(i.Status, "DISBURSED", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(i.Status, "REJECTED", StringComparison.OrdinalIgnoreCase)
        && !string.Equals(i.Status, "CANCELLED", StringComparison.OrdinalIgnoreCase));

    var frmDate = (Model.FromDate ?? "").Trim();
    var toDate = (Model.ToDate ?? "").Trim();
    if (string.IsNullOrEmpty(frmDate)) { frmDate = DateTime.Today.ToString("yyyy-MM-dd"); Model.FromDate = frmDate; }
    if (string.IsNullOrEmpty(toDate)) { toDate = DateTime.Today.ToString("yyyy-MM-dd"); Model.ToDate = toDate; }
    var dateMode = "get";
}

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=40" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=25" rel="stylesheet" />
<link href="~/MainFrontDesign/css/retailer-loan-report-modern.css?v=12" rel="stylesheet" />
<link href="~/MainFrontDesign/select2/dist/css/select2.min.css" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-dmt-report-page saas-security-report-page saas-loan-report-page saas-retailer-loan-report-page">

    <div class="container-fluid vm-opr-page-shell">

        @if (TempData["Success"] != null)
        {
            <div class="vm-retailer-loan-alert" role="status">
                <i class="fas fa-check-circle" aria-hidden="true"></i> @TempData["Success"]
            </div>
        }

        @{
            var loanFormAttrs = new Dictionary<string, object>
            {
                { "id", "loanReportForm" },
                { "class", "vm-rpt-filters-panel__form vm-retailer-loan-filters-form" },
                { "data-date-mode", dateMode },
                { "data-frm-date", frmDate },
                { "data-to-date", toDate }
            };
        }
        @using (Html.BeginForm("Index", "Loan", new { area = "RETAILER" }, FormMethod.Get, loanFormAttrs))
        {
            <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">

                <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-retailer-loan-toolbar-one-line">

                    <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                        <li><a href="@Url.Action("Dashboard", "Home", new { area = "RETAILER" })"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                        <li>Loan</li>
                        <li>My Applications</li>
                    </ol>

                    <div class="saas-acc-filter-bar vm-retailer-loan-filter-row">

                        <div class="vm-retailer-loan-filter-cell vm-retailer-loan-filter-cell--status">
                            @Html.DropDownListFor(m => m.Status, new SelectList(statuses), "All Status", new { @id = "ddl_status", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div class="vm-retailer-loan-filter-cell vm-retailer-loan-filter-cell--type">
                            @Html.DropDownListFor(m => m.LoanTypeId, new SelectList(Model.LoanTypes ?? new List<Vastwebmulti.Areas.RETAILER.Models.LoanTypeVm>(), "Id", "Name"), "All Loan Types", new { @id = "ddlLoanType", @class = "vm-opr-select vm-dmt-select form-control" })
                        </div>

                        <div class="vm-retailer-loan-filter-cell vm-retailer-loan-filter-cell--date">
                            <input type="date" id="txt_frm_date" name="FromDate" value="@frmDate" class="vm-loan-native-date" required="required" autocomplete="off" title="From date" aria-label="From date" />
                        </div>

                        <div class="vm-retailer-loan-filter-cell vm-retailer-loan-filter-cell--date">
                            <input type="date" id="txt_to_date" name="ToDate" value="@toDate" class="vm-loan-native-date" required="required" autocomplete="off" title="To date" aria-label="To date" />
                        </div>

                        <div class="vm-retailer-loan-filter-cell vm-retailer-loan-filter-cell--action">
                            <button type="submit" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn" title="Search">
                                <i class="fas fa-search" aria-hidden="true"></i><span>Search</span>
                            </button>
                        </div>

                        <div class="vm-retailer-loan-filter-cell vm-retailer-loan-filter-cell--action">
                            <a href="@Url.Action("Index", "Loan", new { area = "RETAILER" })" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn vm-retailer-loan-reset-btn" title="Reset" style="background:#64748b;border-color:#64748b;text-decoration:none;">
                                <i class="fas fa-undo" aria-hidden="true"></i><span>Reset</span>
                            </a>
                        </div>

                        <div class="vm-retailer-loan-filter-cell vm-retailer-loan-filter-cell--new">
                            <a href="@Url.Action("Create", "Loan", new { area = "RETAILER" })" class="vm-retailer-loan-new-btn" title="Request new loan">
                                <i class="fas fa-plus" aria-hidden="true"></i><span>New Loan</span>
                            </a>
                        </div>

                    </div>

                </div>

                <div class="vm-retailer-loan-totals-panel vm-opr-totals-panel vm-dmt-totals-panel" id="loanReportTotalsPanel" style="display:none;" aria-hidden="true">
                    <div class="vm-retailer-loan-totals-panel__head">
                        <div class="vm-retailer-loan-totals-panel__title">
                            <span class="vm-retailer-loan-totals-panel__title-icon" aria-hidden="true">
                                <i class="fas fa-chart-line"></i>
                            </span>
                            <div class="vm-retailer-loan-totals-panel__title-text">
                                <strong>Loan summary</strong>
                                <span>Overview for your current filters</span>
                            </div>
                        </div>
                        <button type="button" class="vm-retailer-loan-totals-panel__close" onclick="hideLoanReportTotals()" title="Hide summary" aria-label="Hide summary">
                            <i class="fas fa-times" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="vm-retailer-loan-totals-grid">
                        <article class="vm-retailer-loan-stat is-total">
                            <span class="vm-retailer-loan-stat__icon" aria-hidden="true"><i class="fas fa-wallet"></i></span>
                            <div class="vm-retailer-loan-stat__body">
                                <span class="vm-retailer-loan-stat__label">Total amount</span>
                                <strong class="vm-retailer-loan-stat__value">&#8377; @totalAmount.ToString("N2")</strong>
                            </div>
                        </article>
                        <article class="vm-retailer-loan-stat is-approved">
                            <span class="vm-retailer-loan-stat__icon" aria-hidden="true"><i class="fas fa-check-circle"></i></span>
                            <div class="vm-retailer-loan-stat__body">
                                <span class="vm-retailer-loan-stat__label">Approved</span>
                                <strong class="vm-retailer-loan-stat__value">&#8377; @approvedAmount.ToString("N2")</strong>
                            </div>
                        </article>
                        <article class="vm-retailer-loan-stat is-disbursed">
                            <span class="vm-retailer-loan-stat__icon" aria-hidden="true"><i class="fas fa-hand-holding-usd"></i></span>
                            <div class="vm-retailer-loan-stat__body">
                                <span class="vm-retailer-loan-stat__label">Disbursed</span>
                                <strong class="vm-retailer-loan-stat__value">&#8377; @disbursedAmount.ToString("N2")</strong>
                            </div>
                        </article>
                        <article class="vm-retailer-loan-stat is-pending">
                            <span class="vm-retailer-loan-stat__icon" aria-hidden="true"><i class="fas fa-hourglass-half"></i></span>
                            <div class="vm-retailer-loan-stat__body">
                                <span class="vm-retailer-loan-stat__label">Pending apps</span>
                                <strong class="vm-retailer-loan-stat__value">@pendingCount</strong>
                            </div>
                        </article>
                    </div>
                </div>

            </div>
        }

        <div class="vm-opr-main-card vm-security-report-main-card vm-loan-report-main-card">
            <div class="vm-opr-table-panel vm-security-report-table-panel">
                <div class="vm-opr-table-panel__head vm-dmt-table-panel__head vm-security-report-table-head">
                    <div class="vm-opr-table-panel__title">
                        <i class="fas fa-money-check-alt" aria-hidden="true"></i>
                        <span>My loan applications</span>
                    </div>
                    <div class="vm-dmt-table-panel__right">
                        <span class="vm-radiant-record-badge" title="Total records">
                            Records: <strong>@rowCount</strong>
                        </span>
                        <span class="vm-radiant-inline-total" title="Total amount for current filter">
                            Total: <strong>&#8377; @totalAmount.ToString("N2")</strong>
                        </span>
                        <div class="vm-dmt-table-actions vm-opr-filter-actions saas-acc-export-group">
                            <button type="button" class="vm-retailer-loan-summary-btn vm-loan-totals-btn" onclick="findLoanTotal()" title="Show loan summary" aria-expanded="false" aria-controls="loanReportTotalsPanel">
                                <i class="fas fa-chart-pie" aria-hidden="true"></i>
                                <span>Summary</span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="vm-opr-table-wrap">
                    <div class="table-responsive vm-opr-table-scroll">
                        <table id="loanReportTable" class="table vm-opr-data-table" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>Status</th>
                                    <th>Application&nbsp;No</th>
                                    <th>Loan&nbsp;Type</th>
                                    <th>Applicant</th>
                                    <th>Mobile</th>
                                    <th>Amount&nbsp;&#8377;</th>
                                    <th>Tenure</th>
                                    <th>Applied&nbsp;On</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (results.Any())
                                {
                                    foreach (var item in results)
                                    {
                                        var statusUpper = (item.Status ?? "").ToUpper();
                                        var statusCls = "is-hold";
                                        if (statusUpper == "APPROVED") { statusCls = "is-approved"; }
                                        else if (statusUpper == "DISBURSED") { statusCls = "is-disbursed"; }
                                        else if (statusUpper == "REJECTED" || statusUpper == "CANCELLED") { statusCls = "is-rejected"; }
                                        else if (statusUpper == "NEW") { statusCls = "is-new"; }
                                        else if (statusUpper == "UNDER_PROCESS" || statusUpper == "VERIFICATION" || statusUpper == "DOCUMENT_REQUIRED" || statusUpper == "ON_HOLD") { statusCls = "is-process"; }
                                        var statusText = (item.Status ?? "-").Replace("_", " ");
                                        <tr>
                                            <td>
                                                <span class="vm-loan-status @statusCls"><span class="vm-loan-dot"></span>@statusText</span>
                                            </td>
                                            <td>@item.ApplicationNo</td>
                                            <td>@item.LoanTypeName</td>
                                            <td>@item.FullName</td>
                                            <td>@item.Mobile</td>
                                            <td>@item.LoanAmount.ToString("N2")</td>
                                            <td>@(item.TenureMonths.HasValue ? item.TenureMonths + " mo" : "-")</td>
                                            <td>@item.CreatedDate.ToString("dd MMM yyyy")</td>
                                            <td>
                                                <a href="@Url.Action("Details", "Loan", new { area = "RETAILER", id = item.Id })" title="View Details" style="color:#ffc107;background:transparent;border:none;">
                                                    <img src="~/ashok-images/rightaeps.svg" alt="" style="border:1px solid var(--border-color,#e2e8f0);padding:3px;font-size:10px;height:20px !important;" />
                                                </a>
                                                @if (string.Equals(item.Status, "DOCUMENT_REQUIRED", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <a href="@Url.Action("UploadDocuments", "Loan", new { area = "RETAILER", id = item.Id })" class="vm-retailer-loan-upload-link" title="Upload documents">
                                                        <i class="fas fa-upload" aria-hidden="true"></i> Upload
                                                    </a>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr class="vm-opr-table-empty-row">
                                        <td colspan="9" class="vm-opr-table-empty vm-dmt-table-empty">
                                            <i class="fas fa-money-check-alt" aria-hidden="true"></i>
                                            <span>No loan applications found for the selected filters.</span>
                                            <div style="margin-top:12px;">
                                                <a href="@Url.Action("Create", "Loan", new { area = "RETAILER" })" class="vm-retailer-loan-new-btn">
                                                    <i class="fas fa-plus" aria-hidden="true"></i><span>Request New Loan</span>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</section>

@section PostVmScripts {
<script>
    (function ($) {
        if (!$) { return; }

        window.hideLoanReportTotals = function () {
            var $panel = $('#loanReportTotalsPanel');
            var $btn = $('.vm-loan-totals-btn');
            $panel.hide().attr('aria-hidden', 'true').removeClass('is-open');
            $btn.attr('aria-expanded', 'false').removeClass('is-active');
        };

        window.findLoanTotal = function () {
            var $panel = $('#loanReportTotalsPanel');
            var $btn = $('.vm-loan-totals-btn');
            if ($panel.is(':visible')) {
                hideLoanReportTotals();
                return;
            }
            $panel.show().attr('aria-hidden', 'false').addClass('is-open');
            $btn.attr('aria-expanded', 'true').addClass('is-active');
        };

        function initLoanNativeDates() {
            var frm = document.querySelector('#loanReportForm #txt_frm_date');
            var to = document.querySelector('#loanReportForm #txt_to_date');
            if (!frm || !to) { return false; }

            if ($.fn.datepicker) {
                $([frm, to]).each(function () {
                    var $el = $(this);
                    if ($el.data('datepicker')) {
                        try { $el.datepicker('destroy'); } catch (e) { }
                    }
                });
            }

            var openPicker = function () {
                try { if (this.showPicker) { this.showPicker(); } } catch (e) { }
            };
            frm.addEventListener('click', openPicker);
            to.addEventListener('click', openPicker);

            var syncRange = function () {
                if (frm.value && to.value && to.value < frm.value) {
                    to.value = frm.value;
                }
            };
            frm.addEventListener('change', syncRange);
            to.addEventListener('change', syncRange);
            return true;
        }

        function initLoanReportSelect2() {
            var $status = $('#ddl_status');
            var $type = $('#ddlLoanType');
            [$status, $type].forEach(function ($el) {
                if (!$el.length || !$.fn.select2) { return; }
                if ($el.data('select2')) { $el.select2('destroy'); }
                if (typeof window.applyAdminSelect2 === 'function') {
                    window.applyAdminSelect2($el, { width: '100%', minimumResultsForSearch: 6 }, true);
                } else {
                    $el.select2({ width: '100%', minimumResultsForSearch: 6 });
                }
            });
        }

        function loanReportBoot() {
            initLoanReportSelect2();
            initLoanNativeDates();
            $('#loanReportForm .select2-container').css('width', '100%');
        }

        $(function () { loanReportBoot(); });
    })(window.jQuery);
</script>
}
