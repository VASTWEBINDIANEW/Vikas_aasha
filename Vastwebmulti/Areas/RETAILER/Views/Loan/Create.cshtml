                                                                                                                                                                                                                                                                                                                                                                   name="Application.ITRIncome"
                                                                                                                                                                                                                                                                                                                                                                   class="form-control"
                                                                                                                                                                                                                                                                                                                                                                   min="0"
                                                                                                                                                                                                                                                                                                                                                                   step="0.01"
                                                                                                                                                                                                                                                                                                                                                                   placeholder="600000" />

                                                                                                                                                                                                                                                                                                                                                            <small class="loan-help">
                                                                                                                                                                                                                                                                                                                                                                Mainly applicable for self-employed/
                                                                                                                                                                                                                                                                                                                                                                irregular income cases.
                                                                                                                                                                                                                                                                                                                                                            </small>

                                                                                                                                                                                                                                                                                                                                                        </div>


                                                                                                                                                                                                                                                                                                                                                        <div class="loan-field">

                                                                                                                                                                                                                                                                                                                                                            <label>
                                                                                                                                                                                                                                                                                                                                                                EMI Bounce - Last 3 Months
                                                                                                                                                                                                                                                                                                                                                            </label>

                                                                                                                                                                                                                                                                                                                                                            <input type="number"
                                                                                                                                                                                                                                                                                                                                                                   id="EligibilityBounceCount"
                                                                                                                                                                                                                                                                                                                                                                   name="Application.Last3MonthsBounceCount"
                                                                                                                                                                                                                                                                                                                                                                   class="form-control"
                                                                                                                                                                                                                                                                                                                                                                   min="0"
                                                                                                                                                                                                                                                                                                                                                                   value="0"
                                                                                                                                                                                                                                                                                                                                                                   placeholder="0" />

                                                                                                                                                                                                                                                                                                                                                        </div>


                                                                                                                                                                                                                                                                                                                                                        <div class="loan-field">

                                                                                                                                                                                                                                                                                                                                                            <label>
                                                                                                                                                                                                                                                                                                                                                                Average Bank Statement Period
                                                                                                                                                                                                                                                                                                                                                            </label>

                                                                                                                                                                                                                                                                                                                                                            <select name="Application.BankStatementMonths"
                                                                                                                                                                                                                                                                                                                                                                    class="form-control">

                                                                                                                                                                                                                                                                                                                                                                <option value="">
                                                                                                                                                                                                                                                                                                                                                                    -- Select --
                                                                                                                                                                                                                                                                                                                                                                </option>

                                                                                                                                                                                                                                                                                                                                                                <option value="3">
                                                                                                                                                                                                                                                                                                                                                                    3 Months
                                                                                                                                                                                                                                                                                                                                                                </option>

                                                                                                                                                                                                                                                                                                                                                                <option value="6">
                                                                                                                                                                                                                                                                                                                                                                    6 Months
                                                                                                                                                                                                                                                                                                                                                                </option>

                                                                                                                                                                                                                                                                                                                                                            </select>

                                                                                                                                                                                                                                                                                                                                                        </div>

                                                                                                                                                                                                                                                                                                                                                    </div>


                                                                                                                                                                                                                                                                                                                                                    <div class="loan-note">

                                                                                                                                                                                                                                                                                                                                                        <strong>
                                                                                                                                                                                                                                                                                                                                                            Policy reference:
                                                                                                                                                                                                                                                                                                                                                        </strong>

                                                                                                                                                                                                                                                                                                                                                        Minimum CIBIL is 650.
                                                                                                                                                                                                                                                                                                                                                        Salaried FOIR can be considered up to 70%
                                                                                                                                                                                                                                                                                                                                                        of net monthly income, subject to policy checks.

                                                                                                                                                                                                                                                                                                                                                    </div>

                                                                                                                                                                                                                                                                                                                                                </div>
                                                                                                                                                                                                                                                                                                                                                                <!-- =====================================================
                                                                                                                                                                                                                                                                                                                                                                9. LOAN REQUIREMENT
                                                                                                                                                                                                                                                                                                                                                                ===================================================== -->

                                                                                                                                                                                                                                                                                                                                                                                <div id="usedCarLoanRequirement"
                                                                                                                                                                                                                                                                                                                                                                                     class="loan-section">

                                                                                                                                                                                                                                                                                                                                                                                    <div class="loan-section-heading">



                                                                                                                                                                                                                                                                                                                                                                                        <div>

                                                                                                                                                                                                                                                                                                                                                                                            <h4>
                                                                                                                                                                                                                                                                                                                                                                                                Loan Requirement
                                                                                                                                                                                                                                                                                                                                                                                            </h4>

                                                                                                                                                                                                                                                                                                                                                                                            <span>
                                                                                                                                                                                                                                                                                                                                                                                                Enter requested loan amount and repayment preference.
                                                                                                                                                                                                                                                                                                                                                                                            </span>

                                                                                                                                                                                                                                                                                                                                                                                        </div>

                                                                                                                                                                                                                                                                                                                                                                                    </div>


                                                                                                                                                                                                                                                                                                                                                                                    <div class="loan-field-grid">


                                                                                                                                                                                                                                                                                                                                                                                        <div class="loan-field">

                                                                                                                                                                                                                                                                                                                                                                                            <label>
                                                                                                                                                                                                                                                                                                                                                                                                Requested Loan Amount
                                                                                                                                                                                                                                                                                                                                                                                                <span class="required">*</span>
                                                                                                                                                                                                                                                                                                                                                                                            </label>

                                                                                                                                                                                                                                                                                                                                                                                            @Html.TextBoxFor(
                                                                                                                                                                                                                                                                                                                                                                                                                    m => m.Application.LoanAmount,
                                                                                                                                                                                                                                                                                                                                                                                                                    new
                                                                                                                                                                                                                                                                                                                                                                                                                    {
                                                                                                                                                                                                                                                                                                                                                                                                                        @class = "form-control",
                                                                                                                                                                                                                                                                                                                                                                                                                        id = "LoanAmount",
                                                                                                                                                                                                                                                                                                                                                                                                                        type = "number",
                                                                                                                                                                                                                                                                                                                                                                                                                        min = "0",
                                                                                                                                                                                                                                                                                                                                                                                                                        step = "0.01",
                                                                                                                                                                                                                                                                                                                                                                                                                        placeholder = "500000"
                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                )

                                                                                                                                                                                                                                                                                                                                                                                            @Html.ValidationMessageFor(
                                                                                                                                                                                                                                                                                                                                                                                                                    m => m.Application.LoanAmount,
                                                                                                                                                                                                                                                                                                                                                                                                                    "",
                                                                                                                                                                                                                                                                                                                                                                                                                    new { @class = "text-danger" }
                                                                                                                                                                                                                                                                                                                                                                                                                )

                                                                                                                                                                                                                                                                                                                                                                                        </div>


                                                                                                                                                                                                                                                                                                                                                                                        <div class="loan-field">

                                                                                                                                                                                                                                                                                                                                                                                            <label>
                                                                                                                                                                                                                                                                                                                                                                                                Tenure
                                                                                                                                                                                                                                                                                                                                                                                                <span class="required">*</span>
                                                                                                                                                                                                                                                                                                                                                                                            </label>

                                                                                                                                                                                                                                                                                                                                                                                            @Html.TextBoxFor(
                                                                                                                                                                                                                                                                                                                                                                                                                    m => m.Application.TenureMonths,
                                                                                                                                                                                                                                                                                                                                                                                                                    new
                                                                                                                                                                                                                                                                                                                                                                                                                    {
                                                                                                                                                                                                                                                                                                                                                                                                                        @class = "form-control",
                                                                                                                                                                                                                                                                                                                                                                                                                        id = "TenureMonths",
                                                                                                                                                                                                                                                                                                                                                                                                                        type = "number",
                                                                                                                                                                                                                                                                                                                                                                                                                        min = "25",
                                                                                                                                                                                                                                                                                                                                                                                                                        max = "60",
                                                                                                                                                                                                                                                                                                                                                                                                                        placeholder = "48"
                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                )

                                                                                                                                                                                                                                                                                                                                                                                            <small id="tenureHint"
                                                                                                                                                                                                                                                                                                                                                                                                   class="loan-help">
                                                                                                                                                                                                                                                                                                                                                                                                Allowed: 25 to 60 months
                                                                                                                                                                                                                                                                                                                                                                                            </small>

                                                                                                                                                                                                                                                                                                                                                                                            @Html.ValidationMessageFor(
                                                                                                                                                                                                                                                                                                                                                                                                                    m => m.Application.TenureMonths,
                                                                                                                                                                                                                                                                                                                                                                                                                    "",
                                                                                                                                                                                                                                                                                                                                                                                                                    new { @class = "text-danger" }
                                                                                                                                                                                                                                                                                                                                                                                                                )

                                                                                                                                                                                                                                                                                                                                                                                        </div>


                                                                                                                                                                                                                                                                                                                                                                                        <div class="loan-field">

                                                                                                                                                                                                                                                                                                                                                                                            <label>
                                                                                                                                                                                                                                                                                                                                                                                                Rate of Interest
                                                                                                                                                                                                                                                                                                                                                                                            </label>

                                                                                                                                                                                                                                                                                                                                                                                            <input type="number"
                                                                                                                                                                                                                                                                                                                                                                                                   id="InterestRate"
                                                                                                                                                                                                                                                                                                                                                                                                   name="Application.InterestRate"
                                                                                                                                                                                                                                                                                                                                                                                                   class="form-control"
                                                                                                                                                                                                                                                                                                                                                                                                   min="12.75"
                                                                                                                                                                                                                                                                                                                                                                                                   max="17.50"
                                                                                                                                                                                                                                                                                                                                                                                                   step="0.01"
                                                                                                                                                                                                                                                                                                                                                                                                   placeholder="12.75" />

                                                                                                                                                                                                                                                                                                                                                                                            <small class="loan-help">
                                                                                                                                                                                                                                                                                                                                                                                                Policy range: 12.75% to 17.50%
                                                                                                                                                                                                                                                                                                                                                                                            </small>

                                                                                                                                                                                                                                                                                                                                                                                        </div>


                                                                                                                                                                                                                                                                                                                                                                                        <div class="loan-field">

                                                                                                                                                                                                                                                                                                                                                                                            <label>
                                                                                                                                                                                                                                                                                                                                                                                                Estimated EMI
                                                                                                                                                                                                                                                                                                                                                                                            </label>

                                                                                                                                                                                                                                                                                                                                                                                            <input type="text"
                                                                                                                                                                                                                                                                                                                                                                                                   id="EstimatedEMI"
                                                                                                                                                                                                                                                                                                                                                                                                   class="form-control"
                                                                                                                                                                                                                                                                                                                                                                                                   readonly />

                                                                                                                                                                                                                                                                                                                                                                                        </div>


                                                                                                                                                                                                                                                                                                                                                                                        <div class="loan-field wide">

                                                                                                                                                                                                                                                                                                                                                                                            @Html.LabelFor(
                                                                                                                                                                                                                                                                                                                                                                                                                    m => m.Application.LoanPurpose
                                                                                                                                                                                                                                                                                                                                                                                                                )

                                                                                                                                                                                                                                                                                                                                                                                            <span class="required">*</span>

                                                                                                                                                                                                                                                                                                                                                                                            @Html.TextBoxFor(
                                                                                                                                                                                                                                                                                                                                                                                                                    m => m.Application.LoanPurpose,
                                                                                                                                                                                                                                                                                                                                                                                                                    new
                                                                                                                                                                                                                                                                                                                                                                                                                    {
                                                                                                                                                                                                                                                                                                                                                                                                                        @class = "form-control",
                                                                                                                                                                                                                                                                                                                                                                                                                        placeholder =
                                                                                                                                                                                                                                                                                                                                                                                                                            "What will the loan be used for?"
                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                )

                                                                                                                                                                                                                                                                                                                                                                                        </div>

                                                                                                                                                                                                                                                                                                                                                                                    </div>

                                                                                                                                                                                                                                                                                                                                                                                </div> <!-- ACTIONS -->

                                                                                                                                                                                                                                                                                                                                                                                                <div class="loan-actions">

                                                                                                                                                                                                                                                                                                                                                                                                    @Html.ActionLink(
                                                                                                                                                                                                                                                                                                                                                                                                                            "Cancel",
                                                                                                                                                                                                                                                                                                                                                                                                                            "Index",
                                                                                                                                                                                                                                                                                                                                                                                                                            new { area = "RETAILER" },
                                                                                                                                                                                                                                                                                                                                                                                                                            new { @class = "btn btn-default" }
                                                                                                                                                                                                                                                                                                                                                                                                                        )

                                                                                                                                                                                                                                                                                                                                                                                                    <button type="submit"
                                                                                                                                                                                                                                                                                                                                                                                                            class="btn btn-primary">

                                                                                                                                                                                                                                                                                                                                                                                                        <i class="fa fa-paper-plane"></i>

                                                                                                                                                                                                                                                                                                                                                                                                        Submit Application

                                                                                                                                                                                                                                                                                                                                                                                                    </button>

                                                                                                                                                                                                                                                                                                                                                                                                </div>}

                    </div>
                </div>
            </div>
        </div>

    </div>

</section>


<!-- ============================================================
     JAVASCRIPT
     ============================================================ -->

<script src="~/AdminDesign/plugins/jquery/jquery.min.js"></script>

<script src="~/Scripts/jquery.validate.min.js"></script>

<script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>

<script src="~/AdminDesign/js/pages/forms/basic-form-elements.js"></script>

<script src="~/AdminDesign/plugins/bootstrap-select/js/bootstrap-select.js"></script>


<script>

    /* =========================================================
       LOAN TYPE DATA
       ========================================================= */

    var loanTypeCodes = {

        @foreach (var lt in Model.LoanTypes)
        {
            @: @lt.Id: "@lt.Code",
        }

    };


    var loanCreateDobMaxDate = "@DateTime.Today.AddYears(-18).ToString("yyyy-MM-dd")";

    var loanCreateDatePickerOpts = {
        format: "yyyy-mm-dd",
        todayHighlight: true,
        autoclose: true,
        orientation: "bottom auto",
        forceParse: false,
        keyboardNavigation: true,
        enableOnReadonly: true,
        container: "body"
    };


    function bindLoanCreateDatePicker($input) {

        if (!$input || !$input.length || !$.fn.datepicker) {
            return;
        }

        if ($input.data("datepicker")) {
            return;
        }

        var opts = $.extend({}, loanCreateDatePickerOpts);

        if ($input.attr("name") === "Application.DOB") {
            opts.endDate = loanCreateDobMaxDate;
        }

        $input.prop("readonly", true);
        $input.datepicker(opts);

        var setActive = function (on) {
            $input.closest(".saas-acc-dp-field").toggleClass("is-active", !!on);
        };

        $input
            .off("show.loanCreateDate shown.loanCreateDate hide.loanCreateDate changeDate.loanCreateDate")
            .on("show.loanCreateDate shown.loanCreateDate", function () {
                setActive(true);
                if (typeof window.repositionAdminDatepicker === "function") {
                    window.repositionAdminDatepicker(this);
                }
            })
            .on("hide.loanCreateDate changeDate.loanCreateDate", function () {
                setActive(false);
            });
    }


    function showLoanCreateDatePicker($input) {

        if (!$input || !$input.length) {
            return;
        }

        bindLoanCreateDatePicker($input);

        if ($input.data("datepicker")) {
            $input.datepicker("show");
        }
    }


    function initLoanCreateDatePickers(context) {

        var $scope = context ? $(context) : $("#loanCreateForm");

        if (!$scope.length || !$.fn.datepicker) {
            return;
        }

        $scope.find(".vm-loan-form-date .saas-acc-dp-input").each(function () {

            var $input = $(this);

            if (!$input.is(":visible")) {
                return;
            }

            bindLoanCreateDatePicker($input);
        });
    }


    function destroyLoanCreateSelect2($el) {
        if ($el && $el.length && $el.data("select2")) {
            $el.select2("destroy");
        }
    }


    function initLoanCreateSelect2(context) {

        var $scope = context ? $(context) : $("#loanCreateForm");

        if (!$scope.length) {
            return;
        }

        $scope.find("select.form-control:visible").each(function () {

            var $el = $(this);

            $el.addClass("vm-opr-select vm-dmt-select");

            if ($el.hasClass("select2-hidden-accessible")) {
                return;
            }

            if (typeof window.applyAdminSelect2 === "function") {
                window.applyAdminSelect2(
                    $el,
                    {
                        width: "100%",
                        minimumResultsForSearch: 8,
                        dropdownParent: $el.closest(".loan-form")
                    },
                    true
                );
                return;
            }

            if ($.fn.select2) {
                $el.select2({
                    width: "100%",
                    minimumResultsForSearch: 8,
                    dropdownParent: $el.closest(".loan-form")
                });
            }
        });
    }


    var tenureLimits = {

        "PERSONAL": {
            min: 3,
            max: 60
        },

        "NEW_CAR": {
            min: 3,
            max: 84
        },

        "USED_CAR": {
            min: 25,
            max: 60
        }

    };


    /* =========================================================
       SAFE REQUIRED HANDLER
       ========================================================= */

    function setRequired($elements, isRequired) {

        $elements.each(function () {

            var $element = $(this);

            $element.prop(
                "required",
                isRequired
            );

            if ($.fn.rules) {

                if (isRequired) {

                    $element.rules(
                        "add",
                        {
                            required: true
                        }
                    );

                }
                else {

                    $element.rules(
                        "remove",
                        "required"
                    );

                    $element.removeClass(
                        "input-validation-error"
                    );

                    var name = $element.attr("name");

                    if (name) {

                        $('[data-valmsg-for="' + name + '"]')
                            .empty();

                    }

                }

            }

        });

    }


    /* =========================================================
       ACTIVE LOAN TAB
       ========================================================= */

    function markTabActive($tab) {

        $(".loan-type-tab")
            .removeClass("active");

        $tab.addClass("active");

        $("#LoanTypeId")
            .val($tab.data("id"));

    }


    /* =========================================================
       LOAN TYPE CHANGE
       ========================================================= */

    function toggleLoanSections() {

        var loanTypeId =
            $("#LoanTypeId").val();

        var code =
            loanTypeCodes[loanTypeId];


        var isUsedCar =
            code === "USED_CAR";

        var isNewCar =
            code === "NEW_CAR";

        var isCar =
            isUsedCar || isNewCar;


        /* Vehicle */

        $("#vehicleSection")
            .toggle(isCar);


        /* New Car: show only Manufacturer, Model, Variant, Fuel Type, Transmission.
           Hide Registration No, Manufacturing Month/Year, Registration Date,
           Owner Number, KM Driven, Market Value — those are Used Car only. */

        $(".new-car-hide")
            .toggle(!isNewCar);


        /* Used Car */

        $("#usedCarLoanSection")
            .toggle(isUsedCar);

        $("#usedCarEligibilitySection")
            .toggle(isUsedCar);

        //$("#usedCarLoanRequirement")
        //    .toggle(isUsedCar);


        /* Refinance */

        if (!isUsedCar) {

            $("#refinanceTypeSection")
                .hide();

            $("#existingLoanSection")
                .hide();

            $("input[name='Application.CaseType']")
                .prop("checked", false);

            $("input[name='Application.RefinanceType']")
                .prop("checked", false);

            $(".used-case-card")
                .removeClass("active");

            $(".refinance-type-card")
                .removeClass("active");

        }
        else if (
            !$("input[name='Application.CaseType']:checked").length
        ) {

            $("input[name='Application.CaseType'][value='PURCHASE']")
                .prop("checked", true);

            handleCaseType("PURCHASE");

        }


        /* Validation */

        setRequired(
            $(".used-car-required"),
            isUsedCar
        );


        setRequired(
            $(".vehicle-required"),
            isCar
        );


        updateTenureLimits();

        initLoanCreateSelect2();
        initLoanCreateDatePickers();

    }


    /* =========================================================
       TENURE
       ========================================================= */

    function updateTenureLimits() {

        var code =
            loanTypeCodes[
                $("#LoanTypeId").val()
            ];

        var limits =
            tenureLimits[code];


        if (!limits) {

            $("#TenureMonths")
                .removeAttr("min")
                .removeAttr("max");

            $("#tenureHint")
                .text("");

            return;
        }


        $("#TenureMonths")
            .attr("min", limits.min)
            .attr("max", limits.max);


        $("#tenureHint")
            .text(
                "Allowed: " +
                limits.min +
                " to " +
                limits.max +
                " months"
            );

    }


    /* =========================================================
       SELECT LOAN TYPE
       ========================================================= */

    function selectLoanType($tab) {

        markTabActive($tab);

        toggleLoanSections();

    }


    /* =========================================================
       USED CAR CASE
       ========================================================= */

    function resetRefinance() {

        $("#refinanceTypeSection")
            .hide();

        $("#existingLoanSection")
            .hide();

        $("input[name='Application.RefinanceType']")
            .prop("checked", false);

        $(".refinance-type-card")
            .removeClass("active");

        $("#loanClosureDateContainer")
            .hide();

        $("#emiFundingHint")
            .hide()
            .text("");

    }


    function handleCaseType(caseType) {

        $(".used-case-card")
            .removeClass("active");

        $("input[name='Application.CaseType'][value='" +
            caseType +
            "']")
            .closest(".used-case-card")
            .addClass("active");


        if (caseType === "REFINANCE") {

            $("#refinanceTypeSection")
                .stop(true, true)
                .slideDown(200);

            $("#caseFundingSummary")
                .hide();

            $("input[name='Application.RefinanceType'][value='NORMAL_REFINANCE']")
                .prop("checked", true);

            handleRefinanceType("NORMAL_REFINANCE");

        }
        else {

            resetRefinance();

            $("#caseFundingSummary")
                .hide();

            $("#refinancePolicyBox")
                .hide();

        }


        calculateVehicleAge();

        updateFundingSummary();
    }


    /* =========================================================
       REFINANCE TYPE
       ========================================================= */

    function handleRefinanceType(type) {

        $(".refinance-type-card")
            .removeClass("active");

        $("input[name='Application.RefinanceType'][value='" + type + "']")
            .closest(".refinance-type-card")
            .addClass("active");


        $("#existingLoanSection")
            .stop(true, true)
            .slideDown(200);


        $("#caseFundingSummary")
            .show();


        /* =========================================
           NORMAL REFINANCE
           ========================================= */

        if (type === "NORMAL_REFINANCE") {

            $("#existingLoanTitle")
                .text("Refinance Details");

            $("#existingLoanDescription")
                .text(
                    "Customer already owns the vehicle and wants to raise funds against it."
                );


            $("#loanClosureDateContainer")
                .hide();

            $("#emiPaidContainer")
                .hide();

            $("#currentOutstandingContainer")
                .hide();

            $("#currentEmiContainer")
                .hide();

            $("#totalEmiContainer")
                .hide();

            $("#lastEmiDateContainer")
                .hide();


            $("#emiFundingHint")
                .hide()
                .text("");


            $("#refinancePolicyBox")
                .show()
                .removeClass("funding-error")
                .addClass("funding-success")
                .html(
                    "<strong>Normal Refinance</strong><br>" +
                    "Customer already owns the vehicle. " +
                    "Maximum funding is up to <strong>90%</strong> " +
                    "of current market value."
                );

        }


        /* =========================================
           CLOSE BALANCE TRANSFER
           ========================================= */

        else if (type === "CLOSE_BT") {

            $("#existingLoanTitle")
                .text("Previous Loan Details");

            $("#existingLoanDescription")
                .text(
                    "Details of the recently closed vehicle loan."
                );


            $("#loanClosureDateContainer")
                .show();

            $("#emiPaidContainer")
                .hide();

            $("#currentOutstandingContainer")
                .hide();

            $("#currentEmiContainer")
                .hide();

            $("#totalEmiContainer")
                .hide();

            $("#lastEmiDateContainer")
                .show();


            $("#emiFundingHint")
                .show()
                .removeClass("funding-error")
                .html(
                    "<strong>Close BT Condition:</strong><br>" +
                    "Previous vehicle loan must have been closed " +
                    "within the last <strong>6 months</strong>."
                );


            $("#refinancePolicyBox")
                .show()
                .html(
                    "<strong>Funding:</strong> Up to " +
                    "<strong>140%</strong> of vehicle market value."
                );

        }


        /* =========================================
           BALANCE TRANSFER + TOP-UP
           ========================================= */

        else if (type === "BT_TOPUP") {

            $("#existingLoanTitle")
                .text("Existing Loan & Top-Up Details");

            $("#existingLoanDescription")
                .text(
                    "Current loan details are required to calculate BT and Top-Up eligibility."
                );


            $("#loanClosureDateContainer")
                .hide();

            $("#emiPaidContainer")
                .show();

            $("#currentOutstandingContainer")
                .show();

            $("#currentEmiContainer")
                .show();

            $("#totalEmiContainer")
                .show();

            $("#lastEmiDateContainer")
                .show();


            updateFundingHint();


            $("#refinancePolicyBox")
                .show()
                .html(
                    "<strong>BT + Top-Up Funding:</strong><br>" +
                    "12+ EMI → Up to 150% - 200% "
                );

        }


        updateFundingSummary();

        window.setTimeout(function () {
            initLoanCreateDatePickers("#existingLoanSection");
            initLoanCreateDatePickers("#lastEmiDateContainer");
            initLoanCreateDatePickers("#loanClosureDateContainer");
        }, 220);

    }


    /* =========================================================
       FUNDING HINT
       ========================================================= */

    function updateFundingHint() {

        var type =
            $("input[name='Application.RefinanceType']:checked")
                .val();


        if (type !== "BT_TOPUP") {

            $("#emiFundingHint")
                .hide()
                .text("");

            return;
        }


        var emiPaid =
            parseInt(
                $("#ExistingPaidEMI").val() || 0,
                10
            );


        var message = "";


        if (emiPaid >= 18) {

            message =
                "<strong>Eligible slab:</strong> 18+ EMI<br>" +
                "Maximum funding: <strong>200%</strong> of vehicle market value.";

        }
        else if (emiPaid === 17) {

            message =
                "<strong>Eligible slab:</strong> 17 EMI<br>" +
                "Maximum funding: <strong>160%</strong> of vehicle market value.";

        }
        else if (emiPaid >= 12) {

            message =
                "<strong>Eligible slab:</strong> 12–16 EMI<br>" +
                "Maximum funding: <strong>140%</strong> of vehicle market value.";

        }
        else {

            message =
                "<strong>Not Eligible:</strong><br>" +
                "Minimum <strong>12 EMI payments</strong> are required " +
                "for Balance Transfer + Top-Up.";

        }


        $("#emiFundingHint")
            .show()
            .html(message);


        updateFundingSummary();
    }

    function updateFundingSummary() {

        var caseType =
            $("input[name='Application.CaseType']:checked")
                .val();

        var refinanceType =
            $("input[name='Application.RefinanceType']:checked")
                .val();

        var marketValue =
            parseFloat(
                $("#MarketValue").val() || 0
            );


        if (!caseType || caseType !== "REFINANCE") {

            $("#caseFundingSummary")
                .hide();

            return;
        }


        if (!refinanceType || marketValue <= 0) {

            $("#caseFundingSummary")
                .hide();

            return;
        }


        var fundingPercent = 0;
        var caseName = "";


        /* NORMAL REFINANCE */

        if (refinanceType === "NORMAL_REFINANCE") {

            caseName = "Normal Refinance";

            fundingPercent = 90;

        }


        /* CLOSE BT */

        else if (refinanceType === "CLOSE_BT") {

            caseName = "Close Balance Transfer";

            fundingPercent = 140;

        }


        /* BT TOP UP */

        else if (refinanceType === "BT_TOPUP") {

            caseName = "Balance Transfer + Top-Up";


            var emiPaid =
                parseInt(
                    $("#ExistingPaidEMI").val() || 0,
                    10
                );


            if (emiPaid >= 18) {

                fundingPercent = 200;

            }
            else if (emiPaid === 17) {

                fundingPercent = 160;

            }
            else if (emiPaid >= 12) {

                fundingPercent = 140;

            }
            else {

                fundingPercent = 0;

            }

        }


        $("#summaryCaseType")
            .text(caseName);


        $("#summaryMarketValue")
            .text(
                formatCurrency(marketValue)
            );


        $("#summaryFundingPercent")
            .text(
                fundingPercent > 0
                    ? fundingPercent + "%"
                    : "Not Eligible"
            );


        var maximumLoan =
            marketValue *
            fundingPercent /
            100;


        $("#summaryMaximumLoan")
            .text(
                fundingPercent > 0
                    ? formatCurrency(maximumLoan)
                    : "₹0"
            );


        /* TOP-UP CALCULATION */

        if (
            refinanceType === "BT_TOPUP" &&
            fundingPercent > 0
        ) {

            var outstanding =
                parseFloat(
                    $("#CurrentOutstanding").val() || 0
                );


            var topUp =
                Math.max(
                    maximumLoan - outstanding,
                    0
                );


            $("#summaryNewLoan")
                .text(
                    formatCurrency(maximumLoan)
                );


            $("#summaryOutstanding")
                .text(
                    formatCurrency(outstanding)
                );


            $("#summaryTopUp")
                .text(
                    formatCurrency(topUp)
                );


            $("#topupSummary")
                .show();

        }
        else {

            $("#topupSummary")
                .hide();

        }


        $("#caseFundingSummary")
            .show();

    }

    function formatCurrency(value) {

        return "₹ " +
            Number(value || 0)
                .toLocaleString("en-IN", {
                    maximumFractionDigits: 0
                });
    }

    $(document).on(
        "input",
        "#ExistingPaidEMI,#MarketValue,#CurrentOutstanding",
        function () {

            updateFundingHint();
            updateFundingSummary();

        }
    );


    /* =========================================================
       VEHICLE AGE
       ========================================================= */

    function calculateVehicleAge() {

        var year =
            parseInt(
                $("#ManufacturingYear").val() || 0,
                10
            );


        var month =
            parseInt(
                $("#ManufacturingMonth").val() || 0,
                10
            );


        if (!year || !month) {

            return;

        }


        var today =
            new Date();


        var age =
            today.getFullYear() -
            year;


        if (
            (today.getMonth() + 1) <
            month
        ) {

            age--;

        }


        var caseType =
            $("input[name='Application.CaseType']:checked")
                .val();


        var maxAge =
            caseType === "PURCHASE"
                ? 15
                : 11;


        if (
            caseType &&
            age > maxAge
        ) {

            $("#ManufacturingYear")
                .addClass("input-validation-error");


            alert(
                "Vehicle age is " +
                age +
                " years. Maximum allowed age for this case is " +
                maxAge +
                " years."
            );

        }
        else {

            $("#ManufacturingYear")
                .removeClass("input-validation-error");

        }

    }


    /* =========================================================
       EMI CALCULATION
       ========================================================= */

    function calculateEMI() {

        var principal =
            parseFloat(
                $("#LoanAmount").val() || 0
            );


        var annualRate =
            parseFloat(
                $("#InterestRate").val() || 0
            );


        var months =
            parseInt(
                $("#TenureMonths").val() || 0,
                10
            );


        if (
            principal <= 0 ||
            annualRate <= 0 ||
            months <= 0
        ) {

            $("#EstimatedEMI")
                .val("");

            return;

        }


        var monthlyRate =
            annualRate / 12 / 100;


        var emi =
            principal *
            monthlyRate *
            Math.pow(
                1 + monthlyRate,
                months
            ) /
            (
                Math.pow(
                    1 + monthlyRate,
                    months
                ) - 1
            );


        if (isFinite(emi)) {

            $("#EstimatedEMI")
                .val(
                    "₹ " +
                    emi.toFixed(2)
                );

        }

    }


    /* =========================================================
       CLICK LOAN TYPE
       ========================================================= */

    $(document).on(
        "click",
        ".loan-type-tab",
        function (e) {

            e.preventDefault();

            selectLoanType(
                $(this)
            );

        }
    );


