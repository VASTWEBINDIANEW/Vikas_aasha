                                                                                                                                <i class="fa fa-exchange"></i>
                                                                                                                            </div>

                                                                                                                            <div class="refinance-type-content">

                                                                                                                                <h4>Close Balance Transfer (BT)</h4>

                                                                                                                                <p>
                                                                                                                                    Previous vehicle loan has already been closed
                                                                                                                                    and customer wants fresh finance against the same vehicle.
                                                                                                                                </p>

                                                                                                                                <div class="refinance-example">

                                                                                                                                    <strong>Condition:</strong><br />

                                                                                                                                    Previous vehicle loan must have been closed
                                                                                                                                    within the last <strong>6 months</strong>.

                                                                                                                                    <br /><br />

                                                                                                                                    <strong>Funding:</strong>
                                                                                                                                    Up to <strong>140%</strong> of market value.

                                                                                                                                </div>

                                                                                                                            </div>

                                                                                                                            <div class="refinance-radio">
                                                                                                                                <input type="radio"
                                                                                                                                       name="Application.RefinanceType"
                                                                                                                                       value="CLOSE_BT" />
                                                                                                                            </div>

                                                                                                                        </div>


