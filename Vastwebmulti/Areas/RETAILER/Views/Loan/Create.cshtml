@model Vastwebmulti.Areas.RETAILER.Models.LoanApplicationCreateVM
@{ ViewBag.Title = "Request Loan";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml"; }

<link href="~/MainFrontDesign/css/admin-account-page-modern.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-page-responsive.css" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-filters-unified.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-operator-report-modern.css?v=33" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-money-transfer-report-modern.css?v=26" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-ticket-report-modern.css?v=40" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-flight-travel-report-mobile.css?v=25" rel="stylesheet" />
<link href="~/MainFrontDesign/css/retailer-loan-report-modern.css?v=1" rel="stylesheet" />
<link href="~/MainFrontDesign/css/admin-report-datepicker.css?v=3" rel="stylesheet" />
<link href="~/MainFrontDesign/css/retailer-loan-create-modern.css?v=6" rel="stylesheet" />

<section class="content saas-admin-account-page saas-admin-report-page saas-operator-report-page saas-dmt-report-page saas-ticket-report-page saas-radiant-prepay-page saas-ecommerce-history-page saas-security-report-page saas-loan-report-page saas-retailer-loan-create-page vm-loan-create-radiant-fields">

    <div class="container-fluid vm-opr-page-shell">

        <div class="saas-acc-toolbar saas-acc-toolbar--stacked vm-opr-toolbar-unified vm-radiant-toolbar-shell">
            <div class="saas-acc-toolbar-top vm-opr-toolbar-head vm-dmt-toolbar-head vm-dmt-toolbar-head--one-line vm-radiant-toolbar-one-line vm-ecomm-toolbar-one-line">
                <ol class="saas-acc-breadcrumb vm-dmt-breadcrumb vm-radiant-breadcrumb">
                    <li><a href="@Url.Action("Dashboard", "Home", new { area = "RETAILER" })"><i class="fas fa-home" aria-hidden="true"></i> Dashboard</a></li>
                    <li>Loan</li>
                    <li><a href="@Url.Action("Index", "Loan", new { area = "RETAILER" })">My Applications</a></li>
                    <li>New Request</li>
                </ol>
                <div class="saas-acc-filter-bar vm-opr-filter-row vm-dmt-filter-row vm-dmt-filter-row--one-line vm-dmt-filter-row--ticket vm-dmt-filter-row--radiant vm-radiant-inline-filters vm-ecomm-filter-row--one-line">
                    <div class="vm-dmt-filter-search-group vm-loan-create-toolbar-actions">
                        <a href="@Url.Action("Index", "Loan", new { area = "RETAILER" })" class="saas-acc-btn saas-acc-btn--search saas-acc-report-search-btn vm-opr-toolbar-search vm-radiant-search-btn saas-acc-btn--back" title="Back to list">
                            <i class="fas fa-arrow-left" aria-hidden="true"></i><span>Back</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="vm-opr-main-card vm-retailer-loan-create-main">

            <div class="vm-retailer-loan-create-head vm-dmt-table-panel__head">
                <div class="vm-retailer-loan-create-head__title">
                    <div class="vm-retailer-loan-create-head__icon" aria-hidden="true"><i class="fas fa-file-signature"></i></div>
                    <div>
                        <h3>Request a New Loan</h3>
                        <p>Complete the details below to submit your application.</p>
                    </div>
                </div>
            </div>

            <div class="loan-request-page">
                <div class="loan-shell">
                    <div class="loan-form-card">

            @using (Html.BeginForm(
                "Create",
                "Loan",
                new { area = "RETAILER" },
                FormMethod.Post,
                new
                {
                    @class = "loan-form",
                    novalidate = "novalidate",
                    id = "loanCreateForm"
                }))
            {

@Html.AntiForgeryToken()

                @Html.ValidationSummary(
                                        true,
                                        "",
                                        new { @class = "text-danger validation-summary-errors" }
                                    )
                                <!-- =====================================================
                                1. LOAN TYPE
                                ===================================================== -->

                                                <div class="loan-section">

                                                    <div class="loan-section-heading">



                                                        <div>

                                                            <h4>
                                                                Loan Type
                                                            </h4>

                                                            <span>
                                                                Select the product you would like to apply for.
                                                            </span>

                                                        </div>

                                                    </div>


                                                    <div class="loan-field-grid">

                                                        <div class="loan-field wide">

                                                            <ul class="loan-type-tabs"
                                                                id="loanTypeTabs">

                                                                @foreach (var lt in Model.LoanTypes)
                                                                {

                                                                    string icon =
                                                                        lt.Code == "NEW_CAR"
                                                                            ? "fa-car"
                                                                            : lt.Code == "USED_CAR"
                                                                                ? "fa-automobile"
                                                                                : "fa-money";

                                                <li class="loan-type-tab"
                                                    data-id="@lt.Id"
                                                    data-code="@lt.Code">

                                                    <a href="javascript:void(0);">

                                                        <span class="tab-icon">

                                                            <i class="fa @icon"
                                                               aria-hidden="true"></i>

                                                        </span>

                                                        <span>
                                                            @lt.Name
                                                        </span>

                                                    </a>

                                                </li>
}

                                                            </ul>


                                                            @Html.HiddenFor(
                                                                                    m => m.Application.LoanTypeId,
                                                                                    new { id = "LoanTypeId" }
                                                                                )

                                                            @Html.ValidationMessageFor(
                                                                                    m => m.Application.LoanTypeId,
                                                                                    "",
                                                                                    new { @class = "text-danger" }
                                                                                )

                                                        </div>

                                                    </div>

                                                </div>
                                                                <!-- =====================================================
                                                                2. USED CAR CASE TYPE
                                                                ===================================================== -->

                                                                                <div id="usedCarLoanSection"
                                                                                     class="loan-section"
                                                                                     style="display:none;">

                                                                                    <div class="loan-section-heading">



                                                                                        <div>

                                                                                            <h4>
                                                                                                Used Car Loan Type
                                                                                            </h4>

                                                                                            <span>
                                                                                                Choose the option that matches the customer's requirement.
                                                                                            </span>

                                                                                        </div>

                                                                                    </div>


                                                                                    <div class="used-case-cards">


                                                                                        <!-- PURCHASE -->

                                                                                        <div class="used-case-card"
                                                                                             data-value="PURCHASE">

                                                                                            <div class="used-case-icon">

                                                                                                <i class="fa fa-car"></i>

                                                                                            </div>


                                                                                            <div class="used-case-content">

                                                                                                <h4>
                                                                                                    Purchase Case
                                                                                                </h4>

                                                                                                <p>
                                                                                                    Customer is buying a used car and needs
                                                                                                    a loan to purchase the vehicle.
                                                                                                </p>

                                                                                                <div class="used-case-example">

                                                                                                    <strong>
                                                                                                        Example:
                                                                                                    </strong>

                                                                                                    Customer wants to buy a used Swift
                                                                                                    for ₹6,00,000 and needs finance.

                                                                                                </div>

                                                                                                <div class="used-case-info">

                                                                                                    <i class="fa fa-info-circle"></i>

                                                                                                    Funding can be up to 90% of vehicle
                                                                                                    market value*

                                                                                                </div>

                                                                                            </div>


                                                                                            <div class="used-case-radio">

                                                                                                <input type="radio"
                                                                                                       name="Application.CaseType"
                                                                                                       value="PURCHASE" />

                                                                                            </div>

                                                                                        </div>


                                                                                        <!-- REFINANCE -->

                                                                                        <div class="used-case-card"
                                                                                             data-value="REFINANCE">

                                                                                            <div class="used-case-icon">

                                                                                                <i class="fa fa-money"></i>

                                                                                            </div>


                                                                                            <div class="used-case-content">

                                                                                                <h4>
                                                                                                    Refinance Case
                                                                                                </h4>

                                                                                                <p>
                                                                                                    Customer already owns the vehicle
                                                                                                    and wants to raise money against it.
                                                                                                </p>

                                                                                                <div class="used-case-example">

                                                                                                    <strong>
                                                                                                        Example:
                                                                                                    </strong>

                                                                                                    Customer already owns a car and wants
                                                                                                    funds using that car as security.

                                                                                                </div>

                                                                                                <div class="used-case-info">

                                                                                                    <i class="fa fa-info-circle"></i>

                                                                                                    Select this if the customer already
                                                                                                    owns the car.

                                                                                                </div>

                                                                                            </div>


                                                                                            <div class="used-case-radio">

                                                                                                <input type="radio"
                                                                                                       name="Application.CaseType"
                                                                                                       value="REFINANCE" />

                                                                                            </div>

                                                                                        </div>

                                                                                    </div>


                                                                                    <div class="loan-note">

                                                                                        <i class="fa fa-lightbulb-o"></i>

                                                                                        <strong>
                                                                                            Not sure which one to choose?
                                                                                        </strong>

                                                                                        If the customer is
                                                                                        <strong>buying a used car</strong>,
                                                                                        select <strong>Purchase Case</strong>.

                                                                                        If the customer
                                                                                        <strong>already owns the car</strong>
                                                                                        and wants finance against it,
                                                                                        select <strong>Refinance Case</strong>.

                                                                                    </div>

                                                                                </div>
                                                                                                <!-- =====================================================
                                                                                                2A. REFINANCE TYPE
                                                                                                ===================================================== -->

                                                                                                                <div id="refinanceTypeSection"
                                                                                                                     class="refinance-type-section"
                                                                                                                     style="display:none;">

                                                                                                                    <div class="loan-sub-heading">

                                                                                                                        <h4>
                                                                                                                            <i class="fa fa-refresh"></i>
                                                                                                                            Select Refinance Type
                                                                                                                        </h4>

                                                                                                                        <span>
                                                                                                                            Choose the option that matches the customer's existing loan.
                                                                                                                        </span>

                                                                                                                    </div>


                                                                                                                    <div class="refinance-type-cards">

                                                                                                                        <!-- NORMAL REFINANCE -->
                                                                                                                        <div class="refinance-type-card"
                                                                                                                             data-value="NORMAL_REFINANCE">

                                                                                                                            <div class="refinance-type-icon">
                                                                                                                                <i class="fa fa-money"></i>
                                                                                                                            </div>

                                                                                                                            <div class="refinance-type-content">

                                                                                                                                <h4>Normal Refinance</h4>

                                                                                                                                <p>
                                                                                                                                    Customer already owns the vehicle and wants
                                                                                                                                    to raise funds against the vehicle.
                                                                                                                                </p>

                                                                                                                                <div class="refinance-example">
                                                                                                                                    <strong>Funding:</strong>
                                                                                                                                    Up to <strong>90%</strong> of current vehicle
                                                                                                                                    market value.
                                                                                                                                </div>

                                                                                                                            </div>

                                                                                                                            <div class="refinance-radio">
                                                                                                                                <input type="radio"
                                                                                                                                       name="Application.RefinanceType"
                                                                                                                                       value="NORMAL_REFINANCE" />
                                                                                                                            </div>

                                                                                                                        </div>


                                                                                                                        <!-- CLOSE BT -->
                                                                                                                        <div class="refinance-type-card"
                                                                                                                             data-value="CLOSE_BT">

                                                                                                                            <div class="refinance-type-icon">
                                                                                                                                <i class="fa fa-exchange"></i>
                                                                                                                            </div>

                                                                                                                            <div class="refinance-type-content">

                                                                                                                                <h4>Close Balance Transfer (BT)</h4>

                                                                                                                                <p>
                                                                                                                                    Previous vehicle loan has already been closed
                                                                                                                                    and customer wants fresh finance against the same vehicle.
                                                                                                                                </p>

                                                                                                                                <div class="refinance-example">

                                                                                                                                    <strong>Condition:</strong><br />

                                                                                                                                    Previous vehicle loan must have been closed
                                                                                                                                    within the last <strong>6 months</strong>.

                                                                                                                                    <br /><br />

                                                                                                                                    <strong>Funding:</strong>
                                                                                                                                    Up to <strong>140%</strong> of market value.

                                                                                                                                </div>

                                                                                                                            </div>

                                                                                                                            <div class="refinance-radio">
                                                                                                                                <input type="radio"
                                                                                                                                       name="Application.RefinanceType"
                                                                                                                                       value="CLOSE_BT" />
                                                                                                                            </div>

                                                                                                                        </div>


                                                                                                                        <!-- BT + TOP UP -->
                                                                                                                        <div class="refinance-type-card"
                                                                                                                             data-value="BT_TOPUP">

                                                                                                                            <div class="refinance-type-icon">
                                                                                                                                <i class="fa fa-plus-circle"></i>
                                                                                                                            </div>

                                                                                                                            <div class="refinance-type-content">

                                                                                                                                <h4>Balance Transfer + Top-Up</h4>

                                                                                                                                <p>
                                                                                                                                    Customer currently has a vehicle loan and wants
                                                                                                                                    to transfer the loan and receive additional funds.
                                                                                                                                </p>

                                                                                                                                <div class="refinance-example">

                                                                                                                                    <strong>Minimum:</strong>
                                                                                                                                    12 EMI payments without default/bounce.

                                                                                                                                    <br /><br />

                                                                                                                                    <strong>Funding:</strong><br />

                                                                                                                                    12–16 EMI → <strong>Up to 150-200 %</strong><br />


                                                                                                                                </div>

                                                                                                                            </div>

                                                                                                                            <div class="refinance-radio">
                                                                                                                                <input type="radio"
                                                                                                                                       name="Application.RefinanceType"
                                                                                                                                       value="BT_TOPUP" />
                                                                                                                            </div>

                                                                                                                        </div>

                                                                                                                    </div>

                                                                                                                </div>
                                                                                                                                <!-- =====================================================
                                                                                                                                2C. CASE FUNDING ELIGIBILITY
                                                                                                                                ===================================================== -->

                                                                                                                                                <div id="caseFundingSummary"
                                                                                                                                                     class="loan-section"
                                                                                                                                                     style="display:none;">

                                                                                                                                                    <div class="loan-section-heading">

                                                                                                                                                        <div class="loan-section-number">
                                                                                                                                                            <i class="fa fa-calculator"></i>
                                                                                                                                                        </div>

                                                                                                                                                        <div>
                                                                                                                                                            <h4>Case Funding Eligibility</h4>

                                                                                                                                                            <span>
                                                                                                                                                                Funding limit based on selected case and vehicle value.
                                                                                                                                                            </span>
                                                                                                                                                        </div>

                                                                                                                                                    </div>

                                                                                                                                                    <div class="policy-grid">

                                                                                                                                                        <div class="policy-box">
                                                                                                                                                            <div class="title">Case Type</div>

                                                                                                                                                            <div class="value"
                                                                                                                                                                 id="summaryCaseType">
                                                                                                                                                                -
                                                                                                                                                            </div>
                                                                                                                                                        </div>


                                                                                                                                                        <div class="policy-box">
                                                                                                                                                            <div class="title">Vehicle Market Value</div>

                                                                                                                                                            <div class="value"
                                                                                                                                                                 id="summaryMarketValue">
                                                                                                                                                                ₹0
                                                                                                                                                            </div>
                                                                                                                                                        </div>


                                                                                                                                                        <div class="policy-box">
                                                                                                                                                            <div class="title">Applicable Funding</div>

                                                                                                                                                            <div class="value"
                                                                                                                                                                 id="summaryFundingPercent">
                                                                                                                                                                0%
                                                                                                                                                            </div>
                                                                                                                                                        </div>


                                                                                                                                                        <div class="policy-box">
                                                                                                                                                            <div class="title">Maximum Vehicle Funding</div>

                                                                                                                                                            <div class="value"
                                                                                                                                                                 id="summaryMaximumLoan">
                                                                                                                                                                ₹0
                                                                                                                                                            </div>
                                                                                                                                                        </div>

                                                                                                                                                    </div>


                                                                                                                                                    <!-- Only visible for BT + Top-Up -->

                                                                                                                                                    <div id="topupSummary"
                                                                                                                                                         class="loan-note"
                                                                                                                                                         style="display:none;">

                                                                                                                                                        <strong>Top-Up Calculation</strong>

                                                                                                                                                        <div style="margin-top:8px;">

                                                                                                                                                            Maximum New Loan:
                                                                                                                                                            <strong id="summaryNewLoan">₹0</strong>

                                                                                                                                                            <br />

                                                                                                                                                            Existing Loan Outstanding:
                                                                                                                                                            <strong id="summaryOutstanding">₹0</strong>

                                                                                                                                                            <br />

                                                                                                                                                            Potential Top-Up:
                                                                                                                                                            <strong id="summaryTopUp">₹0</strong>

                                                                                                                                                        </div>

                                                                                                                                                    </div>

                                                                                                                                                </div>
                                                                                                                                                                <!-- =====================================================
                                                                                                                                                                3. APPLICANT
                                                                                                                                                                ===================================================== -->

                                                                                                                                                                                <div class="loan-section">

                                                                                                                                                                                    <div class="loan-section-heading">



                                                                                                                                                                                        <div>

                                                                                                                                                                                            <h4>
                                                                                                                                                                                                Applicant Details
                                                                                                                                                                                            </h4>

                                                                                                                                                                                            <span>
                                                                                                                                                                                                Tell us a little about the applicant.
                                                                                                                                                                                            </span>

                                                                                                                                                                                        </div>

                                                                                                                                                                                    </div>


                                                                                                                                                                                    <div class="loan-field-grid">


                                                                                                                                                                                        <div class="loan-field">

                                                                                                                                                                                            @Html.LabelFor(
                                                                                                                                                                                                                    m => m.Application.FullName
                                                                                                                                                                                                                )

                                                                                                                                                                                            <span class="required">*</span>

                                                                                                                                                                                            @Html.TextBoxFor(
                                                                                                                                                                                                                    m => m.Application.FullName,
                                                                                                                                                                                                                    new
                                                                                                                                                                                                                    {
                                                                                                                                                                                                                        @class = "form-control",
                                                                                                                                                                                                                        placeholder = "Enter full name"
                                                                                                                                                                                                                    }
                                                                                                                                                                                                                )

                                                                                                                                                                                            @Html.ValidationMessageFor(
                                                                                                                                                                                                                    m => m.Application.FullName,
                                                                                                                                                                                                                    "",
                                                                                                                                                                                                                    new { @class = "text-danger" }
                                                                                                                                                                                                                )

                                                                                                                                                                                        </div>


                                                                                                                                                                                        <div class="loan-field">

                                                                                                                                                                                            @Html.LabelFor(
                                                                                                                                                                                                                    m => m.Application.Mobile
                                                                                                                                                                                                                )

                                                                                                                                                                                            <span class="required">*</span>

                                                                                                                                                                                            @Html.TextBoxFor(
                                                                                                                                                                                                                    m => m.Application.Mobile,
                                                                                                                                                                                                                    new
                                                                                                                                                                                                                    {
                                                                                                                                                                                                                        @class = "form-control",
                                                                                                                                                                                                                        maxlength = "15",
                                                                                                                                                                                                                        type = "tel",
                                                                                                                                                                                                                        placeholder = "Enter mobile number"
                                                                                                                                                                                                                    }
                                                                                                                                                                                                                )

                                                                                                                                                                                            @Html.ValidationMessageFor(
                                                                                                                                                                                                                    m => m.Application.Mobile,
                                                                                                                                                                                                                    "",
                                                                                                                                                                                                                    new { @class = "text-danger" }
                                                                                                                                                                                                                )

                                                                                                                                                                                        </div>


                                                                                                                                                                                        <div class="loan-field">

                                                                                                                                                                                            @Html.LabelFor(
                                                                                                                                                                                                                    m => m.Application.Email
                                                                                                                                                                                                                )

                                                                                                                                                                                            <span class="required">*</span>

                                                                                                                                                                                            @Html.TextBoxFor(
                                                                                                                                                                                                                    m => m.Application.Email,
                                                                                                                                                                                                                    new
                                                                                                                                                                                                                    {
                                                                                                                                                                                                                        @class = "form-control",
                                                                                                                                                                                                                        type = "email",
                                                                                                                                                                                                                        placeholder = "Enter email address"
                                                                                                                                                                                                                    }
                                                                                                                                                                                                                )

                                                                                                                                                                                            @Html.ValidationMessageFor(
                                                                                                                                                                                                                    m => m.Application.Email,
                                                                                                                                                                                                                    "",
                                                                                                                                                                                                                    new { @class = "text-danger" }
                                                                                                                                                                                                                )

                                                                                                                                                                                        </div>


                                                                                                                                                                                        <div class="loan-field">

                                                                                                                                                                                            @Html.LabelFor(
                                                                                                                                                                                                                    m => m.Application.DOB
                                                                                                                                                                                                                )

                                                                                                                                                                                            <span class="required">*</span>

                                                                                                                                                                                            <div class="saas-acc-dp-field vm-opr-dp-compact vm-dmt-field--date vm-loan-form-date">
                                                                                                                                                                                                <span class="saas-acc-dp-icon"><i class="fa fa-calendar" aria-hidden="true"></i></span>
                                                                                                                                                                                                @Html.TextBoxFor(
                                                                                                                                                                                                                        m => m.Application.DOB,
                                                                                                                                                                                                                        "{0:yyyy-MM-dd}",
                                                                                                                                                                                                                        new
                                                                                                                                                                                                                        {
                                                                                                                                                                                                                            @class = "form-control saas-acc-dp-input vm-loan-form-date-input",
                                                                                                                                                                                                                            autocomplete = "off",
                                                                                                                                                                                                                            placeholder = "Date of birth"
                                                                                                                                                                                                                        }
                                                                                                                                                                                                                    )
                                                                                                                                                                                            </div>

                                                                                                                                                                                            @Html.ValidationMessageFor(
                                                                                                                                                                                                                    m => m.Application.DOB,
                                                                                                                                                                                                                    "",
                                                                                                                                                                                                                    new { @class = "text-danger" }
                                                                                                                                                                                                                )

                                                                                                                                                                                        </div>


                                                                                                                                                                                        <div class="loan-field">

                                                                                                                                                                                            @Html.LabelFor(
                                                                                                                                                                                                                    m => m.Application.Gender
                                                                                                                                                                                                                )

                                                                                                                                                                                            <span class="required">*</span>

                                                                                                                                                                                            @Html.DropDownListFor(
                                                                                                                                                                                                                    m => m.Application.Gender,
                                                                                                                                                                                                                    new List<SelectListItem>
                                                                                                                                                                                                                    {
                    new SelectListItem
                    {
                        Text = "Male",
                        Value = "Male"
                    },
                    new SelectListItem
                    {
                        Text = "Female",
                        Value = "Female"
                    },
                    new SelectListItem
                    {
                        Text = "Other",
                        Value = "Other"
                    }
},
                                                                                                                                                                                                                    "-- Select gender --",
                                                                                                                                                                                                                    new { @class = "form-control" }
                                                                                                                                                                                                                )

                                                                                                                                                                                            @Html.ValidationMessageFor(
                                                                                                                                                                                                                    m => m.Application.Gender,
                                                                                                                                                                                                                    "",
                                                                                                                                                                                                                    new { @class = "text-danger" }
                                                                                                                                                                                                                )

                                                                                                                                                                                        </div>


                                                                                                                                                                                        <div class="loan-field">

                                                                                                                                                                                            @Html.LabelFor(
                                                                                                                                                                                                                    m => m.Application.PAN
                                                                                                                                                                                                                )

                                                                                                                                                                                            <span class="required">*</span>

                                                                                                                                                                                            @Html.TextBoxFor(
                                                                                                                                                                                                                    m => m.Application.PAN,
                                                                                                                                                                                                                    new
                                                                                                                                                                                                                    {
                                                                                                                                                                                                                        @class = "form-control",
                                                                                                                                                                                                                        maxlength = "10",
                                                                                                                                                                                                                        style = "text-transform:uppercase",
                                                                                                                                                                                                                        placeholder = "ABCDE1234F"
                                                                                                                                                                                                                    }
                                                                                                                                                                                                                )

                                                                                                                                                                                            @Html.ValidationMessageFor(
                                                                                                                                                                                                                    m => m.Application.PAN,
                                                                                                                                                                                                                    "",
                                                                                                                                                                                                                    new { @class = "text-danger" }
                                                                                                                                                                                                                )

                                                                                                                                                                                        </div>

                                                                                                                                                                                    </div>

                                                                                                                                                                                </div>
                                                                                                                                                                                                <!-- =====================================================
                                                                                                                                                                                                4. ADDRESS
                                                                                                                                                                                                ===================================================== -->

                                                                                                                                                                                                                <div class="loan-section">

                                                                                                                                                                                                                    <div class="loan-section-heading">



                                                                                                                                                                                                                        <div>

                                                                                                                                                                                                                            <h4>
                                                                                                                                                                                                                                Address
                                                                                                                                                                                                                            </h4>

                                                                                                                                                                                                                            <span>
                                                                                                                                                                                                                                Enter the applicant's current residential address.
