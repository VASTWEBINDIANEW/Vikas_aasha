            handleCaseType(
                $(this).val()
            );

        }
    );


    /* =========================================================
       REFINANCE CARD
       ========================================================= */

    $(document).on(
        "click",
        ".refinance-type-card",
        function () {

            var value =
                $(this).data("value");


            $(this)
                .find("input[type='radio']")
                .prop("checked", true);


            handleRefinanceType(value);

        }
    );


    /* =========================================================
       REFINANCE RADIO
       ========================================================= */

    $(document).on(
        "change",
        "input[name='Application.RefinanceType']",
        function () {

            handleRefinanceType(
                $(this).val()
            );

        }
    );


    /* =========================================================
       INPUT EVENTS
       ========================================================= */

    $(document).on(
        "change",
        "#ManufacturingYear,#ManufacturingMonth",
        function () {

            calculateVehicleAge();

        }
    );


    $(document).on(
        "input",
        "#LoanAmount,#InterestRate,#TenureMonths",
        function () {

            calculateEMI();

        }
    );


    /* =========================================================
       DOCUMENT READY
       ========================================================= */

    $(document).on(
        "click.loanCreateDate",
        "#loanCreateForm .vm-loan-form-date .saas-acc-dp-input",
        function (e) {
            e.preventDefault();
            showLoanCreateDatePicker($(this));
        }
    );


    $(document).on(
        "click.loanCreateDate",
        "#loanCreateForm .vm-loan-form-date .saas-acc-dp-icon",
        function (e) {
            e.preventDefault();
            var $input = $(this).closest(".saas-acc-dp-field").find(".saas-acc-dp-input").first();
            showLoanCreateDatePicker($input);
        }
    );


    $(document).ready(function () {

        initLoanCreateSelect2();
        initLoanCreateDatePickers();

        /* Default Loan Type */

        var currentId =
            $("#LoanTypeId").val();


        var $defaultTab;


        if (
            currentId &&
            currentId !== "0"
        ) {

            $defaultTab =
                $(".loan-type-tab[data-id='" +
                    currentId +
                    "']");

        }
        else {

            $defaultTab =
                $(".loan-type-tab").first();

        }


        if ($defaultTab.length) {

            selectLoanType(
                $defaultTab
            );

        }


        /* Existing selected Case Type */

        var existingCase =
            $("input[name='Application.CaseType']:checked")
                .val();


        if (existingCase) {

            handleCaseType(
                existingCase
            );

        }


        /* Existing refinance */

        var existingRefinance =
            $("input[name='Application.RefinanceType']:checked")
                .val();


        if (existingRefinance) {

            handleRefinanceType(
                existingRefinance
            );

        }


        calculateEMI();

    });


    /* =========================================================
       MINIMUM AGE VALIDATOR
       ========================================================= */

    if (
        $.validator &&
        $.validator.addMethod
    ) {

        $.validator.addMethod(
            "minimumage",
            function (value, element, params) {

                if (!value) {

                    return true;

                }


                var dob =
                    new Date(value);


                var today =
                    new Date();


                var age =
                    today.getFullYear() -
                    dob.getFullYear();


                var month =
                    today.getMonth() -
                    dob.getMonth();


                if (
                    month < 0 ||
                    (
                        month === 0 &&
                        today.getDate() <
                        dob.getDate()
                    )
                ) {

                    age--;

                }


                return age >= params.min;

            }
        );


        if (
            $.validator.unobtrusive
        ) {

            $.validator.unobtrusive.adapters.add(
                "minimumage",
                ["min"],
                function (options) {

                    options.rules["minimumage"] = {

                        min: options.params.min

                    };


                    options.messages["minimumage"] =
                        options.message;

                }
            );

        }

    }

</script>
