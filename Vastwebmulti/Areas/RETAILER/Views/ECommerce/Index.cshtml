@model Vastwebmulti.Areas.RETAILER.ViewModels.ProductVM
@{
    ViewBag.Title = "E-Commerce";
    Layout = "~/Areas/RETAILER/Views/Shared/_Layout.cshtml";
    string serviceerror = Convert.ToString(ViewBag.servicefressornot);
}

<link href="~/MainFrontDesign/css/retailer-money-transfer-modern.css?v=45" rel="stylesheet" />
<link href="~/MainFrontDesign/css/retailer-ecommerce-modern.css?v=52" rel="stylesheet" />
<link href="~/AdminDesign/plugins/animate-css/animate.min.css" rel="stylesheet" />

<section id="vmEcommPage" class="vm-rmt-page vm-ecomm-page content" data-find-url="@Url.Action("FindProductByName")">

    @if (serviceerror == "NOTOK")
    {
        <div id="firstECOMM" class="vm-ecomm-expired col-md-12">
            <img src="~/ashok-images/forbidden.svg" alt="" />
            <span class="bodycolormy">ECOMMERCE Service Expired !</span>
            <p style="margin-bottom: 20px;text-align: justify;">Your service is currently down, if you want to keep the service running smoothly, you will have to pay the service fee, which you see below and you can purchase the service by clicking the button.</p>
            <button type="button" class="btn btn-default fullbodydycolorbg" onclick="PurchaseECOMM('ECOMM')" style="color: #fff;">ECOMMERCE Purchase</button>
            <button type="button" class="btn btn-default fullbodydycolorbg" onClick="window.location.href=window.location.href">Refresh Page</button>
        </div>
    }
    else if (serviceerror == "ALLNOTDONE")
    {
        <div id="ALLECOMM" class="vm-ecomm-expired col-md-12">
            <img src="~/ashok-images/forbidden.svg" alt="" />
            <span class="bodycolormy">ECOMMERCE Service Expired !</span>
            <p style="margin-bottom: 20px;text-align: justify;">Your service is currently down, if you want to keep the service running smoothly, you will have to pay the service fee, which you see below and you can purchase the service by clicking the button.</p>
            <button type="button" class="btn btn-default fullbodydycolorbg" onclick="PurchaseECOMM('ALL')" style="color: #fff;">ALL Purchase</button>
            <button type="button" class="btn btn-default fullbodydycolorbg" onClick="window.location.href=window.location.href">Refresh Page</button>
        </div>
    }
    else if (serviceerror == "BOTHNOTDONE")
    {
        <div id="BOTHECOMM" class="vm-ecomm-expired col-md-12">
            <img src="~/ashok-images/forbidden.svg" alt="" />
            <span class="bodycolormy">ECOMMERCE Service Expired !</span>
            <p style="margin-bottom: 20px;text-align: justify;">Your service is currently down, if you want to keep the service running smoothly, you will have to pay the service fee, which you see below and you can purchase the service by clicking the button.</p>
            <button type="button" class="btn btn-default fullbodydycolorbg" onclick="PurchaseECOMM('ALL')" style="color: #fff;">ALL Purchase</button>
            <button type="button" class="btn btn-default fullbodydycolorbg" onclick="PurchaseECOMM('ECOMM')" style="color: #fff;">ECOMMERCE Purchase</button>
            <button type="button" class="btn btn-default fullbodydycolorbg" onClick="window.location.href=window.location.href">Refresh Page</button>
        </div>
    }
    else if (serviceerror == "OK")
    {
        <div id="full" class="vm-rmt-left-panel">
            <div class="vm-rmt-left-shell">
                <div class="vm-ecomm-sidebar-head">
                    <i class="material-icons" aria-hidden="true">category</i>
                    <span>Browse categories</span>
                </div>
                @Html.Action("_MenuList")
            </div>
        </div>
        <div class="vm-rmt-report-panel vm-ecomm-main">
            <div class="vm-rmt-report-shell">
                <div id="lstProducts">
                    @Html.Action("_productlist", "ECommerce", new { ProductName = Model.ProductName, SortBy = Model.SortBy })
                </div>
            </div>
        </div>
    }

    <div id="secpurECOMM" class="col-md-12 remitter_button remitter_buttonewq vm-ecomm-expired" style="display:none;text-align: center;">
        <span style="margin-top:0;">Payment Details</span>
        <div class="lavbrd">
            <label>Mode</label>
            <label class="rightlable" id="PaymentType111"></label>
        </div>
        <div class="lavbrd">
            <label>Amount</label>
            <label class="rightlable" id="Price111"></label>
        </div>
        <div class="coldebuttonnew">
            <button type="button" class="bacbuttonrrt" onClick="window.location.href=window.location.href">Back</button>
            <button type="button" class="btn btn-default fullbodydycolorbg" onclick="FinalPurchaseECOMM()" style="color: #fff;">Pay Now</button>
        </div>
        <br />
        <label id="errmsgmicro" style="color:red;"></label>
    </div>

    <input type="hidden" id="HDServicesname" name="HDServicesname" value="" />
</section>

@using (Ajax.BeginForm("_productlist", "ECommerce", new AjaxOptions
{
    UpdateTargetId = "lstProducts",
    InsertionMode = InsertionMode.Replace,
    LoadingElementId = "loadermoney",
    OnComplete = "OnComplete"
}))
{
    <input type="hidden" name="ProductName" id="ProductName" />
    <input type="hidden" name="SubCatId" id="SubCatId" />
    <input type="hidden" name="Price" id="Price" />
    <input type="hidden" name="SortBy" id="SortBy" />
    <input type="hidden" name="FilterBy" id="FilterBy" />
    <input type="submit" id="lstProductsSubmit" class="vm-ecomm-ajax-submit" value="" aria-hidden="true" tabindex="-1" />
}
@Html.Partial("Loder")

@section PostVmScripts {
    <script src="~/AdminDesign/js/pages/ui/animations.js"></script>
    <script src="~/AdminDesign/plugins/bootstrap-notify/bootstrap-notify.min.js"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>
    <script src="~/Scripts/PageScript/Retailer/ProductList.js?v=5"></script>
    <script>
        function vmEcommInitSearchAutocomplete() {
            var $input = jQuery('#txtSearch');
            if (!$input.length || !jQuery.fn.autocomplete) {
                return;
            }
            try {
                if ($input.autocomplete('instance')) {
                    $input.autocomplete('destroy');
                }
            } catch (e) { }
            var url = jQuery('#vmEcommPage').data('find-url');
            $input.autocomplete({
                source: url,
                minLength: 1
            });
        }

        function PurchaseECOMM(e) {
            jQuery('#HDServicesname').val('');
            jQuery.ajax({
                url: '@Url.Action("ServiceCharge", "Home")',
                data: { Service: e },
                cache: false,
                type: 'POST',
                dataType: 'json',
                success: function (data) {
                    jQuery('#secpurECOMM').show();
                    jQuery('#PaymentType111').html(data.PaymentType);
                    jQuery('#Price111').html(data.Price);
                    jQuery('#ALLECOMM').hide();
                    jQuery('#BOTHECOMM').hide();
                    jQuery('#firstECOMM').hide();
                    jQuery('#HDServicesname').val(e);
                }
            });
        }

        function FinalPurchaseECOMM() {
            jQuery.ajax({
                url: '@Url.Action("ServicePurchase", "Home")',
                data: { Service: jQuery('#HDServicesname').val() },
                cache: false,
                type: 'POST',
                dataType: 'json',
                beforeSend: function () {
                    jQuery('.loader').show();
                },
                success: function (data) {
                    if (data.Status == 'Success') {
                        jQuery('#HDServicesname').val('');
                        window.location.reload();
                    } else {
                        jQuery('#errmsgmicro').text(data.Message);
                    }
                },
                complete: function () {
                    jQuery('.loader').hide();
                    jQuery('#remainretailer').load(location.href + ' #remainretailer');
                },
                error: function () {
                    jQuery('#remainretailer').load(location.href + ' #remainretailer');
                    jQuery('.loader').hide();
                }
            });
        }

        jQuery(function ($) {
            var initialSort = '@(Model.SortBy ?? "")';
            if (initialSort) {
                jQuery('#SortBy').val(initialSort);
            }
            var initialSearch = '@(Model.ProductName ?? "")';
            if (initialSearch) {
                jQuery('#ProductName').val(initialSearch);
            }
            var sts = '@TempData["Status"]';
            var msg = '@TempData["Message"]';
            if (sts != null && sts !== '') {
                if (sts === 'Success') {
                    $.notify(msg, {
                        animate: { enter: 'animated fadeInRight', exit: 'animated fadeOutRight' },
                        type: 'success'
                    });
                } else {
                    $.notify(msg, {
                        animate: { enter: 'animated fadeInRight', exit: 'animated fadeOutRight' },
                        type: 'danger'
                    });
                }
            }
            vmEcommInitSearchAutocomplete();
        });
    </script>
}
