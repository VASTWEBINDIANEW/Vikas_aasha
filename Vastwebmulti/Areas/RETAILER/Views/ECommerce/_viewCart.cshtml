@model List<Vastwebmulti.Areas.RETAILER.Models.CartVM>
@if (Model != null && Model.Count > 0)
{
    var subtotal = Model.Sum(a => a.satandardPrice * a.Qty);
    var mrpTotal = Model.Sum(a => a.ListPrice * a.Qty);
    var savings = mrpTotal - subtotal;

    <div class="vm-ecomm-cart-layout">
        <div class="vm-ecomm-cart-main">
            <div class="vm-ecomm-cart-card">
                <div class="vm-ecomm-cart-card__head">
                    <h2>Cart items</h2>
                    <span class="vm-ecomm-cart-card__count">@Model.Count in cart</span>
                </div>
                <div class="vm-ecomm-cart-items">
                    @foreach (var item in Model)
                    {
                        var lineTotal = item.satandardPrice * item.Qty;
                        <article class="vm-ecomm-cart-item" data-product-id="@item.productId">
                            <a class="vm-ecomm-cart-item__img" href="@Url.Action("ProductView", "ECommerce", new { area = "RETAILER", id = item.productId, type = "show" })" target="_blank">
                                <img src="@Url.Content("~" + item.imgUrl)" alt="@item.productName" />
                            </a>
                            <div class="vm-ecomm-cart-item__body">
                                <div class="vm-ecomm-cart-item__top">
                                    <h3 class="vm-ecomm-cart-item__title">@item.productName</h3>
                                    <button type="button" class="vm-ecomm-cart-item__remove" onclick="onRemoveItem('@item.productId')" title="Remove item" aria-label="Remove @item.productName">
                                        <i class="material-icons">delete_outline</i>
                                    </button>
                                </div>
                                <p class="vm-ecomm-cart-item__seller">Seller: @item.VenderFirmName</p>
                                <p class="vm-ecomm-cart-item__price">
                                    <strong>₹ @item.satandardPrice</strong>
                                    <span class="vm-ecomm-cart-item__mrp">₹ @item.ListPrice</span>
                                </p>
                                <p class="vm-ecomm-cart-item__min">Min order qty: @item.MinOrderQty</p>
                                <div class="vm-ecomm-cart-item__qty">
                                    <span class="vm-ecomm-cart-item__qty-label">Qty</span>
                                    <div class="vm-ecomm-qty-stepper">
                                        <button type="button" class="vm-ecomm-qty-stepper__btn" onclick="onMinus('@item.productId')" aria-label="Decrease quantity">
                                            <i class="material-icons">remove</i>
                                        </button>
                                        <input type="text"
                                               class="vm-ecomm-qty-stepper__input"
                                               value="@item.Qty"
                                               id="txtQTY_@item.productId"
                                               data-product-id="@item.productId"
                                               data-last-qty="@item.Qty"
                                               onblur="onChange(this,'@item.productId')"
                                               onkeypress="return isNumber(event)"
                                               aria-label="Quantity for @item.productName" />
                                        <button type="button" class="vm-ecomm-qty-stepper__btn" onclick="onPluse('@item.productId')" aria-label="Increase quantity">
                                            <i class="material-icons">add</i>
                                        </button>
                                    </div>
                                    <span class="vm-ecomm-cart-item__line-total">Line total: ₹ @lineTotal</span>
                                </div>
                            </div>
                        </article>
                    }
                </div>
                <div class="vm-ecomm-cart-actions">
                    <a href="@Url.Action("Index", "ECommerce", new { area = "RETAILER" })" class="vm-ecomm-btn-ghost vm-ecomm-cart-actions__continue">
                        <i class="material-icons">storefront</i>
                        <span>Continue shopping</span>
                    </a>
                    @using (Html.BeginForm("doPayment", "ECommerce", FormMethod.Post, new { @class = "vm-ecomm-cart-pay-form" }))
                    {
                        <input type="hidden" name="productID" value="@Model.FirstOrDefault().productId" />
                        <button type="submit" id="pay" class="vm-ecomm-cart-pay-btn" onclick="return confirm('Are you sure you want to pay for this order?');">
                            <i class="material-icons">bolt</i>
                            <span>Pay now</span>
                        </button>
                    }
                </div>
            </div>
        </div>

        <aside class="vm-ecomm-cart-summary">
            <div class="vm-ecomm-cart-summary__card">
                <h2 class="vm-ecomm-cart-summary__title">Price details</h2>
                <ul class="vm-ecomm-cart-summary__list">
                    <li>
                        <span>Price (@Model.Count items)</span>
                        <strong>₹ @subtotal</strong>
                    </li>
                    <li>
                        <span>Delivery</span>
                        <strong class="vm-ecomm-cart-summary__free">FREE</strong>
                    </li>
                    <li class="vm-ecomm-cart-summary__total">
                        <span>Amount payable</span>
                        <strong>₹ @subtotal</strong>
                    </li>
                    @if (savings > 0)
                    {
                        <li class="vm-ecomm-cart-summary__savings">
                            <span>You save on this order</span>
                            <strong>₹ @string.Format("{0:0.00}", savings)</strong>
                        </li>
                    }
                </ul>
                @using (Html.BeginForm("doPayment", "ECommerce", FormMethod.Post, new { @class = "vm-ecomm-cart-pay-form vm-ecomm-cart-pay-form--summary" }))
                {
                    <input type="hidden" name="productID" value="@Model.FirstOrDefault().productId" />
                    <button type="submit" class="vm-ecomm-cart-pay-btn vm-ecomm-cart-pay-btn--block" onclick="return confirm('Are you sure you want to pay for this order?');">
                        <i class="material-icons">bolt</i>
                        <span>Pay now — ₹ @subtotal</span>
                    </button>
                }
            </div>
        </aside>
    </div>
}
else
{
    <div class="vm-ecomm-empty vm-ecomm-cart-empty-in-card">
        <div class="vm-ecomm-empty__icon" aria-hidden="true">
            <i class="material-icons">remove_shopping_cart</i>
        </div>
        <h3>Your cart is empty</h3>
        <p>Browse the store, add products to cart, and they will appear here for checkout.</p>
        <a href="@Url.Action("Index", "ECommerce", new { area = "RETAILER" })" class="vm-ecomm-empty__btn">Browse products</a>
    </div>
}
