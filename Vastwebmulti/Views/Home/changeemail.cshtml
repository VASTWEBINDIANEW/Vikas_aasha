@{
    Layout = "~/Views/Shared/_MainLayout.cshtml";
    ViewBag.Title = "Change Email";
}
<section class="content" style="padding:40px 0;">
    <div class="container">
        <div class="row">
            <div class="col-md-6 col-md-offset-3">
                <div class="panel panel-default">
                    <div class="panel-heading"><h3>Change Email Address</h3></div>
                    <div class="panel-body">
                        @using (Html.BeginForm("changeemail", "Home", FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <div class="form-group">
                                <label>Old Email</label>
                                <input type="email" name="oldemail" class="form-control" required />
                            </div>
                            <div class="form-group">
                                <label>New Email</label>
                                <input type="email" name="newmail" class="form-control" required />
                            </div>
                            <button type="submit" class="btn btn-primary">Update Email</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
