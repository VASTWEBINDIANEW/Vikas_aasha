                                <div class="vm-login-visual__content">
                            @if (ViewBag.Loginsilder != null)
                            {
                                try
                                {
                                    <div id="carousel" class="owl-carousel vm-login-visual__slider">
                                        @foreach (var item in ViewBag.Loginsilder)
                                        {
                                            if (item.Status == "Y")
                                            {

                                                <div class="item">
                                                    <img src="@Url.Content("~/" + item.ImagePath)" alt="Login slide" />
                                                </div>

                                            }
                                            else
                                            {
                                                <div class="item">
                                                    <img src="~/images/Default_Login.jpg" alt="Login slide" />
                                                </div>
                                            }
                                        }
                                    </div>
                                }

                                catch
                                {

                                }

                            }
                            else if (ViewBag.Logo != null)
                            {
                                <div class="vm-login-visual__brand">
                                    <img src="@Url.Content("~/" + ViewBag.Logo)" class="vm-login-visual__logo" alt="@companyname" />
