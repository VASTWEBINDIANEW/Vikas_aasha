@model Vastwebmulti.Models.RegisterViewModel
@using Vastwebmulti.Models;
@{
    Layout = null;
}
@{
    VastwebmultiEntities db = new VastwebmultiEntities();
    var ccc = db.tblContects.ToList();
    var companyname = ccc.Count == 0 ? "" : ccc.SingleOrDefault().CompnayName;
    var loginimage = db.tblLoginContents.ToList();
    if (loginimage.Count > 0)
    {
        ViewBag.loginimage = loginimage.FirstOrDefault().Image;
    }
    else
    {
        ViewBag.loginimage = "Login_Images/login22.png";
    }

    var image1 = "";
    var fullpath = "";
    var size = "";
    var repeat = "";
    var height = "";
    var backgroundImage = "";
    var image = db.tblWhiteLabelLoginBackImages.Where(p => p.Role == "ADMIN").ToList();
    if (image.Count > 0)
    {
        //if (image.SingleOrDefault(a=>a.UsedFor=="Repeat" && a.StatusCheck == "Y").otherimage == null)
        if (image.Where(a => a.UsedFor == "Repeat" && a.StatusCheck == "Y").SingleOrDefault() != null)
        {
            //image1 = image.SingleOrDefault().ImageUrl;
            //fullpath = "../FooterImages/" + image1;
            image1 = image.SingleOrDefault(a => a.UsedFor == "Repeat").otherimage;
            var ddd = image1.Replace(@"\", "/");
            fullpath = "../.." + ddd;

        }
        else if (image.Where(a => a.UsedFor == "Single" && a.StatusCheck == "Y").SingleOrDefault() != null)
        {
            image1 = image.SingleOrDefault(a => a.UsedFor == "Single").otherimage;
            var ddd = image1.Replace(@"\", "/");
            fullpath = "../.." + ddd;

            size = "cover";
            repeat = "no-repeat";
            height = "100vh";
        }
        else
        {
            backgroundImage = "linear-gradient(to right , var(--main-bg-lcolor), var(--main-bg-rcolor)) !important";
        }
    }
    else
    {
        image1 = "img32.png";
        fullpath = "../FooterImages/" + image1;
        backgroundImage = "linear-gradient(to right , var(--main-bg-lcolor), var(--main-bg-rcolor)) !important";
    }
    var admindetail = db.Admin_details.ToList();
    var mailid = admindetail.SingleOrDefault().email;
    var mobile = admindetail.SingleOrDefault().mobile;
    var background = fullpath;
    var Firm_Name = admindetail.SingleOrDefault().Companyname;
    //ViewBag.image = image.Count == 0 ? "" : image.SingleOrDefault().ImageUrl;

    //string RDate = admindetail.FirstOrDefault().Date.ToString();
    //string[] gg = RDate.Split('-');
    //var RYear = gg[2].Split(' ')[0].ToString();
    /*************************************************************/

    var col = db.changecolors.ToList();
    var color = "";
    if (col.Count > 0)
    {
        color = col.SingleOrDefault(p => p.Role == "ADMIN").adminandouterheadercolor;
    }
    else
    {
        color = "Gray";
    }
    //var color = col.Count == 0 ? "" : col.SingleOrDefault(p => p.Role == "ADMIN").adminandouterheadercolor;

    // New work
    var entry = db.RetailerCreationCharges.FirstOrDefault();
    bool isAdminFree = entry?.CreatedByAdminIsFree ?? false;
    bool isSignUpFree = entry?.CreatedBySignUpIsFree ?? false;
    var useGradientBg = !string.IsNullOrEmpty(backgroundImage);
    if (string.IsNullOrEmpty(size)) { size = "cover"; }
    if (string.IsNullOrEmpty(repeat)) { repeat = "no-repeat"; }
}

<!DOCTYPE html>

<html>
<head>
    <title>@companyname</title>
    <!-- Meta tag Keywords -->
    @{
        var favimage = "";
        VastwebmultiEntities db2 = new VastwebmultiEntities();
        var faviconlogo = db2.tblfavicons.Where(p => p.Role == "ADMIN").ToList();
        if (faviconlogo.Count() > 0)
        {
            if (faviconlogo.SingleOrDefault().Role == "ADMIN")
            {
                favimage = faviconlogo.SingleOrDefault().faviconimage;

            }
        }
        else
        {
            <link rel="icon" href="" type="image/x-icon" />
        }
    }
    <link rel="icon" href="@Url.Content("~/" + @favimage)" type="image/x-icon" />
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="keywords" content="Classic Forms Responsive Widget,Login form widgets, Sign up Web forms , Login signup Responsive web form,Flat Pricing table,Flat Drop downs,Registration Forms,News letter Forms,Elements" />
    <script type="application/x-javascript">
         addEventListener("load", function() { setTimeout(hideURLbar, 0); }, false);
        function hideURLbar(){ window.scrollTo(0,1); } </script>
    <!-- Meta tag Keywords -->
    <!-- css files -->
    <link href="~/NewLoginDesign/css/font-awesome.css" rel="stylesheet" />
    <link href="~/NewLoginDesign/css/style.css" rel="stylesheet" />
    @*<link href="~/CSS/aaaaa.css" rel="stylesheet" />*@
    <link href="~/NewLoginDesign/css/bootstrap-responsive.min.css" rel="stylesheet" />

    <!-- Font-Awesome-Icons-CSS -->
    <!-- //css files -->
    <!-- Web-Fonts -->
    <link href="~/NewLoginDesign/css/owl.carousel.min.css" rel="stylesheet" />
    <link href="//fonts.googleapis.com/css?family=Josefin+Sans:100,100i,300,300i,400,400i,600,600i,700,700i" rel="stylesheet">
    <link href='//fonts.googleapis.com/css?family=Open+Sans:400,600,700' rel='stylesheet' type='text/css'>
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600,700|Roboto:100,400,400i,500,500i,700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.1.0/css/bootstrap.min.css">
    <link href="~/MainFrontDesign/css/Custom-style.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="~/MainFrontDesign/css/public-login-modern.css?v=3" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/1.14.0/umd/popper.min.js"></script>
    <script src="https://maxcdn.bootstrapcdn.com/bootstrap/4.1.0/js/bootstrap.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css">
    <script src="~/Scripts/owl.carousel.min.js"></script>
    <script defer src="~/Scripts/owl.carousel.js"></script>

    @if (!HttpContext.Current.Request.IsLocal)
    {
        <!-- To Disable Inspect Element -->
        <script src="~/Scripts/Disable_Inspect_Element/Disable_Inspect.js"></script>

    }
    <style>
        .vm-login-page {
            --main-bg-lcolor: @color;
            --main-bg-rcolor: @color;
            --vm-login-accent: @color;
            @if (!useGradientBg)
            {
                @:--vm-login-bg-url: url('@background');
                @:--vm-login-bg-size: @size;
                @:--vm-login-bg-repeat: @repeat;
            }
        }
    </style>
</head>

<body class="body Login_body vm-login-page vm-public-login @(useGradientBg ? "vm-login-page--gradient vm-public-login--gradient" : "vm-login-page--photo vm-public-login--photo")">
    <div class="vm-login-page__backdrop" aria-hidden="true"></div>
