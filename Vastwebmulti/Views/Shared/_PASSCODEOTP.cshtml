@using Vastwebmulti.Models
@using Microsoft.AspNet.Identity
@{
    Layout = null;
    var areaName = ViewContext.RouteData.DataTokens["area"] as string ?? "";

    VastwebmultiEntities DB = new VastwebmultiEntities();
    var companyName = DB.Admin_details.FirstOrDefault()?.Companyname ?? "Aasha Digital India";

    var logoRole = "ADMIN";
    if (areaName == "MASTER") { logoRole = "MASTER"; }
    else if (areaName == "DEALER") { logoRole = "DEALER"; }

    var logoimage = "";
    var logo = DB.tblHeaderLogoes.Where(p => p.Role == logoRole).ToList();
    if (logo.Count > 0)
    {
        logoimage = logo.First().LogoImage ?? "";
    }
    if (string.IsNullOrWhiteSpace(logoimage))
    {
        logoimage = "images/Default_Logo.png";
    }

    var userid = User.Identity.GetUserId();
    var passSetting = DB.passcodesettings.Where(x => x.userid == userid).SingleOrDefault();
    var otpTypeRaw = passSetting != null ? passSetting.passcodetype : Convert.ToString(TempData["PASSOCDETYPESETTING"]);
    var otpTypeLabel = "Passcode";
    if (otpTypeRaw == "PERDAY") { otpTypeLabel = "Daily"; }
    else if (otpTypeRaw == "WEAKS") { otpTypeLabel = "Weekly"; }
    else if (otpTypeRaw == "MONTHS") { otpTypeLabel = "Monthly"; }

    var resendSent = TempData["checkuseractive"] != null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
    <title>Security Verification — @companyName</title>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="~/MainFrontDesign/css/admin-modal-modern.css" rel="stylesheet" />
    <link href="~/MainFrontDesign/css/admin-high-security-gate.css?v=4" rel="stylesheet" />
</head>
<body class="saas-admin-ui saas-passcode-gate-standalone">

<div id="loadermoney" class="vm-hs-gate-loader" style="display:none;" aria-hidden="true"></div>

<section class="content saas-high-security-gate-page saas-admin-account-page saas-passcode-gate-page">
    <div class="vm-hs-gate-shell">
        <div class="vm-hs-gate-card vm-hs-gate-card--passcode" role="dialog" aria-modal="true" aria-labelledby="passcodeGateTitle">
            <div class="vm-hs-gate-logo-strip">
                <img src="@Url.Content("~/" + logoimage.TrimStart('/'))"
                     alt="@companyName"
                     class="vm-hs-gate-logo-img"
                     onerror="this.classList.add('is-hidden');document.getElementById('passcodeLogoText').classList.add('is-visible');" />
                <span id="passcodeLogoText" class="vm-hs-gate-logo-text">@companyName</span>
            </div>

            <div class="vm-hs-gate-header">
                <div class="vm-hs-gate-header__icon" aria-hidden="true">
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <h2 class="vm-hs-gate-header__title" id="passcodeGateTitle">Security Verification</h2>
                <p class="vm-hs-gate-header__sub">Enter your @otpTypeLabel passcode sent to your registered mobile / email.</p>
            </div>

            <div class="vm-hs-gate-body">
                @if (resendSent)
                {
                    <p class="vm-hs-gate-message vm-hs-gate-message--success" id="otp-mess">Passcode resent successfully. Please check SMS / email.</p>
                }
                else
                {
                    <p class="vm-hs-gate-message vm-hs-gate-message--info" id="otp-mess" style="display:none;"></p>
                }
                <p class="vm-hs-gate-field-error" id="otp-mess2"></p>

                @using (Html.BeginForm("CHECKPASSCODEPASSWORD", "Home", new { area = areaName }, FormMethod.Post, new { id = "passcodeForm", role = "form" }))
                {
                    <div class="vm-hs-gate-otp-field">
                        <label for="digit-1">@otpTypeLabel passcode</label>
                        <div class="vm-hs-gate-otp-group digit-group" data-group-name="digits" data-autosubmit="false" autocomplete="off">
                            <input type="text" id="digit-1" name="digit-1" data-next="digit-2" inputmode="numeric" pattern="[0-9]*" autocomplete="one-time-code" aria-label="Passcode digit 1" />
                            <input type="text" id="digit-2" name="digit-2" data-next="digit-3" data-previous="digit-1" inputmode="numeric" pattern="[0-9]*" autocomplete="off" aria-label="Passcode digit 2" />
                            <input type="text" id="digit-3" name="digit-3" data-next="digit-4" data-previous="digit-2" inputmode="numeric" pattern="[0-9]*" autocomplete="off" aria-label="Passcode digit 3" />
                            <input type="text" id="digit-4" name="digit-4" data-next="digit-5" data-previous="digit-3" inputmode="numeric" pattern="[0-9]*" autocomplete="off" aria-label="Passcode digit 4" />
                            <input type="text" id="digit-5" name="digit-5" data-next="digit-6" data-previous="digit-4" inputmode="numeric" pattern="[0-9]*" autocomplete="off" aria-label="Passcode digit 5" />
                            <input type="text" id="digit-6" name="digit-6" data-previous="digit-5" inputmode="numeric" pattern="[0-9]*" autocomplete="off" aria-label="Passcode digit 6" />
                        </div>
                    </div>

                    <input type="hidden" id="Passscodes" name="Passscodes" autocomplete="off" />

                    <div class="vm-hs-gate-actions vm-hs-gate-actions--split">
                        <button type="button" class="vm-hs-gate-btn vm-hs-gate-btn--ghost" onclick="document.getElementById('logoutForm').submit();">
                            <i class="fa-solid fa-right-from-bracket" aria-hidden="true"></i> Logout
                        </button>
                        <button type="submit" id="subHere" class="vm-hs-gate-btn vm-hs-gate-btn--primary submitotobtn">
                            <i id="loaderfa" class="" aria-hidden="true"></i>
                            <span id="submitbtn">Verify passcode</span>
                        </button>
                    </div>
                }

                @using (Html.BeginForm("LogOff", "Account", new { Area = "" }, FormMethod.Post, new { id = "logoutForm", style = "display:none;" }))
                {
                    @Html.AntiForgeryToken()
                }

                <div class="vm-hs-gate-resend-wrap">
                    <button type="button" class="vm-hs-gate-resend-link" onclick="resendotp()">
                        <i class="fa-solid fa-rotate-right" aria-hidden="true"></i> OTP not received? Resend passcode
                    </button>
                </div>
            </div>
        </div>
    </div>
</section>

<script src="~/Scripts/jquery-1.10.2.min.js"></script>
<script>
    function resendotp() {
        window.location.href = '@Url.Action("ResendPASSCODEPASSWORD", "Home", new { area = areaName })';
    }

    function showPasscodeLoader() {
        var code = $('#Passscodes').val();
        if (!code || code.length !== 6) {
            code = '';
            for (var i = 1; i <= 6; i++) {
                code += ($('#digit-' + i).val() || '');
            }
            $('#Passscodes').val(code);
        }

        if (code.length !== 6) {
            $('#otp-mess2').text('Please enter complete 6-digit passcode');
            $('#loaderfa').removeClass('fa-solid fa-circle-notch fa-spin');
            return false;
        }

        $('#loadermoney').show();
        $('#loaderfa').addClass('fa-solid fa-circle-notch fa-spin');
        $('#subHere').prop('disabled', true);
        return true;
    }

    $(document).ready(function () {
        window.history.pushState(null, '', window.location.href);
        window.onpopstate = function () {
            window.history.pushState(null, '', window.location.href);
        };

        var $logoText = $('#passcodeLogoText');
        var $logoImg = $('.vm-hs-gate-logo-img');
        if ($logoImg.length && $logoImg[0].complete && $logoImg[0].naturalWidth === 0) {
            $logoImg.addClass('is-hidden');
            $logoText.addClass('is-visible');
        } else if ($logoImg.length && $logoImg[0].complete) {
            $logoText.removeClass('is-visible');
        }

        $('#digit-1').focus();
    });

    $('#passcodeForm').on('submit', function (e) {
        if (!showPasscodeLoader()) {
            e.preventDefault();
        }
    });

    $("#digit-1, #digit-2, #digit-3, #digit-4, #digit-5, #digit-6").on("keyup", function () {
        var otpDigit = $("#digit-1").val() + $("#digit-2").val() + $("#digit-3").val() + $("#digit-4").val() + $("#digit-5").val() + $("#digit-6").val();
        if (otpDigit.length === 6) {
            $('#Passscodes').val(otpDigit);
            $('#otp-mess2').text('');
        }
    });

    $('.digit-group').find('input').each(function () {
        $(this).attr('maxlength', 1);
        $(this).on('keyup', function (e) {
            var parent = $($(this).parent());

            if (e.keyCode === 8 || e.keyCode === 37) {
                var prev = parent.find('input#' + $(this).data('previous'));
                if (prev.length) {
                    $(prev).select();
                }
            } else if ((e.keyCode >= 48 && e.keyCode <= 57) || (e.keyCode >= 96 && e.keyCode <= 105) || e.keyCode === 39) {
                var next = parent.find('input#' + $(this).data('next'));
                if (next.length) {
                    $(next).select();
                }
            }
        });
    });
</script>

@if (!HttpContext.Current.Request.IsLocal)
{
    <script src="~/Scripts/Disable_Inspect_Element/Disable_Inspect.js"></script>
}
</body>
</html>
